{
  // Cloudflare Worker config for Astro on Workers
  "name": "mannyknows",
  // v14 @astrojs/cloudflare injects its own worker entrypoint; a `main` pointing
  // at the (not-yet-built) output makes @cloudflare/vite-plugin fail config resolution.
  "compatibility_date": "2025-08-08",
  "compatibility_flags": ["nodejs_compat"],

  "vars": {
    "GA_MEASUREMENT_ID": "G-J0V35RZNZB",
    "OWNER_EMAIL": "mk@mannyknows.com",
    "OWNER_TIMEZONE": "America/New_York",
    // Sender for Resend (use a verified domain)
    "RESEND_FROM": "Manny <mk@mannyknows.com>",
    // Worker secrets in use (set via `npx wrangler secret put <NAME>`):
    // ADMIN_USERNAME / ADMIN_PASSWORD / SESSION_SECRET (admin login),
    // ADMIN_API_KEY (diagnostics endpoints), OPENAI_API_KEY +
    // KV_ENCRYPTION_KEY (Remi), GEMINI_API_KEY (admin AI assists),
    // RESEND_API_KEY (email). The old ADMIN_KEY secret is orphaned —
    // nothing reads it since the legacy admin was deleted.
    "ADMIN_EMAIL": "mk@mannyknows.com"
  },

  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },

  "kv_namespaces": [
    { "binding": "MK_KV_CHATBOT", "id": "ed368c98eef342b79e8f7c4b96b3fb62", "preview_id": "6ef503c2554244e4a2432f3c1d2e522c" },
    { "binding": "MK_KV_PROFILES", "id": "901abbf5b0484165a8eaa35a035f1ba8", "preview_id": "901abbf5b0484165a8eaa35a035f1ba8" },
    { "binding": "MK_KV_SESSIONS", "id": "4c1513b546c040678d266ba4f103a057", "preview_id": "4c1513b546c040678d266ba4f103a057" },
    { "binding": "MK_KV_SERVICES", "id": "13e95a5db28a4a9da5f517fe0a1e4250", "preview_id": "13e95a5db28a4a9da5f517fe0a1e4250" },
    { "binding": "MK_KV_PRODUCTS", "id": "d5cc59ddbef24b8db748c977aee91bb0", "preview_id": "d5cc59ddbef24b8db748c977aee91bb0" },
    { "binding": "MK_KV_SCHEDULER", "id": "22c4ca99de924d07996d6b44d538602a", "preview_id": "22c4ca99de924d07996d6b44d538602a" }
    // Admin app KV (wiki, presence, caches) — create, then uncomment:
    //   npx wrangler kv namespace create MK_ADMIN_KV     → paste the id
    // ,{ "binding": "MK_ADMIN_KV", "id": "PASTE_ID_HERE", "preview_id": "PASTE_ID_HERE" }
  ],

  // ── Admin/CRM resources (ported from the VLHomes admin) ────────────────────
  // The admin code ships dark: with these bindings absent it answers 503 with
  // setup instructions instead of erroring. Full walkthrough: SETUP-ADMIN.md.
  //
  // 1) D1 (required for everything admin):
  //      npx wrangler d1 create mannyknows-db             → paste database_id
  //    then uncomment "d1_databases", deploy, log in at /admin and run the
  //    migrations at /admin/migrate/.
  // "d1_databases": [
  //   { "binding": "MK_APP_DB", "database_name": "mannyknows-db", "database_id": "PASTE_ID_HERE" }
  // ],
  //
  // 2) R2 (optional — media pool, uploads, contract PDFs):
  //      npx wrangler r2 bucket create mannyknows-media
  // "r2_buckets": [
  //   { "binding": "MK_MEDIA_BUCKET", "bucket_name": "mannyknows-media" }
  // ],
  //
  // 3) Cloudflare Images transforms for /img/* (optional — falls back to
  //    serving originals):
  // "images": { "binding": "IMAGES" },

  "routes": [
    { "pattern": "mannyknows.com/*", "zone_name": "mannyknows.com" },
    { "pattern": "www.mannyknows.com/*", "zone_name": "mannyknows.com" }
  ],

  "observability": { "enabled": true }
}
