---
// Decorative animated background for a page header.
//
// The rules this follows, because a background video is the easiest way to
// wreck a fast site:
//   • Never in the LCP path. The element ships with no <source> at all — a
//     script attaches them after load, so the browser can't queue the download
//     ahead of text and images.
//   • Desktop only. Phones pay for it twice, in data and in battery, and the
//     header is mostly type at that size anyway.
//   • Honours prefers-reduced-motion (a real accessibility need, not a nicety)
//     and Save-Data / 2g-3g connections.
//   • Only plays while on screen, and pauses when the tab is hidden.
//   • Decorative, so aria-hidden and no captions — it carries no information.
// Without JS, or if any check fails, the poster image stays. Nothing breaks.
interface Props {
  /** Base path for /video/<name>.{webm,mp4} and <name>-poster.{avif,webp} */
  name?: string;
  /** 'mono' for white/grey footage (brand-tinted via blend modes);
      'color' for footage with its own palette (shown as-is at low opacity). */
  tone?: 'mono' | 'color';
  /** Warm the video during browser idle time after page load (instead of only
      when scrolled near) so playback starts instantly. Still after the load
      event, so it can never compete with the page's own assets. */
  warm?: boolean;
  /** Also play on phones. Reserve for genuinely small files (the ~330KB
      procedural starfield) — the desktop-only default exists because
      multi-MB footage costs mobile visitors data and battery. Reduced-motion
      and Save-Data are still honoured. */
  mobile?: boolean;
  class?: string;
}
const { name = 'hero-waves', tone = 'mono', warm = false, mobile = false, class: className = '' } = Astro.props;
---

<div class={`hero-video-bg ${tone === 'color' ? 'hero-video-bg--color' : ''} ${className}`} aria-hidden="true">
  <video
    class="hero-video-bg__media"
    data-hero-video
    data-webm={`/video/${name}.webm`}
    data-mp4={`/video/${name}.mp4`}
    data-warm={warm ? '1' : undefined}
    data-mobile={mobile ? '1' : undefined}
    poster={`/video/${name}-poster.webp`}
    muted
    loop
    playsinline
    preload="none"
    tabindex="-1"
  ></video>
  <!-- Brand tint: the footage is white/grey, so it reads as texture until it's
       coloured. Sits above the video, below the header content. -->
  <div class="hero-video-bg__tint"></div>
</div>

<style>
  .hero-video-bg {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
  }

  .hero-video-bg__media {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    /* Light theme: the grey waves darken the pale header just enough to read
       as texture. Kept low: at 0.5 the pale, busy field dragged the body
       copy's contrast down to where it was genuinely hard to read. */
    mix-blend-mode: multiply;
    opacity: 0.22;
  }

  /* Dark theme: multiply would erase it against a near-black page, so invert
     the footage and let screen lift the lines out of the background. */
  :global(.dark) .hero-video-bg__media {
    mix-blend-mode: screen;
    filter: invert(1) saturate(0);
    /* With the copy correctly layered above the scrim, the motion can carry a
       little more presence without touching text contrast. */
    opacity: 0.2;
  }

  .hero-video-bg__tint {
    position: absolute;
    inset: 0;
    background: linear-gradient(120deg, rgba(0, 113, 227, 0.18), transparent 45%, rgba(255, 79, 170, 0.15));
    mix-blend-mode: overlay;
  }

  /* Scrim: text sits in the middle of the header, so calm that area down.
     Without it the headline and subtitle sit on whatever the animation happens
     to be doing at that moment, and contrast changes as it loops. */
  .hero-video-bg::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 72% 68% at 50% 45%, rgba(255, 255, 255, 0.88), transparent 72%);
    z-index: 1;
  }
  :global(.dark) .hero-video-bg::before {
    background: radial-gradient(ellipse 70% 65% at 50% 45%, rgba(9, 9, 11, 0.72), transparent 70%);
  }

  /* The header's own content must stay above all of this. Astro scopes styles
     per component, so a descendant selector written here would only match
     elements this component renders: the header's other children (nav,
     breadcrumb, hero copy) live in the page, so they need :global to be
     reached at all. Without this the tint and scrim paint OVER the text:
     they're inside a positioned, z-indexed box, and static page content sits
     below positioned siblings. */
  :global(.has-hero-video > *:not(.hero-video-bg):not(nav)) {
    position: relative;
    z-index: 1;
  }
  /* The nav gets position WITHOUT a z-index. Giving it one creates a stacking
     context that traps its dropdown menus at z-index 1: the hero copy (also
     z-index 1, later in the DOM) then paints over the open menu, so hovering
     into it "leaves" the nav and the menu snaps shut (Manny hit this live).
     With z-auto the nav still paints above the z-0 video (later sibling), and
     its dropdowns keep escaping to the page context where their own high
     z-index works. */
  :global(.has-hero-video > nav) {
    position: relative;
  }

  /* Fade the bottom out so the section below doesn't start on a hard edge. */
  .hero-video-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent 55%, var(--hero-video-fade, rgba(255, 255, 255, 0.85)));
  }
  :global(.dark) .hero-video-bg::after {
    --hero-video-fade: rgba(9, 9, 11, 0.85);
  }

/* Colour footage carries its own palette: no blend trickery, no brand tint
     just low opacity under the same text-protecting scrim. */
  .hero-video-bg--color .hero-video-bg__media,
  :global(.dark) .hero-video-bg--color .hero-video-bg__media {
    mix-blend-mode: normal;
    filter: none;
    opacity: 0.22;
  }
  :global(.dark) .hero-video-bg--color .hero-video-bg__media {
    mix-blend-mode: screen;
    opacity: 0.3;
  }
  .hero-video-bg--color .hero-video-bg__tint {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-video-bg__media { display: none; }
  }
</style>

<script>
  (function () {
    const videos = Array.from(document.querySelectorAll<HTMLVideoElement>('[data-hero-video]'));
    if (!videos.length) return;

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const desktop = window.matchMedia('(min-width: 1024px)').matches;
    const conn = (navigator as any).connection;
    const thrifty = !!conn && (conn.saveData || /2g|3g/.test(conn.effectiveType ?? ''));
    if (reduced || thrifty) return; // posters stay; nothing downloads

    // Audition override: ?bgvideo=<name> swaps in /video/<name>.webm and
    // treats it as colour footage — lets us compare candidate backgrounds on
    // localhost without rebuilding. Harmless in production: it can only point
    // at files we already host, and unknown names just show the poster.
    const override = new URLSearchParams(location.search).get('bgvideo');

    for (const video of videos) {
      // Desktop-only unless this instance opted into mobile (small files only).
      if (!desktop && !video.dataset.mobile) continue;
      if (override && /^[a-z0-9-]{1,40}$/.test(override)) {
        video.dataset.webm = `/video/${override}.webm`;
        delete video.dataset.mp4;
        video.closest('.hero-video-bg')?.classList.add('hero-video-bg--color');
      }

      // One src, chosen up front via canPlayType — never <source> children.
      // With both formats listed, Lighthouse recorded BOTH files downloading
      // in full (~5.5MB per video, Aug 2026); a single src makes a second
      // fetch impossible. Safari gets MP4 outright: iOS answers "probably"
      // for VP9 WebM and then fails to decode it on real hardware.
      const isSafari = /^((?!chrome|crios|android).)*safari/i.test(navigator.userAgent);
      const attach = () => {
        if (video.src) return;
        const webm = !isSafari && video.dataset.webm && video.canPlayType('video/webm; codecs="vp9"') ? video.dataset.webm : '';
        const src = webm || video.dataset.mp4 || video.dataset.webm;
        if (!src) return;
        video.src = src;
        video.load();
      };

      // Fetch when the section is near the viewport — or, for data-warm
      // videos, during browser idle time right after load, so playback is
      // already buffered when the visitor scrolls to it. Both paths run after
      // the load event, so the page's own assets always win the network.
      const start = () => {
        if (video.dataset.warm) {
          const idle = (window as any).requestIdleCallback ?? ((fn: () => void) => setTimeout(fn, 1500));
          idle(() => {
            video.preload = 'auto';
            attach();
          });
        }

        const io = new IntersectionObserver((entries) => {
          for (const e of entries) {
            video.dataset.onscreen = e.isIntersecting ? '1' : '';
            if (e.isIntersecting) {
              attach();
              video.play().catch(() => {});
            } else {
              video.pause();
            }
          }
        }, { rootMargin: '200px' });
        io.observe(video);
      };

      if (document.readyState === 'complete') start();
      else window.addEventListener('load', start, { once: true });
    }

    document.addEventListener('visibilitychange', () => {
      for (const video of videos) {
        if (document.hidden) video.pause();
        // Resume only what the observer had running — not videos it paused
        // for being off-screen.
        else if (video.dataset.onscreen && video.src) video.play().catch(() => {});
      }
    });

    // iOS Low Power Mode rejects programmatic autoplay but allows play()
    // from a user gesture — retry stalled on-screen videos on first touch.
    const nudge = () => {
      for (const video of videos) {
        if (video.dataset.onscreen && video.src && video.paused) video.play().catch(() => {});
      }
    };
    addEventListener('touchstart', nudge, { passive: true, once: true });
    addEventListener('scroll', nudge, { passive: true, once: true });
  })();
</script>
