---
// The one button. Canonical CTA styling for the whole public site (Aug 2026
// normalization — the /plans hero pills won; the older rounded-xl two-stop
// gradient and the rounded-lg homepage buttons were retired). Every public
// button/link-button renders through this component so the look can't drift
// again. In-card pricing CTAs (PricingCards `.tier-cta`, glass) are the one
// deliberate exception — they carry the column's accent, not the brand pill.
//
//   <Button href="#contact" data-contact-context="…">Get a free look</Button>
//   <Button href="/plans/" variant="secondary" arrow="right">See the plans</Button>
//   <Button href="#pricing" arrow="down">See the plans</Button>
//   <Button type="submit" size="sm">Send</Button>          (no href → <button>)
//
// variant  primary   — brand gradient pill (blue → violet → pink), white text
//          secondary — outline pill, hairline border that warms to blue on hover
//          ghost     — text-only, blue, for tertiary "See all →" links
// size     sm h-10 · md h-12 (default) · lg h-14
// arrow    'right' | 'down' | 'external' | true (= right) — trailing icon
//
// Legacy props (`text`, `subtext`, the old `variant` names, `sparkles`…) are
// still accepted so older call sites keep compiling; prefer the slot.
export interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'ghost'
    // legacy names, mapped below
    | 'cta' | 'apple' | 'green' | 'urgent' | 'emoji' | 'theme-aware';
  size?: 'sm' | 'md' | 'lg';
  arrow?: 'right' | 'down' | 'external' | boolean;
  /** Full-width on small screens (stacks nicely in a flex-col hero). */
  block?: boolean;
  text?: string;
  subtext?: string;
  icon?: string;
  id?: string;
  type?: 'button' | 'submit' | 'reset';
  class?: string;
  className?: string;
  // legacy no-ops
  sparkles?: boolean;
  sparkleTheme?: string;
  pixelColors?: string;
  emoji?: string;
  emojiAnimation?: string;
  yellowText?: boolean;
  target?: string;
  rel?: string;
  title?: string;
  [key: `data-${string}`]: string | undefined;
  [key: `aria-${string}`]: string | undefined;
}

const {
  href,
  variant: rawVariant = 'primary',
  size = 'md',
  arrow = false,
  block = false,
  text,
  subtext,
  icon,
  id,
  type,
  class: klass = '',
  className = '',
  // swallow legacy props so they don't land on the element
  sparkles: _s, sparkleTheme: _st, pixelColors: _pc, emoji: _e, emojiAnimation: _ea, yellowText: _y,
  ...rest
} = Astro.props;

const variant: 'primary' | 'secondary' | 'ghost' =
  rawVariant === 'secondary' || rawVariant === 'theme-aware' ? 'secondary'
  : rawVariant === 'ghost' ? 'ghost'
  : 'primary';

// min-height rather than a fixed height so a long label can wrap on a narrow
// phone instead of spilling out of the pill.
const sizeCls = {
  sm: 'min-h-10 px-5 py-2 text-sm gap-1.5',
  md: 'min-h-12 px-7 py-2.5 text-[15px] gap-2',
  lg: 'min-h-14 px-9 py-3 text-base gap-2.5',
}[size];

const variantCls = {
  primary:
    'rounded-full bg-gradient-to-r from-primary-blue via-purple-500 to-primary-pink text-white font-semibold shadow-sm hover:shadow-lg hover:shadow-primary-blue/25 transition-shadow',
  secondary:
    'rounded-full border border-light-tertiary dark:border-dark-accent bg-white/60 dark:bg-white/[0.04] text-text-light-primary dark:text-text-dark-primary font-medium hover:border-primary-blue/40 hover:text-primary-blue dark:hover:text-blue-300 transition-colors',
  ghost:
    'rounded-full text-primary-blue dark:text-blue-300 font-semibold hover:underline underline-offset-4 px-0',
}[variant];

// Two-line buttons (homepage hero: "FREE 360° PHOTO / CLAIM NOW") are
// tighter — small caps text, narrower padding, no wrapping — so two fit
// side by side on a phone.
const twoLine = Boolean(subtext);
// Ghost keeps the size's type + gap but no padding/height (it's a text link).
const ghostCls = { sm: 'text-sm gap-1.5', md: 'text-[15px] gap-2', lg: 'text-base gap-2.5' }[size];
const shape = variant === 'ghost' ? ghostCls : twoLine ? 'min-h-12 px-4 sm:px-6 py-2 text-sm gap-2 whitespace-nowrap leading-tight' : sizeCls;
const base = `inline-flex items-center justify-center text-center leading-snug no-underline select-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-blue/50 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-dark-primary ${shape} ${block ? 'w-full sm:w-auto' : ''}`;

const cls = `${base} ${variantCls} ${klass} ${className}`.replace(/\s+/g, ' ').trim();

const arrowKind = arrow === true ? 'right' : arrow || null;
const ARROWS: Record<string, string> = {
  right: 'M9 5l7 7-7 7',
  down: 'M19 14l-7 7m0 0l-7-7m7 7V3',
  external: 'M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14',
};
const Tag = href ? 'a' : 'button';
const tagProps = href ? { href } : { type: type ?? 'button' };
---

<Tag id={id} class={cls} {...tagProps} {...rest}>
  {icon && <Fragment set:html={icon} />}
  {text ? (
    subtext ? (
      <span class="flex flex-col items-center leading-tight">
        <span class="font-semibold">{text}</span>
        <span class="text-[10px] font-medium opacity-80">{subtext}</span>
      </span>
    ) : (
      <span>{text}</span>
    )
  ) : (
    <slot />
  )}
  {arrowKind && (
    <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d={ARROWS[arrowKind]} />
    </svg>
  )}
</Tag>
