---
// The one section header (Aug 2026 normalization). Two sizes:
//
//   size="section" (default — interior pages, the sitewide standard)
//     h2  sf-bold text-2xl md:text-3xl, gradient text, centred, mb-10
//     p   text-base, secondary colour, max-w-2xl
//
//   size="hero" (homepage-scale statement headers; PageSection renders
//     every homepage header through this)
//     h2  4xl → 7xl apple-headline, block mb-10
//
// Pass `id` when the header anchors a jump link. `spacing` overrides the
// bottom margin (e.g. spacing="mb-6" for a header directly over a caption).
//
// Optional `aside` slot: something that shares the title's ROW (the homepage
// Apps section parks its dashboards mascot beside the h2). The row stacks on
// phones and sits side by side from md up; the subtitle stays below.
export interface Props {
  badge?: string;
  title: string;
  subtitle?: string;
  size?: 'section' | 'hero';
  alignment?: 'left' | 'center' | 'right';
  /** Bottom margin utility; defaults to mb-10 for both sizes. */
  spacing?: string;
  /** Max width of the block; defaults per size (max-w-2xl section, none for hero). */
  width?: string;
  id?: string;
  className?: string;
  /** Subtitle contains trusted markup (links, <strong>). */
  html?: boolean;
}

const {
  badge,
  title,
  subtitle,
  size = 'section',
  alignment = 'center',
  spacing,
  width,
  id,
  className = '',
  html = false,
} = Astro.props;

const alignCls = { left: 'text-left', center: 'text-center mx-auto', right: 'text-right ml-auto' }[alignment];
const isHero = size === 'hero';
const mb = spacing ?? 'mb-10';
const maxW = width ?? (isHero ? '' : 'max-w-2xl');
const hasAside = Astro.slots.has('aside');
const h2Base = isHero
  ? 'sf-bold apple-headline text-text-light-primary dark:text-text-dark-primary text-4xl md:text-6xl lg:text-7xl'
  : 'sf-bold text-2xl md:text-3xl font-bold';
// Hero h2 carries the gap to the subtitle (mb-6); section h2 lets the p bring
// its own mt-3. When an aside shares the row, the ROW carries that gap.
const h2Cls = isHero && !hasAside ? `${h2Base} mb-6` : h2Base;
const rowCls = `flex flex-col md:flex-row items-center justify-center gap-2 md:gap-12 text-center md:text-left${isHero ? ' mb-6' : ''}`;
const pCls = isHero
  ? 'text-base sm:text-xl text-text-light-secondary dark:text-text-dark-secondary max-w-3xl mx-auto leading-relaxed'
  : 'mt-3 text-base text-text-light-secondary dark:text-text-dark-secondary leading-relaxed';
---

<div id={id} class={`${alignCls} ${maxW} ${mb} ${className}`.trim()}>
  {badge && (
    <div class="mb-4">
      <span class="section-badge inline-block bg-gradient-to-r from-primary-blue/10 via-purple-500/10 to-primary-pink/10 text-primary-blue dark:text-primary-blue px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider">
        {badge}
      </span>
    </div>
  )}
  {hasAside ? (
    <div class={rowCls}>
      <h2 class={h2Cls}>
        <span class="apple-gradient-text" data-colorful-title set:html={title} />
      </h2>
      <slot name="aside" />
    </div>
  ) : (
    <h2 class={h2Cls}>
      <span class="apple-gradient-text" data-colorful-title set:html={title} />
    </h2>
  )}
  {subtitle && (html ? <p class={pCls} set:html={subtitle} /> : <p class={pCls}>{subtitle}</p>)}
</div>
