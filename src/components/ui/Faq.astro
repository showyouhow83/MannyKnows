---
// Shared FAQ block — one consistent card style for every FAQ on the site
// (/plans, /plans/<slug>, and the product detail pages). Pass an array of
// {q, a}. Emits FAQPage structured data unless schema={false}.
interface FaqItem { q: string; a: string; }
interface Props {
  faqs: FaqItem[];
  heading?: string;
  schema?: boolean;
}
const { faqs, heading = 'Common questions', schema = true } = Astro.props;

const faqSchema = schema && faqs.length > 0
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    }
  : null;
---

{faqs.length > 0 && (
  <div class="max-w-4xl mx-auto md:flex md:items-center md:gap-10">
    <div class="flex-1 min-w-0">
    {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
    {heading && (
      <h2 class="sf-bold text-2xl md:text-3xl font-bold text-center mb-10">
        <span class="apple-gradient-text" data-colorful-title>{heading}</span>
      </h2>
    )}
    {/* Native <details> accordion, closed by default: the answers stay in the
        DOM (so the FAQPage schema above and Google's indexing are unaffected)
        while the page stops being a wall of open answers. No JS. */}
    <div class="space-y-3">
      {faqs.map((f) => (
        <details class="group rounded-xl border border-light-tertiary dark:border-dark-accent bg-white dark:bg-dark-secondary">
          <summary class="flex items-center justify-between gap-4 cursor-pointer list-none [&::-webkit-details-marker]:hidden p-5 font-semibold text-text-light-primary dark:text-text-dark-primary rounded-xl focus-visible:outline focus-visible:outline-2 focus-visible:outline-primary-blue/60">
            {f.q}
            <svg class="w-4 h-4 flex-shrink-0 text-text-light-tertiary dark:text-text-dark-tertiary transition-transform duration-200 group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
          </summary>
          <p class="px-5 pb-5 -mt-1 text-sm text-text-light-secondary dark:text-text-dark-secondary leading-relaxed">{f.a}</p>
        </details>
      ))}
    </div>
    </div>

    {/* Question-mark astronaut (waist-up crop, 22 KB webp) — right column on
        desktop, below the FAQs at homepage-mascot size on mobile.
        Size dials: the two max-w values below. */}
    <img
      src="/mascot/astro-faqs.webp"
      alt=""
      aria-hidden="true"
      width="360"
      height="734"
      loading="lazy"
      decoding="async"
      class="mx-auto mt-8 w-full max-w-[80px] md:mx-0 md:mt-0 md:max-w-[160px] h-auto pointer-events-none flex-shrink-0"
    />
  </div>
)}
