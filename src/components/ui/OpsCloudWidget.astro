---
// OpsCloud AI-agent chat widget — facade / load-on-click.
//
// Trial embed (homepage only for now). We render our own lightweight bubble so
// NOTHING third-party loads on page view — this keeps Lighthouse high and limits
// the widget to visitors who actually engage. The real opscloud loader.js is
// injected on first click, then this facade hands off to the real widget.
//
// CSP: opscloud.us is whitelisted in BaseLayout.astro (script/style/font/frame +
// connect/wss). If this ever goes site-wide, keep it behind this facade.
export interface Props {
  agentId?: string;
  api?: string;
}
const { agentId = 'agent_manny_mk', api = 'https://opscloud.us' } = Astro.props;
---

<button
  id="opscloudLauncher"
  type="button"
  class="opscloud-launcher"
  aria-label="Chat with Manny"
  title="Chat with Manny"
  data-agent-id={agentId}
  data-api={api}
>
  <!-- chat icon -->
  <svg class="opscloud-launcher__icon" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
  </svg>
  <!-- loading spinner -->
  <svg class="opscloud-launcher__spinner" width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2.5" stroke-opacity="0.25"></circle>
    <path d="M21 12a9 9 0 0 0-9-9" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"></path>
  </svg>
</button>

<style>
  .opscloud-launcher {
    position: fixed;
    right: 1.25rem;
    bottom: 1.25rem;
    z-index: 40;
    width: 3.5rem;
    height: 3.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
    border-radius: 9999px;
    color: #fff;
    cursor: pointer;
    background: linear-gradient(135deg, #22c55e 0%, #10b981 100%);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.18);
    transition: transform 0.15s ease, opacity 0.3s ease, visibility 0.3s ease;
  }
  .opscloud-launcher:hover { transform: translateY(-1px); }
  .opscloud-launcher:focus-visible { outline: 2px solid #10b981; outline-offset: 3px; }

  /* Lift above the bottom-center dock on mobile so they don't crowd. */
  @media (max-width: 640px) {
    .opscloud-launcher { bottom: 5.25rem; right: 1rem; }
  }

  .opscloud-launcher__spinner { display: none; animation: opscloud-spin 0.8s linear infinite; }
  @keyframes opscloud-spin { to { transform: rotate(360deg); } }

  .opscloud-launcher.is-loading .opscloud-launcher__icon { display: none; }
  .opscloud-launcher.is-loading .opscloud-launcher__spinner { display: block; }

  .opscloud-launcher.is-hidden { opacity: 0; visibility: hidden; pointer-events: none; }

  @media (prefers-reduced-motion: reduce) {
    .opscloud-launcher { transition: opacity 0.3s ease, visibility 0.3s ease; }
    .opscloud-launcher:hover { transform: none; }
  }
</style>

<script>
  (function () {
    const btn = document.getElementById('opscloudLauncher');
    if (!btn) return;
    let injected = false;

    function hideFacade() {
      btn.classList.add('is-hidden');
    }

    function widgetMounted() {
      hideFacade();
      // Best-effort: some widgets expose a global opener so the first click opens
      // chat straight away. Harmless (and silent) if none of these exist.
      ['OpsCloud', 'Opscloud', 'opscloud', 'MannyWidget'].forEach(function (k) {
        try {
          const o = window[k];
          if (o && typeof o.open === 'function') o.open();
        } catch (e) { /* ignore */ }
      });
    }

    function watchForWidget() {
      const obs = new MutationObserver(function (mutations, observer) {
        for (const m of mutations) {
          for (const node of m.addedNodes) {
            if (node.nodeType !== 1 || node === btn) continue;
            const isFrame = node.tagName === 'IFRAME';
            let fixed = false;
            try { fixed = getComputedStyle(node).position === 'fixed'; } catch (e) { /* ignore */ }
            if (isFrame || fixed) {
              observer.disconnect();
              widgetMounted();
              return;
            }
          }
        }
      });
      obs.observe(document.body, { childList: true, subtree: true });
      // Fallback: retire the facade even if we can't positively detect the mount.
      setTimeout(function () { obs.disconnect(); hideFacade(); }, 6000);
    }

    btn.addEventListener('click', function () {
      if (injected) return;
      injected = true;
      btn.classList.add('is-loading');
      btn.setAttribute('aria-busy', 'true');

      const api = btn.dataset.api || 'https://opscloud.us';
      const s = document.createElement('script');
      s.src = api + '/widget/loader.js';
      s.setAttribute('data-agent-id', btn.dataset.agentId || 'agent_manny_mk');
      s.setAttribute('data-api', api);
      s.defer = true;
      s.onerror = function () {
        // Loader blocked/offline — restore the button so it isn't stuck spinning.
        injected = false;
        btn.classList.remove('is-loading');
        btn.removeAttribute('aria-busy');
      };
      document.body.appendChild(s);
      watchForWidget();
    });
  })();
</script>
