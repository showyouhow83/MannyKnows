---
// AiTeamEcosystem — the "what hiring Manny AI looks like" diagram that replaced
// the group-chat mock on /ai-team (Manny, Aug 2026). One request flows to
// Manny AI (the hire), Manny staffs the specialists, and everything lands in
// one dashboard for the owner's approval.
//
// Only non-hidden agents appear (Leo/Aria/Piper/Max work behind the scenes and
// are deliberately not shown anywhere). Pure HTML/SVG — no JS, no new assets:
// the faces are the existing AgentAvatar art.
import AgentAvatar from './AgentAvatar.astro';
import { team } from '../../data/aiTeam';

const specialists = [...team]
  .filter((a) => !a.included && !a.hidden)
  .sort((a, b) => a.order - b.order);

// The specialists Manny summons for this request: Eve researches, Elly
// writes, Vera measures what ships. The rest render dimmed with dashed
// connectors — summoned only when a job calls for them (Manny, Aug 2026:
// lines to unused agents read as wrong).
const ACTIVE = new Set(['eve', 'elly', 'ana']);
// Connector geometry: six equal columns → tile centers at 100,300,…,1100 in a
// 1200-wide viewBox stretched to match the grid width exactly.
const centers = specialists.map((_, i) => 100 + i * 200);

// Short labels for the diagram nodes (full roles live on the roster cards).
const shortRole: Record<string, string> = {
  desi: 'Front desk',
  eve: 'Intel & strategy',
  elly: 'Copywriting',
  essie: 'SEO & local',
  upie: 'Engagement',
  ana: 'Analytics',
};

// The dashboard rows — the RESULT of the request at the top of the diagram,
// so the flow reads request → summoned specialists → the work back for
// approval (Manny, Aug 2026: mixing in generic feed rows broke the story).
// Every row is from the real painter run (7/23/2026), nothing invented; the
// day-to-day feed is the caption under the panel instead.
// The thread's opening move: Manny AI asks what a content creator would ask,
// and the summoned specialists queue behind the brief (Manny, Aug 2026).
const dashboardRows: { who: string; label: string; detail: string; waiting?: { who: string; label: string }[] }[] = [
  {
    who: 'manny',
    label: 'Manny AI — scoping the brief',
    detail: "Who books interior painting in January — homeowners, landlords, offices? What's converting on painting TikTok right now? Which winter objection do we answer first: mess, fumes, or drying time? And what makes the offer worth booking before March?",
    waiting: [
      { who: 'eve', label: 'researching the answers' },
      { who: 'ana', label: 'pulling what performed before' },
      { who: 'elly', label: "waiting on Eve's findings" },
    ],
  },
];
---

<div class="max-w-3xl mx-auto">
  <!-- Stage 1: the owner's request, in their own words -->
  <div class="flex items-start justify-center gap-3 max-w-2xl mx-auto">
    <span class="flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-full bg-gradient-to-r from-primary-blue to-primary-pink text-white shadow-lg shadow-primary-blue/20" aria-hidden="true">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.9 9.9 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
    </span>
    <p class="text-sm text-text-light-secondary dark:text-text-dark-secondary text-left">
      <em>“We want to run a TikTok promo for indoor painting this winter — the offer runs January through March. Produce the content for it.”</em>
      <span class="block mt-1 text-[11px] text-text-light-tertiary dark:text-text-dark-tertiary">A request from a Springfield painting contractor</span>
    </p>
  </div>

  <div class="flex justify-center py-2" aria-hidden="true">
    <svg width="16" height="28" viewBox="0 0 16 28" fill="none"><path d="M8 0v22m0 0l-6-6m6 6l6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-text-light-tertiary dark:text-text-dark-tertiary"/></svg>
  </div>

  <!-- Stage 2: Manny AI, the hire -->
  <div class="mx-auto max-w-md rounded-2xl border border-primary-blue/40 ring-1 ring-primary-blue/15 bg-white dark:bg-dark-secondary p-5 flex items-center gap-4 shadow-lg shadow-primary-blue/10">
    <div class="w-16 h-16 flex-shrink-0 rounded-xl bg-gradient-to-br from-primary-blue/[0.07] via-transparent to-primary-pink/[0.07]">
      <AgentAvatar agent="manny" class="w-full h-full" />
    </div>
    <div class="min-w-0">
      <p class="text-base font-bold text-text-light-primary dark:text-text-dark-primary leading-tight">Manny AI — the manager</p>
      <p class="text-sm text-text-light-secondary dark:text-text-dark-secondary leading-snug mt-1">Summons the right specialists for the task, briefs each one, and runs the handoffs so the task is completed the way you expect — staffing more sub-agents behind the scenes as it calls for them.</p>
    </div>
  </div>

  <!-- Fan-out connectors: one line per tile, solid to the specialists Manny
       summoned for this run, faint & dashed to the ones on the bench.
       Hidden on mobile where the grid wraps to two rows. -->
  <div class="hidden sm:block py-1" aria-hidden="true">
    <svg class="w-full" height="34" viewBox="0 0 1200 34" fill="none" preserveAspectRatio="none">
      {specialists.map((a, i) => (
        <path
          d={`M600 0 C600 20, ${centers[i]} 14, ${centers[i]} 34`}
          stroke="currentColor"
          stroke-width={ACTIVE.has(a.id) ? 2.2 : 1.4}
          stroke-dasharray={ACTIVE.has(a.id) ? undefined : '4 5'}
          class={ACTIVE.has(a.id) ? 'text-primary-blue/70 dark:text-blue-300/70' : 'text-text-light-tertiary dark:text-text-dark-tertiary'}
          opacity={ACTIVE.has(a.id) ? '0.95' : '0.3'}
        />
      ))}
    </svg>
  </div>

  <!-- Stage 3: the specialists — summoned ones lit, the rest on the bench -->
  <ul class="grid grid-cols-3 sm:grid-cols-6 gap-3 mt-3 sm:mt-0" role="list">
    {specialists.map((a) => (
      <li class={`flex flex-col items-center gap-1 rounded-xl border p-2.5 transition-opacity ${ACTIVE.has(a.id) ? 'border-primary-blue/40 ring-1 ring-primary-blue/20 bg-white dark:bg-dark-secondary' : 'border-light-tertiary dark:border-dark-accent bg-white dark:bg-dark-secondary opacity-45'}`}>
        <div class="w-full max-w-[52px] aspect-square rounded-xl bg-gradient-to-br from-primary-blue/[0.07] via-transparent to-primary-pink/[0.07]">
          <AgentAvatar agent={a.id} class="w-full h-full" />
        </div>
        <span class="text-[11px] font-bold text-text-light-primary dark:text-text-dark-primary leading-tight">{a.name}</span>
        <span class="text-[9px] text-text-light-tertiary dark:text-text-dark-tertiary text-center leading-tight">{shortRole[a.id] ?? a.role}</span>
      </li>
    ))}
  </ul>
  <p class="mt-2 text-center text-[11px] text-text-light-tertiary dark:text-text-dark-tertiary">
    For this request Manny summoned Eve, Elly, and Vera — the rest stay on the bench until a job calls for them.
  </p>

  <div class="flex justify-center py-2" aria-hidden="true">
    <svg width="16" height="28" viewBox="0 0 16 28" fill="none"><path d="M8 0v22m0 0l-6-6m6 6l6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-text-light-tertiary dark:text-text-dark-tertiary"/></svg>
  </div>

  <!-- Stage 4: the request comes back done, for your approval -->
  <div class="rounded-2xl border border-light-tertiary dark:border-dark-accent bg-white dark:bg-dark-secondary overflow-hidden shadow-sm">
    <div class="flex items-center justify-between px-4 py-2.5 border-b border-light-tertiary dark:border-dark-accent bg-light-secondary/50 dark:bg-dark-primary/50">
      <span class="text-[11px] font-bold uppercase tracking-wider text-text-light-tertiary dark:text-text-dark-tertiary">Your dashboard · the request, back done</span>
    </div>
    <ul role="list">
      {dashboardRows.map((r, i) => (
        <li class={`flex items-center gap-3 px-4 py-3 ${i > 0 ? 'border-t border-light-tertiary dark:border-dark-accent' : ''}`}>
          <div class="w-8 h-8 flex-shrink-0 rounded-lg bg-gradient-to-br from-primary-blue/10 to-primary-pink/10 overflow-hidden">
            <AgentAvatar agent={r.who as any} class="w-full h-full" />
          </div>
          <div class="min-w-0 flex-1">
            <p class="text-sm font-semibold text-text-light-primary dark:text-text-dark-primary leading-tight">{r.label}</p>
            <p class="text-[11px] text-text-light-tertiary dark:text-text-dark-tertiary leading-snug">{r.detail}</p>
          </div>
          {r.waiting && (
            <div class="flex-shrink-0 flex flex-col gap-1.5">
              {r.waiting.map((w) => (
                <span class="inline-flex items-center gap-1.5 rounded-full bg-amber-50 dark:bg-amber-500/10 text-amber-700 dark:text-amber-400 text-[10px] font-semibold pl-1 pr-2.5 py-0.5">
                  <span class="w-5 h-5 rounded-full overflow-hidden bg-gradient-to-br from-primary-blue/10 to-primary-pink/10">
                    <AgentAvatar agent={w.who as any} class="w-full h-full" />
                  </span>
                  {w.label}
                </span>
              ))}
            </div>
          )}
        </li>
      ))}
    </ul>
  </div>

  <p class="mt-3 text-center text-[11px] text-text-light-tertiary dark:text-text-dark-tertiary leading-relaxed">
    Day to day, the same dashboard carries the whole team's output — the daily intel brief, captured leads, search rankings, and the monthly report.
  </p>
</div>
