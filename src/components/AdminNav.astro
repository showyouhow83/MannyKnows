---
// Shared admin desktop nav. Single source of truth for the link list +
// dropdowns. Pass `active` to highlight the current page.
//   <AdminNav active="dashboard" />
type ActiveKey =
  | 'dashboard' | 'leads' | 'quotes' | 'projects'
  | 'calendar' | 'portfolios' | 'crew' | 'partners' | 'contacts' | 'media-pool' | 'web';
interface Props { active?: ActiveKey }
const { active } = Astro.props;
const cls = (key: ActiveKey) => `nav-link${active === key ? ' active' : ''}`;

// Build stamp — src/data/build-info.json is currently a static file (commit
// "mk"). Wire a generator into the build (à la SLPainting's
// scripts/generate-build-info.js) when per-deploy stamps are wanted.
import buildInfo from '../data/build-info.json';
const builtDate = new Date(buildInfo.builtAt);
const builtLabel = isNaN(builtDate.getTime())
  ? ''
  : builtDate.toLocaleString('en-US', {
      timeZone: 'America/New_York',
      month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit',
    });
const shortVersion = String(buildInfo.version || '').split('.')[0];
const commitUrl = `https://github.com/MannyKnows/MannyKnows/commit/${buildInfo.commit}`;
---
<nav class="admin-nav">
  <a href="/admin/dashboard" class={cls('dashboard')}>Dashboard</a>
  <div class="nav-item">
    <a href="/admin/leads" class={cls('leads')}>Leads</a>
    <div class="nav-dropdown">
      <a href="/admin/leads" class="nav-dropdown-link">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
        View All Leads
      </a>
      <div class="nav-dropdown-divider"></div>
      <a href="/admin/leads?new=1" class="nav-dropdown-link action">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
        New Lead
      </a>
    </div>
  </div>
  <div class="nav-item">
    <a href="/admin/quotes" class={cls('quotes')}>Quotes</a>
    <div class="nav-dropdown">
      <a href="/admin/quotes" class="nav-dropdown-link">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
        View All Quotes
      </a>
      <a href="/admin/quote-templates" class="nav-dropdown-link">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><path d="M9 13h6M9 17h6"/></svg>
        Quote Templates
      </a>
      <div class="nav-dropdown-divider"></div>
      <a href="/admin/quotes?new=1" class="nav-dropdown-link action">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
        New Quote
      </a>
    </div>
  </div>
  <div class="nav-item">
    <a href="/admin/projects" class={cls('projects')}>Projects</a>
    <div class="nav-dropdown">
      <a href="/admin/projects" class="nav-dropdown-link">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
        View All Projects
      </a>
      <a href="/admin/contract-templates" class="nav-dropdown-link">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><path d="M9 13h6M9 17h6"/></svg>
        Contract Templates
      </a>
      <a href="/admin/contractor-signature" class="nav-dropdown-link">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 17h18M5 13l4-8 4 8M10 13h6"/></svg>
        My Signature
      </a>
      <div class="nav-dropdown-divider"></div>
      <a href="/admin/projects/?new=1" class="nav-dropdown-link action">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
        New Project
      </a>
    </div>
  </div>
  <a href="/admin/portfolios" class={cls('portfolios')}>Portfolios</a>
  <a href="/admin/contacts" class={cls('contacts')}>Contacts</a>
  <a href="/admin/partners" class={cls('partners')}>Partners</a>
  <a href="/admin/crew" class={cls('crew')}>Crew</a>
  <a href="/admin/calendar" class={cls('calendar')}>Calendar</a>
  <a href="/admin/media-pool" class={cls('media-pool')}>
    Media Pool<span class="nav-badge" id="mediaPoolBadge" style="display:none;">0</span>
  </a>
  <a href="/admin/web" class={`nav-link nav-link-special${active === 'web' ? ' active' : ''}`}>Web</a>
</nav>
<style is:global>
  /* Build stamp rendered into the admin footer (below "by MK"). */
  .footer-version {
    display: block;
    margin-top: 6px;
    font-size: 11px;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    opacity: 0.55;
  }
  .footer-version a {
    color: var(--color-text-secondary, #94a3b8);
    text-decoration: none;
  }
  .footer-version a:hover { text-decoration: underline; opacity: 1; }
</style>
<script define:vars={{ verText: `v${shortVersion} · ${buildInfo.commit}${builtLabel ? ` · ${builtLabel} ET` : ''}`, commitUrl, titleText: `Build ${buildInfo.commit} · deployed ${builtLabel} ET` }}>
  // Append the build stamp below "by MK" in the admin footer. Done here (in
  // the shared nav) so every admin page gets it from one source of truth.
  (function stampFooter() {
    function inject() {
      var footer = document.querySelector('.admin-footer');
      if (!footer || footer.querySelector('.footer-version')) return;
      var span = document.createElement('span');
      span.className = 'footer-version';
      var a = document.createElement('a');
      a.href = commitUrl; a.target = '_blank'; a.rel = 'noopener';
      a.textContent = verText; a.title = titleText;
      span.appendChild(a);
      footer.appendChild(span);
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', inject);
    else inject();
  })();
</script>
<script is:inline>
  // Resilience: if a /cdn-cgi/image/ thumbnail 404s (zone Image Transformations
  // disabled or over quota), swap the <img> to the raw R2 URL embedded in it.
  // Capture-phase listener covers every current and future cdn-cgi image.
  document.addEventListener('error', function (e) {
    var img = e.target;
    if (!img || img.tagName !== 'IMG' || img.dataset.cdnFallback) return;
    var m = /^(https?:\/\/[^/]+)\/cdn-cgi\/image\/[^/]+(\/.+)$/.exec(img.src);
    if (m) { img.dataset.cdnFallback = '1'; img.src = m[1] + m[2]; }
  }, true);
</script>
<script is:inline>
  (function pollMediaPoolCount() {
    const badges = [
      document.getElementById('mediaPoolBadge'),
      document.getElementById('mediaPoolBadgeMobile'),
    ].filter(Boolean);
    if (!badges.length) return;
    async function refresh() {
      try {
        const res = await fetch('/api/admin/media-pool/?count=1', { credentials: 'include' });
        if (!res.ok) return;
        const data = await res.json();
        const n = Number(data.count || 0);
        badges.forEach(b => {
          if (n > 0) { b.textContent = String(n); b.style.display = 'inline-flex'; }
          else { b.style.display = 'none'; }
        });
      } catch {}
    }
    // Expose so the pool page can force-refresh after deletes/assignments —
    // otherwise the badge lags up to 30s behind reality.
    window.refreshMediaPoolBadge = refresh;
    refresh();
    setInterval(refresh, 30000);
  })();
</script>
