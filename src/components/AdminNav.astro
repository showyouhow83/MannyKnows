---
// Shared admin desktop nav. Single source of truth for the link list +
// dropdowns. Pass `active` to highlight the current page.
//   <AdminNav active="dashboard" />
type ActiveKey =
  | 'dashboard' | 'leads' | 'quotes' | 'projects'
  | 'calendar' | 'portfolios' | 'crew' | 'partners' | 'contacts' | 'media-pool' | 'web'
  | 'settings';
interface Props { active?: ActiveKey }
const { active } = Astro.props;
const cls = (key: ActiveKey) => `nav-link${active === key ? ' active' : ''}`;

// Build stamp — src/data/build-info.json is currently a static file (commit
// "mk"). Wire a generator into the build (à la SLPainting's
// scripts/generate-build-info.js) when per-deploy stamps are wanted.
import buildInfo from '../data/build-info.json';
const builtDate = new Date(buildInfo.builtAt);
const builtLabel = isNaN(builtDate.getTime())
  ? ''
  : builtDate.toLocaleString('en-US', {
      timeZone: 'America/New_York',
      month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit',
    });
const shortVersion = String(buildInfo.version || '').split('.')[0];
const commitUrl = `https://github.com/MannyKnows/MannyKnows/commit/${buildInfo.commit}`;
---
<nav class="admin-nav">
  <a href="/admin/dashboard" class={cls('dashboard')}>Dashboard</a>
  <div class="nav-item">
    <a href="/admin/leads" class={cls('leads')}>Leads</a>
    <a href="/admin/leads?new=1" class="nav-plus" data-modal-fn="showNewLeadModal" title="New Lead" aria-label="New Lead">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M12 5v14M5 12h14"/></svg>
    </a>
  </div>
  <div class="nav-item">
    <a href="/admin/quotes" class={cls('quotes')}>Quotes</a>
    <a href="/admin/quotes?new=1" class="nav-plus" data-modal-fn="showNewQuoteModal" title="New Quote" aria-label="New Quote">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M12 5v14M5 12h14"/></svg>
    </a>
  </div>
  <div class="nav-item">
    <a href="/admin/projects" class={cls('projects')}>Projects</a>
    <a href="/admin/projects/?new=1" class="nav-plus" data-modal-fn="openNewProjectModal" title="New Project" aria-label="New Project">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M12 5v14M5 12h14"/></svg>
    </a>
  </div>
  <a href="/admin/portfolios" class={cls('portfolios')}>Portfolios</a>
  <a href="/admin/contacts" class={cls('contacts')}>Contacts</a>
  <a href="/admin/partners" class={cls('partners')}>Partners</a>
  <a href="/admin/crew" class={cls('crew')}>Crew</a>
  <a href="/admin/calendar" class={cls('calendar')}>Calendar</a>
  <a href="/admin/media-pool" class={cls('media-pool')}>
    Media Pool<span class="nav-badge" id="mediaPoolBadge" style="display:none;">0</span>
  </a>
  <a href="/admin/web" class={`nav-link nav-link-special${active === 'web' ? ' active' : ''}`}>Web</a>
  <div class="nav-item nav-item-settings" id="navSettings">
    <button type="button" class={`nav-link nav-label nav-settings-toggle${active === 'settings' ? ' active' : ''}`} id="navSettingsToggle" aria-expanded="false" aria-controls="navSettingsMenu">
      <svg class="nav-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/></svg>
      Settings
      <svg class="nav-caret" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
    </button>
    <div class="nav-dropdown" id="navSettingsMenu">
      <a href="/admin/quote-templates" class="nav-dropdown-link">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><path d="M9 13h6M9 17h6"/></svg>
        Quote Templates
      </a>
      <a href="/admin/contract-templates" class="nav-dropdown-link">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><path d="M9 13h6M9 17h6"/></svg>
        Contract Templates
      </a>
      <a href="/admin/contractor-signature" class="nav-dropdown-link">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 17h18M5 13l4-8 4 8M10 13h6"/></svg>
        My Signature
      </a>
    </div>
  </div>
  <div class="sidenav-foot">
    by <a href="https://mannyknows.com" class="footer-link" target="_blank" rel="noopener">MK <span class="rocket-emoji">🚀</span></a>
  </div>
</nav>
<button class="sidenav-toggle" id="sidenavToggle" aria-label="Toggle navigation" title="Toggle navigation">
  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"/></svg>
</button>
<script is:inline>
  // Sidebar rail (desktop ≥1025px). Runs inline, before first paint of the
  // main content, so the collapsed state never flashes. Pages without
  // <AdminNav> never get body.has-sidenav and keep their full-width layout.
  (function () {
    document.body.classList.add('has-sidenav');
    try {
      if (localStorage.getItem('admin-nav-collapsed') === '1') {
        document.body.classList.add('nav-collapsed');
      }
    } catch (e) {}
    var btn = document.getElementById('sidenavToggle');
    if (btn) btn.addEventListener('click', function () {
      var collapsed = document.body.classList.toggle('nav-collapsed');
      try { localStorage.setItem('admin-nav-collapsed', collapsed ? '1' : '0'); } catch (e) {}
    });

    // Settings group: sub-links stay hidden until Settings is clicked.
    // State persists across pages; a settings page always opens its group.
    var settingsToggle = document.getElementById('navSettingsToggle');
    var settingsItem = document.getElementById('navSettings');
    if (settingsToggle && settingsItem) {
      var settingsOpen = settingsToggle.classList.contains('active');
      try { settingsOpen = settingsOpen || localStorage.getItem('admin-settings-open') === '1'; } catch (e) {}
      settingsItem.classList.toggle('open', settingsOpen);
      settingsToggle.setAttribute('aria-expanded', settingsOpen ? 'true' : 'false');
      settingsToggle.addEventListener('click', function () {
        var open = settingsItem.classList.toggle('open');
        settingsToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
        try { localStorage.setItem('admin-settings-open', open ? '1' : '0'); } catch (e) {}
      });
    }

    // Hover "+" on Leads/Quotes/Projects: when the page's creation modal is
    // present, open it in place; anywhere else the ?new=1 href navigates and
    // the target page auto-opens it.
    document.querySelectorAll('.nav-plus').forEach(function (plus) {
      plus.addEventListener('click', function (e) {
        var fn = plus.dataset.modalFn && window[plus.dataset.modalFn];
        if (typeof fn === 'function') { e.preventDefault(); fn(); }
      });
    });
  })();
</script>
<style is:global>
  /* Build stamp rendered into the admin footer (below "by MK"). */
  .footer-version {
    display: block;
    margin-top: 6px;
    font-size: 11px;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    opacity: 0.55;
  }
  .footer-version a {
    color: var(--color-text-secondary, #a1a1aa);
    text-decoration: none;
  }
  .footer-version a:hover { text-decoration: underline; opacity: 1; }
</style>
<script define:vars={{ verText: `v${shortVersion} · ${buildInfo.commit}${builtLabel ? ` · ${builtLabel} ET` : ''}`, commitUrl, titleText: `Build ${buildInfo.commit} · deployed ${builtLabel} ET` }}>
  // Append the build stamp below "by MK" — into the page footer (mobile) and
  // the rail's credit block (desktop). Done here (in the shared nav) so every
  // admin page gets it from one source of truth.
  (function stampFooter() {
    function inject() {
      document.querySelectorAll('.admin-footer, .sidenav-foot').forEach(function (footer) {
        if (footer.querySelector('.footer-version')) return;
        var span = document.createElement('span');
        span.className = 'footer-version';
        var a = document.createElement('a');
        a.href = commitUrl; a.target = '_blank'; a.rel = 'noopener';
        a.textContent = verText; a.title = titleText;
        span.appendChild(a);
        footer.appendChild(span);
      });
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', inject);
    else inject();
  })();
</script>
<script is:inline>
  // Resilience: if a /cdn-cgi/image/ thumbnail 404s (zone Image Transformations
  // disabled or over quota), swap the <img> to the raw R2 URL embedded in it.
  // Capture-phase listener covers every current and future cdn-cgi image.
  document.addEventListener('error', function (e) {
    var img = e.target;
    if (!img || img.tagName !== 'IMG' || img.dataset.cdnFallback) return;
    var m = /^(https?:\/\/[^/]+)\/cdn-cgi\/image\/[^/]+(\/.+)$/.exec(img.src);
    if (m) { img.dataset.cdnFallback = '1'; img.src = m[1] + m[2]; }
  }, true);
</script>
<script is:inline>
  (function pollMediaPoolCount() {
    const badges = [
      document.getElementById('mediaPoolBadge'),
      document.getElementById('mediaPoolBadgeMobile'),
    ].filter(Boolean);
    if (!badges.length) return;
    async function refresh() {
      try {
        const res = await fetch('/api/admin/media-pool/?count=1', { credentials: 'include' });
        if (!res.ok) return;
        const data = await res.json();
        const n = Number(data.count || 0);
        badges.forEach(b => {
          if (n > 0) { b.textContent = String(n); b.style.display = 'inline-flex'; }
          else { b.style.display = 'none'; }
        });
      } catch {}
    }
    // Expose so the pool page can force-refresh after deletes/assignments —
    // otherwise the badge lags up to 30s behind reality.
    window.refreshMediaPoolBadge = refresh;
    refresh();
    setInterval(refresh, 30000);
  })();
</script>
