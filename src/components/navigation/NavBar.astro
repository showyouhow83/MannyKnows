---
import Button from '../ui/Button.astro';
import { getCollection } from 'astro:content';
import { localAreas } from '../../data/localAreas';
import { plans } from '../../data/plans';
import { aiTeamSetupFee, team } from '../../data/aiTeam';
import { aiWebsiteSetupFee, aiWebsiteMonthly } from '../../data/aiWebsite';
import { PACKAGES } from '../../data/localSeo';
import { TIERS, APPS_HOURLY } from '../../data/apps';

// Prices in the search catalog interpolate from the canonical data files so a
// reprice can't strand them (Local SEO packages and Business Apps tiers moved
// into src/data/ in Aug 2026, so there are no hand-typed exceptions left).
const plan = (slug: string) => plans.find((p) => p.slug === slug);
const pp = (slug: string) => (plan(slug)?.price ?? 0).toLocaleString('en-US');
const tp = (slug: string, tier: string) => (plan(slug)?.tiers?.find((t) => t.name === tier)?.price ?? 0).toLocaleString('en-US');
const aiStaffFrom = Math.min(...team.filter((a) => a.price > 0).map((a) => a.price));
const getAheadWorth = ((plan('get-growing')?.price ?? 0) + 2 * (plan('business-ads')?.price ?? 0)).toLocaleString('en-US');

interface AnimationConfig {
  searchGradientEnabled?: boolean;
  debugMode?: boolean;
  searchScrollDelay?: number;
}

interface Props {
  className?: string;
  animationConfig?: AnimationConfig;
}

const { 
  className = "",
  animationConfig = {
    searchGradientEnabled: true,
    debugMode: false,
    searchScrollDelay: 0
  }
} = Astro.props;

// The four "offering" pages are grouped under one "Services" dropdown to keep
// the top bar uncluttered; everything else stays flat.
const offerings = [
  { href: "/services/", label: "Overview", desc: "How it all fits together" },
  { href: "/plans/", label: "Monthly Plans", desc: "Websites we build & run for you" },
  { href: "/ecommerce/", label: "Online Stores", desc: "Built, stocked & run for you" },
  { href: "/local-seo/", label: "SEO Services", desc: "Rank on Google & AI search" },
  { href: "/apps/", label: "Business Apps", desc: "Scripts, integrations & MCP servers" },
  { href: "/ai-team/", label: "AI Agents Team", desc: "AI agents ready to work" },
];
const primaryLinks = [
  { href: "/pricing/", label: "Pricing" },
  { href: "/#work", label: "Portfolio" },
  { href: "/about/", label: "About" },
  { href: "/blog/", label: "Blog" },
  { href: "/contact/", label: "Contact" },
];

// Site search index (pages + services + blog), built at request time.
const blogPosts = (await getCollection('blog')).filter((p) => !p.data.draft);
const searchIndex = [
  { title: "Home", description: "Web design & marketing for dental & medical practices, plus websites, SEO, AI agents, and software for every Western Massachusetts business.", url: "/", type: "Page" },
  { title: "Services", description: "Everything we do, in one place, plus the three ways to work with us: monthly (we run it), one-time projects (you own it), or co-owned builds (nothing upfront).", url: "/services/", type: "Page" },
  { title: "How it works", description: "How we get from the first call to working software — from friction to a finished app.", url: "/how-it-works/", type: "Page" },
  { title: "Remi AI, the AI Booking Agent", description: "Remi AI answers customers 24/7 in English or Spanish, captures every lead, and books jobs on Pro. Its own plans from $40/mo, on any website — or with a one-page site included.", url: "/ai-booking-agent/", type: "Page" },
  { title: "One-Page Website", description: `A fast one-page site with Remi AI answering customers and capturing leads, plus your 360° tour on your own domain. $${aiWebsiteSetupFee} to build, $${aiWebsiteMonthly}/mo to run.`, url: "/ai-website/", type: "Page" },
  { title: "Websites that improve themselves", description: "Why a site that checks itself daily, fixes what's safe on its own, and answers customers 24/7 beats a normal site that sits frozen. Included with every monthly plan.", url: "/plans/#why-smart", type: "Page" },
  { title: "Plans & pricing", description: `Four multilingual website plans from $${pp('get-found')}/mo: Get Found, Get Booked, Get Growing & Get Ahead, plus ads & full-agency services.`, url: "/plans/", type: "Page" },
  { title: "Get Found plan", description: `The starter tier gets you a custom-designed 1–3 page site, hosting, local ranking, a contact form, and Remi AI answering customers 24/7. $${pp('get-found')}/mo.`, url: "/plans/get-found/", type: "Page" },
  { title: "Get Booked plan", description: `Remi AI books the job into your calendar, with deeper local SEO and AI search optimization. $${pp('get-booked')}/mo.`, url: "/plans/get-booked/", type: "Page" },
  { title: "Get Growing plan", description: `The fully self-optimizing tier. Remi AI sells and steers people to the right service; the site writes and A/B tests its own content and keeps SEO tuned continuously. $${pp('get-growing')}/mo.`, url: "/plans/get-growing/", type: "Page" },
  { title: "Get Ahead plan", description: `Get Growing plus your ads run and managed on two networks, and a monthly working session with Manny. $${pp('get-ahead')}/mo for $${getAheadWorth} of service.`, url: "/plans/get-ahead/", type: "Page" },
  { title: "Online stores", description: `A Shopify store built, stocked, and run for you. Four tiers from $${pp('sell-online')}/mo plus your Shopify subscription. AI shopping assistant at the top tiers.`, url: "/ecommerce/", type: "Page" },
  { title: "Business Ads plan", description: `Social growth, managed Google & social ads, and SEO campaigns. $${tp('business-ads', 'Per Network')}/mo per network, or 4 major networks for $${tp('business-ads', 'Full Coverage')}/mo.`, url: "/plans/business-ads/", type: "Page" },
  { title: "Multimedia Agency plan", description: `One person, every role: development, design, SEO, photo, video, apps & software, with AI multiplying the output. $${pp('multimedia-agency')}/wk or $${tp('multimedia-agency', 'Agency Monthly')}/mo, everything on one retainer.`, url: "/plans/multimedia-agency/", type: "Page" },
  { title: "The AI Agents Team", description: `Manny AI, ready to work on your business: one manager that staffs AI specialists — chat agent (Remi AI), daily intel (Eve), copy (Elly), SEO (Nova), engagement (Finn) & reporting (Vera), plus sub-agents behind the scenes. $${aiTeamSetupFee} setup, AI staff from $${aiStaffFrom}/mo.`, url: "/ai-team/", type: "Page" },
  { title: "Portfolio", description: "Real sites we've designed and built for Western Mass businesses, case studies included.", url: "/#work", type: "Page" },
  { title: "About", description: "Who's behind MannyKnows — twenty years of enterprise engineering, based in Springfield.", url: "/about/", type: "Page" },
  { title: "Contact", description: "Send a message, email mm@mannyknows.com, or call (413) 361-8451.", url: "/contact/", type: "Page" },
  { title: "Free AI Website Analysis", description: "Send your site, get a clear report covering speed, SEO, mobile, conversions & AI-readiness. Free, no obligation.", url: "/free-ai-website-analysis/", type: "Page" },
  { title: "SEO Services", description: `SEO packages with monthly 360° photos, reviews collected & answered, and AI search optimization — ${PACKAGES.map((p) => `${p.name} $${p.price.toLocaleString('en-US')}/mo`).join(', ')} — plus one-time audits, migrations & virtual tours. Start with a free 360° photo. Included in every AI-powered website we build.`, url: "/local-seo/", type: "Page" },
  { title: "Business Apps", description: `Apps for how your business runs: ${TIERS.map((t) => `${t.name.toLowerCase()} from $${t.price.toLocaleString('en-US')}`).join(', ')}. Flat $${APPS_HOURLY}/hr, quoted up front.`, url: "/apps/", type: "Page" },
  // The niche pages were folded into the plans + the blog cluster (Aug 2026):
  // "dental"/"medical"/"practice" searches route to /plans/, where the plans
  // are sold with the practice framing; the how-to lives in the blog posts.
  { title: "Websites for Dental & Medical Practices", description: "Practice websites that answer patients 24/7, book into the schedule, and rank in your town — backed by hundreds of dental & medical practice sites designed, built, and launched.", url: "/plans/", type: "Page" },
  { title: "Websites for Contractors", description: "Sites that rank and book jobs for painters, remodelers & home-service contractors, with Remi AI booking estimates 24/7.", url: "/plans/", type: "Page" },
  { title: "Websites for Daycares", description: "Warm, trustworthy sites for daycares & childcare, with enrollment questions answered 24/7 by Remi AI.", url: "/plans/", type: "Page" },
  { title: "Pricing", description: "Every service on one page: website plans, stores, Remi AI, the AI Agents Team, SEO packages, apps, ads and the agency retainer, with what each costs.", url: "/pricing/", type: "Page" },
  ...localAreas.map((a) => ({ title: `Web design ${a.name} MA`, description: `Multilingual websites with AI booking agents for ${a.name} & Western Mass businesses.`, url: `/web-design-${a.slug}-ma/`, type: "Page" })),
  // "Launch your app" search entry removed with the IdeaLaunchpad modal (Aug 2026) — its /#launchpad anchor no longer exists.
  { title: "Blog", description: "Notes on automation, AI, and lead generation.", url: "/blog/", type: "Page" },
  ...blogPosts.map((p) => ({ title: p.data.title, description: p.data.description, url: `/blog/${p.id}/`, type: "Blog", tags: p.data.tags.join(" ") })),
];
---

<nav id="topNav" class={`bg-transparent min-h-[4.05rem] relative flex items-center border-b border-gray-300/30 dark:border-white/10 ${className}`}>
  <div class="max-w-[1440px] mx-auto px-2 w-full">
    <!-- Desktop Layout -->
    <div class="hidden xl:flex justify-between items-center w-full">
      <!-- Logo -->
      <div class="text-5xl font-black m-0" style="font-size: 3rem;">
        <a href="/" aria-label="MK — MannyKnows home" class="logo-gradient text-text-light-primary dark:text-text-dark-primary font-black transition-all duration-500 no-underline relative overflow-hidden inline-flex items-center gap-2 before:content-[''] before:absolute before:inset-0 before:bg-gradient-to-r before:from-transparent before:via-white/6 before:to-transparent before:-translate-x-full before:animate-subtle-shimmer before:pointer-events-none">
          <span>MK</span>
          <img src="/art/astronaut-rocket.webp" width="256" height="256" alt="MannyKnows astronaut mascot" decoding="async" class="h-11 w-11 object-contain shrink-0 -ml-5 nav-astro" />
        </a>
      </div>

      <!-- Navigation Menu -->
      <ul class="flex list-none gap-8 m-0 p-0 flex-1 justify-center ml-8 items-center">
        <!-- Services dropdown: groups the four offering pages under one item -->
        <li class="relative" data-nav-dropdown>
          <button
            type="button"
            data-nav-dropdown-toggle
            aria-haspopup="true"
            aria-expanded="false"
            class="group inline-flex items-center gap-1 bg-transparent border-none p-0 cursor-pointer font-medium"
          >
            <span class="nav-gradient text-text-light-primary dark:text-text-dark-primary transition-all duration-500">Services</span>
            <svg class="nav-caret w-3 h-3 text-text-light-secondary dark:text-text-dark-secondary transition-transform duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 9l6 6 6-6" /></svg>
          </button>
          <div class="nav-dropdown-menu" data-nav-dropdown-menu hidden role="menu">
            {offerings.map((o) => (
              <a href={o.href} role="menuitem">
                <span class="nav-dropdown-item-title">{o.label}</span>
                <span class="nav-dropdown-item-desc">{o.desc}</span>
              </a>
            ))}
          </div>
        </li>
        {primaryLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="nav-gradient text-text-light-primary dark:text-text-dark-primary font-medium transition-all duration-500 no-underline relative overflow-hidden before:content-[''] before:absolute before:inset-0 before:bg-gradient-to-r before:from-transparent before:via-white/6 before:to-transparent before:-translate-x-full before:animate-subtle-shimmer before:pointer-events-none"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>

      <!-- Search Bar (capped ~half width so it doesn't dominate the nav) -->
      <div class="relative flex items-center flex-1 max-w-sm mx-4">
        <label for="search-input" class="absolute -left-[10000px] opacity-0 pointer-events-none">Browse Services Catalog</label>
        <input
          id="search-input"
          type="search"
          placeholder="Browse services catalog..."
          class="bg-black/10 dark:bg-white/10 border border-border-light dark:border-border-dark rounded-lg py-3 pl-4 pr-10 text-text-light-primary dark:text-text-dark-primary text-sm w-full h-12 transition-all duration-300 backdrop-blur-lg placeholder:text-text-light-tertiary dark:placeholder:text-text-dark-tertiary focus:outline-none focus:border-primary-blue/50 focus:bg-black/20 dark:focus:bg-white/20 focus:shadow-[0_0_0_2px_rgba(16,209,255,0.2)]"
        />
        <button type="button" class="absolute right-2 bg-none border-none text-text-light-tertiary dark:text-text-dark-tertiary cursor-pointer p-1 rounded transition-colors duration-300 flex items-center justify-center hover:text-text-light-primary dark:hover:text-text-dark-primary" aria-label="AI Search">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 0l1.5 4.5L18 6l-4.5 1.5L12 12l-1.5-4.5L6 6l4.5-1.5L12 0z"/>
            <path d="M20 8l1 3 3 1-3 1-1 3-1-3-3-1 3-1 1-3z"/>
            <path d="M4 16l0.8 2.4L7.2 19.2l-2.4 0.8L4 22.4l-0.8-2.4L0.8 19.2l2.4-0.8L4 16z"/>
          </svg>
        </button>
        <div id="search-results" class="search-results" role="listbox" aria-label="Search results" hidden></div>
      </div>

      <!-- Navigation Actions -->
      <div class="flex items-center gap-2 relative ml-auto">
        <!-- Desktop light/dark toggle — drives the same themeToggle the
             settings modal owns, so persistence stays in one place. -->
        <button type="button" id="desktopThemeToggle" class="bg-black/10 dark:bg-white/10 border border-border-light dark:border-border-dark rounded-lg text-text-light-primary dark:text-text-dark-primary w-12 h-12 flex items-center justify-center cursor-pointer transition-all duration-300 hover:bg-black/20 dark:hover:bg-white/20" aria-label="Switch between light and dark mode" title="Light / dark mode">
          <svg class="hidden dark:block" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
          <svg class="block dark:hidden" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/></svg>
        </button>
        <!-- The idea launcher used to live here as a bulb icon. It now sits as a
             small FYI notice under the homepage's Latest projects section, where
             it has room to say what it is instead of relying on a tooltip. -->
        <button type="button" data-contact class="group bg-gradient-to-br from-green-500 via-emerald-500 to-green-600 bg-200 border border-green-400/30 rounded-lg text-white w-12 h-12 flex items-center justify-center cursor-pointer transition-all duration-300 relative overflow-hidden hover:shadow-[0_8px_25px_rgba(34,197,94,0.4)] animate-green-gradient-flow before:content-[''] before:absolute before:inset-0 before:bg-gradient-to-r before:from-transparent before:via-white/8 before:to-transparent before:-translate-x-full before:animate-green-shimmer" aria-label="Contact us" title="Contact us">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="relative z-10" aria-hidden="true">
            <rect x="2" y="4" width="20" height="16" rx="2"/>
            <path d="m22 7-10 6L2 7"/>
          </svg>
          <!-- Tooltip -->
          <div class="absolute top-full left-1/2 transform -translate-x-1/2 mt-2 px-3 py-2 bg-black dark:bg-white text-white dark:text-black text-sm whitespace-nowrap rounded opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50 shadow-lg pointer-events-none" role="tooltip">
            Contact us
          </div>
        </button>
      </div>
    </div>

    <!-- Mobile Layout -->
    <div class="flex xl:hidden items-center w-full h-16 px-0">
      <!-- Logo - 15% -->
      <div class="flex-[0_0_15%] flex items-center">
        <div class="text-3xl font-black m-0 leading-none" style="font-size: 1.875rem;">
          <a href="/" class="logo-gradient text-text-light-primary dark:text-text-dark-primary font-black transition-all duration-500 no-underline relative overflow-hidden before:content-[''] before:absolute before:inset-0 before:bg-gradient-to-r before:from-transparent before:via-white/6 before:to-transparent before:-translate-x-full before:animate-subtle-shimmer before:pointer-events-none">
            MK
          </a>
        </div>
      </div>

      <!-- Search Bar - 70% -->
      <div class="flex-[0_0_70%] flex items-center px-2">
        <div class="relative flex items-center w-full">
          <label for="search-input-mobile" class="absolute -left-[10000px] opacity-0 pointer-events-none">Browse Services Catalog</label>
          <input
            id="search-input-mobile"
            type="search"
            placeholder="Browse services catalog..."
            class="bg-black/10 dark:bg-white/10 border border-border-light dark:border-border-dark rounded-lg py-2 pl-3 pr-8 text-text-light-primary dark:text-text-dark-primary text-sm w-full h-10 transition-all duration-300 backdrop-blur-lg placeholder:text-text-light-tertiary dark:placeholder:text-text-dark-tertiary focus:outline-none focus:border-primary-blue/50 focus:bg-black/20 dark:focus:bg-white/20 focus:shadow-[0_0_0_2px_rgba(16,209,255,0.2)]"
          />
          <button type="button" class="absolute right-2 bg-none border-none text-text-light-tertiary dark:text-text-dark-tertiary cursor-pointer p-1 rounded transition-colors duration-300 flex items-center justify-center h-6 w-6 hover:text-text-light-primary dark:hover:text-text-dark-primary" aria-label="AI Search">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 0l1.5 4.5L18 6l-4.5 1.5L12 12l-1.5-4.5L6 6l4.5-1.5L12 0z"/>
              <path d="M20 8l1 3 3 1-3 1-1 3-1-3-3-1 3-1 1-3z"/>
              <path d="M4 16l0.8 2.4L7.2 19.2l-2.4 0.8L4 22.4l-0.8-2.4L0.8 19.2l2.4-0.8L4 16z"/>
            </svg>
          </button>
          <div id="search-results-mobile" class="search-results" role="listbox" aria-label="Search results" hidden></div>
        </div>
      </div>

      <!-- Hamburger Menu - 15% -->
      <div class="flex-[0_0_15%] flex justify-center items-center">
        <button
          type="button"
          id="mobile-menu-toggle"
          class="p-2 rounded-lg text-text-light-primary dark:text-text-dark-primary hover:bg-black/10 dark:hover:bg-white/10 transition-colors duration-300 flex items-center justify-center"
          aria-label="Toggle mobile menu"
          aria-expanded="false"
        >
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="hamburger-icon" aria-hidden="true">
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="close-icon hidden" aria-hidden="true">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Menu Overlay -->
  <div id="mobile-menu" class="fixed inset-0 z-50 xl:hidden transform translate-x-full transition-transform duration-300 ease-in-out">
    <!-- Light Glassmorphism Background -->
    <div id="mobile-menu-backdrop" class="absolute inset-0 bg-white/20 dark:bg-[#0a0a14]/40 backdrop-blur-xl"></div>
    
    <!-- Menu Content -->
    <div class="relative h-full w-[95%] ml-auto flex flex-col bg-white/90 dark:bg-[#0a0a14]/90 backdrop-blur-xl border-l border-gray-300/30 dark:border-white/20 shadow-xl">
      <!-- Header with Close Button -->
      <div class="flex items-center justify-between p-6 border-b border-gray-200 dark:border-gray-700">
        <a href="/" aria-label="MK — MannyKnows home" class="logo-gradient inline-flex items-center gap-2 text-2xl font-black text-text-light-primary dark:text-text-dark-primary no-underline">
          MK
          <img src="/art/astronaut-rocket.webp" width="256" height="256" alt="MannyKnows astronaut mascot" decoding="async" class="h-9 w-9 object-contain shrink-0 -ml-4 nav-astro" />
        </a>
        <button
          type="button"
          id="mobile-menu-close"
          class="p-2 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors duration-200"
          aria-label="Close mobile menu"
        >
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-text-light-primary dark:text-text-dark-primary" aria-hidden="true">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
      
      <!-- Navigation Links -->
      <div class="px-4 py-4 space-y-1">
        <!-- Services dropdown — same items as the desktop dropdown, loaded open -->
        <button
          type="button"
          id="mobileServicesToggle"
          class="w-full flex items-center justify-between py-1 bg-transparent border-none cursor-pointer"
          aria-expanded="true"
          aria-controls="mobileServicesPanel"
        >
          <span class="text-base font-semibold text-text-light-primary dark:text-text-dark-primary">Services</span>
          <svg id="mobileServicesChevron" class="w-4 h-4 text-text-light-tertiary dark:text-text-dark-tertiary transition-transform duration-200" style="transform: rotate(180deg);" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <polyline points="6,9 12,15 18,9"></polyline>
          </svg>
        </button>
        <div id="mobileServicesPanel" class="ml-1 pl-3 border-l border-gray-200 dark:border-gray-700 space-y-2 pb-1">
          {offerings.map((o) => (
            <a
              href={o.href}
              class="mobile-nav-link block hover:text-primary-blue dark:hover:text-primary-blue transition-colors duration-200"
            >
              <span class="block text-base font-medium text-text-light-primary dark:text-text-dark-primary">{o.label}</span>
              <span class="block text-xs text-text-light-tertiary dark:text-text-dark-tertiary">{o.desc}</span>
            </a>
          ))}
        </div>
        <div class="h-px bg-gray-200 dark:bg-gray-700 my-3"></div>
        {primaryLinks.map((link) => (
          <a
            href={link.href}
            class="mobile-nav-link block text-base font-medium text-text-light-primary dark:text-text-dark-primary hover:text-primary-blue dark:hover:text-primary-blue transition-colors duration-200"
          >
            {link.label}
          </a>
        ))}
      </div>
      
      <!-- Action Buttons -->
      <div class="p-6 border-t border-gray-200 dark:border-gray-700 space-y-3">
        
        <!-- Settings Section -->
        <div class="mt-6">
          <!-- Settings Toggle Button -->
          <button
            type="button"
            id="mobileSettingsToggle"
            class="group w-full p-3 bg-gray-100/50 dark:bg-gray-800/50 hover:bg-gray-200/50 dark:hover:bg-gray-700/50 rounded-lg border border-gray-200 dark:border-gray-600 transition-all duration-200 flex items-center justify-between"
            aria-label="Open user preferences"
            title="User preferences"
          >
            <div class="flex items-center gap-3">
              <!-- User Preferences Icon -->
