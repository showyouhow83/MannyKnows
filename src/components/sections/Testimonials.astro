---
// Testimonials — a sliding carousel of the real client quotes (from
// src/data/testimonials.ts). Renders NOTHING while the list is empty, so it can
// sit mounted on the homepage until real quotes exist. Uses the site's global
// Swiper (loaded in BaseLayout) with the redesigned QuoteBlock card.
import { testimonials as realTestimonials, type Testimonial } from '../../data/testimonials';
import QuoteBlock from '../ui/QuoteBlock.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import Section from '../layout/Section.astro';
import Container from '../layout/Container.astro';

interface Props {
  items?: Testimonial[];
  heading?: string;
  /** Header scale: the homepage passes "hero" so this matches its other
      statement headers; interior pages keep the default section scale. */
  size?: 'section' | 'hero';
}

const { items = realTestimonials, heading = 'What clients say', size = 'section' } = Astro.props;
---

{items.length > 0 && (
  <Section id="testimonials" variant="alternate" className="room room-violet" hasOverflow>
    <!-- Telescope astronaut observing the reviews from the right corner.
         30 KB transparent WebP (2x): tweak size/offsets on the img classes. -->
    <img
      src="/mascot/astronaut-telescope.webp"
      alt="Astronaut mascot looking through a telescope"
      aria-hidden="true"
      width="838"
      height="847"
      loading="lazy"
      decoding="async"
      class="block absolute bottom-0 left-4 w-[110px] h-auto pointer-events-none z-10 -scale-x-100"
    />
    <Container className="relative">
      <SectionHeader size={size} badge={size === 'hero' ? 'Testimonials' : undefined} title={heading} />

      <div class="relative px-0 sm:px-12">
        <div class="swiper testimonials-swiper">
          <div class="swiper-wrapper">
            {items.map((t) => (
              <div class="swiper-slide"><QuoteBlock quote={t} class="h-full" /></div>
            ))}
          </div>
          <div class="swiper-pagination"></div>
        </div>

        {/* Prev/next: token classes (surface, hairline border, blue hover);
            only the positioning lives in the CSS below. */}
        <button type="button" class="t-nav t-prev hidden sm:flex items-center justify-center h-11 w-11 rounded-full bg-white dark:bg-dark-secondary border border-light-tertiary dark:border-dark-accent text-text-light-secondary dark:text-text-dark-secondary shadow-lg shadow-primary-blue/10 hover:text-primary-blue dark:hover:text-blue-300 hover:border-primary-blue/40 transition-colors cursor-pointer" aria-label="Previous testimonial">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"></polyline></svg>
        </button>
        <button type="button" class="t-nav t-next hidden sm:flex items-center justify-center h-11 w-11 rounded-full bg-white dark:bg-dark-secondary border border-light-tertiary dark:border-dark-accent text-text-light-secondary dark:text-text-dark-secondary shadow-lg shadow-primary-blue/10 hover:text-primary-blue dark:hover:text-blue-300 hover:border-primary-blue/40 transition-colors cursor-pointer" aria-label="Next testimonial">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"></polyline></svg>
        </button>
      </div>
    </Container>

    {/* Swiper's assets load HERE, not in BaseLayout — this is the only Swiper
        consumer, and loading globally cost every other page 151 KB of JS.
        The init below already polls for window.Swiper, so late arrival is fine. */}
    <link rel="stylesheet" href="/swiper-bundle.min.css" media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href="/swiper-bundle.min.css" /></noscript>
    <script is:inline>
      // Swiper's ~140KB bundle used to load with `defer`, costing ~300ms of
      // parse/eval inside the load window on every page with testimonials —
      // for a carousel far below the fold. It now loads only when the section
      // is within 600px of the viewport (or at idle after load, whichever
      // first), so first paint never pays for it.
      (function () {
        var injected = false;
        function loadSwiper() {
          if (injected) return; injected = true;
          var s = document.createElement('script');
          s.src = '/swiper-bundle.min.js';
          s.onload = initTestimonials;
          document.head.appendChild(s);
        }
        function watch() {
          var el = document.querySelector('.testimonials-swiper');
          if (!el) return;
          if (!('IntersectionObserver' in window)) { loadSwiper(); return; }
          var io = new IntersectionObserver(function (entries) {
            for (var i = 0; i < entries.length; i++) {
              if (entries[i].isIntersecting) { io.disconnect(); loadSwiper(); }
            }
          }, { rootMargin: '600px' });
          io.observe(el);
          // fallback: fetch at idle after load so deep-linked or non-scrolling
          // visitors still get a working carousel
          addEventListener('load', function () {
            (window.requestIdleCallback || function (fn) { setTimeout(fn, 2000); })(loadSwiper);
          }, { once: true });
        }
        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', watch);
        else watch();

        function initTestimonials() {
          if (typeof Swiper === 'undefined') { setTimeout(initTestimonials, 100); return; }
          var el = document.querySelector('.testimonials-swiper');
          if (!el || el.swiper) return;
          new Swiper('.testimonials-swiper', {
            slidesPerView: 1.15,
            spaceBetween: 24,
            rewind: true,
            grabCursor: true,
            autoplay: { delay: 5000, disableOnInteraction: false, pauseOnMouseEnter: true },
            pagination: { el: '.testimonials-swiper .swiper-pagination', clickable: true },
            navigation: { nextEl: '.t-next', prevEl: '.t-prev' },
            breakpoints: {
              640: { slidesPerView: 1.8 },
              1024: { slidesPerView: 2.4 },
              1440: { slidesPerView: 3 },
            },
          });
        }
      })();
    </script>

  </Section>
)}

{/* Top-level (not inside the expression above) so Astro runs it through
    Tailwind: the @apply lines below need that. Global because Swiper builds
    the bullets at runtime. */}
<style is:global>
  .testimonials-swiper { padding-bottom: 3rem; }
  .testimonials-swiper .swiper-wrapper { align-items: stretch; }
  .testimonials-swiper .swiper-slide { height: auto; display: flex; }
  .testimonials-swiper .swiper-pagination { bottom: 0 !important; }
  /* 24×24 tap targets (WCAG 2.5.8): the visible 9px dot sits inside a
     transparent border; background-clip keeps the border invisible. */
  .testimonials-swiper .swiper-pagination-bullet {
    width: 23px; height: 23px;
    @apply bg-light-tertiary dark:bg-dark-accent;
    border: 7px solid transparent; background-clip: padding-box;
    opacity: 1; transition: width .3s ease, background .3s ease;
    margin: 0 1px !important;
  }
  .testimonials-swiper .swiper-pagination-bullet-active {
    width: 40px; border-radius: 12px;
    @apply bg-gradient-to-br from-primary-blue to-primary-pink;
    background-clip: padding-box;
  }
  /* Positioning only — the look is Tailwind classes on the buttons. */
  .t-nav { position: absolute; top: calc(50% - 1.5rem); transform: translateY(-50%); z-index: 10; }
  .t-prev { left: 0; }
  .t-next { right: 0; }
  .t-nav.swiper-button-disabled { opacity: 0.35; pointer-events: none; }
</style>
