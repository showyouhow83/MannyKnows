---
// HeroSwiper.astro — homepage hero carousel.
// A custom "vanilla" coverflow carousel (NO Swiper / no third-party slider),
// modeled on the slpainting.co hero: a large centered slide with two scaled,
// faded slides peeking on each side; 8s autoplay, hover/tab pause, drag + swipe,
// infinite wrap-around. Behavior constants live in the inline <script> below.

export interface Slide {
  // Either an Unsplash photo base URL (no query params) or a local derivative
  // base like '/hero/remi-books-the-job' — see the resizing note further down.
  image: string;
  title: string;        // <= 34 chars
  description?: string; // <= 120 chars
  href?: string;        // click target for the centered slide
  // Alt text for the photo. Falls back to `title`, which is fine for a stock
  // photo but not for a real scene — describe what's shown instead.
  alt?: string;
}

export interface Props {
  slides?: Slide[];
}

// Default slides — the four monthly plans plus the AI Team. Five slides is the
// clean minimum for a 2-per-side coverflow (every slide holds a unique position,
// so the wrap-around never has to show one slide in two places).
const defaultSlides: Slide[] = [
  {
    image: '/hero/online-store-built-to-sell',
    alt: 'A maker’s table of products (mugs, folded shirts, a cap) with a storefront interface floating above it, the scene shifting from daylight to night as orders, shipping, and sales reports keep running.',
    title: 'An online store built to sell',
    description: 'A full online store, designed, themed, and optimized to sell, built on years of eCommerce experience.',
    href: '/ecommerce/',
  },
  {
    image: '/hero/your-ai-team-ready-to-hire',
    alt: 'One job moving down the AI Team assembly line: a product handed in at intake, routed by Manny to research, copywriting, and video editing, and coming out the other end as a finished post ready to publish.',
    title: 'Your AI team, ready to hire',
    description: 'Sales, research, copy, graphics, voice: AI agents built around your business, run on demand.',
    href: '/ai-team/',
  },
  {
    image: '/hero/remi-books-the-job',
    alt: 'A contractor leaning against a work truck, phone in hand, as notifications confirm Remi AI booked a job for Tuesday, captured a new lead, and tuned the site’s speed and SEO.',
    title: 'Get Found. Get Booked. Get Growing.',
    description: 'AI-Powered Websites that answer customers 24/7, book the work, and improve themselves, built, hosted, and maintained for you.',
    href: '/plans/',
  },
  {
    image: '/hero/your-full-media-tech-team',
    alt: 'An empty multimedia studio still at work: wall and desk screens running front-desk, analytics, calendar, and map dashboards beside whiteboards of SEO plans, with nobody in the room.',
    title: 'Every role. One person.',
    description: 'Manny, a developer on demand, covers photo, video, design, SEO, apps & software, with AI multiplying the output.',
    href: '/plans/multimedia-agency/',
  },
  {
    image: '/hero/business-ads-that-bring-the-work',
    alt: 'A laptop screen showing an ad-campaign dashboard: revenue and conversion charts climbing across the month, with traffic and session panels below.',
    title: 'Business Ads that bring the work',
    description: 'Social media, Google & social ads, SEO, and your Google Business Profile: get seen everywhere.',
    href: '/plans/business-ads/',
  },
];

const { slides = defaultSlides } = Astro.props;

// Two kinds of slide image, and they resize differently.
//
// Remote (Unsplash) URLs get their own query-param crops: 16:9, desktop
// 1200×675, mobile 640×360. Those params only work on Unsplash's CDN.
//
// Local images are self-hosted 16:9 derivatives sitting at
// public/hero/<base>-<width>.{avif,webp} with a -1280.jpg fallback. Self-hosting
// matters here: the first slide is the LCP element, so a third-party request in
// front of it costs real Lighthouse points. Regenerate derivatives with sharp
// (widths below) if you add one — don't drop a multi-megabyte original in
// public/ and point at it directly.
const isLocal = (src: string) => src.startsWith('/');
const LOCAL_WIDTHS = [640, 960, 1280, 1600];
const localSrcset = (base: string, ext: string) =>
  LOCAL_WIDTHS.map((w) => `${base}-${w}.${ext} ${w}w`).join(', ');
const LOCAL_SIZES = '(min-width: 768px) 1200px, 100vw';
const desktopSrc = (base: string) => `${base}?w=1200&h=675&fit=crop&crop=entropy&q=62&auto=format`;
const mobileSrc = (base: string) => `${base}?w=640&h=360&fit=crop&crop=entropy&q=60&auto=format`;
---

<section class="hero-carousel-section">
  <div class="hero-carousel" id="heroCarousel" aria-roledescription="carousel" aria-label="Featured plans and services">
    <div class="hero-track" id="heroTrack">
      {slides.map((slide, i) => (
        <a
          class="hero-slide"
          data-index={i}
          href={slide.href ?? '#'}
          aria-label={slide.title}
          draggable="false"
        >
          <picture>
            {isLocal(slide.image) ? (
              <>
                <source type="image/avif" srcset={localSrcset(slide.image, 'avif')} sizes={LOCAL_SIZES} />
                <source type="image/webp" srcset={localSrcset(slide.image, 'webp')} sizes={LOCAL_SIZES} />
              </>
            ) : (
              <source media="(min-width: 768px)" srcset={desktopSrc(slide.image)} />
            )}
            <img
              src={isLocal(slide.image) ? `${slide.image}-1280.jpg` : mobileSrc(slide.image)}
              alt={slide.alt ?? slide.title}
              width="1200"
              height="675"
              draggable="false"
              loading={i === 0 ? 'eager' : 'lazy'}
              fetchpriority={i === 0 ? 'high' : undefined}
              decoding="async"
            />
          </picture>
          <div class="hero-slide-content">
            <h2>{slide.title}</h2>
            {slide.description && <p>{slide.description}</p>}
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    var carousel = document.getElementById('heroCarousel');
    var track = document.getElementById('heroTrack');
    if (!carousel || !track) return;

    // Anchors + images are natively draggable; that hijacks the pointer and kills
    // both custom swipe and click-through. Suppress the browser's own drag.
    track.addEventListener('dragstart', function (e) { e.preventDefault(); });
    var slides = Array.prototype.slice.call(track.querySelectorAll('.hero-slide'));
    var n = slides.length;
    if (!n) return;

    // --- behavior constants (match slpainting.co) ---
    var AUTOPLAY_DELAY = 8000;
    var SIDE_SLIDES = 2;
    var SCALE_STEP = 0.3;    // center 1.0 → ±1 0.7 → ±2 0.4
    var OPACITY_STEP = 0.35; // center 1.0 → ±1 0.65 → ±2 0.30
    var TRANSLATE_FACTOR = 0.55;
    var SWIPE_THRESHOLD = 50;
    var DRAG_DETECT = 10;

    var current = 0;
    var timer = null;

    // shortest signed distance from `current` to slide `i`, wrapping around
    function offsetOf(i) {
      var o = i - current;
      if (o > n / 2) o -= n;
      if (o < -n / 2) o += n;
      return o;
    }

    var slideW = 0; // cached: reading offsetWidth in render() forced a reflow per call
    function render() {
      var w = slideW || (slideW = slides[0].offsetWidth || track.offsetWidth || 1);
      for (var i = 0; i < n; i++) {
        var el = slides[i];
        var o = offsetOf(i);
        var a = Math.abs(o);
        if (a > SIDE_SLIDES) {
          el.style.opacity = '0';
          el.style.transform = 'translateX(-50%) scale(0)';
          el.style.zIndex = '0';
          el.style.pointerEvents = 'none';
          el.setAttribute('aria-hidden', 'true');
          el.tabIndex = -1;
          el.classList.remove('is-center');
          continue;
        }
        var translate = o * w * TRANSLATE_FACTOR;
        el.style.transform = 'translateX(calc(-50% + ' + translate + 'px)) scale(' + (1 - a * SCALE_STEP) + ')';
        el.style.opacity = a === 0 ? '1' : String(1 - a * OPACITY_STEP);
        el.style.zIndex = a === 0 ? '10' : a === 1 ? '5' : '2';
        el.style.pointerEvents = a <= 1 ? 'auto' : 'none';
        el.setAttribute('aria-hidden', a === 0 ? 'false' : 'true');
        el.tabIndex = a === 0 ? 0 : -1;
        if (o === 0) el.classList.add('is-center');
        else el.classList.remove('is-center');
      }
    }

    function goTo(i) { current = ((i % n) + n) % n; render(); restart(); }
    function next() { goTo(current + 1); }
    function prev() { goTo(current - 1); }

    function play() { if (!timer) timer = setInterval(next, AUTOPLAY_DELAY); }
    function pause() { if (timer) { clearInterval(timer); timer = null; } }
    function restart() { pause(); play(); }

    // click: the centered slide follows its link; a side slide navigates to it
    slides.forEach(function (el, i) {
      el.addEventListener('click', function (e) {
        if (offsetOf(i) !== 0) { e.preventDefault(); goTo(i); }
      });
    });

    // drag / swipe — pointer events cover mouse + touch. We deliberately do NOT
    // use setPointerCapture: capturing the pointer to the track steals the click
    // from the slide <a>, so taps would neither navigate nor re-center. Track the
    // move on window instead (mouse has no implicit capture; touch bubbles up).
    var startX = 0, dx = 0, dragging = false, moved = false;
    track.addEventListener('pointerdown', function (e) {
      if (e.button != null && e.button !== 0) return; // primary button only
      dragging = true; moved = false; startX = e.clientX; dx = 0;
      pause();
    });
    window.addEventListener('pointermove', function (e) {
      if (!dragging) return;
      dx = e.clientX - startX;
      if (Math.abs(dx) > DRAG_DETECT) moved = true;
    });
    window.addEventListener('pointerup', function () {
      if (!dragging) return;
      dragging = false;
      if (Math.abs(dx) > SWIPE_THRESHOLD) { dx < 0 ? next() : prev(); }
      else { play(); }
      // a real drag (not a tap) — swallow the click that immediately follows so
      // it doesn't navigate; a plain tap leaves the click alone.
      if (moved) {
        var blocker = function (ev) { ev.preventDefault(); ev.stopPropagation(); };
        track.addEventListener('click', blocker, true);
        setTimeout(function () { track.removeEventListener('click', blocker, true); }, 60);
      }
    });
    window.addEventListener('pointercancel', function () { if (dragging) { dragging = false; play(); } });

    // pause on hover and when the tab is hidden
    carousel.addEventListener('mouseenter', pause);
    carousel.addEventListener('mouseleave', play);
    document.addEventListener('visibilitychange', function () { document.hidden ? pause() : play(); });

    // keyboard: left/right when the carousel has focus within
    carousel.addEventListener('keydown', function (e) {
      if (e.key === 'ArrowLeft') { e.preventDefault(); prev(); }
      else if (e.key === 'ArrowRight') { e.preventDefault(); next(); }
    });

    window.addEventListener('resize', function () { slideW = 0; render(); });

    // first paint without the 0.6s transition so slides don't fly out from center
    track.classList.add('no-anim');
    render();
    requestAnimationFrame(function () {
      requestAnimationFrame(function () { track.classList.remove('no-anim'); });
    });
    play();
  })();
</script>

<style>
  .hero-carousel-section {
    width: 100%;
    padding: 0.5rem 0 2rem;
  }

  .hero-carousel {
    position: relative;
    max-width: 1920px;
    margin: 0 auto;
    overflow: hidden;
    /* Slides keep a 350px minimum height (per Manny): the old
       clamp(110px, 15.5vw, 283px) rendered a 110px strip on phones. Images are
       16:9 with object-fit: cover, so taller slides crop the sides on narrow
       screens; hero art should keep its subject near the center. */
    height: clamp(350px, 24vw, 460px);
  }

  .hero-track {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .hero-slide {
    position: absolute;
    top: 0;
    left: 50%;
    width: clamp(300px, 55vw, 1000px);
    max-width: calc(100% - 48px);
    height: 100%;
    transform: translateX(-50%);
    transform-origin: center center;
    border-radius: 16px;
    overflow: hidden;
    display: block;
    text-decoration: none;
    background: #18212b;
    opacity: 0;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
    transition: transform 0.6s cubic-bezier(0.25, 0.1, 0.25, 1),
                opacity 0.6s cubic-bezier(0.25, 0.1, 0.25, 1),
                box-shadow 0.6s cubic-bezier(0.25, 0.1, 0.25, 1);
    will-change: transform, opacity;
    user-select: none;
    -webkit-user-select: none;
    -webkit-user-drag: none;
    touch-action: pan-y;
  }

  /* Pre-JS fallback: show the first slide centered (it's the LCP element). */
  .hero-slide:first-child { opacity: 1; z-index: 10; }

  .hero-track.no-anim .hero-slide { transition: none !important; }

  .hero-slide.is-center { box-shadow: 0 0 30px rgba(0, 0, 0, 0.5); cursor: pointer; }

  .hero-slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: 16px;
    pointer-events: none;
    -webkit-user-drag: none;
  }

  .hero-slide-content {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 48px 24px 20px;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.8), rgba(0, 0, 0, 0.5) 50%, transparent);
    border-radius: 0 0 16px 16px;
    color: #fff;
    pointer-events: none;
  }

  .hero-slide-content h2 {
    margin: 0;
    font-size: 22px;
    font-weight: 700;
    line-height: 1.2;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.4);
    transition: color 0.3s ease;
  }

  /* Split by viewport (Manny): desktop leads with the description, the title
     repeats what the imagery already says; mobile gets only the short title.
     Lives here (not as utility classes on the markup) because these scoped
     selectors out-specify Tailwind's `hidden`. The mobile half sits in the
     existing max-width block further down. */
  @media (min-width: 769px) {
    .hero-slide-content h2 { display: none; }
    .hero-slide-content p { margin-top: 0; }
  }

  .hero-slide.is-center:hover .hero-slide-content h2 { color: #10d1ff; }

  .hero-slide-content p {
    margin: 8px 0 0;
    font-size: 14px;
    font-weight: 400;
    line-height: 1.4;
    text-align: center;
    color: rgba(255, 255, 255, 0.85);
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
  }

  .hero-slide:focus-visible { outline: 3px solid #10d1ff; outline-offset: 3px; }

  /* Tablet */
  @media (max-width: 768px) {
    .hero-carousel { height: 34vw; } /* +35% per Manny (was 25vw) */
    .hero-slide { width: 85vw; }
    .hero-slide-content { padding: 30px 18px 18px; }
    .hero-slide-content p { display: none; }
  }

  /* Small mobile */
  @media (max-width: 480px) {
    .hero-carousel { height: 270px; } /* +35% per Manny (was 200px) */
    .hero-slide { width: calc(100% - 16px); }
    .hero-slide-content { padding: 24px 14px 14px; }
    .hero-slide-content h2 { font-size: 1rem; }
    .hero-slide-content p { font-size: 13px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-slide { transition: opacity 0.3s ease; }
  }
</style>
