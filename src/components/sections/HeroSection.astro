---
export interface Props {
  title: string;
  highlightedText: string;
  /** Text rendered after the highlighted span (e.g. ", less busywork, for Western Mass contractors."). */
  titleAfter?: string;
  subtitle: string;
  /** Optional small pill shown above the headline (e.g. a location / niche tag). */
  badge?: string;
  className?: string;
}

const { title, highlightedText, titleAfter = "", subtitle, badge, className = "" } = Astro.props;
---

<section id="hero" class={`pb-6 md:pb-8 text-center apple-gradient-container ${className}`}>
  <div class="max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8">
    {/* This div's old `max-w-16xl` class was never defined in Tailwind, so the
        title has always wrapped at the outer 1440px container. That 1440px is
        the site-wide hero-title width: interior page heroes match it. */}
    <div class="mx-auto">
      {badge && (
        <span class="inline-block bg-gradient-to-r from-primary-blue/10 via-purple-500/10 to-primary-pink/10 text-primary-blue px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider mb-4">
          {badge}
        </span>
      )}
      {/* Homepage hero scale: a fluid clamp (1.7rem → 6vw → 4.5rem) instead of
          the interior h1 steps; ≤639px the global mobile rule sets it to 2rem. */}
      <h1 class="sf-bold text-[clamp(1.7rem,6vw,4.5rem)] mb-4 sm:mb-6 apple-headline">
        <!-- Whole heading is gradient — house rule (Manny, Aug 2026): no more
             white/gradient splits inside titles. -->
        <!-- highlightedText is trusted site copy rendered as HTML so it can
             carry responsive breaks like <br class="sm:hidden" />. -->
        <span class="apple-gradient-text" data-colorful-title>{title && <>{title} </>}<span set:html={highlightedText} />{titleAfter}</span>
      </h1>
      <p class="sf-regular text-base sm:text-xl mb-0 text-text-light-secondary dark:text-text-dark-secondary apple-body-text max-w-3xl mx-auto">
        {subtitle}
      </p>
    </div>
  </div>
</section>
