---
// ProcessSectionAlt.astro - AI Transformation Process (3 Steps Horizontal)
// SLPainting layout with MannyKnows styling
import Section from '../layout/Section.astro';
import Container from '../layout/Container.astro';

export interface Props {
  className?: string;
}

const { className = '' } = Astro.props;

// The rotating end of "From process to …" — real things we build, nothing invented.
const rotatingWords = [
  'Mobile apps',
  'Websites that rank',
  'Online stores',
  'Web applications',
  'Smart Websites',
  'AI agents that book jobs',
];

const processSteps = [
  {
    number: "1",
    title: "Tell us what's slowing you down",
    description: "One short call or message. We look at how the work actually comes in, what eats your time, and what customers around you are searching for."
  },
  {
    number: "2",
    title: "We build the fix",
    description: "A website, store, or app built around how you work — with your own admin to run it, Remi answering customers 24/7, and English + Spanish as standard. You see it and approve it before it goes live."
  },
  {
    number: "3",
    title: "It keeps earning its keep",
    description: "Plans run monthly, so the work never stops: the site tunes its own speed and SEO, every lead lands in your admin, and you get a monthly report of what changed. Need something new? You'll see a preview before anything ships."
  }
];
---

<Section id="process" variant="default" hasOverflow={true} className={className}>
  <Container className="relative z-10">
    <!-- Header with rotating word (same look as SectionHeader, custom h2) -->
    <div class="text-center mb-20">
      <div class="mb-4">
        <span class="section-badge inline-block bg-gradient-to-r from-primary-blue/10 via-purple-500/10 to-primary-pink/10 text-primary-blue dark:text-primary-blue px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider">
          How it works
        </span>
      </div>
      <h2 class="sf-bold apple-headline text-text-light-primary dark:text-text-dark-primary text-4xl md:text-6xl lg:text-7xl mb-6">
        <span class="apple-gradient-text" data-colorful-title>From process to</span>
        <span id="processRotator" class="block apple-gradient-text min-h-[1.25em] transition-all duration-300" aria-live="off">{rotatingWords[0]}</span>
      </h2>
      <p class="text-base sm:text-xl text-text-light-secondary dark:text-text-dark-secondary max-w-3xl mx-auto leading-relaxed">
        The quote that eats your evenings becomes a form that prices itself. The schedule you juggle over text becomes an app your crew opens every morning. The store you keep meaning to open starts taking orders while you sleep. Bring us the process that's slowing you down — we map it on the first call, then build the software that runs it for you. Monthly plans start at $95; custom apps get scoped on that same call.
      </p>
    </div>

    <script is:inline define:vars={{ rotatingWords }}>
      // Rotate the headline's last word. Skips the motion (but still swaps
      // words) when the visitor prefers reduced motion.
      (function () {
        const el = document.getElementById('processRotator');
        if (!el) return;
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        let i = 0;
        setInterval(function () {
          i = (i + 1) % rotatingWords.length;
          if (reduced) { el.textContent = rotatingWords[i]; return; }
          el.style.opacity = '0';
          el.style.transform = 'translateY(0.35em)';
          setTimeout(function () {
            el.textContent = rotatingWords[i];
            el.style.opacity = '1';
            el.style.transform = 'translateY(0)';
          }, 280);
        }, 2400);
      })();
    </script>

    <!-- Horizontal 3-Step Process (SLPainting Layout) -->
    <div class="steps-grid grid grid-cols-1 md:grid-cols-3 gap-12 lg:gap-16 max-w-6xl mx-auto">
      {processSteps.map((step, index) => (
        <div class="step-item relative flex flex-col items-center text-center" data-step={index}>
          <div class="step-number" aria-hidden="true">
            {step.number}
          </div>

          <h3 class="step-title">{step.title}</h3>

          <p class="step-description text-sm lg:text-base text-text-light-secondary dark:text-white/80 leading-relaxed">
            {step.description}
          </p>
        </div>
      ))}
    </div>
  </Container>
</Section>

<style>
  /* Step Grid Layout */
  .steps-grid {
    margin-top: -2rem;
  }

  /* Step item styling */
  .step-item {
    padding: 1rem;
    position: relative;
  }

  /* Number styling - Apple-style gradient animation */
  .step-number {
    position: relative;
    font-size: 180px;
    font-weight: 900;
    line-height: 0.8;
    margin: 0;

    /* MK gradient: blue to pink (no light blue) */
    background: linear-gradient(90deg, #0071e3, #ff4faa);
    background-size: 400% 100%;
    animation: numberGradientFlow 35s ease-in-out infinite;

    /* Gradient text */
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;

    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  @keyframes numberGradientFlow {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }

  /* Step title styling */
  .step-title {
    font-size: 1.25rem;
    font-weight: 700;
    margin-top: 1.5rem;
    position: relative;
    z-index: 1;
    max-width: 260px;
    line-height: 1.3;
    color: #1f2937;
  }

  :global(.dark) .step-title {
    color: #ffffff;
  }

  /* Step description — always visible, sits under the title */
  .step-description {
    margin-top: 0.75rem;
    max-width: 320px;
  }

  /* Responsive adjustments */
  @media (min-width: 768px) {
    .step-number {
      font-size: 200px;
      line-height: 1;
    }

    .step-title {
      font-size: 1.5rem;
      margin-top: 2rem;
    }
  }

  @media (max-width: 767px) {
    .step-item {
      padding-bottom: 1rem;
    }

    .step-number {
      font-size: 140px;
    }
  }

  /* Entrance animation */
  .step-item {
    opacity: 0;
    transform: translateY(20px);
    animation: stepFadeIn 0.6s ease forwards;
  }

  .step-item:nth-child(1) { animation-delay: 0.1s; }
  .step-item:nth-child(2) { animation-delay: 0.2s; }
  .step-item:nth-child(3) { animation-delay: 0.3s; }

  @keyframes stepFadeIn {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
