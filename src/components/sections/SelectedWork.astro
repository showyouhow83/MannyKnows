---
// Selected Work grid — real client sites + capability projects as cards.
// Items with a `url` link out to the live site; items without one (e.g. internal
// automation projects) render as a non-clickable card. Data: src/data/selectedWork.ts.
import { selectedWork } from '../../data/selectedWork';

// Responsive screenshots: pre-generated AVIF + WebP variants live at
// public/works/<base>-<width>.<ext> for each width below (built with sharp).
// The homepage is server-rendered, so we hand-write <picture> rather than use
// astro:assets (which only pre-optimizes images on prerendered pages).
const WORK_WIDTHS = [400, 640, 960, 1280];
const workSrcset = (base: string, ext: 'avif' | 'webp') =>
  WORK_WIDTHS.map((w) => `/works/${base}-${w}.${ext} ${w}w`).join(', ');
// Card renders at ~30vw (3-col) on desktop, ~45vw (2-col) on tablets, ~92vw on phones.
const WORK_SIZES = '(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 92vw';

const initial = (name: string) => name.trim().charAt(0).toUpperCase();
const host = (url: string) => url.replace(/^https?:\/\//, '').replace(/\/+$/, '');
const baseCard =
  'group flex flex-col bg-white dark:bg-dark-secondary border border-light-tertiary dark:border-dark-accent rounded-xl overflow-hidden transition-all duration-300';
---

<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
  {selectedWork.map((item) => {
    // A finished case study wins: link internally to /work/<slug>. Otherwise fall
    // back to the live site (external), or a non-clickable card if neither exists.
    const linked = item.caseStudy || item.url;
    const Wrapper = linked ? 'a' : 'div';
    const wrapperAttrs = item.caseStudy
      ? { href: `/work/${item.caseStudy}/` }
      : item.url
      ? { href: item.url, target: '_blank' as const, rel: 'noopener noreferrer' }
      : {};
    // Hover: a subtle color glow only — no translate, no scale (Manny).
    // Cards with a hoverImage crossfade to the mobile screenshot.
    return (
      <Wrapper {...wrapperAttrs} class={`${baseCard} ${linked ? 'hover:border-primary-blue/40 hover:shadow-[0_0_45px_rgba(0,113,227,0.25),0_0_18px_rgba(255,79,170,0.12)]' : ''}`}>
        <div class="relative aspect-[16/9] overflow-hidden border-b border-light-tertiary dark:border-dark-accent">
          {item.image ? (
            <picture>
              <source type="image/avif" srcset={workSrcset(item.image, 'avif')} sizes={WORK_SIZES} />
              <source type="image/webp" srcset={workSrcset(item.image, 'webp')} sizes={WORK_SIZES} />
              <img
                src={`/works/${item.image}-960.webp`}
                alt={item.imageAlt ?? item.name}
                width="1280"
                height="720"
                loading="lazy"
                decoding="async"
                class={`w-full h-full object-cover ${item.hoverImage ? 'transition-opacity duration-500 group-hover:opacity-0' : ''}`}
              />
            </picture>
          ) : (
            <div class="w-full h-full bg-gradient-to-br from-primary-blue/15 via-purple-500/10 to-primary-pink/15 flex items-center justify-center">
              <span class="text-3xl font-bold apple-gradient-text">{initial(item.name)}</span>
            </div>
          )}
          {item.image && item.hoverImage && (
            <img
              src={`/works/${item.hoverImage}-960.webp`}
              alt=""
              aria-hidden="true"
              width="960"
              height="1790"
              loading="lazy"
              decoding="async"
              class="absolute inset-0 w-full h-full object-cover object-top opacity-0 transition-opacity duration-500 group-hover:opacity-100 pointer-events-none"
            />
          )}
        </div>
        <div class="p-5 flex flex-col flex-1">
          <div class="flex items-center justify-between gap-2">
            <h3 class="font-semibold text-text-light-primary dark:text-text-dark-primary">{item.name}</h3>
            {item.url && (
              <svg class="w-4 h-4 flex-shrink-0 text-text-light-tertiary dark:text-text-dark-tertiary group-hover:text-primary-blue transition-colors" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H8M17 7v9" />
              </svg>
            )}
          </div>
          {item.tags && item.tags.length > 0 && (
            <div class="flex flex-wrap gap-1.5 mt-2">
              {item.tags.map((t) => (
                <span class="text-[11px] font-medium uppercase tracking-wide text-primary-blue dark:text-blue-300 bg-primary-blue/10 rounded-full px-2 py-0.5">{t}</span>
              ))}
            </div>
          )}
          {item.blurb && (
            <p class="text-sm text-text-light-secondary dark:text-text-dark-secondary mt-3 leading-relaxed">{item.blurb}</p>
          )}
          {item.url && (
            <span class="text-xs text-text-light-tertiary dark:text-text-dark-tertiary mt-auto pt-3">{host(item.url)}</span>
          )}
        </div>
      </Wrapper>
    );
  })}

  <!-- Coffee break in the 6th grid cell — the seat is his until project #6
       ships, then this moves elsewhere (Manny's call on where). -->
  <div class="flex items-center justify-center" aria-hidden="true">
    <img
      src="/mascot/astronaut-coffee-moon.webp"
      alt="Astronaut mascot drinking coffee on a crescent moon"
      aria-hidden="true"
      width="819"
      height="860"
      loading="lazy"
      decoding="async"
      class="moon-swing w-full max-w-[110px] h-auto pointer-events-none"
    />
  </div>
</div>

<style>
  /* Gentle hanging swing (Manny, Aug 2026): pivot sits well above the image
     (like a string he's hanging from), so a small rotation reads as a shallow
     arc. Dials: --swing-angle and the duration. */
  .moon-swing {
    --swing-angle: 3.5deg;
    transform-origin: 50% -120%;
    animation: moonSwing 6.8s ease-in-out infinite;
  }
  @keyframes moonSwing {
    0%, 100% { rotate: var(--swing-angle); }
    50%      { rotate: calc(-1 * var(--swing-angle)); }
  }
  @media (prefers-reduced-motion: reduce) {
    .moon-swing { animation: none; }
  }
</style>
