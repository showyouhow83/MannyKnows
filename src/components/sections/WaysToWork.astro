---
// WaysToWork — the single "how do I engage you" section on /services.
//
// This replaced two stacked sections ("Two ways to work with us" and
// "Software built for your business") that were really one decision cut in
// half: "Own it outright" was just the one-time model applied to apps, while
// co-owning via the Idea Launchpad is a genuinely different arrangement. So:
// one section, three doors. If a fourth engagement model ever exists, it's a
// fourth card here — not a new section.
//
// Copy rules carried over from the old sections: the custom-build price
// anchor (raised to $2,500 with Manny's sign-off, Aug 2026) and the
// revenue-share promise are published commitments — change them only with
// Manny's sign-off.
import Section from '../layout/Section.astro';
import Container from '../layout/Container.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import Button from '../ui/Button.astro';
---

<Section id="ways-to-work" variant="alternate" className="room chain-violet-blue">
  <Container>
    <SectionHeader title="Three ways to work with us" subtitle="Everything we build (sites, stores, marketing, custom software) comes through one of three doors. Pick by how you want to own it." />
    <div class="grid gap-6 lg:grid-cols-3 max-w-6xl mx-auto items-stretch">

      <div class="flex flex-col rounded-2xl border border-primary-blue/30 bg-primary-blue/[0.04] p-6">
        <span class="self-start inline-flex items-center rounded-full px-3 py-1 text-xs font-bold uppercase tracking-wider mb-3 bg-primary-blue/15 text-primary-blue dark:text-blue-300">Monthly · we run it</span>
        <h3 class="text-lg font-bold text-text-light-primary dark:text-text-dark-primary leading-snug">Handled long-term</h3>
        <p class="mt-3 text-sm text-text-light-secondary dark:text-text-dark-secondary leading-relaxed flex-1">A one-time setup fee where we build something, then a flat monthly rate, cancel anytime. With Plans we build and run your site, store, and marketing; with the <a href="/ai-team/" class="text-primary-blue dark:text-blue-300 hover:underline">AI Agents Team</a> we build the agents and you run them on demand. Best when you want it kept working, not just delivered once.</p>
        <img src="/mascot/astronaut-planting.webp" alt="Astronaut mascot planting a seedling" aria-hidden="true" width="872" height="1106" loading="lazy" decoding="async" class="mx-auto my-4 w-full max-w-[80px] h-auto pointer-events-none" />
        <Button href="/plans/" variant="secondary" size="sm" class="mt-5">See the plans</Button>
      </div>

      <div class="flex flex-col rounded-2xl border border-light-tertiary dark:border-dark-accent bg-white dark:bg-dark-secondary p-6">
        <span class="self-start inline-flex items-center rounded-full px-3 py-1 text-xs font-bold uppercase tracking-wider mb-3 bg-light-secondary dark:bg-dark-accent text-text-light-secondary dark:text-text-dark-secondary">One-time · you own it</span>
        <h3 class="text-lg font-bold text-text-light-primary dark:text-text-dark-primary leading-snug">A specific thing, done once</h3>
        <p class="mt-3 text-sm text-text-light-secondary dark:text-text-dark-secondary leading-relaxed flex-1">One custom development project with a clear finish line — a website, an app, an automation, anything we can engineer. We scope it together, quote it up front, build it, and hand it over. The code and the tool are yours. Many owners build once, then roll onto a plan to keep it growing.</p>
        <p class="mt-3 text-xs text-text-light-tertiary dark:text-text-dark-tertiary">New to this? See <a href="/how-it-works/" class="font-semibold text-primary-blue dark:text-blue-300 hover:underline">how we turn a process into an app</a>, start to finish.</p>
        <Button href="/contact/" data-contact-context="One-time build: scope it" variant="secondary" size="sm" class="mt-5">Scope a build</Button>
      </div>

      <div class="flex flex-col rounded-2xl border border-primary-blue/40 ring-1 ring-primary-blue/20 bg-gradient-to-br from-primary-blue/[0.06] via-transparent to-primary-pink/[0.06] p-6">
        <span class="self-start inline-flex items-center rounded-full px-3 py-1 text-xs font-bold uppercase tracking-wider mb-3 bg-gradient-to-r from-primary-blue/15 to-primary-pink/15 text-primary-blue dark:text-blue-300">Co-own · nothing upfront</span>
        <h3 class="text-lg font-bold text-text-light-primary dark:text-text-dark-primary leading-snug">Your idea, built together</h3>
        <p class="mt-3 text-sm text-text-light-secondary dark:text-text-dark-secondary leading-relaxed flex-1">Got an idea for an app or online product? Pitch it. If we believe in it, we design, build, launch, and market it with <strong class="text-text-light-primary dark:text-text-dark-primary">no upfront cost</strong>. We build it together and share what it earns.</p>
        <img src="/mascot/astronaut-idea.webp" alt="Astronaut mascot with a lightbulb idea" aria-hidden="true" width="797" height="1101" loading="lazy" decoding="async" class="mx-auto my-4 w-full max-w-[80px] h-auto pointer-events-none" />
        <Button href="#contact" data-contact-context="Idea Launchpad: co-own an app" size="sm" class="mt-5">Pitch your idea</Button>
      </div>

    </div>
  </Container>
</Section>
