---
// Plan cards — driven by src/data/plans.ts (shared with the /plans/<slug>
// detail pages). Prices are "Starting at"; every plan is tailored per client.
// The card layout itself lives in PricingCards.astro, shared with /ecommerce so
// the two grids can't drift; this file maps plan records onto it and owns the
// comparison table and the included-with-every-plan list below the grid.
import { websitePlans } from '../../data/plans';
import PricingCards from '../pricing/PricingCards.astro';
// Card rows come from the shared builder so /pricing renders the identical grid.
import { websitePlanCards } from '../../lib/pricingCards';

const cards = websitePlanCards();

// Included at every tier, so it's listed once below the comparison table rather
// than as rows of four identical checkmarks (the table exists to show what
// differs) or as bullets that would bloat the entry card. Infrastructure comes
// from Cloudflare; the stock library and logo templates from our Envato
// Elements license.
// Ordered so the 3-column grid reads in themed rows: setup, then no-limits,
// then stock media.
const includedEverywhere = [
  'Your own admin, built to fit your business',
  'Multilingual as standard',
  'Domain registered for you',
  'SSL certificate & DDoS protection',
  'Content caching on Cloudflare’s global network',
  "Site runs on Cloudflare's CDN",
  'Unlimited storage & bandwidth',
  'Unlimited stock photography & video',
  'Unlimited logos',
  'Graphic design & AI stock media',
];
---

{/* No max-width here: the grid fills the page Container (1440px), the same
    width the homepage and /ecommerce use. It used to be capped at max-w-6xl
    (1152px), which made these cards narrower than the identical grid on
    /ecommerce and squeezed every tier's copy into extra line wraps. */}
<div>
  <PricingCards id="pricingPlans" cards={cards} />

  <!-- At-a-glance comparison — what's additive as you climb the tiers -->
  <div class="mt-12">
    <h3 class="text-center text-lg font-bold text-text-light-primary dark:text-text-dark-primary leading-snug mb-5">Compare at a glance</h3>
    <div class="overflow-x-auto rounded-2xl border border-light-tertiary dark:border-dark-accent bg-white dark:bg-dark-secondary">
      <table class="w-full text-sm min-w-[760px] table-fixed">
        <thead>
          <tr class="text-text-light-primary dark:text-text-dark-primary">
            <th class="w-[190px] sm:w-2/5 sticky left-0 z-20 text-left font-semibold px-4 py-3 bg-light-secondary dark:bg-dark-primary border-r border-light-tertiary dark:border-dark-accent">What you get</th>
            <th class="px-3 py-3 font-semibold text-center bg-light-secondary dark:bg-dark-primary">Get Found</th>
            <th class="px-3 py-3 font-semibold text-center bg-light-secondary dark:bg-dark-primary">Get Booked</th>
            <th class="px-3 py-3 font-semibold text-center bg-light-secondary dark:bg-dark-primary">Get Growing</th>
            <th class="px-3 py-3 font-semibold text-center bg-light-secondary dark:bg-dark-primary">Get Ahead</th>
                      </tr>
        </thead>
        <tbody class="text-text-light-secondary dark:text-text-dark-secondary">
          {[
            ['Custom-designed website (logo included)', '1–3 pages', 'Multi-page', 'Multi-page', 'Multi-page'],
            ['Hosting, SSL, Security & Speed (Cloudflare)', true, true, true, true],
            ['Set up to rank on Google & Maps', true, true, true, true],
            ['Brand Brain development for AI agents', true, true, true, true],
            ['Remi AI answers customers 24/7, in any language', true, true, true, true],
            ['Your own admin — leads, contacts, content', true, true, true, true],
            ['Remi AI books the job into your calendar', false, true, true, true],
            ['Self-optimizing (speed, SEO, content)', 'Basic', 'More', 'Full', 'Full'],
            ['Generates its own content', false, false, true, true],
            ['A/B tests content & keeps the winners', false, false, true, true],
            ['Remi AI sells, steering people to the right service', false, false, true, true],
            ['Your ads run & managed (two networks)', false, false, false, true],
          ].map((row) => (
            <tr class="border-t border-light-tertiary dark:border-dark-accent">
              <td class="sticky left-0 z-10 text-left px-4 py-2.5 bg-white dark:bg-dark-secondary border-r border-light-tertiary dark:border-dark-accent">{row[0]}</td>
              {row.slice(1).map((cell) => (
                <td class="text-center px-3 py-2.5">
                  {typeof cell === 'string' ? (
                    <span class="text-xs font-semibold text-primary-blue dark:text-blue-300">{cell}</span>
                  ) : cell ? (
                    <svg class="w-4 h-4 inline text-green-500" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-label="included"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                  ) : (
                    <span class="text-text-light-tertiary/50 dark:text-text-dark-tertiary/50" aria-label="not included">—</span>
                  )}
                </td>
              ))}
            </tr>
          ))}
          {/* Both money rows read straight off plans.ts so the table can't
              drift from the cards above it on a reprice. */}
          <tr class="border-t border-light-tertiary dark:border-dark-accent font-semibold text-text-light-primary dark:text-text-dark-primary">
            <td class="sticky left-0 z-10 text-left px-4 py-2.5 bg-white dark:bg-dark-secondary border-r border-light-tertiary dark:border-dark-accent">One-time setup (waived on a yearly plan)</td>
            {websitePlans.map((p) => (
              <td class="text-center px-3 py-2.5">${p.setupFee?.toLocaleString('en-US')}</td>
            ))}
          </tr>
          <tr class="border-t border-light-tertiary dark:border-dark-accent font-semibold text-text-light-primary dark:text-text-dark-primary">
            <td class="sticky left-0 z-10 text-left px-4 py-2.5 bg-white dark:bg-dark-secondary border-r border-light-tertiary dark:border-dark-accent">Starting at (per month)</td>
            {websitePlans.map((p) => (
              <td class="text-center px-3 py-2.5">${p.price.toLocaleString('en-US')}</td>
            ))}
          </tr>
        </tbody>
      </table>
    </div>
    <p class="mt-3 text-center text-xs text-text-light-tertiary dark:text-text-dark-tertiary">Selling products online? That's a different build, see <a href="/ecommerce/" class="font-semibold text-primary-blue dark:text-blue-300 hover:underline">online stores</a>.</p>
    {/* Two distinct destinations on purpose (Manny, Aug 2026): the name goes
        to Remi AI's profile card on the AI Agents Team roster; the action link goes to
        the booking-agent explainer page. */}
    <p class="mt-2 text-center text-xs text-text-light-tertiary dark:text-text-dark-tertiary"><a href="/ai-booking-agent/" class="font-semibold text-primary-blue dark:text-blue-300 hover:underline">Remi AI</a> is your site's built-in AI agent, chat, sales &amp; booking. <a href="/ai-booking-agent/" class="text-primary-blue dark:text-blue-300 hover:underline">See Remi AI's own plans</a>.</p>
  </div>

  <!-- What the monthly price covers — shown once for all plans -->
  <div id="included" class="mt-10 max-w-6xl mx-auto pt-6 border-t border-light-tertiary dark:border-dark-accent scroll-mt-24">
    <h3 class="text-center text-lg font-bold text-text-light-primary dark:text-text-dark-primary leading-snug">Included with every plan</h3>
    <p class="mt-1.5 text-center text-xs text-text-light-tertiary dark:text-text-dark-tertiary">Fast, secure, and stocked, at every tier, not just the top one.</p>
    <ul class="mt-5 grid gap-x-8 gap-y-2.5 sm:grid-cols-2 text-sm text-text-light-secondary dark:text-text-dark-secondary">
      {includedEverywhere.map((item) => (
        <li class="flex items-start gap-2">
          <svg class="w-4 h-4 mt-0.5 flex-shrink-0 text-green-500" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
          <span>{item}</span>
        </li>
      ))}
    </ul>
    <p class="mt-5 text-center text-xs text-text-light-tertiary dark:text-text-dark-tertiary leading-relaxed">
      What each "unlimited" covers is in our <a href="/terms/#unlimited" class="text-primary-blue dark:text-blue-300 font-medium hover:underline">terms</a>.
    </p>
    <p class="mt-3 text-center text-xs text-text-light-tertiary dark:text-text-dark-tertiary leading-relaxed">
      Month to month, a one-time setup fee pays for the build and the monthly runs the site. There's no minimum term, so cancelling costs nothing. Yearly is one upfront payment for 12 months — pay for 10, get 12, and the setup fee is waived. Both carry a full refund for 5 business days after kickoff. Details in our <a href="/terms/#build-fee" class="text-primary-blue dark:text-blue-300 font-medium hover:underline">terms</a>.
    </p>
  </div>
</div>
