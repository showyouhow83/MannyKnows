---
// Shared template for the per-profession landing pages. Driven entirely by a
// Profession record (src/data/professions.ts). Thin page wrappers live at
// src/pages/websites-for-<slug>.astro.
//
// Aug 2026 normalization: breadcrumb, buttons and section headers render
// through the shared primitives (Breadcrumb / Button / SectionHeader), and the
// old "What's quietly costing you jobs" + "What you get" pair is one
// problems→fixes section, in the same card language as the rest of the site.
import BaseLayout from '../../layouts/BaseLayout.astro';
import NavBar from '../navigation/NavBar.astro';
import DockMenu from '../navigation/DockMenu.astro';
import Section from '../layout/Section.astro';
import Container from '../layout/Container.astro';
import Breadcrumb from '../ui/Breadcrumb.astro';
import Button from '../ui/Button.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import QuoteBlock from '../ui/QuoteBlock.astro';
import Faq from '../ui/Faq.astro';
import { getTestimonial } from '../../data/testimonials';
import { professions, type Profession } from '../../data/professions';

interface Props {
  profession: Profession;
}
const { profession: p } = Astro.props;

const quote = p.proofBusiness ? getTestimonial(p.proofBusiness) : undefined;
const others = professions.filter((x) => x.slug !== p.slug);
const contactContext = `Website for ${p.name}`;

// Mentions of Manny (the human) link to /about/ — same helper as /plans.
// Word-bound so "MannyKnows" / "Manny AI" never match.
const linkManny = (s: string) =>
  s.replace(
    /\bManny\b(?!\s*AI\b)(?!Knows)/g,
    '<a href="/about/" class="text-primary-blue dark:text-blue-300 font-medium hover:underline">Manny</a>'
  );
const faqs = p.faqs.map((f) =>
  /\bManny\b(?!\s*AI\b)(?!Knows)/.test(f.a) ? { ...f, a: linkManny(f.a), html: true } : f
);
---

<BaseLayout title={p.metaTitle} description={p.metaDescription}>
  {/* one-canvas: one tone for the whole page instead of a different colour
      per section (Manny, Aug 2026). Hue is grouped by pillar — see the
      ONE-TONE CANVAS block in global.css. The per-section .room /
      .chain-* / .glow-* classes below are left in place on purpose:
      delete the two classes on the next line and the page reverts. */}
  <main class="relative bg-light-primary dark:bg-dark-primary text-text-light-primary dark:text-text-dark-primary min-h-screen transition-colors duration-300 one-canvas one-canvas-live">

    <header class="relative bg-gradient-to-t from-gray-50/50 via-gray-100/30 to-gray-50/20 dark:from-gray-900/60 dark:via-slate-800/40 dark:to-gray-900/30 transition-colors duration-300 room-hero">
      <NavBar />
      <Breadcrumb items={[{ label: `Websites for ${p.name}` }]} />
      <!-- Split hero, same shape as /plans: pitch on the left, a scannable
           "what you get" panel on the right (the full cards live in the
           problems→fixes section below). -->
      <div class="pb-14">
        <Container>
          <div class="max-w-[1440px] mx-auto grid lg:grid-cols-2 gap-10 lg:gap-14 items-center">
            <div class="text-center lg:text-left">
              <div class="flex justify-center mb-6">
                <img
                  src="/mascot/astronaut-notes.webp"
                  alt="Astronaut mascot taking notes on a clipboard"
                  aria-hidden="true"
                  width="320"
                  height="600"
                  decoding="async"
                  class="w-auto h-[200px] pointer-events-none"
                />
              </div>
              <div class="text-center">
                <span class="inline-block bg-gradient-to-r from-primary-blue/10 via-purple-500/10 to-primary-pink/10 text-primary-blue px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider mb-4">{p.badge}</span>
              </div>
              <h1 class="sf-bold apple-headline text-4xl md:text-5xl lg:text-6xl mb-6 leading-tight">
                <span class="apple-gradient-text" data-colorful-title>{p.h1}</span>
              </h1>
              <p class="max-w-2xl mx-auto lg:mx-0 text-base sm:text-xl text-text-light-secondary dark:text-text-dark-secondary leading-relaxed mb-8" set:html={linkManny(p.heroIntro)} />
              <div class="flex flex-col sm:flex-row gap-4 justify-center">
                <Button href="#contact" data-contact-context={contactContext} arrow="right">Get a free look at your site</Button>
                <Button href="/plans/" variant="secondary">See the plans</Button>
              </div>
            </div>

            <div class="rounded-3xl border border-primary-blue/40 ring-1 ring-primary-blue/20 bg-white dark:bg-dark-secondary p-6 sm:p-8 shadow-lg shadow-primary-blue/5">
              <span class="block text-[11px] font-bold uppercase tracking-wide text-primary-blue dark:text-blue-300 mb-1">What you get</span>
              <p class="text-sm text-text-light-secondary dark:text-text-dark-secondary mb-5">{p.panelIntro}</p>
              <ul class="space-y-3.5">
                {p.offer.map((o) => (
                  <li class="flex items-start gap-3 text-sm text-text-light-secondary dark:text-text-dark-secondary leading-snug">
                    <span class="flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-lg bg-gradient-to-br from-primary-blue/10 to-primary-pink/10 text-primary-blue dark:text-blue-300"><svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg></span>
                    <span class="pt-1.5 font-medium text-text-light-primary dark:text-text-dark-primary">{o.title}</span>
                  </li>
                ))}
              </ul>
              <p class="mt-5 pt-5 border-t border-light-tertiary dark:border-dark-accent text-sm font-semibold text-text-light-primary dark:text-text-dark-primary" set:html={linkManny(p.panelNote)} />
            </div>
          </div>
        </Container>
      </div>
    </header>

    <!-- Problems → fixes. One section: what a weak site costs this trade on
         the left, what they get from us on the right. -->
    <Section id="prof-fix" variant="default" className="room chain-violet-blue">
      <Container>
        <SectionHeader
          title={`What’s quietly costing you ${p.lossNoun}, and what fixes it`}
          subtitle={p.fixIntro}
          width="max-w-3xl"
        />
        <div class="grid gap-8 lg:grid-cols-12 max-w-6xl mx-auto items-start">
          <div class="lg:col-span-5">
            <p class="text-xs font-bold uppercase tracking-wider text-text-light-tertiary dark:text-text-dark-tertiary mb-4">The problems</p>
            <div class="space-y-4">
              {p.painPoints.map((pt) => (
                <div class="group relative overflow-hidden rounded-2xl border border-light-tertiary dark:border-dark-accent bg-white dark:bg-dark-secondary p-6 transition-all duration-300 hover:border-amber-400/50 hover:shadow-xl hover:shadow-amber-500/10">
                  <div class="flex items-center gap-3">
                    <div class="flex h-11 w-11 flex-shrink-0 items-center justify-center rounded-xl bg-amber-500/10 text-amber-600 dark:text-amber-400">
                      <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
                    </div>
                    <h3 class="text-lg font-bold text-text-light-primary dark:text-text-dark-primary leading-snug">{pt.title}</h3>
                  </div>
                  <p class="mt-3 text-sm text-text-light-secondary dark:text-text-dark-secondary leading-relaxed">{pt.body}</p>
                </div>
              ))}
            </div>
          </div>
          <div class="lg:col-span-7">
            <p class="text-xs font-bold uppercase tracking-wider text-text-light-tertiary dark:text-text-dark-tertiary mb-4">What you get</p>
            <div class="grid gap-4 sm:grid-cols-2">
              {p.offer.map((o) => (
                <div class="group relative overflow-hidden rounded-2xl border border-light-tertiary dark:border-dark-accent bg-white dark:bg-dark-secondary p-6 transition-all duration-300 hover:border-primary-blue/40 hover:shadow-xl hover:shadow-primary-blue/10">
                  <div class="flex items-center gap-3">
                    <div class="flex h-11 w-11 flex-shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-primary-blue to-primary-pink text-white shadow-lg shadow-primary-blue/20">
                      <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                    </div>
                    <h3 class="text-lg font-bold text-text-light-primary dark:text-text-dark-primary leading-snug">{o.title}</h3>
                  </div>
                  <p class="mt-3 text-sm text-text-light-secondary dark:text-text-dark-secondary leading-relaxed">{o.body}</p>
                </div>
              ))}
            </div>
          </div>
        </div>
        <div class="max-w-3xl mx-auto text-center mt-12">
          <p class="text-text-light-secondary dark:text-text-dark-secondary leading-relaxed mb-6">
            All of it ships on one website plan, with no term. Pick the tier that fits how you work, and we build the rest around it.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <Button href="/plans/" arrow="right">See the plans</Button>
            <Button href="#contact" data-contact-context={contactContext} variant="secondary">Get a free look at your site</Button>
          </div>
        </div>
      </Container>
    </Section>

    {quote && (
      <Section id="prof-proof" variant="default" className="room glow-violet">
        <Container>
          <div class="max-w-2xl mx-auto text-center">
            <p class="text-sm font-semibold uppercase tracking-wide text-primary-blue dark:text-blue-300 mb-6">{p.proofHeading}</p>
            <QuoteBlock quote={quote} align="center" />
          </div>
        </Container>
      </Section>
    )}

    <Section id="prof-faq" variant="alternate" className="room glow-violet">
      <Container>
        <div class="max-w-3xl mx-auto">
          <Faq faqs={faqs} />
        </div>
      </Container>
    </Section>

    <!-- Cross-links to the other verticals -->
    <Section id="prof-others" variant="default" className="room glow-blue">
      <Container>
        <div class="max-w-4xl mx-auto text-center">
          <p class="text-xs font-bold uppercase tracking-wider text-text-light-tertiary dark:text-text-dark-tertiary mb-5">We also build for</p>
          <div class="flex flex-wrap items-center justify-center gap-3">
            {others.map((o) => (
              <a href={`/websites-for-${o.slug}/`} class="inline-flex items-center rounded-full border border-light-tertiary dark:border-dark-accent bg-white dark:bg-dark-secondary px-4 py-1.5 text-sm text-text-light-secondary dark:text-text-dark-secondary hover:border-primary-blue/40 hover:text-primary-blue dark:hover:text-blue-300 transition-colors">
                {o.name}
              </a>
            ))}
          </div>
          <div class="mt-10">
            <Button href="#contact" data-contact-context={contactContext} arrow="right">Talk to us about your {p.businessNoun} website</Button>
          </div>
        </div>
      </Container>
    </Section>

    <DockMenu />
  </main>
</BaseLayout>
