---
// Homepage "Google Business Profile" section body — the "why a 360° photo
// wins customers" proof tiles plus the CTA. The section title/subtitle live
// in index.astro. Swapped with /free-360-photo/ (Aug 2026 per Manny): the
// BrightLocal consumer stats now live there, above the two-column comparison
// (GbpComparison.astro).
//
// HONESTY RULE (same as the rest of the site): cited numbers only —
//   • the 2× figure is Ipsos MediaCT research commissioned by Google
//     (on Street View virtual tours)
//   • 42% / 35% are Google's own Business Profile photo data
// Vendor blogs claim bigger numbers (31% bookings, 5-10x view time) but none
// trace to a named study, so they don't go on the page.
const WHY = [
  { stat: '2×', label: 'as likely to generate interest', body: 'Listings with photos & virtual tours are 2x as likely to generate customer interest as listings without.', source: null },
  { stat: '42%', label: 'more direction requests', body: 'Listings with photos get 42% more requests for driving directions on Google.', source: null },
  { stat: '35%', label: 'more clicks to your site', body: 'Photo-rich profiles see 35% more click-throughs to the business website.', source: null },
  { stat: '24/7', label: 'storefront on Google', body: 'A 360° photo lets customers step inside at any hour, the trust is built before they ever call.', source: null },
];
---

<div class="max-w-6xl mx-auto">
  <!-- The pitch line lives in the section title/subtitle (index.astro);
       here are just the proof tiles. -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
    {WHY.map((w) => (
      <div class="bg-white dark:bg-dark-secondary border border-light-tertiary dark:border-dark-accent rounded-2xl p-6 text-center flex flex-col">
        <div class="text-4xl font-black apple-gradient-text mb-1" data-colorful-title>{w.stat}</div>
        <div class="text-sm font-semibold text-text-light-primary dark:text-text-dark-primary mb-3">{w.label}</div>
        <p class="text-sm text-text-light-secondary dark:text-text-dark-secondary leading-relaxed flex-1">{w.body}</p>
        {w.source && <p class="text-[11px] text-text-light-tertiary dark:text-text-dark-tertiary mt-3">Source: {w.source}</p>}
      </div>
    ))}
  </div>
  <p class="text-center text-xs text-text-light-tertiary dark:text-text-dark-tertiary mt-6 max-w-2xl mx-auto">
    Numbers above come from research commissioned by Google (Ipsos MediaCT, on Street View virtual tours) and Google's own Business Profile photo data.
  </p>

  <div class="text-center mt-10">
    <div class="flex flex-wrap items-center justify-center gap-4">
      <a href="/local-seo/" class="inline-flex items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-primary-blue to-primary-pink text-white px-6 py-3 text-sm font-semibold transition-all duration-300">
        Start ranking today
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
      </a>
      <a href="/local-seo/#free-360-photo" class="inline-flex items-center justify-center gap-2 rounded-xl border border-primary-blue/40 text-primary-blue dark:text-blue-300 px-6 py-3 text-sm font-semibold hover:bg-primary-blue/5 transition-all duration-300">
        Request 360° Photo
      </a>
    </div>
    <p class="mt-4 text-xs text-text-light-tertiary dark:text-text-dark-tertiary">
      Rather do it yourself? <a href="/blog/google-business-profile-springfield/" class="underline decoration-dotted hover:text-primary-blue">The full guide is free on our blog.</a>
    </p>
  </div>
</div>
