---
// Homepage "Google Business Profile" explainer — the cited consumer stats and
// the CTA. Sits above the AI Team section. The "set up right vs left alone"
// two-column comparison moved to /free-360-photo/ (GbpComparison.astro),
// Aug 2026 per Manny.
//
// HONESTY RULE (same as the rest of the site): every figure below is traceable
// to a named source, and the source is printed on the page:
//   • BrightLocal Local Consumer Review Survey 2026 — primary consumer research
//     https://www.brightlocal.com/research/local-consumer-review-survey/
// The widely-repeated "complete profiles get 7x more clicks / 2.7x more
// reputable" figures are NOT here on purpose: they're attributed to Google all
// over the web but appear nowhere in Google's current documentation.

// Notes are optional — Manny trimmed the cards to one line each; the 41%
// figure moved up into the 97% card's main label instead of a footnote.
const stats: { n: string; label: string; note?: string }[] = [
  { n: '71%', label: 'use Google to find local businesses' },
  { n: '97%', label: 'read reviews for local businesses, 41% always do' },
  { n: '47%', label: "won't use a business with under 20 reviews" },
  { n: '74%', label: 'want reviews from the last three months' },
];
---

<div class="max-w-6xl mx-auto">
  <!-- The what-a-GBP-is lesson now lives in the section title/subtitle
       (index.astro): repeating it here as an intro paragraph was saying the
       same thing twice before the reader reached the numbers. -->
  <!-- Cited stats -->
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
    {stats.map((s) => (
      <div class="rounded-2xl border border-light-tertiary dark:border-dark-accent bg-white dark:bg-dark-secondary p-5 text-center">
        <div class="text-3xl md:text-4xl font-black apple-gradient-text mb-1" data-colorful-title>{s.n}</div>
        <div class="text-sm font-semibold text-text-light-primary dark:text-text-dark-primary leading-snug">{s.label}</div>
        {s.note && <div class="text-xs text-text-light-tertiary dark:text-text-dark-tertiary mt-1 leading-snug">{s.note}</div>}
      </div>
    ))}
  </div>
  <p class="text-center text-xs text-text-light-tertiary dark:text-text-dark-tertiary">
    Source: <a href="https://www.brightlocal.com/research/local-consumer-review-survey/" target="_blank" rel="noopener noreferrer" class="underline decoration-dotted hover:text-primary-blue">BrightLocal Local Consumer Review Survey 2026</a>
  </p>

  <div class="text-center mt-10">
    <div class="flex flex-wrap items-center justify-center gap-4">
      <a href="/plans/get-found/" class="inline-flex items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-primary-blue to-primary-pink text-white px-6 py-3 text-sm font-semibold transition-all duration-300">
        Start ranking today
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
      </a>
      <a href="/free-360-photo/" class="inline-flex items-center justify-center gap-2 rounded-xl border border-primary-blue/40 text-primary-blue dark:text-blue-300 px-6 py-3 text-sm font-semibold hover:bg-primary-blue/5 transition-all duration-300">
        Request 360° Photo
      </a>
    </div>
    <p class="mt-4 text-xs text-text-light-tertiary dark:text-text-dark-tertiary">
      Rather do it yourself? <a href="/blog/google-business-profile-springfield/" class="underline decoration-dotted hover:text-primary-blue">The full guide is free on our blog.</a>
    </p>
  </div>
</div>
