---
// AiWebsiteAgentDemo — the phone-framed conversation that proves what the AI
// Website's agent does. Shared by /ai-website and the #ai-website section on
// /free-360-photo so the demo can't drift between them.
//
// Static markup on purpose: this sits above the fold on a page whose whole
// pitch is speed, so it ships no JS and no layout shift. The transcript lives
// in src/data/aiWebsite.ts.
import { aiWebsiteChat } from '../../data/aiWebsite';

interface Props {
  /** Label under the phone frame. */
  caption?: string;
  class?: string;
}
const {
  caption = 'A visitor at 10:47pm. Nobody had to be awake for this.',
  class: className = '',
} = Astro.props;
---

<div class={`mx-auto w-full max-w-[320px] ${className}`}>
  <div class="rounded-[2rem] border-[6px] border-gray-900 dark:border-gray-700 bg-white dark:bg-dark-primary shadow-2xl overflow-hidden">
    <!-- Status bar / site chrome -->
    <div class="flex items-center justify-between px-4 py-2 bg-gray-50 dark:bg-dark-secondary border-b border-light-tertiary dark:border-dark-accent">
      <span class="text-[10px] font-semibold text-text-light-tertiary dark:text-text-dark-tertiary">yourbusiness.com</span>
      <span class="inline-flex items-center gap-1.5 text-[10px] font-semibold text-green-600 dark:text-green-400">
        <span class="w-1.5 h-1.5 rounded-full bg-green-500"></span>
        Online
      </span>
    </div>

    <ul class="p-3 space-y-2" role="list">
      {aiWebsiteChat.map((m) => (
        <li class={`flex ${m.from === 'them' ? 'justify-end' : 'justify-start'}`}>
          <p
            class:list={[
              'text-[11px] leading-snug px-3 py-2 max-w-[85%] rounded-2xl',
              m.from === 'them'
                ? 'bg-blue-500 text-white rounded-br-sm'
                : 'bg-gray-100 dark:bg-dark-secondary text-text-light-primary dark:text-text-dark-primary rounded-bl-sm',
            ]}
          >
            <span class="sr-only">{m.from === 'them' ? 'Customer: ' : 'Remi: '}</span>
            {m.text}
          </p>
        </li>
      ))}
    </ul>

    <!-- Where it ends up. Lead capture, NOT a booking — this Remi doesn't
         book (see the honesty guard on aiWebsiteChat in aiWebsite.ts). -->
    <div class="border-t border-light-tertiary dark:border-dark-accent bg-green-50 dark:bg-green-500/10 px-3 py-2.5">
      <p class="text-[10px] font-bold uppercase tracking-wider text-green-700 dark:text-green-400">Sent to your inbox</p>
      <p class="text-[11px] text-text-light-secondary dark:text-text-dark-secondary mt-0.5 leading-snug">
        New lead · Carla · (413) 555-0182 · weekend job, quoted $450–$650 range
      </p>
    </div>
  </div>

  {caption && (
    <p class="mt-4 text-center text-xs text-text-light-tertiary dark:text-text-dark-tertiary leading-relaxed">
      {caption}
    </p>
  )}
</div>
