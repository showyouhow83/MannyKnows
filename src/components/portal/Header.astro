---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../../consts';

const PHONE_DISPLAY = '(413) 361-8451';
const PHONE_TEL = '+14133618451';
---

<header>
	<div class="container header__inner">
		<a href="/" class="logo" aria-label={SITE_TITLE}>
			<svg
				class="logo-svg"
				xmlns="http://www.w3.org/2000/svg"
				viewBox="0 0 620 240"
				role="img"
				aria-label={SITE_TITLE}
			>
				<path d="M0 0H85V226L211 0H290L160 240H0Z" fill="#ff781d" />
				<path d="M290 0L370 0L456.67 160L619 160L619 240L420 240Z" fill="#ffffff" />
			</svg>
		</a>
		<nav class="nav-primary" aria-label="Primary">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
			<HeaderLink href="/contact">Contact</HeaderLink>
		</nav>
		<a class="header__cta" href={`tel:${PHONE_TEL}`} aria-label={`Call ${PHONE_DISPLAY}`}>
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
			</svg>
			<span>{PHONE_DISPLAY}</span>
		</a>
	</div>
</header>
<style>
	header {
		margin: 0;
		background: rgb(var(--black));
		position: sticky;
		top: 0;
		z-index: 40;
	}
	.header__inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		min-height: 64px;
		gap: 1rem;
	}
	.logo {
		display: flex;
		align-items: center;
		text-decoration: none;
		flex-shrink: 0;
	}
	.logo-svg {
		height: 32px;
		width: auto;
		display: block;
	}
	.nav-primary {
		display: none;
		align-items: center;
		gap: 0.25rem;
	}
	.nav-primary a {
		padding: 0.75em 0.85em;
		color: white;
		border-bottom: 3px solid transparent;
		text-decoration: none;
		font-weight: 600;
		font-size: 0.95rem;
	}
	.nav-primary a.active {
		border-bottom-color: var(--accent);
	}
	.nav-primary a:hover {
		color: var(--accent);
	}
	.header__cta {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.47rem 0.85rem;
		background: var(--accent);
		color: white;
		text-decoration: none;
		font-weight: 700;
		font-size: 0.9rem;
		border-radius: 6px;
		min-height: 40px;
		transition: background 0.2s ease;
	}
	.header__cta:hover {
		background: var(--accent-dark);
		color: white;
	}
	.header__cta svg {
		width: 16px;
		height: 16px;
	}
	.header__cta span {
		display: none;
	}
	@media (min-width: 540px) {
		.logo-svg {
			height: 36px;
		}
		.header__cta span {
			display: inline;
		}
	}
	@media (min-width: 860px) {
		.nav-primary {
			display: flex;
		}
	}
</style>
