---
export interface Props {
  maxWidth?: string;
  className?: string;
}

const { maxWidth = "1440px", className = "" } = Astro.props;
---

<!--
  One gutter for the whole site. This was px-2 (8px), which left body text
  almost touching the phone edge on pages that add no padding of their own —
  and pages that DID add their own ended up at 16px or 24px, so the inset
  visibly changed from page to page. 16 → 24 → 32 is the standard scale.
  Page sections should not add their own horizontal padding inside a
  Container; if the inset looks wrong, fix it here.
-->
<div class={`max-w-[${maxWidth}] mx-auto px-4 sm:px-6 lg:px-8 ${className}`}>
  <slot />
</div>
