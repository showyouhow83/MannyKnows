---
// Homepage section primitive: a washed <section> (the homepage keeps its
// per-section washes — interior pages use Section.astro's one-canvas shell)
// wrapping the shared Container + a hero-scale SectionHeader, so the homepage
// headers can't drift from the sitewide header again (Aug 2026 normalization).
//
// Slots: default (body), `background` (decorative layer behind the content,
// e.g. HeroVideoBackground or an edge-peek mascot), `aside` (shares the
// title's row — see SectionHeader).
import Container from './Container.astro';
import SectionHeader from '../ui/SectionHeader.astro';

export interface Props {
  id?: string;
  badge?: string;
  title?: string;
  subtitle?: string;
  variant?: 'default' | 'alternate' | 'dark' | 'hero';
  className?: string;
  headerAlignment?: 'left' | 'center' | 'right';
}

const {
  id,
  badge,
  title,
  subtitle,
  variant = 'default',
  className = '',
  headerAlignment = 'center'
} = Astro.props;

// Define variant styles
const variantStyles = {
  default: 'bg-light-primary dark:bg-dark-primary',
  alternate: 'bg-gradient-to-br from-gray-50/90 via-gray-100/85 to-gray-200/90 dark:from-gray-900/90 dark:via-slate-800/85 dark:to-gray-900/90 border-t border-gray-300/30 dark:border-white/10',
  dark: 'bg-gradient-to-br from-slate-900/95 via-gray-900/90 to-slate-800/95 border-t border-white/10',
  // Same wash the hero header wears — for sections that should sit at the
  // hero's dark, not the raw near-black page base.
  hero: 'bg-gradient-to-t from-gray-50/50 via-gray-100/30 to-gray-50/20 dark:from-gray-900/60 dark:via-slate-800/40 dark:to-gray-900/30 border-t border-gray-300/30 dark:border-white/10'
};

const sectionClass = `relative py-16 ${variantStyles[variant]} transition-colors duration-300 overflow-hidden ${className}`;
const hasAside = Astro.slots.has('aside');
---

<section id={id} class={sectionClass}>
  <!-- Optional decorative background layer (e.g. HeroVideoBackground). The
       section is already relative + overflow-hidden and the content wrapper
       below is z-10, so anything slotted here sits behind the content. -->
  <slot name="background" />
  <Container className="relative z-10">
    {/* Two branches on purpose: a slot forwarded inside a conditional still
        registers as "present" on the child, which would put every header in
        the aside row layout. */}
    {title && hasAside && (
      <SectionHeader size="hero" badge={badge} title={title} subtitle={subtitle} alignment={headerAlignment}>
        <slot name="aside" slot="aside" />
      </SectionHeader>
    )}
    {title && !hasAside && (
      <SectionHeader size="hero" badge={badge} title={title} subtitle={subtitle} alignment={headerAlignment} />
    )}
    <slot />
  </Container>
</section>
