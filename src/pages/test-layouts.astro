---
// TEMPORARY internal preview (noindex) — two layout options each for the
// homepage "AI-Powered Websites" and "Business Apps" sections, so Manny can
// pick one per section. Delete this page once decided.
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import NavBar from '../components/navigation/NavBar.astro';
import PageSection from '../components/layout/PageSection.astro';
import Illustration from '../components/illustrations/Illustration.astro';

const check = 'M5 13l4 4L19 7';

const THEIRS = [
  'Built once, then frozen. Every change costs a call, a quote, and a wait.',
  'Slowly falls behind on speed and search as the rules change around it.',
  'Breaks quietly. You find out when a customer tells you, or never.',
  'Not ready for AI traffic: the answer engines customers now ask can’t read it.',
];
const OURS = [
  'Checks itself daily and fixes what’s safe to fix on its own.',
  'Keeps up with search and speed instead of falling behind them.',
  'Catches breakage before your customers do.',
  'Structured so ChatGPT and Google’s AI can read, quote, and recommend you.',
];

const NODES = [
  { label: 'Website', icon: 'M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9' },
  { label: 'Inbox', icon: 'M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z' },
  { label: 'CRM', icon: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z' },
  { label: 'Calendar', icon: 'M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z' },
  { label: 'Phone', icon: 'M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z' },
];
---

<BaseLayout title="Layout options (internal preview) | MannyKnows" noindex={true}>
  <main class="relative bg-light-primary dark:bg-dark-primary text-text-light-primary dark:text-text-dark-primary min-h-screen transition-colors duration-300">
    <NavBar />

    <div class="max-w-3xl mx-auto text-center px-4 pt-10 pb-4">
      <h1 class="sf-bold text-2xl md:text-3xl font-bold"><span class="apple-gradient-text" data-colorful-title>Homepage layout options</span></h1>
      <p class="mt-3 text-sm text-text-light-secondary dark:text-text-dark-secondary">Two options per section, with the real copy. The starred ones are my picks. This page is noindexed and gets deleted once you choose.</p>
    </div>

    <!-- ════════ WEBSITES · OPTION A — fused "versus" panel · ★ MY PICK ════════ -->
    <div class="text-center pt-8">
      <span class="inline-block rounded-full bg-gradient-to-r from-primary-blue to-primary-pink text-white text-xs font-bold uppercase tracking-wider px-4 py-1.5">Websites · Option A: versus panel · ★ my pick</span>
    </div>
    <PageSection
      id="ws-a"
      badge="AI-Powered Websites"
      title="Websites that help you run <br />your business efficiently"
      subtitle="A normal website is frozen the day it launches: it only improves if you pay someone to touch it. Ours check themselves every single day: multilingual, capturing leads, and getting you found on Google."
      variant="alternate"
    >
      <div class="max-w-5xl mx-auto">
        <div class="relative rounded-3xl border border-light-tertiary dark:border-dark-accent overflow-hidden grid md:grid-cols-2">
          <div class="bg-gray-50/80 dark:bg-dark-primary/60 p-6 sm:p-10 md:border-r border-light-tertiary dark:border-dark-accent">
            <h3 class="font-bold text-text-light-tertiary dark:text-text-dark-tertiary mb-5 uppercase tracking-wide text-xs">Their regular websites</h3>
            <ul class="space-y-4 text-sm text-text-light-secondary dark:text-text-dark-secondary">
              {THEIRS.map((t) => (
                <li class="flex gap-3"><span class="text-text-light-tertiary dark:text-text-dark-tertiary flex-shrink-0">—</span><span>{t}</span></li>
              ))}
            </ul>
          </div>
          <div class="bg-gradient-to-br from-primary-blue/[0.06] via-transparent to-primary-pink/[0.06] bg-white dark:bg-dark-secondary p-6 sm:p-10">
            <h3 class="font-bold text-primary-blue dark:text-blue-300 mb-5 uppercase tracking-wide text-xs">Our AI Smart Websites</h3>
            <ul class="space-y-4 text-sm text-text-light-secondary dark:text-text-dark-secondary">
              {OURS.map((t) => (
                <li class="flex gap-3"><svg class="w-4 h-4 mt-0.5 flex-shrink-0 text-primary-blue dark:text-blue-300" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d={check} /></svg><span>{t}</span></li>
              ))}
            </ul>
          </div>
          <span class="hidden md:flex absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 h-12 w-12 items-center justify-center rounded-full bg-white dark:bg-dark-secondary border border-light-tertiary dark:border-dark-accent shadow-lg text-sm font-black apple-gradient-text" aria-hidden="true">vs</span>
        </div>
        <p class="text-center text-base sm:text-lg font-semibold text-text-light-primary dark:text-text-dark-primary mt-10 max-w-2xl mx-auto">
          A normal website that isn't updated and optimized is worth a little less every month. Yours optimizes itself and is worth a little more every day.
        </p>
        <div class="text-center mt-8">
          <a href="/plans/" class="inline-flex items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-primary-blue to-primary-pink text-white px-8 py-3.5 text-sm font-semibold transition-all duration-300">
            Compare the plans
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
          </a>
        </div>
      </div>
    </PageSection>

    <!-- ════════ WEBSITES · OPTION B — bento grid ════════ -->
    <div class="text-center pt-8">
      <span class="inline-block rounded-full border border-primary-blue/40 text-primary-blue dark:text-blue-300 text-xs font-bold uppercase tracking-wider px-4 py-1.5">Websites · Option B: bento grid</span>
    </div>
    <PageSection
      id="ws-b"
      badge="AI-Powered Websites"
      title="Websites that help you run <br />your business efficiently"
      subtitle="A normal website is frozen the day it launches: it only improves if you pay someone to touch it. Ours check themselves every single day."
      variant="default"
    >
      <div class="max-w-6xl mx-auto">
        <div class="grid gap-5 md:grid-cols-4">
          <div class="md:col-span-2 md:row-span-2 rounded-3xl border border-primary-blue/40 ring-1 ring-primary-blue/20 bg-white dark:bg-dark-secondary p-8 flex flex-col justify-center">
            <h3 class="text-xl sm:text-2xl font-bold text-text-light-primary dark:text-text-dark-primary mb-4">Most websites get worse every month. This one gets better.</h3>
            <p class="text-sm sm:text-base text-text-light-secondary dark:text-text-dark-secondary leading-relaxed mb-4">A normal site quietly rots for years while the owner assumes it's fine. Ours checks itself every single day and fixes what's safe to fix on its own.</p>
            <p class="text-sm font-semibold text-text-light-primary dark:text-text-dark-primary">Worth a little less every month, or worth a little more every day. That's the choice.</p>
          </div>
          <div class="rounded-3xl border border-light-tertiary dark:border-dark-accent bg-white dark:bg-dark-secondary p-6">
            <div class="text-2xl font-black apple-gradient-text mb-1" data-colorful-title>24/7</div>
            <p class="text-sm text-text-light-secondary dark:text-text-dark-secondary">“Remi” answers customers in any language, and captures every lead.</p>
          </div>
          <div class="rounded-3xl border border-light-tertiary dark:border-dark-accent bg-white dark:bg-dark-secondary p-6">
            <div class="text-2xl font-black apple-gradient-text mb-1" data-colorful-title>Daily</div>
            <p class="text-sm text-text-light-secondary dark:text-text-dark-secondary">Speed, SEO, and content checked and tuned: like a developer on the site every day.</p>
          </div>
          <div class="rounded-3xl border border-light-tertiary dark:border-dark-accent bg-white dark:bg-dark-secondary p-6">
            <div class="text-2xl font-black apple-gradient-text mb-1" data-colorful-title>AI-read</div>
            <p class="text-sm text-text-light-secondary dark:text-text-dark-secondary">Structured so ChatGPT and Google's AI can read, quote, and recommend you.</p>
          </div>
          <div class="rounded-3xl border border-light-tertiary dark:border-dark-accent bg-white dark:bg-dark-secondary p-6">
            <div class="text-2xl font-black apple-gradient-text mb-1" data-colorful-title>Yours</div>
            <p class="text-sm text-text-light-secondary dark:text-text-dark-secondary">Your domain and content stay yours: month-to-month, cancel anytime.</p>
          </div>
        </div>
        <div class="text-center mt-10">
          <a href="/plans/" class="inline-flex items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-primary-blue to-primary-pink text-white px-8 py-3.5 text-sm font-semibold transition-all duration-300">
            Compare the plans
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
          </a>
        </div>
      </div>
    </PageSection>

    <!-- ════════ APPS · OPTION A — pipeline · ★ MY PICK ════════ -->
    <div class="text-center pt-8">
      <span class="inline-block rounded-full bg-gradient-to-r from-primary-blue to-primary-pink text-white text-xs font-bold uppercase tracking-wider px-4 py-1.5">Apps · Option A: pipeline · ★ my pick</span>
    </div>
    <PageSection
      id="apps-a"
      badge="Business Apps"
      title="Apps for how your <br />business runs"
      subtitle="Not app-store apps: the software that removes your busywork. Standalone scripts and tools, integrations that connect everything you already use, and full custom systems."
      variant="alternate"
    >
      <div class="max-w-5xl mx-auto">
        <div class="relative">
          <div class="hidden sm:block absolute left-10 right-10 top-8 h-0.5 bg-gradient-to-r from-primary-blue via-purple-500 to-primary-pink opacity-40" aria-hidden="true"></div>
          <div class="relative flex flex-wrap justify-center sm:justify-between gap-6">
            {NODES.map((n) => (
              <div class="flex flex-col items-center gap-2 w-20">
                <span class="flex h-16 w-16 items-center justify-center rounded-2xl bg-white dark:bg-dark-secondary border border-light-tertiary dark:border-dark-accent shadow-sm">
                  <svg class="w-7 h-7 text-primary-blue dark:text-blue-300" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d={n.icon} /></svg>
                </span>
                <span class="text-xs font-semibold text-text-light-secondary dark:text-text-dark-secondary">{n.label}</span>
              </div>
            ))}
          </div>
          <div class="hidden sm:flex flex-col items-center" aria-hidden="true">
            <span class="h-8 w-0.5 bg-gradient-to-b from-purple-500 to-primary-pink opacity-40"></span>
          </div>
          <div class="flex justify-center mt-4 sm:mt-0">
            <span class="inline-flex items-center gap-2 rounded-full border border-primary-blue/40 ring-1 ring-primary-blue/20 bg-white dark:bg-dark-secondary px-5 py-2.5 text-sm font-semibold text-text-light-primary dark:text-text-dark-primary">
              <svg class="w-4 h-4 text-primary-blue dark:text-blue-300" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
              Your AI, plugged in through MCP
            </span>
          </div>
        </div>
        <div class="grid sm:grid-cols-2 gap-4 max-w-2xl mx-auto mt-10 text-center">
          <p class="text-sm text-text-light-tertiary dark:text-text-dark-tertiary"><span class="font-semibold">Before:</span> the same thing re-typed into five places.</p>
          <p class="text-sm text-text-light-primary dark:text-text-dark-primary"><span class="font-semibold text-primary-blue dark:text-blue-300">After:</span> data moves on its own, and your AI can work with it.</p>
        </div>
        <p class="text-center text-base sm:text-lg font-semibold text-text-light-primary dark:text-text-dark-primary mt-8 max-w-2xl mx-auto">
          The fastest way to get hours back is to stop doing the work a machine can do.
        </p>
        <div class="text-center mt-8">
          <a href="/apps/" class="inline-flex items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-primary-blue to-primary-pink text-white px-8 py-3.5 text-sm font-semibold transition-all duration-300">
            Explore Business Apps
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
          </a>
        </div>
      </div>
    </PageSection>

    <!-- ════════ APPS · OPTION B — zig-zag rows ════════ -->
    <div class="text-center pt-8">
      <span class="inline-block rounded-full border border-primary-blue/40 text-primary-blue dark:text-blue-300 text-xs font-bold uppercase tracking-wider px-4 py-1.5">Apps · Option B: zig-zag rows</span>
    </div>
    <PageSection
      id="apps-b"
      badge="Business Apps"
      title="Apps for how your <br />business runs"
      subtitle="Not app-store apps: the software that removes your busywork."
      variant="default"
    >
      <div class="max-w-5xl mx-auto space-y-14">
        <div class="grid md:grid-cols-2 gap-8 md:gap-12 items-center">
          <div>
            <span class="inline-block text-[11px] font-bold uppercase tracking-wide px-2.5 py-1 rounded-full mb-3 bg-gradient-to-r from-primary-blue/10 to-primary-pink/10 text-primary-blue dark:text-blue-300">Disconnected</span>
            <h3 class="text-xl font-bold text-text-light-primary dark:text-text-dark-primary mb-3">Scripts &amp; tools</h3>
            <p class="text-sm sm:text-base text-text-light-secondary dark:text-text-dark-secondary leading-relaxed">Standalone helpers with one job: a Google Apps Script that turns a spreadsheet into a quoting tool, a scheduled report that lands in your inbox every Monday, a utility that files what you used to do by hand.</p>
          </div>
          <div class="flex justify-center"><Illustration kind="automation" class="w-full max-w-[260px]" /></div>
        </div>
        <div class="grid md:grid-cols-2 gap-8 md:gap-12 items-center">
          <div class="flex justify-center md:order-first order-last"><Illustration kind="agent" class="w-full max-w-[260px]" /></div>
          <div>
            <span class="inline-block text-[11px] font-bold uppercase tracking-wide px-2.5 py-1 rounded-full mb-3 bg-gradient-to-r from-primary-blue/10 to-primary-pink/10 text-primary-blue dark:text-blue-300">Connected</span>
            <h3 class="text-xl font-bold text-text-light-primary dark:text-text-dark-primary mb-3">Integrations &amp; MCP</h3>
            <p class="text-sm sm:text-base text-text-light-secondary dark:text-text-dark-secondary leading-relaxed">Your tools wired together so data stops being re-typed: APIs and webhooks, Twilio phone &amp; SMS, Make.com and Zapier flows: and MCP servers, so the AI you use can plug into your calendar, CRM, and inventory and actually work with them.</p>
          </div>
        </div>
        <div class="text-center">
          <a href="/apps/" class="inline-flex items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-primary-blue to-primary-pink text-white px-8 py-3.5 text-sm font-semibold transition-all duration-300">
            Explore Business Apps
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
          </a>
        </div>
      </div>
    </PageSection>

    <div class="max-w-3xl mx-auto text-center px-4 py-14">
      <p class="text-sm text-text-light-secondary dark:text-text-dark-secondary">Pick one per section (A/B for Websites, A/B for Apps) and I'll build it into the homepage and delete this page.</p>
    </div>
  </main>
</BaseLayout>
