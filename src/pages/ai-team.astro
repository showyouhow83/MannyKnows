---
// The AI Team — our flagship, productized service. Ten AI specialists + one
// manager (Manny), all reading from one shared "Brand Brain," coordinated so a
// single request becomes a finished, measured deliverable. Content is driven by
// src/data/aiTeam.ts.
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import NavBar from '../components/navigation/NavBar.astro';
import Section from '../components/layout/Section.astro';
import Container from '../components/layout/Container.astro';
import DockMenu from '../components/navigation/DockMenu.astro';
import AgentAvatar from '../components/team/AgentAvatar.astro';
import Illustration from '../components/illustrations/Illustration.astro';
import StepCards from '../components/ui/StepCards.astro';
import QuoteBlock from '../components/ui/QuoteBlock.astro';
import Faq from '../components/ui/Faq.astro';
import { getTestimonial } from '../data/testimonials';
import { team, aiTeamBundles, aiTeamSetupFee, aiTeamStartingPrice, aiTeamFaq, wholeTeamBundle } from '../data/aiTeam';
import type { AgentId } from '../data/aiTeam';
import { BOOKING_URL } from '../data/booking';

// The one client quote that's literally about running an AI agent wired into
// their admin — the flagship page shouldn't be the only one without proof.
const proofQuote = getTestimonial('VL Home Services');

const roster = [...team].sort((a, b) => a.order - b.order);
const manager = roster.find((a) => a.included)!;
const agents = roster.filter((a) => !a.included);
const nameFor = (id: string) => team.find((a) => a.id === id)?.name ?? id;

const startFrom = aiTeamStartingPrice.toLocaleString('en-US');
const setup = aiTeamSetupFee.toLocaleString('en-US');
const topSave = wholeTeamBundle.savings.toLocaleString('en-US');

// "One brain, one boss" pillars.
// Short on purpose, and every phrase earns SEO keep ("AI agents trained on
// your business", "managed", "AI marketing") — no filler.
const pillars = [
  {
    icon: 'M9.75 3a3 3 0 00-3 3v.75H6A2.25 2.25 0 003.75 9v9A2.25 2.25 0 006 20.25h12A2.25 2.25 0 0020.25 18V9A2.25 2.25 0 0018 6.75h-.75V6a3 3 0 00-3-3h-4.5zM9 9.75h.008v.008H9V9.75zm6 0h.008v.008H15V9.75zM8.25 14.25h7.5',
    title: 'One Brand Brain',
    body: 'AI agents developed for your business and trained on your services, prices, and brand voice — so nothing ships off-brand.',
  },
  {
    icon: 'M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z',
    title: 'Managed by Manny AI',
    body: 'Ask once. Manny AI briefs the right AI agents, runs the job, and returns finished work for your sign-off.',
  },
  {
    icon: 'M2.25 18L9 11.25l4.306 4.307a11.95 11.95 0 015.814-5.519l2.74-1.22m0 0l-5.94-2.28m5.94 2.28l-2.28 5.941',
    title: 'AI marketing that compounds',
    body: "Research feeds writing, writing feeds design — each month's results sharpen the next.",
  },
];

// A real run, condensed hard. Asked on 7/23/2026: "I need content ideas for a
// painting company." Manny scoped the brief, Eve researched what's actually
// working for painters on TikTok, Elly turned it into 10 shoot-ready scripts,
// and one approval shipped it. Every finding, name, and figure below is from
// that run — nothing invented. Only the agents that actually worked it appear,
// one bubble each: fragmenting a specialist's answer across four bubbles read
// as chatter, not expertise. `from` is an agent id or 'you'.
// `tag` mirrors the real compose box's Outputs selector — the owner picks
// where the work should land (or leaves it blank and Manny decides), so the
// channel never has to be typed into the request itself.
const conversation: { from: AgentId | 'you'; text: string; tag?: string }[] = [
  { from: 'you', text: "I need content ideas for a painting company.", tag: 'Output: TikTok' },
  { from: 'manny', text: "On it. Eve, dig into what’s actually working for painters on TikTok right now. Elly, script the batch off her research." },
  { from: 'eve', text: "It looks like ASMR rolls and before/afters get likes, not calls. What converts is paint-mixing — “guess the color” videos built Tonester Paints to 2.1M followers. And almost no Western Mass painter is on TikTok. That’s the lane." },
  { from: 'elly', text: "Off Eve’s research: ten shoot-ready scripts, captions and hashtags included. #1 “Guess the Color”: freeze right before the reveal — “comment your guess.” Every close fits its channel: TikTok asks for a comment, Google Business says call." },
  { from: 'manny', text: "That’s the batch — half for reach, half to make the phone ring, all filmable in two afternoons. Your call." },
  { from: 'you', text: "Ship it." },
  { from: 'manny', text: "Done. When the videos start posting, I’ll flag which ones pull DMs and quote calls, and we’ll build the next batch off those." },
];

// Compact role labels shown next to each name in the chat (e.g. "Nova (SEO)").
const chatRole: Record<string, string> = {
  manny: 'Manager',
  eve: 'Research',
  elly: 'Copy',
  eny: 'Graphics & video',
  mimi: 'Voice',
  essie: 'SEO',
  bap: 'Publishing',
  addy: 'Ads',
  upie: 'Engagement',
  ana: 'Analytics',
};

// Bottleneck → agent router ("which agents do I need?" is the wrong first
// question — this maps the leak to the hire). The last two rows are the ones
// that convert the hardest-to-shop-around visitors: custom agents and the
// can't-name-it diagnostic.
const ROUTER: { leak: string; who: string; href: string; sub?: string }[] = [
  { leak: 'Leads come in and nobody answers fast enough', who: 'Remi', sub: 'front desk', href: '#agent-remi' },
  { leak: "You're guessing at what to make and for whom", who: 'Eve', sub: 'research & strategy', href: '#agent-eve' },
  { leak: 'The writing never gets done', who: 'Elly', sub: 'copywriting', href: '#agent-elly' },
  { leak: 'You look smaller than you are', who: 'Leo', sub: 'graphics & video', href: '#agent-leo' },
  { leak: "You'd post more if you didn't have to record", who: 'Aria', sub: 'voice & audio', href: '#agent-aria' },
  { leak: 'Springfield customers search for what you do — and find someone else', who: 'Nova', sub: 'SEO & local search', href: '#agent-nova' },
  { leak: 'Content exists but never ships on time', who: 'Piper', sub: 'publishing', href: '#agent-piper' },
  { leak: "You're paying for ads you can't trace to jobs", who: 'Max', sub: 'paid ads', href: '#agent-max' },
  { leak: 'Reviews and DMs sit unanswered', who: 'Finn', sub: 'engagement & reputation', href: '#agent-finn' },
  { leak: "You honestly don't know what's working", who: 'Vera', sub: 'analytics', href: '#agent-vera' },
  { leak: "Your bottleneck isn't on this list", who: 'A custom agent', sub: 'scoped on the diagnostic call', href: '#custom-agent' },
  { leak: "You can't name one", who: 'The 15-minute diagnostic', sub: "we'll find it together", href: BOOKING_URL },
];

const steps = [
  { n: '01', title: 'We sit down and find your voice', body: "A series of one-on-one working sessions between the person who owns your brand voice and our engineer, until we've dialed in exactly what you sell, who buys, and how you sound.", icon: 'M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.9 9.9 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z' },
  { n: '02', title: 'We build your Brand Brain', body: 'Everything from those sessions — plus your services, prices, past work, and best content — gets cleaned up, formatted, and loaded into one shared knowledge base every agent reads from. This is the step that makes ten agents act like one team.', icon: 'M4 7c0-1.657 3.582-3 8-3s8 1.343 8 3-3.582 3-8 3-8-1.343-8-3zM4 7v5c0 1.657 3.582 3 8 3s8-1.343 8-3V7M4 12v5c0 1.657 3.582 3 8 3s8-1.343 8-3v-5' },
  { n: '03', title: 'We build & train your agents', body: "We set up each agent you've hired around its one job, connect it to your Brand Brain and the tools it needs, and wire its handoffs through Manny.", icon: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z' },
  { n: '04', title: 'We fine-tune it with you', body: 'We run the team alongside you and adjust until the output is quality and earns your approval — before anything goes live.', icon: 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z' },
  { n: '05', title: 'You run it; we support it', body: 'You tell Manny AI what you need, approve what goes out, and read the reports. We handle the updates and ongoing support, so the team only gets sharper.', icon: 'M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15' },
];


// Structured data: the AI Team as a Service. Prices come from aiTeam.ts at
// build time so this block can never drift from the real pricing.
const pageJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'The AI Team — AI Agents for Springfield & Western Mass Businesses',
  serviceType: 'AI agent development',
  provider: {
  '@type': 'ProfessionalService',
  '@id': 'https://mannyknows.com/#business',
  name: 'MannyKnows',
  url: 'https://mannyknows.com',
  telephone: '+1-413-361-8451',
  address: { '@type': 'PostalAddress', addressLocality: 'Springfield', addressRegion: 'MA', addressCountry: 'US' },
},
  areaServed: [
    { '@type': 'City', name: 'Springfield, Massachusetts' },
    { '@type': 'AdministrativeArea', name: 'Western Massachusetts' },
    { '@type': 'AdministrativeArea', name: 'Hampden County, MA' },
    { '@type': 'AdministrativeArea', name: 'Hampshire County, MA' },
    { '@type': 'AdministrativeArea', name: 'Franklin County, MA' },
  ],
  description: 'Ten AI specialists — front desk, research, copywriting, graphics & video, voice, SEO, publishing, paid ads, engagement, and analytics — custom-built for your business and managed by Manny AI.',
  offers: [
    {
      '@type': 'Offer',
      name: 'Individual AI agent',
      price: String(aiTeamStartingPrice),
      priceCurrency: 'USD',
      description: `From $${aiTeamStartingPrice}/mo per agent, one-time $${aiTeamSetupFee} setup. Manny AI (the manager) is included with any hire.`,
    },
    {
      '@type': 'Offer',
      name: wholeTeamBundle.name,
      price: String(wholeTeamBundle.monthly),
      priceCurrency: 'USD',
      description: `All ten agents for $${wholeTeamBundle.monthly}/mo — $${wholeTeamBundle.savings}/mo less than hiring them individually.`,
    },
  ],
};
---

<BaseLayout
  title="Hire AI Agents in Springfield, MA — Built Around Your Business | MannyKnows"
  description="AI agents for Western Mass small businesses — from $95/mo. We find the bottleneck costing you money, then build the agent that fixes it: front desk, content, SEO, ads & more. Springfield, MA."
>
  <script type="application/ld+json" set:html={JSON.stringify(pageJsonLd)} />
  <main class="relative bg-light-primary dark:bg-dark-primary text-text-light-primary dark:text-text-dark-primary min-h-screen transition-colors duration-300">

    <header class="relative bg-gradient-to-t from-gray-50/50 via-gray-100/30 to-gray-50/20 dark:from-gray-900/60 dark:via-slate-800/40 dark:to-gray-900/30 transition-colors duration-300">
      <NavBar />
      <nav aria-label="breadcrumb" class="max-w-[1440px] mx-auto px-4 lg:px-6 pt-6 pb-4">
        <ol class="flex flex-wrap items-center gap-2 text-sm text-text-light-secondary dark:text-text-dark-secondary">
          <li><a href="/" class="hover:text-primary-blue transition-colors">Home</a></li>
          <li class="flex items-center"><span class="mx-2 text-text-light-tertiary dark:text-text-dark-tertiary">/</span><span class="text-text-light-primary dark:text-text-dark-primary font-medium">AI Team</span></li>
        </ol>
      </nav>

      <div class="pb-12">
        <Container>
          <div class="max-w-[1440px] mx-auto text-center">
            <div class="flex justify-center mb-6">
              <Illustration kind="agent" class="w-full max-w-[210px]" />
            </div>
            {/* Eyebrow avoids repeating the H1's "hired like staff" — it adds
                the price fact instead (badge/H1 pairing rule, Aug 2026). */}
            <span class="inline-block bg-gradient-to-r from-primary-blue/10 via-purple-500/10 to-primary-pink/10 text-primary-blue px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider mb-4">
              The AI Team · from ${startFrom}/mo · Manny AI included
            </span>
            <h1 class="sf-bold apple-headline text-4xl md:text-5xl lg:text-6xl mb-4">
              <span class="apple-gradient-text" data-colorful-title>AI agents for Springfield &amp; Western Mass businesses — hired like staff</span>
            </h1>
            <p class="sf-bold text-xl md:text-2xl font-bold text-text-light-primary dark:text-text-dark-primary mb-6">One team. One brain. One boss — you.</p>
            <p class="max-w-3xl mx-auto text-base sm:text-xl text-text-light-secondary dark:text-text-dark-secondary leading-relaxed">
              Most AI tools are blank chat boxes you prompt from scratch every time. Your AI Team is the opposite: ten AI specialists, one shared brain, one manager — every agent built around your business, trained on your voice, your services, and your customers, then fine-tuned with you until its work earns your approval. You get one simple admin and one point of contact: Manny AI puts the right agents on the job and brings the finished work back for your sign-off.
              <strong class="text-text-light-primary dark:text-text-dark-primary"> You don't start with ten — you start with the one aimed at whatever's costing you the most. And when the fix your business needs isn't on the roster, we build it: a custom agent designed for your exact problem, sitting on the same Brand Brain as the rest of the team.</strong>
              Built in Springfield, working for businesses across Western Massachusetts.
            </p>

            <!-- The three pillars, promoted into the hero (Manny: one stronger
                 hero instead of hero + separate "One brain" section) -->
            <div class="mt-10 grid gap-6 md:grid-cols-3 max-w-6xl mx-auto text-left">
              {pillars.map((pl) => (
                <div class="rounded-2xl border border-light-tertiary dark:border-dark-accent bg-white dark:bg-dark-secondary p-6">
                  <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-br from-primary-blue to-primary-pink text-white shadow-lg shadow-primary-blue/20 mb-3">
                    <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d={pl.icon} /></svg>
                  </div>
                  <h3 class="text-base font-bold text-text-light-primary dark:text-text-dark-primary mb-2">{pl.title}</h3>
                  <p class="text-sm text-text-light-secondary dark:text-text-dark-secondary leading-relaxed">{pl.body}</p>
                </div>
              ))}
            </div>

            <!-- Mini roster preview -->
            <div class="mt-8 flex items-center justify-center -space-x-2">
              {roster.map((a) => (
                <div class="w-9 h-9 sm:w-11 sm:h-11 rounded-full ring-2 ring-primary-blue/40 bg-gradient-to-br from-primary-blue/10 to-primary-pink/10 overflow-hidden" title={`${a.name} — ${a.role}`}>
                  <AgentAvatar agent={a.id} class="w-full h-full" />
                </div>
              ))}
            </div>
            <p class="mt-3 text-xs text-text-light-tertiary dark:text-text-dark-tertiary">Ten specialists and a manager, working as one team — and the roster keeps growing.</p>

            <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
              <a href="#ai-team-roster" class="inline-flex items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-primary-blue to-primary-pink text-white px-8 py-3.5 text-sm font-semibold transition-all duration-300">
                Meet the team
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" /></svg>
              </a>
              <a href={BOOKING_URL} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 rounded-xl border border-primary-blue/40 text-primary-blue dark:text-blue-300 px-6 py-3.5 text-sm font-semibold hover:bg-primary-blue/5 transition-all duration-300">
                Book the 15-min diagnostic
              </a>
            </div>
          </div>
        </Container>
      </div>
    </header>

    <!-- Before you meet anyone — the two-questions diagnostic + the
         bottleneck→agent router. Bottleneck-first framing (Manny, Aug 2026):
         the page sells the ONE right hire, not ten. -->
    <Section id="find-your-bottleneck" variant="default">
      <Container>
        <div class="max-w-3xl mx-auto text-center mb-10">
          <h2 class="sf-bold text-2xl md:text-3xl font-bold mb-4">
            <span class="apple-gradient-text" data-colorful-title>Before you meet anyone</span>
          </h2>
          <p class="text-text-light-secondary dark:text-text-dark-secondary leading-relaxed">
            Most owners land here asking "which agents do I need?" Wrong first question. Start with these two —
            most people can answer both in under a minute:
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-6 max-w-4xl mx-auto mb-10">
          <div class="rounded-2xl border border-light-tertiary dark:border-dark-accent bg-white dark:bg-dark-secondary p-7">
            <span class="inline-flex items-center justify-center w-9 h-9 rounded-full bg-gradient-to-br from-primary-blue to-primary-pink text-white font-black mb-4">1</span>
            <h3 class="text-lg font-bold text-text-light-primary dark:text-text-dark-primary mb-2">What are you bad at that keeps costing you money?</h3>
            <p class="text-sm text-text-light-secondary dark:text-text-dark-secondary leading-relaxed">That's your bottleneck. It's where the leak is.</p>
          </div>
          <div class="rounded-2xl border border-light-tertiary dark:border-dark-accent bg-white dark:bg-dark-secondary p-7">
            <span class="inline-flex items-center justify-center w-9 h-9 rounded-full bg-gradient-to-br from-primary-blue to-primary-pink text-white font-black mb-4">2</span>
            <h3 class="text-lg font-bold text-text-light-primary dark:text-text-dark-primary mb-2">What are you good at that would print revenue if it scaled?</h3>
            <p class="text-sm text-text-light-secondary dark:text-text-dark-secondary leading-relaxed">That's your lever — and it's what breaks first when volume shows up.</p>
          </div>
        </div>

        <div class="max-w-3xl mx-auto text-center mb-12 space-y-4">
          <p class="text-sm sm:text-base text-text-light-secondary dark:text-text-dark-secondary leading-relaxed">
            The answers almost never point to the same place. If leads are the problem, more sales infrastructure
            won't save you. If your close rate is fine but the process buckles at volume, more leads just make it louder.
          </p>
          <p class="text-sm sm:text-base text-text-light-secondary dark:text-text-dark-secondary leading-relaxed">
            AI isn't the strategy. It's the leverage. Your first agent goes exactly where the leak is — from the
            roster below if it's a common one, custom-built if it isn't. We've built agents that check project
            statuses against a contractor's backend and phone systems that answer a daycare's calls in two
            languages. The roster is where most businesses start; it's not where the possibilities end.
          </p>
          <p class="text-sm sm:text-base text-text-light-secondary dark:text-text-dark-secondary leading-relaxed">
            And because every agent — stock or custom — reads from the same Brand Brain, the first hire is never a
            throwaway. It's the foundation the second one starts from.
          </p>
        </div>

        <!-- The router: leak on the left, hire on the right -->
        <div class="max-w-3xl mx-auto rounded-2xl border border-light-tertiary dark:border-dark-accent bg-white dark:bg-dark-secondary overflow-hidden">
          <div class="grid grid-cols-[1fr_auto] items-center gap-x-4 px-5 py-3 border-b border-light-tertiary dark:border-dark-accent bg-light-secondary/50 dark:bg-dark-primary/50">
            <span class="text-[11px] font-bold uppercase tracking-wider text-text-light-tertiary dark:text-text-dark-tertiary">If this is the leak</span>
            <span class="text-[11px] font-bold uppercase tracking-wider text-text-light-tertiary dark:text-text-dark-tertiary text-right">Start here</span>
          </div>
          {ROUTER.map((r, i) => (
            <a
              href={r.href}
              target={r.href.startsWith('http') ? '_blank' : undefined}
              rel={r.href.startsWith('http') ? 'noopener noreferrer' : undefined}
              class={`grid grid-cols-[1fr_auto] items-center gap-x-4 px-5 py-3.5 transition-colors hover:bg-primary-blue/5 ${i > 0 ? 'border-t border-light-tertiary dark:border-dark-accent' : ''} ${i >= 10 ? 'bg-gradient-to-r from-primary-blue/[0.04] to-primary-pink/[0.04]' : ''}`}
            >
              <span class="text-sm text-text-light-primary dark:text-text-dark-primary leading-snug">{r.leak}</span>
              <span class="text-right">
                <span class="block text-sm font-bold text-primary-blue dark:text-blue-300">{r.who} →</span>
                {r.sub && <span class="block text-[11px] text-text-light-tertiary dark:text-text-dark-tertiary">{r.sub}</span>}
              </span>
            </a>
          ))}
        </div>
      </Container>
    </Section>

    <!-- What that looks like in practice -->
    <Section id="ai-team-example" variant="alternate">
      <Container>
        <div class="max-w-3xl mx-auto">
          <div class="text-center mb-8">
            <h2 class="sf-bold text-2xl md:text-3xl font-bold">
              <span class="apple-gradient-text" data-colorful-title>What that looks like in practice</span>
            </h2>
            <p class="mt-3 text-base text-text-light-secondary dark:text-text-dark-secondary leading-relaxed">
              You talk to one place — Manny AI — and the team works in the thread. This is one run, condensed: one line typed, TikTok tapped as the output, one decision at the end.
            </p>
          </div>

          <!-- The example, shown as the actual group chat between you, Manny, and the agents. -->
          <div class="max-w-2xl mx-auto rounded-3xl border border-light-tertiary dark:border-dark-accent bg-light-secondary/40 dark:bg-dark-primary/40 overflow-hidden shadow-sm">
            <div class="flex items-center gap-3 px-4 py-3 border-b border-light-tertiary dark:border-dark-accent bg-white/70 dark:bg-dark-secondary/70">
              <div class="flex -space-x-2">
                {(['manny', 'eve', 'elly'] as const).map((id) => (
                  <div class="w-7 h-7 rounded-full ring-2 ring-white dark:ring-dark-secondary overflow-hidden bg-gradient-to-br from-primary-blue/10 to-primary-pink/10">
                    <AgentAvatar agent={id} class="w-full h-full" />
                  </div>
                ))}
              </div>
              <div>
                <div class="text-sm font-bold text-text-light-primary dark:text-text-dark-primary leading-tight">Your AI Team</div>
                <div class="text-[11px] text-green-600 dark:text-green-400 flex items-center gap-1"><span class="w-1.5 h-1.5 rounded-full bg-green-500 inline-block"></span> online · managed by Manny AI</div>
              </div>
            </div>
            <div class="px-4 py-5 space-y-2.5">
              {conversation.map((m, i) => (
                m.from === 'you' ? (
                  <div class="flex flex-col items-end">
                    <div class="max-w-[82%] rounded-2xl rounded-br-sm bg-gradient-to-r from-primary-blue to-primary-pink text-white px-4 py-2.5 text-sm leading-snug shadow-sm">{m.text}</div>
                    {m.tag && (
                      <span class="mt-1 mr-1 text-[11px] px-2 py-0.5 rounded-full border border-light-tertiary dark:border-dark-accent text-text-light-tertiary dark:text-text-dark-tertiary bg-white/60 dark:bg-dark-secondary/60">{m.tag}</span>
                    )}
                  </div>
                ) : (
                  <div class="flex items-end gap-2">
                    {conversation[i - 1] && conversation[i - 1].from === m.from ? (
                      <div class="w-8 flex-shrink-0" aria-hidden="true"></div>
                    ) : (
                      <div class="w-8 h-8 rounded-full overflow-hidden flex-shrink-0 ring-1 ring-primary-blue/20 bg-gradient-to-br from-primary-blue/10 to-primary-pink/10">
                        <AgentAvatar agent={m.from} class="w-full h-full" />
                      </div>
                    )}
                    <div class="max-w-[82%]">
                      {!(conversation[i - 1] && conversation[i - 1].from === m.from) && (
                        <span class="block text-[11px] mb-0.5 ml-1">
                          <span class="font-semibold text-primary-blue dark:text-blue-300">{nameFor(m.from)}</span>
                          <span class="text-text-light-tertiary dark:text-text-dark-tertiary"> ({chatRole[m.from]})</span>
                        </span>
                      )}
                      <div class="rounded-2xl rounded-bl-sm bg-white dark:bg-dark-secondary border border-light-tertiary dark:border-dark-accent px-4 py-2.5 text-sm text-text-light-secondary dark:text-text-dark-secondary leading-snug shadow-sm">{m.text}</div>
                    </div>
                  </div>
                )
              ))}
            </div>
          </div>
          <p class="mt-8 text-center text-base font-semibold text-text-light-primary dark:text-text-dark-primary">
            That was a manager and two AI agents working for one Springfield painting contractor. Hire AI agents the same way — the ones your business needs, trained on your voice, from $95/mo each.
          </p>
        </div>
      </Container>
    </Section>

    <!-- Local proof strip — the page's heaviest geo signal is real Western
         Mass results with descriptive anchors into the case studies. -->
    <Section id="ai-team-proof-strip" variant="default">
      <Container>
        <div class="max-w-4xl mx-auto text-center">
          <h2 class="sf-bold text-xl md:text-2xl font-bold mb-4">
            <span class="apple-gradient-text" data-colorful-title>Built here, proven here</span>
          </h2>
          <p class="text-sm sm:text-base text-text-light-secondary dark:text-text-dark-secondary leading-relaxed">
            A <a href="/work/sl-painting/" class="font-semibold text-primary-blue dark:text-blue-300 hover:underline">Springfield painting contractor ranking #1 organically for exterior painting</a>.
            A <a href="/work/jk-daycare/" class="font-semibold text-primary-blue dark:text-blue-300 hover:underline">local daycare whose AI answers parents in English and Spanish</a>, on the site and on the phone.
            A <a href="/work/vl-home-services/" class="font-semibold text-primary-blue dark:text-blue-300 hover:underline">home services company whose custom agent checks project statuses straight from their backend</a>.
            <a href="/#work" class="font-semibold text-primary-blue dark:text-blue-300 hover:underline whitespace-nowrap">See the work →</a>
          </p>
        </div>
      </Container>
    </Section>

    <!-- Meet the team (roster) -->
    <Section id="ai-team-roster" variant="default">
      <Container>
        <div class="text-center max-w-2xl mx-auto mb-8">
          <h2 class="sf-bold text-2xl md:text-3xl font-bold">
            <span class="apple-gradient-text" data-colorful-title>Meet — and hire — your team</span>
          </h2>
          <p class="mt-3 text-base text-text-light-secondary dark:text-text-dark-secondary leading-relaxed">
            Each agent owns one job and does it well. "Hiring" one means we build it around your business, connect it to your Brand Brain, and fine-tune it with you until it's ready. Hire one and it delivers straight to you through Manny. Hire more and Manny coordinates the handoffs automatically — and every agent can take a name that fits your brand.
          </p>
          <p class="mt-3 text-xs text-text-light-tertiary dark:text-text-dark-tertiary">
            Agents from ${startFrom}/mo each · one-time ${setup} setup · Manny AI included with any hire · normal AI usage included · add or drop agents anytime
          </p>
        </div>

        <!-- Manager -->
        <div id={`agent-${manager.name.toLowerCase().replace(/\s+/g, '-')}`} class="scroll-mt-24 mb-8 max-w-6xl mx-auto rounded-3xl border border-primary-blue/40 ring-1 ring-primary-blue/20 bg-gradient-to-br from-primary-blue/[0.06] via-transparent to-primary-pink/[0.06] p-6 sm:p-8 flex flex-col sm:flex-row items-center gap-6">
          <div class="w-36 h-36 flex-shrink-0 rounded-2xl bg-gradient-to-br from-primary-blue/[0.07] via-transparent to-primary-pink/[0.07]">
            <AgentAvatar agent={manager.id} class="w-full h-full" />
          </div>
          <div class="flex-1 text-center sm:text-left">
            <div class="flex flex-wrap items-center justify-center sm:justify-start gap-2 mb-1">
              <h3 class="text-xl font-bold text-text-light-primary dark:text-text-dark-primary">{manager.name}</h3>
              <span class="inline-block bg-gradient-to-r from-primary-blue to-primary-pink text-white text-[11px] font-bold uppercase tracking-wide px-2.5 py-1 rounded-full">{manager.note}</span>
            </div>
            <span class="block text-[11px] font-semibold uppercase tracking-wide text-primary-blue dark:text-blue-300 mb-2">{manager.role}</span>
            <p class="text-sm text-text-light-secondary dark:text-text-dark-secondary leading-relaxed">{manager.does}</p>
          </div>
        </div>

        <!-- Agents -->
        <div class="grid gap-6 sm:grid-cols-2 max-w-6xl mx-auto">
          <!-- Anchor ids are the slugified agent name so multi-word names
               ("Manny AI") stay valid; single-word agents keep #agent-<name>. -->
          {agents.map((a) => (
            <div id={`agent-${a.name.toLowerCase().replace(/\s+/g, '-')}`} class="scroll-mt-24 rounded-2xl border border-light-tertiary dark:border-dark-accent bg-white dark:bg-dark-secondary p-6 flex flex-col hover:border-primary-blue/40 hover:shadow-lg transition-all duration-300">
              <div class="flex items-center gap-3 mb-3">
                <div class="w-24 h-24 sm:w-28 sm:h-28 flex-shrink-0 rounded-xl bg-gradient-to-br from-primary-blue/[0.07] via-transparent to-primary-pink/[0.07]">
                  <AgentAvatar agent={a.id} class="w-full h-full" alt={`${a.name}, ${a.role} — AI agent for Springfield & Western Mass small businesses by MannyKnows`} />
                </div>
                <div class="min-w-0">
                  <h3 class="text-lg font-bold text-text-light-primary dark:text-text-dark-primary leading-tight">{a.name}</h3>
                  <span class="text-[11px] font-semibold uppercase tracking-wide text-primary-blue dark:text-blue-300">{a.role}</span>
                </div>
              </div>
              {a.symptom && <p class="text-sm italic text-text-light-primary dark:text-text-dark-primary mb-2">{a.symptom}</p>}
              <p class="flex-1 text-sm text-text-light-secondary dark:text-text-dark-secondary leading-relaxed">{a.does}</p>
              <div class="mt-4 pt-1 flex items-end justify-between gap-3">
                <div class="leading-none">
                  <span class="text-2xl font-black text-text-light-primary dark:text-text-dark-primary">${a.price}</span><span class="text-sm text-text-light-secondary dark:text-text-dark-secondary">/mo</span>
                  {a.note && <span class="block text-[11px] text-text-light-tertiary dark:text-text-dark-tertiary mt-1">{a.note}</span>}
                </div>
                <a
                  href="#contact"
                  data-contact-context={`AI Team — hire ${a.name} (${a.role})`}
                  class="flex-shrink-0 inline-flex items-center justify-center rounded-xl border border-primary-blue/40 text-primary-blue dark:text-blue-300 px-4 py-2.5 text-sm font-semibold hover:bg-primary-blue/5 transition-all duration-300"
                >
                  Hire {a.name}
                </a>
              </div>
            </div>
          ))}

          <!-- The closer: custom agents, promoted from footnote to roster card
               (Manny, Aug 2026). Weird problems are the highest-margin,
               hardest-to-shop-around work — and custom agents that prove
               useful become roster agents, which is what "the roster keeps
               growing" actually means. -->
          <div id="custom-agent" class="scroll-mt-24 rounded-2xl border-2 border-dashed border-primary-blue/40 bg-gradient-to-br from-primary-blue/[0.04] via-transparent to-primary-pink/[0.04] p-6 flex flex-col hover:border-primary-blue/70 transition-all duration-300">
            <div class="flex items-center gap-3 mb-3">
              <div class="w-24 h-24 sm:w-28 sm:h-28 flex-shrink-0 rounded-xl border-2 border-dashed border-primary-blue/30 flex items-center justify-center">
                <svg class="w-10 h-10 text-primary-blue dark:text-blue-300" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" /></svg>
              </div>
              <div class="min-w-0">
                <h3 class="text-lg font-bold text-text-light-primary dark:text-text-dark-primary leading-tight">Your Custom Agent</h3>
                <span class="text-[11px] font-semibold uppercase tracking-wide text-primary-blue dark:text-blue-300">Built for your exact problem</span>
              </div>
            </div>
            <p class="text-sm italic text-text-light-primary dark:text-text-dark-primary mb-2">For when your bottleneck isn't anyone else's.</p>
            <p class="flex-1 text-sm text-text-light-secondary dark:text-text-dark-secondary leading-relaxed">
              The roster covers what every business needs. Some businesses need something only theirs does — an
              agent wired into your backend, your phone line, your scheduling, your inventory. We scope it, build
              it around your Brand Brain, and Manny manages it like any other hire.
            </p>
            <div class="mt-4 pt-1 flex items-end justify-between gap-3">
              <div class="leading-none">
                <span class="text-sm font-semibold text-text-light-primary dark:text-text-dark-primary">Scoped &amp; quoted</span>
                <span class="block text-[11px] text-text-light-tertiary dark:text-text-dark-tertiary mt-1">on the diagnostic call</span>
              </div>
              <a
                href="#contact"
                data-contact-context="AI Team — custom agent"
                class="flex-shrink-0 inline-flex items-center justify-center rounded-xl bg-gradient-to-r from-primary-blue to-primary-pink text-white px-4 py-2.5 text-sm font-semibold transition-all duration-300"
              >
                Scope my agent
              </a>
            </div>
          </div>
        </div>

        <!-- Human-in-the-loop card — closes the roster per Manny (Aug 2026):
             meet the team, then hear who stays in charge. -->
        <div class="max-w-3xl mx-auto mt-14 rounded-2xl border border-light-tertiary dark:border-dark-accent bg-white dark:bg-dark-secondary p-8 text-center">
          <h2 class="sf-bold text-2xl md:text-3xl font-bold mb-4">
            <span class="apple-gradient-text" data-colorful-title>Not fully autonomous — on purpose</span>
          </h2>
          <p class="text-base text-text-light-secondary dark:text-text-dark-secondary leading-relaxed">
            The agents do the heavy lifting — researching, drafting, designing, scheduling, monitoring, measuring. You stay in control: nothing customer-facing goes out until you approve it, Max never moves a dollar of budget without your sign-off, and a real person steps in where judgment matters — the calls, the verifications, the review appeals, the decisions AI shouldn't make alone. You get the speed of automation without handing your brand to a robot.
          </p>
        </div>
      </Container>
    </Section>

    <!-- How it works -->
    <!-- (Bundles section moved below the FAQ per Manny, Aug 2026) -->
    <Section id="ai-team-steps" variant="alternate">
      <Container>
        <h2 class="sf-bold text-2xl md:text-3xl font-bold text-center mb-12">
          <span class="apple-gradient-text" data-colorful-title>How it works</span>
        </h2>
        <StepCards steps={steps} cols={5} class="max-w-7xl mx-auto" />
      </Container>
    </Section>

    <!-- FAQ -->
    <Section id="ai-team-faq" variant="alternate">
      <Container>
        <div class="max-w-3xl mx-auto">
          <Faq faqs={aiTeamFaq} />
          <div class="text-center mt-12">
            <a href="#contact" data-contact-context="AI Team" class="inline-flex items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-primary-blue to-primary-pink text-white px-6 py-3 text-sm font-semibold transition-all duration-300">
              Build my AI team
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
            </a>
          </div>
        </div>
      </Container>
    </Section>

    <!-- Bundles — below the questions per Manny (Aug 2026): once the FAQ has
         answered how hiring works, this is the "pick your squad" close. -->
    <Section id="ai-team-bundles" variant="alternate">
      <Container>
        <div class="text-center max-w-2xl mx-auto mb-10">
          <h2 class="sf-bold text-2xl md:text-3xl font-bold">
            <span class="apple-gradient-text" data-colorful-title>Hire one, a squad, or the whole operation</span>
          </h2>
          <p class="mt-3 text-base text-text-light-secondary dark:text-text-dark-secondary leading-relaxed">
            Any single agent — from ${startFrom}/mo. Every agent works on its own, with Manny AI included as your manager and delivery channel. Hire only Eve and her research lands in your inbox the way you like to read it.
          </p>
          <p class="mt-3 text-sm text-text-light-tertiary dark:text-text-dark-tertiary leading-relaxed">
            Most clients shouldn't start here. Bundles make sense when the two questions point at more than one
            department — otherwise, start with one agent and let the numbers argue for the second.
          </p>
        </div>

        <div class="grid gap-6 lg:grid-cols-3 max-w-6xl mx-auto items-stretch">
          {aiTeamBundles.map((b) => (
            <div class={`relative rounded-3xl border p-6 sm:p-7 flex flex-col ${b.best ? 'border-primary-blue/50 ring-1 ring-primary-blue/20 bg-gradient-to-br from-primary-blue/[0.06] via-transparent to-primary-pink/[0.06]' : 'border-light-tertiary dark:border-dark-accent bg-white dark:bg-dark-secondary'}`}>
              {b.best && (
                <span class="absolute -top-3 left-1/2 -translate-x-1/2 inline-block bg-gradient-to-r from-primary-blue to-primary-pink text-white text-[11px] font-bold uppercase tracking-wide px-3 py-1 rounded-full">Best value</span>
              )}
              <h3 class="text-lg font-bold text-text-light-primary dark:text-text-dark-primary">{b.name}</h3>
              {b.diagnosis && <p class="mt-2 text-sm italic text-text-light-primary dark:text-text-dark-primary leading-snug">{b.diagnosis}</p>}
              <div class="mt-2 leading-none">
                {b.addOn && <span class="text-sm text-text-light-secondary dark:text-text-dark-secondary">add </span>}
                <span class="text-3xl font-black text-text-light-primary dark:text-text-dark-primary">${b.monthly.toLocaleString('en-US')}</span><span class="text-sm text-text-light-secondary dark:text-text-dark-secondary">/mo</span>
              </div>
              <p class="mt-1 text-xs text-text-light-tertiary dark:text-text-dark-tertiary">
                ${b.alaCarte.toLocaleString('en-US')} à la carte · save ${b.savings.toLocaleString('en-US')}/mo
              </p>
              <p class="mt-3 text-sm text-text-light-secondary dark:text-text-dark-secondary leading-relaxed flex-1">{b.tagline}</p>
              <ul class="mt-4 flex flex-wrap gap-1.5">
                {b.agentIds.map((id) => (
                  <li class="text-[11px] font-medium text-primary-blue dark:text-blue-300 bg-primary-blue/10 rounded-full px-2 py-0.5">{nameFor(id)}</li>
                ))}
              </ul>
              <a
                href="#contact"
                data-contact-context={`AI Team — ${b.name}`}
                class={`mt-5 inline-flex items-center justify-center gap-1.5 rounded-xl px-5 py-3 text-sm font-semibold transition-all duration-300 ${b.best ? 'bg-gradient-to-r from-primary-blue to-primary-pink text-white' : 'border border-primary-blue/40 text-primary-blue dark:text-blue-300 hover:bg-primary-blue/5'}`}
              >
                Hire {b.name.replace('The ', '')}
              </a>
            </div>
          ))}
        </div>

        <p class="mt-8 text-center text-xs text-text-light-tertiary dark:text-text-dark-tertiary max-w-2xl mx-auto leading-relaxed">
          One-time ${setup} setup builds your Brand Brain and trains your team — however many agents you hire — including cleaning up and formatting your data so they answer accurately from day one. Normal AI usage is included; unusually heavy usage is metered at cost and quoted before it ever hits a bill. Add or drop agents anytime.
        </p>
      </Container>
    </Section>

    <!-- Client proof — after the questions, the answer per Manny (Aug 2026) -->
    {proofQuote && (
      <Section id="ai-team-proof" variant="default">
        <Container>
          <div class="max-w-2xl mx-auto text-center">
            <p class="text-sm font-semibold uppercase tracking-wide text-primary-blue dark:text-blue-300 mb-6">Clients running Remi AI</p>
            <QuoteBlock quote={proofQuote} align="center" />
          </div>
        </Container>
      </Section>
    )}

    <!-- Final CTA — the diagnostic, no pitch (bottleneck-first close) -->
    <Section id="ai-team-diagnostic" variant="gradient">
      <Container>
        <div class="max-w-2xl mx-auto text-center">
          <h2 class="sf-bold text-2xl md:text-4xl font-bold mb-5">
            <span class="apple-gradient-text" data-colorful-title>Two questions. Fifteen minutes. No pitch until we know where the leak is.</span>
          </h2>
          <p class="text-base sm:text-lg text-text-light-secondary dark:text-text-dark-secondary leading-relaxed mb-8">
            Bring your answers — or bring nothing and we'll find them together. You leave the call knowing which
            department is bleeding and which single agent stops it: one from the roster, or one we scope just for
            you. If the honest answer is "none yet," we'll tell you that too. Springfield-based, serving all of
            Western Mass, in English and Spanish.
          </p>
          <a href={BOOKING_URL} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-primary-blue to-primary-pink text-white px-8 py-3.5 text-sm font-semibold transition-all duration-300">
            Book the diagnostic
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
          </a>
        </div>
      </Container>
    </Section>

    <DockMenu />
  </main>
</BaseLayout>
