---
// The AI Agents Team — our flagship, productized service. Manny AI is added to
// the business, ready to work: one
// manager that staffs AI specialists (visible roster + hidden sub-agents), all
// reading from one shared "Brand Brain," so a single request becomes a
// finished, measured deliverable. Priced per WORKFLOW (aiTeam.ts mannyAiTiers,
// Aug 16 2026), never per agent; Remi AI is the one agent that is also a
// product on its own (its own ladder in src/data/remi.ts).
// Content is driven by src/data/aiTeam.ts.
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import NavBar from '../components/navigation/NavBar.astro';
import Section from '../components/layout/Section.astro';
import Container from '../components/layout/Container.astro';
import DockMenu from '../components/navigation/DockMenu.astro';
import AgentAvatar from '../components/team/AgentAvatar.astro';
import StepCards from '../components/ui/StepCards.astro';
import Faq from '../components/ui/Faq.astro';
import Breadcrumb from '../components/ui/Breadcrumb.astro';
import Button from '../components/ui/Button.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import AiTeamEcosystem from '../components/team/AiTeamEcosystem.astro';
import { team, aiTeamSetupFee, aiTeamStartingPrice, aiTeamFaq, mannyAiTiers } from '../data/aiTeam';
import PricingCards from '../components/pricing/PricingCards.astro';
import { mannyAiCards } from '../lib/pricingCards';
import type { AgentId } from '../data/aiTeam';
import { BOOKING_URL } from '../data/booking';

// hidden agents (Leo, Aria, Piper, Max) work as Manny AI sub-agents — they
// appear nowhere on the page (Manny, Aug 2026).
const roster = [...team].filter((a) => !a.hidden).sort((a, b) => a.order - b.order);
const manager = roster.find((a) => a.included)!;
const agents = roster.filter((a) => !a.included);

const startFrom = aiTeamStartingPrice.toLocaleString('en-US');

// "One brain, one boss" pillars.
// Short on purpose, and every phrase earns SEO keep ("AI agents trained on
// your business", "managed", "AI marketing") — no filler.
// Typed so `avatar` is an AgentId, not string — AgentAvatar rejects the latter.
const pillars: { icon: string; title: string; body: string; avatar?: AgentId }[] = [
  {
    icon: 'M9.75 3a3 3 0 00-3 3v.75H6A2.25 2.25 0 003.75 9v9A2.25 2.25 0 006 20.25h12A2.25 2.25 0 0020.25 18V9A2.25 2.25 0 0018 6.75h-.75V6a3 3 0 00-3-3h-4.5zM9 9.75h.008v.008H9V9.75zm6 0h.008v.008H15V9.75zM8.25 14.25h7.5',
    title: 'One Brand Brain',
    body: 'AI agents developed for your business and trained on your services, prices, and brand voice, so nothing ships off-brand.',
  },
  {
    icon: 'M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z',
    title: 'One agent you talk to',
    body: 'Manny AI is your everything partner. Ask for what you need, and it scopes the work, sends the plan back for your approval, then puts the right specialists on the job.',
    avatar: 'manny',
  },
  {
    icon: 'M2.25 18L9 11.25l4.306 4.307a11.95 11.95 0 015.814-5.519l2.74-1.22m0 0l-5.94-2.28m5.94 2.28l-2.28 5.941',
    title: 'A swarm of AI agents behind it',
    body: 'The specialists Manny AI puts to work, each configured to do the best possible job and to sharpen the process every time they run it, so the same work comes back faster and better each month.',
  },
];


const steps = [
  { n: '01', title: 'We sit down and find your voice', body: "A series of one-on-one working sessions between the person who owns your brand voice and our engineer, until we've dialed in exactly what you sell, who buys, and how you sound.", icon: 'M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.9 9.9 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z' },
  { n: '02', title: 'We build your Brand Brain', body: 'Everything from those sessions (plus your services, prices, past work, and best content) gets cleaned up, formatted, and loaded into one shared knowledge base every agent reads from.', icon: 'M4 7c0-1.657 3.582-3 8-3s8 1.343 8 3-3.582 3-8 3-8-1.343-8-3zM4 7v5c0 1.657 3.582 3 8 3s8-1.343 8-3V7M4 12v5c0 1.657 3.582 3 8 3s8-1.343 8-3v-5' },
  { n: '03', title: 'We build & train your agents', body: "We set up each specialist Manny AI staffs around its one job, connect it to your Brand Brain and the tools it needs, and wire its handoffs through Manny AI.", icon: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z' },
  { n: '04', title: 'We fine-tune it with you', body: 'We run the team alongside you and adjust until the output is quality and earns your approval, before anything goes live.', icon: 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z' },
  { n: '05', title: 'You run it; we support it', body: 'You tell Manny AI what you need, approve what goes out, and read the reports. We handle the updates and ongoing support, so the team only gets sharper.', icon: 'M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15' },
];


// Structured data: the AI Agents Team as a Service. Prices come from aiTeam.ts at
// build time so this block can never drift from the real pricing.
const pageJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'The AI Agents Team for Springfield & Western Mass Businesses',
  serviceType: 'AI agent development',
  provider: {
  '@type': 'ProfessionalService',
  '@id': 'https://mannyknows.com/#business',
  name: 'MannyKnows',
  url: 'https://mannyknows.com',
  telephone: '+1-413-361-8451',
  address: { '@type': 'PostalAddress', addressLocality: 'Springfield', addressRegion: 'MA', addressCountry: 'US' },
},
  areaServed: [
    { '@type': 'City', name: 'Springfield, Massachusetts' },
    { '@type': 'AdministrativeArea', name: 'Western Massachusetts' },
    { '@type': 'AdministrativeArea', name: 'Hampden County, MA' },
    { '@type': 'AdministrativeArea', name: 'Hampshire County, MA' },
    { '@type': 'AdministrativeArea', name: 'Franklin County, MA' },
  ],
  description: 'Manny AI is added to your business, ready to work — one manager that finds the processes AI can improve and staffs AI specialists on them: chat agent, daily intel, copywriting, SEO, engagement, and analytics, with design, video, voice, publishing, and ads sub-agents behind the scenes. Custom-built for your business.',
  offers: [
    {
      '@type': 'Offer',
      name: 'Remi AI: AI chat agent',
      price: String(aiTeamStartingPrice),
      priceCurrency: 'USD',
      description: `Remi AI answers 24/7 and captures every lead, with its own plans from $${aiTeamStartingPrice}/mo; booking arrives on Remi AI Pro. Included with every website plan, where it books from Get Booked and sells from Get Growing.`,
    },
    ...mannyAiTiers.map((t) => ({
      '@type': 'Offer',
      name: `Manny AI: ${t.name}`,
      price: String(t.price),
      priceCurrency: 'USD',
      priceSpecification: { '@type': 'UnitPriceSpecification', price: String(t.price), priceCurrency: 'USD', unitText: 'MONTH' },
      description: `${t.tagline} Priced per workflow, never per agent; one-time $${aiTeamSetupFee} setup, waived on a prepaid year.`,
    })),
  ],
};
---

<BaseLayout
  title="AI Chatbots, Agents & Automation Springfield MA | MannyKnows"
  description={`AI chatbots, agents & automation for Springfield, MA and Western Mass businesses, from $${startFrom}/mo. We find the bottleneck, then put the agent that fixes it to work.`}
>
  <script type="application/ld+json" set:html={JSON.stringify(pageJsonLd)} />
  {/* one-canvas: one tone for the whole page instead of a different colour
      per section (Manny, Aug 2026). Hue is grouped by pillar — see the
      ONE-TONE CANVAS block in global.css. The per-section .room /
      .chain-* / .glow-* classes below are left in place on purpose:
      delete the two classes on the next line and the page reverts. */}
  <main class="relative bg-light-primary dark:bg-dark-primary text-text-light-primary dark:text-text-dark-primary min-h-screen transition-colors duration-300 one-canvas one-canvas-live">

    <header class="relative bg-gradient-to-t from-gray-50/50 via-gray-100/30 to-gray-50/20 dark:from-gray-900/60 dark:via-slate-800/40 dark:to-gray-900/30 transition-colors duration-300 room-hero">
      <NavBar />
      <Breadcrumb items={[{ label: 'AI Agents Team' }]} />

      <div class="pb-12">
        <Container>
          <div class="max-w-[1440px] mx-auto text-center">
            <!-- Manny AI in the suit — the astronaut used all over the site,
                 identified: it's been Manny AI in there the whole time. -->
            <div class="flex justify-center mb-6">
              <img
                src="/mascot/astro-manny-ai.webp"
                alt="Manny AI waving in a MannyKnows astronaut suit"
                aria-hidden="true"
                width="508"
                height="880"
                decoding="async"
                class="astro-float w-auto h-[220px] pointer-events-none"
              />
            </div>
            {/* Eyebrow adds the price fact the H1 doesn't carry, rather than
                restating it (badge/H1 pairing rule, Aug 2026). */}
            <span class="inline-block bg-gradient-to-r from-primary-blue/10 via-purple-500/10 to-primary-pink/10 text-primary-blue px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider mb-4">
              The AI Agents Team · Springfield, MA
            </span>
            <h1 class="sf-bold apple-headline text-4xl md:text-5xl lg:text-6xl mb-6">
              <span class="apple-gradient-text" data-colorful-title>AI agents for Springfield &amp; Western Mass businesses</span>
            </h1>
            <p class="sf-bold text-base md:text-2xl font-bold text-text-light-primary dark:text-text-dark-primary mb-6">One team. One brain. One boss: you.</p>
            <p class="max-w-3xl mx-auto text-base sm:text-xl text-text-light-secondary dark:text-text-dark-secondary leading-relaxed">
              When people picture AI, they picture a chat box you have to prompt. This is <strong class="text-text-light-primary dark:text-text-dark-primary">Manny AI</strong> instead — a manager added to your business, ready to work. It finds the processes AI can improve, then staffs AI specialists onto them, like three, five, or seven people in one, custom-built when the job needs something no roster covers. Each AI agent is trained on your business, voice and services.
            </p>

            <!-- Merged from the old "Before you meet anyone" section (Manny,
                 Aug 2026): the two-question diagnostic + the Brand Brain
                 control paragraph now open the page. -->
            <p class="mt-8 max-w-3xl mx-auto text-sm sm:text-base text-text-light-secondary dark:text-text-dark-secondary leading-relaxed">
              Most owners land here asking "which AI agents does my business need?" Two questions get you there, and most people can answer both in under a minute:
            </p>
            <div class="mt-6 grid md:grid-cols-2 gap-6 max-w-6xl mx-auto text-left">
              <div class="rounded-2xl border border-light-tertiary dark:border-dark-accent bg-white dark:bg-dark-secondary p-6">
                <div class="flex items-center gap-3 mb-2">
                  <span class="flex h-11 w-11 flex-shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-primary-blue to-primary-pink text-white shadow-lg shadow-primary-blue/20 font-black">1</span>
                  <h3 class="text-lg font-bold text-text-light-primary dark:text-text-dark-primary leading-snug">What are you bad at that keeps costing you money?</h3>
                </div>
                <p class="text-sm text-text-light-secondary dark:text-text-dark-secondary leading-relaxed">That's your bottleneck. It's where the leak is.</p>
              </div>
              <div class="rounded-2xl border border-light-tertiary dark:border-dark-accent bg-white dark:bg-dark-secondary p-6">
                <div class="flex items-center gap-3 mb-2">
                  <span class="flex h-11 w-11 flex-shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-primary-blue to-primary-pink text-white shadow-lg shadow-primary-blue/20 font-black">2</span>
                  <h3 class="text-lg font-bold text-text-light-primary dark:text-text-dark-primary leading-snug">What are you good at that would print revenue if it scaled?</h3>
                </div>
                <p class="text-sm text-text-light-secondary dark:text-text-dark-secondary leading-relaxed">That's your lever, and it's what breaks first when volume shows up.</p>
              </div>
            </div>
            <p class="mt-8 max-w-3xl mx-auto text-sm sm:text-base text-text-light-secondary dark:text-text-dark-secondary leading-relaxed">
              The answers rarely point to the same place, and AI isn't the strategy, it's the leverage. The first
              agent goes to work where the leak is. Manny AI staffs the specialist that fixes it, stock or custom-built.
              Every AI agent reads from your Brand Brain, and the Brand Brain is yours to set. Change your services,
              your prices, or the way you want things said, and every agent works from the new version on its next
              run. That is the control. You edit one source, and the whole team moves with it.
            </p>

            <!-- The three pillars (kept per Manny) -->
            <div class="mt-10 grid gap-6 md:grid-cols-3 max-w-6xl mx-auto text-left">
              {pillars.map((pl) => (
                <div class="relative rounded-2xl border border-light-tertiary dark:border-dark-accent bg-white dark:bg-dark-secondary p-6">
                  {pl.avatar && (
                    <div class="absolute -top-7 right-4 w-16 h-16 pointer-events-none">
                      <AgentAvatar agent={pl.avatar} class="w-full h-full" sizes="64px" />
                    </div>
                  )}
                  <div class="flex items-center gap-3 mb-2">
                    <div class="flex h-11 w-11 flex-shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-primary-blue to-primary-pink text-white shadow-lg shadow-primary-blue/20">
                      <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d={pl.icon} /></svg>
                    </div>
                    <h3 class="text-lg font-bold text-text-light-primary dark:text-text-dark-primary leading-snug">{pl.title}</h3>
                  </div>
                  <p class="text-sm text-text-light-secondary dark:text-text-dark-secondary leading-relaxed">{pl.body}</p>
                </div>
              ))}
            </div>

            <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
              <Button href="#ai-team-roster" arrow="down">Meet the team</Button>
              <Button href={BOOKING_URL} target="_blank" rel="noopener noreferrer" variant="secondary">Book a free diagnostic</Button>
            </div>
          </div>
        </Container>
      </div>
    </header>

    <!-- What that looks like in practice -->
    <!-- The ecosystem — replaced the group-chat mock (Manny, Aug 2026): one
         request → Manny AI → specialists → one dashboard. The real painter run
         lives on as the condensed story beneath it. -->
    <Section id="ai-team-example" variant="alternate" className="room chain-violet-blue">
      <Container>
        <div class="max-w-3xl mx-auto">
          <SectionHeader
            title="AI agents working for your business"
            subtitle="Manny AI puts highly specialized AI agents on your business, running dozens of tasks in minutes (market research, competition analysis, design, SEO) that would take a dedicated marketing team days to produce. Everything they make lands in one dashboard for your approval."
            width="max-w-3xl"
          />

          {/* The real painter run (7/23/2026) is woven through the diagram's
              stages: the request, Manny's staffing note, and the approved
              scripts row in the dashboard: instead of a separate story block
              (Manny, Aug 2026). */}
          <AiTeamEcosystem />
        </div>
      </Container>
    </Section>

    <!-- Meet the team (roster) -->
    <Section id="ai-team-roster" variant="default" className="room chain-blue-violet">
      <Container>
        <SectionHeader
          title="Meet the team, ready to work"
          subtitle="Each AI agent owns one task and is constantly updated and optimized to perform it at the highest quality possible. Every time."
        />

        <!-- Manager -->
        <div id={`agent-${manager.name.toLowerCase().replace(/\s+/g, '-')}`} class="scroll-mt-24 mb-8 max-w-6xl mx-auto rounded-3xl border border-primary-blue/40 ring-1 ring-primary-blue/20 bg-gradient-to-br from-primary-blue/[0.06] via-transparent to-primary-pink/[0.06] p-6 sm:p-8 flex flex-col sm:flex-row items-center gap-6">
          <div class="w-36 h-36 flex-shrink-0 rounded-2xl bg-gradient-to-br from-primary-blue/[0.07] via-transparent to-primary-pink/[0.07] overflow-hidden">
            <!-- Same waist-up suit art as the homepage roster card. -->
            <img src="/mascot/astro-manny-ai-bust.webp" srcset="/mascot/astro-manny-ai-bust-1x.webp 1x, /mascot/astro-manny-ai-bust.webp 2x" alt={`${manager.name}, ${manager.role}`} width="384" height="379" loading="lazy" decoding="async" class="w-full h-full object-contain pointer-events-none" />
          </div>
          <div class="flex-1 text-center sm:text-left">
            {/* Name on its own line, the role badge beneath it. */}
            <h3 class="text-xl sm:text-2xl font-bold text-text-light-primary dark:text-text-dark-primary mb-2">{manager.name}</h3>
            <div class="flex flex-wrap items-center justify-center sm:justify-start gap-2 mb-3">
              <span class="inline-block bg-gradient-to-r from-primary-blue/10 via-purple-500/10 to-primary-pink/10 text-primary-blue px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider">{manager.role}</span>
            </div>
            <p class="text-sm text-text-light-secondary dark:text-text-dark-secondary leading-relaxed">{manager.does}</p>
            {/* Bottom-right, the same corner the roster cards below park their
                CTA in. Stays centred on mobile, where the rest of this column is. */}
            <div class="mt-4 pt-1 flex items-end justify-center sm:justify-end">
              <Button href="#contact" data-contact-context="AI Agents Team: put Manny AI to work" class="flex-shrink-0">Put Manny AI to work</Button>
            </div>
          </div>
        </div>

        <!-- Agents -->
        {/* Mobile: a snap-scrolling row so the roster doesn't run the page
            long. sm and up: the original two-column grid. No JS. */}
        <div class="relative max-w-6xl mx-auto">
        <div id="rosterScroll" class="roster-scroll flex snap-x snap-mandatory gap-4 overflow-x-auto -mx-4 px-4 pb-2 sm:mx-0 sm:px-0 sm:pb-0 sm:grid sm:gap-6 sm:grid-cols-2 sm:overflow-visible">
          <!-- Anchor ids are the slugified agent name so multi-word names
               ("Manny AI") stay valid; single-word agents keep #agent-<name>. -->
          {agents.map((a) => (
            <div id={`agent-${a.name.toLowerCase().replace(/\s+/g, '-')}`} class="snap-center shrink-0 w-[82vw] sm:w-auto scroll-mt-24 rounded-2xl border border-light-tertiary dark:border-dark-accent bg-white dark:bg-dark-secondary p-6 flex flex-col hover:border-primary-blue/40 hover:shadow-xl hover:shadow-primary-blue/10 transition-all duration-300">
              <div class="flex items-center gap-3 mb-3">
                <div class="w-24 h-24 sm:w-28 sm:h-28 flex-shrink-0 rounded-xl bg-gradient-to-br from-primary-blue/[0.07] via-transparent to-primary-pink/[0.07]">
                  <AgentAvatar agent={a.id} class="w-full h-full" alt={`${a.name}, ${a.role}, an AI agent for Springfield & Western Mass small businesses by MannyKnows`} />
                </div>
                <div class="min-w-0">
                  <h3 class="text-lg font-bold text-text-light-primary dark:text-text-dark-primary leading-tight">
                    {a.name}
                    {a.id === 'desi' && (
                      <a href="/ai-booking-agent/" aria-label="Learn more about Remi AI, the AI booking agent" title="What is Remi AI?" class="ml-1.5 inline-flex h-5 w-5 items-center justify-center rounded-full border border-primary-blue/40 text-primary-blue dark:text-blue-300 text-[11px] font-bold align-middle hover:bg-primary-blue/5 transition-colors">?</a>
                    )}
                  </h3>
                  <span class="text-xs font-bold uppercase tracking-wider text-text-light-tertiary dark:text-text-dark-tertiary">{a.role}</span>
                </div>
              </div>
              <p class="flex-1 text-sm text-text-light-secondary dark:text-text-dark-secondary leading-relaxed">{a.does}</p>
              {/* Remi AI is the only agent with its own price tag — it's a
                  product on its own. Everyone else goes to work through Manny
                  AI, priced per workflow (the grid below), never per agent. */}
              {a.id === 'desi' ? (
                <div class="mt-4 pt-1 flex items-end justify-between gap-3">
                  <div class="leading-none">
                    <span class="text-2xl font-black text-text-light-primary dark:text-text-dark-primary">${a.price}</span><span class="text-sm text-text-light-secondary dark:text-text-dark-secondary">/mo</span>
                    {a.note && <span class="block text-[11px] text-text-light-tertiary dark:text-text-dark-tertiary mt-1">{a.note}</span>}
                  </div>
                  <Button href="/ai-booking-agent/" variant="secondary" size="sm" class="flex-shrink-0">Put {a.name} to work</Button>
                </div>
              ) : (
                <div class="mt-4 pt-1 flex items-end justify-end gap-3">
                  <Button href="#contact" data-contact-context={`AI Agents Team: Manny AI with ${a.name} (${a.role})`} variant="secondary" size="sm" class="flex-shrink-0">Add to my team</Button>
                </div>
              )}
            </div>
          ))}

          <!-- The closer: custom agents, promoted from footnote to roster card
               (Manny, Aug 2026). Weird problems are the highest-margin,
               hardest-to-shop-around work, and custom agents that prove
               useful become roster agents, which is what "the roster keeps
               growing" actually means. -->
          <div id="custom-agent" class="snap-center shrink-0 w-[82vw] sm:w-auto scroll-mt-24 rounded-2xl border border-primary-blue/40 ring-1 ring-primary-blue/20 bg-white dark:bg-dark-secondary p-6 shadow-lg shadow-primary-blue/5 flex flex-col hover:border-primary-blue/70 transition-all duration-300">
            <div class="flex items-center gap-3 mb-3">
              <div class="w-24 h-24 sm:w-28 sm:h-28 flex-shrink-0 rounded-xl border-2 border-dashed border-primary-blue/30 flex items-center justify-center">
                <svg class="w-10 h-10 text-primary-blue dark:text-blue-300" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" /></svg>
              </div>
              <div class="min-w-0">
                <h3 class="text-lg font-bold text-text-light-primary dark:text-text-dark-primary leading-tight">Your Custom Agent</h3>
                <span class="text-xs font-bold uppercase tracking-wider text-text-light-tertiary dark:text-text-dark-tertiary">Built for your exact problem</span>
              </div>
            </div>
            <p class="flex-1 text-sm text-text-light-secondary dark:text-text-dark-secondary leading-relaxed">
              The roster covers what every business needs. Some businesses need something only theirs does — an
              agent wired into your backend, your phone line, your scheduling, your inventory. We scope it, build
              it around your Brand Brain, and Manny AI manages it like the rest of the team.
            </p>
            <div class="mt-4 pt-1 flex items-end justify-between gap-3">
              <div class="leading-none">
                <span class="text-sm font-semibold text-text-light-primary dark:text-text-dark-primary">Scoped &amp; quoted</span>
                <span class="block text-[11px] text-text-light-tertiary dark:text-text-dark-tertiary mt-1">on the diagnostic call</span>
              </div>
              <Button href="#contact" data-contact-context="AI Agents Team: custom agent" size="sm" class="flex-shrink-0">Scope my agent</Button>
            </div>
          </div>
