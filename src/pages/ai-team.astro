---
// The AI Team — our flagship, productized service. The hire is Manny AI: one
// manager that staffs AI specialists (visible roster + hidden sub-agents), all
// reading from one shared "Brand Brain," so a single request becomes a
// finished, measured deliverable. Only Remi carries a public price ($95/mo —
// it's a product on its own); everything else is scoped on the diagnostic.
// Content is driven by src/data/aiTeam.ts.
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import NavBar from '../components/navigation/NavBar.astro';
import Section from '../components/layout/Section.astro';
import Container from '../components/layout/Container.astro';
import DockMenu from '../components/navigation/DockMenu.astro';
import AgentAvatar from '../components/team/AgentAvatar.astro';
import StepCards from '../components/ui/StepCards.astro';
import Faq from '../components/ui/Faq.astro';
import AiTeamEcosystem from '../components/team/AiTeamEcosystem.astro';
import { team, aiTeamSetupFee, aiTeamStartingPrice, aiTeamFaq } from '../data/aiTeam';
import type { AgentId } from '../data/aiTeam';
import { BOOKING_URL } from '../data/booking';

// hidden agents (Leo, Aria, Piper, Max) work as Manny AI sub-agents — they
// appear nowhere on the page (Manny, Aug 2026).
const roster = [...team].filter((a) => !a.hidden).sort((a, b) => a.order - b.order);
const manager = roster.find((a) => a.included)!;
const agents = roster.filter((a) => !a.included);

const startFrom = aiTeamStartingPrice.toLocaleString('en-US');

// "One brain, one boss" pillars.
// Short on purpose, and every phrase earns SEO keep ("AI agents trained on
// your business", "managed", "AI marketing") — no filler.
// Typed so `avatar` is an AgentId, not string — AgentAvatar rejects the latter.
const pillars: { icon: string; title: string; body: string; avatar?: AgentId }[] = [
  {
    icon: 'M9.75 3a3 3 0 00-3 3v.75H6A2.25 2.25 0 003.75 9v9A2.25 2.25 0 006 20.25h12A2.25 2.25 0 0020.25 18V9A2.25 2.25 0 0018 6.75h-.75V6a3 3 0 00-3-3h-4.5zM9 9.75h.008v.008H9V9.75zm6 0h.008v.008H15V9.75zM8.25 14.25h7.5',
    title: 'One Brand Brain',
    body: 'AI agents developed for your business and trained on your services, prices, and brand voice, so nothing ships off-brand.',
  },
  {
    icon: 'M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z',
    title: 'One agent you talk to',
    body: 'Manny AI is your everything partner: ask for what you need, it scopes the work and sends the plan back for your approval, then puts the right specialists on the job.',
    avatar: 'manny',
  },
  {
    icon: 'M2.25 18L9 11.25l4.306 4.307a11.95 11.95 0 015.814-5.519l2.74-1.22m0 0l-5.94-2.28m5.94 2.28l-2.28 5.941',
    title: 'A swarm of AI agents behind it',
    body: 'The specialists Manny AI puts to work, each configured to do the best possible job and to sharpen the process every time they run it, so the same work comes back faster and better each month.',
  },
];


const steps = [
  { n: '01', title: 'We sit down and find your voice', body: "A series of one-on-one working sessions between the person who owns your brand voice and our engineer, until we've dialed in exactly what you sell, who buys, and how you sound.", icon: 'M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.9 9.9 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z' },
  { n: '02', title: 'We build your Brand Brain', body: 'Everything from those sessions (plus your services, prices, past work, and best content) gets cleaned up, formatted, and loaded into one shared knowledge base every agent reads from.', icon: 'M4 7c0-1.657 3.582-3 8-3s8 1.343 8 3-3.582 3-8 3-8-1.343-8-3zM4 7v5c0 1.657 3.582 3 8 3s8-1.343 8-3V7M4 12v5c0 1.657 3.582 3 8 3s8-1.343 8-3v-5' },
  { n: '03', title: 'We build & train your agents', body: "We set up each specialist Manny AI staffs around its one job, connect it to your Brand Brain and the tools it needs, and wire its handoffs through Manny.", icon: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z' },
  { n: '04', title: 'We fine-tune it with you', body: 'We run the team alongside you and adjust until the output is quality and earns your approval, before anything goes live.', icon: 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z' },
  { n: '05', title: 'You run it; we support it', body: 'You tell Manny AI what you need, approve what goes out, and read the reports. We handle the updates and ongoing support, so the team only gets sharper.', icon: 'M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15' },
];


// Structured data: the AI Team as a Service. Prices come from aiTeam.ts at
// build time so this block can never drift from the real pricing.
const pageJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'The AI Team: AI Agents for Springfield & Western Mass Businesses',
  serviceType: 'AI agent development',
  provider: {
  '@type': 'ProfessionalService',
  '@id': 'https://mannyknows.com/#business',
  name: 'MannyKnows',
  url: 'https://mannyknows.com',
  telephone: '+1-413-361-8451',
  address: { '@type': 'PostalAddress', addressLocality: 'Springfield', addressRegion: 'MA', addressCountry: 'US' },
},
  areaServed: [
    { '@type': 'City', name: 'Springfield, Massachusetts' },
    { '@type': 'AdministrativeArea', name: 'Western Massachusetts' },
    { '@type': 'AdministrativeArea', name: 'Hampden County, MA' },
    { '@type': 'AdministrativeArea', name: 'Hampshire County, MA' },
    { '@type': 'AdministrativeArea', name: 'Franklin County, MA' },
  ],
  description: 'You hire Manny AI, one manager that staffs AI specialists on your business: front desk, daily intel, copywriting, SEO, engagement, and analytics, with design, video, voice, publishing, and ads sub-agents behind the scenes. Custom-built for your business.',
  offers: [
    {
      '@type': 'Offer',
      name: 'Remi: AI front desk agent',
      price: String(aiTeamStartingPrice),
      priceCurrency: 'USD',
      description: `Remi answers, qualifies, and books 24/7: $${aiTeamStartingPrice}/mo as a standalone product. Included with every Smart Website plan, where it books from Get Booked and sells from Get Growing.`,
    },
    {
      '@type': 'Offer',
      name: 'Manny AI, managed AI operation',
      description: `You hire Manny AI, the manager that staffs AI specialists on your business. Scoped and quoted on a 15-minute diagnostic; one-time $${aiTeamSetupFee} setup.`,
    },
  ],
};
---

<BaseLayout
  title="Hire AI Agents in Springfield, MA | MannyKnows"
  description="AI agents for Western Mass small businesses, from $95/mo. We find the bottleneck costing you money, then build the agent that fixes it. Springfield, MA."
>
  <script type="application/ld+json" set:html={JSON.stringify(pageJsonLd)} />
  <main class="relative bg-light-primary dark:bg-dark-primary text-text-light-primary dark:text-text-dark-primary min-h-screen transition-colors duration-300">

    <header class="relative bg-gradient-to-t from-gray-50/50 via-gray-100/30 to-gray-50/20 dark:from-gray-900/60 dark:via-slate-800/40 dark:to-gray-900/30 transition-colors duration-300">
      <NavBar />
      <nav aria-label="breadcrumb" class="max-w-[1440px] mx-auto px-4 lg:px-6 pt-6 pb-4">
        <ol class="flex flex-wrap items-center gap-2 text-sm text-text-light-secondary dark:text-text-dark-secondary">
          <li><a href="/" class="hover:text-primary-blue transition-colors">Home</a></li>
          <li class="flex items-center"><span class="mx-2 text-text-light-tertiary dark:text-text-dark-tertiary">/</span><span class="text-text-light-primary dark:text-text-dark-primary font-medium">AI Team</span></li>
        </ol>
      </nav>

      <div class="pb-12">
        <Container>
          <div class="max-w-[1440px] mx-auto text-center">
            <div class="flex justify-center mb-6">
              <div class="w-32 h-32 md:w-40 md:h-40 rounded-3xl bg-gradient-to-br from-primary-blue/[0.07] via-transparent to-primary-pink/[0.07]">
                <AgentAvatar agent="manny" class="w-full h-full" />
              </div>
            </div>
            {/* Eyebrow adds the price fact the H1 doesn't carry, rather than
                restating it (badge/H1 pairing rule, Aug 2026). */}
            <span class="inline-block bg-gradient-to-r from-primary-blue/10 via-purple-500/10 to-primary-pink/10 text-primary-blue px-4 py-1.5 rounded-full text-[0.65rem] md:text-xs font-bold uppercase tracking-wider mb-4">
              The AI Team · AI staff from ${startFrom}/mo
            </span>
            <h1 class="sf-bold apple-headline text-[1.75rem] md:text-5xl lg:text-6xl mb-4">
              <span class="apple-gradient-text" data-colorful-title>AI agents for Springfield &amp; Western Mass businesses</span>
            </h1>
            <p class="sf-bold text-[0.95rem] md:text-2xl font-bold text-text-light-primary dark:text-text-dark-primary mb-6">One team. One brain. One boss: you.</p>
            <p class="max-w-3xl mx-auto text-base sm:text-xl text-text-light-secondary dark:text-text-dark-secondary leading-relaxed">
              When people picture AI, they picture a chat box you have to prompt. This is a hire instead: <strong class="text-text-light-primary dark:text-text-dark-primary">Manny AI</strong>, one manager that staffs AI specialists onto your work, like three, five, or seven people in one, custom-built when the job needs something no roster covers. Each AI agent is trained on your business, voice and services.
            </p>

            <!-- The three pillars, promoted into the hero (Manny: one stronger
                 hero instead of hero + separate "One brain" section) -->
            <div class="mt-10 grid gap-6 md:grid-cols-3 max-w-6xl mx-auto text-left">
              {pillars.map((pl) => (
                <div class="relative rounded-2xl border border-light-tertiary dark:border-dark-accent bg-white dark:bg-dark-secondary p-6">
                  {pl.avatar && (
                    <div class="absolute -top-7 right-4 w-16 h-16 pointer-events-none">
                      <AgentAvatar agent={pl.avatar} class="w-full h-full" />
                    </div>
                  )}
                  <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-br from-primary-blue to-primary-pink text-white shadow-lg shadow-primary-blue/20 mb-3">
                    <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d={pl.icon} /></svg>
                  </div>
                  <h3 class="text-base font-bold text-text-light-primary dark:text-text-dark-primary mb-2">{pl.title}</h3>
                  <p class="text-sm text-text-light-secondary dark:text-text-dark-secondary leading-relaxed">{pl.body}</p>
                </div>
              ))}
            </div>

            <!-- Mini roster preview -->
            <div class="mt-8 flex items-center justify-center -space-x-2">
              {roster.map((a) => (
                <div class="w-9 h-9 sm:w-11 sm:h-11 rounded-full ring-2 ring-primary-blue/40 bg-gradient-to-br from-primary-blue/10 to-primary-pink/10 overflow-hidden" title={`${a.name}: ${a.role}`}>
                  <AgentAvatar agent={a.id} class="w-full h-full" />
                </div>
              ))}
            </div>
            <p class="mt-3 text-xs text-text-light-tertiary dark:text-text-dark-tertiary">Meet Manny AI and the specialist AI agents it puts to work behind the scenes.</p>

            <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
              <a href="#ai-team-roster" class="inline-flex items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-primary-blue to-primary-pink text-white px-8 py-3.5 text-sm font-semibold transition-all duration-300">
                Meet the team
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" /></svg>
              </a>
              <a href={BOOKING_URL} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 rounded-xl border border-primary-blue/40 text-primary-blue dark:text-blue-300 px-6 py-3.5 text-sm font-semibold hover:bg-primary-blue/5 transition-all duration-300">
                Get a free quote
              </a>
            </div>
          </div>
        </Container>
      </div>
    </header>

    <!-- Before you meet anyone — the two-questions diagnostic + the
         bottleneck→agent router. Bottleneck-first framing (Manny, Aug 2026):
         the page sells the ONE right hire, not ten. -->
    <Section id="find-your-bottleneck" variant="default">
      <Container>
        <div class="max-w-3xl mx-auto text-center mb-10">
          <h2 class="sf-bold text-2xl md:text-3xl font-bold mb-4">
            <span class="apple-gradient-text" data-colorful-title>Before you meet anyone</span>
          </h2>
          <p class="text-text-light-secondary dark:text-text-dark-secondary leading-relaxed">
Most owners land here asking "which AI agents does my business need?" That's the right destination, and two
            questions get you there faster. Most people can answer both in under a minute:
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-6 max-w-4xl mx-auto mb-10">
          <div class="rounded-2xl border border-light-tertiary dark:border-dark-accent bg-white dark:bg-dark-secondary p-7">
            <span class="inline-flex items-center justify-center w-9 h-9 rounded-full bg-gradient-to-br from-primary-blue to-primary-pink text-white font-black mb-4">1</span>
            <h3 class="text-lg font-bold text-text-light-primary dark:text-text-dark-primary mb-2">What are you bad at that keeps costing you money?</h3>
            <p class="text-sm text-text-light-secondary dark:text-text-dark-secondary leading-relaxed">That's your bottleneck. It's where the leak is.</p>
          </div>
          <div class="rounded-2xl border border-light-tertiary dark:border-dark-accent bg-white dark:bg-dark-secondary p-7">
            <span class="inline-flex items-center justify-center w-9 h-9 rounded-full bg-gradient-to-br from-primary-blue to-primary-pink text-white font-black mb-4">2</span>
            <h3 class="text-lg font-bold text-text-light-primary dark:text-text-dark-primary mb-2">What are you good at that would print revenue if it scaled?</h3>
            <p class="text-sm text-text-light-secondary dark:text-text-dark-secondary leading-relaxed">That's your lever, and it's what breaks first when volume shows up.</p>
          </div>
        </div>

        <div class="max-w-3xl mx-auto text-center mb-12">
          <p class="text-sm sm:text-base text-text-light-secondary dark:text-text-dark-secondary leading-relaxed">
            The answers rarely point to the same place, and AI isn't the strategy, it's the leverage. Your first
            hire goes where the leak is: Manny AI staffs the specialist that fixes it, stock or custom-built.
            Every AI agent reads from your Brand Brain, and the Brand Brain is yours to set. Change your services,
            your prices, or the way you want things said, and every agent works from the new version on its next
            run. That is the control: you edit one source, and the whole team moves with it.
          </p>
        </div>

      </Container>
    </Section>

    <!-- What that looks like in practice -->
    <!-- The ecosystem — replaced the group-chat mock (Manny, Aug 2026): one
         request → Manny AI → specialists → one dashboard. The real painter run
         lives on as the condensed story beneath it. -->
    <Section id="ai-team-example" variant="alternate">
      <Container>
        <div class="max-w-3xl mx-auto">
          <div class="text-center mb-10">
            <h2 class="sf-bold text-2xl md:text-3xl font-bold">
              <span class="apple-gradient-text" data-colorful-title>AI agents working for your business</span>
            </h2>
            <p class="mt-3 text-base text-text-light-secondary dark:text-text-dark-secondary leading-relaxed">
              Manny AI puts highly specialized AI agents on your business, running hundreds of tasks in minutes (market research,
              competition analysis, design, SEO) that would take a dedicated marketing team days to produce. Everything
              they make lands in one dashboard for your approval.
            </p>
          </div>

          {/* The real painter run (7/23/2026) is woven through the diagram's
              stages: the request, Manny's staffing note, and the approved
              scripts row in the dashboard: instead of a separate story block
              (Manny, Aug 2026). */}
          <AiTeamEcosystem />
        </div>
      </Container>
    </Section>

    <!-- Meet the team (roster) -->
    <Section id="ai-team-roster" variant="default">
      <Container>
        <div class="text-center max-w-2xl mx-auto mb-8">
          <h2 class="sf-bold text-2xl md:text-3xl font-bold">
            <span class="apple-gradient-text" data-colorful-title>Meet, and hire, your team</span>
          </h2>
          <p class="mt-3 text-base text-text-light-secondary dark:text-text-dark-secondary leading-relaxed">
            Each AI agent owns one task and is constantly updated and optimized to perform it at the highest quality possible. Every time.
          </p>
        </div>

        <!-- Manager -->
        <div id={`agent-${manager.name.toLowerCase().replace(/\s+/g, '-')}`} class="scroll-mt-24 mb-8 max-w-6xl mx-auto rounded-3xl border border-primary-blue/40 ring-1 ring-primary-blue/20 bg-gradient-to-br from-primary-blue/[0.06] via-transparent to-primary-pink/[0.06] p-6 sm:p-8 flex flex-col sm:flex-row items-center gap-6">
          <div class="w-36 h-36 flex-shrink-0 rounded-2xl bg-gradient-to-br from-primary-blue/[0.07] via-transparent to-primary-pink/[0.07]">
            <AgentAvatar agent={manager.id} class="w-full h-full" />
          </div>
          <div class="flex-1 text-center sm:text-left">
            {/* Name on its own line, the role badge beneath it. */}
            <h3 class="text-xl font-bold text-text-light-primary dark:text-text-dark-primary mb-2">{manager.name}</h3>
            <div class="flex flex-wrap items-center justify-center sm:justify-start gap-2 mb-3">
              <span class="inline-block bg-gradient-to-r from-primary-blue to-primary-pink text-white text-[11px] font-bold uppercase tracking-wide px-2.5 py-1 rounded-full">{manager.role}</span>
            </div>
            <p class="text-sm text-text-light-secondary dark:text-text-dark-secondary leading-relaxed">{manager.does}</p>
            {/* Bottom-right, the same corner the roster cards below park their
                CTA in. Stays centred on mobile, where the rest of this column is. */}
            <div class="mt-4 pt-1 flex items-end justify-center sm:justify-end">
              <a
                href="#contact"
                data-contact-context="AI Team: hire Manny AI"
                class="flex-shrink-0 inline-flex items-center justify-center gap-1.5 rounded-xl bg-gradient-to-r from-primary-blue to-primary-pink text-white px-6 py-3 text-sm font-semibold transition-all duration-300"
              >
                Hire Manny AI
              </a>
            </div>
          </div>
        </div>

        <!-- Agents -->
        {/* Mobile: a snap-scrolling row so the roster doesn't run the page
            long. sm and up: the original two-column grid. No JS. */}
        <div class="relative max-w-6xl mx-auto">
        <div id="rosterScroll" class="roster-scroll flex snap-x snap-mandatory gap-4 overflow-x-auto -mx-4 px-4 pb-2 sm:mx-0 sm:px-0 sm:pb-0 sm:grid sm:gap-6 sm:grid-cols-2 sm:overflow-visible">
          <!-- Anchor ids are the slugified agent name so multi-word names
               ("Manny AI") stay valid; single-word agents keep #agent-<name>. -->
          {agents.map((a) => (
            <div id={`agent-${a.name.toLowerCase().replace(/\s+/g, '-')}`} class="snap-center shrink-0 w-[82vw] sm:w-auto scroll-mt-24 rounded-2xl border border-light-tertiary dark:border-dark-accent bg-white dark:bg-dark-secondary p-6 flex flex-col hover:border-primary-blue/40 hover:shadow-lg transition-all duration-300">
              <div class="flex items-center gap-3 mb-3">
                <div class="w-24 h-24 sm:w-28 sm:h-28 flex-shrink-0 rounded-xl bg-gradient-to-br from-primary-blue/[0.07] via-transparent to-primary-pink/[0.07]">
                  <AgentAvatar agent={a.id} class="w-full h-full" alt={`${a.name}, ${a.role}: AI agent for Springfield & Western Mass small businesses by MannyKnows`} />
                </div>
                <div class="min-w-0">
                  <h3 class="text-lg font-bold text-text-light-primary dark:text-text-dark-primary leading-tight">{a.name}</h3>
                  <span class="text-[11px] font-semibold uppercase tracking-wide text-primary-blue dark:text-blue-300">{a.role}</span>
                </div>
              </div>
              <p class="flex-1 text-sm text-text-light-secondary dark:text-text-dark-secondary leading-relaxed">{a.does}</p>
              {/* Remi is the only agent with a public price — it's a product
                  on its own. Everyone else joins through hiring Manny AI
                  (scoped on the diagnostic), so no per-agent price tags. */}
              {a.id === 'desi' ? (
                <div class="mt-4 pt-1 flex items-end justify-between gap-3">
                  <div class="leading-none">
                    <span class="text-2xl font-black text-text-light-primary dark:text-text-dark-primary">${a.price}</span><span class="text-sm text-text-light-secondary dark:text-text-dark-secondary">/mo</span>
                    {a.note && <span class="block text-[11px] text-text-light-tertiary dark:text-text-dark-tertiary mt-1">{a.note}</span>}
                  </div>
                  <a
                    href="#contact"
                    data-contact-context={`AI Team: hire ${a.name} (${a.role})`}
                    class="flex-shrink-0 inline-flex items-center justify-center rounded-xl border border-primary-blue/40 text-primary-blue dark:text-blue-300 px-4 py-2.5 text-sm font-semibold hover:bg-primary-blue/5 transition-all duration-300"
                  >
                    Hire {a.name}
                  </a>
                </div>
              ) : (
                <div class="mt-4 pt-1 flex items-end justify-end gap-3">
                  <a
                    href="#contact"
                    data-contact-context={`AI Team: Manny AI with ${a.name} (${a.role})`}
                    class="flex-shrink-0 inline-flex items-center justify-center rounded-xl border border-primary-blue/40 text-primary-blue dark:text-blue-300 px-4 py-2.5 text-sm font-semibold hover:bg-primary-blue/5 transition-all duration-300"
                  >
                    Add to my team
                  </a>
                </div>
              )}
            </div>
          ))}

          <!-- The closer: custom agents, promoted from footnote to roster card
               (Manny, Aug 2026). Weird problems are the highest-margin,
               hardest-to-shop-around work, and custom agents that prove
               useful become roster agents, which is what "the roster keeps
               growing" actually means. -->
          <div id="custom-agent" class="snap-center shrink-0 w-[82vw] sm:w-auto scroll-mt-24 rounded-2xl border-2 border-dashed border-primary-blue/40 bg-gradient-to-br from-primary-blue/[0.04] via-transparent to-primary-pink/[0.04] p-6 flex flex-col hover:border-primary-blue/70 transition-all duration-300">
            <div class="flex items-center gap-3 mb-3">
              <div class="w-24 h-24 sm:w-28 sm:h-28 flex-shrink-0 rounded-xl border-2 border-dashed border-primary-blue/30 flex items-center justify-center">
                <svg class="w-10 h-10 text-primary-blue dark:text-blue-300" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" /></svg>
              </div>
