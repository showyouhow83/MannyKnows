<script>
  // Roster autoplay (phones only). Advances every 4s and loops back to the
  // first card. Pauses while the user is touching it, while the tab is
  // hidden, when the section scrolls out of view, and for reduced-motion.
  (function () {
    const track = document.getElementById('rosterScroll');
    if (!track) return;
    // Narrowed once here: TS re-widens `track` to possibly-null inside the
    // closures below, and children are Element (no offsetLeft) until cast.
    const rail: HTMLElement = track;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    const isPhone = () => window.matchMedia('(max-width: 639px)').matches;
    const cards = (): HTMLElement[] =>
      Array.from(rail.children).filter((el): el is HTMLElement => el.tagName === 'DIV');

    let timer: number | null = null, paused = false, visible = true;

    function goTo(i: number) {
      const list = cards();
      if (!list.length) return;
      const idx = (i + list.length) % list.length;              // wrap around
      rail.scrollTo({ left: list[idx].offsetLeft - rail.offsetLeft, behavior: 'smooth' });
    }
    function current() {
      const list = cards();
      let best = 0, min = Infinity;
      list.forEach((el, i) => {
        const d = Math.abs(el.offsetLeft - rail.offsetLeft - rail.scrollLeft);
        if (d < min) { min = d; best = i; }
      });
      return best;
    }
    function tick() { if (!paused && visible && isPhone()) goTo(current() + 1); }
    function start() {
      if (timer || reduce.matches) return;
      timer = window.setInterval(tick, 4000);
    }
    function stop() { if (timer) { clearInterval(timer); timer = null; } }

    document.querySelectorAll('[data-roster-nav]').forEach((btn) => {
      btn.addEventListener('click', () => {
        goTo(current() + (btn.getAttribute('data-roster-nav') === 'next' ? 1 : -1));
        paused = true; window.setTimeout(() => { paused = false; }, 8000);  // let them browse
      });
    });

    track.addEventListener('pointerdown', () => { paused = true; });
    track.addEventListener('pointerup', () => { window.setTimeout(() => { paused = false; }, 6000); });
    document.addEventListener('visibilitychange', () => { visible = !document.hidden; });

    if ('IntersectionObserver' in window) {
      new IntersectionObserver((entries) => {
        entries.forEach((e) => { e.isIntersecting ? start() : stop(); });
      }, { threshold: 0.25 }).observe(track);
    } else {
      start();
    }
  })();
</script>

