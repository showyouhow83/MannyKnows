---
// Admin Quotes Page - 3-Column Layout
import { env as cfEnv } from 'cloudflare:workers';
import { AdminAuth } from '../../lib/adminAuth';
import AdminNav from '../../components/AdminNav.astro';
import AdminMobileDrawer from '../../components/AdminMobileDrawer.astro';
import AdminPresence from '../../components/AdminPresence.astro';
import { SERVICE_TYPES, SERVICE_LABELS } from '../../data/serviceTypes';
import '../../styles/admin.css';

const env = cfEnv;
const sessionSecret = env?.SESSION_SECRET || env?.ADMIN_PASSWORD;
const session = await AdminAuth.validateSession(Astro.request, sessionSecret);

if (!session.isAuthenticated) {
  return Astro.redirect('/admin');
}
if (session.role === 'viewer') {
  return Astro.redirect('/admin/portfolios');
}

// Fetch all quotes from D1
const db = env?.MK_APP_DB;
let allQuotes: any[] = [];
let partnersList: any[] = [];
let error = '';

if (db) {
  try {
    const result = await db.prepare(
      'SELECT * FROM quotes WHERE status != ? ORDER BY updated_at DESC'
    ).bind('failed').all();
    allQuotes = result.results || [];
    const partnersRes = await db.prepare('SELECT id, name FROM partners WHERE archived = 0 ORDER BY name ASC').all();
    partnersList = partnersRes.results || [];
  } catch (e) {
    error = 'Failed to load quotes';
    console.error('Quotes fetch error:', e);
  }
} else {
  error = 'Database not configured';
}

// Split into categories
const draftQuotes = allQuotes.filter(q => q.status === 'draft');
const sentQuotes = allQuotes.filter(q => q.status === 'sent' && !q.is_renegotiation);
const renegoQuotes = allQuotes.filter(q => q.status === 'sent' && q.is_renegotiation);
const declinedQuotes = allQuotes.filter(q => q.status === 'declined');
const acceptedQuotes = allQuotes.filter(q => q.status === 'accepted');
const coldQuotes = allQuotes.filter(q => q.status === 'cold');

// Mini-dashboard stats: open pipeline = money on the table (draft + awaiting
// customer response, including renegotiations). Accepted quotes are counted
// separately — they're won, just not promoted yet.
const openPipeline = allQuotes
  .filter(q => q.status === 'draft' || q.status === 'sent')
  .reduce((sum, q) => sum + (Number(q.total) || 0), 0);
const pipelineLabel = '$' + openPipeline.toLocaleString('en-US', { maximumFractionDigits: 0 });

// Service labels
const serviceLabels: Record<string, string> = SERVICE_LABELS;

// Format date helper
function formatDate(dateStr: string | null): string {
  if (!dateStr) return 'N/A';
  try {
    return new Date(dateStr).toLocaleDateString('en-US', {
      month: 'short',
      day: 'numeric',
      year: 'numeric'
    });
  } catch {
    return dateStr;
  }
}

// Format time ago
function timeAgo(dateStr: string): string {
  // SQLite CURRENT_TIMESTAMP returns "YYYY-MM-DD HH:MM:SS" in UTC with no
  // offset suffix. JavaScript parses that as *local* time, which produces
  // negative diffs for fresh rows. Normalise to ISO-with-Z so the math is
  // correct regardless of the runtime's timezone.
  const normalised = /^\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}$/.test(dateStr)
    ? dateStr.replace(' ', 'T') + 'Z'
    : dateStr;
  const date = new Date(normalised);
  const now = new Date();
  const diffMs = now.getTime() - date.getTime();
  // Clamp negatives to 0 (clock skew shouldn't show "−1 days ago")
  const diffDays = Math.max(0, Math.floor(diffMs / (1000 * 60 * 60 * 24)));

  if (diffDays === 0) return 'Today';
  if (diffDays === 1) return 'Yesterday';
  if (diffDays < 7) return `${diffDays} days ago`;
  if (diffDays < 30) return `${Math.floor(diffDays / 7)} weeks ago`;
  return `${Math.floor(diffDays / 30)} months ago`;
}
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Quotes | MannyKnows Admin</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <meta name="robots" content="noindex, nofollow">
  <script>
    // Theme init - runs before CSS to prevent flash
    (function() {
      const theme = localStorage.getItem('admin-theme') || 'dark';
      document.documentElement.setAttribute('data-theme', theme);
    })();
  </script>
  <style>
    /* Page-specific styles - extends admin.css */

    /* Search bar */
    .search-bar {
      background: var(--glass-bg);
      border: 1px solid var(--glass-border);
      border-radius: var(--field-radius);
      padding: 8px 12px;
      margin-bottom: 16px;
      display: flex;
      gap: 10px;
      align-items: center;
      backdrop-filter: blur(10px);
    }

    .search-bar svg {
      color: var(--color-text-secondary);
      flex-shrink: 0;
    }

    .search-input {
      flex: 1;
      border: none;
      font-size: 14px;
      outline: none;
      background: transparent;
      color: var(--color-text-primary);
    }

    .search-input::placeholder {
      color: var(--color-text-secondary);
    }

    .quote-card.hidden,
    .status-card.hidden {
      display: none;
    }

    .no-results {
      display: none;
      text-align: center;
      padding: 24px 16px;
      color: var(--color-text-secondary);
      font-size: 13px;
    }

    .no-results.visible {
      display: block;
    }

    /* Main content — mini-dashboard layout (pattern locked on Leads) */
    .admin-main {
      min-height: calc(100vh - 65px);
      padding: 16px;
    }

    /* Mini-dashboard header: title left, search + the one primary action
       right — nothing redundant inside the list column anymore. */
    .page-topbar {
      display: flex;
      align-items: center;
      gap: 16px;
      flex-wrap: wrap;
      margin-bottom: 16px;
    }

    .page-topbar-heading { margin-right: auto; }

    .page-title {
      margin: 0;
      font-size: 24px;
      font-weight: 800;
      background: linear-gradient(90deg, #a78bfa, #e879f9, #f472b6);
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
      color: transparent;
    }

    .page-subtitle {
      margin: 2px 0 0;
      font-size: 13px;
      color: var(--color-text-secondary);
    }

    .page-topbar .search-bar {
      flex: 1;
      min-width: 220px;
      max-width: 400px;
      margin-bottom: 0;
    }

    .page-topbar .new-record-btn { width: auto; margin-bottom: 0; padding: 0 18px; }

    /* Stat cards */
    .quote-stats {
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 12px;
      margin-bottom: 16px;
    }

    .quote-stat {
      background: var(--glass-bg);
      border: 1px solid var(--glass-border);
      border-radius: var(--radius-md);
      padding: 12px 16px;
      backdrop-filter: blur(10px);
    }

    .quote-stat-num { font-size: 22px; font-weight: 700; color: var(--color-text-primary); }
    .quote-stat-num.pending { color: var(--warning-soft-foreground); }
    .quote-stat-num.declined { color: var(--danger-soft-foreground); }
    .quote-stat-num.accepted { color: var(--success-soft-foreground); }
    .quote-stat-num.accent { color: var(--accent-soft-foreground); }

    .quote-stat-label {
      margin-top: 2px;
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--color-text-secondary);
    }

    .quotes-columns {
      display: flex;
      align-items: flex-start;
      gap: 16px;
    }

    /* Left column - Drafts list. Sticky sidebar so the page (and detail card)
       scroll as one, no second scrollbar on the detail. */
    .quotes-list {
      width: 300px;
      min-width: 280px;
      max-width: 320px;
      position: sticky;
      top: 16px;
      align-self: flex-start;
      max-height: calc(100vh - 65px - 32px);
      overflow-y: auto;
      padding: 16px;
      background: var(--glass-bg);
      border: 1px solid var(--glass-border);
      border-radius: var(--radius-lg);
      backdrop-filter: blur(10px);
    }

    /* Middle column - Quote content. Grows to natural height; the PAGE scrolls
       (single scrollbar) instead of an inner scroll region. */
    .quote-content {
      flex: 1;
      /* Flex child defaults to min-width:auto and won't shrink below its
         content: wide inner content then pushes the panel past the viewport
         on mobile. Allow it to shrink to the available width. */
      min-width: 0;
      max-width: 100%;
      padding: 16px;
      background: var(--glass-bg);
      border: 1px solid var(--glass-border);
      border-radius: var(--radius-lg);
      backdrop-filter: blur(10px);
    }

    /* Quote sections (collapsible on mobile) */
    .quote-section {
      margin-bottom: 16px;
    }

    .quote-section:last-child {
      margin-bottom: 0;
    }

    .section-body {
      /* Always visible on desktop */
    }

    /* Chevron hidden on desktop */
    .section-chevron {
      display: none;
    }

    /* Status pills on cards — HeroUI soft chip anatomy: small pill, 12px
       text, soft background, no border (same format as Leads' Confirmed). */
    .status-pill {
      display: inline-flex;
      align-items: center;
      padding: 2px 10px;
      border-radius: 9999px;
      font-size: 12px;
      line-height: 20px;
      font-weight: 500;
    }

    .status-pill.draft { background: rgba(148, 163, 184, 0.15); color: #a1a1aa; }
    .status-pill.sent { background: var(--warning-soft); color: var(--warning-soft-foreground); }
    .status-pill.declined { background: var(--danger-soft); color: var(--danger-soft-foreground); }
    .status-pill.accepted { background: var(--success-soft); color: var(--success-soft-foreground); }
    .status-pill.cold { background: rgba(100, 116, 139, 0.15); color: #94a3b8; }
    .status-pill.renego { background: rgba(139, 92, 246, 0.15); color: #a78bfa; }

    .quote-reason {
      font-size: 11px;
      color: var(--color-text-secondary);
      font-style: italic;
      margin-top: 4px;
    }

    .quote-approval-badge {
      font-size: 10px;
      font-weight: 600;
    }

    .quote-card-actions {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 6px;
      margin-top: 6px;
    }

    /* Section header */
    .section-header {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 12px;
      padding-bottom: 12px;
      border-bottom: 1px solid var(--glass-border);
    }

    .section-title {
      font-size: 13px;
      font-weight: 600;
      color: var(--color-text-secondary);
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .section-count {
      padding: 2px 8px;
      border-radius: 12px;
      font-size: 11px;
      font-weight: 600;
    }

    .section-count.draft {
      background: rgba(0, 113, 227, 0.2);
      color: #60a5fa;
    }

    .section-count.sent {
      background: rgba(245, 158, 11, 0.2);
      color: #fbbf24;
    }

    .section-count.declined {
      background: rgba(220, 38, 38, 0.2);
      color: #f87171;
    }

    .section-count.renego {
      background: rgba(139, 92, 246, 0.2);
      color: #a78bfa;
    }

    .section-count.cold {
      background: rgba(100, 116, 139, 0.2);
      color: #a1a1aa;
    }

    /* Collapsed state (desktop: used for Cold section default) */
    .section-body.collapsed {
      display: none;
    }

    /* Quote card — compact single-line */
    .quote-card {
      background: var(--glass-bg);
      border: 1px solid var(--glass-border);
      border-radius: var(--radius-md);
      padding: 8px 12px;
      margin-bottom: 6px;
      cursor: pointer;
      transition: all 0.2s;
      backdrop-filter: blur(10px);
    }

    .quote-card:hover {
      border-color: var(--color-primary);
      background: rgba(255, 255, 255, 0.08);
    }

    .quote-card.selected {
      border-color: var(--color-primary);
      background: rgba(0, 113, 227, 0.15);
      box-shadow: 0 0 0 2px rgba(0, 113, 227, 0.3);
    }

    /* One row per card: code · status chip · name — time right. Extra info
       (decline reason, follow-ups, actions) stacks below only when present. */
    .quote-card-row {
      display: flex;
      align-items: center;
      gap: 8px;
      min-width: 0;
    }

    .quote-shortcode {
      font-family: 'SF Mono', Monaco, monospace;
      font-size: 13px;
      font-weight: 800;
      color: var(--color-primary);
      letter-spacing: 0.3px;
      flex-shrink: 0;
    }

    .quote-card-row .status-pill,
    .quote-card-row .renegotiation-badge { flex-shrink: 0; }

    .quote-name {
      flex: 1;
      min-width: 0;
      font-weight: 600;
      font-size: 13px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      color: var(--color-text-primary);
    }

    .quote-time {
      font-size: 10px;
      color: var(--color-text-secondary);
      flex-shrink: 0;
      white-space: nowrap;
    }

    .quote-meta {
      font-size: 11px;
      color: var(--color-text-secondary);
      margin-top: 4px;
    }

    .renegotiation-badge {
      display: inline-block;
      background: rgba(139, 92, 246, 0.15);
      color: #a78bfa;
      padding: 2px 8px;
      border-radius: 9999px;
      font-size: 10px;
      line-height: 18px;
      font-weight: 600;
      letter-spacing: 0.3px;
    }

    /* Status box cards (right column) */
    .status-section {
      margin-bottom: 24px;
    }

    .status-card {
      background: var(--glass-bg);
      border: 1px solid var(--glass-border);
      border-radius: var(--radius-md);
      padding: 10px 12px;
      margin-bottom: 6px;
      cursor: pointer;
      transition: all 0.2s;
      backdrop-filter: blur(10px);
    }

    .status-card:hover {
      border-color: var(--color-primary);
      background: rgba(255, 255, 255, 0.08);
    }

    .status-card.selected {
      border-color: var(--color-primary);
      background: rgba(0, 113, 227, 0.15);
    }

    .status-card-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 8px;
      margin-bottom: 4px;
    }

    .status-card-number {
      font-family: 'SF Mono', Monaco, monospace;
      font-size: 10px;
      color: var(--color-primary);
      font-weight: 600;
    }

    .status-card-time {
      font-size: 10px;
      color: var(--color-text-secondary);
    }

    .status-card-name {
      font-size: 13px;
      font-weight: 500;
      margin-bottom: 6px;
      color: var(--color-text-primary);
    }

    .status-card-reason {
      font-size: 11px;
      color: var(--color-text-secondary);
      font-style: italic;
      margin-bottom: 8px;
    }

    .status-card-actions {
      display: flex;
      gap: 6px;
    }

    .btn-sm {
      padding: 4px 12px;
      border-radius: 9999px;
      font-size: 11px;
      font-weight: 500;
      cursor: pointer;
      transition: all 0.15s;
      border: none;
    }

    .btn-accept {
      background: rgba(239, 68, 68, 0.2);
      color: #f87171;
    }

    .btn-accept:hover {
      background: rgba(239, 68, 68, 0.3);
    }

    .btn-renego {
      background: linear-gradient(135deg, #2563eb 0%, #7c3aed 100%);
      color: white;
    }

    .btn-renego:hover {
      opacity: 0.9;
    }

    /* Empty state */
    .empty-state {
      text-align: center;
      padding: 24px 16px;
      color: var(--color-text-secondary);
      font-size: 13px;
    }

    /* Placeholder */
    .content-placeholder {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-height: 320px;
      color: var(--color-text-secondary);
      text-align: center;
      font-size: 14px;
    }

    .content-placeholder svg {
      margin-bottom: 16px;
      opacity: 0.4;
    }

    /* Quote edit form */
    .quote-form {
      display: none;
    }

    .quote-form.visible {
      display: block;
      /* Flex child of .admin-main: allow it to shrink to the viewport so wide
         inner content (tabs, fields) never pushes the whole panel sideways. */
      min-width: 0;
      max-width: 100%;
    }

    /* Tab Navigation */
    .form-tabs {
      display: flex;
      gap: 0;
      border-bottom: 2px solid var(--color-border, #e5e7eb);
      margin-bottom: 24px;
      /* Scroll the tab row within the viewport on narrow screens instead of
         letting 4 tabs expand the panel (which pushed all content sideways
         and required scrolling left to read it). */
      overflow-x: auto;
      overflow-y: hidden;
      /* Touch swipes pan ONLY horizontally, no vertical drag of the nav. */
      touch-action: pan-x;
      overscroll-behavior-x: contain;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }
    .form-tabs::-webkit-scrollbar { display: none; }
    .form-tab { flex-shrink: 0; white-space: nowrap; }

    .form-tab {
      padding: 10px 20px;
      font-size: 13px;
      font-weight: 600;
      color: var(--color-text-secondary, #6b7280);
      background: none;
      border: none;
      border-bottom: 2px solid transparent;
      margin-bottom: -2px;
      cursor: pointer;
      transition: color 0.2s, border-color 0.2s;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .form-tab:hover {
      color: var(--color-text-primary, #1a1a2e);
    }

    .form-tab.active {
      color: var(--color-primary, #0071e3);
      border-bottom-color: var(--color-primary, #0071e3);
    }

    .form-tab .tab-badge {
      background: var(--color-primary, #0071e3);
      color: white;
      font-size: 10px;
      padding: 1px 6px;
      border-radius: 10px;
      font-weight: 700;
    }

    .tab-content {
      display: none;
    }

    .tab-content.active {
      display: block;
    }

    /* Messages Tab */
    .messages-compose {
      margin-bottom: 20px;
    }

    .messages-compose label {
      display: block;
      font-size: 12px;
      font-weight: 600;
      color: var(--color-text-secondary, #6b7280);
      margin-bottom: 6px;
    }

    .messages-compose .compose-row {
      margin-bottom: 12px;
    }

    .messages-compose .compose-actions {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: 4px;
    }

    /* Message styles moved to is:global block for dynamically created elements */

    .form-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 24px;
      flex-wrap: wrap;
      gap: 16px;
    }

    .form-title-group {
      flex: 1;
    }

    /* Code badge = chip (same metrics as Leads' .detail-code) */
    .form-quote-number {
      display: inline-block;
      background: linear-gradient(135deg, #2563eb 0%, #7c3aed 100%);
      color: white;
      padding: 3px 12px;
      border-radius: 9999px;
      font-size: 12px;
      line-height: 20px;
      font-weight: 600;
      letter-spacing: 0.5px;
      margin-bottom: 8px;
    }

    .form-customer-name {
      font-size: 20px;
      font-weight: 700;
      margin: 0;
      color: var(--color-text-primary);
    }

    .form-actions-top {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }

    .btn {
      padding: 8px 16px;
      border-radius: 9999px;
      font-size: 13px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.15s;
      border: none;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }

    .btn-primary {
      background: linear-gradient(90deg, #2563eb, #d946ef);
      color: white;
    }

    .btn-primary:hover {
      opacity: 0.9;
    }

    /* Cue on the main Save button when there are unsaved scope edits. */
    #btnSave.has-unsaved {
      box-shadow: 0 0 0 2px #fbbf24, 0 0 12px rgba(251, 191, 36, 0.5);
      animation: savePulse 1.6s ease-in-out infinite;
    }
    @keyframes savePulse {
      0%, 100% { box-shadow: 0 0 0 2px #fbbf24, 0 0 8px rgba(251,191,36,0.35); }
      50% { box-shadow: 0 0 0 2px #fbbf24, 0 0 16px rgba(251,191,36,0.65); }
    }

    .btn-secondary {
      background: var(--glass-bg);
      border: 1px solid var(--glass-border);
      color: var(--color-text-secondary);
    }

    .btn-secondary:hover {
      background: rgba(255, 255, 255, 0.1);
      color: var(--color-text-primary);
    }

    .btn-success {
      background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%);
      color: white;
    }

    .btn-polish {
      background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
      color: white;
    }

    .btn-polish:hover {
      opacity: 0.9;
    }

    .btn-polish:disabled {
      opacity: 0.6;
      cursor: wait;
    }

    .spinner-sm {
      display: inline-block;
      width: 12px;
      height: 12px;
      border: 2px solid rgba(255,255,255,0.3);
      border-radius: 50%;
      border-top-color: white;
      animation: spin 0.8s linear infinite;
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    /* Detail-header status — HeroUI soft chip (no border) */
    .pending-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 3px 12px;
      background: var(--warning-soft);
      color: var(--warning-soft-foreground);
      border-radius: 9999px;
      font-size: 12px;
      line-height: 20px;
      font-weight: 500;
    }

    .quote-status-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 3px 12px;
      border-radius: 9999px;
      font-size: 12px;
      line-height: 20px;
      font-weight: 500;
    }

    .quote-status-badge.draft {
      background: rgba(156,163,175,.15); color: #a1a1aa;
    }

    .quote-status-badge.sent {
      background: var(--warning-soft); color: var(--warning-soft-foreground);
    }

    .quote-status-badge.declined {
      background: var(--danger-soft); color: var(--danger-soft-foreground);
    }

    .quote-status-badge.accepted {
      background: var(--success-soft); color: var(--success-soft-foreground);
    }

    .quote-status-badge.project {
      background: rgba(168,85,247,.15); color: #c084fc;
    }

    .btn-promote {
      background: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 100%);
      color: white;
    }

    .btn-promote:hover {
      opacity: 0.9;
    }

    .btn-danger {
      background: rgba(239, 68, 68, 0.2);
      color: #f87171;
      border: 1px solid rgba(239, 68, 68, 0.3);
    }

    .btn-danger:hover {
      background: rgba(239, 68, 68, 0.3);
    }

    /* Form section — inner card metrics from the locked pattern */
    .form-section {
      background: var(--glass-bg);
      border: 1px solid var(--glass-border);
      border-radius: var(--radius-md);
      padding: 16px;
      margin-bottom: 12px;
      backdrop-filter: blur(10px);
    }

    /* (Scope-editor hover rules moved to the <style is:global> block, they
       target JS-rendered elements that don't carry Astro's scope attribute.) */

    /* Two-column row of form-sections (Customer Info + Appointment Scheduler).
       Stacks on mobile. The inner .form-section keeps its own margin-bottom
       so vertical rhythm stays consistent when wrapped. */
    .form-section-row { display: flex; flex-direction: column; gap: 0; }
    .form-section-row .form-section { margin-bottom: 12px; }
    @media (min-width: 900px) {
      .form-section-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
      }
      .form-section-row .form-section { margin-bottom: 12px; }
    }

    /* Section titles: 12px uppercase accent (locked pattern) */
    .form-section-title {
      font-size: 12px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--color-primary);
      margin-bottom: 12px;
    }

    .form-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
      margin-bottom: 12px;
    }

    .form-row.single {
      grid-template-columns: 1fr;
    }

    .form-row.triple {
      grid-template-columns: 2fr 1fr 1fr;
    }

    .form-group {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .form-label {
      font-size: 12px;
      font-weight: 500;
      color: var(--color-text-secondary);
    }

    /* .form-input / .form-input:focus / ::placeholder defined canonically in
       src/styles/admin.css. Do NOT redefine them here: local overrides cause
       the page-to-page drift the user reported. */

    .input-with-action {
      display: flex;
      gap: 6px;
      align-items: center;
    }

    .input-with-action .form-input {
      flex: 1;
    }

    .input-action-btn {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 36px;
      height: 36px;
      border-radius: var(--radius-md);
      background: var(--glass-bg);
      border: 1px solid var(--glass-border);
      color: var(--color-primary);
      cursor: pointer;
      transition: all 0.15s;
      flex-shrink: 0;
      text-decoration: none;
    }

    .input-action-btn:hover {
      background: rgba(0, 113, 227, 0.15);
      border-color: var(--color-primary);
    }

    /* .form-textarea defined canonically in admin.css. */

    /* Pricing table styles moved to <style is:global> block below */

    .btn-add-row {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 6px 12px;
      background: var(--glass-bg);
      border: 1px dashed var(--glass-border);
      border-radius: var(--radius-md);
      color: var(--color-text-secondary);
      font-size: 12px;
      cursor: pointer;
      transition: all 0.15s;
    }

    .btn-add-row:hover {
      border-color: var(--color-primary);
      color: var(--color-primary);
    }

    /* Totals */
    .totals-section {
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 8px;
      padding-top: 16px;
      border-top: 1px solid var(--glass-border);
    }

    .total-row {
      display: flex;
      justify-content: space-between;
      width: 200px;
      font-size: 14px;
      color: var(--color-text-primary);
    }

    .total-row.grand-total {
      font-size: 18px;
      font-weight: 700;
      color: var(--color-primary);
      padding-top: 8px;
      border-top: 2px solid var(--glass-border);
    }

    /* Bottom action bar (Save, Send, Promote) */
    .form-action-bar {
      display: flex;
      justify-content: center;
      gap: 12px;
      padding-top: 24px;
      margin-top: 24px;
      border-top: 1px solid var(--glass-border);
      flex-wrap: wrap;
    }

    /* Management tab content */
    .management-section {
      background: var(--glass-bg);
      border: 1px solid var(--glass-border);
      border-radius: var(--radius-md);
      padding: 16px;
      margin-bottom: 12px;
    }

    .management-title {
      font-size: 12px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--color-primary);
      margin: 0 0 6px 0;
    }

    .management-desc {
      font-size: 13px;
      color: var(--color-text-secondary);
      margin: 0 0 20px 0;
    }

    /* Promote + Mark-as-Declined cards: stacked on narrow screens, side-by-side
       (50/50) above 1024px. When the decline card is hidden, the promote card
       flex:1 takes the full width on its own. */
    .management-cards {
      display: flex;
      flex-direction: column;
      gap: 20px;
      margin-bottom: 20px;
    }
    .management-cards > div { margin-bottom: 0; }
    @media (min-width: 1025px) {
      .management-cards { flex-direction: row; align-items: flex-start; }
      .management-cards > div { flex: 1; min-width: 0; }
    }

    .management-actions {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
    }

    /* Error message */
    .error-message {
      background: rgba(239, 68, 68, 0.2);
      border: 1px solid rgba(239, 68, 68, 0.3);
      color: #f87171;
      padding: 16px 20px;
      border-radius: var(--radius-md);
      margin-bottom: 16px;
    }

    /* Modal - Dark theme (override admin.css .modal styles) */
    .modal {
      display: none;
      position: fixed;
      inset: 0;
      z-index: 10000;
      align-items: center;
      justify-content: center;
      /* Reset admin.css .modal overrides */
      max-width: none;
      width: auto;
      background: transparent;
      border: none;
      border-radius: 0;
      max-height: none;
      overflow: visible;
      animation: none;
    }

    .modal.active {
      display: flex;
    }

    .modal-backdrop {
      position: absolute;
      inset: 0;
      background: rgba(0, 0, 0, 0.7);
      backdrop-filter: blur(8px);
    }

    .modal-content {
      position: relative;
      background: linear-gradient(135deg, rgba(18, 18, 31, 0.95), rgba(10, 10, 20, 0.98));
      border: 1px solid var(--glass-border);
      border-radius: 16px;
      padding: 32px;
      max-width: 400px;
      width: 90%;
      text-align: center;
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
    }

    .modal-icon {
      width: 64px;
      height: 64px;
      margin: 0 auto 16px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .modal-icon.danger {
      background: rgba(239, 68, 68, 0.2);
    }

    .modal-icon.danger svg {
      color: #f87171;
    }

    .modal-title {
      font-size: 16px;
      font-weight: 600;
      margin: 0 0 8px;
      color: var(--color-text-primary);
    }

    .modal-text {
      font-size: 14px;
      color: var(--color-text-secondary);
      margin: 0 0 24px;
      line-height: 1.5;
    }

    .modal-actions {
      display: flex;
      gap: 12px;
    }

    .modal-actions .btn {
      flex: 1;
    }

    /* Images grid container (scoped) */
    .images-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));
      gap: 8px;
      margin-bottom: 12px;
    }

    .upload-progress-bar {
      margin-bottom: 12px;
      padding: 12px;
      background: rgba(0, 113, 227, 0.1);
      border: 1px solid rgba(0, 113, 227, 0.2);
      border-radius: 8px;
    }

    .upload-progress-text {
      font-size: 13px;
      font-weight: 600;
      color: var(--color-primary, #0071e3);
      margin-bottom: 8px;
    }

    .upload-progress-track {
      height: 6px;
      background: rgba(0, 113, 227, 0.15);
      border-radius: 3px;
      overflow: hidden;
    }

    .upload-progress-fill {
      height: 100%;
      background: linear-gradient(90deg, #2563eb, #7c3aed);
      border-radius: 3px;
      transition: width 0.3s ease;
      width: 0%;
    }

    .images-empty {
      color: var(--color-text-secondary);
      font-size: 13px;
      padding: 20px;
      text-align: center;
    }

    .contract-upload-area {
      padding: 16px;
      border: 2px dashed var(--color-border);
      border-radius: 8px;
      text-align: center;
    }

    .contract-file-card {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 12px 16px;
      background: var(--color-bg-secondary);
      border: 1px solid var(--color-border);
      border-radius: 8px;
    }

    .contract-file-info {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .form-section-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 12px;
    }

    .form-section-header .form-section-title {
      margin-bottom: 0;
    }

    .image-upload-controls {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .image-count {
      font-size: 12px;
      color: var(--color-text-secondary);
    }

    .image-uploading {
      opacity: 0.5;
      pointer-events: none;
    }

    /* Image lightbox */
    .lightbox {
      display: none;
      position: fixed;
      inset: 0;
      z-index: 10002;
      background: rgba(0, 0, 0, 0.95);
      align-items: center;
      justify-content: center;
      cursor: zoom-out;
    }

    .lightbox.active {
      display: flex;
    }

    .lightbox img {
      max-width: 90vw;
      max-height: 90vh;
      object-fit: contain;
    }

    .lightbox-close {
      position: absolute;
      top: 20px;
      right: 20px;
      width: 40px;
      height: 40px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.1);
      border: none;
      color: white;
      font-size: 24px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    /* Mobile responsive */
    /* Tablet (incl. iPad portrait/landscape): keep the desktop 2-column layout
       so the detail shows BESIDE the list, not stacked below it. Just narrow
       the list, and let it be collapsed via the toggle for more detail room. */
    @media (min-width: 769px) and (max-width: 1180px) {
      .quotes-list { width: 248px; min-width: 220px; max-width: 268px; }
    }
    /* Collapsible list: toggle hides it so the detail gets full width. */
    .list-toggle-btn {
      display: inline-flex; align-items: center; justify-content: center;
      position: fixed; left: 8px; top: 50%; transform: translateY(-50%); z-index: 60;
      width: 34px; height: 34px; border-radius: 8px; font-size: 18px; line-height: 1;
      border: 1px solid var(--glass-border); background: var(--glass-bg);
      color: var(--color-text-primary); cursor: pointer;
      box-shadow: 0 4px 14px rgba(0,0,0,0.3);
    }
    .admin-main.list-collapsed .quotes-list { display: none; }

    @media (max-width: 768px) {
      .admin-main { padding: 12px; }

      .quotes-columns {
        flex-direction: column;
        gap: 20px;
        /* Stretch children to full width: base align-items:flex-start would
           otherwise size the detail card to its content instead of the screen. */
        align-items: stretch;
      }

      .quote-stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .quote-stat.pipeline { grid-column: span 2; }

      .page-topbar .search-bar { order: 3; flex-basis: 100%; max-width: none; }

      .quotes-list {
        width: 100% !important;
        min-width: 100% !important;
        max-width: 100% !important;
        max-height: 45vh;
        padding: 10px;
      }

      .quote-content {
        width: 100%;
        min-width: 0;
        max-width: 100%;
        padding: 12px;
      }

      /* Mobile: sections are collapsible */
      .section-chevron {
        display: block;
        margin-left: auto;
        transition: transform 0.2s;
      }

      .section-toggle {
        cursor: pointer;
        user-select: none;
      }

      .section-toggle.collapsed .section-chevron {
        transform: rotate(-90deg);
      }

      .collapsed-mobile {
        display: none;
      }

      /* Compact header */
      .form-header {
        flex-direction: column;
        gap: 10px;
        margin-bottom: 14px;
      }

      .form-quote-number {
        padding: 2px 10px;
        font-size: 11px;
        margin-bottom: 6px;
      }

      .form-customer-name {
        font-size: 18px;
      }

      .form-actions-top {
        width: 100%;
        justify-content: flex-start;
        gap: 6px;
        flex-wrap: wrap;
      }

      /* Compact form styling */
      .form-row {
        grid-template-columns: 1fr;
        gap: 10px;
      }

      .form-group label {
        font-size: 12px;
        margin-bottom: 4px;
      }

      .form-group input,
      .form-group select,
      .form-group textarea {
        padding: 8px 10px;
        font-size: 13px;
      }

      .form-section {
        padding: 10px 12px;
        margin-bottom: 8px;
        border-radius: var(--radius-md);
      }

      .form-section-title {
        font-size: 12px;
        margin-bottom: 8px;
      }

      /* Right-pane sections become tap-to-toggle accordions on mobile.
         Wiring is done in JS (initQuoteSectionAccordions) which adds a
         chevron + click handler to each top-level form-section title. */
      #tabDetails .form-section.fs-collapsible > .form-section-title,
      #tabPdfs .form-section.fs-collapsible > .form-section-title,
      #tabMessages .form-section.fs-collapsible > .form-section-title,
      #tabManagement .form-section.fs-collapsible > .form-section-title {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        cursor: pointer;
        user-select: none;
        margin-bottom: 0;
        padding: 4px 0;
      }
      .fs-chevron {
        display: inline-block;
        font-size: 14px;
        line-height: 1;
        opacity: 0.6;
        transition: transform 0.2s ease;
        transform: rotate(0deg);
      }
      .form-section.fs-collapsed > .form-section-title .fs-chevron {
        transform: rotate(-90deg);
      }
      /* Only sections that successfully opted into the accordion (have
         BOTH classes) hide their content when collapsed. Sections whose
         title isn't a direct child of .form-section (e.g. the Scopes &
         Pricing card uses a wrapping flex div around its h3) get skipped
         by the init and must stay fully visible, without the dual-class
         guard, they'd lose their content too. */
      .form-section.fs-collapsible.fs-collapsed > *:not(.form-section-title) {
        display: none !important;
      }
      /* When a section is in the collapsed state, drop its own margin-bottom
         so the section list reads more like a tight nav stack. */
      .form-section.fs-collapsible.fs-collapsed {
        margin-bottom: 6px;
        padding: 8px 12px;
      }

      /* iOS Safari renders <input type="date"> at its intrinsic width
         (including space for the picker icon), ignoring the parent's
         width unless we explicitly reset its appearance + min-width.
         Without this, the date field overflows narrow cards on mobile. */
      .form-input[type="date"],
      .form-input[type="time"],
      .form-input[type="datetime-local"] {
        -webkit-appearance: none;
        appearance: none;
        min-width: 0;
        max-width: 100%;
        box-sizing: border-box;
      }

      /* Scope cards inside the editor: tighter padding on mobile so the
         nested per-scope actions don't push the page off-screen. */
      .scope-card {
        padding: 10px !important;
      }
      .scope-card .scope-section {
        padding: 8px !important;
      }

      /* Floating Preview PDF FAB: fixed bottom-right while editing. Mirrors
         the bottom-action-bar #btnPreviewPdf click. Hidden on desktop where
         the action bar is already in view. */
      .preview-fab {
        position: fixed;
        right: 14px;
        bottom: 20px;
        z-index: 90;
        display: none;
        align-items: center;
        gap: 6px;
        padding: 10px 14px !important;
        border-radius: 999px !important;
        font-size: 12px !important;
        font-weight: 700 !important;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.45);
        background: var(--color-bg-elevated, #1f2937) !important;
        color: var(--color-text-primary, #fff) !important;
        border: 1px solid var(--glass-border, rgba(255,255,255,0.15)) !important;
      }
      .preview-fab.is-visible { display: inline-flex; }
      .preview-fab svg { width: 14px !important; height: 14px !important; }

      /* Compact buttons - force override */
      .btn,
      .btn-primary,
      .btn-secondary,
      .btn-danger,
      .btn-success,
      .btn-promote {
        padding: 6px 12px !important;
        font-size: 11px !important;
        gap: 4px !important;
        border-radius: 9999px !important;
      }

      .btn svg,
      .form-actions-top .btn svg {
        width: 12px !important;
        height: 12px !important;
      }

      .form-actions-top {
        gap: 6px !important;
      }

      /* Compact pricing table moved to global style block */

      /* New Quote Modal - Full screen on mobile */
      .modal {
        padding: 0 !important;
        align-items: flex-start !important;
      }

      .modal-content {
        max-width: 100% !important;
        width: 100% !important;
        height: 100vh !important;
        max-height: 100vh !important;
        border-radius: 0 !important;
        padding: 0 !important;
        display: flex;
        flex-direction: column;
      }

      .modal-header {
        position: sticky;
        top: 0;
        z-index: 10;
        background: linear-gradient(135deg, rgba(18, 18, 31, 0.98), rgba(10, 10, 20, 0.99));
        padding: 12px 16px !important;
        margin-bottom: 0 !important;
        border-bottom: 1px solid var(--glass-border);
        display: flex;
        align-items: center;
        justify-content: space-between;
      }

      .modal-title {
        font-size: 16px !important;
      }

      .modal-header button {
        width: 32px;
        height: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(255, 255, 255, 0.1) !important;
        border-radius: 50% !important;
        padding: 0 !important;
      }

      .modal-header button svg {
        width: 16px;
        height: 16px;
      }

      /* Form inside modal */
      .modal-content form,
      #newQuoteForm {
        flex: 1;
        overflow-y: auto;
        padding: 16px;
      }

      .modal-content .form-row {
        grid-template-columns: 1fr;
        gap: 12px;
      }

      .modal-content .form-group-modal,
      .modal-content .form-group {
        margin-bottom: 12px;
      }

      .modal-content .form-group-modal label,
      .modal-content .form-group label {
        font-size: 12px;
        margin-bottom: 4px;
      }

      .modal-content .form-group-modal input,
      .modal-content .form-group-modal select,
      .modal-content .form-group-modal textarea,
      .modal-content .form-group input,
      .modal-content .form-group select,
      .modal-content .form-group textarea {
        padding: 10px 12px;
        font-size: 14px;
      }

      .modal-actions,
      .modal-content > div:last-child {
        position: sticky;
        bottom: 0;
        background: linear-gradient(135deg, rgba(18, 18, 31, 0.98), rgba(10, 10, 20, 0.99));
        margin: 0;
        padding: 12px 16px;
        border-top: 1px solid var(--glass-border);
        gap: 8px;
        display: flex;
      }

      .modal-actions .btn,
      .modal-content > div:last-child .btn {
        padding: 10px 16px !important;
        font-size: 13px !important;
        border-radius: 9999px !important;
        flex: 1;
      }
    }

    /* Mobile Navigation */
    .mobile-nav-toggle {
      display: none;
      flex-direction: column;
      justify-content: center;
      gap: 5px;
      width: 40px;
      height: 40px;
      background: var(--glass-bg);
      border: 1px solid var(--glass-border);
      border-radius: var(--radius-md);
      cursor: pointer;
      padding: 10px;
      transition: all 0.2s ease;
    }

    .mobile-nav-toggle span {
      display: block;
      width: 100%;
      height: 2px;
      background: var(--color-text-primary);
      border-radius: 2px;
      transition: all 0.3s ease;
    }

    .mobile-nav-toggle:hover {
      background: var(--glass-bg-hover);
    }

    .mobile-nav-toggle.active span:nth-child(1) {
      transform: rotate(45deg) translate(5px, 5px);
    }

    .mobile-nav-toggle.active span:nth-child(2) {
      opacity: 0;
    }

    .mobile-nav-toggle.active span:nth-child(3) {
      transform: rotate(-45deg) translate(5px, -5px);
    }

    .mobile-nav-overlay {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: rgba(0, 0, 0, 0.5);
      z-index: 998;
      opacity: 0;
      transition: opacity 0.3s ease;
    }

    .mobile-nav-overlay.active {
      display: block;
      opacity: 1;
    }

    .mobile-nav-panel {
      position: fixed;
      top: 0;
      right: -300px;
      width: 280px;
      height: 100vh;
      background: var(--color-background);
      border-left: 1px solid var(--glass-border);
      z-index: 999;
      transition: right 0.3s ease;
      overflow-y: auto;
    }

    .mobile-nav-panel.active {
      right: 0;
    }

    .mobile-nav-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 16px 20px;
      border-bottom: 1px solid var(--glass-border);
    }

    .mobile-nav-title {
      font-size: 16px;
      font-weight: 600;
      color: var(--color-text-primary);
    }

    .mobile-nav-close {
      width: 36px;
      height: 36px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: var(--glass-bg);
      border: 1px solid var(--glass-border);
      border-radius: var(--radius-md);
      cursor: pointer;
      color: var(--color-text-primary);
      transition: all 0.2s ease;
    }

    .mobile-nav-close:hover {
      background: var(--glass-bg-hover);
    }

    .mobile-nav-links {
      padding: 16px;
    }

    .mobile-nav-link {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 14px 16px;
      color: var(--color-text-secondary);
      text-decoration: none;
      font-weight: 500;
      font-size: 15px;
      border-radius: var(--radius-md);
      transition: all 0.2s ease;
      margin-bottom: 4px;
    }

    .mobile-nav-link:hover {
      background: var(--glass-bg-hover);
      color: var(--color-text-primary);
    }

    .mobile-nav-link.active {
      background: linear-gradient(135deg, var(--color-primary), var(--color-primary-dark));
      color: white;
    }

    .mobile-nav-link svg {
      flex-shrink: 0;
    }

    .mobile-nav-divider {
      height: 1px;
      background: var(--glass-border);
      margin: 12px 0;
    }

    .mobile-nav-section-title {
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: var(--color-text-secondary);
      padding: 8px 16px 12px;
      opacity: 0.7;
    }

    /* Sub-action links (New Quote, etc.) - compact inline style */
    .mobile-nav-sub-action {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 8px 16px 8px 48px;
      color: var(--color-primary);
      text-decoration: none;
      font-weight: 500;
      font-size: 13px;
      border-radius: var(--radius-sm);
      transition: all 0.2s ease;
      margin-bottom: 4px;
    }

    .mobile-nav-sub-action:hover {
      background: var(--glass-bg-hover);
    }

    .mobile-nav-sub-action svg {
      width: 16px;
      height: 16px;
      flex-shrink: 0;
    }

    @media (max-width: 1024px) {
      .mobile-nav-toggle {
        display: flex;
      }

      .admin-nav {
        display: none;
      }
    }
  </style>
  <style is:global>
    /* Scope editor: section/item action buttons (↑ ↓ ✕, Preview PDF) only
       show while the user is actively interacting with the parent. Hover
       alone no longer reveals them (was creating visual noise on the form);
       the user must focus an input or button inside the section/item to
       expose its actions. Tap on touch / click on desktop both set focus,
       so the same rule works everywhere. JS-rendered HTML doesn't carry
       Astro's scoped attribute, so this lives in the global block. */
    .scope-section-actions,
    .scope-item-actions {
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.15s ease;
    }
    /* Scope-card and section actions live in the FIRST child div of the
       parent (the title row). Using `> div:focus-within > .scope-section-actions`
       scopes the reveal to focus in THAT title row, not a deeper item. */
    .scope-section > div:focus-within > .scope-section-actions,
    .scope-item:focus-within .scope-item-actions {
      opacity: 1;
      pointer-events: auto;
    }
    /* Touch devices have no hover and focus-within is unreliable from a tap on
       a non-input, so always show the actions there (they were untappable). */
    @media (hover: none) {
      .scope-section-actions,
      .scope-item-actions {
        opacity: 1 !important;
        pointer-events: auto !important;
      }
    }

    /* Image gallery (dynamically rendered, needs global scope) */
    .image-thumb {
      position: relative;
      aspect-ratio: 1;
      border-radius: var(--radius-md, 8px);
      overflow: hidden;
      background: var(--color-background, rgba(0,0,0,0.2));
      border: 1px solid var(--color-border, rgba(255,255,255,0.1));
    }

    .image-thumb img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      cursor: pointer;
      transition: transform 0.2s;
      display: block;
    }

    .image-delete-btn {
      position: absolute;
      top: 4px;
      right: 4px;
      width: 24px;
      height: 24px;
      background: rgba(220, 38, 38, 0.9);
      border: none;
      border-radius: 4px;
      color: white;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      opacity: 0;
      transition: opacity 0.2s;
    }

    .image-thumb:hover .image-delete-btn {
      opacity: 1;
    }

    .image-anno-btn {
      position: absolute;
      top: 4px;
      left: 4px;
      width: 24px;
      height: 24px;
      background: rgba(37, 99, 235, 0.92);
      border: none;
      border-radius: 4px;
      color: white;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      text-decoration: none;
      font-size: 14px;
      line-height: 1;
      opacity: 0;
      transition: opacity 0.2s;
    }
    .image-thumb:hover .image-anno-btn { opacity: 1; }

    /* Star toggle: which reference images appear in the customer PDF. Bottom-
       left so it doesn't collide with annotate (top-left) or delete (top-right).
       Starred state stays visible (not hover-only) so the selection reads at a
       glance, and the thumb gets a gold ring. */
    .image-star-btn {
      position: absolute;
      bottom: 4px;
      left: 4px;
      width: 24px;
      height: 24px;
      background: rgba(10, 10, 20, 0.72);
      border: none;
      border-radius: 4px;
      color: #fde047;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 15px;
      line-height: 1;
      opacity: 0;
      transition: opacity 0.2s;
    }
    .image-thumb:hover .image-star-btn { opacity: 1; }
    .image-star-btn.active { opacity: 1; background: rgba(202, 138, 4, 0.95); color: #fff; }
    .image-thumb.is-starred { outline: 2px solid #facc15; outline-offset: -2px; }
    /* Touch devices (iPad/phone) have no hover: keep the image action buttons
       visible so the Quote team can star/annotate/delete with a tap. */
    @media (hover: none) {
      .image-star-btn, .image-anno-btn, .image-delete-btn { opacity: 1 !important; }
    }

    /* Global styles for dynamically created message elements */
    .messages-log {
      margin-top: 24px;
    }

    .messages-log-title {
      font-size: 13px;
      font-weight: 600;
      color: rgba(255, 255, 255, 0.6);
      margin-bottom: 12px;
      display: flex;
      align-items: center;
      gap: 6px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    /* Chat-style message thread */
    #messagesContainer {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .message-item {
      padding: 10px 14px;
      border-radius: 16px;
      max-width: 82%;
      transition: background 0.2s;
    }

    /* Admin messages: right-aligned */
    .message-item.admin-msg {
      align-self: flex-end;
      background: rgba(74, 222, 128, 0.1);
      border: 1px solid rgba(74, 222, 128, 0.2);
      border-bottom-right-radius: 4px;
    }

    .message-item.admin-msg:hover {
      background: rgba(74, 222, 128, 0.15);
    }

    /* Customer messages: left-aligned */
    .message-item.customer-reply {
      align-self: flex-start;
      background: rgba(59, 130, 246, 0.1);
      border: 1px solid rgba(59, 130, 246, 0.25);
      border-bottom-left-radius: 4px;
    }

    .message-item.customer-reply:hover {
      background: rgba(59, 130, 246, 0.15);
    }

    .message-item .msg-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 6px;
      gap: 12px;
    }

    .message-item .msg-subject {
      font-size: 12px;
      font-weight: 600;
      color: rgba(255, 255, 255, 0.7);
      flex: 1;
    }

    .message-item .msg-date {
      font-size: 10px;
      color: rgba(255, 255, 255, 0.35);
      white-space: nowrap;
    }

    .message-item .msg-body {
      font-size: 13px;
      color: rgba(255, 255, 255, 0.9);
      line-height: 1.5;
      white-space: pre-wrap;
    }

    .message-item .msg-status {
      font-size: 10px;
      display: flex;
      align-items: center;
      gap: 4px;
      margin-top: 6px;
    }

    .message-item .msg-status.sent {
      color: rgba(74, 222, 128, 0.6);
    }

    .message-item .msg-status.failed {
      color: #f87171;
    }

    .message-item .msg-status.received {
      color: rgba(96, 165, 250, 0.6);
    }

    .message-item .msg-sender-badge {
      font-size: 10px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      padding: 2px 8px;
      border-radius: 10px;
      display: inline-block;
      margin-bottom: 4px;
    }

    .message-item .msg-sender-badge.admin {
      background: rgba(74, 222, 128, 0.15);
      color: #4ade80;
    }

    .message-item .msg-sender-badge.customer {
      background: rgba(96, 165, 250, 0.15);
      color: #60a5fa;
    }

    .messages-empty {
      text-align: center;
      padding: 40px 20px;
      color: rgba(255, 255, 255, 0.4);
      font-size: 13px;
    }

    .messages-empty svg {
      margin-bottom: 12px;
      opacity: 0.3;
    }

    /* Notification Bell styles are in admin.css */

    /* Global styles for dynamically injected pricing table content */
    .pricing-table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 16px;
    }

    .pricing-table th {
      text-align: left;
      font-size: 11px;
      font-weight: 600;
      color: var(--color-text-secondary);
      text-transform: uppercase;
      padding: 8px;
      border-bottom: 1px solid var(--glass-border);
    }

    .pricing-table td {
      padding: 6px 8px;
      border-bottom: none;
      vertical-align: top;
    }

    .pricing-table input,
    .pricing-table select,
    .pricing-table textarea {
      width: 100%;
      padding: 10px 12px;
      border: 1px solid var(--glass-border);
      border-radius: var(--radius-md);
      font-size: 14px;
      font-family: inherit;
      background: rgba(0, 0, 0, 0.2);
      color: var(--color-text-primary);
      box-sizing: border-box;
      transition: border-color 0.15s, background 0.15s;
    }

    .pricing-table input:focus,
    .pricing-table select:focus,
    .pricing-table textarea:focus {
      outline: none;
      border-color: var(--color-primary);
      background: rgba(0, 0, 0, 0.3);
    }

    .pricing-table input::placeholder,
    .pricing-table textarea::placeholder {
      color: var(--color-text-secondary);
    }

    .pricing-table .row-total {
      font-weight: 600;
      color: var(--color-text-primary);
      padding: 10px 12px;
    }

    .pricing-table .btn-remove,
    .service-row .btn-remove {
      background: none;
      border: none;
      color: #dc2626;
      cursor: pointer;
      font-size: 18px;
      padding: 6px 10px;
      border-radius: var(--radius-md);
      transition: background 0.15s, color 0.15s;
      line-height: 1;
    }

    .pricing-table .btn-remove:hover,
    .service-row .btn-remove:hover {
      background: rgba(220, 38, 38, 0.15);
      color: #f87171;
    }

    @media (max-width: 768px) {
      .pricing-table th,
      .pricing-table td {
        padding: 6px 8px;
        font-size: 12px;
      }

      .pricing-table input {
        padding: 6px 8px;
        font-size: 12px;
      }
    }
  </style>
</head>
<body>
  <AdminPresence />
  <header class="admin-header">
    <a href="/admin/dashboard" class="admin-logo-link">
      <div class="logo-gradient-wrapper"></div>
      <span class="admin-badge">Admin</span>
    </a>
    <AdminNav active="quotes" />
    <!-- Mobile: Bell + Hamburger -->
    <div class="mobile-header-right">
      <div class="notification-bell-wrapper">
        <button class="btn-bell" id="bellBtnMobile" title="Customer Replies" aria-label="Customer Replies">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
          <span class="bell-badge bell-badge-mobile" style="display:none;">0</span>
        </button>
        <div class="bell-dropdown" id="bellDropdownMobile" style="display:none;">
          <div class="bell-dropdown-header"><span>Customer Replies</span><button class="bell-mark-all-read" onclick="markAllRead()">Mark all read</button></div>
          <div class="bell-dropdown-list" id="bellListMobile">
            <div class="bell-dropdown-empty">No new replies</div>
          </div>
        </div>
      </div>
      <button class="mobile-nav-toggle" id="mobileNavToggle" aria-label="Toggle navigation">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>

    <!-- Desktop: Theme + Bell + Logout -->
    <div class="header-actions">
      <button class="theme-toggle" id="themeToggle" onclick="toggleTheme()" title="Toggle theme">
        <svg class="icon-sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="5"/>
          <line x1="12" y1="1" x2="12" y2="3"/>
          <line x1="12" y1="21" x2="12" y2="23"/>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
          <line x1="1" y1="12" x2="3" y2="12"/>
          <line x1="21" y1="12" x2="23" y2="12"/>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
        </svg>
        <svg class="icon-moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
      </button>
      <div class="notification-bell-wrapper">
        <button class="btn-bell" id="bellBtn" title="Customer Replies" aria-label="Customer Replies">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
          <span class="bell-badge" id="bellBadge" style="display:none;">0</span>
        </button>
        <div class="bell-dropdown" id="bellDropdown" style="display:none;">
          <div class="bell-dropdown-header"><span>Customer Replies</span><button class="bell-mark-all-read" onclick="markAllRead()">Mark all read</button></div>
          <div class="bell-dropdown-list" id="bellList">
            <div class="bell-dropdown-empty">No new replies</div>
          </div>
        </div>
      </div>
      <button class="btn-logout" onclick="logout()">Logout</button>
    </div>
  </header>

  <AdminMobileDrawer active="quotes" />

  <button class="list-toggle-btn" id="listToggleBtn" title="Show / hide list" aria-label="Toggle list">‹</button>
  <main class="admin-main">
    <!-- Mini-dashboard topbar: title + search + the one primary action -->
    <div class="page-topbar">
      <div class="page-topbar-heading">
        <h1 class="page-title">Quotes</h1>
        <p class="page-subtitle">Draft, send, and promote into projects</p>
      </div>
      <div class="search-bar">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"/>
          <path d="M21 21l-4.35-4.35"/>
        </svg>
        <input
          type="text"
          class="search-input"
          id="searchInput"
          placeholder="Search quotes..."
        >
      </div>
      <button type="button" class="new-record-btn" onclick="showNewQuoteModal()">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M12 5v14M5 12h14"/></svg>
        New Quote
      </button>
    </div>

    <!-- Stat cards -->
    <div class="quote-stats">
      <div class="quote-stat">
        <div class="quote-stat-num">{allQuotes.length}</div>
        <div class="quote-stat-label">Total Quotes</div>
      </div>
      <div class="quote-stat">
        <div class="quote-stat-num pending">{sentQuotes.length + renegoQuotes.length}</div>
        <div class="quote-stat-label">Pending Approval</div>
      </div>
      <div class="quote-stat">
        <div class="quote-stat-num declined">{declinedQuotes.length}</div>
        <div class="quote-stat-label">Needs Review</div>
      </div>
      <div class="quote-stat">
        <div class="quote-stat-num accepted">{acceptedQuotes.length}</div>
        <div class="quote-stat-label">Ready to Promote</div>
      </div>
      <div class="quote-stat pipeline">
        <div class="quote-stat-num accent">{pipelineLabel}</div>
        <div class="quote-stat-label">Open Pipeline</div>
      </div>
    </div>

    <div class="quotes-columns">
    <!-- Left: Draft Quotes List -->
    <div class="quotes-list">
      {error && <div class="error-message">{error}</div>}

      <div class="no-results" id="noResults">
        No quotes match your search
      </div>

      <!-- Draft Quotes -->
      <div class="quote-section">
        <div class="section-header section-toggle" data-section="draft">
          <h2 class="section-title">Draft Quotes</h2>
          <span class="section-count draft">{draftQuotes.length}</span>
          <svg class="section-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
        </div>
        <div class="section-body" id="sectionDraft">
          {draftQuotes.length === 0 ? (
            <div class="empty-state">No draft quotes</div>
          ) : (
            draftQuotes.map((quote) => (
              <div
                class="quote-card"
                data-quote-id={quote.id}
                data-quote={JSON.stringify(quote)}
                data-search={`${quote.quote_number} ${quote.customer_name} ${quote.customer_email || ''} ${quote.customer_phone || ''} ${quote.city || ''}`.toLowerCase()}
              >
                <div class="quote-card-row">
                  <span class="quote-shortcode" title={quote.quote_number}>#{(quote.quote_number || '').slice(-4)}</span>
                  <span class="status-pill draft">Draft</span>
                  {quote.is_renegotiation ? <span class="renegotiation-badge">RENEGO</span> : null}
                  <span class="quote-name">{quote.customer_name}</span>
                  <span class="quote-time">{timeAgo(quote.updated_at)}</span>
                </div>
              </div>
            ))
          )}
        </div>
      </div>

      <!-- Pending Approval (first-time only) -->
      <div class="quote-section">
        <div class="section-header section-toggle" data-section="sent">
          <h2 class="section-title">Pending Approval</h2>
          <span class="section-count sent">{sentQuotes.length}</span>
          <svg class="section-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
        </div>
        <div class="section-body collapsed-mobile" id="sectionSent">
          {sentQuotes.length === 0 ? (
            <div class="empty-state">No quotes pending</div>
          ) : (
            sentQuotes.map((quote) => (
              <div class="quote-card" data-quote-id={quote.id} data-quote={JSON.stringify(quote)} data-search={`${quote.quote_number} ${quote.customer_name} ${quote.customer_email || ''} ${quote.customer_phone || ''} ${quote.city || ''}`.toLowerCase()}>
                <div class="quote-card-row">
                  <span class="quote-shortcode" title={quote.quote_number}>#{(quote.quote_number || '').slice(-4)}</span>
                  <span class="status-pill sent">Pending</span>
                  <span class="quote-name">{quote.customer_name}</span>
                  <span class="quote-time">{timeAgo(quote.sent_at || quote.updated_at)}</span>
                </div>
                {(quote.follow_up_count as number) > 0 && <div class="quote-meta">{quote.follow_up_count} follow-up{(quote.follow_up_count as number) > 1 ? 's' : ''} sent</div>}
              </div>
            ))
          )}
        </div>
      </div>

      <!-- Needs Review (Declined) -->
      <div class="quote-section">
        <div class="section-header section-toggle" data-section="declined">
          <h2 class="section-title">Needs Review</h2>
          <span class="section-count declined">{declinedQuotes.length}</span>
          <svg class="section-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
        </div>
        <div class="section-body collapsed-mobile" id="sectionDeclined">
          {declinedQuotes.length === 0 ? (
            <div class="empty-state">No declined quotes</div>
          ) : (
            declinedQuotes.map((quote) => (
              <div class="quote-card" data-quote-id={quote.id} data-quote={JSON.stringify(quote)} data-search={`${quote.quote_number} ${quote.customer_name} ${quote.customer_email || ''} ${quote.customer_phone || ''} ${quote.city || ''}`.toLowerCase()}>
                <div class="quote-card-row">
                  <span class="quote-shortcode" title={quote.quote_number}>#{(quote.quote_number || '').slice(-4)}</span>
                  <span class="status-pill declined">Declined</span>
                  {quote.is_renegotiation ? <span class="renegotiation-badge">RENEGO</span> : null}
                  <span class="quote-name">{quote.customer_name}</span>
                  <span class="quote-time">{timeAgo(quote.responded_at || quote.updated_at)}</span>
                </div>
                {quote.decline_reason && <div class="quote-reason">"{quote.decline_reason}"</div>}
                <div class="quote-card-actions">
                  <button class="btn-sm btn-accept" data-quote-id={quote.id} onclick="event.stopPropagation(); acceptDecline(this.dataset.quoteId)">Accept Decline</button>
                  <button class="btn-sm btn-renego" data-quote-id={quote.id} onclick="event.stopPropagation(); renegotiate(this.dataset.quoteId)">Renegotiate</button>
                </div>
              </div>
            ))
          )}
        </div>
      </div>

      <!-- Renegotiation Pending -->
      <div class="quote-section">
        <div class="section-header section-toggle" data-section="renego">
          <h2 class="section-title">Renegotiation Pending</h2>
          <span class="section-count renego">{renegoQuotes.length}</span>
          <svg class="section-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
        </div>
        <div class="section-body collapsed-mobile" id="sectionRenego">
          {renegoQuotes.length === 0 ? (
            <div class="empty-state">No renegotiated quotes pending</div>
          ) : (
            renegoQuotes.map((quote) => (
              <div class="quote-card" data-quote-id={quote.id} data-quote={JSON.stringify(quote)} data-search={`${quote.quote_number} ${quote.customer_name} ${quote.customer_email || ''} ${quote.customer_phone || ''} ${quote.city || ''}`.toLowerCase()}>
                <div class="quote-card-row">
                  <span class="quote-shortcode" title={quote.quote_number}>#{(quote.quote_number || '').slice(-4)}</span>
                  <span class="status-pill renego">Revised</span>
                  <span class="quote-name">{quote.customer_name}</span>
                  <span class="quote-time">{timeAgo(quote.sent_at || quote.updated_at)}</span>
                </div>
                {(quote.follow_up_count as number) > 0 && <div class="quote-meta">{quote.follow_up_count} follow-up{(quote.follow_up_count as number) > 1 ? 's' : ''} sent</div>}
              </div>
            ))
          )}
        </div>
      </div>

      <!-- Ready to Promote (Accepted) -->
      <div class="quote-section">
        <div class="section-header section-toggle" data-section="accepted">
          <h2 class="section-title">Ready to Promote</h2>
          <span class="section-count" style="background: rgba(34, 197, 94, 0.1); color: #22c55e;">{acceptedQuotes.length}</span>
          <svg class="section-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
        </div>
        <div class="section-body collapsed-mobile" id="sectionAccepted">
          {acceptedQuotes.length === 0 ? (
            <div class="empty-state">No accepted quotes</div>
          ) : (
            acceptedQuotes.map((quote) => (
              <div class="quote-card" data-quote-id={quote.id} data-quote={JSON.stringify(quote)} data-search={`${quote.quote_number} ${quote.customer_name} ${quote.customer_email || ''} ${quote.customer_phone || ''} ${quote.city || ''}`.toLowerCase()}>
                <div class="quote-card-row">
                  <span class="quote-shortcode" title={quote.quote_number}>#{(quote.quote_number || '').slice(-4)}</span>
                  <span class="status-pill accepted">Accepted</span>
                  {quote.is_renegotiation ? <span class="renegotiation-badge">RENEGO</span> : null}
                  <span class="quote-name">{quote.customer_name}</span>
                  <span class="quote-time">{timeAgo(quote.responded_at || quote.updated_at)}</span>
                </div>
                <div class="quote-card-actions">
                  {quote.promoted_by === 'customer' ? (
                    <span class="quote-approval-badge" style="color: #22c55e;">Customer Approved</span>
                  ) : quote.promoted_by === 'admin' ? (
                    <span class="quote-approval-badge" style="color: #6366f1;">Admin Promoted</span>
                  ) : null}
                  <button class="btn-sm btn-renego" data-quote-id={quote.id} onclick="event.stopPropagation(); promoteToProject(this.dataset.quoteId)">Promote to Project</button>
                </div>
              </div>
            ))
          )}
        </div>
      </div>

      <!-- Cold Quotes (collapsed by default) -->
      <div class="quote-section">
        <div class="section-header section-toggle collapsed" data-section="cold">
          <h2 class="section-title">Cold Quotes</h2>
          <span class="section-count cold">{coldQuotes.length}</span>
          <svg class="section-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
        </div>
        <div class="section-body collapsed-mobile collapsed" id="sectionCold">
          {coldQuotes.length === 0 ? (
            <div class="empty-state">No cold quotes</div>
          ) : (
            coldQuotes.map((quote) => (
              <div class="quote-card" data-quote-id={quote.id} data-quote={JSON.stringify(quote)} data-search={`${quote.quote_number} ${quote.customer_name} ${quote.customer_email || ''} ${quote.customer_phone || ''} ${quote.city || ''}`.toLowerCase()}>
                <div class="quote-card-row">
                  <span class="quote-shortcode" title={quote.quote_number}>#{(quote.quote_number || '').slice(-4)}</span>
                  <span class="status-pill cold">Cold</span>
                  {quote.is_renegotiation ? <span class="renegotiation-badge">RENEGO</span> : null}
                  <span class="quote-name">{quote.customer_name}</span>
                  <span class="quote-time">{timeAgo(quote.updated_at)}</span>
                </div>
                <div class="quote-meta">{quote.follow_up_count} follow-up{(quote.follow_up_count as number) !== 1 ? 's' : ''} sent</div>
              </div>
            ))
          )}
        </div>
      </div>
    </div>

    <!-- Middle: Quote Content/Edit Form -->
    <div class="quote-content">
      <!-- Mobile Back Button -->
      <button class="mobile-back-btn" onclick="hideMobileDetail()">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M19 12H5M12 19l-7-7 7-7"/>
        </svg>
        Back to list
      </button>

      <div class="content-placeholder" id="contentPlaceholder">
        <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
          <polyline points="14 2 14 8 20 8"/>
          <line x1="16" y1="13" x2="8" y2="13"/>
          <line x1="16" y1="17" x2="8" y2="17"/>
          <polyline points="10 9 9 9 8 9"/>
        </svg>
        <p>Select a quote to view and edit</p>
      </div>

      <div class="quote-form" id="quoteForm">
        <div class="form-header">
          <div class="form-title-group">
            <div class="form-quote-number" id="formQuoteNumber"></div>
            <h1 class="form-customer-name" id="formCustomerName"></h1>
          </div>
          <div class="form-actions-top">
            <span class="quote-status-badge" id="quoteStatusBadge" style="display:none;"></span>
            <button class="btn btn-success" id="btnReactivate" style="display:none;" title="Reactivate this cold quote: resets follow-up count and sends it back to Pending Approval">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 4v6h6"/><path d="M3.51 15a9 9 0 1 0 .49-4"/></svg>
              Reactivate
            </button>
            <button class="btn-close-detail" id="btnCloseDetail" title="Close" aria-label="Close quote">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
            </button>
          </div>
        </div>

        <!-- Tab Navigation -->
        <div class="form-tabs">
          <button class="form-tab active" data-tab="details">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
            Details
          </button>
          <button class="form-tab" data-tab="messages">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
            Messages
            <span class="tab-badge" id="messagesBadge" style="display:none;">0</span>
          </button>
          <button class="form-tab" data-tab="pdfs">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="12" y1="18" x2="12" y2="12"/><line x1="9" y1="15" x2="15" y2="15"/></svg>
            Documents
          </button>
          <button class="form-tab" data-tab="management">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/></svg>
            Management
          </button>
        </div>

        <!-- Details Tab -->
        <div class="tab-content active" id="tabDetails">

        <!-- Customer Quote Link (visible only for sent quotes) -->
        <div class="form-section" id="quoteReviewSection" style="display:none;">
          <h3 class="form-section-title">Customer Quote Link</h3>
          <div style="display:flex; align-items:center; gap:10px; flex-wrap:wrap;">
            <a id="quoteReviewUrl" href="#" target="_blank" style="font-size:13px; color:var(--color-primary); text-decoration:none; word-break:break-all;">
            </a>
            <button class="btn btn-secondary" style="padding:6px 14px; font-size:12px;" onclick="navigator.clipboard.writeText(document.getElementById('quoteReviewUrl').href); this.textContent='Copied!'; setTimeout(()=>this.textContent='Copy Link',1500);">Copy Link</button>
          </div>
        </div>

        <!-- Customer Info + Appointment Scheduler — side-by-side on desktop,
             stacked on mobile. See `.form-section-row` rule in the page <style>. -->
        <div class="form-section-row">
        <!-- Customer Info Section -->
        <div class="form-section">
          <h3 class="form-section-title">Customer Info</h3>
          <div class="form-row">
            <div class="form-group">
              <label class="form-label">Name</label>
              <input type="text" class="form-input" id="inputName" />
            </div>
            <div class="form-group">
              <label class="form-label">Email</label>
              <div class="input-with-action">
                <input type="email" class="form-input" id="inputEmail" />
                <a class="input-action-btn" id="emailAction" href="#" onclick="event.preventDefault(); const ev=document.getElementById('inputEmail').value; if(ev) window.location.href='mailto:'+ev;" title="Send email">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                </a>
              </div>
            </div>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label class="form-label">Phone</label>
              <div class="input-with-action">
                <input type="tel" class="form-input" id="inputPhone" />
                <a class="input-action-btn" id="phoneAction" href="#" onclick="event.preventDefault(); const pv=document.getElementById('inputPhone').value; if(pv) window.location.href='tel:'+pv;" title="Call">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                </a>
              </div>
            </div>
            <div class="form-group">
              <label class="form-label">Address</label>
              <div class="input-with-action">
                <input type="text" class="form-input" id="inputAddress" />
                <a class="input-action-btn" id="mapsAction" href="#" onclick="event.preventDefault(); const a=document.getElementById('inputAddress').value, c=document.getElementById('inputCity').value, s=document.getElementById('inputState').value, z=document.getElementById('inputZip').value; const q=[a,c,s,z].filter(Boolean).join(', '); if(q) window.open('https://www.google.com/maps?q='+encodeURIComponent(q),'_blank','noopener');" title="Open in Google Maps">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                </a>
              </div>
            </div>
          </div>
          <div class="form-row triple">
            <div class="form-group">
              <label class="form-label">City</label>
              <input type="text" class="form-input" id="inputCity" />
            </div>
            <div class="form-group">
              <label class="form-label">State</label>
              <input type="text" class="form-input" id="inputState" />
            </div>
            <div class="form-group">
              <label class="form-label">Zip</label>
              <input type="text" class="form-input" id="inputZip" />
            </div>
          </div>
        </div>

        <!-- Interested in Service + Appointment Scheduler — combined card.
             The lead's stated interest (service type + free-text scope) lives
             above the scheduling fields so it's the first thing the admin sees
             when they open a quote, with the date/time selector below. -->
        <div class="form-section">
          <h3 class="form-section-title">Interested in Service</h3>
          <p style="font-size: 12px; color: var(--color-text-secondary); margin-bottom: 12px;">What the customer asked for. Add a row per service type: each holds its own scope description.</p>
          <div id="servicesList"></div>
          <button type="button" class="btn-add-row" id="btnAddService" style="margin-top:8px;">+ Add Service</button>

          <div style="margin-top:22px; padding-top:16px; border-top:1px solid var(--glass-border);">
            <h4 style="font-size:14px; font-weight:700; color:var(--color-text-primary); margin:0 0 4px 0;">Appointment Scheduler</h4>
            <p style="font-size: 12px; color: var(--color-text-secondary); margin-bottom: 12px;">Schedule a call or visit with the customer. Pre-filled from lead if available.</p>
            <div class="form-row">
              <div class="form-group">
                <label class="form-label">Date</label>
                <input type="date" class="form-input" id="inputPreferredDate" />
              </div>
              <div class="form-group">
                <label class="form-label">Preferred Time</label>
                <select class="form-select" id="inputPreferredTime">
                  <option value="">Select time</option>
                  <option value="7:00 AM">7:00 AM</option>
                  <option value="8:00 AM">8:00 AM</option>
                  <option value="9:00 AM">9:00 AM</option>
                  <option value="10:00 AM">10:00 AM</option>
                  <option value="11:00 AM">11:00 AM</option>
                  <option value="12:00 PM">12:00 PM</option>
                  <option value="1:00 PM">1:00 PM</option>
                  <option value="2:00 PM">2:00 PM</option>
                  <option value="3:00 PM">3:00 PM</option>
                  <option value="4:00 PM">4:00 PM</option>
                  <option value="5:00 PM">5:00 PM</option>
                  <option value="6:00 PM">6:00 PM</option>
                  <option value="7:00 PM">7:00 PM</option>
                </select>
              </div>
            </div>
          </div>
        </div>
        </div><!-- /form-section-row -->

        <!-- (Quote PDFs section moved to its own tab — see #tabPdfs below) -->

        <!-- Scopes & Pricing — combined card (Phase 5 final).
             A quote owns N scopes (Website, SEO, etc.). Each scope holds
             its own sections + items, and any "Subtotal" items inside any
             scope feed the Pricing summary at the bottom of this same card.
             Grand total = sum of all scope subtotals − discount. -->
        <div class="form-section">
          <div style="display:flex; justify-content:space-between; align-items:center; gap:8px; flex-wrap:wrap; margin-bottom:6px;">
            <h3 class="form-section-title" style="margin:0;">Scopes &amp; Pricing</h3>
            <span id="scopeSaveStatus" style="font-size:12px; color:var(--color-text-secondary);"></span>
          </div>
          <p style="font-size:12px; color:var(--color-text-secondary); margin:4px 0 14px;">
            Each scope is a distinct piece of work (e.g. Website build, Local SEO setup). Apply a template to seed a scope, edit its sections, and add <strong>Subtotal</strong> items inside each scope &mdash; those feed the Pricing summary below.
          </p>

          <!-- Scope list — one card per scope. Rendered by renderScopes(). -->
          <div id="scopesList"></div>

          <!-- Add Scope — slim row at the end of the list (no panel chrome
               so it doesn't compete visually with the actual scope cards
               above). Single-line on desktop, wraps on mobile. -->
          <div style="display:flex; gap:10px; align-items:center; flex-wrap:wrap; margin-top:12px; padding:10px 4px;">
            <span style="font-size:13px; font-weight:600; color:var(--color-text-secondary); white-space:nowrap;">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align:-2px;"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
              Add another scope
            </span>
            <select id="scopeAddTemplatePicker" class="form-input" style="flex:1; min-width:180px; max-width:340px;"></select>
            <button type="button" id="scopeAddFromTemplateBtn" class="btn btn-primary" style="padding:8px 14px; font-size:13px;">Add from template</button>
            <button type="button" id="scopeAddEmptyBtn" class="btn-link-secondary" style="background:transparent; border:none; color:var(--color-text-secondary); font-size:12px; cursor:pointer; padding:6px 4px; text-decoration:underline; text-underline-offset:3px;">or add empty scope</button>
          </div>

          <!-- Pricing summary — sums every Subtotal item across every scope. -->
          <div id="pricingScope" style="margin-top:18px; padding:14px; background:rgba(255,255,255,0.03); border:1px solid var(--glass-border); border-radius:var(--radius-md);">
            <div style="font-size:11px; text-transform:uppercase; letter-spacing:0.5px; font-weight:700; color:var(--color-text-secondary); margin-bottom:8px;">Pricing Summary</div>
            <div id="pricingScopeSubtotals" style="display:flex; flex-direction:column; gap:6px; margin-bottom:8px;"></div>
            <div class="totals-section" style="margin-top:0;">
              <div class="total-row">
                <span>Subtotals:</span>
                <span id="pricingScopeSubtotal">$0.00</span>
              </div>
              <div class="total-row">
                <span>Discount:</span>
                <input type="number" class="form-input" id="inputDiscount" style="width: 100px; padding: 4px 8px; text-align: right;" value="0" />
              </div>
              <div class="total-row grand-total">
                <span>Total:</span>
                <span id="pricingScopeGrand">$0.00</span>
              </div>
            </div>
          </div>

          <!-- Acceptance mode — Simple (one Accept button) vs Advanced (drawn
               signature, ESIGN/UETA). Default Simple. Saves with the main Save. -->
          <div id="acceptModeBox" style="margin-top:14px; padding:14px; background:rgba(255,255,255,0.03); border:1px solid var(--glass-border); border-radius:var(--radius-md); display:flex; gap:12px; align-items:flex-start;">
            <input type="checkbox" id="inputRequireSig" style="margin-top:3px; width:18px; height:18px; cursor:pointer;" />
            <label for="inputRequireSig" style="cursor:pointer; flex:1;">
              <span style="font-weight:700; font-size:14px; color:var(--color-text-primary);">Require a signature to accept</span>
              <span style="display:block; font-size:12px; color:var(--color-text-secondary); margin-top:3px;">
                Off (default): customer accepts with one <strong>Accept</strong> button. On: customer must draw a legal e-signature.
              </span>
            </label>
          </div>

          <!-- Scopes persist with the quote's main Save button (top-right) —
               no separate save here. Just a clear-all action. -->
          <div style="margin-top:14px; display:flex; gap:8px; justify-content:space-between; align-items:center; flex-wrap:wrap;">
            <button type="button" id="scopeClearAllBtn" class="btn btn-danger" style="padding:10px 18px;">Clear all scopes</button>
            <span style="font-size:12px; color:var(--color-text-secondary);">Scope changes save with the <strong>Save</strong> button at the top.</span>
          </div>
        </div>

        <!-- Reference Media Section (admin only — public quote form is images-only) -->
        <div class="form-section">
          <div class="form-section-header">
            <h3 class="form-section-title">Reference Media</h3>
            <span id="pdfStarHint" style="font-size:12px; color:var(--color-text-secondary); margin-left:auto; margin-right:12px;">No images starred → all show in the PDF</span>
            <div class="image-upload-controls">
              <input type="file" id="imageInput" accept="image/jpeg,image/png,image/webp,image/heic,video/mp4,video/quicktime,video/webm" multiple hidden />
              <button type="button" class="btn-sm btn-secondary" id="btnAddImage">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                  <polyline points="17 8 12 3 7 8"/>
                  <line x1="12" y1="3" x2="12" y2="15"/>
                </svg>
                Add Media
              </button>
              <span class="image-count" id="imageCount">0/100</span>
            </div>
          </div>
          <div class="upload-progress-bar" id="uploadProgress" style="display: none;">
            <div class="upload-progress-text" id="uploadProgressText">Uploading...</div>
            <div class="upload-progress-track">
              <div class="upload-progress-fill" id="uploadProgressFill"></div>
            </div>
          </div>
          <div id="qrefBulkBar" style="display:none; align-items:center; gap:8px; flex-wrap:wrap; margin-bottom:10px; padding:8px 12px; background:rgba(99,102,241,0.12); border:1px solid rgba(99,102,241,0.35); border-radius:var(--radius-md);">
            <span id="qrefBulkCount" style="font-size:13px; font-weight:700; color:#c7d2fe;">0 selected</span>
            <span style="flex:1; min-width:8px;"></span>
            <button type="button" onclick="qrefBulkDelete()" style="padding:6px 12px; background:rgba(239,68,68,0.15); border:1px solid rgba(239,68,68,0.45); border-radius:var(--radius-md); color:#fca5a5; font-size:12px; font-weight:600; cursor:pointer;">Delete</button>
            <button type="button" onclick="qrefClearSelect()" style="padding:6px 12px; background:rgba(148,163,184,0.12); border:1px solid rgba(148,163,184,0.35); border-radius:var(--radius-md); color:#cbd5e1; font-size:12px; font-weight:600; cursor:pointer;">Clear</button>
          </div>
          <div class="images-grid" id="imagesGrid">
            <!-- Media items rendered here -->
          </div>
          <div class="images-empty" id="imagesEmpty" style="display: none;">
            No media attached to this quote
          </div>
        </div>

        <!-- Internal Notes Section -->
        <div class="form-section">
          <h3 class="form-section-title">Internal Notes (not visible to customer)</h3>
          <div class="form-row single">
            <div class="form-group">
              <textarea class="form-input form-textarea" id="inputNotes" placeholder="Add notes..."></textarea>
            </div>
          </div>
        </div>

        </div><!-- /tabDetails -->

        <!-- Messages Tab -->
        <div class="tab-content" id="tabMessages">
          <div class="messages-compose">
            <div class="compose-row">
              <label for="msgSubject">Subject</label>
              <input type="text" id="msgSubject" class="form-input" placeholder="Message from MannyKnows" />
            </div>
            <div class="compose-row">
              <label for="msgBody">Message</label>
              <textarea id="msgBody" class="form-input form-textarea" placeholder="Type your message to the customer..."></textarea>
            </div>
            <input type="file" id="quoteAttachInput" accept="image/*,video/*,application/pdf" multiple style="display:none;" />
            <div id="quoteAttachList" style="display:flex;flex-wrap:wrap;gap:8px;margin-bottom:4px;"></div>
            <div class="compose-actions">
              <button type="button" class="btn btn-secondary" style="font-size:12px;padding:5px 12px;" id="btnQuoteAttach">
