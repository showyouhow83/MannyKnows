    // Best-effort device label from a User-Agent string ("Chrome on macOS").
    function deviceFromUA(ua: string): string {
      if (!ua) return 'Unknown device';
      let os = 'Unknown OS', br = 'Unknown browser';
      if (/iphone|ipad|ipod/i.test(ua)) os = 'iPhone/iPad (iOS)';
      else if (/android/i.test(ua)) os = 'Android';
      else if (/mac os x|macintosh/i.test(ua)) os = 'macOS';
      else if (/windows/i.test(ua)) os = 'Windows';
      else if (/linux/i.test(ua)) os = 'Linux';
      if (/edg\//i.test(ua)) br = 'Edge';
      else if (/crios/i.test(ua)) br = 'Chrome';
      else if (/chrome/i.test(ua)) br = 'Chrome';
      else if (/fxios|firefox/i.test(ua)) br = 'Firefox';
      else if (/safari/i.test(ua)) br = 'Safari';
      return `${br} on ${os}`;
    }

    // SQLite CURRENT_TIMESTAMP is UTC ("YYYY-MM-DD HH:MM:SS"). Render in local.
    function fmtAuditTime(ts: string): string {
      if (!ts) return '—';
      try {
        const iso = ts.includes('T') ? ts : ts.replace(' ', 'T');
        const d = new Date(iso + (/[zZ]|[+-]\d\d:?\d\d$/.test(iso) ? '' : 'Z'));
        if (isNaN(d.getTime())) return ts;
        return d.toLocaleString('en-US', { dateStyle: 'medium', timeStyle: 'short' });
      } catch { return ts; }
    }

