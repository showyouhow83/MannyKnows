    (window as any).acceptDecline = acceptDecline;

    // Renegotiate
    async function renegotiate(quoteId: string) {
      try {
        const res = await fetch('/api/quotes/renegotiate/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'include',
          body: JSON.stringify({ quote_id: parseInt(quoteId) }),
        });
        const result: any = await res.json();
        if (result.success) {
          showToast('Quote moved to renegotiation');
          setTimeout(() => location.reload(), 1000);
        } else {
          showToast(result.error || 'Failed', 'error');
        }
      } catch (err) {
        showToast('Error: ' + (err instanceof Error ? err.message : 'Unknown error'), 'error');
      }
    }
    (window as any).renegotiate = renegotiate;

    // Promote accepted quote to project
    let pendingPromoteQuoteId: string | null = null;
    let pendingPromoteQuoteData: QuoteData | null = null;
    let pendingPromoteFromDraft = false; // Flag for direct promotion from draft

    function promoteToProject(quoteId: string) {
      // Find the quote data from the cards
      const card = document.querySelector(`.quote-card[data-quote-id="${quoteId}"]`) as HTMLElement | null;
      if (!card) {
        showToast('Quote not found', 'error');
        return;
      }

      pendingPromoteQuoteId = quoteId;
      pendingPromoteQuoteData = JSON.parse(card.dataset.quote || '{}');
      pendingPromoteFromDraft = false; // This is from sidebar, not from draft

      // Check if this was customer-approved
      const isCustomerApproved = (pendingPromoteQuoteData as any)?.promoted_by === 'customer';
      const notifyContainer = document.getElementById('notifyCheckboxContainer');
      const promoteText = document.getElementById('promoteModalText');

      if (isCustomerApproved) {
        if (notifyContainer) notifyContainer.style.display = 'block';
        if (promoteText) promoteText.textContent = `Promote "${pendingPromoteQuoteData?.customer_name}" to a project. This quote was approved by the customer.`;
        const checkbox = document.getElementById('sendNotificationCheckbox') as HTMLInputElement | null;
        if (checkbox) checkbox.checked = true;
      } else {
        if (notifyContainer) notifyContainer.style.display = 'none';
        if (promoteText) promoteText.textContent = `Promote "${pendingPromoteQuoteData?.customer_name}" to a project.`;
      }

      document.getElementById('promoteModal')?.classList.add('active');
    }
    (window as any).promoteToProject = promoteToProject;

    // Handle promote confirmation
    document.getElementById('confirmPromoteBtn')?.addEventListener('click', async () => {
      if (!pendingPromoteQuoteId) return;

      const checkbox = document.getElementById('sendNotificationCheckbox') as HTMLInputElement | null;
      const sendNotification = checkbox?.checked || false;
      closeModal('promoteModal');

      try {
        // If promoting from draft, save the quote first — but DO NOT change its
        // status here. Pre-marking it 'accepted' orphaned quotes in "Ready to
        // Promote" whenever project creation below failed; sending 'draft'
        // could trip the renegotiation flag on a declined quote. Sending NO
        // status leaves it untouched — the projects POST flips it to 'project'
        // atomically on success, and on failure it stays exactly where it was.
        // ALSO pre-save when the promoted quote is the one open in the editor:
        // the sidebar's Promote button used to snapshot stored data, silently
        // dropping unsaved edits (a typed-but-unsaved discount vanished on
        // promotion — Manny hit this on BXQZ, and before that on VLH).
        if (pendingPromoteFromDraft || String(pendingPromoteQuoteId) === String(selectedQuoteId)) {
          const data = collectFormData() as any;
          delete data.status;
          delete data.promoted_by;

          const saveRes = await fetch('/api/quotes/', {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'include',
            body: JSON.stringify(data),
          });

          const saveResult: any = await saveRes.json();

          if (!saveResult.success) {
            showToast(saveResult.error || 'Failed to save quote', 'error');
            pendingPromoteQuoteId = null;
            pendingPromoteQuoteData = null;
            pendingPromoteFromDraft = false;
            return;
          }
        }

        // Create the project
        const response = await fetch('/api/projects/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'include',
          body: JSON.stringify({
            quote_id: parseInt(pendingPromoteQuoteId || '0'),
            send_notification: sendNotification
          })
        });

        const result: any = await response.json();

        if (result.success) {
          showToast('Quote promoted to project!');
          setTimeout(() => window.location.href = '/admin/projects', 1000);
        } else {
          showToast(result.error || 'Failed to promote', 'error');
        }
      } catch (err) {
        const errorMessage = err instanceof Error ? err.message : 'Unknown error';
        showToast('Error: ' + errorMessage, 'error');
      }

      pendingPromoteQuoteId = null;
      pendingPromoteQuoteData = null;
      pendingPromoteFromDraft = false;
    });

    // Modal helpers
