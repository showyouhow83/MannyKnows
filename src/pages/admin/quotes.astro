    // Collect form data
    function collectFormData() {
      // Collect services from the vertical list (array of {type, scope}).
      const services: ServiceRow[] = [];
      document.querySelectorAll('#servicesList .service-row').forEach(row => {
        const typeInput = row.querySelector('[data-field="type"]') as HTMLSelectElement | null;
        const scopeInput = row.querySelector('[data-field="scope"]') as HTMLTextAreaElement | null;
        const customInput = row.querySelector('[data-field="type_custom"]') as HTMLInputElement | null;
        let type = typeInput?.value || '';
        // "Other" → store the typed custom service as the type itself.
        if (type === 'other') type = (customInput?.value || '').trim() || '';
        const scope = scopeInput?.value || '';
        if (type) {
          services.push({ type, scope });
        }
      });

      // Derive a top-level scope_description from the per-service scopes so
      // the Project view's "Services & Scope" section always has a Scope row.
      // If there's only one service, use its scope verbatim. Multiple services
      // get prefixed with their type label so the customer can see what's what.
      const serviceTypeLabels: Record<string, string> = {
        'website-basic': 'Get Found',
        'website-plus': 'Get Booked',
        'website-smart': 'Get Growing',
        'ecommerce': 'Sell Online',
        'business-ads': 'Business Ads',
        'multimedia-agency': 'Multimedia Agency',
        'ai-team': 'AI Team',
        'custom-app': 'Custom Web App',
        '360-photo': 'Free 360° Photo',
        'website-analysis': 'Free AI Website Analysis',
      };
      const derivedScopeParts = services
        .filter(s => (s.scope || '').trim())
        .map((s, _i, arr) => {
          const label = serviceTypeLabels[s.type] || s.type;
          return arr.length > 1 ? `${label}: ${s.scope.trim()}` : s.scope.trim();
        });
      const derivedScopeDescription = derivedScopeParts.join('\n\n') || null;

      const notesTextarea = document.getElementById('inputNotes') as HTMLTextAreaElement | null;
      const notesText = notesTextarea?.value || '';
      const notes = notesText ? [{ date: new Date().toISOString(), note: notesText }] : [];

      return {
        quote_id: parseInt(selectedQuoteId || '0'),
        customer_name: (document.getElementById('inputName') as HTMLInputElement)?.value || '',
        customer_email: (document.getElementById('inputEmail') as HTMLInputElement)?.value || '',
        customer_phone: (document.getElementById('inputPhone') as HTMLInputElement)?.value || '',
        address: (document.getElementById('inputAddress') as HTMLInputElement)?.value || '',
        city: (document.getElementById('inputCity') as HTMLInputElement)?.value || '',
        state: (document.getElementById('inputState') as HTMLInputElement)?.value || '',
        zip: (document.getElementById('inputZip') as HTMLInputElement)?.value || '',
        services,
        scope_description: derivedScopeDescription, // auto-derived from services[].scope so the project view always has a Scope row
        preferred_date: (document.getElementById('inputPreferredDate') as HTMLInputElement)?.value || null,
        preferred_time: (document.getElementById('inputPreferredTime') as unknown as HTMLSelectElement)?.value || null,
        discount: parseFloat((document.getElementById('inputDiscount') as HTMLInputElement)?.value || '0') || 0,
        require_signature: (document.getElementById('inputRequireSig') as HTMLInputElement)?.checked ? 1 : 0,
        notes,
      };
    }

    // Save quote function
    async function saveQuote(force?: boolean) {
      if (!selectedQuoteId) return;

      const btn = document.getElementById('btnSave') as HTMLButtonElement;
      const origText = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="animation:spin 1s linear infinite"><path d="M12 2v4m0 12v4m-7.07-3.93l2.83-2.83m8.48-8.48l2.83-2.83M2 12h4m12 0h4m-3.93 7.07l-2.83-2.83M7.76 7.76L4.93 4.93"/></svg> Saving...';

      const data = collectFormData() as any;
      // Single save = quote fields + scopes. The scope editor's state is
      // sent here so there's no separate "Save scopes" button. The page
      // reloads on success, so local scope-state sync isn't needed.
      data.template_sections = scopesState;
      // Optimistic-lock token: the version we loaded. If the row changed since,
      // the server returns 409 and we OFFER "Save anyway" (force) rather than
      // blocking — a long edit must never be lost to a background bump (cron,
      // contact backfill, a second tab, etc.). force=true omits the token.
      data.expected_updated_at = force ? null : ((selectedQuoteData as any)?.updated_at || null);
      // The server blocks an empty scope payload from wiping real scope data
      // (guards against a blank-seed save race). An empty ARRAY only happens
      // via the explicit "Clear all scopes" action, so allow that through.
      if (Array.isArray(scopesState) && scopesState.length === 0) {
        data.allow_empty_scopes = true;
      }

      try {
        const res = await fetch('/api/quotes/', {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'include',
          body: JSON.stringify(data),
        });

        const result: any = await res.json();

        if (result.success) {
          setScopeDirty(false);
          showToast('Quote saved successfully');
          // Reload to pull fresh SSR data, but reopen the SAME quote so the
          // admin isn't bounced back to an empty list after every save.
          setTimeout(() => { location.href = location.pathname + '?open=' + selectedQuoteId; }, 900);
        } else if (res.status === 409 || result.conflict) {
          // Changed since we opened it (another window, or a background update
          // like the follow-up cron / contact backfill). Don't lose the edit —
          // offer to save anyway. Cancel keeps the form open so nothing is lost.
          btn.disabled = false;
          btn.innerHTML = origText;
          showConfirmModal({
            title: 'This quote changed in another window',
            message: 'It was updated since you opened it (another tab, or an automatic background update). Save your changes anyway? This will overwrite the other version.',
            confirmText: 'Save anyway',
            confirmClass: 'btn-success',
            onConfirm: () => saveQuote(true),
          });
        } else {
          showToast(result.error || 'Failed to save', 'error');
          btn.disabled = false;
          btn.innerHTML = origText;
        }
      } catch (err) {
        showToast('Error: ' + (err instanceof Error ? err.message : 'Unknown error'), 'error');
        btn.disabled = false;
        btn.innerHTML = origText;
      }
    }

    document.getElementById('btnSave')?.addEventListener('click', () => saveQuote());
    document.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key === 's') {
        e.preventDefault();
        if (selectedQuoteId !== null) saveQuote();
      }
    });

    // Auto-generate the quote PDF before sending if the admin hasn't attached
    // one yet. We embed /admin/quotes/{id}/preview/?autosave=1 in a hidden
    // iframe; the preview page runs its html2pdf flow on load and posts a
    // message back when the PDF has been uploaded to R2. Resolves with the
    // attachment record (or null if a same-origin error swallowed it), or
    // rejects with the error message from the iframe.
    function autoGenerateQuotePdf(quoteId: string): Promise<any> {
      return new Promise((resolve, reject) => {
        const iframe = document.createElement('iframe');
        iframe.src = `/admin/quotes/${quoteId}/preview/?autosave=1`;
        iframe.setAttribute('aria-hidden', 'true');
        // Keep the iframe rendered (html2canvas requires layout) but invisible.
        iframe.style.cssText = 'position:fixed; left:-9999px; top:0; width:900px; height:1400px; border:0; opacity:0; pointer-events:none;';
        let settled = false;
        const cleanup = () => {
          window.removeEventListener('message', onMessage);
          if (iframe.parentNode) iframe.parentNode.removeChild(iframe);
        };
        const onMessage = (e: MessageEvent) => {
          if (e.source !== iframe.contentWindow) return;
          const d = e.data as any;
          if (!d || typeof d !== 'object') return;
          if (d.type === 'sl-pdf-saved' && d.quoteId === Number(quoteId)) {
            settled = true; cleanup(); resolve(d.attachment || null);
          } else if (d.type === 'sl-pdf-failed' && d.quoteId === Number(quoteId)) {
            settled = true; cleanup(); reject(new Error(d.error || 'PDF generation failed'));
          }
        };
        window.addEventListener('message', onMessage);
        // Fail-safe timeout: html2pdf rarely takes >20s; cap at 60s so a
        // broken preview page doesn't leave the admin staring forever.
        setTimeout(() => {
          if (!settled) { cleanup(); reject(new Error('PDF generation timed out')); }
        }, 60000);
        document.body.appendChild(iframe);
      });
    }


    // Send to customer — confirmation goes through the in-app modal (matches
    // the rest of the admin's styling) instead of the native browser confirm.
    // Before the email fires, we make sure the quote has at least one PDF
    // attached. If not, we silently auto-generate one so the customer always
    // gets a downloadable PDF in their email.
    document.getElementById('btnSend')?.addEventListener('click', () => {
      if (!selectedQuoteId) return;

      const data = collectFormData() as any;
      data.status = 'sent';

      const recipient = (data.customer_email || '').trim();
      const customerName = (data.customer_name || '').trim() || 'the customer';
      const hasEmail = !!recipient;
      const message = hasEmail
        ? `Send this quote to ${customerName} at ${recipient}? They'll receive an email immediately and can accept or decline from the link.`
        : `No customer email is on file, so the send will fail. Add the email first if you want delivery.`;

      showConfirmModal({
        title: hasEmail ? 'Send quote to customer?' : 'Missing email',
        message,
        confirmText: hasEmail ? 'Send' : 'Send anyway',
        confirmClass: hasEmail ? 'btn-success' : 'btn-danger',
        onConfirm: async () => {
          const sendBtn = document.getElementById('btnSend') as HTMLButtonElement | null;
          const origText = sendBtn?.innerHTML;
          const quoteIdForSend = selectedQuoteId;
          if (!quoteIdForSend) return;
          try {
            // Step 1: (re)generate the Estimate PDF if it's missing OR stale.
            // Stale = the quote was edited after the current Estimate PDF was
            // made (e.g. a renegotiation added a discount). Without this, the
            // customer's accept page keeps showing the old, pre-discount PDF.
            // Both timestamps are same-format SQLite UTC strings, so a string
            // compare is safe. autoGenerateQuotePdf replaces the prior "Estimate"
            // by label, so regenerating never creates duplicates.
            const estimateAtt = (currentAttachments || []).find(a => /estimate/i.test(a.label || '') && !/signed/i.test(a.label || ''));
            const qUpdated = (selectedQuoteData as any)?.updated_at || '';
            const estUploaded = (estimateAtt as any)?.uploaded_at || '';
            const estStale = !!(estimateAtt && qUpdated && estUploaded && String(qUpdated) > String(estUploaded));
            if (!currentAttachments || currentAttachments.length === 0 || !estimateAtt || estStale) {
              if (sendBtn) {
                sendBtn.disabled = true;
                sendBtn.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="animation:spin 1s linear infinite;"><path d="M12 2v4m0 12v4m-7.07-3.93l2.83-2.83m8.48-8.48l2.83-2.83M2 12h4m12 0h4m-3.93 7.07l-2.83-2.83M7.76 7.76L4.93 4.93"/></svg> Generating PDF…';
              }
              try {
                await autoGenerateQuotePdf(quoteIdForSend);
                await loadAttachments(); // resync so the stale copy isn't kept locally
              } catch (pdfErr) {
                showToast('Could not auto-generate PDF: ' + (pdfErr instanceof Error ? pdfErr.message : 'unknown error'), 'error');
                if (sendBtn) { sendBtn.disabled = false; if (origText) sendBtn.innerHTML = origText; }
                return;
              }
              if (sendBtn) sendBtn.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg> Sending…';
            }

            // Step 2: fire the PATCH that flips status=sent → triggers email.
            const res = await fetch('/api/quotes/', {
              method: 'PATCH',
              headers: { 'Content-Type': 'application/json' },
              credentials: 'include',
              body: JSON.stringify(data),
            });
            const result: any = await res.json();
            // The API returns success: true for the DB write even when the
            // Resend email failed — surface both states so the admin sees
            // when a quote was saved but the email didn't actually go out.
            if (result.success && result.emailSent !== false) {
              showToast('Quote sent to customer');
              setTimeout(() => location.reload(), 1000);
            } else if (result.success && result.emailSent === false) {
              if (sendBtn) { sendBtn.disabled = false; if (origText) sendBtn.innerHTML = origText; }
              showToast('Quote saved but email failed: ' + (result.message || 'unknown error'), 'error');
            } else {
              if (sendBtn) { sendBtn.disabled = false; if (origText) sendBtn.innerHTML = origText; }
              showToast(result.error || 'Failed to send', 'error');
            }
          } catch (err) {
            if (sendBtn) { sendBtn.disabled = false; if (origText) sendBtn.innerHTML = origText; }
            showToast('Error: ' + (err instanceof Error ? err.message : 'Unknown error'), 'error');
          }
        },
      });
    });

    // Promote directly to project (for verbal/in-person sales)
