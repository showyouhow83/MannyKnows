  <!-- MK Footer -->
  <footer class="admin-footer">
    by <a href="https://mannyknows.com" class="footer-link" target="_blank" rel="noopener">MK <span class="rocket-emoji">🚀</span></a>
  </footer>

  <script>
    import { SERVICE_TYPES as SVC_TYPES, isKnownService as isKnownSvc } from '../../data/serviceTypes';

    // Show/hide a custom-service text input when "Other" is chosen (New Quote
    // modal). The typed value becomes the stored service_type.
    (window as any).toggleCustomService = function(sel: HTMLSelectElement, customId: string) {
      const inp = document.getElementById(customId) as HTMLInputElement | null;
      if (!inp) return;
      const isOther = sel.value === 'other';
      inp.style.display = isOther ? 'block' : 'none';
      if (!isOther) inp.value = '';
    };

    // Same behavior for a dynamically-built scope row: toggle the sibling
    // custom input within the row.
    (window as any).toggleRowCustomService = function(sel: HTMLSelectElement) {
      const row = sel.closest('.service-row');
      const inp = row?.querySelector('.service-custom-input') as HTMLInputElement | null;
      if (!inp) return;
      const isOther = sel.value === 'other';
      inp.style.display = isOther ? 'block' : 'none';
      if (!isOther) inp.value = '';
    };

    // TypeScript type declarations for DOM and window extensions
    interface QuoteData {
      quote_number?: string;
      quote_token?: string;
      customer_name?: string;
      customer_email?: string;
      customer_phone?: string;
      address?: string;
      city?: string;
      state?: string;
      zip?: string;
      services?: string;
      scope_description?: string;
      estimated_start?: string;
      estimated_end?: string;
      estimated_duration?: string;
      preferred_date?: string;
      preferred_time?: string;
      materials?: string;
      labor?: string;
      discount?: number;
      notes?: string;
      project_images?: string;
      contract_url?: string;
      status?: string;
      is_renegotiation?: number;
      follow_up_count?: number;
      last_follow_up_at?: string;
    }

    interface ServiceRow {
      type: string;
      scope: string;
    }

    let selectedQuoteId: string | null = null;
    let selectedQuoteData: QuoteData | null = null;

    // Select all clickable quote cards
    const allCards = document.querySelectorAll<HTMLElement>('.quote-card');
    const contentPlaceholder = document.getElementById('contentPlaceholder');
    const quoteForm = document.getElementById('quoteForm');

    allCards.forEach(card => {
      card.addEventListener('click', () => {
        // Remove selection from all
        allCards.forEach(c => c.classList.remove('selected'));
        card.classList.add('selected');

        // Get quote data
        selectedQuoteId = card.dataset.quoteId || null;
        selectedQuoteData = JSON.parse(card.dataset.quote || '{}');
        // Presence: announce which quote this admin is now viewing/editing.
        if (selectedQuoteId) (window as any).setPresenceRecord?.('quote', selectedQuoteId);

        // Show form
        if (contentPlaceholder) contentPlaceholder.style.display = 'none';
        if (quoteForm) quoteForm.classList.add('visible');

        // On mobile, show the detail view
        showMobileDetail();

        // Populate form
        if (selectedQuoteData) populateForm(selectedQuoteData);

        // Reset to Details tab and preload message count
        resetToDetailsTab();
        if (selectedQuoteId) loadMessages(selectedQuoteId);
        if (typeof (window as any).initQuoteMsgCompose === 'function') (window as any).initQuoteMsgCompose();
        // Scope is inlined into Details now, so load it whenever a quote opens.
        if (selectedQuoteId) loadScopeTab();
        // Mobile-only: collapse sidebar-like form sections into an accordion +
        // show the floating Preview PDF FAB.
        initQuoteSectionAccordions();
        updatePreviewFab();
      });
    });

    // Close detail — back to the index/placeholder without touching the nav.
    // Opening a card auto-collapses the list, so closing must expand it back
    // or the page is left showing only the empty placeholder.
    document.getElementById('btnCloseDetail')?.addEventListener('click', () => {
      allCards.forEach(c => c.classList.remove('selected'));
      if (quoteForm) quoteForm.classList.remove('visible');
      if (contentPlaceholder) contentPlaceholder.style.display = '';
      document.querySelector('.admin-main')?.classList.remove('list-collapsed');
      const listToggle = document.getElementById('listToggleBtn');
      if (listToggle) listToggle.textContent = '‹';
      hideMobileDetail();
    });

    // Search functionality
    const searchInput = document.getElementById('searchInput') as HTMLInputElement | null;
    const noResults = document.getElementById('noResults');

    searchInput?.addEventListener('input', () => {
      const query = (searchInput as HTMLInputElement).value.toLowerCase().trim();
      let visibleCount = 0;

      allCards.forEach(card => {
        const searchData = card.getAttribute('data-search') || '';
        const matches = query === '' || searchData.includes(query);
        card.classList.toggle('hidden', !matches);
        if (matches) visibleCount++;
      });

      noResults?.classList.toggle('visible', visibleCount === 0 && query !== '');

      // On mobile: auto-expand sections that have search matches
      if (query && window.innerWidth <= 768) {
        document.querySelectorAll<HTMLElement>('.section-body').forEach(body => {
          const hasVisibleCards = body.querySelector('.quote-card:not(.hidden)');
          if (hasVisibleCards) {
            body.classList.remove('collapsed-mobile');
            body.previousElementSibling?.classList.remove('collapsed');
          }
        });
      }
    });

    // Mobile section toggle (accordion - only one open at a time)
    document.querySelectorAll<HTMLElement>('.section-toggle').forEach(header => {
      header.addEventListener('click', () => {
        const sectionName = header.dataset.section;
        const body = document.getElementById('section' + sectionName!.charAt(0).toUpperCase() + sectionName!.slice(1));
        if (!body) return;

        // Desktop: only allow toggling the Cold section
        if (window.innerWidth > 768) {
          if (sectionName === 'cold') {
            body.classList.toggle('collapsed');
            header.classList.toggle('collapsed');
          }
          return;
        }

        const isCollapsed = body.classList.contains('collapsed-mobile');

        // Check if currently selected card is in a section being collapsed
        const selectedCard = document.querySelector('.quote-card.selected') as HTMLElement | null;

        if (isCollapsed) {
          // Collapse all other sections first
          document.querySelectorAll<HTMLElement>('.section-body').forEach(b => b.classList.add('collapsed-mobile'));
          document.querySelectorAll<HTMLElement>('.section-toggle').forEach(h => h.classList.add('collapsed'));
          // Expand this one
          body.classList.remove('collapsed-mobile');
          header.classList.remove('collapsed');
        } else {
          // Collapse this section
          body.classList.add('collapsed-mobile');
          header.classList.add('collapsed');
        }

        // If the selected card is now inside a collapsed section, clear the detail
        if (selectedCard) {
          const parentBody = selectedCard.closest('.section-body');
          if (parentBody && parentBody.classList.contains('collapsed-mobile')) {
            allCards.forEach(c => c.classList.remove('selected'));
            if (quoteForm) quoteForm.classList.remove('visible');
            if (contentPlaceholder) contentPlaceholder.style.display = 'flex';
            hideMobileDetail();
          }
        }
      });
    });

    function updateQuotePartnerBadge() {
      const sel = document.getElementById('quotePartnerSelect') as HTMLSelectElement | null;
      const badge = document.getElementById('quotePartnerBadge');
      if (!sel || !badge) return;
      if (sel.value) {
        badge.textContent = 'White-labeled: ' + (sel.options[sel.selectedIndex]?.text || 'Partner');
        badge.style.background = 'rgba(245,158,11,0.15)'; badge.style.color = '#fbbf24';
      } else {
        badge.textContent = 'Internal (MannyKnows)';
        badge.style.background = 'rgba(148,163,184,0.15)'; badge.style.color = '#a1a1aa';
      }
    }
    (window as any).updateQuotePartnerBadge = updateQuotePartnerBadge;

    async function saveQuotePartner() {
      const sel = document.getElementById('quotePartnerSelect') as HTMLSelectElement | null;
      if (!sel || !selectedQuoteId) { showToast('Open a quote first', 'error'); return; }
      const partnerId = sel.value ? parseInt(sel.value) : null;
      try {
        const res = await fetch('/api/quotes/', {
          method: 'PATCH', credentials: 'include',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ quote_id: parseInt(String(selectedQuoteId)), partner_id: partnerId }),
        });
        const data = await res.json() as any;
        if (!data.success) { showToast(data.error || 'Failed to update', 'error'); return; }
        updateQuotePartnerBadge();
        showToast(partnerId ? ('Now representing ' + (sel.options[sel.selectedIndex]?.text || 'partner')) : 'Back to internal (MannyKnows)', 'success');
      } catch (e) { showToast('Failed to update', 'error'); }
    }
    (window as any).saveQuotePartner = saveQuotePartner;

    function populateForm(quote: QuoteData) {
      const formQuoteNumber = document.getElementById('formQuoteNumber');
      const formCustomerName = document.getElementById('formCustomerName');
      if (formQuoteNumber) {
        var qn = quote.quote_number || '';
        formQuoteNumber.textContent = qn ? ('#' + qn.slice(-4)) : 'N/A';
        formQuoteNumber.title = qn;  // full number on hover
      }
      if (formCustomerName) formCustomerName.textContent = quote.customer_name || 'Unknown';

      // Representing (partner white-label) selector reflects this quote.
      const qpSel = document.getElementById('quotePartnerSelect') as HTMLSelectElement | null;
      if (qpSel) {
        qpSel.value = (quote as any).partner_id ? String((quote as any).partner_id) : '';
        updateQuotePartnerBadge();
      }

      // Show quote review URL section if quote has been sent (has a token)
      // Show quote link only for non-draft quotes (must have been sent at least once)
      const reviewSection = document.getElementById('quoteReviewSection');
      const reviewUrlEl = document.getElementById('quoteReviewUrl') as HTMLAnchorElement;
      const qs = quote.status as string;
      const hasSentLink = quote.quote_token && qs !== 'draft';
      if (reviewSection && reviewUrlEl && hasSentLink) {
        const url = `https://mannyknows.com/quote/${quote.quote_token}`;
        reviewUrlEl.href = url;
        reviewUrlEl.textContent = `mannyknows.com/quote/${quote.quote_token}`;
        reviewSection.style.display = '';
      } else if (reviewSection) {
        reviewSection.style.display = 'none';
      }

      // Show "Mark as Declined" section for draft/sent/cold quotes
      const declineSection = document.getElementById('declineSection');
      if (declineSection) {
        const qs = quote.status as string;
        const canDecline = qs === 'draft' || qs === 'sent' || qs === 'cold';
        declineSection.style.display = canDecline ? '' : 'none';
      }

      (document.getElementById('inputName') as HTMLInputElement).value = quote.customer_name || '';
      (document.getElementById('inputEmail') as HTMLInputElement).value = quote.customer_email || '';
      (document.getElementById('inputPhone') as HTMLInputElement).value = quote.customer_phone || '';
      (document.getElementById('inputAddress') as HTMLInputElement).value = quote.address || '';
      (document.getElementById('inputCity') as HTMLInputElement).value = quote.city || '';
      (document.getElementById('inputState') as HTMLInputElement).value = quote.state || '';
      (document.getElementById('inputZip') as HTMLInputElement).value = quote.zip || '';

      // Appointment Scheduler
      (document.getElementById('inputPreferredDate') as HTMLInputElement).value = quote.preferred_date || '';
      (document.getElementById('inputPreferredTime') as unknown as HTMLSelectElement).value = quote.preferred_time || '';

      // Services - now stored as array of {type, scope} objects
      let services: ServiceRow[] = [];
      try {
        const parsed = JSON.parse(quote.services || '[]');
        // Handle legacy format (array of strings) vs new format (array of objects)
        if (parsed.length > 0 && typeof parsed[0] === 'string') {
          // Legacy format: convert to new format with scope from quote.scope_description
          services = parsed.map((type: string, i: number) => ({
            type,
            scope: i === 0 ? (quote.scope_description || '') : ''
          }));
        } else {
          services = parsed;
        }
      } catch {}
      renderServices(services);

      // Quote PDF attachments — fetched async; UI updates when ready
      currentAttachments = [];
      currentAcceptance = null; // clear prior quote's audit before re-render
      renderAttachments();
      void loadAttachments();
      // Acceptance audit (who/when/where/how) for accepted quotes — also tells
      // renderAttachments whether the signed-PDF backfill applies.
      void loadAcceptance();


      // Discount — single source of truth lives inside the Scopes &amp; Pricing card.
      const discountEl = document.getElementById('inputDiscount') as HTMLInputElement | null;
      if (discountEl) discountEl.value = String(quote.discount || 0);

      // Acceptance mode toggle (default Simple = unchecked).
      const reqSigEl = document.getElementById('inputRequireSig') as HTMLInputElement | null;
      if (reqSigEl) reqSigEl.checked = !!(quote as any).require_signature;

      // Notes
      let notes: { note: string }[] = [];
      try { notes = JSON.parse(quote.notes || '[]'); } catch {}
      (document.getElementById('inputNotes') as HTMLTextAreaElement).value = notes.map((n: { note: string }) => n.note).join('\n');

      // Images
      let images = [];
      try { images = JSON.parse(quote.project_images || '[]'); } catch {}
      quoteSelected = new Set();
      updateQuoteBulkBar();
      featuredImages = new Set();
      try {
        const starred = JSON.parse((quote as any).pdf_image_urls || '[]');
        if (Array.isArray(starred)) starred.forEach((u: string) => featuredImages.add(u));
      } catch {}
      renderImages(images);

      // Status badge + action buttons in header
      const btnSend = document.getElementById('btnSend');
      const btnReactivate = document.getElementById('btnReactivate');
      const statusBadge = document.getElementById('quoteStatusBadge');
      const isCold = quote.status === 'cold';
      const isSent = quote.status === 'sent';

      if (btnSend) btnSend.style.display = (isSent || isCold) ? 'none' : '';
      if (btnReactivate) btnReactivate.style.display = isCold ? '' : 'none';
      updateSendButtonState();

      if (statusBadge) {
        const labels: Record<string, string> = {
          draft: 'Draft',
          sent: quote.is_renegotiation ? '⏱ Renegotiation Pending' : '⏱ Pending Approval',
          declined: 'Needs Review',
          accepted: 'Ready to Promote',
          project: 'Promoted to Project',
          cold: '❄️ Cold',
        };
        const status = quote.status as string;
        const label = labels[status] || status;
        statusBadge.textContent = label;
        statusBadge.className = `quote-status-badge ${status === 'cold' ? 'draft' : status}`;
        statusBadge.style.display = '';
      }

      // Follow-up history
      const fuHistory = document.getElementById('followUpHistory');
      const fuContent = document.getElementById('followUpHistoryContent');
      const fuCount = quote.follow_up_count || 0;
      if (fuHistory && fuContent && (fuCount > 0 || isCold)) {
        fuHistory.style.display = '';
        const lines = [];
        if (fuCount >= 1) lines.push(`✉ Follow-up #1 sent${quote.last_follow_up_at && fuCount === 1 ? ' · ' + new Date(quote.last_follow_up_at + 'Z').toLocaleDateString() : ''}`);
        if (fuCount >= 2) lines.push(`✉ Follow-up #2 sent${quote.last_follow_up_at ? ' · ' + new Date(quote.last_follow_up_at + 'Z').toLocaleDateString() : ''}`);
        if (isCold) lines.push('❄️ No response: quote marked cold');
        fuContent.innerHTML = lines.join('<br>');
      } else if (fuHistory) {
        fuHistory.style.display = 'none';
      }
    }

    // Service options for dropdown — shared canonical list.
    const serviceOptions = SVC_TYPES;

    function getServiceOptionsHTML(selectedValue = '') {
      return serviceOptions.map(opt =>
        `<option value="${opt.value}" ${opt.value === selectedValue ? 'selected' : ''}>${opt.label}</option>`
      ).join('');
    }

    // Services list renders as vertical card-style rows: a service-type select
    // above a scope-description textarea, with a remove button on the right.
    // Container is `#servicesList` (was `#servicesBody` table tbody).
    function buildServiceRowHtml(s: { type: string; scope: string }): string {
      // A custom (not-in-list) type means the row was saved via "Other" —
      // select Other and pre-fill the custom input with the stored text.
      const custom = s.type && !isKnownSvc(s.type) && s.type !== 'other';
      const selectValue = custom ? 'other' : s.type;
      return `
        <div class="service-row" style="display:flex; gap:10px; align-items:flex-start; padding:12px; background:rgba(255,255,255,0.03); border:1px solid var(--glass-border); border-radius:var(--radius-md); margin-bottom:10px;">
          <div style="flex:1; display:flex; flex-direction:column; gap:8px; min-width:0;">
            <div>
              <label class="form-label" style="display:block; margin-bottom:4px; font-size:10px; text-transform:uppercase; letter-spacing:0.5px; color:var(--color-text-secondary);">Service Type</label>
              <select class="form-input" data-field="type" onchange="toggleRowCustomService(this)">
                <option value="">Select service...</option>
                ${getServiceOptionsHTML(selectValue)}
              </select>
              <input type="text" class="form-input service-custom-input" data-field="type_custom" placeholder="Enter custom service" style="display:${custom ? 'block' : 'none'}; margin-top:8px;" value="${custom ? escapeHtml(s.type) : ''}" />
            </div>
            <div>
              <label class="form-label" style="display:block; margin-bottom:4px; font-size:10px; text-transform:uppercase; letter-spacing:0.5px; color:var(--color-text-secondary);">Scope Description</label>
              <textarea class="form-input" data-field="scope" placeholder="Describe the work scope..." rows="3" style="resize:vertical;">${escapeHtml(s.scope || '')}</textarea>
            </div>
          </div>
          <button type="button" onclick="removeRow(this)" class="btn-remove" title="Remove this service" style="flex-shrink:0;">×</button>
        </div>
      `;
    }

    function renderServices(services: ServiceRow[]) {
      const list = document.getElementById('servicesList');
      if (!list) return;
      list.innerHTML = services.map((s: ServiceRow) => buildServiceRowHtml(s)).join('');
      if (services.length === 0) addServiceRow();
    }

    function escapeHtml(text: string): string {
      const div = document.createElement('div');
      div.textContent = text;
      return div.innerHTML;
    }

    // Render a message body with URLs as tidy clickable chips. Handles both
    // bare URLs and the `<https://…>` form Gmail uses for Drive-file links.
    function renderMsgLink(href: string): string {
      let host = '';
      try { host = new URL(href).hostname.replace(/^www\./, ''); } catch (_) {}
      const label = host === 'drive.google.com' ? 'Open in Google Drive'
        : host === 'images.mannyknows.com' ? 'View file'
        : host || 'Open link';
      return '<a href="' + escapeHtml(href) + '" target="_blank" rel="noopener" '
        + 'style="display:inline-flex;align-items:center;gap:4px;padding:2px 9px;margin:1px 0;'
        + 'background:rgba(0, 113, 227,0.12);border:1px solid rgba(0, 113, 227,0.3);border-radius:6px;'
        + 'font-size:12px;color:var(--color-primary,#0071e3);text-decoration:none;vertical-align:middle;">'
        + escapeHtml(label) + ' ↗</a>';
    }
    function linkifyBody(raw: string): string {
      let out = '';
      const re = /<?(https?:\/\/[^\s<>]+)>?/g;
      let last = 0;
      let m: RegExpExecArray | null;
      while ((m = re.exec(raw))) {
        out += escapeHtml(raw.slice(last, m.index));
        out += renderMsgLink(m[1]);
        last = re.lastIndex;
      }
      out += escapeHtml(raw.slice(last));
      return out;
    }

    function addServiceRow() {
      const list = document.getElementById('servicesList');
      if (!list) return;
      const wrapper = document.createElement('div');
      wrapper.innerHTML = buildServiceRowHtml({ type: '', scope: '' }).trim();
      const row = wrapper.firstChild as HTMLElement;
      if (row) list.appendChild(row);
    }

    // Image handling
    let currentImages: string[] = [];
    // URLs the admin starred to appear in the customer PDF (empty = show all).
    let featuredImages = new Set<string>();
    // URLs currently multi-selected for bulk delete.
    let quoteSelected = new Set<string>();
    const MAX_IMAGES = 100;

    // Convert full image URL to thumbnail URL using Cloudflare Image Resizing
    function getThumbnailUrl(url: string, size: number = 200): string {
      // Transform: https://images.mannyknows.com/path/to/image.jpg
      // To: https://images.mannyknows.com/cdn-cgi/image/width=200,height=200,fit=cover,quality=80,format=auto/path/to/image.jpg
      try {
        const urlObj = new URL(url);
        // Only use Cloudflare Image Resizing on production (images.mannyknows.com)
        // Localhost and other domains should just return the original URL
        if (urlObj.hostname === 'images.mannyknows.com' && !window.location.hostname.includes('localhost')) {
          const path = urlObj.pathname;
          return `${urlObj.origin}/cdn-cgi/image/width=${size},height=${size},fit=cover,quality=80,format=auto${path}`;
        }
        return url;
      } catch {
        return url; // Fallback to original if URL parsing fails
      }
    }
    // Larger format-auto variant for the lightbox so HEIC (iOS) originals
    // get transcoded — browsers can't render image/heic natively, so the
    // raw R2 URL shows a broken icon in the modal.
    function getDisplayUrl(url: string, maxWidth = 1600): string {
      try {
        const urlObj = new URL(url);
        if (urlObj.hostname === 'images.mannyknows.com' && !window.location.hostname.includes('localhost')) {
          const path = urlObj.pathname;
          return `${urlObj.origin}/cdn-cgi/image/width=${maxWidth},fit=scale-down,quality=85,format=auto${path}`;
        }
        return url;
      } catch {
        return url;
      }
    }

    function renderImages(images: string[]) {
      currentImages = images || [];
      const grid = document.getElementById('imagesGrid');
      const emptyMsg = document.getElementById('imagesEmpty');
      const countSpan = document.getElementById('imageCount');

      if (currentImages.length === 0) {
        if (grid) grid.innerHTML = '';
        if (emptyMsg) emptyMsg.style.display = 'block';
      } else {
        if (emptyMsg) emptyMsg.style.display = 'none';
        if (grid) grid.innerHTML = currentImages.map((url: string, i: number) => {
          const isVideo = /\.(mp4|mov|webm|m4v)(?:\?|$)/i.test(url);
          // Escape the URL for safe inclusion in inline onclick handlers
          const safeUrl = url.replace(/'/g, "\\'");
          const selBox = `<input type="checkbox" class="qref-select"${quoteSelected.has(url) ? ' checked' : ''} onclick="event.stopPropagation();" onchange="toggleQuoteSelect('${safeUrl}', this)" title="Select" style="position:absolute; bottom:6px; right:6px; width:18px; height:18px; z-index:6; cursor:pointer; accent-color:#7c3aed; box-shadow:0 0 0 2px rgba(10, 10, 20,0.55); border-radius:3px;" />`;
          if (isVideo) {
            return `
              <div class="image-thumb is-video" onclick="openLightbox('${safeUrl}', true)" style="background: linear-gradient(135deg, #12121f 0%, #1a1a2e 100%); display:flex; align-items:center; justify-content:center; color:#a1a1aa; position:relative; overflow:hidden;${quoteSelected.has(url) ? ' outline:3px solid #7c3aed; outline-offset:-3px;' : ''}">
                <video src="${safeUrl}#t=0.1" preload="metadata" muted playsinline style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; z-index:0; pointer-events:none;"></video>
                ${selBox}
                <svg width="40" height="40" viewBox="0 0 24 24" fill="white" style="position:relative; z-index:1; filter:drop-shadow(0 1px 4px rgba(0,0,0,0.6));"><polygon points="6 4 20 12 6 20 6 4"/></svg>
                <span class="image-video-badge" style="z-index:2;">Video</span>
                <button type="button" class="image-delete-btn" onclick="event.stopPropagation(); deleteImage('${safeUrl}')" title="Remove video">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
                </button>
              </div>`;
          }
          const annoUrl = `/admin/annotate/?src=${encodeURIComponent(url)}&target=quote&id=${selectedQuoteId}&back=${encodeURIComponent(location.pathname + location.search)}`;
          const starred = featuredImages.has(url);
          return `
            <div class="image-thumb${starred ? ' is-starred' : ''}"${quoteSelected.has(url) ? ' style="outline:3px solid #7c3aed; outline-offset:-3px;"' : ''}>
              ${selBox}
              <img src="${getThumbnailUrl(url, 200)}" alt="Reference media ${i + 1}" onclick="openLightbox('${safeUrl}')" loading="lazy" />
              <button type="button" class="image-star-btn${starred ? ' active' : ''}" onclick="event.stopPropagation(); toggleFeatured('${safeUrl}')" title="${starred ? 'Shown in the customer PDF: click to remove' : 'Show this image in the customer PDF'}">${starred ? '★' : '☆'}</button>
              <a href="${annoUrl}" class="image-anno-btn" title="Annotate (markup, arrows, notes)" onclick="event.stopPropagation();">✎</a>
              <button type="button" class="image-delete-btn" onclick="deleteImage('${safeUrl}')" title="Remove">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
              </button>
            </div>`;
        }).join('');
      }

      if (countSpan) {
        const vids = currentImages.filter((u: string) => /\.(mp4|mov|webm|m4v)(?:\?|$)/i.test(u)).length;
        const imgs = currentImages.length - vids;
        countSpan.textContent = `${imgs} image${imgs === 1 ? '' : 's'} · ${vids} video${vids === 1 ? '' : 's'} (${currentImages.length}/${MAX_IMAGES})`;
      }
      const starCount = currentImages.filter(u => featuredImages.has(u)).length;
      const hint = document.getElementById('pdfStarHint');
      if (hint) hint.textContent = starCount > 0
        ? `${starCount} starred → only these show in the PDF`
        : 'No images starred → all show in the PDF';
    }

    function openLightbox(url: string, isVideo = false) {
      const lightboxImage = document.getElementById('lightboxImage') as HTMLImageElement | null;
      const lightbox = document.getElementById('lightbox');
      if (!lightbox) return;
      if (isVideo) {
        // Replace the lightbox content with a <video> for this view
        const existingVid = lightbox.querySelector('video');
        if (existingVid) existingVid.remove();
        if (lightboxImage) lightboxImage.style.display = 'none';
        const video = document.createElement('video');
        video.src = url;
        video.controls = true;
        video.autoplay = true;
        video.style.maxWidth = '90vw';
        video.style.maxHeight = '85vh';
        video.style.borderRadius = '8px';
        lightbox.appendChild(video);
      } else {
        const existingVid = lightbox.querySelector('video');
        if (existingVid) existingVid.remove();
        if (lightboxImage) {
          lightboxImage.style.display = '';
          lightboxImage.src = getDisplayUrl(url);
        }
      }
      lightbox.classList.add('active');
    }
    (window as any).openLightbox = openLightbox;

    function closeLightbox() {
      document.getElementById('lightbox')?.classList.remove('active');
    }
    (window as any).closeLightbox = closeLightbox;

    async function deleteImage(imageUrl: string) {
      if (!selectedQuoteId) return;

      showConfirmModal({
        title: 'Remove Image?',
        message: 'This image will be removed from the quote.',
        confirmText: 'Remove',
        confirmClass: 'btn-danger',
        onConfirm: async () => {
          try {
            const res = await fetch(`/api/quotes/upload-image/?quote_id=${selectedQuoteId}&image_url=${encodeURIComponent(imageUrl)}`, {
              method: 'DELETE',
              credentials: 'include',
            });

            const result: any = await res.json();

            if (result.success) {
              // Update local array and re-render
              currentImages = currentImages.filter(url => url !== imageUrl);
              renderImages(currentImages);
              showToast('Image removed');
            } else {
              showToast(result.error || 'Failed to remove image', 'error');
            }
          } catch (err) {
            showToast('Error: ' + (err instanceof Error ? err.message : 'Unknown error'), 'error');
          }
        }
      });
    }
    (window as any).deleteImage = deleteImage;

    // ---- Quote Reference Media multi-select (bulk delete) ----
    function updateQuoteBulkBar() {
      const bar = document.getElementById('qrefBulkBar');
      const cnt = document.getElementById('qrefBulkCount');
      if (!bar) return;
      if (quoteSelected.size > 0) {
        bar.style.display = 'flex';
        if (cnt) cnt.textContent = `${quoteSelected.size} selected`;
      } else {
        bar.style.display = 'none';
      }
    }
    function toggleQuoteSelect(url: string, el: HTMLInputElement) {
      if (el.checked) quoteSelected.add(url); else quoteSelected.delete(url);
      const tile = el.closest('.image-thumb') as HTMLElement | null;
      if (tile) {
        tile.style.outline = el.checked ? '3px solid #6366f1' : '';
        tile.style.outlineOffset = el.checked ? '-3px' : '';
      }
      updateQuoteBulkBar();
    }
    function qrefClearSelect() {
      quoteSelected.clear();
      document.querySelectorAll('.qref-select:checked').forEach((c) => {
        (c as HTMLInputElement).checked = false;
        const t = (c as HTMLElement).closest('.image-thumb') as HTMLElement | null;
