      const confirmDeleteBtn = document.getElementById('confirmDeleteBtn');
      if (deleteModalTitle) deleteModalTitle.textContent = 'Delete Permanently?';
      if (deleteModalText) deleteModalText.textContent = 'This will permanently delete both the quote AND the lead. This cannot be undone.';
      if (confirmDeleteBtn) confirmDeleteBtn.onclick = async () => {
