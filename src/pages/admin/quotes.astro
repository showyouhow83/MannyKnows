      }
    });

    mobileNavClose?.addEventListener('click', closeMobileNav);
    mobileNavOverlay?.addEventListener('click', closeMobileNav);

    // Close on escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && mobileNavPanel?.classList.contains('active')) {
        closeMobileNav();
      }
    });

    // =====================================================
    // MOBILE DETAIL VIEW (for 3-column layouts)
    // =====================================================
    function showMobileDetail() {
      const main = document.querySelector('.admin-main');
      main?.classList.add('detail-active');
    }

    function hideMobileDetail() {
      const main = document.querySelector('.admin-main');
      main?.classList.remove('detail-active');
      // Hide the floating Preview PDF FAB when the admin returns to the list.
      const fab = document.getElementById('previewPdfFab');
      fab?.classList.remove('is-visible');
    }
    (window as any).hideMobileDetail = hideMobileDetail;

    // Logout
    async function logout() {
      await fetch('/api/admin/logout/', { method: 'POST' });
      window.location.href = '/admin';
    }
    (window as any).logout = logout;

    // =====================================================
    // NOTIFICATION BELL
    // =====================================================
    // Desktop bell
    const bellBtn = document.getElementById('bellBtn');
    const bellBadge = document.getElementById('bellBadge');
    const bellDropdown = document.getElementById('bellDropdown');
    const bellList = document.getElementById('bellList');
    // Mobile bell
    const bellBtnMobile = document.getElementById('bellBtnMobile');
    const bellBadgeMobile = document.querySelector('.bell-badge-mobile') as HTMLElement | null;
    const bellDropdownMobile = document.getElementById('bellDropdownMobile');
    const bellListMobile = document.getElementById('bellListMobile');

    let bellOpen = false;
    let activeBellDropdown: HTMLElement | null = null;

    function closeBell() {
      bellOpen = false;
      if (bellDropdown) bellDropdown.style.display = 'none';
      if (bellDropdownMobile) bellDropdownMobile.style.display = 'none';
      activeBellDropdown = null;
    }

    [bellBtn, bellBtnMobile].forEach(btn => {
      btn?.addEventListener('click', (e) => {
        e.stopPropagation();
        const dropdown = btn === bellBtn ? bellDropdown : bellDropdownMobile;
        if (bellOpen && activeBellDropdown === dropdown) {
          closeBell();
        } else {
          closeBell();
          bellOpen = true;
          activeBellDropdown = dropdown;
          if (dropdown) dropdown.style.display = 'block';
        }
      });
    });

    document.addEventListener('click', () => { if (bellOpen) closeBell(); });
    bellDropdown?.addEventListener('click', (e) => e.stopPropagation());
    bellDropdownMobile?.addEventListener('click', (e) => e.stopPropagation());

    function renderNotifications(replies: any[], listEl: HTMLElement) {
      listEl.innerHTML = replies.map((r: any) => {
        const dateObj = r.created_at ? new Date(r.created_at + 'Z') : null;
        const timeAgo = dateObj ? getTimeAgo(dateObj) : '';
        const preview = (r.body || '').substring(0, 80) + ((r.body || '').length > 80 ? '...' : '');
        return `
          <div class="bell-notification" data-quote-id="${r.quote_id}">
            <div class="bell-notification-top">
              <span class="bell-notification-name">${escapeHtml(r.customer_name || r.sender_name || 'Customer')}</span>
              <span class="bell-notification-time">${timeAgo}</span>
            </div>
            <div class="bell-notification-body">${escapeHtml(preview)}</div>
            <div class="bell-notification-quote">#${escapeHtml(r.quote_number || '')}</div>
          </div>
        `;
      }).join('');

      // Click notification → navigate to that quote's messages tab
      listEl.querySelectorAll('.bell-notification').forEach(el => {
        el.addEventListener('click', () => {
          const quoteId = (el as HTMLElement).dataset.quoteId;
          if (!quoteId) return;
          const quoteCard = document.querySelector(`.quote-card[data-quote-id="${quoteId}"]`) as HTMLElement;
          if (quoteCard) {
            quoteCard.click();
            setTimeout(() => {
              const msgsTab = document.querySelector('.tab-btn[data-tab="messages"]') as HTMLElement;
              msgsTab?.click();
            }, 200);
          }
          closeBell();
        });
      });
    }

    async function loadNotifications() {
      try {
        const res = await fetch('/api/admin/unread-replies/', { credentials: 'same-origin' });
        const data: any = await res.json();
        if (!data.success || !data.replies?.length) {
          // No unread — clear badges
          [bellBadge, bellBadgeMobile].forEach(badge => {
            if (badge) badge.style.display = 'none';
          });
          [bellBtn, bellBtnMobile].forEach(btn => btn?.classList.remove('has-notifications'));
          if (bellList) bellList.innerHTML = '<div class="bell-dropdown-empty">No new replies</div>';
          if (bellListMobile) bellListMobile.innerHTML = '<div class="bell-dropdown-empty">No new replies</div>';
          return;
        }

        const replies = data.replies;
        // Update both badges
        [bellBadge, bellBadgeMobile].forEach(badge => {
          if (badge) { badge.textContent = String(replies.length); badge.style.display = 'flex'; }
        });
        [bellBtn, bellBtnMobile].forEach(btn => btn?.classList.add('has-notifications'));
        // Render in both dropdowns
        if (bellList) renderNotifications(replies, bellList);
        if (bellListMobile) renderNotifications(replies, bellListMobile);
      } catch (err) {
        console.error('Failed to load notifications:', err);
      }
    }

    function getTimeAgo(date: Date): string {
      const now = new Date();
      const diff = Math.floor((now.getTime() - date.getTime()) / 1000);
      if (diff < 60) return 'just now';
      if (diff < 3600) return `${Math.floor(diff / 60)}m ago`;
      if (diff < 86400) return `${Math.floor(diff / 3600)}h ago`;
      return `${Math.floor(diff / 86400)}d ago`;
    }

    async function markAllRead() {
      try {
        await fetch('/api/admin/unread-replies/', {
          method: 'POST',
          credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ mark_all: true })
        });
        await loadNotifications();
        closeBell();
      } catch (err) {
        console.error('Failed to mark all as read:', err);
      }
    }
    (window as any).markAllRead = markAllRead;

    async function markRepliesRead(quoteId: string) {
      try {
        await fetch('/api/admin/unread-replies/', {
          method: 'POST',
          credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ quote_id: parseInt(quoteId) })
        });
        // Refresh bell after marking read
        loadNotifications();
      } catch (err) {
        console.error('Failed to mark replies as read:', err);
      }
    }

    loadNotifications();

    // Auto-open a specific quote if ?open=QUOTE_ID is in the URL (bell deep link)
    (function() {
      const openId = new URLSearchParams(window.location.search).get('open');
      if (!openId) return;
      window.history.replaceState({}, '', window.location.pathname);
      let tries = 0;
      function tryOpen() {
        const card = document.querySelector(`.quote-card[data-quote-id="${openId}"]`) as HTMLElement | null;
        if (card) {
          card.click();
          // No scrollIntoView — it scrolls the whole page on tablet and pulls
          // the footer up over the content after each save.
        } else if (tries++ < 15) {
          setTimeout(tryOpen, 150);
        }
      }
      // Deferred (never synchronous): a same-tick .click() fires the detail
      // renderer before later script modules have initialized their state,
      // crashing mid-render with a TDZ ReferenceError and leaving the panel
      // (incl. media upload wiring) half-built.
      setTimeout(tryOpen, 0);
    })();

    // =====================================================
    // NEW QUOTE MODAL
    // =====================================================
    const newQuoteModal = document.getElementById('newQuoteModal');
    const newQuoteForm = document.getElementById('newQuoteForm') as HTMLFormElement | null;
    const quoteSourceSelect = document.getElementById('quoteSource') as HTMLSelectElement | null;
    const quoteReferralSourceGroup = document.getElementById('quoteReferralSourceGroup');

    function showNewQuoteModal() {
      newQuoteModal?.classList.add('active');
      // Reset form
      newQuoteForm?.reset();
      if (quoteReferralSourceGroup) quoteReferralSourceGroup.style.display = 'none';
    }
    (window as any).showNewQuoteModal = showNewQuoteModal;

    function hideNewQuoteModal() {
      newQuoteModal?.classList.remove('active');
    }
    (window as any).hideNewQuoteModal = hideNewQuoteModal;

    // Show/hide referral source field based on source selection
    quoteSourceSelect?.addEventListener('change', () => {
      if (quoteReferralSourceGroup) quoteReferralSourceGroup.style.display = quoteSourceSelect.value === 'referral' ? 'block' : 'none';
    });

    // Handle form submission - creates Lead first, then promotes to Quote
    newQuoteForm?.addEventListener('submit', async (e) => {
      e.preventDefault();

      const submitBtn = document.getElementById('submitNewQuote') as HTMLButtonElement | null;
      const originalText = submitBtn?.textContent || 'Create Quote';
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Creating...';
      }

      // Gather form data
      if (!newQuoteForm) return;
      const formData = new FormData(newQuoteForm);
      const leadData = {
        customer_name: formData.get('customer_name'),
        company_name: formData.get('company_name') || undefined,
        customer_email: formData.get('customer_email') || undefined,
        customer_phone: formData.get('customer_phone') || undefined,
        address: formData.get('address') || undefined,
        city: formData.get('city') || undefined,
        zip: formData.get('zip') || undefined,
        service_type: formData.get('service_type') === 'other'
          ? ((formData.get('service_type_custom') || '').toString().trim() || 'other')
          : formData.get('service_type'),
        project_description: formData.get('project_description') || undefined,
        source: formData.get('source'),
        referral_source: formData.get('referral_source') || undefined,
        // Partner set at creation flows Lead → Quote (quote inherits partner_id).
        partner_id: formData.get('partner_id') || undefined
      };

      // Validate at least one contact method
      if (!leadData.customer_email && !leadData.customer_phone) {
        showToast('Please provide at least an email or phone number', 'error');
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = originalText;
        }
        return;
      }

      try {
        // Step 1: Create the Lead first
        const leadResponse = await fetch('/api/admin/leads/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'include',
          body: JSON.stringify(leadData)
        });

        const leadResult: any = await leadResponse.json();

        if (!leadResult.success) {
          showToast(leadResult.error || 'Failed to create lead', 'error');
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = originalText;
          }
          return;
        }

        // Step 2: Promote the Lead to Quote
        const quoteResponse = await fetch('/api/quotes/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'include',
          body: JSON.stringify({ lead_id: leadResult.lead.id })
        });

        const quoteResult: any = await quoteResponse.json();

        if (quoteResult.success) {
          hideNewQuoteModal();
          showToast(`Quote created: ${quoteResult.quote_number}`);
          // Reload page after short delay to show the new quote
          setTimeout(() => location.reload(), 1000);
        } else {
          showToast(quoteResult.error || 'Failed to create quote', 'error');
        }
      } catch (error) {
        showToast('Error: ' + (error instanceof Error ? error.message : 'Unknown error'), 'error');
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = originalText;
        }
      }
    });

    // Check for ?new=1 or ?open=QUOTE_ID parameters
    (function() {
      const urlParams = new URLSearchParams(window.location.search);
      if (urlParams.get('new') === '1') {
        showNewQuoteModal();
        window.history.replaceState({}, '', window.location.pathname);
      } else if (urlParams.get('open')) {
        const openId = urlParams.get('open');
        const card = document.querySelector(`.quote-card[data-quote-id="${openId}"]`) as HTMLElement | null;
        if (card) {
          card.scrollIntoView({ behavior: 'smooth', block: 'center' });
          card.click();
        }
        window.history.replaceState({}, '', window.location.pathname);
      }
    })();

    // ==========================================
    // Tab Navigation & Messaging
    // ==========================================

    const formTabs = document.querySelectorAll<HTMLElement>('.form-tab');
    const tabDetails = document.getElementById('tabDetails');
    const tabMessages = document.getElementById('tabMessages');
    const tabPdfs = document.getElementById('tabPdfs');
    const tabManagement = document.getElementById('tabManagement');
    const messagesBadge = document.getElementById('messagesBadge');
    const messagesContainer = document.getElementById('messagesContainer');

    // ── Quote message attachments ────────────────────────────────────────────
    var _quoteAttachments: any[] = [];

    document.getElementById('btnQuoteAttach')?.addEventListener('click', () => {
      document.getElementById('quoteAttachInput')?.click();
    });

    document.getElementById('quoteAttachInput')?.addEventListener('change', async (event) => {
      const files = Array.from((event.target as HTMLInputElement).files || []);
      if (!files.length) return;
      const list = document.getElementById('quoteAttachList');
      for (const f of files) {
        const idx = _quoteAttachments.length;
        _quoteAttachments.push(null);
        const placeholder = document.createElement('div');
        placeholder.style.cssText = 'display:inline-flex;align-items:center;gap:6px;padding:5px 10px;background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.12);border-radius:8px;font-size:12px;color:var(--color-text-secondary);';
        placeholder.innerHTML = '<span class="spinner-sm"></span> Uploading…';
        if (list) list.appendChild(placeholder);
        const form = new FormData();
        form.append('file', f);
        try {
          const res = await fetch('/api/admin/messages/upload', { method: 'POST', credentials: 'same-origin', body: form });
          const data: any = await res.json();
          if (!data.success) throw new Error(data.error || 'Upload failed');
          const att = { url: data.url, name: data.name, type: data.type, size: data.size };
          _quoteAttachments[idx] = att;
          const isImg = (att.type || '').startsWith('image/');
          const iconSvg = (att.type === 'application/pdf')
            ? '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>'
            : (att.type || '').startsWith('video/')
            ? '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2"/></svg>'
            : '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>';
          const removeBtn = '<button type="button" style="background:none;border:none;cursor:pointer;color:var(--color-text-secondary);padding:0;line-height:1;margin-left:2px;" title="Remove" onclick="removeQuoteAttach(' + idx + ',this.parentNode)">'
            + '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></button>';
          placeholder.innerHTML = (isImg ? '<img src="' + att.url + '" style="width:32px;height:32px;border-radius:4px;object-fit:cover;" />' : iconSvg)
            + '<span style="max-width:120px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">' + escapeHtml(att.name) + '</span>'
            + removeBtn;
        } catch (e) {
          _quoteAttachments[idx] = null;
          placeholder.innerHTML = '<span style="color:#f87171;">Failed: ' + escapeHtml(f.name) + '</span>'
            + '<button type="button" style="background:none;border:none;cursor:pointer;color:var(--color-text-secondary);padding:0;" onclick="this.parentNode.remove()"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></button>';
        }
      }
      (event.target as HTMLInputElement).value = '';
    });

    function removeQuoteAttach(idx: number, el: HTMLElement | null) {
      _quoteAttachments[idx] = null;
      if (el) el.remove();
    }
    (window as any).removeQuoteAttach = removeQuoteAttach;

    const messagesEmpty = document.getElementById('messagesEmpty');
    const btnSendMessage = document.getElementById('btnSendMessage');
    const msgSubject = document.getElementById('msgSubject') as HTMLInputElement;
    const msgBody = document.getElementById('msgBody') as HTMLTextAreaElement;

    // ---- Message draft autosave + default subject + Polish undo ----
    let _quotePrePolish: { subject: string; body: string } | null = null;
    function quoteMsgDraftKey(qid: string) { return 'quoteMsgDraft-' + qid; }
    function defaultQuoteSubject(): string {
      const num = (selectedQuoteData && (selectedQuoteData as any).quote_number) || selectedQuoteId || '';
      return 'MannyKnows Project | #' + num;
    }
    function saveQuoteMsgDraft() {
      if (!selectedQuoteId) return;
      try {
        const body = msgBody?.value || '';
        if (body.trim()) localStorage.setItem(quoteMsgDraftKey(selectedQuoteId), JSON.stringify({ subject: msgSubject?.value || '', body }));
        else localStorage.removeItem(quoteMsgDraftKey(selectedQuoteId));
      } catch {}
    }
    function clearQuoteMsgDraft() { if (selectedQuoteId) { try { localStorage.removeItem(quoteMsgDraftKey(selectedQuoteId)); } catch {} } }
    // Called when a quote opens: set the default subject, then restore any draft.
    function initQuoteMsgCompose() {
      if (msgSubject) msgSubject.value = defaultQuoteSubject();
      if (msgBody) msgBody.value = '';
      _quotePrePolish = null;
      const u = document.getElementById('btnUndoPolish'); if (u) (u as HTMLElement).style.display = 'none';
      if (!selectedQuoteId) return;
      try {
        const raw = localStorage.getItem(quoteMsgDraftKey(selectedQuoteId));
        if (raw) { const d = JSON.parse(raw); if (msgBody && d.body) msgBody.value = d.body; if (msgSubject && d.subject) msgSubject.value = d.subject; }
      } catch {}
    }
    (window as any).initQuoteMsgCompose = initQuoteMsgCompose;
    msgSubject?.addEventListener('input', saveQuoteMsgDraft);
    msgBody?.addEventListener('input', saveQuoteMsgDraft);
    document.getElementById('btnUndoPolish')?.addEventListener('click', () => {
      if (!_quotePrePolish) return;
      if (msgBody) msgBody.value = _quotePrePolish.body;
      if (msgSubject && _quotePrePolish.subject != null) msgSubject.value = _quotePrePolish.subject;
      saveQuoteMsgDraft();
      const u = document.getElementById('btnUndoPolish'); if (u) (u as HTMLElement).style.display = 'none';
      showToast('Reverted to your original message', 'success');
    });

    formTabs.forEach(tab => {
      tab.addEventListener('click', () => {
        formTabs.forEach(t => t.classList.remove('active'));
        tab.classList.add('active');
        const target = tab.dataset.tab;
        if (tabDetails) tabDetails.classList.toggle('active', target === 'details');
        if (tabMessages) tabMessages.classList.toggle('active', target === 'messages');
        if (tabPdfs) tabPdfs.classList.toggle('active', target === 'pdfs');
        if (tabManagement) tabManagement.classList.toggle('active', target === 'management');
        if (target === 'messages' && selectedQuoteId) {
          loadMessages(selectedQuoteId);
          markRepliesRead(selectedQuoteId);
        }
      });
    });

    // Reset to Details tab when selecting a new quote
    function resetToDetailsTab() {
      formTabs.forEach(t => t.classList.toggle('active', t.dataset.tab === 'details'));
      if (tabDetails) tabDetails.classList.add('active');
      if (tabMessages) tabMessages.classList.remove('active');
      if (tabPdfs) tabPdfs.classList.remove('active');
      if (tabManagement) tabManagement.classList.remove('active');
      // Pre-fill subject with quote number
      if (msgSubject && selectedQuoteData?.quote_number) {
        msgSubject.value = selectedQuoteData.quote_number + ' -- ';
      }
      if (msgBody) msgBody.value = '';
    }

    async function loadMessages(quoteId: string) {
      if (!messagesContainer) return;
      try {
        const res = await fetch(`/api/admin/messages/?quote_id=${quoteId}`, { credentials: 'same-origin' });
        const data: any = await res.json();
        if (!data.success || !data.messages?.length) {
          if (messagesEmpty) messagesEmpty.style.display = 'block';
          // Clear any previously rendered messages
          messagesContainer.querySelectorAll('.message-item').forEach(el => el.remove());
          if (messagesBadge) messagesBadge.style.display = 'none';
          return;
        }
        if (messagesEmpty) messagesEmpty.style.display = 'none';
        // Clear old
        messagesContainer.querySelectorAll('.message-item').forEach(el => el.remove());
        // Render NEWEST FIRST — the API returns oldest→newest, so reverse it so
        // the latest message sits right under the reply box (no scrolling to the
        // bottom to read it, then back up to reply).
        data.messages.slice().reverse().forEach((msg: any) => {
          const div = document.createElement('div');
          const isCustomer = msg.sender_type === 'customer';
          div.className = isCustomer ? 'message-item customer-reply' : 'message-item admin-msg';
          const dateObj = msg.created_at ? new Date(msg.created_at + 'Z') : null;
          const dateStr = dateObj ? dateObj.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '';
          const timeStr = dateObj ? dateObj.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' }) : '';
          // Strip quote number prefix from subject for cleaner display
          const subject = (msg.subject || 'No subject').replace(/^MK-[A-Z0-9-]+\s*--?\s*/i, '').trim() || msg.subject || 'No subject';

          const senderBadge = isCustomer
            ? `<span class="msg-sender-badge customer">${escapeHtml(msg.sender_name || msg.sender_email || 'Customer')}</span>`
            : `<span class="msg-sender-badge admin">MannyKnows</span>`;

          const statusLine = isCustomer
            ? `<div class="msg-status received">↩ Reply from ${escapeHtml(msg.sender_email || msg.sender_name || 'customer')}</div>`
            : `<div class="msg-status ${msg.status === 'sent' ? 'sent' : 'failed'}">${msg.status === 'sent' ? '✓' : '✗'} ${msg.status === 'sent' ? 'Delivered' : 'Failed'} → ${msg.recipient_email ? escapeHtml(msg.recipient_email) : 'unknown'}</div>`;

          var attsHtml = '';
          try {
            var atts = msg.attachments ? JSON.parse(msg.attachments) : [];
            if (Array.isArray(atts) && atts.length) {
              attsHtml = '<div style="margin-top:8px;display:flex;flex-wrap:wrap;gap:6px;">'
                + atts.filter(Boolean).map((a: any) => {
                  var isImg = (a.type || '').startsWith('image/');
                  var isPdf = a.type === 'application/pdf';
                  var isVid = (a.type || '').startsWith('video/');
                  if (isImg) {
                    return '<a href="' + encodeURI(a.url) + '" target="_blank" rel="noopener" style="display:inline-block;">'
                      + '<img src="' + encodeURI(a.url) + '" alt="' + escapeHtml(a.name) + '" style="max-width:180px;max-height:120px;border-radius:6px;object-fit:cover;border:1px solid rgba(255,255,255,0.1);" /></a>';
                  }
                  var icon = isPdf
                    ? '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>'
                    : isVid
                    ? '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2"/></svg>'
                    : '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/></svg>';
                  return '<a href="' + encodeURI(a.url) + '" target="_blank" rel="noopener" style="display:inline-flex;align-items:center;gap:5px;padding:5px 10px;background:rgba(255,255,255,0.07);border:1px solid rgba(255,255,255,0.12);border-radius:6px;font-size:11px;color:var(--color-text);text-decoration:none;max-width:180px;overflow:hidden;">'
                    + icon + '<span style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">' + escapeHtml(a.name) + '</span></a>';
                }).join('') + '</div>';
            }
          } catch (_) {}

          div.innerHTML = `
            ${senderBadge}
            <div class="msg-header">
              <span class="msg-subject">${escapeHtml(subject)}</span>
              <span class="msg-date">${dateStr} · ${timeStr}</span>
            </div>
            <div class="msg-body">${linkifyBody(msg.body || '')}</div>
            ${attsHtml}
            ${statusLine}
          `;
          messagesContainer.appendChild(div);
        });
        // Update badge
        if (messagesBadge) {
          messagesBadge.textContent = String(data.messages.length);
          messagesBadge.style.display = 'inline';
        }
      } catch (err) {
        console.error('Failed to load messages:', err);
      }
    }

    // Polish message with AI — polishes BOTH the subject and the body. The
    // subject keeps its "MK-… --" quote-number prefix; only the human part
    // after it is polished.
    document.getElementById('btnPolish')?.addEventListener('click', async () => {
      const bodyEl = document.getElementById('msgBody') as HTMLTextAreaElement;
      const subjEl = document.getElementById('msgSubject') as HTMLInputElement | null;
      const text = bodyEl?.value?.trim();
      if (!text) { showToast('Write a message first', 'error'); return; }

      const cust = selectedQuoteData?.customer_name || '';
      async function polishText(t: string): Promise<string | null> {
        try {
          const res = await fetch('/api/admin/polish-message/', {
            method: 'POST', credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ message: t, customer_name: cust }),
          });
          const data = await res.json() as any;
          return (data.success && data.polished) ? data.polished : null;
        } catch { return null; }
      }

      // Split the subject's quote-number prefix from the editable part. The
      // standard "MannyKnows Project | #…" title is fixed — never polish it.
      const rawSubj = subjEl?.value || '';
      const isStdTitle = /^MannyKnows Project \| #/i.test(rawSubj);
      const sm = rawSubj.match(/^(MK-[A-Z0-9-]+\s*--?\s*)([\s\S]*)$/i);
      const subjPrefix = sm ? sm[1] : '';
      const subjText = isStdTitle ? '' : (sm ? sm[2] : rawSubj).trim();
      // Snapshot pre-polish text so the admin can undo.
      _quotePrePolish = { body: bodyEl?.value || '', subject: rawSubj };

      const btn = document.getElementById('btnPolish') as HTMLButtonElement;
      const btnText = btn.querySelector('.polish-text') as HTMLElement;
      const btnLoading = btn.querySelector('.polish-loading') as HTMLElement;
      btn.disabled = true;
      btnText.style.display = 'none';
      btnLoading.style.display = '';

      try {
        const [pBody, pSubj] = await Promise.all([
          polishText(text),
          subjText ? polishText(subjText) : Promise.resolve(null),
        ]);
        if (pBody) bodyEl.value = pBody;
        if (pSubj && subjEl) subjEl.value = subjPrefix + pSubj;
        if (pBody || pSubj) {
          const u = document.getElementById('btnUndoPolish'); if (u) (u as HTMLElement).style.display = '';
          saveQuoteMsgDraft();
          showToast('Polished: use Undo polish to revert');
        } else { showToast('Failed to polish', 'error'); }
      } catch {
        showToast('Failed to polish message', 'error');
      } finally {
        btn.disabled = false;
        btnText.style.display = '';
        btnLoading.style.display = 'none';
      }
    });

    btnSendMessage?.addEventListener('click', async () => {
      if (!selectedQuoteId || !selectedQuoteData) {
        showToast('No quote selected', 'error');
        return;
      }
      const body = msgBody?.value?.trim();
      if (!body) {
        showToast('Message body is required', 'error');
        return;
      }
      const email = selectedQuoteData.customer_email;
      if (!email) {
        showToast('This quote has no customer email address', 'error');
        return;
      }

      const btn = btnSendMessage as HTMLButtonElement;
      btn.disabled = true;
      btn.textContent = 'Sending...';

      const pendingAtts = _quoteAttachments.filter(Boolean);

      try {
        const res = await fetch('/api/admin/messages/', {
          method: 'POST',
          credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            quote_id: parseInt(selectedQuoteId),
            subject: msgSubject?.value?.trim() || 'Message from MannyKnows',
            body: body,
            recipient_email: email,
            recipient_name: selectedQuoteData.customer_name || undefined,
            attachments: pendingAtts.length ? pendingAtts : undefined,
          }),
        });
        const data: any = await res.json();
        if (data.success) {
          showToast(data.email_status === 'sent' ? 'Message sent!' : 'Message saved but email failed', data.email_status === 'sent' ? 'success' : 'error');
          if (msgBody) msgBody.value = '';
          if (msgSubject) msgSubject.value = defaultQuoteSubject();
          clearQuoteMsgDraft();
          _quotePrePolish = null;
          const undoB = document.getElementById('btnUndoPolish'); if (undoB) (undoB as HTMLElement).style.display = 'none';
          _quoteAttachments = [];
          const attList = document.getElementById('quoteAttachList');
          if (attList) attList.innerHTML = '';
          loadMessages(selectedQuoteId);
        } else {
          showToast(data.error || 'Failed to send message', 'error');
        }
      } catch (err) {
        showToast('Error sending message', 'error');
      } finally {
        btn.disabled = false;
        btn.innerHTML = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg> Send Email`;
      }
    });

    // ========================================================================
    // Scope editor — multi-scope cards (Phase 5)
    // ========================================================================
    // A quote owns N scopes. Each scope: { id, title, template_id, sections }
    // where sections are the same { id, title, items[] } shape as Phase 4.
    // scopesState mirrors quotes.template_sections (parseScopes wraps legacy
    // flat data automatically).
    let scopeTemplates: Array<{ id: number; name: string; project_type: string; is_default: number; archived: number }> = [];
    let scopesState: Array<{ id: string; title: string; template_id?: number | null; sections: any[] }> = [];
    let scopeDirty = false;
    let scopeTemplatesLoaded = false;

    // Client-side mirror of parseScopes() in quoteTemplateConstants.ts.
    // Wraps legacy flat data as one scope titled "Main scope".
    function parseScopesClient(raw: any): Array<{ id: string; title: string; template_id?: number | null; sections: any[] }> {
      if (!raw) return [];
      let parsed: any;
      try { parsed = typeof raw === 'string' ? JSON.parse(raw) : raw; } catch { return []; }
      if (!Array.isArray(parsed) || parsed.length === 0) return [];
      const first = parsed[0];
      if (first && typeof first === 'object' && Array.isArray((first as any).sections)) {
        return parsed;
      }
      return [{
        id: 'scope-legacy',
        title: 'Main scope',
        template_id: null,
        sections: parsed,
      }];
    }

    function scopeEscape(s: any) {
      return String(s == null ? '' : s)
        .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
    }
    function scopeUid(prefix: string) {
      return `${prefix}-${Date.now().toString(36)}-${Math.random().toString(36).slice(2, 8)}`;
    }

    function scopeFirstServiceType(): string | null {
      // services may be a stringified JSON array of strings OR of {type,scope}
      const raw = (selectedQuoteData as any)?.services;
      if (!raw) return null;
      try {
        const arr = typeof raw === 'string' ? JSON.parse(raw) : raw;
        if (!Array.isArray(arr) || !arr.length) return null;
        const first = arr[0];
        if (typeof first === 'string') return first.toLowerCase();
        if (first && typeof first === 'object' && first.type) return String(first.type).toLowerCase();
      } catch {}
      return null;
    }

    async function loadScopeTemplates() {
      if (scopeTemplatesLoaded) return;
      try {
        const res = await fetch('/api/admin/quote-templates/', { credentials: 'include' });
        const data = await res.json() as { success?: boolean; templates?: typeof scopeTemplates };
        if (data.success && Array.isArray(data.templates)) {
          scopeTemplates = data.templates;
          scopeTemplatesLoaded = true;
        }
      } catch {}
    }

    // Generic template-picker populator. Called for:
    //   • the page-level "Add scope from template" select
    //   • per-scope "Replace with template" selects (one per scope card)
    function buildTemplatePickerOptions(selectedId: number | null): string {
      const opts: string[] = ['<option value="">, Select template, </option>'];
      const order = SVC_TYPES.map((s) => s.value);
      const grouped = new Map<string, typeof scopeTemplates>();
      for (const t of scopeTemplates) {
        if (t.archived) continue;
        const key = t.project_type || 'other';
        if (!grouped.has(key)) grouped.set(key, []);
        grouped.get(key)!.push(t);
      }
      for (const type of order) {
        if (!grouped.has(type)) continue;
        const label = type.charAt(0).toUpperCase() + type.slice(1);
        opts.push(`<optgroup label="${scopeEscape(label)}">`);
        for (const t of grouped.get(type)!) {
          const sel = selectedId === t.id ? ' selected' : '';
          opts.push(`<option value="${t.id}"${sel}>${scopeEscape(t.name)}${t.is_default ? ' · default' : ''}</option>`);
        }
        opts.push('</optgroup>');
      }
      return opts.join('');
    }

    function renderAddScopeTemplatePicker() {
      const picker = document.getElementById('scopeAddTemplatePicker') as HTMLSelectElement | null;
      if (!picker) return;
      picker.innerHTML = buildTemplatePickerOptions(null);
      // Default selection: is_default template for the quote's first service.
      const firstType = scopeFirstServiceType();
      if (firstType) {
        const def = scopeTemplates.find(t => !t.archived && t.project_type === firstType && t.is_default);
        if (def) picker.value = String(def.id);
      }
    }

    // A quote is "scoped" once at least one scope has at least one section.
    // The empty seed ([{title:'Main scope', sections:[]}]) does NOT count.
    function quoteHasScope() {
      return Array.isArray(scopesState) && scopesState.some(s => Array.isArray(s.sections) && s.sections.length > 0);
    }
    // Block "Send to Customer" until there's a real scope — you shouldn't be
    // able to send an empty/$0 quote to a customer.
    function updateSendButtonState() {
      const btnSend = document.getElementById('btnSend') as HTMLButtonElement | null;
      if (!btnSend) return;
      const ok = quoteHasScope();
      btnSend.disabled = !ok;
      btnSend.title = ok ? '' : 'Add a scope of work before sending this quote to the customer.';
      btnSend.style.opacity = ok ? '' : '0.45';
      btnSend.style.cursor = ok ? '' : 'not-allowed';
    }
    (window as any).updateSendButtonState = updateSendButtonState;

    function setScopeDirty(d: boolean) {
      scopeDirty = d;
      updateSendButtonState();
      const status = document.getElementById('scopeSaveStatus');
      if (status) {
        status.textContent = d ? 'Unsaved changes: click Save' : '';
        status.style.color = d ? '#fbbf24' : 'var(--color-text-secondary)';
      }
      // Cue the single (main) Save button so the admin knows there are
      // pending scope edits to persist.
      const mainSave = document.getElementById('btnSave') as HTMLButtonElement | null;
      if (mainSave) mainSave.classList.toggle('has-unsaved', d);
    }

    // Sum every subtotal item in one scope.
    function sumScopeSubtotalsLocal(scope: any): number {
      let total = 0;
      if (!scope || !Array.isArray(scope.sections)) return 0;
      for (const sec of scope.sections) {
        if (!Array.isArray(sec?.items)) continue;
        for (const it of sec.items) {
          if (it && it.type === 'subtotal') {
            const amt = Number(it.amount) || 0;
            total += amt;
          }
        }
      }
      return total;
    }

    // Top-level renderer — one card per scope, then a sentinel when empty.
    function renderScopes() {
      const container = document.getElementById('scopesList');
      if (!container) return;
      if (!scopesState.length) {
        container.innerHTML = '<div style="padding:24px; text-align:center; color:var(--color-text-secondary); border:1.5px dashed var(--glass-border); border-radius:var(--radius-md); font-size:13px;">No scopes yet. Use the buttons below to add a scope from a template, or add an empty scope to build one by hand.</div>';
      } else {
        container.innerHTML = scopesState.map((sc, idx) => renderScopeCard(sc, idx)).join('');
      }
      updateSendButtonState();
      // After re-render, re-populate every per-scope template picker (selects
      // lose their option DOM during innerHTML replacement).
      for (const sc of scopesState) {
        const sel = document.getElementById(`scopeTemplatePicker-${sc.id}`) as HTMLSelectElement | null;
        if (sel) sel.innerHTML = buildTemplatePickerOptions(sc.template_id || null);
      }
      renderPricingMode();
    }

    // One scope card. Layout:
    //   Header: title input | subtotal badge | actions (↑↓✕ Preview) | collapse toggle
    //   Body  : per-scope template picker + Apply | sections list | + Add section
    function renderScopeCard(scope: any, scopeIdx: number): string {
      const last = scopesState.length - 1;
      const subtotal = sumScopeSubtotalsLocal(scope);
      const sectionsHtml = (scope.sections || []).map((sec: any, i: number) =>
        renderScopeSectionInCard(scope.id, sec, i, scope.sections.length)
      ).join('');
      return `<div class="scope-card scope-section" style="background:rgba(255,255,255,0.04); border:1px solid var(--glass-border); border-radius:var(--radius-lg); padding:14px; margin-bottom:14px;" data-scope-id="${scopeEscape(scope.id)}">
        <div style="display:flex; gap:10px; align-items:center; margin-bottom:12px; flex-wrap:wrap;">
          <input type="text" class="form-input" value="${scopeEscape(scope.title)}" oninput="scopeUpdateScopeTitle('${scope.id}', this.value)" placeholder="Scope title (e.g. Website Build)" style="flex:1; min-width:180px; font-weight:700; font-size:15px;">
          <span style="font-size:13px; font-weight:700; color:#86efac; font-variant-numeric:tabular-nums; padding:6px 10px; background:rgba(34,197,94,0.08); border:1px solid rgba(34,197,94,0.25); border-radius:var(--radius-sm); white-space:nowrap;">$${subtotal.toFixed(2)}</span>
          <div class="scope-section-actions" style="display:flex; gap:6px;">
            <button type="button" class="btn btn-secondary scope-polish-btn" data-polish-target="scope-title" data-scope-id="${scope.id}" onclick="scopePolishScopeTitle('${scope.id}', this)" style="padding:6px 8px;" title="Polish: fix typos + translate Spanish → English">✨</button>
            <button type="button" class="btn btn-secondary" onclick="scopePreviewPdf('${scope.id}')" style="padding:6px 10px; font-size:12px;" title="Preview just this scope as a PDF">Preview PDF</button>
            <button type="button" class="btn btn-secondary" ${scopeIdx === 0 ? 'disabled' : ''} onclick="scopeMoveScope('${scope.id}', -1)" style="padding:6px 10px;" title="Move up">↑</button>
            <button type="button" class="btn btn-secondary" ${scopeIdx === last ? 'disabled' : ''} onclick="scopeMoveScope('${scope.id}', 1)" style="padding:6px 10px;" title="Move down">↓</button>
            <button type="button" class="btn btn-secondary" onclick="scopeDeleteScope('${scope.id}')" style="padding:6px 10px; color:#fca5a5;" title="Delete this scope">✕</button>
          </div>
        </div>

        <div style="display:flex; gap:8px; align-items:end; flex-wrap:wrap; margin-bottom:12px;">
          <div style="flex:1; min-width:180px;">
            <label class="form-label" style="display:block; margin-bottom:4px; font-size:10px; text-transform:uppercase; letter-spacing:0.5px; color:var(--color-text-secondary);">Replace with template</label>
            <select id="scopeTemplatePicker-${scope.id}" class="form-input"></select>
          </div>
          <button type="button" class="btn btn-secondary" onclick="scopeApplyTemplateToScope('${scope.id}')" style="padding:9px 14px;">Apply</button>
        </div>

        <div style="margin-bottom:8px; font-size:11px; font-weight:700; color:var(--color-text-secondary); text-transform:uppercase; letter-spacing:0.5px;">Sections</div>
        ${sectionsHtml || '<div style="padding:14px; text-align:center; color:var(--color-text-secondary); border:1px dashed var(--glass-border); border-radius:var(--radius-sm); font-size:12px;">No sections in this scope yet.</div>'}
        <button type="button" onclick="scopeAddSection('${scope.id}')" style="display:block; width:100%; padding:10px; background:rgba(255,255,255,0.02); border:1.5px dashed var(--glass-border); color:var(--color-text-secondary); border-radius:var(--radius-md); font-size:13px; font-weight:600; cursor:pointer; margin-top:8px;">+ Add section</button>
      </div>`;
    }

    function renderScopeSectionInCard(scopeId: string, section: any, sIdx: number, totalSections: number): string {
      const last = totalSections - 1;
      const items = (section.items || []).map((it: any, iIdx: number) =>
        renderScopeItemInCard(scopeId, section.id, it, iIdx, section.items.length)
      ).join('');
      return `<div class="scope-section" style="background:rgba(255,255,255,0.03); border:1px solid var(--glass-border); border-radius:var(--radius-md); padding:12px; margin-bottom:10px;" data-section-id="${scopeEscape(section.id)}">
        <div style="display:flex; gap:8px; align-items:center; margin-bottom:10px;">
          <input type="text" class="form-input" value="${scopeEscape(section.title)}" oninput="scopeUpdateSectionTitle('${scopeId}', '${section.id}', this.value)" placeholder="Section title" style="flex:1; font-weight:700;">
          <div class="scope-section-actions" style="display:flex; gap:6px;">
            <button type="button" class="btn btn-secondary scope-polish-btn" onclick="scopePolishSectionTitle('${scopeId}', '${section.id}', this)" style="padding:6px 8px;" title="Polish: fix typos + translate Spanish → English">✨</button>
            <button type="button" class="btn btn-secondary" ${sIdx === 0 ? 'disabled' : ''} onclick="scopeMoveSection('${scopeId}', '${section.id}', -1)" style="padding:6px 10px;">↑</button>
            <button type="button" class="btn btn-secondary" ${sIdx === last ? 'disabled' : ''} onclick="scopeMoveSection('${scopeId}', '${section.id}', 1)" style="padding:6px 10px;">↓</button>
            <button type="button" class="btn btn-secondary" onclick="scopeDeleteSection('${scopeId}', '${section.id}')" style="padding:6px 10px; color:#fca5a5;">✕</button>
          </div>
        </div>
        ${items}
        <div style="display:flex; gap:6px; flex-wrap:wrap; padding-top:8px; border-top:1px dashed var(--glass-border); margin-top:8px;">
          <button type="button" class="btn btn-secondary" onclick="scopeAddItem('${scopeId}', '${section.id}', 'bullet')" style="padding:5px 10px; font-size:12px;">+ Bullet</button>
          <button type="button" class="btn btn-secondary" onclick="scopeAddItem('${scopeId}', '${section.id}', 'fillable')" style="padding:5px 10px; font-size:12px;">+ Color line</button>
          <button type="button" class="btn btn-secondary" onclick="scopeAddItem('${scopeId}', '${section.id}', 'choice')" style="padding:5px 10px; font-size:12px;" title="Labeled dropdown: admin defines the options">+ Choice</button>
          <button type="button" class="btn btn-secondary" onclick="scopeAddItem('${scopeId}', '${section.id}', 'subtotal')" style="padding:5px 10px; font-size:12px;">+ Subtotal</button>
          <button type="button" class="btn btn-secondary" onclick="scopeAddItem('${scopeId}', '${section.id}', 'note')" style="padding:5px 10px; font-size:12px;">+ Note</button>
        </div>
      </div>`;
    }

    function renderScopeItemInCard(scopeId: string, sectionId: string, item: any, iIdx: number, itemsLen: number): string {
      const last = itemsLen - 1;
      const label = item.type === 'bullet' ? 'BULLET'
        : item.type === 'fillable' ? 'COLOR'
        : item.type === 'choice' ? 'CHOICE'
        : item.type === 'paint_line' ? 'PAINT/STAIN'
        : item.type === 'subtotal' ? 'SUBTOTAL'
        : 'NOTE';
      let fields = '';
      if (item.type === 'bullet' || item.type === 'note') {
        fields = `<textarea class="form-input" oninput="scopeUpdateItemField('${scopeId}', '${sectionId}', '${item.id}', 'text', this.value)" placeholder="${item.type === 'bullet' ? 'Bullet text' : 'Paragraph text'}" style="min-height:48px; line-height:1.4; resize:vertical;">${scopeEscape(item.text || '')}</textarea>`;
      } else if (item.type === 'fillable') {
        // Color line — matches the customer portal card: code/name value +
        // Paint/Stain type + Finish. All optional; flows to the portal + contract.
        const pt = item.product_type === 'paint' || item.product_type === 'stain' ? item.product_type : '';
        const finishes = ['Flat', 'Matte', 'Eggshell', 'Satin', 'Semi-gloss', 'Gloss'];
        fields = `<div style="display:flex; gap:6px; flex-wrap:wrap;">
          <input type="text" class="form-input" oninput="scopeUpdateItemField('${scopeId}', '${sectionId}', '${item.id}', 'label', this.value)" value="${scopeEscape(item.label || '')}" placeholder="Label (e.g. Wall color: living room)" style="flex:1; min-width:140px;">
          <input type="text" class="form-input" oninput="scopeUpdateItemField('${scopeId}', '${sectionId}', '${item.id}', 'value', this.value)" value="${scopeEscape(item.value || '')}" placeholder="Color name or code" style="flex:1; min-width:140px;">
        </div>
        <div style="display:flex; gap:6px; margin-top:6px;">
          <select class="form-input" onchange="scopeUpdateItemField('${scopeId}', '${sectionId}', '${item.id}', 'product_type', this.value)" style="flex:1;">
            <option value=""${!pt ? ' selected' : ''}>Paint or stain?</option>
            <option value="paint"${pt === 'paint' ? ' selected' : ''}>Paint</option>
            <option value="stain"${pt === 'stain' ? ' selected' : ''}>Stain</option>
          </select>
          <select class="form-input" onchange="scopeUpdateItemField('${scopeId}', '${sectionId}', '${item.id}', 'finish', this.value)" style="flex:1;">
            <option value=""${!item.finish ? ' selected' : ''}>Finish (optional)</option>
            ${finishes.map(f => `<option value="${f}"${item.finish === f ? ' selected' : ''}>${f}</option>`).join('')}
          </select>
        </div>`;
      } else if (item.type === 'choice') {
        // Three fields: label, comma-separated options, and a value
        // dropdown driven by those options. The options input is admin
        // metadata — only the picked value reaches the customer-facing
        // document. We render the value as a <select> when options are
        // defined, falling back to a text input when not (so brand-new
        // rows with no options yet can still be typed into).
        const opts: string[] = Array.isArray(item.options) ? item.options : [];
        const optionsStr = opts.join(', ');
        const valueField = opts.length > 0
          ? `<select class="form-input" onchange="scopeUpdateItemField('${scopeId}', '${sectionId}', '${item.id}', 'value', this.value)" style="flex:1; min-width:140px;">
              <option value=""${!item.value ? ' selected' : ''}>, Select, </option>
              ${opts.map(o => `<option value="${scopeEscape(o)}"${item.value === o ? ' selected' : ''}>${scopeEscape(o)}</option>`).join('')}
            </select>`
          : `<input type="text" class="form-input" oninput="scopeUpdateItemField('${scopeId}', '${sectionId}', '${item.id}', 'value', this.value)" value="${scopeEscape(item.value || '')}" placeholder="Value (add options to make this a dropdown)" style="flex:1; min-width:140px;">`;
        fields = `<div style="display:flex; gap:6px; flex-wrap:wrap;">
          <input type="text" class="form-input" oninput="scopeUpdateItemField('${scopeId}', '${sectionId}', '${item.id}', 'label', this.value)" value="${scopeEscape(item.label || '')}" placeholder="Label (e.g. Countertop material, Sheen)" style="flex:1; min-width:140px;">
          ${valueField}
        </div>
        <input type="text" class="form-input" onchange="scopeUpdateChoiceOptions('${scopeId}', '${sectionId}', '${item.id}', this.value)" value="${scopeEscape(optionsStr)}" placeholder="Options (comma-separated, e.g. Granite, Quartz, Butcher block)" title="Type the choices, separated by commas. The dropdown updates when you click away." style="margin-top:6px; font-size:12px;">`;
      } else if (item.type === 'paint_line') {
        // Legacy — kept editable so already-saved rows still work. New
        // items go through the generic Choice flow above.
        const productType = item.product_type === 'stain' ? 'stain' : 'paint';
        fields = `<div style="display:flex; gap:6px; flex-wrap:wrap;">
          <input type="text" class="form-input" oninput="scopeUpdateItemField('${scopeId}', '${sectionId}', '${item.id}', 'label', this.value)" value="${scopeEscape(item.label || '')}" placeholder="Label (e.g. Body color)" style="flex:1; min-width:140px;">
          <input type="text" class="form-input" oninput="scopeUpdateItemField('${scopeId}', '${sectionId}', '${item.id}', 'value', this.value)" value="${scopeEscape(item.value || '')}" placeholder="Color / product" style="flex:1; min-width:140px;">
          <select class="form-input" onchange="scopeUpdateItemField('${scopeId}', '${sectionId}', '${item.id}', 'product_type', this.value)" style="width:120px;">
            <option value="paint"${productType === 'paint' ? ' selected' : ''}>Paint</option>
            <option value="stain"${productType === 'stain' ? ' selected' : ''}>Stain</option>
          </select>
        </div>`;
      } else if (item.type === 'subtotal') {
        fields = `<div style="display:flex; gap:6px;">
          <input type="text" class="form-input" oninput="scopeUpdateItemField('${scopeId}', '${sectionId}', '${item.id}', 'label', this.value)" value="${scopeEscape(item.label || '')}" placeholder="Label" style="flex:1;">
          <input type="number" inputmode="decimal" step="0.01" class="form-input" oninput="scopeUpdateItemField('${scopeId}', '${sectionId}', '${item.id}', 'amount', this.value)" value="${item.amount != null ? item.amount : ''}" placeholder="0.00" style="width:140px;">
        </div>`;
      }
      return `<div class="scope-item" style="display:flex; gap:8px; align-items:flex-start; padding:8px; background:rgba(255,255,255,0.02); border:1px solid rgba(255,255,255,0.04); border-radius:var(--radius-sm); margin-bottom:6px;">
        <div style="flex-shrink:0; width:68px; font-size:9px; font-weight:700; text-transform:uppercase; letter-spacing:0.5px; color:var(--color-text-secondary); padding:6px 0; text-align:center; background:rgba(255,255,255,0.03); border-radius:4px;">${label}</div>
        <div style="flex:1; min-width:0;">${fields}</div>
        <div class="scope-item-actions" style="display:flex; flex-direction:column; gap:4px;">
          <button type="button" class="btn btn-secondary scope-polish-btn" onclick="scopePolishItem('${scopeId}', '${sectionId}', '${item.id}', this)" style="padding:4px 8px; font-size:11px;" title="Polish: fix typos + translate Spanish → English">✨</button>
          <button type="button" class="btn btn-secondary" ${iIdx === 0 ? 'disabled' : ''} onclick="scopeMoveItem('${scopeId}', '${sectionId}', '${item.id}', -1)" style="padding:4px 8px; font-size:11px;">↑</button>
          <button type="button" class="btn btn-secondary" ${iIdx === last ? 'disabled' : ''} onclick="scopeMoveItem('${scopeId}', '${sectionId}', '${item.id}', 1)" style="padding:4px 8px; font-size:11px;">↓</button>
          <button type="button" class="btn btn-secondary" onclick="scopeDeleteItem('${scopeId}', '${sectionId}', '${item.id}')" style="padding:4px 8px; font-size:11px; color:#fca5a5;">✕</button>
        </div>
      </div>`;
    }

    // Pricing summary inside the Scopes &amp; Pricing card — sums every Subtotal
    // item across every scope, then subtracts the discount. Always visible
    // now that the legacy materials/labor editor is gone.
    function renderPricingMode() {
      const list = document.getElementById('pricingScopeSubtotals');
      if (!list) return;

      // Build a flat list of subtotal items annotated with their scope title
      // so the Pricing summary reads as "Interior — Total: $X / Deck — Total: $Y".
      const rows: Array<{ label: string; amount: number }> = [];
      for (const sc of scopesState) {
        if (!Array.isArray(sc?.sections)) continue;
        for (const sec of sc.sections) {
          if (!Array.isArray(sec?.items)) continue;
          for (const it of sec.items) {
            if (it && it.type === 'subtotal') {
              const amt = Number(it.amount) || 0;
              const label = scopesState.length > 1
                ? `${sc.title || 'Scope'}: ${it.label || 'Subtotal'}`
                : (it.label || 'Subtotal');
              rows.push({ label, amount: amt });
            }
          }
        }
      }
      list.innerHTML = rows.length
        ? rows.map(r => `
            <div style="display:flex; justify-content:space-between; gap:10px; padding:6px 10px; background:rgba(255,255,255,0.02); border:1px solid var(--glass-border); border-radius:var(--radius-sm); font-size:13px;">
              <span style="color:var(--color-text-secondary);">${(r.label || '').replace(/[<>&]/g, '')}</span>
              <span style="font-weight:600; font-variant-numeric:tabular-nums;">$${r.amount.toFixed(2)}</span>
            </div>
          `).join('')
        : `<div style="padding:8px 10px; font-size:12px; color:var(--color-text-secondary); font-style:italic;">No Subtotal items yet, add one inside a scope section to set pricing.</div>`;
      const sum = rows.reduce((s, r) => s + r.amount, 0);
      const discountEl = document.getElementById('inputDiscount') as HTMLInputElement | null;
      const discount = discountEl ? (parseFloat(discountEl.value) || 0) : 0;
      const subtotalEl = document.getElementById('pricingScopeSubtotal');
      const grandEl = document.getElementById('pricingScopeGrand');
      if (subtotalEl) subtotalEl.textContent = `$${sum.toFixed(2)}`;
      if (grandEl) grandEl.textContent = `$${(sum - discount).toFixed(2)}`;
    }

    // Preview PDF button in the bottom action bar — opens the printable
    // preview in a new tab. Available from any tab, any time. The floating
    // FAB (#previewPdfFab) mirrors this click so mobile users don't have to
    // scroll to the bottom of the long Scopes &amp; Pricing card.
    function openPreviewPdf() {
      if (!selectedQuoteId) { showToast('Open a quote first', 'error'); return; }
      window.open(`/admin/quotes/${selectedQuoteId}/preview/`, '_blank', 'noopener');
    }
    document.getElementById('btnPreviewPdf')?.addEventListener('click', openPreviewPdf);
    document.getElementById('previewPdfFab')?.addEventListener('click', openPreviewPdf);

    // Show the floating Preview FAB only on mobile + only when a quote is
    // selected. Called from the quote-open lifecycle (after selectedQuoteId
    // is set) and from a viewport resize listener.
    const mobileMql = window.matchMedia('(max-width: 768px)');
    function updatePreviewFab() {
      const fab = document.getElementById('previewPdfFab');
      if (!fab) return;
      const visible = mobileMql.matches && !!selectedQuoteId;
      fab.classList.toggle('is-visible', visible);
    }
    (window as any).updatePreviewFab = updatePreviewFab;
    mobileMql.addEventListener?.('change', updatePreviewFab);

    // ─── Collapsible list sidebar (tablet) ───────────────────────────────
    // Hide the list to give the detail full width; toggle restores it. On
    // tablet, opening a quote auto-collapses the list so the detail is focused.
    (function () {
      var toggle = document.getElementById('listToggleBtn');
      var main = document.querySelector('.admin-main');
      if (!toggle || !main) return;
      function setCollapsed(c: boolean) {
        main!.classList.toggle('list-collapsed', c);
        toggle!.textContent = c ? '›' : '‹';
      }
      toggle.addEventListener('click', function () {
        setCollapsed(!main!.classList.contains('list-collapsed'));
      });
      // When a quote opens (any screen size), collapse the list to focus the detail.
      document.addEventListener('click', function (e) {
        var card = (e.target as HTMLElement)?.closest?.('.quote-card');
        if (card) setCollapsed(true);
      });
    })();

    // ─── Mobile accordions for the right-pane form sections ───────────────
    // On mobile, each top-level .form-section in the tabbed quote detail
    // collapses by default — admin taps the title to expand. The Scopes &amp;
    // Pricing card opens by default so editing is one tap away. Called by
    // initQuoteSectionAccordions() after a quote is loaded into the form.
    function initQuoteSectionAccordions() {
      // Target ONLY top-level form sections under the tab panes — nested
      // form-sections (e.g. inside scope cards) stay always open.
      const containers = ['#tabDetails', '#tabPdfs', '#tabMessages', '#tabManagement'];
      const sections: HTMLElement[] = [];
      for (const sel of containers) {
        document.querySelectorAll<HTMLElement>(`${sel} > .form-section`).forEach(el => sections.push(el));
      }
      for (const section of sections) {
        if (section.dataset.accordionWired === '1') continue;
        const title = section.querySelector(':scope > .form-section-title') as HTMLElement | null;
        if (!title) continue;

        // Mark as opted-in for the CSS rules.
        section.classList.add('fs-collapsible');

        // Inject a chevron span at the end of the title (only once).
        if (!title.querySelector('.fs-chevron')) {
          const chevron = document.createElement('span');
          chevron.className = 'fs-chevron';
          chevron.textContent = '▾';
          title.appendChild(chevron);
        }

        title.addEventListener('click', (e) => {
          // Don't intercept clicks on actual inputs inside the title row
          // (e.g. the Scopes &amp; Pricing card has a save-status text span).
          const t = e.target as HTMLElement;
          if (t.closest('input, select, textarea, button, a')) return;
          // Accordion behavior is mobile-only — desktop ignores the toggle.
          if (!mobileMql.matches) return;
          section.classList.toggle('fs-collapsed');
        });
        section.dataset.accordionWired = '1';
      }
      // Default state on mobile: collapse only the accordion-wired sections,
      // and keep Scopes & Pricing open since it's the primary editing area.
      // Sections without a direct-child title (Scopes & Pricing's title is
      // nested inside a flex wrapper, Reference Media's is inside a header
      // div) never got the fs-collapsible class — leave them fully visible
      // so the user doesn't lose their content to the hide rule.
      if (mobileMql.matches) {
        for (const section of sections) {
          if (!section.classList.contains('fs-collapsible')) continue;
          const title = (section.querySelector(':scope > .form-section-title')?.textContent || '').trim();
          const isScopesCard = title.startsWith('Scopes');
          section.classList.toggle('fs-collapsed', !isScopesCard);
        }
      } else {
        for (const section of sections) section.classList.remove('fs-collapsed');
      }
    }
    (window as any).initQuoteSectionAccordions = initQuoteSectionAccordions;
    // Re-run when the viewport crosses the mobile breakpoint so toggling
    // desktop↔mobile in dev tools (or rotating an iPad) updates state.
    mobileMql.addEventListener?.('change', () => initQuoteSectionAccordions());

    // ─── Lookup helpers ────────────────────────────────────────────────────
    function findScope(scopeId: string) {
      return scopesState.find((sc: any) => sc.id === scopeId);
    }
    function findSection(scopeId: string, sectionId: string) {
      const sc = findScope(scopeId); if (!sc) return undefined;
      return (sc.sections || []).find((s: any) => s.id === sectionId);
    }

    // ─── Scope-level mutators ──────────────────────────────────────────────
    (window as any).scopeUpdateScopeTitle = (scopeId: string, v: string) => {
      const sc = findScope(scopeId); if (!sc) return;
      sc.title = v;
      setScopeDirty(true);
    };
    (window as any).scopeMoveScope = (scopeId: string, dir: number) => {
      const idx = scopesState.findIndex(sc => sc.id === scopeId);
      const target = idx + dir;
      if (idx === -1 || target < 0 || target >= scopesState.length) return;
      const [m] = scopesState.splice(idx, 1);
      scopesState.splice(target, 0, m);
      setScopeDirty(true);
      renderScopes();
    };
    (window as any).scopeDeleteScope = (scopeId: string) => {
      const sc = findScope(scopeId);
      const label = sc?.title || 'this scope';
      showConfirmModal({
        title: `Delete "${label}"?`,
        message: 'This removes the scope and all its sections. The change is local until you click Save.',
        confirmText: 'Delete scope',
        confirmClass: 'btn-danger',
        onConfirm: () => {
          scopesState = scopesState.filter(s => s.id !== scopeId);
          setScopeDirty(true);
          renderScopes();
        },
      });
    };
    (window as any).scopePreviewPdf = (scopeId: string) => {
      if (!selectedQuoteId) { showToast('Save the quote first', 'error'); return; }
      window.open(`/admin/quotes/${selectedQuoteId}/preview/?scope=${encodeURIComponent(scopeId)}`, '_blank', 'noopener');
    };
    (window as any).scopeApplyTemplateToScope = async (scopeId: string) => {
      if (!selectedQuoteId) return;
      const picker = document.getElementById(`scopeTemplatePicker-${scopeId}`) as HTMLSelectElement | null;
      const tplId = picker && picker.value ? Number(picker.value) : null;
      if (!tplId) { showToast('Pick a template first', 'error'); return; }
      const sc = findScope(scopeId);

      // Apply implementation — same payload either way, just gated on
      // confirmation when there's existing content to overwrite.
      const apply = async () => {
        try {
          // scope_title is passed so the server can upsert with the right
          // label when the scope only exists in client state (auto-seeded
          // Main scope or legacy-synthesized scope).
          const res = await fetch(`/api/quotes/${selectedQuoteId}/apply-template/`, {
            method: 'POST', credentials: 'include',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ template_id: tplId, scope_id: scopeId, scope_title: sc?.title || '' }),
          });
          const data = await res.json() as { success?: boolean; error?: string; template_sections?: any[] };
          if (!data.success) { showToast(data.error || 'Failed to apply template', 'error'); return; }
          scopesState = Array.isArray(data.template_sections) ? data.template_sections : [];
          if (selectedQuoteData) {
            (selectedQuoteData as any).template_sections = JSON.stringify(scopesState);
          }
          renderScopes();
          setScopeDirty(false);
          showToast('Template applied to scope', 'success');
        } catch {
          showToast('Failed to apply template', 'error');
        }
      };

      if (sc?.sections?.length) {
        showConfirmModal({
          title: `Replace "${sc.title || 'this scope'}"?`,
          message: "The scope's existing sections will be overwritten with the template's content. This can't be undone.",
          confirmText: 'Replace',
          confirmClass: 'btn-warning',
          onConfirm: apply,
        });
      } else {
        apply();
      }
    };

    // ─── Section + item mutators (now scoped to a specific scope) ─────────
    (window as any).scopeUpdateSectionTitle = (scopeId: string, sectionId: string, v: string) => {
      const sec = findSection(scopeId, sectionId); if (!sec) return;
      sec.title = v;
      setScopeDirty(true);
    };
    (window as any).scopeUpdateItemField = (scopeId: string, sectionId: string, itemId: string, field: string, value: string) => {
      const sec = findSection(scopeId, sectionId); if (!sec) return;
      const it = (sec.items || []).find((x: any) => x.id === itemId); if (!it) return;
      if (field === 'amount') it.amount = value === '' ? 0 : Number(value);
      else it[field] = value;
      setScopeDirty(true);
      // Live-refresh the per-scope subtotal badge + the Pricing summary
      // without a full re-render (would lose focus on the active input).
      if (it.type === 'subtotal') {
        const sc = findScope(scopeId);
        const card = document.querySelector(`.scope-card[data-scope-id="${scopeId}"]`);
        if (sc && card) {
          const subtotalBadge = card.querySelector(':scope > div > span:nth-child(2)') as HTMLSpanElement | null;
          if (subtotalBadge) subtotalBadge.textContent = `$${sumScopeSubtotalsLocal(sc).toFixed(2)}`;
        }
        renderPricingMode();
      }
    };
    (window as any).scopeMoveSection = (scopeId: string, sectionId: string, dir: number) => {
      const sc = findScope(scopeId); if (!sc) return;
      const idx = sc.sections.findIndex((s: any) => s.id === sectionId);
      const target = idx + dir;
      if (idx === -1 || target < 0 || target >= sc.sections.length) return;
      const [m] = sc.sections.splice(idx, 1);
      sc.sections.splice(target, 0, m);
      setScopeDirty(true);
      renderScopes();
    };
    (window as any).scopeDeleteSection = (scopeId: string, sectionId: string) => {
      const sc = findScope(scopeId); if (!sc) return;
      showConfirmModal({
        title: 'Delete this section?',
        message: 'The section and all its items (bullets, color lines, subtotals, notes) will be removed.',
        confirmText: 'Delete section',
        confirmClass: 'btn-danger',
        onConfirm: () => {
          sc.sections = sc.sections.filter((s: any) => s.id !== sectionId);
          setScopeDirty(true);
          renderScopes();
        },
      });
    };
    (window as any).scopeAddSection = (scopeId: string) => {
      const sc = findScope(scopeId); if (!sc) return;
      sc.sections = sc.sections || [];
      sc.sections.push({ id: scopeUid('s'), title: 'New section', items: [] });
      setScopeDirty(true);
      renderScopes();
    };
    (window as any).scopeAddItem = (scopeId: string, sectionId: string, type: string) => {
      const sec = findSection(scopeId, sectionId); if (!sec) return;
      const base: any = { id: scopeUid('i'), type };
      if (type === 'bullet' || type === 'note') base.text = '';
      else if (type === 'fillable') { base.label = ''; base.value = ''; }
      else if (type === 'choice') {
        // Generic choice — admin types their own label + options (e.g.
        // "Hardware finish: Brass, Nickel, Black"). Starts blank.
        base.label = '';
        base.value = '';
        base.options = [];
      }
      else if (type === 'paint_line') { base.label = ''; base.value = ''; base.product_type = 'paint'; }
      else if (type === 'subtotal') { base.label = ''; base.amount = 0; }
      sec.items = sec.items || [];
      sec.items.push(base);
      setScopeDirty(true);
      renderScopes();
    };

    // Parses the comma-separated options input into an array. Empty strings
    // are dropped, surrounding whitespace is trimmed. The render is full so
    // the value-dropdown rebuilds from the new options.
    (window as any).scopeUpdateChoiceOptions = (scopeId: string, sectionId: string, itemId: string, raw: string) => {
      const sec = findSection(scopeId, sectionId); if (!sec) return;
      const it = (sec.items || []).find((x: any) => x.id === itemId);
      if (!it) return;
      const opts = String(raw || '').split(',').map(s => s.trim()).filter(Boolean);
      it.options = opts;
      // If the previously-selected value isn't in the new options list,
      // clear it so the dropdown doesn't show stale state.
      if (it.value && !opts.includes(it.value)) it.value = '';
      setScopeDirty(true);
      renderScopes();
    };
    (window as any).scopeMoveItem = (scopeId: string, sectionId: string, itemId: string, dir: number) => {
      const sec = findSection(scopeId, sectionId); if (!sec) return;
      const idx = sec.items.findIndex((i: any) => i.id === itemId);
      const target = idx + dir;
      if (idx === -1 || target < 0 || target >= sec.items.length) return;
      const [m] = sec.items.splice(idx, 1);
      sec.items.splice(target, 0, m);
      setScopeDirty(true);
      renderScopes();
    };
    (window as any).scopeDeleteItem = (scopeId: string, sectionId: string, itemId: string) => {
      const sec = findSection(scopeId, sectionId); if (!sec) return;
      sec.items = sec.items.filter((i: any) => i.id !== itemId);
      setScopeDirty(true);
      renderScopes();
    };

    // ────────────────────────────────────────────────────────────────────────
    // AI polish — per-item ✨ button. Calls /api/admin/polish-text (Gemini
    // 2.0 Flash) which: (a) fixes typos + grammar, (b) translates Spanish →
    // English, (c) preserves numbers/brand names verbatim. Conservative —
    // does not rephrase or rewrite. Admin clicks ✨ on whichever item they
    // want cleaned; template-untouched items stay as the template authored
    // them.
    // ────────────────────────────────────────────────────────────────────────
    async function polishOneString(text: string, kind: string): Promise<string | null> {
      if (!text || !text.trim()) return null;
      try {
        const res = await fetch('/api/admin/polish-text/', {
          method: 'POST',
          credentials: 'include',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ text, kind }),
        });
        const data = await res.json() as { success?: boolean; polished?: string; error?: string };
        if (!data.success || !data.polished) {
          showToast(data.error || 'Polish failed', 'error');
          return null;
        }
        return data.polished;
      } catch {
        showToast('Polish failed (network error)', 'error');
        return null;
      }
    }

    // Lock the button visually while the polish API call is in flight. The
    // ✨ glyph swaps to a spinning indicator and the button disables so
    // double-clicks don't fire a second request.
    function withPolishLoading<T>(btn: HTMLButtonElement | null, fn: () => Promise<T>): Promise<T> {
      const orig = btn?.innerHTML ?? '';
      if (btn) { btn.disabled = true; btn.innerHTML = '⏳'; }
      return fn().finally(() => {
        if (btn) { btn.disabled = false; btn.innerHTML = orig || '✨'; }
      });
    }

    (window as any).scopePolishScopeTitle = async (scopeId: string, btnEl?: HTMLButtonElement) => {
      const sc = findScope(scopeId); if (!sc) return;
      await withPolishLoading(btnEl || null, async () => {
        const polished = await polishOneString(sc.title || '', 'scope title');
        if (polished == null) return;
        sc.title = polished;
        setScopeDirty(true);
        renderScopes();
        showToast('Scope title polished', 'success');
      });
    };

    (window as any).scopePolishSectionTitle = async (scopeId: string, sectionId: string, btnEl?: HTMLButtonElement) => {
      const sec = findSection(scopeId, sectionId); if (!sec) return;
      await withPolishLoading(btnEl || null, async () => {
        const polished = await polishOneString(sec.title || '', 'section title');
        if (polished == null) return;
        sec.title = polished;
        setScopeDirty(true);
        renderScopes();
        showToast('Section title polished', 'success');
      });
    };

    // Polish the primary text field on the item. For bullet/note that's the
    // body text; for fillable, both the label AND the value (two sequential
    // calls so each is treated with the right "kind" hint); for subtotal,
    // the label only (the amount is a number).
    (window as any).scopePolishItem = async (scopeId: string, sectionId: string, itemId: string, btnEl?: HTMLButtonElement) => {
      const sec = findSection(scopeId, sectionId); if (!sec) return;
      const it = (sec.items || []).find((x: any) => x.id === itemId);
      if (!it) return;
      await withPolishLoading(btnEl || null, async () => {
        let changed = false;
        if (it.type === 'bullet' || it.type === 'note') {
          const polished = await polishOneString(it.text || '', it.type === 'bullet' ? 'bullet point' : 'paragraph note');
          if (polished != null) { it.text = polished; changed = true; }
        } else if (it.type === 'fillable' || it.type === 'paint_line' || it.type === 'choice') {
          if ((it.label || '').trim()) {
            const kind = it.type === 'paint_line' ? 'paint/stain row label'
              : it.type === 'choice' ? 'dropdown field label'
              : 'fillable field label';
            const p1 = await polishOneString(it.label, kind);
            if (p1 != null) { it.label = p1; changed = true; }
          }
          if ((it.value || '').trim()) {
            const kind = it.type === 'paint_line' ? 'paint/stain color or product name'
              : it.type === 'choice' ? 'dropdown selected value'
              : 'fillable field value';
            const p2 = await polishOneString(it.value, kind);
            if (p2 != null) { it.value = p2; changed = true; }
          }
        } else if (it.type === 'subtotal') {
          if ((it.label || '').trim()) {
            const polished = await polishOneString(it.label, 'subtotal row label');
            if (polished != null) { it.label = polished; changed = true; }
          }
        }
        if (changed) {
          setScopeDirty(true);
          renderScopes();
          showToast('Polished', 'success');
        } else {
          showToast('Nothing to polish', 'info');
        }
      });
    };

    async function loadScopeTab() {
      await loadScopeTemplates();
      renderAddScopeTemplatePicker();
      // Parse the quote's template_sections — handles new (scoped) and legacy
      // (flat) shapes transparently.
      const raw = (selectedQuoteData as any)?.template_sections;
      scopesState = parseScopesClient(raw);
      // If empty, synthesize from legacy materials/labor so the admin sees the
      // pre-Phase-5 content as a Main scope they can edit + Save (which then
      // persists as real scope data, retiring the legacy fields for this row).
      if (scopesState.length === 0) {
        const synth = synthesizeScopeFromLegacy(selectedQuoteData as any);
        if (synth) {
          scopesState = [synth];
        } else {
          // Truly empty quote: seed one blank Main scope so the editor isn't bare.
          scopesState = [{
            id: scopeUid('scope'),
            title: 'Main scope',
            template_id: null,
            sections: [],
          }];
        }
      }
      renderScopes();
      setScopeDirty(false);
    }
    (window as any).loadScopeTab = loadScopeTab;

    // Client-side mirror of quoteToScopes() synthesis path. Used only by
    // loadScopeTab to populate the editor for pre-Phase-5 quotes.
    function synthesizeScopeFromLegacy(quote: any): any | null {
      if (!quote) return null;
      const sections: any[] = [];
      try {
        const materials = quote.materials ? JSON.parse(quote.materials) : [];
        if (Array.isArray(materials) && materials.length > 0) {
          const items = materials
            .map((m: any, i: number) => ({
              id: scopeUid('i-mat-' + i),
              type: 'bullet',
              text: String(m?.name || m?.description || '').trim(),
            }))
            .filter((it: any) => it.text);
          if (items.length) sections.push({ id: scopeUid('s-mat'), title: 'Materials', items });
        }
      } catch {}
      try {
        const labor = quote.labor ? JSON.parse(quote.labor) : [];
        if (Array.isArray(labor) && labor.length > 0) {
          const items: any[] = labor
            .map((l: any, i: number) => {
              const desc = String(l?.description || l?.name || '').trim();
              if (!desc) return null;
              const qty = Number(l?.qty);
              return { id: scopeUid('i-lab-' + i), type: 'bullet', text: qty > 1 ? `${desc} (x${qty})` : desc };
            })
            .filter((x: any) => !!x);
          const laborTotal = Number(quote.labor_total);
          if (Number.isFinite(laborTotal) && laborTotal > 0) {
            items.push({ id: scopeUid('i-lab-total'), type: 'subtotal', label: 'Labor total', amount: laborTotal });
          }
          if (items.length) sections.push({ id: scopeUid('s-lab'), title: 'Labor', items });
        }
      } catch {}
      if (sections.length === 0) return null;
      return {
        id: scopeUid('scope'),
        title: 'Main scope',
        template_id: null,
        sections,
      };
    }

    // ─── Page-level "+ Add scope from template" — appends a new scope ────
    document.getElementById('scopeAddFromTemplateBtn')?.addEventListener('click', async () => {
      if (!selectedQuoteId) return;
      const picker = document.getElementById('scopeAddTemplatePicker') as HTMLSelectElement | null;
      const tplId = picker && picker.value ? Number(picker.value) : null;
      if (!tplId) { showToast('Pick a template first', 'error'); return; }
      const btn = document.getElementById('scopeAddFromTemplateBtn') as HTMLButtonElement;
      btn.disabled = true;
      const orig = btn.textContent;
      btn.textContent = 'Adding…';
      try {
        // No scope_id → server appends a new scope titled with the template name.
        const res = await fetch(`/api/quotes/${selectedQuoteId}/apply-template/`, {
          method: 'POST', credentials: 'include',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ template_id: tplId }),
        });
        const data = await res.json() as { success?: boolean; error?: string; template_sections?: any[] };
        if (!data.success) { showToast(data.error || 'Failed to add scope', 'error'); return; }
        scopesState = Array.isArray(data.template_sections) ? data.template_sections : [];
        if (selectedQuoteData) {
          (selectedQuoteData as any).template_sections = JSON.stringify(scopesState);
        }
        renderScopes();
        setScopeDirty(false);
        showToast('Scope added from template', 'success');
      } catch {
        showToast('Failed to add scope', 'error');
      } finally {
        btn.disabled = false;
        btn.textContent = orig || '+ Add from template';
      }
    });

    // ─── "+ Empty scope" — client-side add; admin clicks Save scopes to persist
    document.getElementById('scopeAddEmptyBtn')?.addEventListener('click', () => {
      scopesState.push({
        id: scopeUid('scope'),
        title: 'New scope',
        template_id: null,
        sections: [],
      });
      setScopeDirty(true);
      renderScopes();
    });

    // (The separate "Save scopes" button was removed — scopes now persist
    // via the quote's single main Save button, which sends scopesState as
    // template_sections. See saveQuote().)

    // ─── Clear all scopes — wipes local state; admin saves to persist ─────
    document.getElementById('scopeClearAllBtn')?.addEventListener('click', () => {
      if (!scopesState.length) { showToast('No scopes to clear', 'info'); return; }
      const n = scopesState.length;
      showConfirmModal({
        title: 'Clear all scopes?',
        message: `Remove all ${n} scope${n === 1 ? '' : 's'} from this quote? Click "Save" afterwards to commit.`,
        confirmText: 'Clear scopes',
        confirmClass: 'btn-danger',
        onConfirm: () => {
          scopesState = [];
          setScopeDirty(true);
          renderScopes();
        },
      });
    });
  </script>
</body>
</html>
