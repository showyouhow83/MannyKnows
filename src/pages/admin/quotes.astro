    async function loadAcceptance() {
      currentAcceptance = null;
      renderAcceptance();
      if (!selectedQuoteId) { renderAttachments(); return; }
      const q = selectedQuoteData as any;
      const isAccepted = !!q && ['accepted', 'project'].includes(String(q.status));
      if (!isAccepted) { renderAttachments(); return; }
      const forId = selectedQuoteId;
      try {
        const res = await fetch(`/api/quotes/${forId}/acceptance`);
        const data: any = await res.json().catch(() => ({}));
        // Ignore if the admin switched quotes mid-flight.
        if (selectedQuoteId !== forId) return;
        currentAcceptance = (data && data.success && data.acceptance) ? data.acceptance : null;
      } catch { currentAcceptance = null; }
      renderAcceptance();
      renderAttachments(); // re-evaluate backfill warning now that we know the method
    }

    function escAttr(s: string): string {
      return String(s ?? '').replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }

    async function loadAttachments() {
      if (!selectedQuoteId) { currentAttachments = []; renderAttachments(); return; }
      try {
        const res = await fetch(`/api/quotes/${selectedQuoteId}/attachments/`, { credentials: 'include' });
        const data = await res.json() as { success?: boolean; attachments?: QuoteAttachment[] };
        currentAttachments = (data.success && data.attachments) || [];
      } catch {
        currentAttachments = [];
      }
      renderAttachments();
    }

    async function uploadAttachment(file: File) {
      if (!selectedQuoteId) return;
      const btn = document.getElementById('btnAddAttachment') as HTMLButtonElement | null;
      const originalHtml = btn?.innerHTML;
      if (btn) { btn.disabled = true; btn.textContent = 'Uploading...'; }

      try {
        // Default the label to the filename without extension; user can rename inline after.
        const defaultLabel = file.name.replace(/\.pdf$/i, '').slice(0, 80) || 'Estimate';
        const res = await fetch(`/api/quotes/${selectedQuoteId}/attachments/`, {
          method: 'POST',
          credentials: 'include',
          headers: {
            'Content-Type': 'application/pdf',
            'X-Attachment-Label': defaultLabel,
            'X-Attachment-Filename': file.name,
          },
          body: file,
        });
        const data = await res.json() as { success?: boolean; attachment?: QuoteAttachment; error?: string };
        if (data.success && data.attachment) {
          currentAttachments.push(data.attachment);
          renderAttachments();
          showToast('PDF attached');
        } else {
          showToast(data.error || 'Failed to upload PDF', 'error');
        }
      } catch {
        showToast('Error uploading PDF', 'error');
      }

      if (btn) {
        btn.disabled = false;
        if (originalHtml) btn.innerHTML = originalHtml;
      }
    }

