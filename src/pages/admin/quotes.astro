    // Convert HEIC/HEIF to JPEG using canvas
    async function convertHeicToJpeg(file: File): Promise<File> {
      const isHeic = file.type === 'image/heic' || file.type === 'image/heif' ||
        file.name.toLowerCase().endsWith('.heic') || file.name.toLowerCase().endsWith('.heif');
      if (!isHeic) return file;
      const bitmap = await createImageBitmap(file);
      const canvas = document.createElement('canvas');
      canvas.width = bitmap.width;
      canvas.height = bitmap.height;
      const ctx = canvas.getContext('2d')!;
      ctx.drawImage(bitmap, 0, 0);
      bitmap.close();
      const blob: Blob = await new Promise((resolve) => canvas.toBlob(resolve as any, 'image/jpeg', 0.92));
      const newName = file.name.replace(/\.heic$/i, '.jpg').replace(/\.heif$/i, '.jpg');
      return new File([blob], newName, { type: 'image/jpeg' });
    }

    async function uploadImages(files: File[]) {
      if (!selectedQuoteId) return;
      if (currentImages.length >= MAX_IMAGES) {
        showToast(`Maximum ${MAX_IMAGES} images allowed`, 'error');
        return;
      }

      const uploadBtn = document.getElementById('btnAddImage') as HTMLButtonElement | null;
      const progressBar = document.getElementById('uploadProgress') as HTMLElement;
      const progressText = document.getElementById('uploadProgressText') as HTMLElement;
      const progressFill = document.getElementById('uploadProgressFill') as HTMLElement;

      if (uploadBtn) uploadBtn.disabled = true;
      if (progressBar) progressBar.style.display = 'block';

      const total = files.length;
      let successCount = 0;
      let failCount = 0;

      for (let i = 0; i < files.length; i++) {
        let file = files[i];

        // Update progress
        const current = i + 1;
        if (progressText) progressText.textContent = `Uploading ${current}/${total}: ${file.name}`;
        if (progressFill) progressFill.style.width = `${((i) / total) * 100}%`;

        const isVideo = file.type.startsWith('video/');
        // Try client-side HEIC conversion (works in Safari); if fails, send as-is (server converts).
        // Skip for videos.
        const isHeic = !isVideo && (file.type === 'image/heic' || file.type === 'image/heif' ||
          file.name.toLowerCase().endsWith('.heic') || file.name.toLowerCase().endsWith('.heif'));
        if (isHeic && progressText) progressText.textContent = `Converting ${current}/${total}: ${file.name}`;

        if (!isVideo) {
          try {
            file = await convertHeicToJpeg(file);
          } catch (err) {
            console.log(`[Upload] Client HEIC conversion failed for ${file.name}, server will handle it`);
            if (isHeic && progressText) progressText.textContent = `Uploading ${current}/${total}: ${file.name} (server converting)`;
          }
        }

        if (currentImages.length + successCount >= MAX_IMAGES) {
          showToast(`Reached maximum of ${MAX_IMAGES} images`, 'error');
          break;
        }

        try {
          console.log(`[Upload] Uploading ${file.name} (${file.type}, ${file.size} bytes) to quote ${selectedQuoteId}`);
          const res = await fetch('/api/quotes/upload-image/', {
            method: 'POST',
            headers: {
              'Content-Type': file.type || 'image/jpeg',
              'X-Quote-Id': selectedQuoteId,
            },
            credentials: 'include',
            body: file,
          });

          const result: any = await res.json();
          console.log(`[Upload] Response for ${file.name}:`, result);

          if (result.success) {
            currentImages.push(result.imageUrl);
            successCount++;
            renderImages(currentImages);
          } else {
            console.error(`[Upload] Failed ${file.name}:`, result.error);
            showToast(`${file.name}: ${result.error || 'Upload failed'}`, 'error');
            failCount++;
          }
        } catch (err) {
          console.error(`[Upload] Error ${file.name}:`, err);
          showToast(`${file.name}: Network error`, 'error');
          failCount++;
        }

        // Update progress after each file
        if (progressFill) progressFill.style.width = `${(current / total) * 100}%`;
      }

      // Done
      if (progressText) progressText.textContent = `Done! ${successCount} uploaded${failCount > 0 ? `, ${failCount} failed` : ''}`;
      if (progressFill) progressFill.style.width = '100%';
      setTimeout(() => { if (progressBar) progressBar.style.display = 'none'; }, 2000);

      if (uploadBtn) uploadBtn.disabled = false;
      renderImages(currentImages);

      if (successCount > 0) {
        showToast(`${successCount} image${successCount > 1 ? 's' : ''} uploaded`);
      }
    }

