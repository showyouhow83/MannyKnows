---
// /admin/quote-templates — list + create quote templates.
// Editing one template happens in /admin/quote-templates/[id] (sub-page).
import { AdminAuth } from '../../lib/adminAuth';
import AdminNav from '../../components/AdminNav.astro';
import AdminMobileDrawer from '../../components/AdminMobileDrawer.astro';
import ConfirmModal from '../../components/ConfirmModal.astro';
import { DEFAULT_QUOTE_TEMPLATES } from '../../lib/quoteTemplateConstants';
import '../../styles/admin.css';

export const prerender = false;

const env = (Astro.locals as any).runtime?.env;
const sessionSecret = env?.SESSION_SECRET || env?.ADMIN_PASSWORD;
const session = await AdminAuth.validateSession(Astro.request, sessionSecret);
if (!session.isAuthenticated) {
  return Astro.redirect('/admin/');
}
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Quote Templates — MannyKnows Admin</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="robots" content="noindex, nofollow" />
    <script>
      (function() { document.documentElement.setAttribute('data-theme', 'dark'); })();
    </script>
    <style is:global>
      body {
        min-height: 100vh;
        background: var(--color-background);
        color: var(--color-text-primary);
        margin: 0;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      }
      .qt-page { max-width: 1400px; margin: 0 auto; padding: 24px 16px 48px; }
      .qt-header { display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 12px; margin-bottom: 20px; }
      .qt-header h1 { margin: 0 0 4px; font-size: 28px; font-weight: 700; }
      .qt-header p { color: var(--color-text-secondary); margin: 0; font-size: 14px; }
      .qt-actions { display: flex; gap: 8px; align-items: center; }
      .qt-actions button, .qt-actions label {
        padding: 8px 14px;
        background: var(--glass-bg);
        border: 1px solid var(--glass-border);
        color: var(--color-text-primary);
        border-radius: var(--radius-md);
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        font-family: inherit;
      }
      .qt-actions button.primary {
        background: linear-gradient(135deg, var(--color-primary), var(--color-primary-dark));
        color: #fff;
        border-color: var(--color-primary);
      }
      .qt-actions label { display: inline-flex; gap: 6px; align-items: center; user-select: none; }
      .qt-actions label input { accent-color: var(--color-primary); }

      /* Per-type project chip (replaces the per-type group titles since
         everything renders in one gallery grid now). */
      .qt-type-pill {
        display: inline-block;
        font-size: 9px; font-weight: 700;
        text-transform: uppercase; letter-spacing: 0.5px;
        padding: 2px 7px; border-radius: 4px;
        background: rgba(99, 102, 241, 0.18);
        color: #a5b4fc;
        white-space: nowrap;
        max-width: 100%;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      /* Mobile-first: fixed 3-per-row so cards stay tappable on phones.
         Desktop: tight auto-fill so a wide screen shows 7+ cards per row. */
      .qt-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 10px;
      }
      @media (min-width: 768px) {
        .qt-grid {
          grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
          gap: 12px;
        }
      }
      .qt-card {
        position: relative;
        background: var(--glass-bg);
        border: 1px solid var(--glass-border);
        border-radius: var(--radius-lg);
        padding: 12px;
        text-decoration: none;
        color: inherit;
        display: flex; flex-direction: column; gap: 6px;
        transition: filter 0.15s, transform 0.15s;
        min-width: 0;
      }
      .qt-card:hover { filter: brightness(1.1); }
      .qt-card.archived { opacity: 0.55; }
      .qt-card-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 6px; min-width: 0; }
      .qt-card-title { font-size: 13px; font-weight: 700; line-height: 1.3; word-break: break-word; }
      .qt-card-meta { font-size: 11px; color: var(--color-text-secondary); }
      /* Trash icon button overlaid on each card. stopPropagation in the
         click handler keeps the parent <a> navigation from firing. */
      .qt-card-delete,
      .qt-card-duplicate {
        position: absolute;
        top: 6px;
        width: 24px;
        height: 24px;
        background: rgba(15, 23, 42, 0.7);
        border: 1px solid var(--glass-border);
        border-radius: 6px;
        display: none;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        padding: 0;
      }
      .qt-card-delete {
        right: 6px;
        color: #fca5a5;
      }
      .qt-card-duplicate {
        right: 34px;
        color: #93c5fd;
      }
      .qt-card:hover .qt-card-delete,
      .qt-card:hover .qt-card-duplicate,
      .qt-card-delete:focus-visible,
      .qt-card-duplicate:focus-visible {
        display: inline-flex;
      }
      .qt-card-delete:hover {
        background: rgba(239, 68, 68, 0.25);
        border-color: rgba(239, 68, 68, 0.5);
        color: #fff;
      }
      .qt-card-duplicate:hover {
        background: rgba(59, 130, 246, 0.25);
        border-color: rgba(59, 130, 246, 0.5);
        color: #fff;
      }
      .qt-badges { display: flex; gap: 6px; flex-wrap: wrap; }
      .qt-badge {
        display: inline-flex; align-items: center;
        font-size: 10px; font-weight: 700;
        text-transform: uppercase; letter-spacing: 0.5px;
        padding: 3px 8px; border-radius: 999px;
      }
      .qt-badge.default {
        background: linear-gradient(135deg, var(--color-primary), var(--color-primary-dark));
        color: #fff;
      }
      .qt-badge.archived { background: rgba(148, 163, 184, 0.2); color: #94a3b8; }

      .qt-empty {
        padding: 40px 24px;
        text-align: center;
        color: var(--color-text-secondary);
        background: var(--glass-bg);
        border: 1px dashed var(--glass-border);
        border-radius: var(--radius-lg);
      }

      /* New-template modal */
      .qt-modal {
        position: fixed; inset: 0;
        background: rgba(0,0,0,0.6);
        display: none;
        align-items: center; justify-content: center;
        z-index: 1000;
        padding: 16px;
      }
      .qt-modal.active { display: flex; }
      .qt-modal-box {
        background: var(--color-background-light, var(--color-background));
        border: 1px solid var(--glass-border);
        border-radius: var(--radius-lg);
        width: 100%; max-width: 480px;
        overflow: hidden;
        display: flex; flex-direction: column;
      }
      .qt-modal-header {
        padding: 14px 18px;
        border-bottom: 1px solid var(--glass-border);
        display: flex; justify-content: space-between; align-items: center;
      }
      .qt-modal-header h2 { margin: 0; font-size: 16px; font-weight: 700; }
      .qt-modal-close { background: transparent; border: none; color: var(--color-text-secondary); font-size: 22px; line-height: 1; cursor: pointer; }
      .qt-modal-body { padding: 16px 18px; }
      .qt-modal-footer {
        padding: 12px 18px;
        border-top: 1px solid var(--glass-border);
        display: flex; gap: 8px; justify-content: flex-end;
      }
      .qt-modal-footer button {
        padding: 8px 16px; border-radius: var(--radius-md);
        font-size: 13px; font-weight: 600; cursor: pointer; font-family: inherit;
      }
      .qt-modal-footer button.cancel { background: rgba(255,255,255,0.04); border: 1px solid var(--glass-border); color: var(--color-text-primary); }
      .qt-modal-footer button.primary { background: linear-gradient(135deg, var(--color-primary), var(--color-primary-dark)); color: #fff; border: 1px solid var(--color-primary); }
      .qt-modal-footer button:disabled { opacity: 0.4; cursor: not-allowed; }
      .qt-modal-field { margin-bottom: 12px; }
      .qt-modal-field label { display: block; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: var(--color-text-secondary); margin-bottom: 4px; }
      .qt-modal-field input, .qt-modal-field select {
        width: 100%; box-sizing: border-box;
        padding: 10px 12px;
        background: rgba(255,255,255,0.04);
        border: 1px solid var(--glass-border);
        color: var(--color-text-primary);
        border-radius: var(--radius-md);
        font-size: 14px; font-family: inherit;
      }

      .toast {
        position: fixed; bottom: 24px; left: 50%; transform: translateX(-50%);
        padding: 12px 20px;
        background: var(--color-background-light, #1f2937);
        border: 1px solid var(--glass-border);
        border-radius: var(--radius-md);
        font-size: 14px; z-index: 2000;
        opacity: 0; transition: opacity 0.2s; pointer-events: none;
      }
      .toast.visible { opacity: 1; }
      .toast.success { border-color: rgba(34, 197, 94, 0.4); color: #86efac; }
      .toast.error { border-color: rgba(239, 68, 68, 0.4); color: #fca5a5; }
    </style>
  </head>
  <body>
    <header class="admin-header">
      <a href="/admin/dashboard" class="admin-logo-link">
        <div class="logo-gradient-wrapper"></div>
        <span class="admin-badge">Admin</span>
      </a>
      <AdminNav active="quotes" />
      <div class="mobile-header-right">
        <button class="mobile-nav-toggle" id="mobileNavToggle" aria-label="Toggle navigation">
          <span></span><span></span><span></span>
        </button>
      </div>
      <div class="header-actions">
        <button class="theme-toggle" id="themeToggle" onclick="toggleTheme()" title="Toggle theme">
          <svg class="icon-sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
          <svg class="icon-moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        </button>
        <button class="btn-logout" onclick="logout()">Logout</button>
      </div>
    </header>

    <AdminMobileDrawer active="quotes" />

    <main class="qt-page">
      <div class="qt-header">
        <div>
          <h1>Quote Templates</h1>
          <p>Reusable scope scaffolds applied to a quote. Edit per-quote inside the quote's Scope tab.</p>
        </div>
        <div class="qt-actions">
          <label><input type="checkbox" id="showArchived" onchange="loadTemplates()"> Show archived</label>
          <button id="seedBtn" onclick="seedStarterTemplates()" title="Create one starter scope-of-work template per service">Add starter templates</button>
          <button class="primary" onclick="openNewModal()">+ New template</button>
        </div>
      </div>

      <div id="qtList">
        <div class="qt-empty">Loading…</div>
      </div>
    </main>

    <!-- New template modal -->
    <div class="qt-modal" id="newModal" onclick="if(event.target===this) closeNewModal()">
      <div class="qt-modal-box">
        <div class="qt-modal-header">
          <h2>New quote template</h2>
          <button class="qt-modal-close" onclick="closeNewModal()">&times;</button>
        </div>
        <div class="qt-modal-body">
          <div class="qt-modal-field">
            <label for="newName">Name</label>
            <input id="newName" type="text" placeholder="e.g. Kitchen — Cabinets & Countertops Only" />
          </div>
          <div class="qt-modal-field">
            <label for="newType">Project type</label>
            <select id="newType">
              <option value="kitchen_remodel">Kitchen Remodeling</option>
              <option value="bathroom_remodel">Bathroom Remodeling</option>
              <option value="interior_painting">Interior Painting</option>
              <option value="flooring">Flooring</option>
              <option value="general_repairs">General Repairs & Handyman</option>
              <option value="other">Other</option>
            </select>
          </div>
          <p style="font-size:12px;color:var(--color-text-secondary);margin:0;">A blank template will be created with one starter section — you'll add sections + items on the next page.</p>
        </div>
        <div class="qt-modal-footer">
          <button class="cancel" onclick="closeNewModal()">Cancel</button>
          <button class="primary" id="newSubmitBtn" onclick="submitNew()">Create</button>
        </div>
      </div>
    </div>

    <div class="toast" id="toast"></div>

    <ConfirmModal />

    <!-- Starter template payloads (one per MK service) — data lives in
         src/lib/quoteTemplateConstants.ts (DEFAULT_QUOTE_TEMPLATES). -->
    <script type="application/json" id="starterTemplatesData" set:html={JSON.stringify(DEFAULT_QUOTE_TEMPLATES)}></script>

    <script is:inline>
      (function() {
        const saved = localStorage.getItem('admin-theme');
        document.documentElement.setAttribute('data-theme', saved || 'dark');
      })();
      function toggleTheme() {
        const cur = document.documentElement.getAttribute('data-theme') || 'dark';
        const next = cur === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', next);
        localStorage.setItem('admin-theme', next);
      }
      async function logout() {
        await fetch('/api/admin/logout/', { method: 'POST' });
        window.location.href = '/admin';
      }

      const mobileNavToggle = document.getElementById('mobileNavToggle');
      const mobileNavPanel = document.getElementById('mobileNavPanel');
      const mobileNavOverlay = document.getElementById('mobileNavOverlay');
      const mobileNavClose = document.getElementById('mobileNavClose');
      function openMobileNav() {
        mobileNavToggle?.classList.add('active');
        mobileNavPanel?.classList.add('active');
        mobileNavOverlay?.classList.add('active');
        document.body.style.overflow = 'hidden';
      }
      function closeMobileNav() {
        mobileNavToggle?.classList.remove('active');
        mobileNavPanel?.classList.remove('active');
        mobileNavOverlay?.classList.remove('active');
        document.body.style.overflow = '';
      }
      mobileNavToggle?.addEventListener('click', () => {
        if (mobileNavPanel?.classList.contains('active')) closeMobileNav();
        else openMobileNav();
      });
      mobileNavClose?.addEventListener('click', closeMobileNav);
      mobileNavOverlay?.addEventListener('click', closeMobileNav);

      const TYPE_LABEL = {
        kitchen_remodel: 'Kitchen Remodeling',
        bathroom_remodel: 'Bathroom Remodeling',
        interior_painting: 'Interior Painting',
        flooring: 'Flooring',
        general_repairs: 'General Repairs & Handyman',
        other: 'Other',
      };

      function showToast(msg, type) {
        const el = document.getElementById('toast');
        el.textContent = msg;
        el.className = 'toast visible ' + (type || '');
        clearTimeout(window._toastTimer);
        window._toastTimer = setTimeout(() => el.classList.remove('visible'), 2500);
      }
      function escapeHtml(s) {
        return String(s == null ? '' : s)
          .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
      }

      async function loadTemplates() {
        const list = document.getElementById('qtList');
        const showArchived = document.getElementById('showArchived').checked ? '?archived=1' : '';
        try {
          const res = await fetch('/api/admin/quote-templates/' + showArchived, { credentials: 'include' });
          const data = await res.json();
          if (!data.success) { showToast(data.error || 'Failed to load', 'error'); return; }
          const templates = data.templates || [];
          if (!templates.length) {
            list.innerHTML = '<div class="qt-empty">No templates yet. Click <strong>Add starter templates</strong> to seed one scope-of-work skeleton per service, or <strong>+ New template</strong> to start from scratch.</div>';
            return;
          }
          // One gallery grid — every template is a card. Project type renders
          // as a pill inside the card. Cards sort by project_type then name
          // so similar templates cluster visually.
          const order = ['kitchen_remodel', 'bathroom_remodel', 'interior_painting', 'flooring', 'general_repairs', 'other'];
          const orderRank = (t) => {
            const k = (t.project_type || 'other').toLowerCase();
            const i = order.indexOf(k);
            return i === -1 ? 999 : i;
          };
          templates.sort((a, b) => {
            const r = orderRank(a) - orderRank(b);
            if (r !== 0) return r;
            return String(a.name || '').localeCompare(String(b.name || ''));
          });
          const cards = templates.map(t => {
            const badges = [];
            if (t.is_default) badges.push('<span class="qt-badge default">Default</span>');
            if (t.archived) badges.push('<span class="qt-badge archived">Archived</span>');
            const typeLabel = TYPE_LABEL[t.project_type] || t.project_type || 'Other';
            return `
              <a class="qt-card${t.archived ? ' archived' : ''}" href="/admin/quote-templates/${t.id}/">
                <button class="qt-card-duplicate" type="button" title="Duplicate" aria-label="Duplicate" onclick="duplicateTemplate(event, ${t.id})">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                </button>
                <button class="qt-card-delete" type="button" title="Delete forever" aria-label="Delete forever" onclick="hardDeleteTemplate(event, ${t.id}, '${escapeHtml(t.name).replace(/'/g, "\\'")}')">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6M14 11v6"/></svg>
                </button>
                <div class="qt-card-head">
                  <div class="qt-card-title">${escapeHtml(t.name)}</div>
                </div>
                <div class="qt-type-pill">${escapeHtml(typeLabel)}</div>
                <div class="qt-badges">${badges.join('')}</div>
                <div class="qt-card-meta">${t.section_count} section${t.section_count === 1 ? '' : 's'}</div>
              </a>
            `;
          }).join('');
          list.innerHTML = `<div class="qt-grid">${cards}</div>`;
        } catch {
          showToast('Failed to load templates', 'error');
        }
      }

      function openNewModal() {
        document.getElementById('newName').value = '';
        document.getElementById('newType').value = 'kitchen_remodel';
        document.getElementById('newModal').classList.add('active');
        document.body.style.overflow = 'hidden';
      }
      function closeNewModal() {
        document.getElementById('newModal').classList.remove('active');
        document.body.style.overflow = '';
      }
      window.openNewModal = openNewModal;
      window.closeNewModal = closeNewModal;

      async function submitNew() {
        const name = document.getElementById('newName').value.trim();
        const project_type = document.getElementById('newType').value;
        if (!name) { showToast('Name is required', 'error'); return; }
        const btn = document.getElementById('newSubmitBtn');
        btn.disabled = true; btn.textContent = 'Creating…';
        try {
          // Blank starter — admin fills it out on the editor page
          const sections = [
            { id: 's-' + Date.now(), title: 'Untitled Section', items: [] }
          ];
          const res = await fetch('/api/admin/quote-templates/', {
            method: 'POST',
            credentials: 'include',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ name, project_type, sections }),
          });
          const data = await res.json();
          if (!data.success || !data.id) {
            showToast(data.error || 'Failed to create', 'error');
            btn.disabled = false; btn.textContent = 'Create';
            return;
          }
          window.location.href = `/admin/quote-templates/${data.id}/`;
        } catch {
          showToast('Failed to create template', 'error');
          btn.disabled = false; btn.textContent = 'Create';
        }
      }
      window.submitNew = submitNew;
      window.loadTemplates = loadTemplates;

      // Hard delete — drops the row entirely. Quotes that previously applied
      // the template keep their frozen copy in template_sections, so this
      // doesn't break historical quotes.
      async function hardDeleteTemplate(evt, id, name) {
        evt.preventDefault();
        evt.stopPropagation();
        window.showConfirmModal({
          title: `Delete "${name}" forever?`,
          text: "Quotes that already applied it keep their copy. This can't be undone.",
          confirmText: 'Delete forever',
          type: 'danger',
          onConfirm: async () => {
            try {
              const res = await fetch(`/api/admin/quote-templates/${id}/?hard=1`, {
                method: 'DELETE',
                credentials: 'include',
              });
              const data = await res.json();
              if (!data.success) { showToast(data.error || 'Delete failed', 'error'); return; }
              showToast('Template deleted', 'success');
              loadTemplates();
            } catch {
              showToast('Delete failed', 'error');
            }
          },
        });
      }
      window.hardDeleteTemplate = hardDeleteTemplate;

      async function duplicateTemplate(evt, id) {
        evt.preventDefault();
        evt.stopPropagation();
        const btn = evt.currentTarget;
        const origHtml = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '⏳';
        try {
          // Fetch the full template (sections are not in the list view)
          const getRes = await fetch(`/api/admin/quote-templates/${id}/`, { credentials: 'include' });
          const getData = await getRes.json();
          if (!getData.success || !getData.template) {
            showToast('Could not load template', 'error');
            btn.disabled = false; btn.innerHTML = origHtml;
            return;
          }
          const src = getData.template;
          const copyName = src.name + ' (copy)';
          const postRes = await fetch('/api/admin/quote-templates/', {
            method: 'POST',
            credentials: 'include',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              name: copyName,
              project_type: src.project_type,
              sections: src.sections,
            }),
          });
          const postData = await postRes.json();
          if (!postData.success || !postData.id) {
            showToast(postData.error || 'Failed to duplicate', 'error');
            btn.disabled = false; btn.innerHTML = origHtml;
            return;
          }
          window.location.href = `/admin/quote-templates/${postData.id}/`;
        } catch {
          showToast('Failed to duplicate template', 'error');
          btn.disabled = false; btn.innerHTML = origHtml;
        }
      }
      window.duplicateTemplate = duplicateTemplate;

      // Seed the five MK starter templates (one per service). Skips any
      // service that already has a template of the same name so re-clicking
      // never duplicates. Data comes from the JSON island above.
      async function seedStarterTemplates() {
        const btn = document.getElementById('seedBtn');
        let starters = [];
        try {
          starters = JSON.parse(document.getElementById('starterTemplatesData').textContent || '[]');
        } catch {}
        if (!starters.length) { showToast('No starter data found', 'error'); return; }
        btn.disabled = true; btn.textContent = 'Adding…';
        try {
          // Fetch existing names so seeding is idempotent.
          const res = await fetch('/api/admin/quote-templates/?archived=1', { credentials: 'include' });
          const data = await res.json();
          const existingNames = new Set((data.templates || []).map(t => String(t.name || '').toLowerCase()));
          let created = 0, skipped = 0;
          for (const t of starters) {
            if (existingNames.has(String(t.name).toLowerCase())) { skipped++; continue; }
            const postRes = await fetch('/api/admin/quote-templates/', {
              method: 'POST',
              credentials: 'include',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                name: t.name,
                project_type: t.project_type,
                sections: t.sections,
                is_default: t.is_default ? 1 : 0,
              }),
            });
            const postData = await postRes.json();
            if (postData.success) created++;
          }
          showToast(created ? `Added ${created} starter template${created === 1 ? '' : 's'}${skipped ? ` (${skipped} already existed)` : ''}` : 'Starter templates already exist', created ? 'success' : '');
          loadTemplates();
        } catch {
          showToast('Failed to add starter templates', 'error');
        } finally {
          btn.disabled = false; btn.textContent = 'Add starter templates';
        }
      }
      window.seedStarterTemplates = seedStarterTemplates;

      loadTemplates();
    </script>
  </body>
</html>
