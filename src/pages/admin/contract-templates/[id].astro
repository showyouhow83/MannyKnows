---
// /admin/contract-templates/[id] — editor for one contract template.
// Same scope/section/item editor as quote templates plus two extra panels
// at the top: payment-schedule defaults and terms (marketing release,
// reference request, custom clauses).
import { env as cfEnv } from 'cloudflare:workers';
import { AdminAuth } from '../../../lib/adminAuth';
import AdminNav from '../../../components/AdminNav.astro';
import AdminMobileDrawer from '../../../components/AdminMobileDrawer.astro';
import ConfirmModal from '../../../components/ConfirmModal.astro';
import '../../../styles/admin.css';

export const prerender = false;

const env = cfEnv;
const sessionSecret = env?.SESSION_SECRET || env?.ADMIN_PASSWORD;
const session = await AdminAuth.validateSession(Astro.request, sessionSecret);
if (!session.isAuthenticated) {
  return Astro.redirect('/admin/');
}

const templateId = Number(Astro.params.id);
if (!templateId || Number.isNaN(templateId)) {
  return Astro.redirect('/admin/contract-templates');
}
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Edit Contract Template — MannyKnows Admin</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="robots" content="noindex, nofollow" />
    <script>
      (function() { document.documentElement.setAttribute('data-theme', 'dark'); })();
    </script>
    <style is:global>
      body {
        min-height: 100vh;
        background: var(--color-background);
        color: var(--color-text-primary);
        margin: 0;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      }
      .ce-page { max-width: 980px; margin: 0 auto; padding: 24px 16px 80px; }

      .ce-toolbar {
        position: sticky; top: 0; z-index: 5;
        background: var(--color-background);
        padding: 16px 0 12px;
        border-bottom: 1px solid var(--glass-border);
        display: flex; flex-wrap: wrap; gap: 12px; align-items: center;
        margin-bottom: 20px;
      }
      .ce-back {
        text-decoration: none; color: var(--color-text-secondary);
        font-size: 13px; font-weight: 600;
        display: inline-flex; align-items: center; gap: 4px;
      }
      .ce-back:hover { color: var(--color-text-primary); }
      .ce-toolbar-spacer { flex: 1; }
      .ce-status { font-size: 12px; color: var(--color-text-secondary); }
      .ce-status.dirty { color: #fbbf24; }
      .ce-status.saved { color: #86efac; }
      .ce-toolbar button {
        padding: 8px 14px;
        background: var(--glass-bg);
        border: 1px solid var(--glass-border);
        color: var(--color-text-primary);
        border-radius: var(--radius-md);
        font-size: 13px; font-weight: 600;
        cursor: pointer; font-family: inherit;
      }
      .ce-toolbar button.primary {
        background: linear-gradient(135deg, var(--color-primary), #e05f00);
        color: #fff; border-color: var(--color-primary);
      }
      .ce-toolbar button.danger {
        color: #fca5a5; border-color: rgba(239, 68, 68, 0.3);
      }
      .ce-toolbar button:disabled { opacity: 0.4; cursor: not-allowed; }

      /* Panels above the scope/section editor. Each is a labeled card with
         its own field grid so admin can audit defaults at a glance. */
      .ce-panel {
        background: var(--glass-bg);
        border: 1px solid var(--glass-border);
        border-radius: var(--radius-lg);
        padding: 16px 18px;
        margin-bottom: 16px;
      }
      .ce-panel-title {
        font-size: 14px; font-weight: 700;
        margin: 0 0 4px;
      }
      .ce-panel-sub {
        font-size: 12px;
        color: var(--color-text-secondary);
        margin: 0 0 14px;
      }

      .ce-head-grid {
        display: grid;
        grid-template-columns: 2fr 1fr auto;
        gap: 10px;
        align-items: end;
      }
      @media (max-width: 700px) {
        .ce-head-grid { grid-template-columns: 1fr 1fr; }
      }
      .ce-pay-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 10px;
      }
      @media (max-width: 900px) { .ce-pay-grid { grid-template-columns: repeat(2, 1fr); } }
      @media (max-width: 480px) { .ce-pay-grid { grid-template-columns: 1fr; } }

      .ce-field label {
        display: block; font-size: 10px; font-weight: 700;
        text-transform: uppercase; letter-spacing: 0.5px;
        color: var(--color-text-secondary); margin-bottom: 4px;
      }
      .ce-field input, .ce-field select, .ce-field textarea {
        width: 100%; box-sizing: border-box;
        padding: 10px 12px;
        background: rgba(255,255,255,0.04);
        border: 1px solid var(--glass-border);
        color: var(--color-text-primary);
        border-radius: var(--radius-md);
        font-size: 14px; font-family: inherit;
        resize: vertical;
      }
      .ce-toggle {
        display: inline-flex; align-items: center; gap: 6px;
        padding: 10px 12px;
        background: rgba(255,255,255,0.04);
        border: 1px solid var(--glass-border);
        border-radius: var(--radius-md);
        cursor: pointer;
        font-size: 13px; font-weight: 600;
        user-select: none; white-space: nowrap;
      }
      .ce-toggle input { accent-color: var(--color-primary); }

      /* Terms block fields */
      .ce-terms-row {
        display: grid;
        grid-template-columns: auto 1fr;
        gap: 12px; align-items: start;
        padding: 10px 0;
        border-top: 1px dashed var(--glass-border);
      }
      .ce-terms-row:first-of-type { border-top: 0; padding-top: 0; }
      .ce-terms-row .ce-toggle { align-self: start; }

      /* Section card */
      .ce-section {
        background: var(--glass-bg);
        border: 1px solid var(--glass-border);
        border-radius: var(--radius-lg);
        padding: 14px 16px;
        margin-bottom: 14px;
      }
      .ce-section-head {
        display: flex; gap: 10px; align-items: center;
        margin-bottom: 12px;
      }
      .ce-section-title {
        flex: 1;
        padding: 8px 10px;
        background: rgba(255,255,255,0.04);
        border: 1px solid var(--glass-border);
        color: var(--color-text-primary);
        border-radius: var(--radius-md);
        font-size: 15px; font-weight: 700; font-family: inherit;
      }
      .ce-icon-btn {
        width: 30px; height: 30px;
        background: rgba(255,255,255,0.04);
        border: 1px solid var(--glass-border);
        color: var(--color-text-secondary);
        border-radius: var(--radius-sm);
        cursor: pointer;
        display: inline-flex; align-items: center; justify-content: center;
        flex-shrink: 0;
      }
      .ce-icon-btn:hover { color: var(--color-text-primary); background: rgba(255,255,255,0.07); }
      .ce-icon-btn.danger:hover { color: #fca5a5; background: rgba(239, 68, 68, 0.1); }
      .ce-icon-btn:disabled { opacity: 0.3; cursor: not-allowed; }

      /* Hide section + item reorder/delete buttons until focused inside.
         Matches the active-state-only pattern used in the quote editor. */
      .ce-section .ce-icon-btn,
      .ce-item-actions {
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.15s ease;
      }
      .ce-section:focus-within > .ce-section-head .ce-icon-btn,
      .ce-item:focus-within .ce-item-actions {
        opacity: 1;
        pointer-events: auto;
      }

      .ce-item {
        display: flex; gap: 8px; align-items: flex-start;
        padding: 8px;
        background: rgba(255,255,255,0.02);
        border: 1px solid rgba(255,255,255,0.05);
        border-radius: var(--radius-sm);
        margin-bottom: 6px;
      }
      .ce-item-type {
        flex-shrink: 0;
        width: 76px;
        font-size: 9px; font-weight: 700;
        text-transform: uppercase; letter-spacing: 0.5px;
        color: var(--color-text-secondary);
        padding: 6px 0; text-align: center;
        background: rgba(255,255,255,0.03);
        border-radius: var(--radius-sm);
      }
      .ce-item-fields { flex: 1; display: flex; flex-direction: column; gap: 6px; min-width: 0; }
      .ce-item-fields input, .ce-item-fields textarea {
        width: 100%; box-sizing: border-box;
        padding: 8px 10px;
        background: rgba(255,255,255,0.04);
        border: 1px solid var(--glass-border);
        color: var(--color-text-primary);
        border-radius: var(--radius-sm);
        font-size: 13px; font-family: inherit;
        resize: vertical;
      }
      .ce-item-fields textarea { min-height: 50px; line-height: 1.4; }
      .ce-item-actions { display: flex; flex-direction: column; gap: 4px; flex-shrink: 0; }

      .ce-item-row { display: flex; gap: 6px; }
      .ce-item-row > * { flex: 1; }
      .ce-amount-field { max-width: 130px; }

      .ce-add-row {
        display: flex; flex-wrap: wrap; gap: 6px;
        padding-top: 8px;
        border-top: 1px dashed var(--glass-border);
        margin-top: 8px;
      }
      .ce-add-row button {
        padding: 6px 12px;
        background: rgba(255,255,255,0.04);
        border: 1px solid var(--glass-border);
        color: var(--color-text-primary);
        border-radius: var(--radius-sm);
        font-size: 12px; font-weight: 600;
        cursor: pointer; font-family: inherit;
      }
      .ce-add-row button:hover { background: rgba(255,255,255,0.08); }

      .ce-add-section {
        display: block;
        width: 100%;
        padding: 14px;
        background: rgba(255,255,255,0.02);
        border: 1.5px dashed var(--glass-border);
        color: var(--color-text-secondary);
        border-radius: var(--radius-md);
        font-size: 14px; font-weight: 600;
        cursor: pointer; font-family: inherit;
        text-align: center;
      }
      .ce-add-section:hover { background: rgba(255,255,255,0.04); color: var(--color-text-primary); }

      .ce-empty { padding: 40px; text-align: center; color: var(--color-text-secondary); }

      .toast {
        position: fixed; bottom: 24px; left: 50%; transform: translateX(-50%);
        padding: 12px 20px;
        background: var(--color-background-light, #1f2937);
        border: 1px solid var(--glass-border);
        border-radius: var(--radius-md);
        font-size: 14px; z-index: 2000;
        opacity: 0; transition: opacity 0.2s; pointer-events: none;
      }
      .toast.visible { opacity: 1; }
      .toast.success { border-color: rgba(34, 197, 94, 0.4); color: #86efac; }
      .toast.error { border-color: rgba(239, 68, 68, 0.4); color: #fca5a5; }
    </style>
  </head>
  <body>
    <header class="admin-header">
      <a href="/admin/dashboard" class="admin-logo-link">
        <div class="logo-gradient-wrapper"></div>
        <span class="admin-badge">Admin</span>
      </a>
      <AdminNav active="projects" />
      <div class="mobile-header-right">
        <button class="mobile-nav-toggle" id="mobileNavToggle" aria-label="Toggle navigation">
          <span></span><span></span><span></span>
        </button>
      </div>
      <div class="header-actions">
        <button class="btn-logout" onclick="logout()">Logout</button>
      </div>
    </header>

    <AdminMobileDrawer active="projects" />

    <main class="ce-page" data-template-id={String(templateId)}>
      <div class="ce-toolbar">
        <a class="ce-back" href="/admin/contract-templates">← All contract templates</a>
        <span class="ce-toolbar-spacer"></span>
        <span class="ce-status" id="saveStatus"></span>
        <button id="archiveBtn" class="danger" onclick="archiveTemplate()">Archive</button>
        <button id="deleteForeverBtn" class="danger" onclick="hardDeleteTemplate()" style="border-color:rgba(239,68,68,0.5); color:#fca5a5;">Delete forever</button>
        <button id="saveBtn" class="primary" onclick="saveTemplate()" disabled>Save</button>
      </div>

      <div id="ceShell">
        <div class="ce-empty">Loading template…</div>
      </div>
    </main>

    <div class="toast" id="toast"></div>

    <ConfirmModal />

    <script is:inline>
      (function() {
        const saved = localStorage.getItem('admin-theme');
        document.documentElement.setAttribute('data-theme', saved || 'dark');
      })();
      async function logout() {
        await fetch('/api/admin/logout/', { method: 'POST' });
        window.location.href = '/admin';
      }

      const mobileNavToggle = document.getElementById('mobileNavToggle');
      const mobileNavPanel = document.getElementById('mobileNavPanel');
      const mobileNavOverlay = document.getElementById('mobileNavOverlay');
      const mobileNavClose = document.getElementById('mobileNavClose');
      mobileNavToggle?.addEventListener('click', () => {
        const isActive = mobileNavPanel?.classList.contains('active');
        mobileNavToggle?.classList.toggle('active', !isActive);
        mobileNavPanel?.classList.toggle('active', !isActive);
        mobileNavOverlay?.classList.toggle('active', !isActive);
        document.body.style.overflow = !isActive ? 'hidden' : '';
      });
      mobileNavClose?.addEventListener('click', () => {
        mobileNavToggle?.classList.remove('active');
        mobileNavPanel?.classList.remove('active');
        mobileNavOverlay?.classList.remove('active');
        document.body.style.overflow = '';
      });
      mobileNavOverlay?.addEventListener('click', () => mobileNavClose?.click());

      function showToast(msg, type) {
        const el = document.getElementById('toast');
        el.textContent = msg;
        el.className = 'toast visible ' + (type || '');
        clearTimeout(window._toastTimer);
        window._toastTimer = setTimeout(() => el.classList.remove('visible'), 2500);
      }
      function escapeHtml(s) {
        return String(s == null ? '' : s)
          .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
      }
      function escapeAttr(s) {
        return String(s == null ? '' : s).replace(/"/g, '&quot;');
      }
      function uid(prefix) {
        return `${prefix}-${Date.now()}-${Math.random().toString(36).slice(2, 8)}`;
      }

      // ===== State =====
      const templateId = Number(document.querySelector('.ce-page').dataset.templateId);
      // template mirrors the DB row plus the parsed `sections` and `terms`.
      let template = null;
      let dirty = false;

      function setDirty(d) {
        dirty = d;
        const status = document.getElementById('saveStatus');
        const saveBtn = document.getElementById('saveBtn');
        if (d) {
          status.textContent = 'Unsaved changes';
          status.className = 'ce-status dirty';
          saveBtn.disabled = false;
        } else {
          status.textContent = 'All changes saved';
          status.className = 'ce-status saved';
          saveBtn.disabled = true;
        }
      }

      async function loadTemplate() {
        try {
          const res = await fetch(`/api/admin/contract-templates/${templateId}/`, { credentials: 'include' });
          const data = await res.json();
          if (!data.success || !data.template) {
            document.getElementById('ceShell').innerHTML = `<div class="ce-empty">${data.error || 'Template not found'}</div>`;
            return;
          }
          template = data.template;
          if (!Array.isArray(template.sections)) template.sections = [];
          if (!template.terms || typeof template.terms !== 'object') template.terms = {};
          // Make sure the standard term blocks always exist so the toggles
          // render even on legacy rows.
          template.terms.marketing_release ??= { enabled: false, text: '' };
          template.terms.reference_request ??= { enabled: false, text: 'Can we use you as a reference?' };
          template.terms.custom_terms ??= [];
          render();
          setDirty(false);
        } catch {
          showToast('Failed to load template', 'error');
        }
      }

      function render() {
        const shell = document.getElementById('ceShell');
        const archiveBtn = document.getElementById('archiveBtn');
        archiveBtn.textContent = template.archived ? 'Restore' : 'Archive';
        archiveBtn.classList.toggle('danger', !template.archived);

        let html = '';

        // ── Panel: Identity (name + type + default toggle) ──
        const PROJECT_TYPES = [
          ['website-basic', 'AI Smart Website I'],
          ['website-plus', 'AI Smart Website II'],
          ['website-smart', 'AI Smart Website III'],
          ['ecommerce', 'AI Smart eCommerce'],
          ['business-ads', 'Business Ads'],
          ['multimedia-agency', 'Multimedia Agency'],
          ['ai-team', 'AI Team'],
          ['custom-app', 'Custom Web App'],
          ['other', 'Other'],
        ];
        html += `<div class="ce-panel">
          <div class="ce-head-grid">
            <div class="ce-field"><label>Name</label><input id="tplName" type="text" value="${escapeAttr(template.name)}"></div>
            <div class="ce-field"><label>Project type</label><select id="tplType">${
              PROJECT_TYPES.map(([v, l]) =>
                `<option value="${v}"${template.project_type === v ? ' selected' : ''}>${l}</option>`
              ).join('')
            }</select></div>
            <label class="ce-toggle"><input id="tplDefault" type="checkbox"${template.is_default ? ' checked' : ''}> Default for type</label>
          </div>
        </div>`;

        // ── Panel: Payment Schedule defaults ──
        html += `<div class="ce-panel">
          <h3 class="ce-panel-title">Payment schedule defaults</h3>
          <p class="ce-panel-sub">Used to auto-generate the payment plan on any project that applies this template. Each value can still be overridden per project.</p>
          <div class="ce-pay-grid">
            <div class="ce-field"><label>Down payment %</label><input id="dpPct" type="number" step="1" min="0" max="100" value="${template.down_payment_percent}"></div>
            <div class="ce-field"><label># down payments</label><input id="dpCount" type="number" step="1" min="0" max="12" value="${template.down_payment_count}"></div>
            <div class="ce-field"><label># monthly payments</label><input id="mpCount" type="number" step="1" min="0" max="60" value="${template.monthly_payment_count}"></div>
            <div class="ce-field"><label>Warranty (months)</label><input id="warranty" type="number" step="1" min="0" max="240" value="${template.warranty_months}"></div>
            <div class="ce-field"><label>Cancel window (days)</label><input id="cancelDays" type="number" step="1" min="0" max="30" value="${template.cancellation_window_days}"></div>
            <div class="ce-field"><label>Cancel fee ($)</label><input id="cancelFee" type="number" step="0.01" min="0" value="${template.cancellation_fee_amount}"></div>
            <div class="ce-field"><label>Late fee grace (days)</label><input id="lateGrace" type="number" step="1" min="0" max="30" value="${template.late_fee_grace_days}"></div>
            <div class="ce-field"><label>Late fee ($)</label><input id="lateFee" type="number" step="0.01" min="0" value="${template.late_fee_amount}"></div>
          </div>
        </div>`;

        // ── Panel: Terms ──
        const mr = template.terms.marketing_release || { enabled: false, text: '' };
        const rr = template.terms.reference_request || { enabled: false, text: '' };
        const customTerms = Array.isArray(template.terms.custom_terms) ? template.terms.custom_terms : [];
        html += `<div class="ce-panel">
          <h3 class="ce-panel-title">Terms &amp; clauses</h3>
          <p class="ce-panel-sub">Standard contract clauses. Toggle off any you don't want on this template.</p>

          <div class="ce-terms-row">
            <label class="ce-toggle"><input id="termMrEnabled" type="checkbox"${mr.enabled ? ' checked' : ''}> Marketing release</label>
            <div class="ce-field"><label>Clause text</label><textarea id="termMrText" rows="2" placeholder="MannyKnows will be taking photos and videos…">${escapeHtml(mr.text || '')}</textarea></div>
          </div>

          <div class="ce-terms-row">
            <label class="ce-toggle"><input id="termRrEnabled" type="checkbox"${rr.enabled ? ' checked' : ''}> Reference request (Y/N)</label>
            <div class="ce-field"><label>Question text</label><input id="termRrText" type="text" value="${escapeAttr(rr.text || '')}" placeholder="Can we use you as a reference?"></div>
          </div>

          <div style="margin-top:12px;">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
              <span style="font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:0.5px; color:var(--color-text-secondary);">Custom terms (extra clauses)</span>
              <button class="ce-icon-btn" style="width:auto; padding:6px 10px;" onclick="addCustomTerm()" title="Add custom term">+ Add</button>
            </div>
            <div id="customTermsList">${
              customTerms.length === 0
                ? '<div style="font-size:12px; color:var(--color-text-secondary); font-style:italic; padding:6px 0;">No extra clauses.</div>'
                : customTerms.map((ct, i) => `
                  <div class="ce-terms-row" data-ct-index="${i}">
                    <button class="ce-icon-btn danger" onclick="removeCustomTerm(${i})" title="Remove">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                    </button>
                    <div class="ce-field" style="display:flex; flex-direction:column; gap:6px;">
                      <input type="text" oninput="updateCustomTerm(${i}, 'title', this.value)" value="${escapeAttr(ct.title || '')}" placeholder="Clause title">
                      <textarea rows="2" oninput="updateCustomTerm(${i}, 'text', this.value)" placeholder="Clause text…">${escapeHtml(ct.text || '')}</textarea>
                    </div>
                  </div>
                `).join('')
            }</div>
          </div>
        </div>`;

        // ── Panel: Scope sections ──
        html += `<div class="ce-panel">
          <h3 class="ce-panel-title">Scope sections</h3>
          <p class="ce-panel-sub">Body of the contract — same structure as quote templates (Surface Prep, Painting Process, etc.).</p>
        `;
        if (!template.sections.length) {
          html += '<div class="ce-empty">No sections yet — add the first one below.</div>';
        }
        template.sections.forEach((section, sIdx) => {
          html += renderSection(section, sIdx);
        });
        html += `<button class="ce-add-section" onclick="addSection()">+ Add section</button>`;
        html += `</div>`;

        shell.innerHTML = html;

        // Wire identity panel listeners
        document.getElementById('tplName').addEventListener('input', (e) => { template.name = e.target.value; setDirty(true); });
        document.getElementById('tplType').addEventListener('change', (e) => { template.project_type = e.target.value; setDirty(true); });
        document.getElementById('tplDefault').addEventListener('change', (e) => { template.is_default = e.target.checked ? 1 : 0; setDirty(true); });

        // Wire payment-schedule listeners. Numeric inputs feed straight into
        // template fields; clampNumber on the server validates ranges again.
        const numericBindings = [
          ['dpPct', 'down_payment_percent'],
          ['dpCount', 'down_payment_count'],
          ['mpCount', 'monthly_payment_count'],
          ['warranty', 'warranty_months'],
          ['cancelDays', 'cancellation_window_days'],
          ['cancelFee', 'cancellation_fee_amount'],
          ['lateGrace', 'late_fee_grace_days'],
          ['lateFee', 'late_fee_amount'],
        ];
        for (const [elId, field] of numericBindings) {
          document.getElementById(elId)?.addEventListener('input', (e) => {
            const n = Number(e.target.value);
            template[field] = Number.isFinite(n) ? n : 0;
            setDirty(true);
          });
        }

        // Wire terms listeners (marketing + reference)
        document.getElementById('termMrEnabled').addEventListener('change', (e) => {
          template.terms.marketing_release.enabled = e.target.checked;
          setDirty(true);
        });
        document.getElementById('termMrText').addEventListener('input', (e) => {
          template.terms.marketing_release.text = e.target.value;
          setDirty(true);
        });
        document.getElementById('termRrEnabled').addEventListener('change', (e) => {
          template.terms.reference_request.enabled = e.target.checked;
          setDirty(true);
        });
        document.getElementById('termRrText').addEventListener('input', (e) => {
          template.terms.reference_request.text = e.target.value;
          setDirty(true);
        });
      }

      function renderSection(section, sIdx) {
        const lastIdx = template.sections.length - 1;
        let html = `<div class="ce-section" data-section-id="${section.id}">`;
        html += `<div class="ce-section-head">
          <input class="ce-section-title" type="text" value="${escapeAttr(section.title)}" oninput="updateSectionTitle('${section.id}', this.value)" placeholder="Section title">
          <button class="ce-icon-btn" ${sIdx === 0 ? 'disabled' : ''} onclick="moveSection('${section.id}', -1)" title="Move up">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="18 15 12 9 6 15"/></svg>
          </button>
          <button class="ce-icon-btn" ${sIdx === lastIdx ? 'disabled' : ''} onclick="moveSection('${section.id}', 1)" title="Move down">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
          <button class="ce-icon-btn danger" onclick="deleteSection('${section.id}')" title="Delete section">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6M14 11v6"/></svg>
          </button>
        </div>`;

        section.items.forEach((item, iIdx) => {
          html += renderItem(section.id, item, iIdx, section.items.length);
        });

        html += `<div class="ce-add-row">
          <button onclick="addItem('${section.id}', 'bullet')">+ Bullet</button>
          <button onclick="addItem('${section.id}', 'fillable')">+ Color line</button>
          <button onclick="addItem('${section.id}', 'choice')" title="Labeled dropdown — admin defines the options">+ Choice</button>
          <button onclick="addItem('${section.id}', 'subtotal')">+ Subtotal</button>
          <button onclick="addItem('${section.id}', 'note')">+ Note</button>
        </div>`;
        html += `</div>`;
        return html;
      }

      function renderItem(sectionId, item, iIdx, itemsLen) {
        const lastIdx = itemsLen - 1;
        const typeLabel = item.type === 'bullet' ? 'BULLET'
          : item.type === 'fillable' ? 'COLOR'
          : item.type === 'choice' ? 'CHOICE'
          : item.type === 'paint_line' ? 'PAINT/STAIN'
          : item.type === 'subtotal' ? 'SUBTOTAL'
          : 'NOTE';

        let fields = '';
        if (item.type === 'bullet' || item.type === 'note') {
          fields = `<textarea oninput="updateItemField('${sectionId}', '${item.id}', 'text', this.value)" placeholder="${item.type === 'bullet' ? 'Bullet text' : 'Paragraph text'}">${escapeHtml(item.text || '')}</textarea>`;
        } else if (item.type === 'fillable') {
          // Color line — matches the rich card in the quote editor: code/name
          // value + Paint/Stain type + Finish. All optional.
          const pt = item.product_type === 'paint' || item.product_type === 'stain' ? item.product_type : '';
          const finishes = ['Flat', 'Matte', 'Eggshell', 'Satin', 'Semi-gloss', 'Gloss'];
          fields = `<div class="ce-item-row">
            <input type="text" oninput="updateItemField('${sectionId}', '${item.id}', 'label', this.value)" value="${escapeAttr(item.label || '')}" placeholder="Label (e.g. Color for living room)">
            <input type="text" oninput="updateItemField('${sectionId}', '${item.id}', 'value', this.value)" value="${escapeAttr(item.value || '')}" placeholder="Color code or name (e.g. SW 7672)">
          </div>
          <div class="ce-item-row" style="margin-top:6px;">
            <select onchange="updateItemField('${sectionId}', '${item.id}', 'product_type', this.value)">
              <option value=""${!pt ? ' selected' : ''}>Paint or stain?</option>
              <option value="paint"${pt === 'paint' ? ' selected' : ''}>Paint</option>
              <option value="stain"${pt === 'stain' ? ' selected' : ''}>Stain</option>
            </select>
            <select onchange="updateItemField('${sectionId}', '${item.id}', 'finish', this.value)">
              <option value=""${!item.finish ? ' selected' : ''}>Finish (optional)</option>
              ${finishes.map(f => `<option value="${f}"${item.finish === f ? ' selected' : ''}>${f}</option>`).join('')}
            </select>
          </div>`;
        } else if (item.type === 'choice') {
          // Generic admin-defined dropdown. Comma-separated options become
          // a <select>; empty options falls back to a plain text input.
          const opts = Array.isArray(item.options) ? item.options : [];
          const optionsStr = opts.join(', ');
          const valueField = opts.length > 0
            ? `<select onchange="updateItemField('${sectionId}', '${item.id}', 'value', this.value)" style="flex:1;">
                <option value=""${!item.value ? ' selected' : ''}>— Select —</option>
                ${opts.map(o => `<option value="${escapeAttr(o)}"${item.value === o ? ' selected' : ''}>${escapeHtml(o)}</option>`).join('')}
              </select>`
            : `<input type="text" oninput="updateItemField('${sectionId}', '${item.id}', 'value', this.value)" value="${escapeAttr(item.value || '')}" placeholder="Default value (add options below to make a dropdown)">`;
          fields = `<div class="ce-item-row">
            <input type="text" oninput="updateItemField('${sectionId}', '${item.id}', 'label', this.value)" value="${escapeAttr(item.label || '')}" placeholder="Label (e.g. Sheen, Paint type)">
            ${valueField}
          </div>
          <input type="text" oninput="updateChoiceOptions('${sectionId}', '${item.id}', this.value)" onchange="updateChoiceOptions('${sectionId}', '${item.id}', this.value, true)" value="${escapeAttr(optionsStr)}" placeholder="Options (comma-separated, e.g. Paint, Stain, Sealer)" style="margin-top:6px; font-size:12px;">`;
        } else if (item.type === 'paint_line') {
          // Legacy — kept editable for any already-saved rows.
          const productType = item.product_type === 'stain' ? 'stain' : 'paint';
          fields = `<div class="ce-item-row" style="flex-wrap:wrap;">
            <input type="text" oninput="updateItemField('${sectionId}', '${item.id}', 'label', this.value)" value="${escapeAttr(item.label || '')}" placeholder="Label (e.g. Body color)">
            <input type="text" oninput="updateItemField('${sectionId}', '${item.id}', 'value', this.value)" value="${escapeAttr(item.value || '')}" placeholder="Default color / product (optional)">
            <select onchange="updateItemField('${sectionId}', '${item.id}', 'product_type', this.value)" style="flex:0 0 110px;">
              <option value="paint"${productType === 'paint' ? ' selected' : ''}>Paint</option>
              <option value="stain"${productType === 'stain' ? ' selected' : ''}>Stain</option>
            </select>
          </div>`;
        } else if (item.type === 'subtotal') {
          fields = `<div class="ce-item-row">
            <input type="text" oninput="updateItemField('${sectionId}', '${item.id}', 'label', this.value)" value="${escapeAttr(item.label || '')}" placeholder="Label (e.g. Painting subtotal)">
            <input class="ce-amount-field" type="number" inputmode="decimal" step="0.01" oninput="updateItemField('${sectionId}', '${item.id}', 'amount', this.value)" value="${item.amount != null ? item.amount : ''}" placeholder="0.00">
          </div>`;
        }

        return `<div class="ce-item">
          <div class="ce-item-type">${typeLabel}</div>
          <div class="ce-item-fields">${fields}</div>
          <div class="ce-item-actions">
            <button class="ce-icon-btn" ${iIdx === 0 ? 'disabled' : ''} onclick="moveItem('${sectionId}', '${item.id}', -1)" title="Move up">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="18 15 12 9 6 15"/></svg>
            </button>
            <button class="ce-icon-btn" ${iIdx === lastIdx ? 'disabled' : ''} onclick="moveItem('${sectionId}', '${item.id}', 1)" title="Move down">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
            </button>
            <button class="ce-icon-btn danger" onclick="deleteItem('${sectionId}', '${item.id}')" title="Delete item">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
          </div>
        </div>`;
      }

      // ===== Scope mutators (all bump the dirty flag) =====
      function getSection(id) { return template.sections.find(s => s.id === id); }

      window.updateSectionTitle = (id, v) => { const s = getSection(id); if (s) { s.title = v; setDirty(true); } };
      window.updateItemField = (sId, iId, field, value) => {
        const s = getSection(sId); if (!s) return;
        const item = s.items.find(i => i.id === iId); if (!item) return;
        if (field === 'amount') item.amount = value === '' ? 0 : Number(value);
        else item[field] = value;
        setDirty(true);
      };
      window.moveSection = (id, dir) => {
        const idx = template.sections.findIndex(s => s.id === id);
        const target = idx + dir;
        if (idx === -1 || target < 0 || target >= template.sections.length) return;
        const [moved] = template.sections.splice(idx, 1);
        template.sections.splice(target, 0, moved);
        setDirty(true); render();
      };
      window.deleteSection = (id) => {
        window.showConfirmModal({
          title: 'Delete this section?',
          text: 'The section and all its items will be removed.',
          confirmText: 'Delete section',
          type: 'danger',
          onConfirm: () => {
            template.sections = template.sections.filter(s => s.id !== id);
            setDirty(true); render();
          },
        });
      };
      window.addSection = () => {
        template.sections.push({ id: uid('s'), title: 'New section', items: [] });
        setDirty(true); render();
      };
      window.addItem = (sectionId, type) => {
        const s = getSection(sectionId); if (!s) return;
        const base = { id: uid('i'), type };
        if (type === 'bullet' || type === 'note') base.text = '';
        else if (type === 'fillable') { base.label = ''; base.value = ''; }
        else if (type === 'choice') { base.label = ''; base.value = ''; base.options = ['Paint', 'Stain']; }
        else if (type === 'paint_line') { base.label = ''; base.value = ''; base.product_type = 'paint'; }
        else if (type === 'subtotal') { base.label = ''; base.amount = 0; }
        s.items.push(base);
        setDirty(true); render();
      };

      // Choice option-list parser. Splits CSV → array, drops empties,
      // trims whitespace, and clears `value` if the prior selection isn't
      // in the new list (avoids a stale option in the <select>).
      // doRender false on keystrokes (oninput) keeps the typed field alive;
      // true on blur (onchange) re-renders so the value field can become a dropdown.
      window.updateChoiceOptions = (sectionId, itemId, raw, doRender) => {
        const s = getSection(sectionId); if (!s) return;
        const item = s.items.find(i => i.id === itemId); if (!item) return;
        const opts = String(raw || '').split(',').map(x => x.trim()).filter(Boolean);
        item.options = opts;
        if (item.value && !opts.includes(item.value)) item.value = '';
        setDirty(true);
        if (doRender) render();
      };
      window.moveItem = (sectionId, itemId, dir) => {
        const s = getSection(sectionId); if (!s) return;
        const idx = s.items.findIndex(i => i.id === itemId);
        const target = idx + dir;
        if (idx === -1 || target < 0 || target >= s.items.length) return;
        const [moved] = s.items.splice(idx, 1);
        s.items.splice(target, 0, moved);
        setDirty(true); render();
      };
      window.deleteItem = (sectionId, itemId) => {
        const s = getSection(sectionId); if (!s) return;
        s.items = s.items.filter(i => i.id !== itemId);
        setDirty(true); render();
      };

      // ===== Custom terms mutators =====
      window.addCustomTerm = () => {
        template.terms.custom_terms.push({ title: '', text: '' });
        setDirty(true); render();
      };
      window.removeCustomTerm = (idx) => {
        template.terms.custom_terms.splice(idx, 1);
        setDirty(true); render();
      };
      window.updateCustomTerm = (idx, field, value) => {
        const ct = template.terms.custom_terms[idx];
        if (!ct) return;
        ct[field] = value;
        setDirty(true);
      };

      // ===== Save =====
      async function saveTemplate() {
        const btn = document.getElementById('saveBtn');
        btn.disabled = true; btn.textContent = 'Saving…';
        try {
          const res = await fetch(`/api/admin/contract-templates/${templateId}/`, {
            method: 'PATCH',
            credentials: 'include',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              name: template.name,
              project_type: template.project_type,
              is_default: template.is_default ? 1 : 0,
              sections: template.sections,
              terms: template.terms,
              down_payment_percent: template.down_payment_percent,
              down_payment_count: template.down_payment_count,
              monthly_payment_count: template.monthly_payment_count,
              cancellation_window_days: template.cancellation_window_days,
              cancellation_fee_amount: template.cancellation_fee_amount,
              late_fee_amount: template.late_fee_amount,
              late_fee_grace_days: template.late_fee_grace_days,
              warranty_months: template.warranty_months,
            }),
          });
          const data = await res.json();
          if (!data.success) {
            showToast(data.error || 'Save failed', 'error');
            btn.disabled = false; btn.textContent = 'Save';
            return;
          }
          showToast('Saved', 'success');
          setDirty(false);
          btn.textContent = 'Save';
        } catch {
          showToast('Save failed', 'error');
          btn.disabled = false; btn.textContent = 'Save';
        }
      }
      window.saveTemplate = saveTemplate;

      async function archiveTemplate() {
        const archiving = !template.archived;
        const doFlip = async () => {
          try {
            const res = await fetch(`/api/admin/contract-templates/${templateId}/`, {
              method: 'PATCH',
              credentials: 'include',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ archived: archiving ? 1 : 0 }),
            });
            const data = await res.json();
            if (!data.success) { showToast(data.error || 'Failed', 'error'); return; }
            template.archived = archiving ? 1 : 0;
            render();
            showToast(archiving ? 'Archived' : 'Restored', 'success');
          } catch {
            showToast('Failed', 'error');
          }
        };
        if (archiving) {
          window.showConfirmModal({
            title: 'Archive this contract template?',
            text: 'It will be hidden from the templates picker. Existing project contracts that used it keep their copy. You can restore it later.',
            confirmText: 'Archive',
            type: 'warning',
            onConfirm: doFlip,
          });
        } else {
          doFlip();
        }
      }
      window.archiveTemplate = archiveTemplate;

      async function hardDeleteTemplate() {
        const name = template?.name || 'this template';
        window.showConfirmModal({
          title: `Delete "${name}" forever?`,
          text: "Project contracts that already applied it keep their copy. This can't be undone.",
          confirmText: 'Delete forever',
          type: 'danger',
          onConfirm: async () => {
            try {
              const res = await fetch(`/api/admin/contract-templates/${templateId}/?hard=1`, {
                method: 'DELETE',
                credentials: 'include',
              });
              const data = await res.json();
              if (!data.success) { showToast(data.error || 'Delete failed', 'error'); return; }
              dirty = false;
              window.location.href = '/admin/contract-templates';
            } catch {
              showToast('Delete failed', 'error');
            }
          },
        });
      }
      window.hardDeleteTemplate = hardDeleteTemplate;

      document.addEventListener('keydown', (e) => {
        if ((e.metaKey || e.ctrlKey) && e.key === 's') {
          e.preventDefault();
          if (dirty) saveTemplate();
        }
      });

      window.addEventListener('beforeunload', (e) => {
        if (dirty) { e.preventDefault(); e.returnValue = ''; }
      });

      loadTemplate();
    </script>
  </body>
</html>
