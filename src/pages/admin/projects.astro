        <div id="markPaidCheckRow" style="display:none;">
          <label style="font-size:11px;font-weight:600;color:var(--color-text-secondary);text-transform:uppercase;letter-spacing:.5px;display:block;margin-bottom:4px;">Check #</label>
          <input type="text" id="markPaidCheckNum" placeholder="e.g. 1042" style="width:100%;padding:8px 10px;border-radius:8px;border:1px solid var(--color-border);background:var(--color-surface);color:var(--color-text);font-size:13px;box-sizing:border-box;" />
        </div>
        <div>
          <label style="font-size:11px;font-weight:600;color:var(--color-text-secondary);text-transform:uppercase;letter-spacing:.5px;display:block;margin-bottom:4px;">Date received</label>
          <input type="date" id="markPaidDate" style="width:100%;padding:8px 10px;border-radius:8px;border:1px solid var(--color-border);background:var(--color-surface);color:var(--color-text);font-size:13px;box-sizing:border-box;" />
