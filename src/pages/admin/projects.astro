    // Generic section lock/unlock — used by Schedule, Materials, Labor, and
    // Pricing Summary. When locked, all inputs/textareas inside the section
    // get readonly and the Add/Remove buttons hide via CSS. The fourth-arg
    // "follow" flag suppresses button styling so a section can be toggled
    // alongside another (e.g. Pricing follows Labor's Edit button).
    function toggleSectionLock(sectionId, btn, follow) {
      var sect = document.getElementById(sectionId);
      if (!sect) return;
      var locked = sect.getAttribute('data-locked') === '1';

      var inputs = sect.querySelectorAll('input, textarea, select');
      inputs.forEach(function(el) {
        // Always-readonly outputs (calculated total) stay readonly.
        if (el.classList.contains('labor-total')) return;
        if (locked) {
          el.removeAttribute('readonly');
          el.style.cursor = 'text';
        } else {
          el.setAttribute('readonly', '');
          el.style.cursor = 'default';
        }
        // Don't override background — admin theme is dark, and overriding
        // the inline bg makes the field render white when re-locked. The
        // readonly attribute + cursor change is enough state cue.
        el.style.background = '';
      });

      sect.setAttribute('data-locked', locked ? '0' : '1');

      if (!follow && btn) {
        var nowLocked = !locked;
        btn.setAttribute('data-locked', nowLocked ? '1' : '0');
        btn.textContent = nowLocked ? 'Edit' : 'Done';
        btn.style.color = nowLocked ? 'var(--color-text-secondary)' : 'var(--color-primary)';
        btn.style.borderColor = nowLocked ? 'var(--color-border)' : 'var(--color-primary)';
      }
    }
