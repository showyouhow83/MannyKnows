      <div class="modal-actions" style="margin-top:20px;">
        <button class="btn btn-cancel" onclick="closeMarkPaidModal()">Cancel</button>
        <button class="btn btn-confirm success" id="markPaidConfirmBtn" onclick="submitMarkPaid()">Mark paid</button>
      </div>
