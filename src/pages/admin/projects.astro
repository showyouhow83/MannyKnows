  </div>

  <script is:inline define:vars={{ allProjects: JSON.stringify(allProjects), crewLeads: JSON.stringify(crewLeads), serviceLabels: JSON.stringify(serviceLabels), projectUpdatesData: JSON.stringify(projectUpdates), partnersData: JSON.stringify(partnersList), streamSub: streamSub }}>
    const projects = JSON.parse(allProjects);
    let crews = JSON.parse(crewLeads); // Changed to let so we can update it
    const labels = JSON.parse(serviceLabels);
    const projectUpdates = JSON.parse(projectUpdatesData);
    const partners = JSON.parse(partnersData); // active partners for white-label dropdown
    let selectedProjectId = null;
    let pendingConfirmCallback = null;
    // Projects whose missing signed-quote PDF we've already auto-generated this
    // page-session (avoid re-triggering on every re-open).
    const _autoBackfilledPdf = new Set();

    // Show/hide a custom-service text input when "Other" is chosen in a
    // service dropdown; the typed value becomes the stored service.
    window.toggleCustomService = function(sel, customId) {
      var inp = document.getElementById(customId);
      if (!inp) return;
      var isOther = sel.value === 'other';
      inp.style.display = isOther ? 'block' : 'none';
      if (!isOther) inp.value = '';
    };

    // Toast notification helper
    // Toast lifetime depends on severity — error messages can be long and
    // critical, so they linger 8s instead of the standard 3s. Clears any
    // pending hide-timer so back-to-back toasts don't dismiss early.
    function showToast(message, type = 'info') {
      const toast = document.getElementById('toast');
      const toastMsg = document.getElementById('toastMessage');
      toastMsg.textContent = message;
      toast.className = `toast ${type}`;
      toast.classList.add('visible');
      if (window._toastTimer) clearTimeout(window._toastTimer);
      const ttl = type === 'error' ? 8000 : 3000;
      window._toastTimer = setTimeout(() => toast.classList.remove('visible'), ttl);
    }

    // Confirmation modal helper
    function showConfirmModal(title, text, confirmText, type, callback) {
      const modal = document.getElementById('confirmModal');
      const icon = document.getElementById('modalIcon');
      const confirmBtn = document.getElementById('modalConfirmBtn');

      document.getElementById('modalTitle').textContent = title;
      document.getElementById('modalText').textContent = text;
      confirmBtn.textContent = confirmText || 'Confirm';
      confirmBtn.className = `btn btn-confirm ${type || ''}`;
      icon.className = `modal-icon ${type || 'info'}`;

      pendingConfirmCallback = callback;
      modal.classList.add('active');
    }

    function closeModal() {
      document.getElementById('confirmModal').classList.remove('active');
      pendingConfirmCallback = null;
    }

    async function confirmModalAction() {
      const cb = pendingConfirmCallback;
      if (!cb) return;
      const confirmBtn = document.getElementById('modalConfirmBtn');
      const cancelBtn = confirmBtn.parentElement.querySelector('.btn-cancel');
      const originalText = confirmBtn.textContent;
      // Lock the modal while the action runs so quick double-clicks can't
      // submit twice (matters for slow ops like project→portfolio with many
      // images uploading to Cloudflare Images).
      confirmBtn.disabled = true;
      if (cancelBtn) cancelBtn.disabled = true;
      confirmBtn.textContent = 'Working…';
      pendingConfirmCallback = null;
      try {
        await cb();
      } finally {
        confirmBtn.disabled = false;
        if (cancelBtn) cancelBtn.disabled = false;
        confirmBtn.textContent = originalText;
        document.getElementById('confirmModal').classList.remove('active');
      }
    }

    // Set up confirm button handler
    document.getElementById('modalConfirmBtn').addEventListener('click', confirmModalAction);

    // ── Quick "mark as already paid" modal ──────────────────────────────────
    let _markPaidState = null;
    let _invoiceByRow = {}; // latest invoice send per payment row (for resend confirm)

    function quickMarkPaid(projectId, rowId, amount, label) {
      _markPaidState = { projectId, rowId, amount };
      const today = new Date().toISOString().slice(0, 10);
      document.getElementById('markPaidLabel').textContent =
        (label ? label + ' — ' : '') + fmtCurrency(amount);
      document.getElementById('markPaidMethod').value = 'cash';
      document.getElementById('markPaidCheckRow').style.display = 'none';
      document.getElementById('markPaidCheckNum').value = '';
      document.getElementById('markPaidDate').value = today;
      document.getElementById('markPaidModal').classList.add('active');
    }

    // Email the customer an invoice for one schedule row (check-mailing
    // instructions + amount). Useful when a payment is owed but we can't collect
    // in person — e.g. a mid-project add-on after the visit.
    function sendInvoice(projectId, rowId, amount, label) {
      const iv = (_invoiceByRow || {})[rowId];
      let title = 'Send invoice?';
      let confirmText = 'Send invoice';
      let type = 'info';
      let text = 'Email the customer an invoice for ' + (label ? label + ' — ' : '') + fmtCurrency(amount) + ', with instructions to mail a check.';
      if (iv && iv.sent_at) {
        // Already sent before → make a resend a deliberate, informed action.
        title = 'Resend invoice?';
        confirmText = 'Resend invoice';
        type = 'warning';
        const countTxt = (iv.send_count > 1) ? ' (' + iv.send_count + ' sent)' : '';
        const sentMs = Date.parse(String(iv.sent_at).replace(' ', 'T') + 'Z');
        const hoursAgo = isFinite(sentMs) ? (Date.now() - sentMs) / 3600000 : null;
        if (hoursAgo !== null && hoursAgo >= 0 && hoursAgo < 2) {
          // Very recent — stronger (red) warning against an accidental double-send.
          const mins = Math.max(1, Math.round(hoursAgo * 60));
          const ago = mins < 60 ? (mins + ' minute' + (mins === 1 ? '' : 's')) : 'about an hour';
          type = 'danger';
          text = 'You sent this invoice ' + ago + ' ago' + countTxt + '. Resend ' + fmtCurrency(amount) + ' to the customer anyway?';
        } else {
          text = 'You last sent this invoice on ' + fmtDate(iv.sent_at) + countTxt + '. Resend ' + fmtCurrency(amount) + ' to the customer anyway?';
        }
      }
      showConfirmModal(title, text, confirmText, type, async function() {
        try {
          const res = await fetch('/api/projects/' + projectId + '/send-invoice/', {
            method: 'POST', credentials: 'include',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ row_id: rowId }),
          });
          const data = await res.json();
          if (data.success) { showToast('Invoice sent to ' + (data.sent_to || 'customer'), 'success'); loadContractTab(projectId); }
          else showToast(data.error || 'Failed to send invoice', 'error');
        } catch (e) { showToast('Failed to send invoice', 'error'); }
      });
    }

    document.getElementById('markPaidMethod').addEventListener('change', function() {
      document.getElementById('markPaidCheckRow').style.display =
        this.value === 'check' ? 'block' : 'none';
    });

    function closeMarkPaidModal() {
      document.getElementById('markPaidModal').classList.remove('active');
      _markPaidState = null;
    }

    async function submitMarkPaid() {
      if (!_markPaidState) return;
      const { projectId, rowId, amount } = _markPaidState;
      const method = document.getElementById('markPaidMethod').value;
      const checkNum = document.getElementById('markPaidCheckNum').value.trim() || null;
      const collectedAt = document.getElementById('markPaidDate').value || null;
      const btn = document.getElementById('markPaidConfirmBtn');
      btn.disabled = true;
      btn.textContent = 'Saving…';
      try {
        const res = await fetch('/api/admin/projects/' + projectId + '/collect-payment', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ row_id: rowId, amount, payment_method: method,
            check_number: checkNum, collected_at: collectedAt, no_signature: true }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Failed');
        closeMarkPaidModal();
        showToast('Payment marked as received', 'success');
        // Reload detail panel to reflect paid status
        if (selectedProjectId === projectId) selectProject(projectId);
      } catch (e) {
        showToast(e.message || 'Could not save payment', 'error');
      } finally {
        btn.disabled = false;
        btn.textContent = 'Mark paid';
      }
    }

    // Add-crew modal + helpers retired — crew leads are now created only
    // from /admin/crew. The dropdown above pulls from `crewLeads` which is
    // hydrated server-side, so no client-side add path is needed here.

    // Search/filter projects
    function filterProjects() {
      const query = document.getElementById('projectSearch').value.toLowerCase().trim();
      const cards = document.querySelectorAll('#projectsList .project-card');

      cards.forEach(card => {
        const searchText = card.dataset.search || '';
        const matches = !query || searchText.includes(query);
        card.style.display = matches ? 'block' : 'none';
      });

      // On mobile: auto-expand sections with matches
      if (query && window.innerWidth <= 768) {
        document.querySelectorAll('.section-body').forEach(function(body) {
          const hasVisible = body.querySelector('.project-card:not([style*="display: none"])');
          if (hasVisible) {
            body.classList.remove('collapsed-mobile');
            if (body.previousElementSibling) body.previousElementSibling.classList.remove('collapsed');
          }
        });
      }
    }

    // Mobile section toggle (accordion - one at a time)
    document.querySelectorAll('.section-toggle').forEach(function(header) {
      header.addEventListener('click', function() {
        if (window.innerWidth > 768) return;
        var sectionId = 'section' + header.getAttribute('data-section').charAt(0).toUpperCase() + header.getAttribute('data-section').slice(1);
        var body = document.getElementById(sectionId);
        if (!body) return;
        var isCollapsed = body.classList.contains('collapsed-mobile');
        var selectedCard = document.querySelector('.project-card.selected');

        if (isCollapsed) {
          document.querySelectorAll('.section-body').forEach(function(b) { b.classList.add('collapsed-mobile'); });
          document.querySelectorAll('.section-toggle').forEach(function(h) { h.classList.add('collapsed'); });
          body.classList.remove('collapsed-mobile');
          header.classList.remove('collapsed');
        } else {
          body.classList.add('collapsed-mobile');
          header.classList.add('collapsed');
        }

        // If selected card is in a collapsed section, clear detail
        if (selectedCard) {
          var parentBody = selectedCard.closest('.section-body');
          if (parentBody && parentBody.classList.contains('collapsed-mobile')) {
            document.querySelectorAll('.project-card').forEach(function(c) { c.classList.remove('selected'); });
            var content = document.getElementById('projectContent');
            if (content) content.innerHTML = '<div class="content-placeholder"><div class="placeholder-icon">\uD83D\uDCCB</div><p>Select a project to view details</p></div>';
            hideMobileDetail();
          }
        }
      });
    });

    function formatServices(servicesJson) {
      if (!servicesJson) return 'Home Services';
      try {
        const services = JSON.parse(servicesJson);
        return services.map(s => {
          const key = typeof s === 'string' ? s : (s.type || s.service || s.name || 'unknown');
          return labels[key] || key.charAt(0).toUpperCase() + key.slice(1);
        }).join(', ');
      } catch {
        return servicesJson;
      }
    }

    function formatCurrency(amount) {
      if (!amount) return '$0';
      return new Intl.NumberFormat('en-US', {
        style: 'currency',
        currency: 'USD',
        minimumFractionDigits: 0
      }).format(amount);
    }

    function formatDate(dateStr) {
      if (!dateStr) return 'Not set';
      try {
        return new Date(dateStr).toLocaleDateString('en-US', {
          month: 'short',
          day: 'numeric',
          year: 'numeric'
        });
      } catch {
        return dateStr;
      }
    }

    function formatDateShort(dateStr) {
      if (!dateStr) return '';
      try {
        return new Date(dateStr).toLocaleDateString('en-US', {
          month: 'short',
          day: 'numeric'
        });
      } catch {
        return dateStr;
      }
    }

    function parseLineItems(jsonStr) {
      if (!jsonStr) return [];
      try {
        return JSON.parse(jsonStr);
      } catch {
        return [];
      }
    }

    function parseImages(jsonStr) {
      if (!jsonStr) return [];
      try {
        const images = JSON.parse(jsonStr);
        return Array.isArray(images) ? images : [];
      } catch {
        return [];
      }
    }

    function formatDateTime(dateStr) {
      if (!dateStr) return '';
      try {
        return new Date(dateStr).toLocaleString('en-US', {
          month: 'short',
          day: 'numeric',
          year: 'numeric',
          hour: 'numeric',
          minute: '2-digit',
          hour12: true
        });
      } catch {
        return dateStr;
      }
    }

    function renderCrewUpdates(projectId) {
      const updates = projectUpdates[projectId] || [];

      if (updates.length === 0) {
        return '<div class="no-crew-updates">No updates from crew yet</div>';
      }

      return updates.map(update => {
        let content = '';

        // Add note if exists
        if (update.note) {
          content += `<div class="crew-update-note">${update.note}</div>`;
        }

        // Add image if exists (Stream poster for videos, resized thumb for images)
        if (update.image_url) {
          if (update.stream_uid && streamSub) {
            content += `
            <div class="crew-update-image">
              <img src="https://${streamSub}/${update.stream_uid}/thumbnails/thumbnail.jpg?time=1s&height=400" alt="Video" onclick="window.open('https://${streamSub}/${update.stream_uid}/iframe', '_blank')" loading="lazy" style="cursor:pointer;" />
            </div>
          `;
          } else {
            const thumbUrl = getThumbnailUrl(update.image_url, 200);
            content += `
            <div class="crew-update-image">
              <img src="${thumbUrl}" alt="Progress image" onclick="window.open('${update.image_url}', '_blank')" loading="lazy" />
            </div>
          `;
          }
        }

        return `
          <div class="crew-update-item">
            <div class="crew-update-header">
              <span class="crew-update-author">${update.posted_by_name || 'Crew'}</span>
              <span class="crew-update-time">${formatDateTime(update.created_at)}</span>
              <button type="button" class="crew-update-delete" onclick="deleteCrewUpdate(${update.id}, ${projectId})" title="Delete update">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M3 6h18M19 6v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6m3 0V4a2 2 0 012-2h4a2 2 0 012 2v2"/>
                </svg>
              </button>
            </div>
            ${content}
          </div>
        `;
      }).join('');
    }

    // Convert full image URL to thumbnail URL using Cloudflare Image Resizing
    function getThumbnailUrl(url, size = 200) {
      if (!url) return '';
      try {
        const urlObj = new URL(url);
        // Only use Cloudflare Image Resizing on production (images.mannyknows.com)
        // Localhost and other domains should just return the original URL
        if (urlObj.hostname === 'images.mannyknows.com' && !window.location.hostname.includes('localhost')) {
          const path = urlObj.pathname;
          return `${urlObj.origin}/cdn-cgi/image/width=${size},height=${size},fit=cover,quality=80,format=auto${path}`;
        }
        return url;
      } catch {
        return url;
      }
    }
    // Larger, format-auto variant used by the lightbox so HEIC originals
    // get transcoded (browsers can't render image/heic natively) and big
    // photos don't slam the network at full resolution.
    function getDisplayUrl(url, maxWidth = 1600) {
      if (!url) return '';
      try {
        const urlObj = new URL(url);
        if (urlObj.hostname === 'images.mannyknows.com' && !window.location.hostname.includes('localhost')) {
          const path = urlObj.pathname;
          return `${urlObj.origin}/cdn-cgi/image/width=${maxWidth},fit=scale-down,quality=85,format=auto${path}`;
        }
        return url;
      } catch {
        return url;
      }
    }

    function selectProject(id) {
      selectedProjectId = id;
      // Presence: announce which project this admin is now viewing/editing.
      // NOTE: this lives in an is:inline script (not compiled), so NO TS casts.
      if (id && window.setPresenceRecord) window.setPresenceRecord('project', id);

      // Update card selection
      document.querySelectorAll('.project-card, .status-card').forEach(card => {
        card.classList.toggle('selected', card.dataset.id == id);
      });

      // Find project
      const project = projects.find(p => p.id == id);
      if (!project) {
        console.error('[Projects] Project not found:', id);
        return;
      }

      // Render detail (include mobile back button + close button at top)
      const content = document.getElementById('projectContent');
      const backBtn = `<button class="mobile-back-btn" onclick="hideMobileDetail()">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M19 12H5M12 19l-7-7 7-7"/>
        </svg>
        Back to list
      </button>`;
      const closeBtn = `<button class="btn-close-detail detail-close-float" onclick="closeProjectDetail()" title="Close" aria-label="Close project">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
      </button>`;
      content.innerHTML = backBtn + closeBtn + renderProjectDetail(project);

      // Self-heal the recurring "Signed quote PDF missing" case: the customer
      // signed but the accept-time (customer-browser) PDF generation didn't
      // land. Regenerate it silently here in the reliable admin browser, once
      // per project per session. Falls back to the manual button if it fails.
      if (project.quote_id && content.querySelector('[data-needs-signed-pdf]') && !_autoBackfilledPdf.has(id)) {
        _autoBackfilledPdf.add(id);
        autoBackfillSignedQuotePdf(project.quote_id, id);
      }

      // Lazy-mount poster frames for every video tile in the project's
      // Media grid. Without this, all videos look identical (icon only).
      if (typeof mountVideoPosters === 'function') mountVideoPosters(content);

      // Store quote_id for tab switching and load messages (badge only, don't mark read)
      if (project.quote_id) {
        currentProjectQuoteId = project.quote_id;
        loadProjectMessages(project.id, project.quote_id, true);
        // Restore any in-progress message draft (survives tab switches / reloads).
        if (typeof restoreMsgDraft === 'function') restoreMsgDraft(project.id);
      } else {
        currentProjectQuoteId = null;
      }

      // On mobile, show the detail view
      showMobileDetail();
    }

    function renderProjectDetail(project) {
      // Real contract state (from project_contracts, not the legacy column).
      // A project with a contract that's still draft/sent is NOT truly ready to
      // start — the agreement isn't executed yet. Signed/countersigned (or no
      // contract at all) clears it.
      const cStatus = project.contract_real_status || null;
      const contractUnsigned = cStatus === 'draft' || cStatus === 'sent';

      const statusBadgeClass = project.status === 'needs_crew'
                              ? (cStatus === 'sent' ? 'awaiting-sign' : cStatus === 'draft' ? 'contract-unsent' : 'needs-crew')
                              : project.status === 'in_progress' ? 'in-progress' : 'completed';

      const statusLabel = project.status === 'needs_crew'
                         ? (contractUnsigned
                             ? (cStatus === 'sent' ? 'Awaiting Signature' : 'Contract Not Sent')
                             : (project.crew_lead_id ? 'Ready to Start' : 'Needs Crew'))
                         : project.status === 'in_progress' ? 'In Progress' : 'Completed';

      const crewOptions = crews.map(c =>
        `<option value="${c.id}" ${c.id === project.crew_lead_id ? 'selected' : ''}>${c.name}</option>`
      ).join('');

      // Parse materials and labor from quote
      const materials = parseLineItems(project.quote_materials);
      const labor = parseLineItems(project.quote_labor);
      // Merge images from both lead and quote (deduplicated)
      const leadImages = parseImages(project.lead_images);
      const quoteImages = parseImages(project.quote_images);
      const allLegacyImages = [...new Set([...leadImages, ...quoteImages])];

      // Project images from project_updates (admin + quote_migration + crew)
      const projUpdates = projectUpdates[project.id] || [];
      const projectImages = projUpdates.filter(u => u.image_url).map(u => ({
        id: u.id,
        url: u.image_url,
        stream_uid: u.stream_uid || null,
        posted_by: u.posted_by,
        is_starred: u.is_starred ? 1 : 0,
        created_at: u.created_at
      }));
      // Reference-media counts (images vs videos) for the section header.
      const refVidCount = projectImages.filter(m => m.stream_uid || /\.(mp4|mov|webm|m4v)(\?|$)/i.test(m.url || '')).length;
      const refImgCount = projectImages.length - refVidCount;
      const refCountLabel = projectImages.length
        ? `${refImgCount} image${refImgCount === 1 ? '' : 's'} &middot; ${refVidCount} video${refVidCount === 1 ? '' : 's'}`
        : '';
      // Combine: project_updates images + legacy lead/quote images (for older projects not yet migrated)
      const allImages = projectImages.length > 0 ? projectImages : allLegacyImages.map(img => ({ url: img.url || img, posted_by: 'legacy', created_at: null }));

      // Build materials list (name only, no pricing)
      let materialsHtml = '';
      if (materials.length > 0) {
        materialsHtml = `
          <ul style="margin: 8px 0 0 0; padding: 0 0 0 20px;">
            ${materials.map(m => `
              <li style="padding: 4px 0; color: var(--color-text-primary); font-size: 14px;">${m.name || m.description || 'Item'}</li>
            `).join('')}
          </ul>
        `;
      } else {
        materialsHtml = '<div class="no-images">No materials listed</div>';
      }

      // Build labor table
      let laborHtml = '';
      if (labor.length > 0) {
        laborHtml = `
          <table class="pricing-table">
            <thead>
              <tr>
                <th>Description</th>
                <th style="text-align: right;">Qty/Hours</th>
                <th style="text-align: right;">Rate</th>
                <th style="text-align: right;">Total</th>
              </tr>
            </thead>
            <tbody>
              ${labor.map(l => `
                <tr>
                  <td>${l.description || l.name || 'Labor'}</td>
                  <td style="text-align: right;">${l.qty || l.hours || 1}</td>
                  <td style="text-align: right;">${formatCurrency(l.unit_price || l.rate || l.unitPrice || 0)}</td>
                  <td style="text-align: right;">${formatCurrency(l.total || 0)}</td>
                </tr>
              `).join('')}
              <tr class="total-row">
                <td colspan="3">Labor Total</td>
                <td style="text-align: right;">${formatCurrency(project.labor_total)}</td>
              </tr>
            </tbody>
          </table>
        `;
      } else {
        laborHtml = '<div class="no-images">No labor listed</div>';
      }

      // Build media grid with thumbnails (and video tiles) + delete buttons
      let imagesHtml = '';
      if (allImages.length > 0) {
        imagesHtml = `
          <div id="refBulkBar" data-pid="${project.id}" style="display:none; align-items:center; gap:8px; flex-wrap:wrap; margin-bottom:10px; padding:8px 12px; background:rgba(99,102,241,0.12); border:1px solid rgba(99,102,241,0.35); border-radius:var(--radius-md);">
            <span id="refBulkCount" style="font-size:13px; font-weight:700; color:#c7d2fe;">0 selected</span>
            <span style="flex:1; min-width:8px;"></span>
            <button type="button" onclick="refBulkToPool(${project.id})" style="padding:6px 12px; background:rgba(245,158,11,0.15); border:1px solid rgba(245,158,11,0.45); border-radius:var(--radius-md); color:#fcd34d; font-size:12px; font-weight:600; cursor:pointer;">Move to Media Pool</button>
            <button type="button" onclick="refBulkDelete(${project.id})" style="padding:6px 12px; background:rgba(239,68,68,0.15); border:1px solid rgba(239,68,68,0.45); border-radius:var(--radius-md); color:#fca5a5; font-size:12px; font-weight:600; cursor:pointer;">Delete</button>
            <button type="button" onclick="refClearSelect()" style="padding:6px 12px; background:rgba(148,163,184,0.12); border:1px solid rgba(148,163,184,0.35); border-radius:var(--radius-md); color:#cbd5e1; font-size:12px; font-weight:600; cursor:pointer;">Clear</button>
          </div>
          <div class="images-grid">
            ${allImages.map((img, idx) => {
              const fullUrl = img.url || img;
              // Chunked: tiles past the first 30 start hidden; "Load more" reveals
              // the next batch. Keeps media-heavy projects from rendering hundreds
              // of tiles at once.
              const hiddenClass = idx >= 30 ? ' ref-hidden' : '';
              const isVideo = !!img.stream_uid || /\.(mp4|mov|webm|m4v)(?:\?|$)/i.test(fullUrl);
              const thumbUrl = isVideo ? fullUrl : getThumbnailUrl(fullUrl, 200);
              const tag = img.posted_by === 'quote_migration' ? 'b' : img.posted_by === 'crew_lead' ? 'd' : img.posted_by === 'admin' ? 'd' : '';
              const updateId = img.id || null;
              const safeUrl = String(fullUrl).replace(/'/g, "\\'");
              const starred = img.is_starred ? 1 : 0;
              const deleteBtn = updateId
                ? '<button class="image-delete-btn" onclick="event.stopPropagation(); deleteProjectImage(' + project.id + ', ' + updateId + ')" title="Delete"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg></button>'
                : '';
              // Star = crew-only (shown to crew, hidden from client). Toggleable.
              const starBtn = updateId
                ? '<button class="image-star-btn' + (starred ? ' active' : '') + '" ontouchstart="event.stopPropagation();" onclick="event.stopPropagation(); toggleProjectStar(' + project.id + ', ' + updateId + ', this)" title="' + (starred ? 'Crew-only (starred): click to make client-visible' : 'Click to mark crew-only (hidden from client)') + '">' + (starred ? '★' : '☆') + '</button>'
                : '';
              // Multi-select checkbox (top-left) for bulk delete / move-to-pool.
              const selectBox = updateId
                ? '<input type="checkbox" class="ref-select" data-uid="' + updateId + '" onclick="event.stopPropagation();" onchange="toggleRefSelect(' + updateId + ', this)" title="Select" style="position:absolute; bottom:6px; right:6px; width:18px; height:18px; z-index:6; cursor:pointer; accent-color:#6366f1; box-shadow:0 0 0 2px rgba(10, 11, 13,0.55); border-radius:3px;" />'
                : '';
              if (isVideo) {
                const streamUid = img.stream_uid || '';
                // Stream auto-thumbnail (tiny JPG) — no video download. Falls back
                // to the play-icon tile if the video isn't a Stream video yet or
                // is still transcoding (thumbnail 4xx → onerror hides the img).
                // Stream thumbnail when available; otherwise show the video's
                // first frame via preload=metadata (Range-served from R2).
                const poster = (streamUid && streamSub)
                  ? '<img src="https://' + streamSub + '/' + streamUid + '/thumbnails/thumbnail.jpg?time=1s&height=400" alt="Video" loading="lazy" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; z-index:0;" onerror="this.style.display=\'none\'" />'
                  : '<video src="' + safeUrl + '#t=0.1" preload="metadata" muted playsinline style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; z-index:0; pointer-events:none;"></video>';
                const lbArg = streamUid ? streamUid : safeUrl;
                return `
              <div class="image-thumb is-video${hiddenClass}"${updateId ? ' data-uid="' + updateId + '"' : ''} onclick="openLightbox('${lbArg}', true, '${streamUid}')" style="background: linear-gradient(135deg, #12121f 0%, #1a1a2e 100%); display:flex; align-items:center; justify-content:center; color:#a1a1aa; position:relative; overflow:hidden;">
                ${poster}
                <svg class="video-fallback-icon" width="40" height="40" viewBox="0 0 24 24" fill="white" style="position:relative; z-index:1; filter:drop-shadow(0 1px 4px rgba(0,0,0,0.6));"><polygon points="6 4 20 12 6 20 6 4"/></svg>
                <span class="image-video-badge" style="z-index:2;">Video</span>
                ${tag ? '<span class="image-tag" style="z-index:2;">' + tag + '</span>' : ''}
                ${selectBox}
                ${starBtn}
                ${deleteBtn}
              </div>`;
              }
              const annoUrl = '/admin/annotate/?src=' + encodeURIComponent(fullUrl) + '&target=project&id=' + project.id + '&back=' + encodeURIComponent(location.pathname + location.search);
              return `
              <div class="image-thumb${starred ? ' is-starred' : ''}${hiddenClass}"${updateId ? ' data-uid="' + updateId + '"' : ''}>
                <img src="${thumbUrl}" alt="Project media" onclick="openLightbox('${safeUrl}')" loading="lazy" />
                ${tag ? '<span class="image-tag">' + tag + '</span>' : ''}
                ${selectBox}
                ${starBtn}
                <a href="${annoUrl}" class="image-anno-btn" title="Annotate (markup, arrows, notes)" onclick="event.stopPropagation();">✎</a>
                ${deleteBtn}
              </div>
            `;
            }).join('')}
          </div>
          ${allImages.length > 30 ? '<div style="text-align:center; margin-top:12px;"><button type="button" class="ref-loadmore-btn" data-shown="30" data-total="' + allImages.length + '" onclick="refMediaLoadMore(this)" style="padding:8px 16px; background:rgba(148,163,184,0.12); border:1px solid var(--glass-border); border-radius:var(--radius-md); color:var(--color-text-secondary); font-size:13px; font-weight:600; cursor:pointer;">Load more (' + (allImages.length - 30) + ' more)</button></div>' : ''}
          <div style="margin-top: 8px; font-size: 11px; color: var(--color-text-secondary);">
            <span style="display: inline-block; background: rgba(59,130,246,0.15); color: #3b82f6; padding: 1px 5px; border-radius: 4px; margin-right: 6px;">b</span>before
            <span style="display: inline-block; background: rgba(34,197,94,0.15); color: #22c55e; padding: 1px 5px; border-radius: 4px; margin: 0 6px;">d</span>during
            <span style="margin-left: 10px;"><span style="color:#facc15;">★</span> crew-only (hidden from client) · <span style="color:#64748b;">☆</span> client-visible</span>
          </div>
        `;
      } else {
        imagesHtml = '<div class="no-images">No media uploaded yet</div>';
      }

      // Approval badge
      const approvalBadge = project.promoted_by === 'customer'
        ? '<span class="approval-badge customer">Customer Approved</span>'
        : project.promoted_by === 'admin'
        ? '<span class="approval-badge admin">Admin Promoted</span>'
        : '';

      const escAttr = (s) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

      // Internal (admin-only) notes. Stored on projects.internal_notes as a JSON
      // array of {date, note} — same shape as quotes.notes, so promoted quotes
      // carry straight over. Flatten to plain text for the textarea.
      let internalNotesText = '';
      try {
        const parsedInternal = JSON.parse(project.internal_notes || '[]');
        if (Array.isArray(parsedInternal)) internalNotesText = parsedInternal.map((n) => (n && n.note) || '').filter(Boolean).join('\n');
        else if (typeof project.internal_notes === 'string') internalNotesText = project.internal_notes;
      } catch { internalNotesText = String(project.internal_notes || ''); }

      return `
        <div class="project-detail">
          <div class="detail-header">
            <div class="detail-header-title-group">
              <div class="detail-title" title="${project.project_number}">#${(project.project_number || '').slice(-4)}</div>
              <h1 class="detail-customer-name">${project.customer_name}${project.company_name ? `<span style="display:block;font-size:13px;font-weight:500;color:var(--color-text-secondary);margin-top:2px;">${escAttr(project.company_name)}</span>` : ''}</h1>
            </div>
            <div class="detail-badges">
              ${approvalBadge}
              <span class="status-badge ${statusBadgeClass}">${statusLabel}</span>
            </div>
          </div>

          <!-- Tab Navigation -->
          <div class="project-tabs">
            <button class="project-tab active" data-proj-tab="details" onclick="switchProjectTab(this, ${project.id})">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
              Details
            </button>
            <button class="project-tab" data-proj-tab="contract" onclick="switchProjectTab(this, ${project.id})">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
              Contract
              ${(() => {
                // Prefer the real structured-contract status; fall back to the
                // legacy file-upload column for older projects.
                const real = project.contract_real_status;
                if (real) {
                  const map = { draft: ['Draft', ''], sent: ['Sent', 'background:#f59e0b;'], signed: ['Signed', 'background:#22c55e;'], countersigned: ['Signed', 'background:#22c55e;'], void: ['Void', 'background:#ef4444;'] };
                  const m = map[real];
                  return m ? `<span class="tab-badge" style="${m[1]}">${m[0]}</span>` : '';
                }
                const ls = project.contract_status;
                if (ls && ls !== 'none') {
                  const label = ls === 'uploaded' ? 'New' : ls === 'sent' ? 'Sent' : ls === 'pending_review' ? 'Review' : ls === 'signed' ? 'Signed' : '';
                  const style = ls === 'signed' ? 'background:#22c55e;' : ls === 'pending_review' ? 'background:#f59e0b;' : '';
                  return label ? `<span class="tab-badge" style="${style}">${label}</span>` : '';
                }
                return '';
              })()}
            </button>
            <button class="project-tab" data-proj-tab="documents" onclick="switchProjectTab(this, ${project.id})">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
              Documents
              ${Array.isArray(project.quote_attachments) && project.quote_attachments.length ? `<span class="tab-badge">${project.quote_attachments.length}</span>` : ''}
            </button>
            <button class="project-tab" data-proj-tab="crew" onclick="switchProjectTab(this, ${project.id})">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
              Crew
            </button>
            ${project.customer_email && project.quote_id ? `
            <button class="project-tab" data-proj-tab="messages" onclick="switchProjectTab(this, ${project.id})">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
              Messages
              <span class="tab-badge" id="msgTabBadge-${project.id}" style="display:none;">0</span>
            </button>
            ` : ''}
            <button class="project-tab" data-proj-tab="management" onclick="switchProjectTab(this, ${project.id})">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/></svg>
              Management
            </button>
          </div>

          <!-- Details Tab -->
          <div class="proj-tab-content active" data-proj-tab-content="details">

          <!-- Customer + Project — one merged card matching the Quote
               admin's Customer Info + Appointment pattern. Holds:
                 - Customer identity (name/email/phone/address)
                 - Services + scope description
                 - Schedule (start/end dates)
               Address links to Apple Maps via the universal
               https://maps.apple.com/?q=... URL: opens the Maps app on
               iOS/macOS, falls back to the web map elsewhere. -->
          ${(() => {
            const fullAddress = [project.customer_address, project.customer_city, [project.customer_state, project.customer_zip].filter(Boolean).join(' ')].filter(Boolean).join(', ');
            const mapsHref = fullAddress ? `https://maps.apple.com/?q=${encodeURIComponent(fullAddress)}` : '';
            const initialScope = project.scope_description || (() => {
              try {
                const arr = typeof project.services === 'string' ? JSON.parse(project.services) : project.services;
                if (!Array.isArray(arr)) return '';
                const labels = { 'website-basic': 'Website I', 'website-plus': 'Website II', 'website-smart': 'Website III', 'ecommerce': 'eCommerce', 'business-ads': 'Business Ads', 'multimedia-agency': 'Multimedia', 'ai-team': 'AI Team', 'custom-app': 'Custom App', '360-photo': '360° Photo', 'website-analysis': 'Site Analysis' };
                const parts = arr.filter(s => (s?.scope || '').trim()).map((s, _i, all) => {
                  const lbl = labels[s.type] || s.type;
                  return all.length > 1 ? lbl + ': ' + s.scope.trim() : s.scope.trim();
                });
                return parts.join('\n\n');
              } catch { return ''; }
            })();
            return `
          <div class="detail-section">
            <div class="detail-section-title">Customer &amp; Project</div>
            <!-- 3-column grid on desktop (>= 1024px): contact / services+scope / schedule.
                 Stacks single-column on smaller screens so phones get the natural
                 top-to-bottom reading order. -->
            <div class="cust-proj-grid">
              <!-- Col 1: customer identity -->
              <div class="cust-proj-col">
                <div class="detail-row">
                  <span class="detail-label">Name</span>
                  <span class="detail-value">${project.customer_name}</span>
                </div>
                ${project.company_name ? `
                <div class="detail-row">
                  <span class="detail-label">Company</span>
                  <span class="detail-value" style="color:var(--color-text-secondary);font-style:italic;">${escAttr(project.company_name)}</span>
                </div>` : ''}
                ${project.customer_email ? `
                <div class="detail-row">
                  <span class="detail-label">Email</span>
                  <span class="detail-value"><a href="mailto:${project.customer_email}" style="color: var(--color-primary); text-decoration: none;">${project.customer_email}</a></span>
                </div>
                ` : ''}
                ${project.customer_phone ? `
                <div class="detail-row">
                  <span class="detail-label">Phone</span>
                  <span class="detail-value"><a href="tel:${project.customer_phone}" style="color: var(--color-primary); text-decoration: none;">${project.customer_phone}</a></span>
                </div>
                ` : ''}
                ${fullAddress ? `
                <div class="detail-row">
                  <span class="detail-label">Address</span>
                  <span class="detail-value">
                    <a href="${mapsHref}" target="_blank" rel="noopener" style="color: var(--color-primary); text-decoration: none; display: inline-flex; align-items: center; gap: 6px;" title="Open in Maps">
                      ${fullAddress}
                      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                    </a>
                  </span>
                </div>
                ` : ''}
              </div>

              <!-- Col 2: services + scope description + linked quote PDFs -->
              <div class="cust-proj-col">
                <div class="detail-row">
                  <span class="detail-label">Services</span>
                  <span class="detail-value">${formatServices(project.services)}</span>
                </div>
                <div style="margin-top: 10px;">
                  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                    <label for="projScope-${project.id}" style="font-size: 12px; font-weight: 600; color: var(--color-text-secondary);">Scope</label>
                    <button type="button" id="projScopeEditBtn-${project.id}" data-locked="1" onclick="toggleScopeEdit(${project.id})" style="font-size: 12px; padding: 4px 10px; border-radius: var(--radius-sm); border: 1px solid var(--color-border); background: transparent; color: var(--color-text-secondary); cursor: pointer;">Edit</button>
                  </div>
                  <textarea
                    id="projScope-${project.id}"
                    class="form-textarea"
                    rows="4"
                    readonly
                    placeholder="What does this project include? (crew only, not shown to the customer)"
                    oninput="autoResize(this)"
                    style="resize: none; cursor: default; width: 100%;"
                  >${escAttr(initialScope)}</textarea>
                </div>

                <!-- Quote documents: every PDF the admin saved on the
                     originating quote's PDFs tab, plus the customer-signed
                     "Estimate: Signed" PDF generated on quote acceptance.
                     When both an "Estimate" and an "Estimate: Signed"
                     exist, we surface the signed copy first (with a
                     "Signed" pill) so the admin sees the canonical record
                     of what the customer actually accepted. -->
                ${(() => {
                  // Render the Quote documents block whenever EITHER:
                  //   (a) the originating quote has any attached PDFs, OR
                  //   (b) the customer signed the quote but no signed PDF
                  //       was auto-generated (Debbi's case — pre-flow accepts).
                  // The latter shows a backfill button so admin can generate
                  // the signed PDF without leaving the project page.
                  const attachments = Array.isArray(project.quote_attachments) ? project.quote_attachments : [];
                  const isSigned = (lbl) => {
                    const s = String(lbl || '').toLowerCase().replace(/\s+/g, ' ').trim();
                    return s === 'estimate: signed' || s === 'estimate - signed' || s.endsWith(', signed') || s.endsWith('- signed') || s.endsWith('signed');
                  };
                  const signed = attachments.filter(a => isSigned(a.label));
                  const rest = attachments.filter(a => !isSigned(a.label));
                  const ordered = [...signed, ...rest];
                  const hasSignedPdf = signed.length > 0;
                  const needsBackfill = !!project.quote_has_signature && !hasSignedPdf && !!project.quote_id;
                  if (ordered.length === 0 && !needsBackfill) return '';
                  return `
                <div style="margin-top: 14px; padding-top: 12px; border-top: 1px dashed var(--glass-border);">
                  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                    <span style="font-size: 12px; font-weight: 600; color: var(--color-text-secondary);">Documents</span>
                    <button type="button" onclick="switchProjectTabByName('documents', ${project.id})" style="font-size: 11px; color: var(--color-primary); text-decoration: none; background: none; border: none; cursor: pointer; padding: 0;">Manage →</button>
                  </div>
                  <div style="display: flex; flex-direction: column; gap: 6px;">
                    ${ordered.map(att => {
                      const signedFlag = isSigned(att.label);
                      const pill = signedFlag
                        ? `<span style="font-size:10px; font-weight:700; padding:2px 6px; border-radius:999px; background:rgba(34,197,94,0.18); color:#86efac; text-transform:uppercase; letter-spacing:0.3px; flex-shrink:0;">Signed</span>`
                        : '';
                      const iconStroke = signedFlag ? '#22c55e' : '#ef4444';
                      return `
                      <a href="${att.file_url}" target="_blank" rel="noopener" style="display: flex; align-items: center; gap: 8px; padding: 8px 10px; background: rgba(255,255,255,0.03); border: 1px solid var(--glass-border); border-radius: var(--radius-sm); font-size: 13px; text-decoration: none; color: var(--color-text-primary);">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="${iconStroke}" stroke-width="2" style="flex-shrink:0;"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                        <span style="flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">${escAttr(att.label || 'Estimate')}</span>
                        ${pill}
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="opacity:0.5; flex-shrink:0;"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                      </a>
                      `;
                    }).join('')}
                    ${needsBackfill ? `
                    <div data-needs-signed-pdf id="signedPdfWarn-${project.id}" style="margin-top: 4px; padding: 10px 12px; background: rgba(245, 158, 11, 0.08); border: 1px solid rgba(245, 158, 11, 0.3); border-radius: var(--radius-sm); font-size: 12px;">
                      <div style="color: #fcd34d; margin-bottom: 6px;">
                        <strong>Signed quote PDF missing.</strong> Generating it now…
                      </div>
                      <button type="button" class="btn-sm btn-secondary" onclick="backfillSignedQuotePdfFromProject(${project.quote_id}, ${project.id}, this)">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align: middle; margin-right: 4px;"><polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>
                        Generate signed PDF
                      </button>
                    </div>
                    ` : ''}
                  </div>
                </div>
                  `;
                })()}
              </div>

              <!-- Col 3: schedule -->
              <div class="cust-proj-col">
                <div class="editable-section" id="projSchedule-${project.id}" data-locked="1">
                  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
                    <span style="font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: var(--color-text-secondary);">Schedule</span>
                    <button type="button" class="section-edit-btn" data-locked="1" onclick="toggleSectionLock('projSchedule-${project.id}', this)">Edit</button>
                  </div>
                  <div class="form-group" style="margin-bottom: 10px;">
                    <label for="schedStart-${project.id}">Start Date</label>
                    <input type="date" id="schedStart-${project.id}" class="form-input" value="${project.scheduled_start || project.quote_estimated_start || ''}" readonly />
                  </div>
                  <div class="form-group">
                    <label for="schedEnd-${project.id}">End Date</label>
                    <input type="date" id="schedEnd-${project.id}" class="form-input" value="${project.scheduled_end || project.quote_estimated_end || ''}" readonly />
                  </div>
                </div>
              </div>
            </div>
          </div>
            `;
          })()}

          <!-- Materials / Labor / Pricing Summary retired (Phase 6B).
               Pricing now lives on the Contract tab: scopes carry their own
               subtotals, the contract's payment schedule shows what the
               customer owes + when, and the total flows from contract →
               project for the customer-portal receipt. -->

          <!-- Internal Notes (whole-project, admin-only). Quote notes flow in
               here on promotion; editable so admins can keep each other in the
               loop. Never shown to the customer or crew: distinct from the
               Crew tab's Crew Notes. -->
          <div class="detail-section">
            <div class="detail-section-title">Internal Notes</div>
            <p style="font-size: 11px; color: var(--color-text-secondary); margin: -4px 0 8px;">
              Private notes for the whole project, shared across the admin team: <strong>not visible to the customer or crew</strong>. Carried over from the quote on promotion.
            </p>
            <textarea id="internalNotes" class="form-textarea" rows="4" placeholder="e.g., Customer is price-sensitive: don't mention the supplier discount. Gate code is 4821. Follow up about the backsplash tile choice next week.">${escAttr(internalNotesText)}</textarea>
            <div style="display:flex; justify-content:flex-end; margin-top:8px;">
              <button type="button" class="btn-sm btn-primary" onclick="saveInternalNotes(${project.id}, this)">Save Notes</button>
            </div>
          </div>

          <!-- Client Portal Access -->
          <div class="detail-section">
            <div class="detail-section-title">Client Portal Access</div>
            <div class="client-link">
              <a href="${location.origin}/project/${project.client_token}" target="_blank">
                ${location.origin.replace(/^https?:\/\//, '')}/project/${project.client_token}
              </a>
              <button class="btn-copy" onclick="copyLink('client', '${project.client_token}')">Copy</button>
            </div>
          </div>

          <!-- Reference Media (admin only — accepts images and videos) -->
          <div class="detail-section">
            <div class="detail-section-title" style="display: flex; justify-content: space-between; align-items: center;">
              <span>Reference Media${refCountLabel ? ` <span style="font-weight:400; font-size:12px; color:var(--color-text-secondary);">&middot; ${refCountLabel}</span>` : ''}</span>
              <button type="button" class="btn-sm btn-secondary" onclick="openImageUpload(${project.id})">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                  <polyline points="17 8 12 3 7 8"/>
                  <line x1="12" y1="3" x2="12" y2="15"/>
                </svg>
                Add Media
              </button>
            </div>
            <div class="upload-progress-bar" id="projUploadProgress-${project.id}" style="display: none;">
              <div class="upload-progress-text" id="projUploadText-${project.id}">Uploading...</div>
              <div class="upload-progress-track">
                <div class="upload-progress-fill" id="projUploadFill-${project.id}"></div>
              </div>
            </div>
            ${imagesHtml}
          </div>

          </div><!-- /Details Tab -->

          <!-- Contract Tab — Phase 6B template-driven flow. Replaces the
               legacy "upload a PDF" UI with a thin shell that owns the
               contract lifecycle: apply a template → edit on the dedicated
               /admin/projects/[id]/contract page → preview PDF → send to
               customer for signing → mark countersigned. JS-rendered so
               the tab fetches its own state on activation (loadContractTab). -->
          <div class="proj-tab-content" data-proj-tab-content="contract">
            <div id="contractTab-${project.id}" data-project-id="${project.id}" data-project-status={project.status}>
              <div class="detail-section">
                <div class="detail-section-title">Contract</div>
                <div style="padding: 24px 12px; text-align: center; color: var(--color-text-secondary); font-size: 13px;">Loading contract…</div>
              </div>
            </div>
          </div>

          <!-- Crew Tab -->
          <div class="proj-tab-content" data-proj-tab-content="crew">
            <!-- Crew Assignment + Portal Access — 50/50 two-column row -->
            <div class="crew-tab-row">
              <!-- Crew Assignment -->
              <div class="detail-section crew-tab-col">
                <div class="detail-section-title">Crew Assignment</div>
                <div class="form-group">
                  <label>Crew Lead</label>
                  <select id="crewLeadSelect" class="form-select">
                    <option value="">Select crew lead...</option>
                    ${crewOptions}
                  </select>
                </div>
                <p style="font-size: 11px; color: var(--color-text-secondary); margin: -4px 0 8px;">
                  Need to add a new crew lead? Go to <a href="/admin/crew" style="color: var(--color-primary); text-decoration: none;">Crew</a>, new leads are created there and become available here.
                </p>
                <div class="form-group">
                  <label>Crew Notes</label>
                  <textarea id="crewNotes" class="form-textarea" rows="2" placeholder="e.g., Working with Pedro and Esteban">${project.crew_notes || ''}</textarea>
                </div>
              </div>

              <!-- Crew Portal Access -->
              ${project.crew_token ? `
              <div class="detail-section crew-tab-col">
                <div class="detail-section-title">Crew Portal Access</div>
                <div class="client-link" style="background: rgba(139, 92, 246, 0.1);">
                  <a href="${location.origin}/project/crew/${project.crew_token}" target="_blank" style="color: #8b5cf6;">
                    ${location.origin.replace(/^https?:\/\//, '')}/project/crew/${project.crew_token}
                  </a>
                  <button class="btn-copy" onclick="copyLink('crew', '${project.crew_token}')" style="background: #8b5cf6;">Copy</button>
                </div>
                <p style="font-size: 11px; color: var(--color-text-secondary); margin-top: 8px;">
                  Share this link with the assigned crew lead. They can view job details and upload progress photos.
                </p>
              </div>
              ` : ''}
            </div>
          </div>

          <!-- Documents Tab — PDFs owned by the project (promoted from the
               quote + anything the admin adds). Full add/relabel/remove. -->
          <div class="proj-tab-content" data-proj-tab-content="documents">
            <div class="detail-section">
              <div class="detail-section-title" style="display:flex; justify-content:space-between; align-items:center; gap:8px;">
                <span>Documents</span>
                <button type="button" class="btn-sm btn-primary" onclick="document.getElementById('projDocInput-${project.id}').click()">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align:middle; margin-right:4px;"><path d="M12 5v14M5 12h14"/></svg>
                  Add PDF
                </button>
              </div>
              <p style="font-size:12px; color:var(--color-text-secondary); margin:-2px 0 12px;">
                PDFs attached to this project: the customer-signed estimate and any quote PDFs carried over on promotion, plus anything you add here (permits, supplier estimates, change orders, etc.).
              </p>
              <input type="file" id="projDocInput-${project.id}" accept="application/pdf" style="display:none;" onchange="uploadProjectDocument(${project.id}, this)" />
              <div id="projDocsList-${project.id}" data-project-id="${project.id}" data-project-status={project.status} style="display:flex; flex-direction:column; gap:8px;">
                <div style="font-size:12px; color:var(--color-text-secondary); padding:8px 0;">Loading…</div>
              </div>
            </div>
          </div>

          <!-- Messages Tab -->
          ${project.customer_email && project.quote_id ? `
          <div class="proj-tab-content" data-proj-tab-content="messages">
            <div class="messages-compose">
              <div class="compose-row">
                <label>Subject</label>
                <input type="text" id="projMsgSubject-${project.id}" class="form-input" value="MannyKnows Project | #${project.project_number || project.id}" oninput="saveMsgDraft(${project.id})" />
              </div>
              <div class="compose-row">
                <label>Message</label>
                <textarea id="projMsgBody-${project.id}" class="form-input form-textarea" placeholder="Type your message to the customer..." oninput="saveMsgDraft(${project.id})"></textarea>
              </div>
              <input type="file" id="projAttachInput-${project.id}" accept="image/*,video/*,application/pdf" multiple style="display:none;" onchange="handleMsgAttach(event,${project.id})" />
              <div id="projAttachList-${project.id}" style="display:flex;flex-wrap:wrap;gap:8px;margin-bottom:4px;"></div>
              <div class="compose-actions">
                <button type="button" class="btn btn-secondary" style="font-size:12px;padding:5px 12px;" onclick="openMsgAttachPicker(${project.id})">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align:middle;margin-right:4px;"><path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/></svg>
                  Add file
                </button>
                <button class="btn btn-polish" type="button" onclick="polishProjectMessage(${project.id}, '${(project.customer_name || '').replace(/'/g, "\\'")}')">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2L15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2z"/></svg>
                  <span class="polish-text">Polish</span>
                  <span class="polish-loading" style="display:none;"><span class="spinner-sm"></span> Polishing...</span>
                </button>
                <button class="btn btn-secondary" type="button" id="projMsgUndo-${project.id}" style="display:none;" onclick="undoPolish(${project.id})">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 7v6h6"/><path d="M21 17a9 9 0 0 0-9-9 9 9 0 0 0-6 2.3L3 13"/></svg>
                  Undo polish
                </button>
                <button class="btn btn-success" onclick="sendProjectMessage(${project.id}, ${project.quote_id}, '${project.customer_email}', '${(project.customer_name || '').replace(/'/g, "\\'")}')">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="22" y1="2" x2="11" y2="13"/>
                    <polygon points="22 2 15 22 11 13 2 9 22 2"/>
                  </svg>
                  Send Email
                </button>
              </div>
            </div>

            <div class="messages-log">
              <div class="messages-log-title">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                Message History
              </div>
              <div id="projMessages-${project.id}" class="proj-messages-container">
                <div class="messages-empty">
                  <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                  </svg>
                  <p>No messages sent yet</p>
                </div>
              </div>
            </div>
          </div>
          ` : ''}

          <!-- Management Tab -->
          <div class="proj-tab-content" data-proj-tab-content="management">
            <div class="management-section">
              <h3 class="management-title">Representing</h3>
              <p class="management-desc">Who the customer sees this project as. <strong>Internal</strong> = MannyKnows branding; a partner white-labels every customer-facing email, the client portal, and the PDFs. This is set when the record is created and can't be changed here.</p>
              <div style="display:flex; gap:8px; align-items:center; flex-wrap:wrap;">
                <span id="projPartnerBadge-${project.id}" style="font-size:13px; font-weight:600; padding:5px 14px; border-radius:999px; ${project.partner_id ? 'background:rgba(245,158,11,0.15); color:#fbbf24;' : 'background:rgba(148,163,184,0.15); color:#a1a1aa;'}">
                  ${project.partner_id ? 'White-labeled: ' + escAttr(project.partner_name || 'Partner') : 'Internal (MannyKnows)'}
                </span>
              </div>
            </div>
            <div class="management-section">
              <h3 class="management-title">Project Management</h3>
              <p class="management-desc">These actions affect the project's lifecycle. Use with care.</p>
              <div class="management-actions">
