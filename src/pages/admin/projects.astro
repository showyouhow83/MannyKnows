  <!-- Mark as Already Paid Modal -->
  <div class="modal" id="markPaidModal">
    <div class="modal-backdrop" onclick="closeMarkPaidModal()"></div>
    <div class="modal-content" style="max-width:380px;">
      <div class="modal-icon success">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>
        </svg>
      </div>
      <h3 class="modal-title">Mark as already paid</h3>
      <p class="modal-text" id="markPaidLabel" style="margin-bottom:16px;"></p>
      <div style="display:flex;flex-direction:column;gap:10px;text-align:left;">
        <div>
          <label style="font-size:11px;font-weight:600;color:var(--color-text-secondary);text-transform:uppercase;letter-spacing:.5px;display:block;margin-bottom:4px;">Payment method</label>
          <select id="markPaidMethod" style="width:100%;padding:8px 10px;border-radius:8px;border:1px solid var(--color-border);background:var(--color-surface);color:var(--color-text);font-size:13px;">
            <option value="cash">Cash</option>
            <option value="check">Check</option>
            <option value="bank transfer">Bank Transfer</option>
