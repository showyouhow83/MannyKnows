    // ─── Documents tab ───────────────────────────────────────────────────
    // PDFs owned by the project: promoted from the quote + admin-added.
    async function loadProjectDocuments(projectId) {
      var list = document.getElementById('projDocsList-' + projectId);
      if (!list) return;
      try {
        var res = await fetch('/api/projects/' + projectId + '/documents/', { credentials: 'include' });
        var data = await res.json();
        renderProjectDocuments(projectId, (data && data.documents) || [], (data && data.contract) || null);
      } catch (e) {
        list.innerHTML = '<div style="font-size:12px; color:#f87171; padding:8px 0;">Failed to load documents.</div>';
      }
    }
    window.loadProjectDocuments = loadProjectDocuments;

    function isSignedDocLabel(lbl) {
      var s = String(lbl || '').toLowerCase().replace(/\s+/g, ' ').trim();
      return s.endsWith(': signed') || s.endsWith('- signed') || s.endsWith('signed');
    }

    // Read-only card for the structured contract (managed on the Contract
    // tab, not removable here). Links the live preview = always-current
    // signatures, same as the client portal.
    function contractDocCard(contract) {
      if (!contract || !contract.url) return '';
      var pill = contract.signed
        ? '<span style="font-size:10px; font-weight:700; padding:2px 6px; border-radius:999px; background:rgba(34,197,94,0.18); color:#86efac; text-transform:uppercase; letter-spacing:0.3px; flex-shrink:0;">Signed</span>'
        : '<span style="font-size:10px; font-weight:600; padding:2px 6px; border-radius:999px; background:rgba(245,158,11,0.15); color:#fbbf24; flex-shrink:0;">Awaiting signature</span>';
      return '<div class="contract-file-card" style="display:flex; align-items:center; gap:10px; padding:8px 10px; background:rgba(59,130,246,0.06); border:1px solid rgba(59,130,246,0.25); border-radius:var(--radius-sm);">' +
          '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#3b82f6" stroke-width="2" style="flex-shrink:0;"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>' +
          '<span style="flex:1; min-width:0; font-size:13px; font-weight:600; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">' + escAttrJs(contract.label || 'Contract') + '</span>' +
          pill +
          '<a href="' + escAttrJs(contract.url) + '" target="_blank" rel="noopener" style="color:var(--color-primary); font-size:12px; text-decoration:none; white-space:nowrap;">View</a>' +
        '</div>';
    }

    function renderProjectDocuments(projectId, docs, contract) {
      var list = document.getElementById('projDocsList-' + projectId);
      if (!list) return;
      // On a completed project, an unsigned/draft contract is stale (e.g. the
      // draft contract migrated partner jobs carry) — hide its card so the
      // signing link stops confusing the admin. Signed contracts still show.
      var completed = (list.getAttribute('data-project-status') || '') === 'completed';
      if (completed && contract && !contract.signed) contract = null;
      var contractHtml = contractDocCard(contract);
      if (!docs.length && !contractHtml) {
        list.innerHTML = '<div style="font-size:12px; color:var(--color-text-secondary); padding:8px 0;">No documents yet. Add a PDF, or promote a quote / sign a contract.</div>';
        return;
      }
      // Signed estimate(s) first.
      var signed = docs.filter(function(d){ return isSignedDocLabel(d.label); });
      var rest = docs.filter(function(d){ return !isSignedDocLabel(d.label); });
      var ordered = signed.concat(rest);
      list.innerHTML = contractHtml + ordered.map(function(d) {
        var signedFlag = isSignedDocLabel(d.label);
        var iconStroke = signedFlag ? '#22c55e' : '#ef4444';
        var promoted = d.source === 'quote_promotion';
        var pill = signedFlag
          ? '<span style="font-size:10px; font-weight:700; padding:2px 6px; border-radius:999px; background:rgba(34,197,94,0.18); color:#86efac; text-transform:uppercase; letter-spacing:0.3px; flex-shrink:0;">Signed</span>'
          : (promoted ? '<span style="font-size:10px; font-weight:600; padding:2px 6px; border-radius:999px; background:rgba(148,163,184,0.15); color:#a1a1aa; flex-shrink:0;" title="Carried over from the quote on promotion">from quote</span>' : '');
        return '<div class="contract-file-card" data-doc-id="' + d.id + '" style="display:flex; align-items:center; gap:10px; padding:8px 10px; background:rgba(255,255,255,0.03); border:1px solid var(--glass-border); border-radius:var(--radius-sm);">' +
            '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="' + iconStroke + '" stroke-width="2" style="flex-shrink:0;"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>' +
            '<input type="text" value="' + escAttrJs(d.label || 'Document') + '" data-doc-label="' + d.id + '" onchange="relabelProjectDocument(' + d.id + ', this.value)" style="flex:1; min-width:0; padding:6px 10px; background:rgba(255,255,255,0.05); border:1px solid var(--glass-border); border-radius:6px; color:var(--color-text-primary); font-size:13px;" />' +
            pill +
            '<a href="' + escAttrJs(d.file_url) + '" target="_blank" rel="noopener" style="color:var(--color-primary); font-size:12px; text-decoration:none; white-space:nowrap;">View</a>' +
            '<button type="button" onclick="deleteProjectDocument(' + d.id + ', ' + projectId + ')" class="btn-sm" style="background:none; border:1px solid #dc2626; color:#dc2626; padding:4px 10px; font-size:11px; cursor:pointer; border-radius:4px;">Remove</button>' +
          '</div>';
      }).join('');
    }

    function escAttrJs(s) {
      return String(s == null ? '' : s).replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
    }

    async function uploadProjectDocument(projectId, input) {
      var file = input.files && input.files[0];
      input.value = '';
      if (!file) return;
      if (file.type !== 'application/pdf') { showToast('Only PDFs are allowed', 'error'); return; }
      if (file.size > 20 * 1024 * 1024) { showToast('File too large (max 20MB)', 'error'); return; }
      var defaultLabel = file.name.replace(/\.pdf$/i, '').slice(0, 80) || 'Document';
      showToast('Uploading…', 'info');
      try {
        var res = await fetch('/api/projects/' + projectId + '/documents/', {
          method: 'POST', credentials: 'include',
          headers: {
            'Content-Type': 'application/pdf',
            'X-Document-Label': encodeURIComponent(defaultLabel),
            'X-Document-Filename': encodeURIComponent(file.name),
          },
          body: file,
        });
        var data = await res.json();
        if (data.success) { showToast('Document added', 'success'); loadProjectDocuments(projectId); }
        else showToast(data.error || 'Upload failed', 'error');
      } catch (e) { showToast('Upload failed', 'error'); }
    }
    window.uploadProjectDocument = uploadProjectDocument;

    async function relabelProjectDocument(docId, label) {
      try {
        await fetch('/api/projects/documents/' + docId + '/', {
          method: 'PATCH', credentials: 'include',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ label: label }),
        });
      } catch (e) { /* silent: label is non-critical */ }
    }
    window.relabelProjectDocument = relabelProjectDocument;

    function deleteProjectDocument(docId, projectId) {
      showConfirmModal('Remove document?', 'This removes the PDF from this project. Promoted quote PDFs are only unlinked here: the original quote keeps its copy.', 'Remove', 'danger', async function() {
        try {
          var res = await fetch('/api/projects/documents/' + docId + '/', { method: 'DELETE', credentials: 'include' });
          var data = await res.json();
          if (data.success) { showToast('Removed', 'success'); loadProjectDocuments(projectId); }
          else showToast(data.error || 'Failed to remove', 'error');
        } catch (e) { showToast('Failed to remove', 'error'); }
      });
    }
    window.deleteProjectDocument = deleteProjectDocument;


    // ─── Contract tab — Phase 6B ─────────────────────────────────────────
    // Thin shell. Empty state: pick a contract template + Apply. Loaded state:
    // status + summary (totals, scopes, payment count) + actions (Open editor,
    // Preview PDF, Regenerate schedule, Send to customer, Void). The full
    // section/item editing happens on the dedicated /admin/projects/[id]/contract
    // page — same split as quote-templates list → editor.
    const contractTemplatesCache = { loaded: false, list: [] };

    async function loadContractTemplates() {
      if (contractTemplatesCache.loaded) return contractTemplatesCache.list;
      try {
        const res = await fetch('/api/admin/contract-templates/', { credentials: 'include' });
        const data = await res.json();
        if (data.success && Array.isArray(data.templates)) {
          contractTemplatesCache.list = data.templates;
          contractTemplatesCache.loaded = true;
        }
      } catch {}
      return contractTemplatesCache.list;
    }

    function fmtCurrency(n) {
      var v = Number(n);
      if (!isFinite(v)) v = 0;
      return '$' + v.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }
    // 'HH:MM' (24h) → '3:00 PM'. Returns '' for empty/invalid.
    function fmtTime12(s) {
      var m = /^(\d{2}):(\d{2})$/.exec(String(s || ''));
      if (!m) return '';
      var h = parseInt(m[1], 10), min = m[2];
      var ampm = h >= 12 ? 'PM' : 'AM';
      var h12 = h % 12; if (h12 === 0) h12 = 12;
      return h12 + ':' + min + ' ' + ampm;
    }
    function fmtDate(s) {
      if (!s) return '—';
      try {
        // Two shapes hit this:
        //   • 'YYYY-MM-DD'                — a contract.start_date column
        //   • 'YYYY-MM-DD HH:MM:SS'       — SQLite CURRENT_TIMESTAMP (signed_at)
        // Strip the time portion so we always have just the date, then add
        // a fixed T00:00:00 to keep the locale render stable.
        var trimmed = String(s).split(/[\sT]/)[0];
        var d = new Date(trimmed + 'T00:00:00');
        if (isNaN(d.getTime())) return s;
        return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
      } catch { return s; }
    }
    function escapeAttr(s) {
      return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    async function loadContractTab(projectId) {
      const shell = document.getElementById('contractTab-' + projectId);
      if (!shell) return;
      shell.innerHTML = '<div class="detail-section"><div style="padding: 24px 12px; text-align: center; color: var(--color-text-secondary); font-size: 13px;">Loading contract…</div></div>';

      try {
        const res = await fetch('/api/projects/' + projectId + '/contract/', { credentials: 'include' });
        const data = await res.json();
        if (!data.success) {
          shell.innerHTML = '<div class="detail-section"><div style="padding: 18px; color: #fca5a5;">Failed to load contract: ' + escapeAttr(data.error || 'unknown') + '</div></div>';
          return;
        }
        if (!data.contract) {
          await renderContractEmptyState(projectId, shell);
        } else {
          renderContractLoadedState(projectId, shell, data.contract, data.signatures || [], data.receipts || [], data.availability || [], data.invoices || []);
        }
      } catch (err) {
        shell.innerHTML = '<div class="detail-section"><div style="padding: 18px; color: #fca5a5;">Failed to load contract.</div></div>';
      }
    }
    window.loadContractTab = loadContractTab;

    async function renderContractEmptyState(projectId, shell) {
      const templates = await loadContractTemplates();
      const active = templates.filter(function(t) { return !t.archived; });
      const optionsHtml = active.length
        ? active.map(function(t) {
            return '<option value="' + t.id + '"' + (t.is_default ? ' selected' : '') + '>' + escapeAttr(t.name) + ' (' + escapeAttr(t.project_type) + ')</option>';
          }).join('')
        : '<option value="">No templates available</option>';
      shell.innerHTML = '\
        <div class="detail-section">\
          <div class="detail-section-title">Contract</div>\
          <p style="font-size: 13px; color: var(--color-text-secondary); margin: 0 0 14px;">No contract for this project yet. Apply a contract template to seed scope, payment schedule, and terms. You can edit everything afterwards.</p>\
          <div style="display: flex; gap: 8px; align-items: end; flex-wrap: wrap;">\
            <div style="flex: 1; min-width: 220px;">\
              <label class="form-label" style="display: block; margin-bottom: 4px; font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px; color: var(--color-text-secondary);">Contract template</label>\
              <select id="contractTplPicker-' + projectId + '" class="form-input">' + optionsHtml + '</select>\
            </div>\
            <button class="btn btn-primary" id="contractApplyBtn-' + projectId + '" onclick="applyContractTemplate(' + projectId + ')"' + (active.length ? '' : ' disabled') + '>+ Apply template</button>\
          </div>\
          ' + (active.length ? '' : '<p style="margin-top: 10px; font-size: 12px; color: #fca5a5;">No active contract templates. <a href="/admin/contract-templates" style="color: #fca5a5;">Create one →</a></p>') + '\
        </div>';
    }

    function renderContractLoadedState(projectId, shell, contract, signatures, receipts, availability, invoices) {
      const scopes = Array.isArray(contract.scopes) ? contract.scopes : [];
      const sched = Array.isArray(contract.payment_schedule) ? contract.payment_schedule : [];
      const receiptByRow = {};
      (Array.isArray(receipts) ? receipts : []).forEach(function(r) { receiptByRow[r.row_id] = r; });
      const availByRow = {};
      (Array.isArray(availability) ? availability : []).forEach(function(a) { availByRow[a.row_id] = a; });
      const invoiceByRow = {};
      (Array.isArray(invoices) ? invoices : []).forEach(function(iv) { invoiceByRow[iv.row_id] = iv; });
      _invoiceByRow = invoiceByRow;
      const totalSections = scopes.reduce(function(sum, s) { return sum + (Array.isArray(s.sections) ? s.sections.length : 0); }, 0);
      const downRows = sched.filter(function(r) { return r.kind === 'down'; });
      const monthlyRows = sched.filter(function(r) { return r.kind === 'monthly'; });
      const downTotal = downRows.reduce(function(s, r) { return s + (Number(r.amount) || 0); }, 0);
      const monthlyTotal = monthlyRows.reduce(function(s, r) { return s + (Number(r.amount) || 0); }, 0);

      const statusBadge = (function() {
        const map = {
          draft: { color: '#a1a1aa', label: 'Draft' },
          sent: { color: '#3b82f6', label: 'Sent to customer' },
          signed: { color: '#22c55e', label: 'Signed by customer' },
          countersigned: { color: '#22c55e', label: 'Fully executed' },
          void: { color: '#ef4444', label: 'Void' },
        };
        const m = map[contract.status] || map.draft;
        return '<span style="display: inline-flex; align-items: center; gap: 6px; font-size: 12px; font-weight: 700; padding: 4px 10px; border-radius: 999px; background: ' + m.color + '22; color: ' + m.color + ';"><span style="width: 6px; height: 6px; border-radius: 50%; background: ' + m.color + ';"></span>' + m.label + '</span>';
      })();

      const customerSignedAt = signatures.find(function(s) { return s.signer_role === 'customer'; });

      // Scanned copy of a paper/offline-signed contract, if one was attached.
      var offlineScanUrl = '';
      try { var _t = typeof contract.terms === 'string' ? JSON.parse(contract.terms || '{}') : (contract.terms || {}); offlineScanUrl = _t.offline_scan_url || ''; } catch (e) {}
      var offlineScanLink = offlineScanUrl
        ? '<a href="' + escapeAttr(offlineScanUrl) + '" target="_blank" rel="noopener" style="color:#86efac; font-size:12px; text-decoration:none; font-weight:600; display:inline-flex; align-items:center; gap:4px;" title="Open the scanned paper copy the customer signed."><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg> View signed copy</a>'
        : '';

      const customerLink = contract.contract_token
        ? location.origin + '/project/contract/' + contract.contract_token
        : '';

      const lockedForEdits = contract.status === 'signed' || contract.status === 'countersigned';
      // On a completed project, an unsigned/draft contract has served its
      // purpose (and migrated partner jobs carry a draft contract that was
      // never used). Hide the live signing affordances so the stale signing
      // link stops confusing the admin. A signed contract still shows fully.
      const projectCompleted = (shell && shell.getAttribute('data-project-status')) === 'completed';
      const showSigningActions = !projectCompleted || lockedForEdits;

      // Overflow (⋯) menu — rare + destructive actions kept out of the primary
      // action row. Built state-aware; the kebab only renders if it has items.
      const menuItems = [];
      if (!lockedForEdits) {
        menuItems.push('<button onclick="regenerateContractSchedule(' + projectId + ')" title="Recompute the payment rows from the current total, start date, and counts. Overwrites manual edits to existing rows.">Reset schedule</button>');
      }
      if (contract.status !== 'void') {
        menuItems.push('<button onclick="openSignOfflineModal(' + projectId + ')" title="Record that this contract was signed on paper / offline (no e-signature captured).">Mark signed offline</button>');
      }
      if (contract.status !== 'void') {
        menuItems.push('<button class="danger" onclick="voidContract(' + projectId + ')" title="Cancel this contract but keep it on record. The signing link stops working; you can start a new one.">Void contract</button>');
      }
      if (contract.status === 'void' || contract.status === 'signed' || contract.status === 'countersigned') {
        menuItems.push('<button class="danger" onclick="deleteContractAndStartOver(' + projectId + ')" title="Erase this contract, its signatures, and the signing link, then pick a fresh template. Cannot be undone.">Delete &amp; start over</button>');
      }
      const contractMenu = menuItems.length
        ? '<div class="cmenu-wrap"><button class="cmenu-kebab" title="More options" onclick="toggleContractMenu(event, \'cmenu' + projectId + '\')">⋯</button><div class="cmenu" id="cmenu' + projectId + '">' + menuItems.join('') + '</div></div>'
        : '';

      // Every row gets a Collect / ✓ Paid action so payments can be recorded
      // (with both signatures) as money comes in. A row with a receipt is
      // "paid" — its button flips to a green badge that links to the same page
      // to view/redo. The collect flow lives on its own page (good on an iPad).
      const collectDisabled = contract.status === 'void';
      const previewSched = sched.map(function(r, i) {
        const rec = receiptByRow[r.id];
        const collectUrl = '/admin/projects/' + projectId + '/collect/' + encodeURIComponent(r.id) + '/';
        let action;
        if (rec) {
          // Paid = a non-clickable status pill (no accidental overwrite). A
          // small, deliberate "edit" link remains for genuine corrections.
          action = '<span style="display:inline-block; font-size:11px; font-weight:700; padding:4px 10px; border-radius:6px; border:1px solid rgba(34,197,94,0.5); background:rgba(34,197,94,0.14); color:#86efac; white-space:nowrap;" title="Collected ' + (rec.collected_at ? fmtDate(rec.collected_at) : '') + (rec.check_number ? ' · #' + escapeAttr(rec.check_number) : '') + '">✓ ' + escapeAttr(rec.payment_method || 'paid') + (rec.check_number ? ' #' + escapeAttr(rec.check_number) : '') + '</span>'
            + ' <a href="' + collectUrl + '" style="font-size:10px; color:var(--color-text-secondary); text-decoration:underline; white-space:nowrap; margin-left:4px;" title="Correct or undo this receipt">edit</a>';
        } else if (collectDisabled) {
          action = '<span style="font-size:11px; color: var(--color-text-secondary);">—</span>';
        } else {
          const markPaidArgs = projectId + ',\'' + r.id.replace(/'/g, "\\'") + '\',' + r.amount + ',\'' + escapeAttr(r.label || r.kind).replace(/'/g, "\\'") + '\'';
          const iv = invoiceByRow[r.id];
          const invoiceLabel = iv ? 'Resend invoice' : 'Send Invoice';
          const invoicedNote = iv && iv.sent_at
            ? '<span style="font-size:10px; color:var(--color-text-secondary); white-space:nowrap;" title="Last invoice sent ' + escapeAttr(fmtDate(iv.sent_at)) + (iv.send_count > 1 ? ' (' + iv.send_count + ' sent)' : '') + '">Invoiced ' + escapeAttr(fmtDate(iv.sent_at)) + '</span>'
            : '';
          action = '<span style="display:inline-flex;gap:6px;align-items:center;flex-wrap:wrap;justify-content:flex-end;">'
            + '<a href="' + collectUrl + '" style="display:inline-block; text-decoration:none; font-size:11px; font-weight:700; padding:4px 12px; border-radius:6px; border:1px solid var(--color-primary); background:rgba(0, 113, 227,0.12); color:#93c5fd; white-space:nowrap;" title="Record this payment + capture both signatures">Collect</a>'
            + '<button onclick="quickMarkPaid(' + markPaidArgs + ')" style="display:inline-block; font-size:11px; font-weight:700; padding:4px 10px; border-radius:6px; border:1px solid rgba(34,197,94,0.4); background:rgba(34,197,94,0.1); color:#86efac; white-space:nowrap; cursor:pointer;" title="Mark as already received (no signature required)">Mark paid</button>'
            + '<button onclick="sendInvoice(' + markPaidArgs + ')" style="display:inline-block; font-size:11px; font-weight:700; padding:4px 10px; border-radius:6px; border:1px solid rgba(148,163,184,0.5); background:rgba(148,163,184,0.12); color:#cbd5e1; white-space:nowrap; cursor:pointer;" title="Email the customer an invoice with check-mailing instructions">' + invoiceLabel + '</button>'
            + invoicedNote
            + '</span>';
        }
        const av = availByRow[r.id];
        // Customer availability: a meeting TIME on the contract due date by
        // default, or a REQUESTED alternate date (+time) if they asked for one.
        let avText = '';
        if (!rec && av && (av.available_date || av.available_time || av.note)) {
          const t = av.available_time ? fmtTime12(av.available_time) : '';
          if (av.available_date) {
            avText = '⚠️ Requested another date: ' + escapeAttr(fmtDate(av.available_date)) + (t ? ' at ' + t : '');
          } else if (t) {
            avText = '🗓 Can meet at ' + t + ' on the due date';
          } else if (av.note) {
            avText = '🗓 Customer note';
          }
          if (av.note) avText += ' · ' + escapeAttr(av.note);
        }
        const avLine = avText
          ? '<tr><td colspan="4" style="padding: 0 8px 6px; font-size: 11px; color: ' + (av && av.available_date ? '#fcd34d' : '#93c5fd') + ';">' + avText + '</td></tr>'
          : '';
        return '<tr><td data-label="Payment" style="padding: 6px 8px; color: var(--color-text-secondary); font-size: 12px;">' + (i + 1) + '. ' + escapeAttr(r.label || r.kind) + '</td><td data-label="Due" style="padding: 6px 8px; font-size: 12px;">' + fmtDate(r.due_date) + '</td><td data-label="Amount" style="padding: 6px 8px; font-size: 12px; text-align: right; font-weight: 600;">' + fmtCurrency(r.amount) + '</td><td data-label="Receipt" style="padding: 6px 8px; text-align: right;">' + action + '</td></tr>' + avLine;
      }).join('');
      const overflow = '';

      shell.innerHTML = '\
        <div class="detail-section">\
          <div style="display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; margin-bottom: 6px;">\
            <div class="detail-section-title" style="margin: 0;">Contract</div>\
            ' + statusBadge + '\
          </div>\
\
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin: 14px 0;">\
            <div>\
              <div style="font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: var(--color-text-secondary); margin-bottom: 4px;">Total</div>\
              <div style="font-size: 18px; font-weight: 700;">' + fmtCurrency(contract.total) + '</div>\
            </div>\
            <div>\
              <div style="font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: var(--color-text-secondary); margin-bottom: 4px;">Start date</div>\
              <div style="font-size: 14px; font-weight: 600;">' + fmtDate(contract.start_date) + '</div>\
            </div>\
            <div>\
              <div style="font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: var(--color-text-secondary); margin-bottom: 4px;">Scopes</div>\
              <div style="font-size: 13px;">' + scopes.length + ' scope' + (scopes.length === 1 ? '' : 's') + ' · ' + totalSections + ' section' + (totalSections === 1 ? '' : 's') + '</div>\
            </div>\
            <div>\
              <div style="font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: var(--color-text-secondary); margin-bottom: 4px;">Schedule</div>\
              <div style="font-size: 13px;">' + downRows.length + ' down + ' + monthlyRows.length + ' monthly</div>\
              <div style="font-size: 11px; color: var(--color-text-secondary); margin-top: 2px;">Down ' + fmtCurrency(downTotal) + ' · Monthly ' + fmtCurrency(monthlyTotal) + '</div>\
            </div>\
          </div>\
\
          ' + (sched.length ? '<div style="margin: 14px 0; padding: 10px 12px; background: rgba(255,255,255,0.02); border: 1px solid var(--glass-border); border-radius: var(--radius-md);"><table class="pay-table" style="width: 100%; border-collapse: collapse;"><thead><tr><th style="text-align: left; padding: 4px 8px; font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: var(--color-text-secondary);">Payment</th><th style="text-align: left; padding: 4px 8px; font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: var(--color-text-secondary);">Due</th><th style="text-align: right; padding: 4px 8px; font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: var(--color-text-secondary);">Amount</th><th style="text-align: right; padding: 4px 8px; font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: var(--color-text-secondary);">Receipt</th></tr></thead><tbody>' + previewSched + overflow + '</tbody></table></div>' : '') + '\
\
          ' + (customerSignedAt ? '<div style="margin: 12px 0; padding: 10px 12px; background: rgba(34, 197, 94, 0.08); border: 1px solid rgba(34, 197, 94, 0.3); border-radius: var(--radius-md); font-size: 12px; display: flex; justify-content: space-between; align-items: center; gap: 8px; flex-wrap: wrap;"><span>Signed by <strong>' + escapeAttr(customerSignedAt.signer_name) + '</strong> on ' + fmtDate(customerSignedAt.signed_at) + '</span>' + (offlineScanLink || (contract.contract_token ? '<a href="' + location.origin + '/project/contract-preview/' + contract.contract_token + '/" target="_blank" rel="noopener" style="color: #86efac; font-size: 12px; text-decoration: none; font-weight: 600; display: inline-flex; align-items: center; gap: 4px;" title="Open the full signed contract: view, print, or save as PDF.">View signed contract <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg></a>' : '<button class="btn-sm" style="background: rgba(245, 158, 11, 0.15); border: 1px solid rgba(245, 158, 11, 0.4); color: #fcd34d; padding: 4px 10px; font-size: 11px; cursor: pointer; border-radius: 4px;" onclick="backfillSignedContractPdf(' + projectId + ', this)" title="Regenerate the signed contract PDF (signature already on file).">Regenerate signed PDF</button>')) + '</div>' : '') + '\
\
          ' + (customerLink && showSigningActions ? '<div style="margin: 12px 0; padding: 8px 12px; background: rgba(255,255,255,0.02); border: 1px solid var(--glass-border); border-radius: var(--radius-md); font-size: 12px; display: flex; align-items: center; justify-content: space-between; gap: 8px; flex-wrap: wrap;"><span style="color: var(--color-text-secondary);">Customer signing link</span><a href="' + customerLink + '" target="_blank" rel="noopener" style="color: var(--color-primary); font-size: 11px; word-break: break-all;">' + customerLink + '</a></div>' : '') + '\
\
          <div class="contract-actions">\
            <a class="btn btn-primary btn-compact" href="/admin/projects/' + projectId + '/contract/">Open editor</a>\
            <button class="btn btn-secondary btn-compact" onclick="window.open(\'/admin/projects/' + projectId + '/contract/preview/\', \'_blank\', \'noopener\')">Preview PDF</button>\
            <span class="contract-actions-spacer"></span>\
            ' + ((contract.status === 'draft' || contract.status === 'sent') && !lockedForEdits && showSigningActions ? '<a class="btn btn-compact" href="/admin/projects/' + projectId + '/sign-in-person/" style="background: linear-gradient(135deg, #f59e0b, #d97706); color: #fff; border: none; text-decoration: none;" title="Open the in-person signing flow on an iPad. Customer and contractor both sign on the same device.">Sign in person</a>' : '') + '\
            ' + (contract.status === 'draft' && !lockedForEdits && showSigningActions ? '<button class="btn btn-success btn-compact" onclick="sendContractToCustomer(' + projectId + ')">Send to customer</button>' : '') + '\
            ' + contractMenu + '\
          </div>\
        </div>';
    }

    // Backfill the signed-quote PDF from the project page. Same hidden-
    // iframe autosave the /admin/quotes backfill button uses, but reachable
    // from the project (since the quote-promoted-to-project is where admin
    // actually looks for these). Reloads the page on success so the SSR
    // re-fetches quote_attachments and the new "Estimate — Signed" entry
    // surfaces with its green pill.
    function backfillSignedQuotePdfFromProject(quoteId, projectId, btnEl) {
      var btn = btnEl || null;
      if (btn) { btn.disabled = true; btn.textContent = 'Generating…'; }
      function onMsg(e) {
        var d = e.data;
        if (!d || typeof d !== 'object') return;
        if (d.quoteId !== Number(quoteId)) return;
        if (d.type === 'sl-pdf-saved') {
          window.removeEventListener('message', onMsg);
          showToast('Signed quote PDF generated', 'success');
          // Reload so the SSR re-fetches quote_attachments and the new
          // signed entry appears with its green Signed pill.
          setTimeout(function() { window.location.reload(); }, 800);
        } else if (d.type === 'sl-pdf-failed') {
          window.removeEventListener('message', onMsg);
          showToast('Failed to generate signed PDF: ' + (d.error || 'unknown'), 'error');
          if (btn) { btn.disabled = false; btn.textContent = 'Generate signed PDF'; }
        }
      }
      window.addEventListener('message', onMsg);

      var iframe = document.createElement('iframe');
      iframe.setAttribute('aria-hidden', 'true');
      iframe.style.cssText = 'position:fixed; left:-9999px; top:0; width:900px; height:1400px; border:0; opacity:0; pointer-events:none;';
      iframe.src = '/admin/quotes/' + quoteId + '/preview/?signed=1&autosave=1';
      document.body.appendChild(iframe);
      setTimeout(function() {
        if (iframe.parentNode) iframe.parentNode.removeChild(iframe);
        window.removeEventListener('message', onMsg);
        if (btn && btn.disabled) { btn.disabled = false; btn.textContent = 'Generate signed PDF'; }
      }, 90000);
    }
    window.backfillSignedQuotePdfFromProject = backfillSignedQuotePdfFromProject;

    // Silent, background version used on project-open self-heal. No page
    // reload — on success it just removes the warning box in place.
    function autoBackfillSignedQuotePdf(quoteId, projectId) {
      function onMsg(e) {
        var d = e.data;
        if (!d || typeof d !== 'object') return;
        if (d.quoteId !== Number(quoteId)) return;
        if (d.type === 'sl-pdf-saved') {
          window.removeEventListener('message', onMsg);
          var warn = document.getElementById('signedPdfWarn-' + projectId);
          if (warn && warn.parentNode) warn.parentNode.removeChild(warn);
          showToast('Signed quote PDF generated', 'success');
        } else if (d.type === 'sl-pdf-failed') {
          window.removeEventListener('message', onMsg);
          // Leave the warning in place so the manual button remains available.
          var warn2 = document.getElementById('signedPdfWarn-' + projectId);
          if (warn2) {
            var lead = warn2.querySelector('div');
            if (lead) lead.innerHTML = '<strong>Signed quote PDF missing.</strong> Auto-generate failed: use the button below.';
            var btn = warn2.querySelector('button');
            if (btn) btn.style.display = '';
          }
        }
      }
      window.addEventListener('message', onMsg);

      var iframe = document.createElement('iframe');
      iframe.setAttribute('aria-hidden', 'true');
      iframe.style.cssText = 'position:fixed; left:-9999px; top:0; width:900px; height:1400px; border:0; opacity:0; pointer-events:none;';
      iframe.src = '/admin/quotes/' + quoteId + '/preview/?signed=1&autosave=1';
      document.body.appendChild(iframe);
      setTimeout(function() {
        if (iframe.parentNode) iframe.parentNode.removeChild(iframe);
        window.removeEventListener('message', onMsg);
      }, 90000);
    }
    window.autoBackfillSignedQuotePdf = autoBackfillSignedQuotePdf;

    // Backfill the signed contract PDF for already-signed contracts that
    // don't have one on file (the auto-flow shipped after they signed).
    // Loads the contract preview in a hidden iframe with autosave=1; the
    // page's own SSR reads the signature from contract_signatures and
    // renders it, html2pdf snapshots + uploads, the message listener
    // refreshes this tab when done.
    async function backfillSignedContractPdf(projectId, btnEl) {
      var btn = btnEl || null;
      if (btn) { btn.disabled = true; btn.textContent = 'Generating…'; }
      function onMsg(e) {
        var d = e.data;
        if (!d || typeof d !== 'object') return;
        if (d.projectId !== Number(projectId)) return;
        if (d.type === 'sl-contract-signed-pdf-saved') {
          window.removeEventListener('message', onMsg);
          showToast('Signed contract PDF generated', 'success');
          loadContractTab(projectId);
          if (btn) { btn.disabled = false; btn.textContent = 'Regenerate signed PDF'; }
        } else if (d.type === 'sl-contract-signed-pdf-failed') {
          window.removeEventListener('message', onMsg);
          showToast('Failed to generate signed contract PDF: ' + (d.error || 'unknown'), 'error');
          if (btn) { btn.disabled = false; btn.textContent = 'Regenerate signed PDF'; }
        }
      }
      window.addEventListener('message', onMsg);

      var iframe = document.createElement('iframe');
      iframe.setAttribute('aria-hidden', 'true');
      iframe.style.cssText = 'position:fixed; left:-9999px; top:0; width:900px; height:1400px; border:0; opacity:0; pointer-events:none;';
      iframe.src = '/admin/projects/' + projectId + '/contract/preview/?autosave=1';
      document.body.appendChild(iframe);
      setTimeout(function() {
        if (iframe.parentNode) iframe.parentNode.removeChild(iframe);
        window.removeEventListener('message', onMsg);
        if (btn && btn.disabled) { btn.disabled = false; btn.textContent = 'Regenerate signed PDF'; }
      }, 90000);
    }
    window.backfillSignedContractPdf = backfillSignedContractPdf;

    async function applyContractTemplate(projectId) {
      const picker = document.getElementById('contractTplPicker-' + projectId);
      const btn = document.getElementById('contractApplyBtn-' + projectId);
      if (!picker || !picker.value) { showToast('Pick a template first', 'error'); return; }
      const templateId = Number(picker.value);
      if (btn) { btn.disabled = true; btn.textContent = 'Applying…'; }
      try {
        const res = await fetch('/api/projects/' + projectId + '/apply-contract-template/', {
          method: 'POST',
          credentials: 'include',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ template_id: templateId }),
        });
        const data = await res.json();
        if (!data.success) {
          showToast(data.error || 'Failed to apply template', 'error');
          if (btn) { btn.disabled = false; btn.textContent = '+ Apply template'; }
          return;
        }
        showToast('Contract created', 'success');
        loadContractTab(projectId);
      } catch {
        showToast('Failed to apply contract template', 'error');
        if (btn) { btn.disabled = false; btn.textContent = '+ Apply template'; }
      }
    }
    window.applyContractTemplate = applyContractTemplate;

    async function regenerateContractSchedule(projectId) {
      showConfirmModal(
        'Regenerate payment schedule?',
        'Recomputes the rows from the current total + start date + counts. Any rows already marked paid keep their state. Manual edits to individual rows will be overwritten.',
        'Regenerate',
        'warning',
        async () => {
          try {
            const res = await fetch('/api/projects/' + projectId + '/regenerate-payment-schedule/', {
              method: 'POST',
              credentials: 'include',
            });
            const data = await res.json();
            if (!data.success) { showToast(data.error || 'Failed to regenerate', 'error'); return; }
            showToast('Schedule regenerated', 'success');
            loadContractTab(projectId);
          } catch {
            showToast('Failed to regenerate schedule', 'error');
          }
        }
      );
    }
    window.regenerateContractSchedule = regenerateContractSchedule;

    // Wipe the contract entirely so admin can start fresh. Used when a
    // signed/voided contract needs to be replaced — the customer's
    // signature + audit trail are also dropped (cascade-delete on the
    // FK). After this, the empty state with the template picker shows.
    async function deleteContractAndStartOver(projectId) {
      showConfirmModal(
        'Delete contract & start over?',
        "This removes the contract, its signatures, and the customer's signing link. You'll be able to pick a fresh template afterwards. This can't be undone.",
        'Delete contract',
        'danger',
        async () => {
          try {
            const res = await fetch('/api/projects/' + projectId + '/contract/', {
              method: 'DELETE',
              credentials: 'include',
            });
            const data = await res.json();
            if (!data.success) { showToast(data.error || 'Failed to delete', 'error'); return; }
            showToast('Contract deleted: pick a new template to start over.', 'success');
            loadContractTab(projectId);
          } catch {
            showToast('Failed to delete contract', 'error');
          }
        }
      );
    }
    window.deleteContractAndStartOver = deleteContractAndStartOver;

    async function voidContract(projectId) {
      showConfirmModal(
        'Void this contract?',
        'Customer will no longer be able to sign at the existing link. You can apply a new template afterwards.',
        'Void contract',
        'danger',
        async () => {
          try {
            const res = await fetch('/api/projects/' + projectId + '/contract/', {
              method: 'PATCH',
              credentials: 'include',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ status: 'void' }),
            });
            const data = await res.json();
            if (!data.success) { showToast(data.error || 'Failed to void', 'error'); return; }
            showToast('Contract voided', 'success');
            loadContractTab(projectId);
          } catch {
            showToast('Failed to void contract', 'error');
          }
        }
      );
    }
    window.voidContract = voidContract;

    // Contract action ⋯ menu — open one at a time, close on outside click.
    function toggleContractMenu(evt, id) {
      evt.stopPropagation();
      var menu = document.getElementById(id);
      var wasOpen = menu && menu.classList.contains('open');
      document.querySelectorAll('.cmenu.open').forEach(function(m){ m.classList.remove('open'); });
      if (menu && !wasOpen) menu.classList.add('open');
    }
    window.toggleContractMenu = toggleContractMenu;
    document.addEventListener('click', function(){ document.querySelectorAll('.cmenu.open').forEach(function(m){ m.classList.remove('open'); }); });

    // sendContractToCustomer — flips status draft → sent and fires the
    // customer email with the signing link. Server-side, the PATCH endpoint
    // sends the email through Resend (contract-emails.sendContractToCustomer)
    // and reports back whether delivery succeeded.
    async function sendContractToCustomer(projectId) {
      // Pre-flight: read the customer email off the project card so we can
      // catch the most common cause of email failure ("no recipient") with
      // a clear message before the PATCH fires.
      const card = document.querySelector('.project-card[data-project-id="' + projectId + '"]');
      const cardEmail = card?.dataset?.customerEmail;
      if (card && cardEmail !== undefined && !cardEmail.trim()) {
        showToast(
          "This project has no customer email on file: set it on the Details tab before sending, otherwise the email can't be delivered.",
          'error'
        );
        return;
      }

      // Use the styled confirmation modal (same one as Delete/Promote etc.)
      // instead of the gray browser confirm(). showConfirmModal lives near
      // the top of this script block and renders #confirmModal.
      showConfirmModal(
        'Send contract to customer?',
        "They'll receive an email with a link to review and sign. You can re-send anytime from this tab.",
        'Send',
        'success',
        async () => {
          try {
            const res = await fetch('/api/projects/' + projectId + '/contract/', {
              method: 'PATCH',
              credentials: 'include',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ status: 'sent', send_email: true }),
            });
            const data = await res.json();
            if (!data.success) { showToast(data.error || 'Failed to send', 'error'); return; }
            // The DB flip can succeed while the Resend call fails (no email
            // on file, Resend rejection, etc.) — surface that separately so
            // admin knows to share the link manually.
            if (data.emailSent === false) {
              showToast('Contract marked Sent, but email failed: ' + (data.emailError || 'unknown') + '. Share the signing link manually.', 'error');
            } else {
              showToast('Contract sent: email is on its way to the customer.', 'success');
            }
            loadContractTab(projectId);
          } catch {
            showToast('Failed to update contract status', 'error');
          }
        }
      );
    }
    window.sendContractToCustomer = sendContractToCustomer;

    function escapeHtml(str) {
      return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    async function loadProjectMessages(projectId, quoteId, skipMarkRead) {
      var container = document.getElementById('projMessages-' + projectId);
      if (!container) return;

      try {
        var res = await fetch('/api/admin/messages/?quote_id=' + quoteId, { credentials: 'same-origin' });
        var data = await res.json();
        if (!data.success || !data.messages?.length) {
          container.innerHTML = '<div style="text-align: center; padding: 16px; color: rgba(255,255,255,0.35); font-size: 12px;">No messages yet</div>';
          // Update badge
          var badge = document.getElementById('msgTabBadge-' + projectId);
          if (badge) badge.style.display = 'none';
          return;
        }

        // Count unread customer replies
        var unreadCount = data.messages.filter(function(m) { return m.sender_type === 'customer' && !m.read_at; }).length;
        var badge = document.getElementById('msgTabBadge-' + projectId);
        if (badge) {
          if (unreadCount > 0) {
            badge.textContent = String(unreadCount);
            badge.style.display = '';
          } else {
            badge.style.display = 'none';
          }
        }

        // Newest first so the latest message sits next to the reply box.
        container.innerHTML = data.messages.slice().reverse().map(function(msg) {
          var isCustomer = msg.sender_type === 'customer';
          var dateObj = msg.created_at ? new Date(msg.created_at + 'Z') : null;
          var dateStr = dateObj ? dateObj.toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) : '';
          var timeStr = dateObj ? dateObj.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' }) : '';
          var senderBadge = isCustomer
            ? '<span class="msg-sender-badge customer">' + escapeHtml(msg.sender_name || 'Customer') + '</span>'
            : '<span class="msg-sender-badge admin">MannyKnows</span>';

          // Render attachments stored on the message
          var attsHtml = '';
          try {
            var atts = msg.attachments ? JSON.parse(msg.attachments) : [];
            if (Array.isArray(atts) && atts.length) {
              attsHtml = '<div style="margin-top:8px;display:flex;flex-wrap:wrap;gap:6px;">'
                + atts.filter(Boolean).map(function(a) {
                  var isImg = (a.type || '').startsWith('image/');
                  var isPdf = a.type === 'application/pdf';
                  var isVid = (a.type || '').startsWith('video/');
                  if (isImg) {
                    return '<a href="' + encodeURI(a.url) + '" target="_blank" rel="noopener" style="display:inline-block;">'
                      + '<img src="' + encodeURI(a.url) + '" alt="' + escapeHtml(a.name) + '" style="max-width:180px;max-height:120px;border-radius:6px;object-fit:cover;border:1px solid rgba(255,255,255,0.1);" /></a>';
                  }
                  var icon = isPdf
                    ? '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>'
                    : isVid
                    ? '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2"/></svg>'
                    : '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/></svg>';
                  return '<a href="' + encodeURI(a.url) + '" target="_blank" rel="noopener" style="display:inline-flex;align-items:center;gap:5px;padding:5px 10px;background:rgba(255,255,255,0.07);border:1px solid rgba(255,255,255,0.12);border-radius:6px;font-size:11px;color:var(--color-text);text-decoration:none;max-width:180px;overflow:hidden;">'
                    + icon + '<span style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">' + escapeHtml(a.name) + '</span></a>';
                }).join('')
                + '</div>';
            }
          } catch (_) {}

          return '<div class="message-item ' + (isCustomer ? 'customer-reply' : 'admin-msg') + '">' +
            senderBadge +
            '<div class="msg-header"><span class="msg-date">' + dateStr + ' · ' + timeStr + '</span></div>' +
            '<div class="msg-body">' + escapeHtml(msg.body || '') + '</div>' +
            attsHtml +
            '</div>';
        }).join('');

        // Mark customer replies as read when messages tab is active
        if (!skipMarkRead) {
          await fetch('/api/admin/unread-replies/', {
            method: 'POST',
            credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ quote_id: quoteId })
          });
          loadBellNotifications();
          // Clear badge after marking read
          if (badge) badge.style.display = 'none';
        }
      } catch (err) {
        console.error('Failed to load project messages:', err);
      }
    }

    // Per-project pending attachment state
    var _msgAttachments = {};

    function openMsgAttachPicker(projectId) {
      var inp = document.getElementById('projAttachInput-' + projectId);
      if (inp) inp.click();
    }

    async function handleMsgAttach(event, projectId) {
      var files = Array.from(event.target.files || []);
      if (!files.length) return;
      if (!_msgAttachments[projectId]) _msgAttachments[projectId] = [];
      var list = document.getElementById('projAttachList-' + projectId);

      for (var f of files) {
        var idx = _msgAttachments[projectId].length;
        var placeholder = document.createElement('div');
        placeholder.id = 'msgatt-' + projectId + '-' + idx;
        placeholder.style.cssText = 'display:inline-flex;align-items:center;gap:6px;padding:5px 10px;background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.12);border-radius:8px;font-size:12px;color:var(--color-text-secondary);';
        placeholder.innerHTML = '<span class="spinner-sm"></span> Uploading…';
        if (list) list.appendChild(placeholder);

        var form = new FormData();
        form.append('file', f);
        try {
          var res = await fetch('/api/admin/messages/upload', { method: 'POST', credentials: 'same-origin', body: form });
          var data = await res.json();
          if (!data.success) throw new Error(data.error || 'Upload failed');
          var att = { url: data.url, name: data.name, type: data.type, size: data.size };
          _msgAttachments[projectId].push(att);
          var isImg = (att.type || '').startsWith('image/');
          var iconSvg = (att.type === 'application/pdf')
            ? '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>'
            : (att.type || '').startsWith('video/')
            ? '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2"/></svg>'
            : '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>';
          var removeBtn = '<button type="button" style="background:none;border:none;cursor:pointer;color:var(--color-text-secondary);padding:0;line-height:1;margin-left:2px;" title="Remove" onclick="removeMsgAttach(' + projectId + ',' + (_msgAttachments[projectId].length-1) + ',this.parentNode)">'
            + '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></button>';
          placeholder.innerHTML = (isImg ? '<img src="' + att.url + '" style="width:32px;height:32px;border-radius:4px;object-fit:cover;" />' : iconSvg)
            + '<span style="max-width:120px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">' + escapeHtml(att.name) + '</span>'
            + removeBtn;
        } catch (e) {
          placeholder.innerHTML = '<span style="color:#f87171;">Failed: ' + escapeHtml(f.name) + '</span>'
            + '<button type="button" style="background:none;border:none;cursor:pointer;color:var(--color-text-secondary);padding:0;" onclick="this.parentNode.remove()"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></button>';
        }
      }
      event.target.value = '';
    }

    function removeMsgAttach(projectId, idx, el) {
      if (_msgAttachments[projectId]) _msgAttachments[projectId][idx] = null;
      if (el) el.remove();
    }

    async function sendProjectMessage(projectId, quoteId, email, name) {
      var subjectEl = document.getElementById('projMsgSubject-' + projectId);
      var bodyEl = document.getElementById('projMsgBody-' + projectId);
      var body = bodyEl ? bodyEl.value.trim() : '';
      if (!body) { showToast('Message body is required', 'error'); return; }

      var pendingAtts = (_msgAttachments[projectId] || []).filter(Boolean);

      try {
        var res = await fetch('/api/admin/messages/', {
          method: 'POST',
          credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            quote_id: quoteId,
            subject: subjectEl ? subjectEl.value.trim() : '',
            body: body,
            recipient_email: email,
            recipient_name: name,
            attachments: pendingAtts,
          })
        });
        var data = await res.json();
        if (data.success) {
          if (bodyEl) bodyEl.value = '';
          if (subjectEl) subjectEl.value = defaultMsgSubject(projectId);
          clearMsgDraft(projectId);
          _msgPrePolish[projectId] = null;
          var undoBtn0 = document.getElementById('projMsgUndo-' + projectId);
          if (undoBtn0) undoBtn0.style.display = 'none';
          _msgAttachments[projectId] = [];
          var list = document.getElementById('projAttachList-' + projectId);
          if (list) list.innerHTML = '';
          loadProjectMessages(projectId, quoteId);
        } else {
          showToast(data.error || 'Failed to send message', 'error');
        }
      } catch (err) {
        showToast('Error sending message', 'error');
      }
    }
    window.sendProjectMessage = sendProjectMessage;
    window.openMsgAttachPicker = openMsgAttachPicker;
    window.handleMsgAttach = handleMsgAttach;
    window.removeMsgAttach = removeMsgAttach;

    // ---- Message draft autosave + Polish undo ----
    var _msgPrePolish = {};
    function defaultMsgSubject(projectId) {
      var p = (projects || []).find(function (x) { return x.id === projectId; });
      return 'MannyKnows Project | #' + ((p && (p.project_number || p.id)) || projectId);
    }
    function msgDraftKey(projectId) { return 'projMsgDraft-' + projectId; }
    function saveMsgDraft(projectId) {
      try {
        var s = document.getElementById('projMsgSubject-' + projectId);
        var b = document.getElementById('projMsgBody-' + projectId);
        var body = b ? b.value : '';
        // Only persist while there's actual body content — keeps an empty
        // compose from suppressing the default subject on the next visit.
        if (body.trim()) localStorage.setItem(msgDraftKey(projectId), JSON.stringify({ subject: s ? s.value : '', body: body }));
        else localStorage.removeItem(msgDraftKey(projectId));
      } catch (e) {}
    }
    function restoreMsgDraft(projectId) {
      try {
        var raw = localStorage.getItem(msgDraftKey(projectId));
        if (!raw) return;
        var d = JSON.parse(raw);
        var s = document.getElementById('projMsgSubject-' + projectId);
        var b = document.getElementById('projMsgBody-' + projectId);
        if (b && d.body) b.value = d.body;
        if (s && d.subject) s.value = d.subject;
      } catch (e) {}
    }
    function clearMsgDraft(projectId) { try { localStorage.removeItem(msgDraftKey(projectId)); } catch (e) {} }
    function undoPolish(projectId) {
      var pre = _msgPrePolish[projectId];
      if (!pre) return;
      var b = document.getElementById('projMsgBody-' + projectId);
      var s = document.getElementById('projMsgSubject-' + projectId);
      if (b) b.value = pre.body;
      if (s && pre.subject != null) s.value = pre.subject;
      saveMsgDraft(projectId);
      var undoBtn = document.getElementById('projMsgUndo-' + projectId);
      if (undoBtn) undoBtn.style.display = 'none';
      showToast('Reverted to your original message', 'success');
    }
    window.saveMsgDraft = saveMsgDraft;
    window.restoreMsgDraft = restoreMsgDraft;
    window.undoPolish = undoPolish;

    async function polishProjectMessage(projectId, customerName) {
      var bodyEl = document.getElementById('projMsgBody-' + projectId);
      var subjEl = document.getElementById('projMsgSubject-' + projectId);
      var text = bodyEl ? bodyEl.value.trim() : '';
      if (!text) { showToast('Write a message first', 'error'); return; }

      async function polishText(t, type) {
        try {
          var res = await fetch('/api/admin/polish-message/', {
            method: 'POST', credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ message: t, customer_name: customerName, type: type || 'body' }),
          });
          var data = await res.json();
          return (data.success && data.polished) ? data.polished : null;
        } catch (e) { return null; }
      }

      // Keep the subject's "MK-… --" prefix; polish only the human part. The
      // standard "MannyKnows Project | #…" title is fixed — never polish it.
      var rawSubj = subjEl ? (subjEl.value || '') : '';
      var isStdTitle = /^MannyKnows Project \| #/i.test(rawSubj);
      var sm = rawSubj.match(/^(MK-[A-Z0-9-]+\s*--?\s*)([\s\S]*)$/i);
      var subjPrefix = sm ? sm[1] : '';
      var subjText = isStdTitle ? '' : (sm ? sm[2] : rawSubj).trim();
      // Snapshot pre-polish text so the admin can undo.
      _msgPrePolish[projectId] = { body: bodyEl ? bodyEl.value : '', subject: rawSubj };

      var btn = event.currentTarget;
      var btnText = btn.querySelector('.polish-text');
      var btnLoading = btn.querySelector('.polish-loading');
      btn.disabled = true;
      if (btnText) btnText.style.display = 'none';
      if (btnLoading) btnLoading.style.display = '';

      try {
        var results = await Promise.all([
          polishText(text, 'body'),
          subjText ? polishText(subjText, 'subject') : Promise.resolve(null),
        ]);
        var pBody = results[0], pSubj = results[1];
        if (pBody) bodyEl.value = pBody;
        if (pSubj && subjEl) subjEl.value = subjPrefix + pSubj;
        if (pBody || pSubj) {
          var undoBtn = document.getElementById('projMsgUndo-' + projectId);
          if (undoBtn) undoBtn.style.display = '';
          saveMsgDraft(projectId);
        }
        showToast((pBody || pSubj) ? 'Polished: use Undo polish to revert' : 'Failed to polish', (pBody || pSubj) ? 'success' : 'error');
      } catch (err) {
        showToast('Failed to polish message', 'error');
      } finally {
        btn.disabled = false;
        if (btnText) btnText.style.display = '';
        if (btnLoading) btnLoading.style.display = 'none';
      }
    }
    window.polishProjectMessage = polishProjectMessage;

    // Legacy contract-upload handlers (uploadProjectContract,
    // sendContractToCustomer, markContractSigned, removeProjectContract)
    // retired in Phase 6B. The new template-driven flow lives above in the
    // Contract-tab section.

    async function markAllRead() {
      try {
        await fetch('/api/admin/unread-replies/', {
          method: 'POST',
          credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ mark_all: true })
        });
        loadBellNotifications();
        closeBell();
      } catch (err) {
        console.error('Failed to mark all as read:', err);
      }
    }
    window.markAllRead = markAllRead;

    loadBellNotifications();
    setInterval(loadBellNotifications, 30000);
    document.addEventListener('visibilitychange', () => { if (!document.hidden) { bellErrorCount = 0; loadBellNotifications(); } });

    // ─── Collapsible list sidebar (desktop + tablet) ─────────────────────
    (function () {
      var toggle = document.getElementById('listToggleBtn');
      var main = document.querySelector('.admin-main');
      if (!toggle || !main) return;
      function setCollapsed(c) { main.classList.toggle('list-collapsed', c); toggle.textContent = c ? '›' : '‹'; }
      toggle.addEventListener('click', function () { setCollapsed(!main.classList.contains('list-collapsed')); });
      // Auto-collapse the list when a card is selected (any screen size), so the
      // detail panel gets full width. The toggle re-opens the list.
      document.addEventListener('click', function (e) {
        var card = e.target && e.target.closest ? e.target.closest('.project-card') : null;
        if (card) setCollapsed(true);
      });
    })();

    // Auto-open a specific project if ?open=PROJECT_ID is in the URL
    (function() {
      const openId = new URLSearchParams(window.location.search).get('open');
      if (openId) {
        window.history.replaceState({}, '', window.location.pathname);
        // Select the project, but DON'T scrollIntoView — on the tablet
        // height:auto layout that scrolls the whole page past the header and
        // pulls the footer up, shrinking the usable area after every save.
        setTimeout(() => { selectProject(parseInt(openId)); }, 100);
      }
    })();

    // Live-refresh each list card's status badge (Needs Crew / Ready / Awaiting
    // Signature / Contract Not Sent) so a contract sent/signed elsewhere shows
    // here without a full page reload.
    (function() {
      function cardBadgeHtml(p) {
        if (p.contract_status === 'sent') return '<span class="warning-badge" style="background: rgba(234,179,8,0.15); color: #eab308;">Awaiting Signature</span>';
        if (p.contract_status === 'draft') return '<span class="warning-badge" style="background: rgba(239,68,68,0.15); color: #ef4444;">Contract Not Sent</span>';
        if (!p.crew_lead_id) return '<span class="warning-badge">Needs Crew</span>';
        return '<span class="crew-badge">Ready</span>';
      }
      async function refreshCardStatuses() {
        try {
          const res = await fetch('/api/admin/projects-status/', { credentials: 'same-origin' });
          if (!res.ok) return;
          const data = await res.json();
          if (!data.success) return;
          for (const p of data.projects) {
            const card = document.querySelector('.project-card[data-id="' + p.id + '"]');
            if (!card) continue;
            const slot = card.querySelector('.card-status-slot');
            if (slot) slot.innerHTML = cardBadgeHtml(p);
            card.setAttribute('data-status', p.status);
          }
        } catch {}
      }
      setTimeout(refreshCardStatuses, 3000);
      setInterval(refreshCardStatuses, 20000);
    })();
  </script>

  <!-- MK Footer -->
  <footer class="admin-footer">
    by <a href="https://mannyknows.com" class="footer-link" target="_blank" rel="noopener">MK <span class="rocket-emoji">🚀</span></a>
  </footer>
</body>
