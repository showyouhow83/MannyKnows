    // Lazy-mount a single-frame poster <video> for each video tile in the
    // project Media grid. We seek to 0.5s via the #t fragment so browsers
    // paint that frame as the still poster — without this, all videos look
    // identical (just a play icon). Observer fires once per tile.
    // Re-callable: skips tiles already mounted via the data-poster-mounted flag.
    const _videoPosterObserver = ('IntersectionObserver' in window) ? new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (!entry.isIntersecting) return;
        const el = entry.target;
        if (el.dataset.posterMounted) return;
        el.dataset.posterMounted = '1';
        const src = el.dataset.videoSrc;
        if (!src) return;
        const video = document.createElement('video');
        video.src = src + (src.includes('#') ? '' : '#t=0.5');
        video.muted = true;
        video.playsInline = true;
        video.preload = 'metadata';
        video.setAttribute('disablepictureinpicture', '');
        video.style.cssText = 'position:absolute; inset:0; width:100%; height:100%; object-fit:cover; pointer-events:none; z-index:0;';
        const icon = el.querySelector('.video-fallback-icon');
        if (icon) {
          // Hide the placeholder icon once the video paints its first frame.
          video.addEventListener('loadeddata', () => { icon.style.opacity = '0'; }, { once: true });
        }
        el.insertBefore(video, el.firstChild);
        _videoPosterObserver.unobserve(el);
      });
    }, { rootMargin: '300px 0px' }) : null;

    function mountVideoPosters(rootEl) {
      if (!_videoPosterObserver) return;
      const targets = (rootEl || document).querySelectorAll('.image-thumb.is-video[data-video-src]:not([data-poster-mounted])');
      targets.forEach(el => _videoPosterObserver.observe(el));
    }
    window.mountVideoPosters = mountVideoPosters;

    function openLightbox(url, isVideo, streamUid) {
      var img = document.getElementById('lightboxImage');
      var box = document.getElementById('lightbox');
      if (!box) return;
      // Clean up any prior player
      var prior = box.querySelector('video, iframe.lightbox-stream');
      if (prior) prior.remove();
      if (streamUid && streamSub) {
        // Open the Stream player in a new tab — the /admin CSP blocks embedding
        // it in an iframe, so a top-level navigation is the reliable path.
        window.open('https://' + streamSub + '/' + streamUid + '/watch', '_blank', 'noopener');
        return;
      } else if (isVideo) {
        if (img) img.style.display = 'none';
        var video = document.createElement('video');
        video.src = url;
        video.controls = true;
        video.autoplay = true;
        video.style.maxWidth = '90vw';
        video.style.maxHeight = '85vh';
        video.style.borderRadius = '8px';
        video.onclick = function(e) { e.stopPropagation(); };
        box.appendChild(video);
      } else if (img) {
        img.style.display = '';
        img.src = getDisplayUrl(url);
      }
      box.classList.add('active');
    }

    function closeLightbox() {
      var box = document.getElementById('lightbox');
      if (!box) return;
      var player = box.querySelector('video, iframe.lightbox-stream');
      if (player) player.remove();
      box.classList.remove('active');
    }

