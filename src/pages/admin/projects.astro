---
// Admin Projects Page - 3-Column Layout with Full Quote Data
import { env as cfEnv } from 'cloudflare:workers';
import { AdminAuth } from '../../lib/adminAuth';
import AdminNav from '../../components/AdminNav.astro';
import AdminMobileDrawer from '../../components/AdminMobileDrawer.astro';
import AdminPresence from '../../components/AdminPresence.astro';
import { SERVICE_TYPES, SERVICE_LABELS } from '../../data/serviceTypes';
import { streamSubdomain } from '../../lib/stream';
import '../../styles/admin.css';

const env = cfEnv;
const sessionSecret = env?.SESSION_SECRET || env?.ADMIN_PASSWORD;
const session = await AdminAuth.validateSession(Astro.request, sessionSecret);

if (!session.isAuthenticated) {
  return Astro.redirect('/admin');
}
if (session.role === 'viewer') {
  return Astro.redirect('/admin/portfolios');
}

// Fetch data from D1
const db = env?.MK_APP_DB;
// Cloudflare Stream customer subdomain ('' when Stream isn't configured —
// client code then falls back to poster-less tiles / raw video URLs).
const streamSub = streamSubdomain(env);
let allProjects: any[] = [];
let partnersList: any[] = [];
let crewLeads: any[] = [];
let projectUpdates: Record<number, any[]> = {};
let error = '';

if (db) {
  try {
    // Fetch projects with full quote data, lead images, and crew lead info
    const projectsResult = await db.prepare(`
      SELECT
        p.*,
        cl.name as crew_lead_name,
        cl.email as crew_lead_email,
        cl.phone as crew_lead_phone,
        q.estimated_start as quote_estimated_start,
        q.estimated_end as quote_estimated_end,
        q.estimated_duration as quote_estimated_duration,
        q.materials as quote_materials,
        q.labor as quote_labor,
        q.materials_total,
        q.labor_total,
        q.subtotal,
        q.discount,
        q.notes as quote_notes,
        q.promoted_by,
        q.responded_at,
        q.project_images as quote_images,
        l.id as lead_id,
        l.project_images as lead_images,
        pc.status as contract_real_status,
        pc.id as contract_row_id,
        pc.total as contract_total,
        q.total as quote_total,
        pt.name as partner_name
      FROM projects p
      LEFT JOIN crew_leads cl ON p.crew_lead_id = cl.id
      LEFT JOIN quotes q ON p.quote_id = q.id
      LEFT JOIN leads l ON q.lead_id = l.id
      LEFT JOIN project_contracts pc ON pc.project_id = p.id
      LEFT JOIN partners pt ON p.partner_id = pt.id
      ORDER BY p.created_at DESC
    `).all();
    allProjects = projectsResult.results || [];
    // Effective price for list cards: the signed contract total wins, then the
    // quote total, then the legacy projects.total column. Some projects have a
    // priced contract but a 0 projects.total (never synced), which showed $0.
    for (const p of allProjects as any[]) {
      p.effective_total = (Number(p.contract_total) || 0) || (Number(p.quote_total) || 0) || (Number(p.total) || 0);
    }

    // Active partners for the "Representing" white-label dropdown.
    const partnersResult = await db.prepare(
      `SELECT id, name FROM partners WHERE archived = 0 ORDER BY name ASC`
    ).all();
    partnersList = partnersResult.results || [];

    // Fetch each project's OWN documents (project_documents) in one round
    // trip. These are the PDFs promoted from the originating quote plus any
    // the admin added directly — the project owns + manages them on its
    // Documents tab. (Legacy field name `quote_attachments` kept so the
    // Details "Documents" summary block reads the same property.)
    const projectIds = allProjects.map((p: any) => p.id).filter((id: any) => id != null);
    const docsByProject: Record<number, any[]> = {};
    if (projectIds.length > 0) {
      const placeholders = projectIds.map(() => '?').join(',');
      const docResult = await db.prepare(
        `SELECT id, project_id, label, file_url, file_name, file_size, source, uploaded_at
           FROM project_documents
          WHERE project_id IN (${placeholders})
          ORDER BY uploaded_at ASC, id ASC`
      ).bind(...projectIds).all();
      for (const row of (docResult.results || []) as any[]) {
        if (!docsByProject[row.project_id]) docsByProject[row.project_id] = [];
        docsByProject[row.project_id].push(row);
      }
    }
    // Attach to each project row so the SSR render can iterate them.
    for (const p of allProjects) {
      p.quote_attachments = docsByProject[p.id] || [];
    }

    // Quote-signature flag: 1 if the originating quote has a customer
    // signature on file, 0 otherwise. Drives the "Generate signed PDF"
    // backfill button in the Documents block — we only show it when
    // the customer has signed but the signed PDF wasn't auto-generated
    // (i.e. the quote was accepted before the auto-flow shipped).
    const quoteIds = [...new Set(allProjects.map((p: any) => p.quote_id).filter((id: any) => id != null))];
    if (quoteIds.length > 0) {
      const placeholders = quoteIds.map(() => '?').join(',');
      const sigResult = await db.prepare(
        `SELECT DISTINCT quote_id FROM quote_signatures WHERE quote_id IN (${placeholders})`
      ).bind(...quoteIds).all();
      const signedQuoteIds = new Set((sigResult.results || []).map((r: any) => r.quote_id));
      for (const p of allProjects) {
        p.quote_has_signature = p.quote_id && signedQuoteIds.has(p.quote_id);
      }
    } else {
      for (const p of allProjects) {
        p.quote_has_signature = false;
      }
    }

    // Fetch active crew leads for dropdown
    const crewResult = await db.prepare(
      'SELECT * FROM crew_leads WHERE active = 1 ORDER BY name ASC'
    ).all();
    crewLeads = crewResult.results || [];

    // Fetch project updates (crew notes and progress images)
    const updatesResult = await db.prepare(`
      SELECT * FROM project_updates ORDER BY created_at DESC
    `).all();
    const updates = updatesResult.results || [];

    // Group updates by project_id
    updates.forEach((update: any) => {
      if (!projectUpdates[update.project_id]) {
        projectUpdates[update.project_id] = [];
      }
      projectUpdates[update.project_id].push(update);
    });
  } catch (e) {
    error = 'Failed to load data';
    console.error('Projects fetch error:', e);
  }
} else {
  error = 'Database not configured';
}

// Split projects by status (exclude portfolio from main view)
const activeProjects = allProjects.filter(p => p.status !== 'portfolio');
const needsCrewProjects = allProjects.filter(p => p.status === 'needs_crew');
const inProgressProjects = allProjects.filter(p => p.status === 'in_progress');
const completedProjects = allProjects.filter(p => p.status === 'completed');
const portfolioProjects = allProjects.filter(p => p.status === 'portfolio');

// Service labels
const serviceLabels: Record<string, string> = SERVICE_LABELS;

// Format services
function formatServices(servicesJson: string | null): string {
  if (!servicesJson) return 'Home Services';
  try {
    const services = JSON.parse(servicesJson);
    return services.map((s: any) => {
      const key = typeof s === 'string' ? s : (s.type || s.service || s.name || 'service');
      return serviceLabels[key] || key.charAt(0).toUpperCase() + key.slice(1);
    }).join(', ');
  } catch {
    return servicesJson;
  }
}

// Format date
function formatDate(dateStr: string | null): string {
  if (!dateStr) return 'Not set';
  try {
    return new Date(dateStr).toLocaleDateString('en-US', {
      month: 'short',
      day: 'numeric'
    });
  } catch {
    return dateStr;
  }
}

// Format currency
function formatCurrency(amount: number | null): string {
  if (!amount) return '$0';
  return new Intl.NumberFormat('en-US', {
    style: 'currency',
    currency: 'USD',
    minimumFractionDigits: 0
  }).format(amount);
}
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Projects | MannyKnows Admin</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <meta name="robots" content="noindex, nofollow">
  <script>
    // Theme init - runs before CSS to prevent flash
    (function() {
      const theme = localStorage.getItem('admin-theme') || 'dark';
      document.documentElement.setAttribute('data-theme', theme);
    })();
  </script>
  <style is:global>
    /* JS-rendered detail styles (must be global) */
    .detail-row {
      display: flex;
      align-items: center;
      gap: 16px;
      margin-bottom: 10px;
    }

    .detail-row:last-child {
      margin-bottom: 0;
    }

    .detail-label {
      font-size: 13px;
      color: var(--color-text-secondary);
      min-width: 55px;
      flex-shrink: 0;
    }

    .detail-value {
      font-size: 14px;
      font-weight: 500;
      color: var(--color-text-primary);
    }

    .detail-value.scope {
      white-space: pre-wrap;
      line-height: 1.5;
    }

    /* Pricing input: match admin glassmorphic style */
    .pricing-input {
      padding: 8px 12px;
      background: rgba(255,255,255,0.05);
      border: 1px solid var(--glass-border);
      border-radius: var(--radius-md);
      color: var(--color-text-primary);
      font-size: 14px;
      outline: none;
      transition: border-color 0.2s;
    }

    .pricing-input:focus {
      border-color: var(--color-primary);
    }

    /* Pricing summary inline row */
    .pricing-summary-row {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
    }
    .pricing-summary-item {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      color: var(--color-text-secondary);
      font-size: 14px;
      white-space: nowrap;
    }
    .pricing-summary-item strong {
      color: var(--color-text);
      font-size: 15px;
    }
    .pricing-summary-sep {
      color: var(--color-text-secondary);
      font-size: 16px;
      opacity: 0.6;
    }
    .pricing-summary-total strong {
      font-size: 18px;
      color: var(--color-primary);
    }
    @media (max-width: 768px) {
      .pricing-summary-row {
        justify-content: center;
        text-align: center;
      }
    }

    /* Upload progress bar */
    .upload-progress-bar {
      margin: 12px 0;
      padding: 12px;
      background: rgba(0, 113, 227, 0.1);
      border: 1px solid rgba(0, 113, 227, 0.2);
      border-radius: 8px;
    }
    .upload-progress-text {
      font-size: 13px;
      font-weight: 600;
      color: var(--color-primary, #0071e3);
      margin-bottom: 8px;
    }
    .upload-progress-track {
      height: 6px;
      background: rgba(0, 113, 227, 0.15);
      border-radius: 3px;
      overflow: hidden;
    }
    .upload-progress-fill {
      height: 100%;
      background: linear-gradient(90deg, #2563eb, #d946ef);
      border-radius: 3px;
      transition: width 0.3s ease;
      width: 0%;
    }

    /* Page-specific styles - extends admin.css */

    /* Main content - 3-column layout with rounded cards */
    .admin-main {
      display: flex;
      align-items: flex-start;
      min-height: calc(100vh - 65px - 60px);
      padding: 16px;
      gap: 16px;
    }

    /* List collapse toggle: available on desktop + tablet. Selecting a card
       auto-collapses the list so the detail panel gets full width; the toggle
       brings the list back. */
    .list-toggle-btn {
      display: inline-flex; align-items: center; justify-content: center;
      position: fixed; left: 8px; top: 50%; transform: translateY(-50%); z-index: 60;
      width: 34px; height: 34px; border-radius: 8px; font-size: 18px; line-height: 1;
      border: 1px solid var(--glass-border); background: var(--glass-bg);
      color: var(--color-text-primary); cursor: pointer;
      box-shadow: 0 4px 14px rgba(0,0,0,0.3);
    }
    .admin-main.list-collapsed > .projects-list { display: none; }

    /* Left column - Projects list. Sticky sidebar so it stays in view while the
       page (and the detail card) scroll as one, no second scrollbar on the
       detail. The list only scrolls within itself when it's taller than the
       viewport. */
    .projects-list {
      width: 300px;
      min-width: 280px;
      max-width: 320px;
      position: sticky;
      top: 16px;
      align-self: flex-start;
      max-height: calc(100vh - 65px - 60px - 16px);
      overflow-y: auto;
      padding: 16px;
      background: var(--glass-bg);
      border: 1px solid var(--glass-border);
      border-radius: var(--radius-xl);
      backdrop-filter: blur(10px);
    }

    /* Middle column - Project content. Grows to its natural height; the PAGE
       scrolls (single scrollbar) instead of an inner scroll region. */
    .project-content {
      flex: 1;
      min-width: 0;
      padding: 24px;
      background: var(--glass-bg);
      border: 1px solid var(--glass-border);
      border-radius: var(--radius-xl);
      backdrop-filter: blur(10px);
      /* Anchor for the floating .detail-close-float close button */
      position: relative;
    }

    /* Project sections (collapsible on mobile) */
    .project-section {
      margin-bottom: 16px;
    }

    .project-section:last-child {
      margin-bottom: 0;
    }

    .section-chevron {
      display: none;
    }

    /* Section header */
    .section-header {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 12px;
      padding-bottom: 12px;
      border-bottom: 1px solid var(--glass-border);
    }

    .section-title {
      font-size: 13px;
      font-weight: 600;
      color: var(--color-text-secondary);
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .section-count {
      padding: 2px 8px;
      border-radius: 12px;
      font-size: 11px;
      font-weight: 600;
    }

    .section-count.needs-crew {
      background: rgba(245, 158, 11, 0.2);
      color: #fbbf24;
    }

    .section-count.in-progress {
      background: rgba(0, 113, 227, 0.2);
      color: #60a5fa;
    }

    .section-count.completed {
      background: rgba(34, 197, 94, 0.2);
      color: #4ade80;
    }

    /* Project card */
    .project-card {
      background: var(--glass-bg);
      border: 1px solid var(--glass-border);
      border-radius: var(--radius-md);
      padding: 12px;
      margin-bottom: 8px;
      cursor: pointer;
      transition: all 0.2s;
      backdrop-filter: blur(10px);
    }

    .project-card:hover {
      border-color: var(--color-primary);
      background: rgba(255, 255, 255, 0.08);
    }

    .project-card.selected {
      border-color: var(--color-primary);
      background: rgba(0, 113, 227, 0.15);
      box-shadow: 0 0 0 2px rgba(0, 113, 227, 0.3);
    }

    .project-number {
      font-family: 'SF Mono', Monaco, monospace;
      margin-bottom: 4px;
    }
    .proj-shortcode {
      font-size: 14px;
      font-weight: 800;
      color: var(--color-primary);
      letter-spacing: 0.3px;
    }

    .project-name {
      font-weight: 600;
      font-size: 14px;
      margin-bottom: 4px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      color: var(--color-text-primary);
    }

    .project-meta {
      font-size: 11px;
      color: var(--color-text-secondary);
    }

    .warning-badge {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      background: rgba(245, 158, 11, 0.2);
      color: #fbbf24;
      padding: 2px 6px;
      border-radius: 4px;
      font-size: 10px;
      font-weight: 500;
    }

    .crew-badge {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      background: rgba(34, 197, 94, 0.2);
      color: #4ade80;
      padding: 2px 6px;
      border-radius: 4px;
      font-size: 10px;
      font-weight: 500;
    }

    .customer-badge {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      background: rgba(34, 197, 94, 0.2);
      color: #4ade80;
      padding: 2px 6px;
      border-radius: 4px;
      font-size: 10px;
      font-weight: 500;
    }

    .project-admin-badge {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      background: rgba(99, 102, 241, 0.2);
      color: #818cf8;
      padding: 2px 6px;
      border-radius: 4px;
      font-size: 10px;
      font-weight: 500;
    }

    /* Status section */
    .status-section {
      margin-bottom: 24px;
    }

    .status-card {
      background: var(--glass-bg);
      border: 1px solid var(--glass-border);
      border-radius: var(--radius-md);
      padding: 10px 12px;
      margin-bottom: 6px;
      cursor: pointer;
      transition: all 0.2s;
      backdrop-filter: blur(10px);
    }

    .status-card:hover {
      border-color: var(--color-primary);
      background: rgba(255, 255, 255, 0.08);
    }

    .status-card.selected {
      border-color: var(--color-primary);
      background: rgba(0, 113, 227, 0.15);
    }

    .status-card-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 4px;
    }

    .status-card-number {
      font-family: 'SF Mono', Monaco, monospace;
      font-size: 10px;
      color: var(--color-primary);
      font-weight: 600;
    }

    .status-card-date {
      font-size: 10px;
      color: var(--color-text-secondary);
    }

    .status-card-name {
      font-size: 13px;
      font-weight: 500;
      margin-bottom: 4px;
      color: var(--color-text-primary);
    }

    .status-card-crew {
      font-size: 11px;
      color: #4ade80;
    }

    /* Content placeholder */
    .content-placeholder {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      height: 100%;
      color: var(--color-text-secondary);
    }

    .placeholder-icon {
      font-size: 48px;
      margin-bottom: 16px;
      opacity: 0.3;
    }

    /* Project detail */
    .project-detail {
    }

    .detail-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 24px;
      flex-wrap: wrap;
      gap: 16px;
    }

    .detail-header-title-group {
      flex: 1;
    }

    .detail-title {
      display: inline-block;
      background: linear-gradient(135deg, #2563eb 0%, #d946ef 100%);
      color: white;
      padding: 6px 14px;
      border-radius: 20px;
      font-size: 12px;
      font-weight: 600;
      margin-bottom: 8px;
      font-family: 'SF Mono', Monaco, monospace;
    }

    .detail-customer-name {
      font-size: 24px;
      font-weight: 700;
      margin: 0;
      color: var(--color-text-primary);
    }

    .detail-badges {
      display: flex;
      gap: 8px;
      align-items: center;
    }

    .status-badge {
      display: inline-flex;
      align-items: center;
      padding: 8px 16px;
      border-radius: 8px;
      font-size: 13px;
      font-weight: 600;
      border: 1px solid;
    }

    .status-badge.needs-crew {
      background: rgba(245, 158, 11, 0.15);
      color: #f59e0b;
      border-color: rgba(245, 158, 11, 0.3);
    }

    .status-badge.awaiting-sign {
      background: rgba(234, 179, 8, 0.15);
      color: #eab308;
      border-color: rgba(234, 179, 8, 0.35);
    }

    .status-badge.contract-unsent {
      background: rgba(239, 68, 68, 0.13);
      color: #ef4444;
      border-color: rgba(239, 68, 68, 0.3);
    }

    .status-badge.in-progress {
      background: rgba(0, 113, 227, 0.15);
      color: #0071e3;
      border-color: rgba(0, 113, 227, 0.3);
    }

    .status-badge.completed {
      background: rgba(34, 197, 94, 0.15);
      color: #22c55e;
      border-color: rgba(34, 197, 94, 0.3);
    }

    .approval-badge {
      padding: 4px 10px;
      border-radius: 20px;
      font-size: 11px;
      font-weight: 600;
    }

    .approval-badge.customer {
      background: rgba(34, 197, 94, 0.2);
      color: #4ade80;
    }

    .approval-badge.admin {
      background: rgba(99, 102, 241, 0.2);
      color: #818cf8;
    }

    .detail-section {
      background: var(--glass-bg);
      border: 1px solid var(--glass-border);
      border-radius: var(--radius-lg);
      padding: 20px;
      margin-bottom: 16px;
      backdrop-filter: blur(10px);
    }

    /* Customer & Project merged card: 3-column grid on wide screens so
       contact / scope / schedule sit side-by-side. Stacks on narrower
       widths so phones get the natural top-to-bottom reading order. */
    .cust-proj-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 18px;
    }
    .cust-proj-col {
      min-width: 0;
    }
    .cust-proj-col + .cust-proj-col {
      padding-top: 16px;
      border-top: 1px solid var(--glass-border);
    }
    @media (min-width: 1024px) {
      .cust-proj-grid {
        grid-template-columns: 1fr 1fr 1fr;
        gap: 24px;
      }
      .cust-proj-col + .cust-proj-col {
        padding-top: 0;
        padding-left: 24px;
        border-top: 0;
        border-left: 1px solid var(--glass-border);
      }
    }

    .detail-section-title {
      font-size: 12px;
      font-weight: 600;
      color: var(--color-text-secondary);
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin-bottom: 12px;
    }

    /* Pricing table */
    .pricing-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 13px;
      margin-top: 8px;
    }

    .pricing-table th {
      text-align: left;
      padding: 8px;
      background: rgba(0, 0, 0, 0.2);
      font-weight: 600;
      color: var(--color-text-secondary);
      font-size: 11px;
      text-transform: uppercase;
    }

    .pricing-table td {
      padding: 8px;
      border-top: 1px solid var(--glass-border);
      color: var(--color-text-primary);
    }

    .pricing-table .total-row td {
      font-weight: 600;
      border-top: 2px solid var(--glass-border);
    }

    .pricing-table input,
    .pricing-table select,
    .pricing-table textarea {
      width: 100%;
      padding: 10px 12px;
      border: 1px solid var(--glass-border);
      border-radius: var(--radius-md);
      font-size: 14px;
      font-family: inherit;
      background: rgba(0, 0, 0, 0.2);
      color: var(--color-text-primary);
      box-sizing: border-box;
      transition: border-color 0.15s, background 0.15s;
    }

    .pricing-table input:focus,
    .pricing-table select:focus,
    .pricing-table textarea:focus {
      border-color: var(--color-primary);
      background: rgba(0, 0, 0, 0.3);
      outline: none;
    }

    .pricing-table textarea {
      overflow: hidden;
      resize: none;
      min-height: 42px;
    }

    .btn-add-row {
      background: none;
      border: 1px dashed var(--glass-border);
      color: var(--color-primary);
      padding: 6px 12px;
      border-radius: 4px;
      font-size: 12px;
      cursor: pointer;
      margin-top: 8px;
      width: 100%;
    }

    .btn-add-row:hover {
      background: rgba(0, 113, 227, 0.1);
      border-color: var(--color-primary);
    }

    .btn-remove-row {
      background: none;
      border: none;
      color: #ef4444;
      font-size: 16px;
      cursor: pointer;
      padding: 2px 6px;
      border-radius: 4px;
    }

    .btn-remove-row:hover {
      background: rgba(239, 68, 68, 0.1);
    }

    /* Section-level Edit/Done toggle for project detail. Sections stay
       read-only by default; clicking the small Edit button unlocks. */
    .section-edit-btn {
      font-size: 12px;
      padding: 4px 10px;
      border-radius: var(--radius-sm);
      border: 1px solid var(--color-border);
      background: transparent;
      color: var(--color-text-secondary);
      cursor: pointer;
      font-family: inherit;
    }
    .section-edit-btn:hover {
      background: rgba(255, 255, 255, 0.04);
    }

    /* Hide row Add/Remove affordances while a section is locked. */
    .editable-section[data-locked="1"] .btn-add-row,
    .editable-section[data-locked="1"] .btn-remove-row {
      display: none;
    }

    /* Images grid */
    .images-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));
      gap: 8px;
      margin-top: 12px;
    }

    /* Chunked reference media: tiles past the first batch until "Load more" */
    .image-thumb.ref-hidden { display: none !important; }

    /* Contract action buttons: clean flex row on desktop; uniform 2-col grid
       on mobile (was a messy flex-wrap + spacer producing uneven widths). */
    .contract-actions { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; margin-top: 16px; }
    .contract-actions-spacer { flex: 1 1 auto; }
    @media (max-width: 600px) {
      .contract-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
      .contract-actions-spacer { display: none; }
      .contract-actions > .btn { width: 100%; margin: 0; justify-content: center; text-align: center; }
      .contract-actions > .cmenu-wrap { grid-column: 1 / -1; }
      .contract-actions > .cmenu-wrap .cmenu-kebab { width: 100%; }
    }

    /* Payment schedule: stack into labeled rows on mobile (was a cramped
       4-column table). !important overrides the inline cell styles. */
    @media (max-width: 600px) {
      .pay-table thead { display: none; }
      .pay-table, .pay-table tbody, .pay-table tr { display: block; width: 100%; }
      .pay-table tr { border-bottom: 1px solid var(--glass-border); padding: 6px 0; }
      .pay-table td { display: flex !important; justify-content: space-between; align-items: center; gap: 12px; text-align: right !important; padding: 4px 8px !important; }
      .pay-table td::before { content: attr(data-label); font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: var(--color-text-secondary); }
      .pay-table td[colspan]::before { content: none; }
      .pay-table td[colspan] { justify-content: flex-start; text-align: left !important; }
    }

    /* Mark-signed-offline modal fields: explicit dark styling so values are
       readable (the generic --color-surface/--color-text resolved white-on-white). */
    .so-form { display: flex; flex-direction: column; gap: 12px; text-align: left; }
    .so-label { font-size: 11px; font-weight: 600; color: var(--color-text-secondary); text-transform: uppercase; letter-spacing: .5px; display: block; margin-bottom: 4px; }
    .so-field {
      width: 100%; box-sizing: border-box; padding: 9px 11px; border-radius: 8px;
      border: 1px solid rgba(255,255,255,0.15); background: rgba(255,255,255,0.06);
      color: #e5e7eb; font-size: 13px;
    }
    .so-field::placeholder { color: #a1a1aa; }
    .so-field:focus { outline: none; border-color: #0071e3; }
    .so-file { padding: 8px; color: #cbd5e1; }
    .so-file::file-selector-button,
    .so-file::-webkit-file-upload-button {
      background: rgba(99,102,241,0.2); color: #c7d2fe; border: 1px solid rgba(99,102,241,0.45);
      border-radius: 6px; padding: 6px 12px; font-size: 12px; font-weight: 600; cursor: pointer; margin-right: 10px;
    }

    .image-thumb {
      aspect-ratio: 1;
      border-radius: var(--radius-md);
      overflow: hidden;
      background: var(--color-background);
      border: 1px solid var(--color-border);
    }

    .image-thumb img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      cursor: pointer;
      transition: transform 0.2s;
    }

    /* Form elements */
    .form-row {
      display: flex;
      gap: 16px;
      margin-bottom: 16px;
    }

    .form-group {
      flex: 1;
    }

    .form-group label {
      display: block;
      font-size: 13px;
      font-weight: 500;
      margin-bottom: 6px;
      color: var(--color-text-secondary);
    }

    .form-group select,
    .form-group input,
    .form-group textarea {
      width: 100%;
      padding: 10px 12px;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      font-size: 14px;
      font-family: inherit;
    }

    .form-group select:focus,
    .form-group input:focus,
    .form-group textarea:focus {
      outline: none;
      border-color: var(--color-primary);
      box-shadow: 0 0 0 3px rgba(0, 113, 227, 0.1);
    }

    /* Buttons */
    .btn-row {
      display: flex;
      gap: 12px;
      margin-top: 20px;
    }

    .btn {
      padding: 8px 14px;
      border-radius: var(--radius-md);
      font-size: 13px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s;
      border: none;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }

    .btn-primary {
      background: linear-gradient(135deg, #2563eb 0%, #d946ef 100%);
      color: white;
    }

    .btn-primary:hover {
      opacity: 0.9;
    }

    .btn-success {
      background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%);
      color: white;
    }

    .btn-success:hover {
      opacity: 0.9;
    }

    .btn-secondary {
      background: var(--glass-bg, rgba(255,255,255,0.05));
      border: 1px solid var(--glass-border, rgba(255,255,255,0.1));
      color: var(--color-text-secondary);
    }

    .btn-secondary:hover {
      background: rgba(255, 255, 255, 0.1);
      color: var(--color-text-primary);
    }

    .btn-danger {
      background: rgba(239, 68, 68, 0.2);
      color: #f87171;
      border: 1px solid rgba(239, 68, 68, 0.3);
    }

    .btn-danger:hover {
      background: rgba(239, 68, 68, 0.3);
    }

    .btn-promote {
      background: linear-gradient(135deg, #8b5cf6 0%, #6366f1 100%);
      color: white;
    }

    .btn-promote:hover {
      opacity: 0.9;
    }

    /* Bottom action bar (Save, Start, etc.) */
    .form-action-bar {
      display: flex;
      justify-content: center;
      gap: 12px;
      padding-top: 24px;
      margin-top: 24px;
      border-top: 1px solid var(--glass-border, rgba(255,255,255,0.1));
      flex-wrap: wrap;
    }

    /* Management tab content */
    .management-section {
      background: var(--glass-bg, rgba(255,255,255,0.05));
      border: 1px solid var(--glass-border, rgba(255,255,255,0.1));
      border-radius: var(--radius-lg, 12px);
      padding: 24px;
      margin-bottom: 16px;
    }
    .management-section:last-child { margin-bottom: 0; }

    .management-title {
      font-size: 15px;
      font-weight: 600;
      color: var(--color-text-primary);
      margin: 0 0 6px 0;
    }

    .management-desc {
      font-size: 13px;
      color: var(--color-text-secondary);
      margin: 0 0 20px 0;
    }

    .management-actions {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
    }

    /* Empty state */
    .empty-state {
      text-align: center;
      padding: 24px 16px;
      color: var(--color-text-secondary);
      font-size: 13px;
    }

    /* Client / crew token link container: uses the same translucent
       glass surface as form fields so it sits flush with surrounding cards
       in both light and dark themes. */
    .client-link {
      display: flex;
      align-items: center;
      gap: 8px;
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid var(--glass-border);
      padding: 8px 12px;
      border-radius: var(--radius-md);
    }
    [data-theme="light"] .client-link {
      background: rgba(255, 255, 255, 0.7);
    }

    .client-link a {
      font-family: 'SF Mono', Monaco, monospace;
      font-size: 12px;
      color: var(--color-primary);
      text-decoration: none;
    }

    .client-link a:hover {
      text-decoration: underline;
    }

    .btn-copy {
      padding: 4px 8px;
      background: var(--color-primary);
      color: white;
      border: none;
      border-radius: 4px;
      font-size: 11px;
      cursor: pointer;
    }

    /* Search bar */
    .new-project-btn {
      display: flex; align-items: center; justify-content: center; gap: 7px;
      width: 100%; margin-bottom: 12px; padding: 11px 14px;
      border: none; border-radius: var(--radius-lg); cursor: pointer;
      font-size: 14px; font-weight: 700; color: #fff;
      background: linear-gradient(135deg, #2563eb 0%, #d946ef 100%);
      box-shadow: 0 2px 8px rgba(0, 113, 227,0.25);
    }
    .new-project-btn:hover { transform: none; box-shadow: 0 4px 14px rgba(0, 113, 227,0.35); }
    /* New Project modal form: matched to the New Lead modal styling. */
    /* `.modal-content.np-modal` (not just `.np-modal`) so this beats the later
       `.modal-content { max-width: 420px }` rule that was forcing it narrow. */
    .modal-content.np-modal { text-align: left; max-width: 700px; width: calc(100vw - 32px); max-height: 90vh; overflow-y: auto; background: linear-gradient(135deg, rgba(21, 22, 25, 0.98), rgba(10, 11, 13, 0.99)); box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5); }
    .np-modal-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 6px; }
    .np-modal-close { background: none; border: none; color: var(--color-text-secondary); cursor: pointer; padding: 8px; border-radius: 8px; display: inline-flex; line-height: 0; transition: all 0.2s; }
    .np-modal-close:hover { background: rgba(255,255,255,0.1); color: var(--color-text-primary); }
    .np-field { margin-bottom: 16px; display: flex; flex-direction: column; }
    .np-field label { display: block; font-size: 13px; font-weight: 500; color: var(--color-text-secondary); margin-bottom: 6px; text-align: left; }
    .np-field label .required, .np-field .required { color: #ef4444; }
    .np-field .form-input, .np-field .form-select, .np-field .form-textarea {
      width: 100%; box-sizing: border-box;
      padding: 10px 14px;
      background: var(--glass-bg);
      border: 1px solid var(--glass-border);
      border-radius: 8px;
      font-size: 14px;
      color: var(--color-text-primary);
      transition: all 0.2s;
    }
    .np-field .form-input:focus, .np-field .form-select:focus, .np-field .form-textarea:focus {
      outline: none; border-color: var(--color-primary); box-shadow: 0 0 0 3px rgba(0, 113, 227, 0.1);
    }
    .np-row { display: flex; gap: 16px; }
    .np-row .np-field { flex: 1; }
    .np-status { font-size: 13px; margin: 6px 0 2px; min-height: 16px; }
    .np-status.ok { color: #4ade80; font-weight: 600; }
    .np-status.err { color: #f87171; font-weight: 600; }

    .search-bar {
      background: var(--glass-bg);
      border: 1px solid var(--glass-border);
      border-radius: var(--radius-lg);
      padding: 10px 14px;
      margin-bottom: 16px;
      display: flex;
      gap: 10px;
      align-items: center;
      backdrop-filter: blur(10px);
    }

    .search-bar svg {
      color: var(--color-text-secondary);
      flex-shrink: 0;
    }

    .search-input {
      flex: 1;
      border: none;
      font-size: 14px;
      outline: none;
      background: transparent;
      color: var(--color-text-primary);
    }

    .search-input::placeholder {
      color: var(--color-text-secondary);
    }

    /* Timeline section */
    .timeline-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 12px;
    }

    .timeline-dates {
      font-size: 12px;
      color: var(--color-text-secondary);
    }

    .no-images {
      text-align: center;
      padding: 20px;
      color: var(--color-text-secondary);
      font-size: 13px;
      background: var(--color-background);
      border-radius: var(--radius-md);
    }

    /* Toast Notifications */
    .toast {
      position: fixed;
      bottom: 24px;
      left: 50%;
      transform: translateX(-50%) translateY(100px);
      background: #12121f;
      color: white;
      padding: 14px 24px;
      border-radius: 10px;
      display: flex;
      align-items: center;
      gap: 12px;
      font-size: 14px;
      font-weight: 500;
      box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2);
      opacity: 0;
      transition: all 0.3s ease;
      z-index: 10001;
    }

    .toast.visible {
      transform: translateX(-50%) translateY(0);
      opacity: 1;
    }

    .toast.success { background: #166534; }
    .toast.error { background: #dc2626; }
    .toast.info { background: #1e40af; }

    /* Modal (override admin.css .modal styles) */
    .modal {
      display: none;
      position: fixed;
      inset: 0;
      z-index: 10000;
      align-items: center;
      justify-content: center;
      /* Reset admin.css .modal overrides */
      max-width: none;
      width: auto;
      background: transparent;
      border: none;
      border-radius: 0;
      max-height: none;
      overflow: visible;
      animation: none;
    }

    .modal.active {
      display: flex;
    }

    .modal-backdrop {
      position: absolute;
      inset: 0;
      background: rgba(0, 0, 0, 0.5);
      backdrop-filter: blur(4px);
    }

    .modal-content {
      position: relative;
      background: var(--color-background-light, #12121f);
      border: 1px solid var(--glass-border);
      border-radius: 16px;
      padding: 32px;
      max-width: 420px;
      width: 90%;
      text-align: center;
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
    }

    .modal-icon {
      width: 64px;
      height: 64px;
      margin: 0 auto 16px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .modal-icon.danger {
      background: rgba(239, 68, 68, 0.15);
      color: #f87171;
    }

    .modal-icon.warning {
      background: rgba(245, 158, 11, 0.15);
      color: #fbbf24;
    }

    .modal-icon.info {
      background: rgba(37, 99, 235, 0.15);
      color: #60a5fa;
    }

    .modal-icon.success {
      background: rgba(34, 197, 94, 0.15);
      color: #4ade80;
    }

    .modal-icon.primary {
      background: rgba(37, 99, 235, 0.15);
      color: #60a5fa;
    }

    .modal-title {
      font-size: 20px;
      font-weight: 600;
      margin: 0 0 8px;
      color: var(--color-text-primary);
    }

    .modal-text {
      font-size: 14px;
      color: var(--color-text-secondary);
      margin: 0 0 24px;
      line-height: 1.5;
    }

    .modal-actions {
      display: flex;
      gap: 12px;
    }

    .modal-actions .btn {
      flex: 1;
      padding: 12px 20px;
    }

    .modal .btn-cancel {
      background: var(--color-background);
      border: 1px solid var(--color-border);
      color: var(--color-text-secondary);
    }

    .modal .btn-confirm {
      background: linear-gradient(135deg, #2563eb 0%, #d946ef 100%);
      color: white;
    }

    .modal .btn-confirm.danger {
      background: linear-gradient(135deg, #dc2626 0%, #b91c1c 100%);
    }

    .modal .btn-confirm.warning {
      background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
    }

    .modal .btn-confirm.success {
      background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%);
    }

    .modal .btn:disabled {
      opacity: 0.65;
      cursor: wait;
      pointer-events: none;
    }

    /* Crew Updates Section */
    .crew-updates-section {
      background: var(--glass-bg);
      border: 1px solid var(--color-accent-purple, rgba(124, 58, 237, 0.3));
    }

    .crew-updates-section .detail-section-title {
      color: var(--color-primary);
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .crew-update-item {
      background: var(--glass-bg);
      border: 1px solid var(--glass-border);
      border-radius: var(--radius-md);
      padding: 12px;
      margin-bottom: 12px;
    }

    .crew-update-item:last-child {
      margin-bottom: 0;
    }

    .crew-update-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 8px;
    }

    .crew-update-author {
      font-weight: 600;
      color: var(--color-primary);
      font-size: 13px;
    }

    .crew-update-time {
      font-size: 11px;
      color: var(--color-text-secondary);
    }

    .crew-update-note {
      font-size: 14px;
      line-height: 1.5;
      color: var(--color-text-primary);
      background: var(--glass-bg);
      padding: 10px 12px;
      border-radius: 6px;
      border-left: 3px solid var(--color-primary);
    }

    .crew-update-image {
      margin-top: 8px;
    }

    .crew-update-image img {
      max-width: 200px;
      border-radius: var(--radius-md);
      cursor: pointer;
      transition: transform 0.2s;
    }

    /* Delete buttons for images */
    .image-thumb {
      position: relative;
    }

    /* Video tiles in the Reference Media grid */
    .image-thumb.is-video {
      cursor: pointer;
      overflow: hidden;
    }

    .image-video-badge {
      position: absolute;
      bottom: 4px;
      left: 4px;
      background: rgba(0, 0, 0, 0.7);
      color: white;
      padding: 2px 6px;
      border-radius: 4px;
      font-size: 10px;
      font-weight: 600;
      letter-spacing: 0.3px;
      text-transform: uppercase;
      pointer-events: none;
    }

    .image-delete-btn {
      position: absolute;
      top: 4px;
      right: 4px;
      width: 24px;
      height: 24px;
      background: rgba(220, 38, 38, 0.9);
      border: none;
      border-radius: 4px;
      color: white;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      opacity: 1;
    }

    .image-anno-btn {
      position: absolute;
      top: 4px;
      left: 4px;
      width: 24px;
      height: 24px;
      background: rgba(37, 99, 235, 0.92);
      border: none;
      border-radius: 4px;
      color: white;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      text-decoration: none;
      font-size: 14px;
      line-height: 1;
      opacity: 1;
    }

    /* Crew-only star toggle (top-left, right of annotate). Star = crew-only. */
    .image-star-btn {
      position: absolute;
      top: 4px;
      left: 32px;
      width: 24px;
      height: 24px;
      background: rgba(10, 11, 13, 0.78);
      border: none;
      border-radius: 4px;
      color: #fbbf24;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 14px;
      line-height: 1;
      opacity: 1;
      z-index: 2;
      -webkit-tap-highlight-color: transparent;
    }
    .image-star-btn.active { opacity: 1; background: rgba(202, 138, 4, 0.95); color: #fff; }
    .image-thumb.is-starred { outline: 2px solid #facc15; outline-offset: -2px; }

    /* Image Lightbox */
    .lightbox {
      position: fixed;
      top: 0; left: 0; right: 0; bottom: 0;
      background: rgba(0, 0, 0, 0.9);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 9999;
    }

    .lightbox.active {
      display: flex;
    }

    .lightbox img {
      max-width: 90%;
      max-height: 90%;
      border-radius: 8px;
      object-fit: contain;
    }

    .lightbox-close {
      position: absolute;
      top: 20px;
      right: 20px;
      background: rgba(255, 255, 255, 0.2);
      border: none;
      color: white;
      width: 44px;
      height: 44px;
      border-radius: 50%;
      font-size: 24px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .image-tag {
      position: absolute;
      bottom: 4px;
      left: 4px;
      font-size: 10px;
      font-weight: 700;
      padding: 1px 5px;
      border-radius: 4px;
      text-transform: uppercase;
    }

    .image-tag:contains('b') { background: rgba(59,130,246,0.8); color: white; }

    .image-thumb .image-tag {
      background: rgba(0,0,0,0.6);
      color: white;
    }

    .image-delete-btn:hover {
      background: #dc2626;
    }

    /* Delete button for crew updates */
    .crew-update-delete {
      width: 24px;
      height: 24px;
      background: rgba(220, 38, 38, 0.1);
      border: 1px solid rgba(220, 38, 38, 0.3);
      border-radius: 4px;
      color: #f87171;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-left: auto;
      transition: all 0.2s;
    }

    .crew-update-delete:hover {
      background: rgba(220, 38, 38, 0.2);
      border-color: #f87171;
    }

    .no-crew-updates {
      text-align: center;
      padding: 20px;
      color: var(--color-text-secondary);
      font-size: 13px;
      background: var(--glass-bg);
      border-radius: var(--radius-md);
      border: 1px dashed var(--glass-border);
    }

    /* Mobile Navigation */
    .mobile-nav-toggle {
      display: none;
      flex-direction: column;
      justify-content: center;
      gap: 5px;
      width: 40px;
      height: 40px;
      background: var(--glass-bg);
      border: 1px solid var(--glass-border);
      border-radius: var(--radius-md);
      cursor: pointer;
      padding: 10px;
      transition: all 0.2s ease;
    }

    .mobile-nav-toggle span {
      display: block;
      width: 100%;
      height: 2px;
      background: var(--color-text-primary);
      border-radius: 2px;
      transition: all 0.3s ease;
    }

    .mobile-nav-toggle:hover {
      background: var(--glass-bg-hover);
    }

    .mobile-nav-toggle.active span:nth-child(1) {
      transform: rotate(45deg) translate(5px, 5px);
    }

    .mobile-nav-toggle.active span:nth-child(2) {
      opacity: 0;
    }

    .mobile-nav-toggle.active span:nth-child(3) {
      transform: rotate(-45deg) translate(5px, -5px);
    }

    .mobile-nav-overlay {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: rgba(0, 0, 0, 0.5);
      z-index: 998;
      opacity: 0;
      transition: opacity 0.3s ease;
    }

    .mobile-nav-overlay.active {
      display: block;
      opacity: 1;
    }

    .mobile-nav-panel {
      position: fixed;
      top: 0;
      right: -300px;
      width: 280px;
      height: 100vh;
      background: var(--color-background);
      border-left: 1px solid var(--glass-border);
      z-index: 999;
      transition: right 0.3s ease;
      overflow-y: auto;
    }

    .mobile-nav-panel.active {
      right: 0;
    }

    .mobile-nav-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 16px 20px;
      border-bottom: 1px solid var(--glass-border);
    }

    .mobile-nav-title {
      font-size: 18px;
      font-weight: 600;
      color: var(--color-text-primary);
    }

    .mobile-nav-close {
      width: 36px;
      height: 36px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: var(--glass-bg);
      border: 1px solid var(--glass-border);
      border-radius: var(--radius-md);
      cursor: pointer;
      color: var(--color-text-primary);
      transition: all 0.2s ease;
    }

    .mobile-nav-close:hover {
      background: var(--glass-bg-hover);
    }

    .mobile-nav-links {
      padding: 16px;
    }

    .mobile-nav-link {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 14px 16px;
      color: var(--color-text-secondary);
      text-decoration: none;
      font-weight: 500;
      font-size: 15px;
      border-radius: var(--radius-md);
      transition: all 0.2s ease;
      margin-bottom: 4px;
    }

    .mobile-nav-link:hover {
      background: var(--glass-bg-hover);
      color: var(--color-text-primary);
    }

    .mobile-nav-link.active {
      background: linear-gradient(135deg, var(--color-primary), var(--color-primary-dark));
      color: white;
    }

    .mobile-nav-link svg {
      flex-shrink: 0;
    }

    .mobile-nav-divider {
      height: 1px;
      background: var(--glass-border);
      margin: 12px 0;
    }

    .mobile-nav-section-title {
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: var(--color-text-secondary);
      padding: 8px 16px 12px;
      opacity: 0.7;
    }

    @media (max-width: 1024px) {
      .mobile-nav-toggle {
        display: flex;
      }

      .admin-nav {
        display: none;
      }
    }

    @media (max-width: 768px) {
      /* Phone: stack the list above the detail (full width). NOTE: align-items
         must be STRETCH here: the desktop base sets flex-start (for the sticky
         list), but once the container is column that makes children shrink to
         content width and overflow the viewport. */
      .admin-main { flex-direction: column; height: auto; align-items: stretch; }
      .projects-list {
        width: 100% !important; min-width: 100% !important; max-width: 100% !important;
        max-height: 45vh;
      }
      /* Let the detail panel shrink to the viewport and never push past it. */
      .project-content { width: 100%; min-width: 0; max-width: 100%; }

      /* iOS Safari sizes <input type="date"> at its intrinsic content
         width, including the picker icon area, and ignores parent
         width unless we explicitly reset its appearance + min-width.
         Without this, Schedule's Start Date / End Date inputs overflow
         narrow cards on phones. */
      .form-input[type="date"],
      .form-input[type="time"],
      .form-input[type="datetime-local"] {
        -webkit-appearance: none;
        appearance: none;
        min-width: 0;
        max-width: 100%;
        box-sizing: border-box;
      }

      /* Tablet (incl. iPad): keep the 2-column layout (detail beside the list),
         just narrow the list. Collapse it via the toggle for more room. */
      .admin-main {
        padding: 12px;
        gap: 12px;
      }

      .projects-list {
        width: 248px;
        min-width: 220px;
        max-width: 268px;
        padding: 10px;
      }
      .list-toggle-btn {
        display: inline-flex; align-items: center; justify-content: center;
        position: fixed; left: 8px; top: 50%; transform: translateY(-50%); z-index: 60;
        width: 34px; height: 34px; border-radius: 8px; font-size: 18px; line-height: 1;
        border: 1px solid var(--glass-border); background: var(--glass-bg);
        color: var(--color-text-primary); cursor: pointer;
        box-shadow: 0 4px 14px rgba(0,0,0,0.3);
      }
      .admin-main.list-collapsed > .projects-list { display: none; }

      .project-content {
        min-height: 250px;
        padding: 12px;
      }

      /* Mobile: sections are collapsible */
      .section-chevron {
        display: block;
        margin-left: auto;
        transition: transform 0.2s;
      }

      .section-toggle {
        cursor: pointer;
        user-select: none;
      }

      .section-toggle.collapsed .section-chevron {
        transform: rotate(-90deg);
      }

      .collapsed-mobile {
        display: none;
      }

      /* Compact detail header */
      .detail-header {
        margin-bottom: 12px;
      }

      .detail-customer-name {
        font-size: 18px;
      }

      .detail-header-top {
        gap: 8px;
        margin-bottom: 8px;
      }

      .detail-code {
        padding: 4px 10px;
        font-size: 11px;
        border-radius: 12px;
        margin-bottom: 6px;
      }

      .detail-name {
        font-size: 18px;
      }

      .detail-header-main {
        flex-direction: column;
        align-items: flex-start;
        gap: 8px;
      }

      /* Compact detail sections */
      .detail-section {
        padding: 12px;
        margin-bottom: 10px;
        border-radius: var(--radius-md);
      }

      .detail-section-title {
        font-size: 13px;
        margin-bottom: 10px;
      }

      .detail-row {
        gap: 2px;
        padding: 6px 0;
      }

      .detail-label {
        min-width: 70px;
        font-size: 11px;
      }

      .detail-value {
        font-size: 13px;
      }

      /* Compact form elements */
      .form-row {
        grid-template-columns: 1fr;
        gap: 10px;
      }

      .form-group label {
        font-size: 12px;
        margin-bottom: 4px;
      }

      .form-group input,
      .form-group select,
      .form-group textarea {
        padding: 8px 10px;
        font-size: 13px;
      }

      /* Compact buttons - force override */
      .btn,
      .btn-primary,
      .btn-secondary,
      .btn-danger,
      .btn-success {
        padding: 6px 10px !important;
        font-size: 11px !important;
        gap: 4px !important;
        border-radius: 6px !important;
      }

      .btn svg {
        width: 12px !important;
        height: 12px !important;
      }

      .btn-row {
        flex-wrap: wrap;
        gap: 6px !important;
      }

      .form-action-bar {
        gap: 8px;
        padding-top: 16px;
        margin-top: 16px;
      }

      .management-section {
        padding: 16px;
      }

      /* Compact status badge on mobile */
      .status-badge {
        padding: 5px 12px;
        font-size: 11px;
      }

      /* Compact crew sections */
      .crew-badge {
        padding: 3px 8px;
        font-size: 10px;
      }

      .crew-update-item {
        padding: 10px;
      }

      .crew-update-note {
        font-size: 13px;
      }

      .crew-update-image img {
        max-width: 150px;
      }

      /* Modal - Full screen on mobile */
      .modal {
        padding: 0 !important;
        align-items: flex-start !important;
      }

      .modal-content {
        max-width: 100% !important;
        width: 100% !important;
        min-height: 100vh !important;
        max-height: 100vh !important;
        border-radius: 0 !important;
        padding: 0 !important;
        display: flex;
        flex-direction: column;
      }

      .modal-icon {
        margin: 16px auto 12px;
      }

      .modal-title {
        font-size: 16px !important;
        padding: 0 16px;
        text-align: center;
      }

      .modal-text {
        font-size: 13px !important;
        padding: 0 16px;
        text-align: center;
      }

      /* Full-screen modal sets padding:0, so the offline-sign form fields would
         otherwise touch the screen edges. Give the form its own padding + make
         it the scrollable region so the actions can stick to the bottom. */
      .so-form {
        padding: 16px;
        overflow-y: auto;
        flex: 1 1 auto;
      }

      .modal-actions {
        position: sticky;
        bottom: 0;
        background: linear-gradient(135deg, rgba(21, 22, 25, 0.98), rgba(10, 11, 13, 0.99));
        margin-top: auto;
        padding: 12px 16px !important;
        border-top: 1px solid var(--glass-border);
        gap: 8px !important;
      }

      .modal-actions .btn {
        padding: 10px 16px !important;
        font-size: 13px !important;
        border-radius: 8px !important;
      }
    }

    /* Sub-action links - compact inline style */
    .mobile-nav-sub-action {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 8px 16px 8px 48px;
      color: var(--color-primary);
      text-decoration: none;
      font-weight: 500;
      font-size: 13px;
      border-radius: var(--radius-sm);
      transition: all 0.2s ease;
      margin-bottom: 4px;
    }

    .mobile-nav-sub-action:hover {
      background: var(--glass-bg-hover);
    }

    .mobile-nav-sub-action svg {
      width: 16px;
      height: 16px;
      flex-shrink: 0;
    }

    /* Project Tabs */
    .project-tabs {
      display: flex;
      gap: 0;
      border-bottom: 2px solid var(--color-border, #e5e7eb);
      margin-bottom: 20px;
      /* Tabs scroll horizontally instead of overflowing the panel on mobile. */
      overflow-x: auto;
      overflow-y: hidden;
      /* Touch swipes pan ONLY horizontally, no vertical drag of the nav. */
      touch-action: pan-x;
      overscroll-behavior-x: contain;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none; /* Firefox */
    }
    .project-tabs::-webkit-scrollbar { display: none; } /* Safari/Chrome */

    .project-tab {
      padding: 10px 20px;
      font-size: 13px;
      font-weight: 600;
      color: var(--color-text-secondary, #6b7280);
      background: none;
      border: none;
      border-bottom: 2px solid transparent;
      margin-bottom: -2px;
      cursor: pointer;
      transition: color 0.2s, border-color 0.2s;
      display: flex;
      align-items: center;
      gap: 6px;
      flex-shrink: 0;
      white-space: nowrap;
      flex-shrink: 0;        /* don't squash; let the row scroll */
      white-space: nowrap;
    }
    @media (max-width: 768px) {
      .project-tab { padding: 10px 14px; }
    }

    .project-tab:hover {
      color: var(--color-text-primary, #1a1a2e);
    }

    .project-tab.active {
      color: var(--color-primary, #0071e3);
      border-bottom-color: var(--color-primary, #0071e3);
    }

    .project-tab .tab-badge {
      background: var(--color-primary, #0071e3);
      color: white;
      font-size: 10px;
      padding: 1px 6px;
      border-radius: 10px;
      font-weight: 700;
    }

    /* Crew tab: Assignment + Portal Access side by side (50/50), stack on mobile */
    .crew-tab-row {
      display: flex;
      gap: 16px;
      align-items: flex-start;
    }
    .crew-tab-col {
      flex: 1 1 0;
      min-width: 0;
    }
    @media (max-width: 768px) {
      .crew-tab-row { flex-direction: column; gap: 0; }
    }

    .proj-tab-content {
      display: none;
    }

    .proj-tab-content.active {
      display: block;
    }

    /* Compose & Log */
    .messages-compose {
      margin-bottom: 20px;
    }

    .messages-compose label {
      display: block;
      font-size: 12px;
      font-weight: 600;
      color: var(--color-text-secondary, #6b7280);
      margin-bottom: 6px;
    }

    .messages-compose .compose-row {
      margin-bottom: 12px;
    }

    .messages-compose .compose-actions {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: 4px;
    }

    .messages-log {
      margin-top: 24px;
    }

    .messages-log-title {
      font-size: 13px;
      font-weight: 600;
      color: rgba(255, 255, 255, 0.6);
      margin-bottom: 12px;
      display: flex;
      align-items: center;
      gap: 6px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .proj-messages-container {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .messages-empty {
      text-align: center;
      padding: 24px;
      color: rgba(255, 255, 255, 0.35);
    }

    .messages-empty svg {
      margin-bottom: 8px;
      opacity: 0.5;
    }

    .messages-empty p {
      font-size: 13px;
      margin: 0;
    }

    /* .form-input / .form-textarea defined canonically in src/styles/admin.css.
       Local overrides removed to keep all admin pages visually consistent. */

    .btn-success {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 8px 16px;
      background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%);
      color: white;
      border: none;
      border-radius: 8px;
      font-size: 13px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s;
    }

    .btn-success:hover {
      box-shadow: 0 4px 12px rgba(34, 197, 94, 0.3);
    }

    .btn-polish {
      background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
      color: white;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 8px 16px;
      border: none;
      border-radius: 8px;
      font-size: 13px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s;
    }

    .btn-polish:hover { opacity: 0.9; }
    .btn-polish:disabled { opacity: 0.6; cursor: wait; }

    .spinner-sm {
      display: inline-block;
      width: 12px;
      height: 12px;
      border: 2px solid rgba(255,255,255,0.3);
      border-radius: 50%;
      border-top-color: white;
      animation: spin 0.8s linear infinite;
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    /* Chat-style Messages */
    .message-item {
      padding: 10px 14px;
      border-radius: 16px;
      max-width: 82%;
      transition: background 0.2s;
    }

    .message-item.admin-msg {
      align-self: flex-end;
      background: rgba(74, 222, 128, 0.1);
      border: 1px solid rgba(74, 222, 128, 0.2);
      border-bottom-right-radius: 4px;
    }

    .message-item.admin-msg:hover {
      background: rgba(74, 222, 128, 0.15);
    }

    .message-item.customer-reply {
      align-self: flex-start;
      background: rgba(59, 130, 246, 0.1);
      border: 1px solid rgba(59, 130, 246, 0.25);
      border-bottom-left-radius: 4px;
    }

    .message-item.customer-reply:hover {
      background: rgba(59, 130, 246, 0.15);
    }

    .message-item .msg-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 6px;
      gap: 12px;
    }

    .message-item .msg-subject {
      font-size: 12px;
      font-weight: 600;
      color: rgba(255, 255, 255, 0.7);
      flex: 1;
    }

    .message-item .msg-date {
      font-size: 10px;
      color: rgba(255, 255, 255, 0.35);
      white-space: nowrap;
    }

    .message-item .msg-body {
      font-size: 13px;
      color: rgba(255, 255, 255, 0.9);
      line-height: 1.5;
      white-space: pre-wrap;
    }

    .message-item .msg-sender-badge {
      font-size: 10px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      padding: 2px 8px;
      border-radius: 10px;
      display: inline-block;
      margin-bottom: 4px;
    }

    .message-item .msg-sender-badge.admin {
      background: rgba(74, 222, 128, 0.15);
      color: #4ade80;
    }

    .message-item .msg-sender-badge.customer {
      background: rgba(96, 165, 250, 0.15);
      color: #60a5fa;
    }
  </style>
</head>
<body>
  <AdminPresence />
  <header class="admin-header">
    <a href="/admin/dashboard" class="admin-logo-link">
      <div class="logo-gradient-wrapper"></div>
      <span class="admin-badge">Admin</span>
    </a>
    <AdminNav active="projects" />
    <!-- Mobile: Bell + Hamburger -->
    <div class="mobile-header-right">
      <div class="notification-bell-wrapper">
        <button class="btn-bell" id="bellBtnMobile" title="Customer Replies" aria-label="Customer Replies">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
          <span class="bell-badge bell-badge-mobile" style="display:none;">0</span>
        </button>
        <div class="bell-dropdown" id="bellDropdownMobile" style="display:none;">
          <div class="bell-dropdown-header"><span>Customer Replies</span><button class="bell-mark-all-read" onclick="markAllRead()">Mark all read</button></div>
          <div class="bell-dropdown-list" id="bellListMobile">
            <div class="bell-dropdown-empty">No new replies</div>
          </div>
        </div>
      </div>
      <button class="mobile-nav-toggle" id="mobileNavToggle" aria-label="Toggle navigation">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>

    <div class="header-actions">
      <button class="theme-toggle" id="themeToggle" onclick="toggleTheme()" title="Toggle theme">
        <svg class="icon-sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="5"/>
          <line x1="12" y1="1" x2="12" y2="3"/>
          <line x1="12" y1="21" x2="12" y2="23"/>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
          <line x1="1" y1="12" x2="3" y2="12"/>
          <line x1="21" y1="12" x2="23" y2="12"/>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
        </svg>
        <svg class="icon-moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
      </button>
      <div class="notification-bell-wrapper">
        <button class="btn-bell" id="bellBtn" title="Customer Replies" aria-label="Customer Replies">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
          <span class="bell-badge" id="bellBadge" style="display:none;">0</span>
        </button>
        <div class="bell-dropdown" id="bellDropdown" style="display:none;">
          <div class="bell-dropdown-header"><span>Customer Replies</span><button class="bell-mark-all-read" onclick="markAllRead()">Mark all read</button></div>
          <div class="bell-dropdown-list" id="bellList">
            <div class="bell-dropdown-empty">No new replies</div>
          </div>
        </div>
      </div>
      <button class="btn-logout" onclick="logout()">Logout</button>
    </div>
  </header>

  <AdminMobileDrawer active="projects" />

  <button class="list-toggle-btn" id="listToggleBtn" title="Show / hide list" aria-label="Toggle list">‹</button>
  <main class="admin-main">
    <!-- Left Column: All Projects List with Search -->
    <aside class="projects-list">
      <button type="button" class="new-project-btn" onclick="openNewProjectModal()">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M12 5v14M5 12h14"/></svg>
        New Project
      </button>
      <div class="search-bar">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"/>
          <path d="M21 21l-4.35-4.35"/>
        </svg>
        <input
          type="text"
          class="search-input"
          id="projectSearch"
          placeholder="Search projects..."
          oninput="filterProjects()"
        />
      </div>

      <div id="projectsList">
        <!-- Needs Crew / Ready to Start -->
        <div class="project-section">
          <div class="section-header section-toggle" data-section="needsCrew">
            <span class="section-title">Ready to Start</span>
            <span class="section-count needs-crew">{needsCrewProjects.length}</span>
            <svg class="section-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
          </div>
          <div class="section-body" id="sectionNeedsCrew">
            {needsCrewProjects.length === 0 ? (
              <div class="empty-state">No projects ready to start</div>
            ) : (
              needsCrewProjects.map((project) => (
                <div class="project-card" data-id={project.id} data-status={project.status} data-search={`${project.project_number} ${project.customer_name} ${project.customer_email || ''} ${project.customer_phone || ''}`.toLowerCase()} onclick={`selectProject(${project.id})`}>
                  <div class="project-number" title={project.project_number}><span class="proj-shortcode">#{(project.project_number || '').slice(-4)}</span></div>
                  <div class="project-name">{project.customer_name}</div>
                  <div class="project-meta">
                    <span class="card-status-slot">
                    {project.contract_real_status === 'sent'
                      ? <span class="warning-badge" style="background: rgba(234,179,8,0.15); color: #eab308;">Awaiting Signature</span>
                      : project.contract_real_status === 'draft'
                      ? <span class="warning-badge" style="background: rgba(239,68,68,0.15); color: #ef4444;">Contract Not Sent</span>
                      : (!project.crew_lead_id ? <span class="warning-badge">Needs Crew</span> : <span class="crew-badge">Ready</span>)}
                    </span>
                    {project.crew_lead_name && <span style="margin-left: 4px; color: #4ade80;">✓ {project.crew_lead_name}</span>}
                  </div>
                  <div class="project-meta" style="margin-top: 4px;">{formatCurrency(project.effective_total)}</div>
                </div>
              ))
            )}
          </div>
        </div>

        <!-- In Progress -->
        <div class="project-section">
          <div class="section-header section-toggle" data-section="inProgress">
            <span class="section-title">In Progress</span>
            <span class="section-count in-progress">{inProgressProjects.length}</span>
            <svg class="section-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
          </div>
          <div class="section-body collapsed-mobile" id="sectionInProgress">
            {inProgressProjects.length === 0 ? (
              <div class="empty-state">No projects in progress</div>
            ) : (
              inProgressProjects.map((project) => (
                <div class="project-card" data-id={project.id} data-status={project.status} data-search={`${project.project_number} ${project.customer_name} ${project.customer_email || ''} ${project.customer_phone || ''}`.toLowerCase()} onclick={`selectProject(${project.id})`}>
                  <div class="project-number" title={project.project_number}><span class="proj-shortcode">#{(project.project_number || '').slice(-4)}</span></div>
                  <div class="project-name">{project.customer_name}</div>
                  <div class="project-meta">
                    {project.crew_lead_name && <span class="crew-badge">{project.crew_lead_name}</span>}
                  </div>
                  <div class="project-meta" style="margin-top: 4px;">{formatCurrency(project.effective_total)}</div>
                </div>
              ))
            )}
          </div>
        </div>

        <!-- Completed -->
        <div class="project-section">
          <div class="section-header section-toggle" data-section="completed">
            <span class="section-title">Completed</span>
            <span class="section-count completed">{completedProjects.length}</span>
            <svg class="section-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
          </div>
          <div class="section-body collapsed-mobile" id="sectionCompleted">
            {completedProjects.length === 0 ? (
              <div class="empty-state">No completed projects</div>
            ) : (
              completedProjects.map((project) => (
                <div class="project-card" data-id={project.id} data-status={project.status} data-search={`${project.project_number} ${project.customer_name} ${project.customer_email || ''} ${project.customer_phone || ''}`.toLowerCase()} onclick={`selectProject(${project.id})`}>
                  <div class="project-number" title={project.project_number}><span class="proj-shortcode">#{(project.project_number || '').slice(-4)}</span></div>
                  <div class="project-name">{project.customer_name}</div>
                  <div class="project-meta"><span class="crew-badge">Completed</span></div>
                  <div class="project-meta" style="margin-top: 4px;">{formatCurrency(project.effective_total)}</div>
                </div>
              ))
            )}
          </div>
        </div>
      </div>
    </aside>

    <!-- Middle Column: Project Detail -->
    <section class="project-content" id="projectContent">
      <div class="content-placeholder">
        <div class="placeholder-icon">📋</div>
        <p>Select a project to view details</p>
      </div>
    </section>

  </main>

