    // Convert HEIC/HEIF to JPEG using canvas
    async function convertHeicToJpeg(file) {
      var isHeic = file.type === 'image/heic' || file.type === 'image/heif' ||
        file.name.toLowerCase().endsWith('.heic') || file.name.toLowerCase().endsWith('.heif');
      if (!isHeic) return file;
      var bitmap = await createImageBitmap(file);
      var canvas = document.createElement('canvas');
      canvas.width = bitmap.width;
      canvas.height = bitmap.height;
      var ctx = canvas.getContext('2d');
      ctx.drawImage(bitmap, 0, 0);
      bitmap.close();
      var blob = await new Promise(function(resolve) { canvas.toBlob(resolve, 'image/jpeg', 0.92); });
      var newName = file.name.replace(/\.heic$/i, '.jpg').replace(/\.heif$/i, '.jpg');
      return new File([blob], newName, { type: 'image/jpeg' });
    }

    async function handleProjectImageUpload(event) {
      var files = Array.from(event.target.files || []);
      if (files.length === 0) return;

      var pid = currentUploadProjectId;
      var progressBar = document.getElementById('projUploadProgress-' + pid);
      var progressText = document.getElementById('projUploadText-' + pid);
      var progressFill = document.getElementById('projUploadFill-' + pid);

      if (progressBar) progressBar.style.display = 'block';
      if (progressFill) progressFill.style.width = '0%';

      // Convert HEIC files to JPEG (videos skip the converter)
      var convertedFiles = [];
      for (var i = 0; i < files.length; i++) {
        var f = files[i];
        var isVideoFile = (f.type || '').startsWith('video/');
        var isHeic = !isVideoFile && (f.type === 'image/heic' || f.type === 'image/heif' ||
          f.name.toLowerCase().endsWith('.heic') || f.name.toLowerCase().endsWith('.heif'));
        if (isHeic && progressText) progressText.textContent = 'Converting ' + (i + 1) + '/' + files.length + ': ' + f.name;
        if (isVideoFile) {
          convertedFiles.push(f);
        } else {
          try {
            convertedFiles.push(await convertHeicToJpeg(f));
          } catch (err) {
            console.log('[Upload] Client HEIC conversion failed for ' + f.name + ', server will handle');
            convertedFiles.push(f);
          }
        }
      }
      files = convertedFiles;
      if (files.length === 0) return;

      // Skip oversized files but keep going with the rest. Images cap at
      // 25MB, videos at 100MB.
      var IMAGE_MAX = 25 * 1024 * 1024;
      var VIDEO_MAX = 100 * 1024 * 1024;
      var skipped = files.filter(function(f) {
        var max = (f.type || '').startsWith('video/') ? VIDEO_MAX : IMAGE_MAX;
        return f.size > max;
      });
      files = files.filter(function(f) {
        var max = (f.type || '').startsWith('video/') ? VIDEO_MAX : IMAGE_MAX;
        return f.size <= max;
      });
      if (skipped.length > 0) {
        showToast('Skipped ' + skipped.length + ' file(s) over their size limit (25MB images / 100MB videos): ' + skipped.slice(0, 3).map(function(f) { return f.name + ' (' + (f.size / 1048576).toFixed(1) + 'MB)'; }).join(', ') + (skipped.length > 3 ? '…' : ''), 'warning');
      }
      if (files.length === 0) {
        event.target.value = '';
        if (progressBar) progressBar.style.display = 'none';
        return;
      }

      var total = files.length;
      var successCount = 0;
      var errorCount = 0;
      var skippedCount = skipped.length;
      var errorReasons = [];

      for (var i = 0; i < files.length; i++) {
        var file = files[i];
        var current = i + 1;
        if (progressText) progressText.textContent = 'Uploading ' + current + '/' + total + ': ' + file.name;
        if (progressFill) progressFill.style.width = ((i / total) * 100) + '%';

        try {
          // Get upload URL
          var urlRes = await fetch('/api/r2-upload-url/', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'include',
            body: JSON.stringify({
              filename: file.name,
              contentType: file.type,
              folder: 'progress',
              projectId: pid
            })
          });

          var urlData = await urlRes.json();
          if (!urlData.success) throw new Error(urlData.error);

          // Upload to R2
          var r2Res = await fetch(urlData.uploadUrl, {
            method: 'PUT',
            body: file,
            headers: { 'Content-Type': file.type },
            credentials: 'include'
          });

          if (!r2Res.ok) throw new Error('R2 upload failed: ' + r2Res.status);

          // Save to project_updates
          var addRes = await fetch('/api/projects/' + pid + '/updates/', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'include',
            body: JSON.stringify({
              image_url: urlData.publicUrl,
              posted_by: 'admin',
              posted_by_name: 'Admin'
            })
          });

          var addData = await addRes.json();
          if (addData.success) {
            successCount++;
          } else {
            throw new Error(addData.error || 'Failed to save image');
          }
        } catch (err) {
          console.error('Upload error for ' + file.name + ':', err);
          errorCount++;
          errorReasons.push(file.name + ': ' + ((err && err.message) ? err.message : 'unknown error'));
        }

        if (progressFill) progressFill.style.width = ((current / total) * 100) + '%';
      }

      event.target.value = '';

      // Show final status
      var summarySuffix = '';
      if (errorCount > 0) summarySuffix += ', ' + errorCount + ' failed';
      if (skippedCount > 0) summarySuffix += ', ' + skippedCount + ' skipped (>10MB)';
      if (progressText) progressText.textContent = 'Done! ' + successCount + ' uploaded' + summarySuffix;
      if (progressFill) progressFill.style.width = '100%';

      var reasonText = errorReasons.length ? (' — ' + errorReasons[0] + (errorReasons.length > 1 ? ' (+' + (errorReasons.length - 1) + ' more)' : '')) : '';
      if (successCount > 0) {
        var toastSuffix = '';
        if (errorCount > 0) toastSuffix += ' (' + errorCount + ' failed';
        if (skippedCount > 0) toastSuffix += (toastSuffix ? ', ' : ' (') + skippedCount + ' skipped';
        if (toastSuffix) toastSuffix += ')';
        showToast(successCount + ' image' + (successCount > 1 ? 's' : '') + ' uploaded!' + toastSuffix + reasonText, (errorCount > 0 || skippedCount > 0) ? 'warning' : 'success');
        setTimeout(() => window.location.reload(), 2000);
      } else if (skippedCount > 0 && errorCount === 0) {
        showToast('All ' + skippedCount + ' file(s) over 25MB. Nothing uploaded.', 'error');
        setTimeout(() => { if (progressBar) progressBar.style.display = 'none'; }, 3000);
      } else {
        showToast('Upload failed' + reasonText, 'error');
        setTimeout(() => { if (progressBar) progressBar.style.display = 'none'; }, 4000);
      }
    }

