      var tr = document.createElement('tr');
      tr.innerHTML = '<td><textarea class="pricing-input" rows="1" placeholder="Description" oninput="autoResize(this)"></textarea></td><td><input type="number" value="1" class="pricing-input" min="1" onchange="calcLaborRow(this)" /></td><td><input type="number" value="0" class="pricing-input" step="0.01" onchange="calcLaborRow(this)" /></td><td><input type="number" value="0" class="pricing-input labor-total" step="0.01" readonly /></td><td><button class="btn-remove-row" onclick="this.closest(\'tr\').remove(); updateProjTotals(' + projectId + ');">&times;</button></td>';
      tbody.appendChild(tr);
      tr.querySelector('textarea').focus();
    }

    function calcLaborRow(input) {
      var tr = input.closest('tr');
      var inputs = tr.querySelectorAll('input');
      var qty = parseFloat(inputs[1].value) || 0;
      var unitPrice = parseFloat(inputs[2].value) || 0;
      inputs[3].value = (qty * unitPrice).toFixed(2);
      // Find project ID from table
      var table = tr.closest('table');
      if (table && table.id) {
        var pid = table.id.replace('projLabor-', '');
        updateProjTotals(parseInt(pid));
      }
    }

    function updateProjTotals(projectId) {
      var laborRows = document.querySelectorAll('#projLabor-' + projectId + ' tbody tr');
      var laborTotal = 0;
      laborRows.forEach(function(row) {
        laborTotal += parseFloat(row.querySelector('.labor-total')?.value || '0');
      });
      var discount = parseFloat(document.getElementById('projDiscount-' + projectId)?.value || '0');
      var grandTotal = laborTotal - discount;

      var ltEl = document.getElementById('projLaborTotal-' + projectId);
      var gtEl = document.getElementById('projGrandTotal-' + projectId);
      if (ltEl) ltEl.textContent = '$' + laborTotal.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      if (gtEl) gtEl.textContent = '$' + grandTotal.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    function getProjPricingData(projectId) {
      // Gather materials
      var materials = [];
      document.querySelectorAll('#projMaterials-' + projectId + ' tbody tr').forEach(function(row) {
        var name = row.querySelector('input')?.value?.trim();
        if (name) materials.push({ name: name });
      });

      // Gather labor
      var labor = [];
      document.querySelectorAll('#projLabor-' + projectId + ' tbody tr').forEach(function(row) {
        var inputs = row.querySelectorAll('input');
        var textarea = row.querySelector('textarea');
        var desc = (textarea ? textarea.value : inputs[0]?.value)?.trim();
        if (desc) {
          // When textarea exists for description: inputs[0]=qty, inputs[1]=unit_price, inputs[2]=total
          // When no textarea: inputs[0]=description, inputs[1]=qty, inputs[2]=unit_price, inputs[3]=total
          var offset = textarea ? 0 : 1;
          var qty = parseInt(inputs[offset]?.value) || 1;
          var unitPrice = parseFloat(inputs[offset + 1]?.value) || 0;
          var total = qty * unitPrice;
          labor.push({
            description: desc,
            qty: qty,
            unit_price: unitPrice,
            total: total
          });
        }
      });

      var discount = parseFloat(document.getElementById('projDiscount-' + projectId)?.value || '0');

      return { materials: materials, labor: labor, discount: discount };
    }

