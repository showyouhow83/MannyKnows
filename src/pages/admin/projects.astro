  <!-- Mark contract signed offline (paper) -->
  <div class="modal" id="signOfflineModal">
    <div class="modal-backdrop" onclick="closeSignOfflineModal()"></div>
    <div class="modal-content" style="max-width:420px;">
      <h3 class="modal-title">Mark signed offline</h3>
      <p class="modal-text" style="margin-bottom:16px;">Record a contract signed on paper. This is logged as an offline signature (not an e-signature).</p>
      <div class="so-form">
        <div>
          <label class="so-label">Who signed?</label>
          <select id="soSigners" class="so-field" onchange="soToggleContractor()">
            <option value="both">Customer &amp; contractor (fully executed)</option>
            <option value="customer">Customer only</option>
          </select>
        </div>
        <div>
          <label class="so-label">Customer name</label>
          <input type="text" id="soCustomerName" class="so-field" placeholder="Full legal name" />
        </div>
        <div id="soContractorRow">
          <label class="so-label">Contractor name</label>
          <input type="text" id="soContractorName" class="so-field" placeholder="e.g. MannyKnows" />
        </div>
        <div>
          <label class="so-label">Date signed</label>
          <input type="date" id="soDate" class="so-field" />
        </div>
        <div>
          <label class="so-label">Note <span style="font-weight:400;text-transform:none;">(optional)</span></label>
          <input type="text" id="soNote" class="so-field" placeholder="e.g. signed on-site at the shop" />
        </div>
        <div>
          <label class="so-label">Scanned signed copy <span style="font-weight:400;text-transform:none;">(optional)</span></label>
          <input type="file" id="soScan" class="so-field so-file" accept="image/*,application/pdf" />
        </div>
      </div>
      <div class="modal-actions" style="margin-top:20px;">
        <button class="btn btn-cancel" onclick="closeSignOfflineModal()">Cancel</button>
        <button class="btn btn-confirm" id="soConfirmBtn" onclick="submitSignOffline()">Mark signed</button>
      </div>
