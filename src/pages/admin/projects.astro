    async function saveProject(id, force) {
      console.log('[Projects] saveProject called with id:', id);

      const crewLeadSelect = document.getElementById('crewLeadSelect');
      const crewNotesInput = document.getElementById('crewNotes');

      if (!crewLeadSelect || !crewNotesInput) {
        console.error('[Projects] Form elements not found');
        showToast('Form error - please refresh the page', 'error');
        return;
      }

      const crewLeadId = crewLeadSelect.value;
      const crewNotes = crewNotesInput.value;

      var schedStart = document.getElementById('schedStart-' + id);
      var schedEnd = document.getElementById('schedEnd-' + id);
      var scopeEl = document.getElementById('projScope-' + id);
      var pricing = getProjPricingData(id);

      console.log('[Projects] Saving:', { id, crewLeadId, crewNotes, pricing });

      try {
        // Save project data (crew, schedule, scope_description)
        const response = await fetch('/api/projects/', {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'include',
          body: JSON.stringify({
            project_id: id,
            // Optimistic-lock token: the project version we loaded. force omits
            // it so "Save anyway" can override a background/second-tab bump.
            expected_updated_at: force ? null : ((projects.find((p) => p.id === id) || {}).updated_at || null),
            crew_lead_id: crewLeadId ? parseInt(crewLeadId) : null,
            crew_notes: crewNotes,
            scheduled_start: schedStart ? schedStart.value || null : undefined,
            scheduled_end: schedEnd ? schedEnd.value || null : undefined,
            scope_description: scopeEl ? (scopeEl.value || null) : undefined
          })
        });

        const data = await response.json();

        // Changed since we opened it (another window or a background update).
        // Offer "Save anyway" instead of blocking, so a long edit isn't lost.
        if (!data.success && (response.status === 409 || data.conflict)) {
          showConfirmModal(
            'This project changed in another window',
            'It was updated since you opened it (another tab, or an automatic background update). Save your changes anyway? This will overwrite the other version.',
            'Save anyway', 'info',
            () => saveProject(id, true)
          );
          return;
        }

        // Save pricing + scope_description to quote (canonical source) and
        // sync the recomputed total back to the project below.
        if (currentProjectQuoteId && (pricing.materials.length > 0 || pricing.labor.length > 0 || scopeEl)) {
          // Legacy materials/labor sync: ONLY send pricing fields when that
          // retired UI actually has rows. On scope-priced projects it is
          // always empty, and unconditionally sending discount: 0 here was
          // silently wiping the quote's discount on every project save
          // (which then propagated to the project + draft contract).
          const legacyPricing = pricing.materials.length > 0 || pricing.labor.length > 0;
          const quoteRes = await fetch('/api/quotes/', {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'include',
            body: JSON.stringify({
              quote_id: currentProjectQuoteId,
              ...(legacyPricing ? {
                materials: pricing.materials,
                labor: pricing.labor,
                discount: pricing.discount,
              } : {}),
              scope_description: scopeEl ? (scopeEl.value || null) : undefined
            })
          });
          const quoteData = await quoteRes.json();
          if (quoteData.success && quoteData.quote) {
            // Sync the calculated total back to the project
            await fetch('/api/projects/', {
              method: 'PATCH',
              headers: { 'Content-Type': 'application/json' },
              credentials: 'include',
              body: JSON.stringify({ project_id: id, total: quoteData.quote.total })
            });
          } else if (!quoteData.success) {
            console.error('[Projects] Failed to save pricing:', quoteData.error);
          }
        }

        if (data.success) {
          showToast('Project saved successfully!', 'success');
          // Reopen the SAME project after the reload instead of deselecting.
          setTimeout(() => { window.location.href = window.location.pathname + '?open=' + id; }, 900);
        } else {
          showToast(data.error || 'Failed to save project', 'error');
        }
      } catch (err) {
        console.error('[Projects] Save error:', err);
        showToast('Failed to save. Please try again.', 'error');
      }
    }

