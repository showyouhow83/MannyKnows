    async function submitSignOffline() {
      if (!soProjectId) return;
      var btn = document.getElementById('soConfirmBtn');
      var signers = document.getElementById('soSigners').value;
      var customer_name = document.getElementById('soCustomerName').value.trim();
      var contractor_name = document.getElementById('soContractorName').value.trim();
      var signed_date = document.getElementById('soDate').value || '';
      var note = document.getElementById('soNote').value.trim();
      if (!customer_name) { showToast('Customer name is required', 'error'); return; }
      if (signers === 'both' && !contractor_name) { showToast('Contractor name is required', 'error'); return; }
      var orig = btn.textContent; btn.disabled = true; btn.textContent = 'Saving…';
      try {
        var scan_url = '';
        var scanInput = document.getElementById('soScan');
        var file = scanInput && scanInput.files && scanInput.files[0];
        if (file) {
          var urlRes = await fetch('/api/r2-upload-url/', { method: 'POST', headers: { 'Content-Type': 'application/json' }, credentials: 'include', body: JSON.stringify({ filename: file.name, contentType: file.type, folder: 'contracts', projectId: soProjectId }) });
          var urlData = await urlRes.json();
          if (urlData.success) {
            var put = await fetch(urlData.uploadUrl, { method: 'PUT', body: file, headers: { 'Content-Type': file.type }, credentials: 'include' });
            if (put.ok) scan_url = urlData.publicUrl;
          }
        }
        var res = await fetch('/api/projects/' + soProjectId + '/mark-signed-offline/', { method: 'POST', headers: { 'Content-Type': 'application/json' }, credentials: 'include', body: JSON.stringify({ signers: signers, customer_name: customer_name, contractor_name: contractor_name, signed_date: signed_date, note: note, scan_url: scan_url }) });
        var data = await res.json();
        if (data.success) {
          showToast('Contract marked signed offline', 'success');
          closeSignOfflineModal();
          setTimeout(function () { window.location.href = window.location.pathname + '?open=' + soProjectId; }, 700);
        } else {
          showToast(data.error || 'Failed to mark signed', 'error');
          btn.disabled = false; btn.textContent = orig;
        }
      } catch (e) {
        showToast('Network error', 'error');
        btn.disabled = false; btn.textContent = orig;
      }
    }
