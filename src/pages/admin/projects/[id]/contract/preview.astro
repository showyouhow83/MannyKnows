---
// /admin/projects/[id]/contract/preview — printable contract document.
// Renders the same content the customer sees when signing, plus the
// payment-schedule table + signature lines for the printed copy. Admin
// uses Cmd/Ctrl+P → Save as PDF, or "Save to Project PDFs" to attach to
// the project_contracts row for the customer-facing signing page.
import { env as cfEnv } from 'cloudflare:workers';
import { AdminAuth } from '../../../../../lib/adminAuth';
import {
  COMPANY_HEADER,
  parseScopes,
  renderScopesHtml,
} from '../../../../../lib/quoteTemplateConstants';
import { getBrand, SL_BRAND, type Brand } from '../../../../../lib/brand';
import { streamThumb } from '../../../../../lib/stream';

export const prerender = false;

const env = cfEnv;
const db = env?.MK_APP_DB;
const projectId = Number(Astro.params.id);
if (!db || !projectId || Number.isNaN(projectId)) {
  return Astro.redirect('/admin/projects');
}

// Auth model: admin session OR `?token=<contract_token>` matching the
// row. Token path is how the customer-side signing page loads this
// preview in a hidden iframe to generate the signed contract PDF.
const sessionSecret = env?.SESSION_SECRET || env?.ADMIN_PASSWORD;
const session = await AdminAuth.validateSession(Astro.request, sessionSecret);
const urlToken = (Astro.url.searchParams.get('token') || '').trim();

// Pull project + contract + originating quote in one round trip.
const row = await db.prepare(`
  SELECT
    p.id AS project_id, p.project_number, p.customer_name, p.customer_email,
    p.customer_phone, p.customer_address, p.customer_city, p.customer_state,
    p.customer_zip, p.scheduled_start, p.scheduled_end, p.services,
    p.scope_description, p.partner_id,
    c.id AS contract_id, c.scopes AS contract_scopes,
    c.total, c.discount, c.start_date,
    c.down_payment_percent, c.down_payment_count, c.monthly_payment_count,
    c.cancellation_window_days, c.cancellation_fee_amount,
    c.late_fee_amount, c.late_fee_grace_days, c.warranty_months,
    c.payment_schedule, c.terms, c.status, c.contract_token, c.use_as_reference
  FROM projects p
  LEFT JOIN project_contracts c ON c.project_id = p.id
  WHERE p.id = ?
`).bind(projectId).first() as any;

const brand: Brand = row ? await getBrand(db, row.partner_id) : SL_BRAND;

if (!row) {
  return new Response('Project not found', { status: 404 });
}

// Authorize: admin session OR URL token matches the contract row exactly.
const tokenAuthorized = !!(urlToken && row.contract_token && urlToken === row.contract_token);
if (!session.isAuthenticated && !tokenAuthorized) {
  return Astro.redirect('/admin/');
}

if (!row.contract_id) {
  // No contract applied yet — surface a friendly placeholder.
  return new Response(
    `<!doctype html><html><head><meta charset="utf-8"><title>No contract</title><style>body{font-family:-apple-system,sans-serif;background:#fafafa;padding:40px;text-align:center;color:#71717a;}</style></head><body><h2>No contract applied yet</h2><p>Apply a contract template on the project page first.</p><p><a href="/admin/projects?open=${projectId}">← Back to project</a></p><script is:inline>
  // cdn-cgi thumbnail fallback: swap to the raw R2 URL when transformations 404.
  document.addEventListener('error', function (e) {
    var img = e.target;
    if (!img || img.tagName !== 'IMG' || img.dataset.cdnFallback) return;
    var m = /^(https?:\/\/[^/]+)\/cdn-cgi\/image\/[^/]+(\/.+)$/.exec(img.src);
    if (m) { img.dataset.cdnFallback = '1'; img.src = m[1] + m[2]; }
  }, true);
</script>
</body></html>`,
    { headers: { 'Content-Type': 'text/html' } }
  );
}

const today = new Date().toLocaleDateString('en-US', {
  month: 'long', day: 'numeric', year: 'numeric',
});
function fmtDate(s: string | null | undefined): string {
  if (!s) return '_______________';
  try {
    // Tolerate SQLite CURRENT_TIMESTAMP ('YYYY-MM-DD HH:MM:SS') as well as
    // plain 'YYYY-MM-DD'. Splitting on space/T isolates the date.
    const trimmed = String(s).split(/[\sT]/)[0];
    const d = new Date(trimmed + 'T00:00:00');
    if (isNaN(d.getTime())) return String(s);
    return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
  } catch { return String(s); }
}
function fmtMoney(n: number | string | null | undefined): string {
  const v = Number(n);
  if (!Number.isFinite(v)) return '$0.00';
  return v.toLocaleString('en-US', { style: 'currency', currency: 'USD' });
}
function formatServices(raw: string | null): string {
  if (!raw) return '';
  try {
    const arr = JSON.parse(raw);
    if (!Array.isArray(arr)) return '';
    return arr.map((s: any) => typeof s === 'string' ? s : s?.type || '').filter(Boolean)
      .map((t: string) => t.charAt(0).toUpperCase() + t.slice(1)).join(' + ');
  } catch { return ''; }
}

// Hydrate JSON columns.
const scopes = parseScopes(row.contract_scopes);
const scopesHtml = renderScopesHtml(scopes);

// Pull both signatures (contractor + customer). Contractor is snapshotted
// on apply-template so it shows up in drafts as well. Customer signature
// only exists once status is signed/countersigned.
type SigRow = {
  signature_data_url: string;
  signer_name: string;
  signed_at: string;
  ip_address?: string | null;
  user_agent?: string | null;
  consent_text?: string | null;
};
let contractorSig: SigRow | null = null;
let customerSig: SigRow | null = null;
if (row.contract_id) {
  const sigs = await db.prepare(
    "SELECT signature_data_url, signer_name, signed_at, ip_address, user_agent, consent_text, signer_role FROM contract_signatures WHERE project_contract_id = ? ORDER BY signed_at DESC"
  ).bind(row.contract_id).all() as any;
  for (const s of (sigs.results || [])) {
    const sigRow: SigRow = {
      signature_data_url: s.signature_data_url,
      signer_name: s.signer_name,
      signed_at: s.signed_at,
      ip_address: s.ip_address ?? null,
      user_agent: s.user_agent ?? null,
      consent_text: s.consent_text ?? null,
    };
    if (s.signer_role === 'contractor' && !contractorSig) contractorSig = sigRow;
    if (s.signer_role === 'customer' && !customerSig) customerSig = sigRow;
  }
}

// Per-payment receipts — populate the schedule's signature column for any
// payment that's been collected (down, progress, final). Keyed by row id.
type ReceiptRow = {
  row_id: string;
  amount: number;
  payment_method: string | null;
  check_number: string | null;
  customer_name: string | null;
  customer_signature_data_url: string | null;
  contractor_name: string | null;
  contractor_signature_data_url: string | null;
  collected_at: string | null;
};
const receiptByRow: Record<string, ReceiptRow> = {};
if (row.contract_id) {
  try {
    const recs = await db.prepare(
      `SELECT row_id, amount, payment_method, check_number, customer_name,
              customer_signature_data_url, contractor_name, contractor_signature_data_url, collected_at
       FROM payment_receipts WHERE project_contract_id = ?`
    ).bind(row.contract_id).all() as any;
    for (const r of (recs.results || [])) receiptByRow[r.row_id] = r as ReceiptRow;
  } catch (e) {
    console.error('[contract preview] payment_receipts query failed (table missing?):', e);
  }
}

// Customer-selected colors (v73) — rendered as a "Color Selections" section so
// the chosen paint/stain + finish appear on the contract PDF (live reflect).
type ColorRow = { label: string | null; product_type: string | null; color_value: string | null; finish: string | null; note: string | null };
let colorSelections: ColorRow[] = [];
if (row.project_id) {
  try {
    const cs = await db.prepare(
      `SELECT label, product_type, color_value, finish, note FROM project_colors
       WHERE project_id = ? AND (color_value IS NOT NULL OR finish IS NOT NULL) ORDER BY created_at ASC`
    ).bind(row.project_id).all() as any;
    colorSelections = (cs.results || []) as ColorRow[];
  } catch (e) {
    console.error('[contract preview] project_colors query failed (table missing?):', e);
  }
}

// Parse a User-Agent into a friendly browser + OS string so the audit
// block can show "Chrome on macOS" instead of the full UA blob.
function parseUserAgent(ua: string | null | undefined): string {
  if (!ua) return 'Unknown device';
  let browser = 'Browser';
  if (/Edg\//.test(ua)) browser = 'Edge';
  else if (/Chrome\//.test(ua) && !/Edg\//.test(ua) && !/OPR\//.test(ua)) browser = 'Chrome';
  else if (/Firefox\//.test(ua)) browser = 'Firefox';
  else if (/Safari\//.test(ua) && !/Chrome\//.test(ua)) browser = 'Safari';
  let os = 'Unknown OS';
  if (/iPhone|iPad|iPod/.test(ua)) os = 'iOS';
  else if (/Mac OS X/.test(ua)) os = 'macOS';
  else if (/Android/.test(ua)) os = 'Android';
  else if (/Windows/.test(ua)) os = 'Windows';
  else if (/Linux/.test(ua)) os = 'Linux';
  return `${browser} on ${os}`;
}
function fmtFullDateTime(s: string | null | undefined): string {
  if (!s) return '—';
  try {
    // Server stores 'YYYY-MM-DD HH:MM:SS' in UTC; render in a readable way.
    const trimmed = String(s).replace(' ', 'T') + 'Z';
    const d = new Date(trimmed);
    if (isNaN(d.getTime())) return String(s);
    return d.toLocaleString('en-US', {
      month: 'long', day: 'numeric', year: 'numeric',
      hour: 'numeric', minute: '2-digit', timeZoneName: 'short',
    });
  } catch { return String(s); }
}
let paymentSchedule: Array<{ id: string; kind: 'down' | 'monthly'; label: string; amount: number; due_date: string }> = [];
try { paymentSchedule = JSON.parse(row.payment_schedule || '[]'); } catch {}
let terms: any = {};
try { terms = JSON.parse(row.terms || '{}'); } catch {}

// Starred project photos (same as the public contract + PDF).
let contractPhotos: Array<{ url: string; isVideo: boolean }> = [];
if (row.project_id) {
  try {
    const ph = await db.prepare(`
      SELECT image_url, stream_uid, poster_url FROM project_updates
      WHERE project_id = ? AND COALESCE(is_starred, 0) = 1 AND image_url IS NOT NULL
      ORDER BY created_at ASC
    `).bind(row.project_id).all();
    contractPhotos = (ph.results || []).map((r: any) => {
      const isVideo = !!r.stream_uid || /\.(mp4|mov|webm|m4v)(?:\?|$)/i.test(r.image_url || '');
      let url = r.image_url;
      if (isVideo) url = (r.stream_uid ? streamThumb(r.stream_uid, '1s', env) : '') || r.poster_url || r.image_url;
      else { try { const u = new URL(r.image_url); url = `${u.origin}/cdn-cgi/image/width=800,quality=80,format=auto${u.pathname}`; } catch {} }
      return { url, isVideo };
    });
  } catch (e) { console.error('[admin contract preview] starred photos query failed', e); }
}

const total = Number(row.total) || 0;
const discount = Number(row.discount) || 0;
const downRows = paymentSchedule.filter(r => r.kind === 'down');
const monthlyRows = paymentSchedule.filter(r => r.kind === 'monthly');
const downSum = downRows.reduce((s, r) => s + (Number(r.amount) || 0), 0);
const monthlyAmount = monthlyRows[0]?.amount || 0;
// scheduleTotal sums every row (correct under either plan); balanceSum is
// everything that isn't the down payment.
const scheduleTotal = paymentSchedule.reduce((s, r) => s + (Number(r.amount) || 0), 0);
const balanceSum = +(scheduleTotal - downSum).toFixed(2);
const isMonthlyPlan = monthlyRows.length > 0;

const servicesLabel = formatServices(row.services);
const fullAddress = [row.customer_address, row.customer_city, [row.customer_state, row.customer_zip].filter(Boolean).join(' ')].filter(Boolean).join(', ');
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Contract: {row.project_number}: {brand.name}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="robots" content="noindex, nofollow" />
    <style>
      html {
        -webkit-text-size-adjust: 100%;
        text-size-adjust: 100%;
        font-size: 14px;
      }
      body {
        margin: 0;
        background: #fafafa;
        color: #1f2937;
        font-family: Georgia, 'Times New Roman', Times, serif;
        font-size: 14px;
        line-height: 1.5;
      }
      .toolbar {
        position: sticky; top: 0; z-index: 10;
        background: #0a0b0d; color: #fff;
        padding: 10px 18px;
        display: flex; justify-content: space-between; align-items: center;
        font-family: -apple-system, BlinkMacSystemFont, sans-serif;
        font-size: 13px;
        flex-wrap: wrap; gap: 8px;
      }
      .toolbar a { color: #93c5fd; text-decoration: none; }
      .toolbar a:hover { text-decoration: underline; }
      .toolbar button {
        padding: 8px 16px;
        background: linear-gradient(135deg, #0071e3, #e05f00);
        color: #fff;
        border: none;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        font-family: inherit;
      }
      .doc-page {
        max-width: 760px;
        margin: 24px auto;
        background: #fff;
        padding: 40px 48px;
        box-shadow: 0 12px 40px rgba(10, 11, 13, 0.15);
        color: #1f2937;
      }
      .doc-header {
        display: flex; justify-content: space-between; align-items: flex-start;
        gap: 20px;
        border-bottom: 2px solid #0a0b0d;
        padding-bottom: 16px;
        margin-bottom: 20px;
      }
      .doc-header .subtitle {
        font-size: 12px; color: #71717a; text-transform: uppercase; letter-spacing: 1px;
      }
      .contact-block { text-align: right; font-size: 12px; color: #374151; line-height: 1.55; }
      .contact-block strong { color: #111827; }

      .info-block {
        background: #fafafa;
        border: 1px solid #f4f4f5;
        border-radius: 6px;
        padding: 14px 18px;
        margin-bottom: 24px;
        font-size: 13px;
        line-height: 1.7;
      }
      .info-row { display: grid; grid-template-columns: 130px 1fr; gap: 8px; }
      .info-row .label {
        font-size: 11px; font-weight: 700;
        text-transform: uppercase; letter-spacing: 0.5px;
        color: #71717a; padding-top: 2px;
      }
      .info-row .value { color: #111827; }

      h2.section-h { font-size: 16px; font-weight: 700; color: #0a0b0d; margin: 28px 0 12px; border-bottom: 1px solid #cbd5e1; padding-bottom: 4px; }
      .contract-photos { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 8px; margin-bottom: 16px; }
      .contract-photo { position: relative; aspect-ratio: 4/3; border-radius: 8px; overflow: hidden; background: #151619; border: 1px solid #cbd5e1; }
      .contract-photo img { width: 100%; height: 100%; object-fit: cover; display: block; }
      .contract-photo-badge { position: absolute; bottom: 4px; left: 4px; background: rgba(0,0,0,0.7); color: #fff; font-size: 10px; font-weight: 600; padding: 1px 5px; border-radius: 4px; text-transform: uppercase; }

      .pay-table {
        width: 100%; border-collapse: collapse; font-size: 13px;
        margin: 12px 0 18px;
      }
      .pay-table th, .pay-table td {
        padding: 8px 10px;
        border-bottom: 1px solid #e5e7eb;
        text-align: left;
      }
      .pay-table th {
        background: #fafafa;
        font-size: 11px; font-weight: 700;
        text-transform: uppercase; letter-spacing: 0.5px;
        color: #71717a;
      }
      .pay-table td.amount { text-align: right; font-weight: 700; }
      .pay-table tr.total td {
        background: #fef9c3;
        font-weight: 700;
        border-top: 2px solid #0a0b0d;
      }

      .sig-block {
        margin: 28px 0 16px;
        padding: 16px;
        background: #fafafa;
        border: 1px solid #f4f4f5;
        border-radius: 6px;
      }
      .sig-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 24px;
        margin-top: 18px;
      }
      .sig-line {
        border-bottom: 1px solid #a1a1aa;
        height: 28px;
        margin-bottom: 4px;
      }
      .sig-caption { font-size: 11px; color: #71717a; text-transform: uppercase; letter-spacing: 0.5px; }

      .term-block {
        margin: 14px 0;
        padding: 10px 14px;
        background: #fafafa;
        border-left: 4px solid #cbd5e1;
        font-size: 12px; line-height: 1.6;
      }

      .grand-total-row {
        display: flex; justify-content: space-between; align-items: baseline;
        padding: 14px 0;
        border-top: 2px solid #0a0b0d;
        border-bottom: 2px solid #0a0b0d;
        margin: 24px 0;
        font-size: 16px; font-weight: 700;
      }
      .grand-total-row .amount {
        font-size: 22px; color: #0a0b0d;
      }

      .footnote {
        font-size: 11px;
        color: #a1a1aa;
        text-align: center;
        margin-top: 30px;
      }

      @media print {
        body { background: #fff; }
        .toolbar { display: none; }
        .doc-page { box-shadow: none; margin: 0; padding: 20px 18px; max-width: 100%; }
        * { -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; }
      }
    </style>
  </head>
  <body>
    <div class="toolbar">
      <div>
        <a href={`/admin/projects/${projectId}/contract/`}>← Back to contract</a>
        <span style="margin-left: 10px; opacity: 0.7;">Contract preview · {row.project_number}</span>
      </div>
      <div style="display:flex; gap:8px;">
        <button onclick="window.print()">Print / Save as PDF</button>
      </div>
    </div>

    <div class="doc-page">
      <div class="doc-header">
        <div>
          {brand.isPartner && brand.logoUrl && (
            <img src={brand.logoUrl} alt={brand.name} style="display:block; margin-bottom:6px; max-width:240px; max-height:64px; height:auto;" />
          )}
          {brand.isPartner && !brand.logoUrl && (
            <div style="font-size:30px; font-weight:800; color:#1c2b3e; margin-bottom:6px;">{brand.name}</div>
          )}
          {!brand.isPartner && (
          <svg viewBox="0 0 250 48" width="200" height="38" style="display:block; margin-bottom:6px;" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="MannyKnows"><text x="0" y="35" font-family="-apple-system, 'Segoe UI', Helvetica, Arial, sans-serif" font-size="31" font-weight="800" letter-spacing="-0.5" fill="#0f1219">MannyKnows</text></svg>
          )}
          <div class="subtitle">Home Improvement Contract</div>
          <div style="font-size:12px; color:#71717a; margin-top:8px;">Date: <strong style="color:#111827;">{today}</strong></div>
          <div style="font-size:12px; color:#71717a;">Contract #: <strong style="color:#111827;">{row.project_number}</strong></div>
        </div>
        <div class="contact-block">
          {brand.isPartner ? (
            <Fragment>
              {brand.phoneDisplay && <div><strong>Phone:</strong> {brand.phoneDisplay}</div>}
              {brand.contactEmail && <div><strong>Email:</strong> {brand.contactEmail}</div>}
              {brand.websiteLabel && <div><strong>Website:</strong> {brand.websiteLabel}</div>}
              {brand.addressLines.length > 0 && <div>{brand.addressLines.join(', ')}</div>}
            </Fragment>
          ) : (
            <Fragment>
              {COMPANY_HEADER.licenseNumber && <div><strong>{COMPANY_HEADER.licenseLabel} #:</strong> {COMPANY_HEADER.licenseNumber}</div>}
              <div><strong>Contact:</strong> {COMPANY_HEADER.contactName}</div>
              <div><strong>Phone:</strong> {COMPANY_HEADER.phone}</div>
              <div><strong>Email:</strong> {COMPANY_HEADER.email}</div>
              <div><strong>Website:</strong> {COMPANY_HEADER.website.replace(/^https?:\/\//, '')}</div>
            </Fragment>
          )}
        </div>
      </div>

      <div class="info-block">
        <div class="info-row">
          <span class="label">Customer</span>
          <span class="value">{row.customer_name || ''}</span>
        </div>
        {row.customer_phone && (
          <div class="info-row">
            <span class="label">Phone</span>
            <span class="value">{row.customer_phone}</span>
          </div>
        )}
        {row.customer_email && (
          <div class="info-row">
            <span class="label">Email</span>
            <span class="value">{row.customer_email}</span>
          </div>
        )}
        <div class="info-row">
          <span class="label">Work site</span>
          <span class="value">{fullAddress}</span>
        </div>
        {servicesLabel && (
          <div class="info-row">
            <span class="label">Work type</span>
            <span class="value">{servicesLabel}</span>
          </div>
        )}
        <div class="info-row">
          <span class="label">Start date</span>
          <span class="value">{fmtDate(row.start_date || row.scheduled_start)}</span>
        </div>
      </div>

      <div set:html={scopesHtml}></div>

      {contractPhotos.length > 0 && (
        <>
          <h2 class="section-h">Project Photos</h2>
          <div class="contract-photos">
            {contractPhotos.map((p) => (
              <div class="contract-photo">
                <img src={p.url} alt="Project photo" loading="lazy" />
                {p.isVideo && <span class="contract-photo-badge">Video</span>}
              </div>
            ))}
          </div>
        </>
      )}

      <div class="grand-total-row">
        <span>Total: labor and materials</span>
        <span class="amount">{fmtMoney(total)}</span>
      </div>
      {discount > 0 && (
        <div style="font-size:12px; color:#71717a; text-align:right; margin-top:-18px; margin-bottom:18px;">
          Includes discount of {fmtMoney(discount)}
        </div>
      )}

      {colorSelections.length > 0 && (
        <>
          <h2 class="section-h">Color Selections</h2>
          <table class="pay-table">
            <thead>
              <tr>
                <th>Area</th>
                <th style="width:90px;">Type</th>
                <th style="width:150px;">Color</th>
                <th style="width:110px;">Finish</th>
                <th>Notes</th>
              </tr>
            </thead>
            <tbody>
              {colorSelections.map((c) => (
                <tr>
                  <td>{c.label || '—'}</td>
                  <td style="text-transform:capitalize;">{c.product_type || '—'}</td>
                  <td style="font-weight:600;">{c.color_value || '—'}</td>
                  <td>{c.finish || '—'}</td>
                  <td style="font-size:11px; color:#71717a;">{c.note || ''}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </>
      )}

      <h2 class="section-h">Payment Schedule</h2>
      <p style="font-size:12px; color:#71717a; margin:0 0 8px;">
        {row.down_payment_percent}% down split into {row.down_payment_count} payment{row.down_payment_count === 1 ? '' : 's'},
        {isMonthlyPlan
          ? ` with the balance divided into ${row.monthly_payment_count} monthly payment${row.monthly_payment_count === 1 ? '' : 's'} starting after job completion.`
          : ' with the remaining balance due on completion.'}
      </p>

      <table class="pay-table">
        <thead>
          <tr>
            <th style="width: 100px;">Kind</th>
            <th>Label</th>
            <th style="width: 130px;">Due date</th>
            <th style="width: 120px; text-align:right;">Amount</th>
            <th style="width: 180px;">Signatures</th>
          </tr>
        </thead>
        <tbody>
          {paymentSchedule.map((r) => {
            const rec = receiptByRow[r.id];
            return (
            <tr>
              <td style="text-transform: capitalize; font-size:12px; color:#71717a;">{r.kind}</td>
              <td>{r.label}</td>
              <td>{fmtDate(r.due_date)}</td>
              <td class="amount">{fmtMoney(r.amount)}</td>
              {rec ? (
                <td style="font-size:9px; color:#71717a;">
                  <div style="display:flex; gap:10px; align-items:flex-end;">
                    <div style="flex:1; min-width:0;">
                      {rec.customer_signature_data_url && (
                        <img src={rec.customer_signature_data_url} alt="Client signature" style="display:block; max-height:26px; max-width:100%;" />
                      )}
                      <div style="border-top:1px solid #a1a1aa; padding-top:2px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">Client{rec.customer_name ? `, ${rec.customer_name}` : ''}</div>
                    </div>
                    <div style="flex:1; min-width:0;">
                      {rec.contractor_signature_data_url && (
                        <img src={rec.contractor_signature_data_url} alt="MannyKnows signature" style="display:block; max-height:26px; max-width:100%;" />
                      )}
                      <div style="border-top:1px solid #a1a1aa; padding-top:2px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">Contractor</div>
                    </div>
                  </div>
                  <div style="margin-top:2px; color:#16a34a; font-weight:700;">
                    PAID {rec.collected_at ? fmtDate(rec.collected_at) : ''}{rec.payment_method ? ` · ${rec.payment_method}` : ''}{rec.check_number ? ` #${rec.check_number}` : ''}
                  </div>
                </td>
              ) : (
                <td style="font-size:10px; color:#a1a1aa;">Client _______ / MannyKnows _______</td>
              )}
            </tr>
            );
          })}
          {paymentSchedule.length > 0 && (
            <tr class="total">
              <td colspan="3">TOTAL</td>
              <td class="amount">{fmtMoney(scheduleTotal)}</td>
              <td></td>
            </tr>
          )}
        </tbody>
      </table>

      <div style={`display: grid; grid-template-columns: ${isMonthlyPlan ? '1fr 1fr 1fr' : '1fr 1fr'}; gap: 16px; margin: 12px 0 22px;`}>
        <div>
          <div style="font-size:11px; text-transform:uppercase; letter-spacing:0.5px; color:#71717a; font-weight:700;">Total down</div>
          <div style="font-size:18px; font-weight:700;">{fmtMoney(downSum)}</div>
        </div>
        <div>
          <div style="font-size:11px; text-transform:uppercase; letter-spacing:0.5px; color:#71717a; font-weight:700;">Balance</div>
          <div style="font-size:18px; font-weight:700;">{fmtMoney(balanceSum)}</div>
        </div>
        {isMonthlyPlan && (
          <div>
            <div style="font-size:11px; text-transform:uppercase; letter-spacing:0.5px; color:#71717a; font-weight:700;">Each monthly</div>
            <div style="font-size:18px; font-weight:700;">{fmtMoney(monthlyAmount)}</div>
          </div>
        )}
      </div>

      <h2 class="section-h">Terms</h2>
      <div class="term-block">
        <strong>Cancellation:</strong> Client may cancel within {row.cancellation_window_days} business day{row.cancellation_window_days === 1 ? '' : 's'} of kickoff for a full refund of everything paid, the setup fee included. After that window, setup fees and prepaid annual fees are non-refundable{row.cancellation_fee_amount > 0 ? ` and a ${fmtMoney(row.cancellation_fee_amount)} cancellation fee applies` : ''}. On monthly billing there is no minimum term: cancel anytime, effective at the end of the billing month.
      </div>
      <div class="term-block">
        <strong>Late payments:</strong> Any invoice not received within {row.late_fee_grace_days} business day{row.late_fee_grace_days === 1 ? '' : 's'} of the due date is late{row.late_fee_amount > 0 ? ` and a ${fmtMoney(row.late_fee_amount)} late fee applies` : ''}; overdue amounts accrue interest at 1.5% per month (18% per year) or the maximum rate the law permits, whichever is lower.
      </div>
      {row.warranty_months > 0 && (
        <div class="term-block">
          <strong>Service guarantee:</strong> {row.warranty_months} months from delivery. Covers defects in the work we built; excludes third-party services, client-made changes, and issues outside our control.
        </div>
      )}
      {terms.marketing_release?.enabled && terms.marketing_release.text && (
        <div class="term-block">
          <strong>Marketing release:</strong> {terms.marketing_release.text}
        </div>
      )}
      {Array.isArray(terms.custom_terms) && terms.custom_terms.length > 0 && terms.custom_terms.map((ct: any) => (
        ct?.text ? (
          <div class="term-block">
            {ct.title && <><strong>{ct.title}:</strong>{' '}</>}{ct.text}
          </div>
        ) : null
      ))}

      <h2 class="section-h">Signatures</h2>
      <div class="sig-block">
        <div class="sig-row">
          <div>
            {customerSig ? (
              <>
                <img src={customerSig.signature_data_url} alt={`Signature by ${customerSig.signer_name}`} style="display:block; max-height:80px; max-width:100%; margin-bottom: 4px;" />
                <div class="sig-caption" style="border-top:1px solid #a1a1aa; padding-top:4px;">Customer signature &mdash; {customerSig.signer_name}</div>
              </>
            ) : (
              <>
                <div class="sig-line"></div>
                <div class="sig-caption">Customer signature</div>
              </>
            )}
          </div>
          <div>
            {contractorSig ? (
              <>
                <img src={contractorSig.signature_data_url} alt={`Signature by ${contractorSig.signer_name}`} style="display:block; max-height:80px; max-width:100%; margin-bottom: 4px;" />
                <div class="sig-caption" style="border-top:1px solid #a1a1aa; padding-top:4px;">MannyKnows signature &mdash; {contractorSig.signer_name}</div>
              </>
            ) : (
              <>
                <div class="sig-line"></div>
                <div class="sig-caption">MannyKnows signature</div>
              </>
            )}
          </div>
        </div>
        <div class="sig-row" style="margin-top: 14px;">
          <div>
            {customerSig ? (
              <div class="sig-caption" style="border-bottom:1px solid #a1a1aa; padding-bottom:4px;">
                {customerSig.signer_name} &middot; {fmtDate(customerSig.signed_at)}
              </div>
            ) : (
              <div class="sig-line"></div>
            )}
            <div class="sig-caption" style="margin-top:4px;">Printed name / date</div>
          </div>
          <div>
            {contractorSig ? (
              <div class="sig-caption" style="border-bottom:1px solid #a1a1aa; padding-bottom:4px;">
                {contractorSig.signer_name} &middot; {fmtDate(contractorSig.signed_at)}
              </div>
            ) : (
              <div class="sig-line"></div>
            )}
            <div class="sig-caption" style="margin-top:4px;">Printed name / date</div>
          </div>
        </div>
      </div>

      {customerSig && (
        <div style="margin-top: 22px; padding: 14px 16px; background: #fafafa; border: 1px solid #f4f4f5; border-radius: 6px; font-size: 11px; line-height: 1.6; color: #71717a;">
          <div style="font-weight: 700; color: #0a0b0d; font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 8px;">Signature Audit Trail</div>
          <div style="display: grid; grid-template-columns: 130px 1fr; gap: 4px 12px;">
            <div>Signed by</div><div><strong style="color:#0a0b0d;">{customerSig.signer_name}</strong></div>
            <div>Date &amp; time</div><div>{fmtFullDateTime(customerSig.signed_at)}</div>
            {customerSig.ip_address && (<><div>IP address</div><div>{customerSig.ip_address}</div></>)}
            {customerSig.user_agent && (<><div>Device</div><div>{parseUserAgent(customerSig.user_agent)}</div></>)}
            <div>Contract</div><div>#{row.project_number}</div>
            {customerSig.consent_text && (<><div>Consent</div><div style="font-style: italic;">{customerSig.consent_text}</div></>)}
          </div>
          <div style="margin-top: 10px; padding-top: 8px; border-top: 1px dashed #cbd5e1; font-size: 10px; color: #a1a1aa;">
            Recorded under the ESIGN Act (15 U.S.C. § 7001 et seq.) and Massachusetts UETA.
          </div>
        </div>
      )}

      {terms.reference_request?.enabled && (
        <div style="margin: 24px 0; padding: 14px; background: #fafafa; border: 1px solid #f4f4f5; border-radius: 6px; font-size: 13px;">
          {terms.reference_request.text || 'Can we use you as a reference?'}
          {row.use_as_reference == null
            ? (<span style="margin-left: 20px;">YES _____ NO _____</span>)
            : (<span style="margin-left: 20px; font-weight: 700;">{row.use_as_reference ? 'YES ✓' : 'NO ✓'}</span>)}
        </div>
      )}

      <div class="footnote">{brand.name}{brand.phoneDisplay ? ` · ${brand.phoneDisplay}` : ''}{brand.contactEmail ? ` · ${brand.contactEmail}` : ''}</div>
    </div>

    {/* Autosave bridge: when the page loads with ?autosave=1, generate the
        signed contract PDF via html2pdf and POST it to the new
        /api/projects/contract/signed-pdf endpoint. The customer-side
        signing page (/project/contract/[token]) opens this preview in a
        hidden iframe with ?token=...&autosave=1 so the customer's browser
        does the rendering work, no headless-browser tooling needed in
        our Workers. Admin-side backfill goes through the same iframe but
        without the token. */}
    <script
      is:inline
      data-project-id={String(projectId)}
      data-contract-token={row.contract_token || ''}
      id="autosaveScript"
    >
      (function () {
        var script = document.getElementById('autosaveScript');
        var projectId = script ? script.dataset.projectId : '';
        var contractToken = script ? (script.dataset.contractToken || '') : '';
        var params = new URLSearchParams(window.location.search);
        if (params.get('autosave') !== '1') return;

        function loadHtml2Pdf() {
          if (window.html2pdf) return Promise.resolve(window.html2pdf);
          return new Promise(function (resolve, reject) {
            var s = document.createElement('script');
            s.src = 'https://unpkg.com/html2pdf.js@0.10.1/dist/html2pdf.bundle.min.js';
            s.onload = function () { resolve(window.html2pdf); };
            s.onerror = function () { reject(new Error('Failed to load html2pdf.js')); };
            document.head.appendChild(s);
          });
        }

        async function waitForImagesLoaded(root) {
          var imgs = Array.from(root.querySelectorAll('img'));
          await Promise.all(imgs.map(function (img) {
            if (img.complete && img.naturalWidth > 0) return Promise.resolve();
            return new Promise(function (resolve) {
              img.addEventListener('load', resolve, { once: true });
              img.addEventListener('error', resolve, { once: true });
              // Hard cap so a stalled image doesn't block forever.
              setTimeout(resolve, 6000);
            });
          }));
        }

        function postBack(payload) {
          try { window.parent.postMessage(payload, window.location.origin); } catch (_) {}
        }

        async function run() {
          try {
            var html2pdf = await loadHtml2Pdf();
            var target = document.querySelector('.doc-page');
            if (!target) throw new Error('Preview not found');
            await waitForImagesLoaded(target);
            // Wait for fonts + flush two paint frames before snapshot — fixes
            // intermittent "saved PDF missing parts / clipped text" captures.
            try { if (document.fonts && document.fonts.ready) await document.fonts.ready; } catch (e) {}
            await new Promise(function(r){ requestAnimationFrame(function(){ requestAnimationFrame(r); }); });
            var blob = await html2pdf()
              .from(target)
              .set({
                margin: [0.4, 0.4, 0.5, 0.4],
                filename: 'contract-' + projectId + '-signed.pdf',
                image: { type: 'jpeg', quality: 0.92 },
                // windowWidth pins the layout viewport so the .doc-page always
                // renders at its full 760px max-width. Without it, generation
                // inside the hidden signing iframe lays out narrower, which
                // html2pdf then scales UP — making the signed PDF's font bigger
                // than the quote PDF (generated in a wide window). 900 ≈ the
                // iframe width and matches how the quote preview renders.
                html2canvas: { scale: 2, useCORS: true, allowTaint: false, backgroundColor: '#ffffff', windowWidth: 900 },
                jsPDF: { unit: 'in', format: 'letter', orientation: 'portrait' },
                pagebreak: { mode: ['avoid-all', 'css', 'legacy'] },
              })
              .output('blob');

            var headers = { 'Content-Type': 'application/pdf' };
            // Customer-side: thread the token through. Admin-side loads
            // without a token; session cookie handles auth.
            if (contractToken) headers['X-Contract-Token'] = contractToken;

            var res = await fetch('/api/projects/contract/signed-pdf/?project_id=' + projectId, {
              method: 'POST',
              credentials: 'include',
              headers: headers,
              body: blob,
            });
            var data = await res.json().catch(function () { return null; });
            if (!res.ok || (data && data.success === false)) {
              throw new Error((data && data.error) || ('Upload failed (' + res.status + ')'));
            }
            postBack({
              type: 'sl-contract-signed-pdf-saved',
              projectId: Number(projectId),
              signed_pdf_url: data && data.signed_pdf_url,
            });
          } catch (err) {
            console.error('[contract autosave]', err);
            postBack({
              type: 'sl-contract-signed-pdf-failed',
              projectId: Number(projectId),
              error: (err && err.message) || 'PDF generation failed',
            });
          }
        }

        // Defer one tick so layout settles before html2canvas measures.
        setTimeout(run, 150);
      })();
    </script>
  </body>
</html>
