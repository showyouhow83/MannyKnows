---
// Admin Dashboard - Glassmorphic UI
import { env as cfEnv } from 'cloudflare:workers';
import { AdminAuth } from '../../lib/adminAuth';
import AdminNav from '../../components/AdminNav.astro';
import AdminMobileDrawer from '../../components/AdminMobileDrawer.astro';
import AdminPresence from '../../components/AdminPresence.astro';
import '../../styles/admin.css';

const env = cfEnv;
const sessionSecret = env?.SESSION_SECRET || env?.ADMIN_PASSWORD;
const session = await AdminAuth.validateSession(Astro.request, sessionSecret);

if (!session.isAuthenticated) {
  return Astro.redirect('/admin');
}
if (session.role === 'viewer') {
  return Astro.redirect('/admin/portfolios');
}

// Get database connection
const db = env?.MK_APP_DB;

// Fetch counts from database
let leadCounts = { pending_confirmation: 0, confirmed: 0, promoted: 0, won: 0, failed: 0 };
let quoteCounts = { draft: 0, sent: 0, accepted: 0, declined: 0, project: 0, cold: 0 };
let projectCounts = { needs_crew: 0, ready_to_start: 0, in_progress: 0, completed: 0, portfolio: 0 };
let crewCounts = { active: 0, inactive: 0 };
let totalContacts = 0;

if (db) {
  try {
    // Get lead counts by status. Mirror the Leads page exactly: a lead that has
    // been promoted to a quote is NO LONGER an actionable lead, so exclude any
    // lead flagged 'promoted' OR carrying a linked quote (the status flag is
    // sometimes never flipped, which previously left the dashboard counting a
    // lead the Leads page had already hidden).
    const leadResults = await db.prepare(`
      SELECT status, COUNT(*) as count
        FROM leads
       WHERE COALESCE(status, '') != 'promoted'
         AND id NOT IN (SELECT lead_id FROM quotes WHERE lead_id IS NOT NULL)
       GROUP BY status
    `).all();
    for (const row of (leadResults?.results || []) as Array<{ status: string; count: number }>) {
      if (row.status && row.status in leadCounts) {
        leadCounts[row.status as keyof typeof leadCounts] = row.count;
      }
    }

    // Get quote counts by status
    const quoteResults = await db.prepare(`
      SELECT status, COUNT(*) as count FROM quotes GROUP BY status
    `).all();
    for (const row of (quoteResults?.results || []) as Array<{ status: string; count: number }>) {
      if (row.status && row.status in quoteCounts) {
        quoteCounts[row.status as keyof typeof quoteCounts] = row.count;
      }
    }

    // Get project counts by status, splitting needs_crew by crew assignment
    const projectResults = await db.prepare(`
      SELECT CASE WHEN status = 'needs_crew' AND crew_lead_id IS NOT NULL THEN 'ready_to_start'
                  ELSE status END as effective_status,
             COUNT(*) as count
      FROM projects
      GROUP BY effective_status
    `).all();
    for (const row of (projectResults?.results || []) as Array<{ effective_status: string; count: number }>) {
      if (row.effective_status && row.effective_status in projectCounts) {
        projectCounts[row.effective_status as keyof typeof projectCounts] = row.count;
      }
    }

    // Get crew lead counts by active status
    const crewResults = await db.prepare(`
      SELECT active, COUNT(*) as count FROM crew_leads GROUP BY active
    `).all();
    for (const row of (crewResults?.results || []) as Array<{ active: number; count: number }>) {
      if (row.active === 1) {
        crewCounts.active = row.count;
      } else {
        crewCounts.inactive = row.count;
      }
    }
    // Get contacts count
    try {
      const tableCheck = await db.prepare("SELECT name FROM sqlite_master WHERE type='table' AND name='contacts'").all();
      if (tableCheck.results?.length > 0) {
        const contactResult = await db.prepare('SELECT COUNT(*) as count FROM contacts').first();
        totalContacts = (contactResult as any)?.count || 0;
      }
    } catch {}
  } catch (error) {
    console.error('Dashboard data fetch error:', error);
  }
}

// Calculate totals (only actionable items - promoted/won leads are tracked in Quotes/Projects)
const totalLeads = leadCounts.pending_confirmation + leadCounts.confirmed;
const totalQuotes = quoteCounts.draft + quoteCounts.sent + quoteCounts.accepted + quoteCounts.declined;
const totalProjects = projectCounts.needs_crew + projectCounts.ready_to_start + projectCounts.in_progress + projectCounts.completed;
const totalCrew = crewCounts.active;

// ── Upcoming projects (dashboard widget — links to full /admin/calendar) ──
interface UpcomingProject {
  id: number;
  project_number: string;
  customer_name: string;
  status: string;
  crew_lead_id: number | null;
  scheduled_start: string | null;
  scheduled_end: string | null;
}
let upcomingProjects: UpcomingProject[] = [];
if (db) {
  try {
    const r = await db.prepare(`
      SELECT id, project_number, customer_name, status, crew_lead_id, scheduled_start, scheduled_end
        FROM projects
       WHERE scheduled_start IS NOT NULL
         AND status IN ('needs_crew', 'in_progress')
         AND date(scheduled_end) >= date('now', '-1 day')
       ORDER BY date(scheduled_start) ASC, id ASC
       LIMIT 6
    `).all();
    upcomingProjects = ((r?.results || []) as unknown) as UpcomingProject[];
  } catch (err) {
    console.error('Dashboard upcoming-projects fetch error:', err);
  }
}

// Effective status mirrors the calendar + admin-projects logic — a project
// with a crew assigned is "Ready to start" even if the raw status field is
// still 'needs_crew' (it doesn't auto-bump until admin clicks Start Project).
const effectiveStatus = (p: UpcomingProject): string =>
  p.status === 'needs_crew' && p.crew_lead_id ? 'ready_to_start' : p.status;

const statusBadge = (s: string) => {
  if (s === 'in_progress')    return { label: 'In Progress',    bg: 'rgba(34,197,94,0.18)',  color: '#4ade80' };
  if (s === 'ready_to_start') return { label: 'Ready to Start', bg: 'rgba(59,130,246,0.18)', color: '#60a5fa' };
  if (s === 'needs_crew')     return { label: 'Needs Crew',     bg: 'rgba(245,158,11,0.18)', color: '#fbbf24' };
  return { label: s, bg: 'rgba(255,255,255,0.08)', color: 'var(--color-text-secondary)' };
};

function fmtRange(start: string | null, end: string | null): string {
  if (!start) return '';
  const fmt = (s: string) => new Date(s + 'T12:00:00Z').toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' });
  if (!end || end === start) return fmt(start);
  return `${fmt(start)} → ${fmt(end)}`;
}
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard | MannyKnows Admin</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <meta name="robots" content="noindex, nofollow">
  <script>
    // Theme init - runs before CSS to prevent flash
    (function() {
      const theme = localStorage.getItem('admin-theme') || 'dark';
      document.documentElement.setAttribute('data-theme', theme);
    })();
  </script>
  <style>
    /* Dashboard-specific styles — HeroUI pass (Aug 2026).
       Anatomy, spacing, and states come from the admin.css token system;
       this block only holds what is unique to the dashboard. All element
       IDs and JS-injected class names are unchanged (behavior contract). */

    /* Page title keeps the wordmark gradient — the dashboard is the front door */
    .page-title {
      background: linear-gradient(90deg, #a78bfa 0%, #e879f9 50%, #f472b6 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    /* ── Quick Stats — HeroUI stat tiles ─────────────────────────────── */
    .quick-stats {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 16px;
      margin-bottom: 24px;
    }

    .quick-stat {
      text-align: center;
      padding: 20px;
      background: var(--surface);
      border-radius: var(--radius-lg);
      border: 1px solid var(--border);
      transition: background-color 150ms var(--ease-out), border-color 150ms var(--ease-out);
      text-decoration: none;
      color: inherit;
      display: block;
      cursor: pointer;
    }

    .quick-stat:hover {
      background: var(--surface-secondary);
      border-color: color-mix(in oklab, var(--accent) 35%, transparent);
    }

    .quick-stat-value {
      font-size: 30px;
      line-height: 1.2;
      font-weight: 800;
      background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-secondary) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .quick-stat-label {
      font-size: 11px;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 1px;
      margin-top: 6px;
      font-weight: 600;
    }

    /* ── Client Search — the command bar ─────────────────────────────── */
    .client-search {
      margin-bottom: 24px;
      position: relative;
    }
    .search-input-wrap {
      position: relative;
      display: flex;
      align-items: center;
    }
    .search-icon {
      position: absolute;
      left: 16px;
      color: var(--muted);
      pointer-events: none;
      flex-shrink: 0;
    }
    .search-input {
      width: 100%;
      background-color: var(--field-background);
      border: 1px solid var(--field-border);
      border-radius: 9999px;
      padding: 12px 90px 12px 44px;
      font-size: 14px;
      color: var(--foreground);
      outline: none;
      transition: background-color 150ms var(--ease-smooth), border-color 150ms var(--ease-smooth), box-shadow 150ms var(--ease-out);
      -webkit-appearance: none;
      appearance: none;
      font-family: inherit;
    }
    .search-input::placeholder { color: var(--field-placeholder); opacity: 1; }
    .search-input:hover:not(:focus) { background-color: var(--field-hover); }
    .search-input:focus {
      border-color: var(--accent);
      box-shadow: 0 0 0 3px var(--accent-soft);
      background-color: var(--field-focus);
    }
    .search-shortcut {
      position: absolute;
      right: 16px;
      font-size: 11px;
      color: var(--muted);
      background: var(--default);
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 2px 6px;
      pointer-events: none;
      font-family: monospace;
      letter-spacing: 0.5px;
    }
    .search-clear {
      position: absolute;
      right: 70px;
      background: none;
      border: none;
      color: var(--muted);
      font-size: 18px;
      cursor: pointer;
      padding: 0 6px;
      line-height: 1;
    }
    .search-clear:hover { color: var(--foreground); }
    .search-filters {
      display: flex;
      gap: 6px;
      margin-top: 10px;
    }
    /* Filter chips — HeroUI chip anatomy */
    .search-filter {
      padding: 4px 14px;
      border-radius: 9999px;
      border: 1px solid var(--border);
      background: var(--surface);
      color: var(--muted);
      font-size: 12px;
      font-weight: 500;
      cursor: pointer;
      transition: background-color 100ms var(--ease-out), color 100ms var(--ease-out), border-color 100ms var(--ease-out);
    }
    .search-filter:hover { background: var(--default); color: var(--foreground); }
    .search-filter.active {
      background: var(--accent);
      border-color: var(--accent);
      color: var(--accent-foreground);
    }
    .search-results {
      margin-top: 8px;
      background: var(--overlay);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      box-shadow: var(--overlay-shadow);
      overflow: hidden;
      max-height: 400px;
      overflow-y: auto;
    }
  </style>

  <style is:global>
    /* Search results are injected via innerHTML: must be global to apply.
       Each row has two click targets: the Contact (left) and the live
       record (right). Class names are the JS contract — do not rename. */
    .search-result-item {
      display: flex;
      align-items: stretch;
      border-bottom: 1px solid var(--separator);
    }
    .search-result-item:last-child { border-bottom: none; }
    .sr-main {
      flex: 1;
      min-width: 0;
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 10px 16px;
      text-decoration: none;
      color: var(--foreground);
      transition: background-color 100ms var(--ease-out);
    }
    .sr-main:hover { background: var(--default); }
    .sr-record {
      flex-shrink: 0;
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 10px 16px;
      text-decoration: none;
      color: var(--foreground);
      border-left: 1px solid var(--separator);
      transition: background-color 100ms var(--ease-out);
    }
    .sr-record:hover { background: var(--default); }
    .search-result-badge {
      font-size: 10px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      padding: 3px 9px;
      border-radius: 9999px;
      flex-shrink: 0;
      min-width: 54px;
      text-align: center;
    }
    .search-result-badge.contact { background: rgba(148,163,184,0.18); color: #cbd5e1; border: 1px solid rgba(148,163,184,0.25); }
    .search-result-badge.lead { background: rgba(34,197,94,0.18); color: #4ade80; border: 1px solid rgba(34,197,94,0.25); }
    .search-result-badge.quote { background: rgba(59,130,246,0.18); color: #60a5fa; border: 1px solid rgba(59,130,246,0.25); }
    .search-result-badge.project { background: rgba(168,85,247,0.18); color: #c084fc; border: 1px solid rgba(168,85,247,0.25); }
    .search-result-badge.portfolio { background: rgba(234,179,8,0.18); color: #facc15; border: 1px solid rgba(234,179,8,0.25); }
    .search-result-main { flex: 1; min-width: 0; }
    .search-result-name { font-size: 13px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: var(--foreground); }
    .search-result-sub { font-size: 11px; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin-top: 1px; }
    .search-result-number { font-size: 11px; color: var(--muted); font-family: monospace; }
    .search-result-status {
      font-size: 10px;
      font-weight: 600;
      padding: 2px 8px;
      border-radius: 9999px;
      white-space: nowrap;
    }
    .search-empty { padding: 20px 16px; text-align: center; color: var(--muted); font-size: 13px; }
  </style>

  <style>
    /* Dashboard Grid */
    .dashboard-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
      gap: 16px;
    }

    /* ── Upcoming Projects ───────────────────────────────────────────── */
    .upcoming-projects-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-xl);
      box-shadow: var(--surface-shadow);
      padding: 20px 24px;
      margin-bottom: 16px;
    }
    .upcoming-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
      margin-bottom: 12px;
    }
    .upcoming-title {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: 15px;
      font-weight: 700;
      color: var(--foreground);
    }
    .upcoming-title svg {
      color: var(--accent-soft-foreground);
    }
    .upcoming-cta {
      display: inline-flex;
      align-items: center;
      height: 32px;
      padding: 0 14px;
      border-radius: 9999px;
      background: var(--accent-soft);
      font-size: 13px;
      font-weight: 600;
      color: var(--accent-soft-foreground);
      text-decoration: none;
      transition: background-color 100ms var(--ease-out);
    }
    .upcoming-cta:hover {
      background: var(--accent-soft-hover);
      text-decoration: none;
    }
    .upcoming-empty {
      padding: 16px 0;
      color: var(--muted);
      font-size: 13px;
    }
    .upcoming-list {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .upcoming-row {
      display: grid;
      grid-template-columns: 110px 1fr auto 16px;
      align-items: center;
      gap: 12px;
      padding: 10px 12px;
      border-radius: var(--field-radius);
      background: var(--surface);
      border: 1px solid transparent;
      text-decoration: none;
      color: var(--foreground);
      transition: background-color 100ms var(--ease-out), border-color 100ms var(--ease-out);
    }
    .upcoming-row:hover {
      background: var(--default);
      border-color: var(--border);
    }
    .upcoming-status {
      display: inline-flex;
      justify-content: center;
      padding: 3px 8px;
      border-radius: 9999px;
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.3px;
      text-align: center;
    }
    .upcoming-customer {
      font-weight: 600;
      font-size: 14px;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .upcoming-dates {
      font-size: 13px;
      color: var(--muted);
      white-space: nowrap;
    }
    .upcoming-arrow {
      color: var(--muted);
      font-size: 18px;
      line-height: 1;
    }

    @media (max-width: 640px) {
      .upcoming-row {
        grid-template-columns: 1fr auto;
        gap: 8px;
      }
      .upcoming-status {
        grid-row: 1; grid-column: 1;
        justify-self: start;
      }
      .upcoming-customer {
        grid-row: 2; grid-column: 1 / span 2;
        font-size: 14px;
      }
      .upcoming-dates {
        grid-row: 1; grid-column: 2;
      }
      .upcoming-arrow {
        display: none;
      }
    }

    /* ── Section Cards — HeroUI card anatomy ─────────────────────────── */
    .section-card {
      background: var(--surface);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border-radius: var(--radius-xl);
      border: 1px solid var(--border);
      box-shadow: var(--surface-shadow);
      overflow: hidden;
      transition: background-color 150ms var(--ease-out);
    }

    .section-card:hover {
      background: var(--surface-secondary);
    }

    .section-header {
      padding: 20px 24px;
      border-bottom: 1px solid var(--separator);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .section-title {
      font-size: 16px;
      font-weight: 600;
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .section-icon {
      width: 36px;
      height: 36px;
      border-radius: var(--field-radius);
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .section-icon svg {
      width: 18px;
      height: 18px;
    }

    .section-icon.leads { background: linear-gradient(135deg, #3b82f6, #1d4ed8); color: white; }
    .section-icon.quotes { background: linear-gradient(135deg, #f59e0b, #d97706); color: white; }
    .section-icon.projects { background: linear-gradient(135deg, #22c55e, #16a34a); color: white; }
    .section-icon.crew { background: linear-gradient(135deg, #d946ef, #a21caf); color: white; }
    .section-icon.contacts { background: linear-gradient(135deg, #8b5cf6, #7c3aed); color: white; }

    .section-total {
      font-size: 28px;
      font-weight: 800;
      color: var(--foreground);
    }

    .section-body {
      padding: 20px 24px;
    }

    /* Status Items */
    .status-list {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .status-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 12px 16px;
      background: var(--surface);
      border-radius: var(--field-radius);
      border: 1px solid transparent;
      transition: background-color 100ms var(--ease-out), border-color 100ms var(--ease-out);
    }

    .status-item:hover {
      background: var(--default);
      border-color: var(--border);
    }

    .status-label {
      display: flex;
      align-items: center;
      gap: 12px;
      font-weight: 500;
      font-size: 14px;
    }

    .status-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      box-shadow: 0 0 8px currentColor;
    }

    /* Status colors */
    .status-dot.pending { background: #f59e0b; color: #f59e0b; }
    .status-dot.confirmed { background: #22c55e; color: #22c55e; }
    .status-dot.promoted { background: #3b82f6; color: #3b82f6; }
    .status-dot.won { background: #8b5cf6; color: #8b5cf6; }
    .status-dot.failed { background: #ef4444; color: #ef4444; }
    .status-dot.draft { background: #64748b; color: #64748b; }
    .status-dot.sent { background: #3b82f6; color: #3b82f6; }
    .status-dot.accepted { background: #22c55e; color: #22c55e; }
    .status-dot.declined { background: #ef4444; color: #ef4444; }
    .status-dot.project { background: #8b5cf6; color: #8b5cf6; }
    .status-dot.needs-crew { background: #f59e0b; color: #f59e0b; }
    .status-dot.in-progress { background: #3b82f6; color: #3b82f6; }
    .status-dot.completed { background: #22c55e; color: #22c55e; }
    .status-dot.portfolio { background: #8b5cf6; color: #8b5cf6; }

    .status-count {
      font-weight: 700;
      font-size: 16px;
      color: var(--foreground);
    }

    .status-count.zero {
      color: var(--muted);
      font-weight: 400;
    }

    /* View Link — soft accent pill (HeroUI secondary action; the page keeps
       one loud primary: Sync Pipeline in the header) */
    .view-link {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      height: 36px;
      padding: 0 16px;
      background: var(--accent-soft);
      color: var(--accent-soft-foreground);
      text-decoration: none;
      border-radius: 9999px;
      font-weight: 600;
      font-size: 13px;
      margin-top: 16px;
      transition: background-color 100ms var(--ease-out);
    }

    .view-link:hover {
      background: var(--accent-soft-hover);
    }

    .view-link svg {
      width: 16px;
      height: 16px;
    }

    /* Full Width Sections */
    .full-width-section {
      grid-column: 1 / -1;
      background: var(--surface);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border-radius: var(--radius-xl);
      border: 1px solid var(--border);
      box-shadow: var(--surface-shadow);
      margin-top: 8px;
    }

    .section-header-full {
      padding: 20px 24px;
      border-bottom: 1px solid var(--separator);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .refresh-btn {
      background: var(--default);
      border: 1px solid transparent;
      border-radius: 9999px;
      width: 32px;
      height: 32px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      color: var(--muted);
      transition: background-color 100ms var(--ease-out), color 100ms var(--ease-out);
    }

    .refresh-btn:hover {
      background: var(--default-hover);
      color: var(--foreground);
    }

    .refresh-btn.spinning svg {
      animation: spin 0.8s linear infinite;
    }

    .pipeline-error {
      text-align: center;
      padding: 16px;
      color: var(--danger-soft-foreground);
      background: var(--danger-soft);
      border-radius: var(--field-radius);
      margin-top: 16px;
    }

    .section-title-full {
      font-size: 16px;
      font-weight: 600;
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .section-title-full svg {
      width: 20px;
      height: 20px;
      color: var(--accent-soft-foreground);
    }

    .section-body-full {
      padding: 24px;
    }

    /* Pipeline Flow — soft status washes */
    .pipeline-flow {
      display: flex;
      align-items: center;
      gap: 16px;
      justify-content: center;
      flex-wrap: wrap;
    }

    .pipeline-stage {
      text-align: center;
      padding: 20px 36px;
      border-radius: var(--radius-lg);
      min-width: 140px;
      transition: background-color 150ms var(--ease-out);
    }

    .pipeline-stage.blue {
      background: rgba(59, 130, 246, 0.14);
      border: 1px solid rgba(59, 130, 246, 0.3);
    }

    .pipeline-stage.amber {
      background: rgba(245, 158, 11, 0.14);
      border: 1px solid rgba(245, 158, 11, 0.3);
    }

    .pipeline-stage.green {
      background: rgba(34, 197, 94, 0.14);
      border: 1px solid rgba(34, 197, 94, 0.3);
    }

    .pipeline-stage.purple {
      background: rgba(139, 92, 246, 0.14);
      border: 1px solid rgba(139, 92, 246, 0.3);
    }

    .pipeline-value {
      font-size: 28px;
      font-weight: 800;
      margin-bottom: 4px;
    }

    .pipeline-stage.blue .pipeline-value { color: #60a5fa; }
    .pipeline-stage.amber .pipeline-value { color: #fbbf24; }
    .pipeline-stage.green .pipeline-value { color: #4ade80; }
    .pipeline-stage.purple .pipeline-value { color: #a78bfa; }

    .pipeline-label {
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 1px;
      color: var(--muted);
      font-weight: 600;
    }

    .pipeline-arrow {
      color: var(--muted);
      opacity: 0.5;
    }

    /* Analytics - :global() needed for dynamically generated content */
    :global(.analytics-grid) {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 16px;
      margin-bottom: 24px;
    }

    :global(.analytics-stat) {
      text-align: center;
      padding: 20px;
      background: var(--surface);
      border-radius: var(--radius-lg);
      border: 1px solid var(--border);
      transition: background-color 150ms var(--ease-out);
    }

    :global(.analytics-stat:hover) {
      background: var(--surface-secondary);
    }

    :global(.analytics-stat-value) {
      font-size: 30px;
      line-height: 1.2;
      font-weight: 800;
      background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-secondary) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    :global(.analytics-stat-label) {
      font-size: 11px;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 1px;
      margin-top: 6px;
      font-weight: 600;
    }

    :global(.analytics-content-grid) {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 24px;
    }

    :global(.analytics-chart) {
      height: 140px;
      display: flex;
      align-items: flex-end;
      gap: 10px;
      padding: 20px;
      background: var(--surface);
      border-radius: var(--radius-lg);
      border: 1px solid var(--border);
    }

    :global(.chart-bar) {
      flex: 1;
      background: linear-gradient(180deg, var(--color-primary), var(--color-primary-dark));
      border-radius: 6px 6px 0 0;
      position: relative;
      min-height: 10px;
      transition: filter 150ms var(--ease-out);
    }

    :global(.chart-bar:hover) {
      filter: brightness(1.2);
    }

    :global(.chart-bar-label) {
      position: absolute;
      bottom: -24px;
      left: 50%;
      transform: translateX(-50%);
      font-size: 11px;
      color: var(--muted);
      white-space: nowrap;
      font-weight: 500;
    }

    :global(.top-pages) {
      background: var(--surface);
      border-radius: var(--radius-lg);
      border: 1px solid var(--border);
      overflow: hidden;
    }

    :global(.top-page-item) {
      display: flex;
      justify-content: space-between;
      padding: 14px 18px;
      border-bottom: 1px solid var(--separator);
      transition: background-color 100ms var(--ease-out);
    }

    :global(.top-page-item:last-child) {
      border-bottom: none;
    }

    :global(.top-page-item:hover) {
      background: var(--default);
    }

    :global(.top-page-path) {
      font-family: 'SF Mono', Monaco, 'Cascadia Code', monospace;
      font-size: 13px;
      color: var(--foreground);
    }

    :global(.top-page-views) {
      font-weight: 700;
      color: var(--accent-soft-foreground);
    }

    :global(.analytics-not-configured) {
      text-align: center;
      padding: 48px;
      background: var(--surface);
      border-radius: var(--radius-lg);
      border: 1px solid var(--border);
    }

    :global(.analytics-not-configured code) {
      display: block;
      margin-top: 16px;
      padding: 16px;
      background: rgba(0, 0, 0, 0.4);
      color: #f4f4f5;
      border-radius: var(--radius-md);
      font-size: 12px;
      text-align: left;
      font-family: 'SF Mono', Monaco, 'Cascadia Code', monospace;
    }

    :global(.analytics-subtitle) {
      margin-bottom: 16px;
      font-size: 14px;
      color: var(--muted);
      font-weight: 500;
    }

    /* Dashboard Responsive (page-specific rules only — the header, logo, and
       page-header mobile behavior live in admin.css) */
    @media (max-width: 1024px) {
      .quick-stats {
        grid-template-columns: repeat(2, 1fr);
      }

      .analytics-grid {
        grid-template-columns: repeat(2, 1fr);
      }

      .analytics-content-grid {
        grid-template-columns: 1fr;
      }

      .pipeline-flow {
        gap: 12px;
      }

      .pipeline-stage {
        padding: 16px 24px;
        min-width: 120px;
      }
    }

    @media (max-width: 768px) {
      /* Hide sync button on mobile - accessible via menu if needed */
      .sync-btn {
        display: none;
      }

      /* Prevent overflow */
      .admin-main {
        overflow-x: hidden;
        max-width: 100vw;
        padding: 12px;
      }

      .dashboard-grid {
        grid-template-columns: 1fr;
        max-width: 100%;
        gap: 12px;
      }

      /* Quick stats - 4 columns, super compact */
      .quick-stats {
        grid-template-columns: repeat(4, 1fr);
        gap: 7px;
        max-width: 100%;
        margin-bottom: 16px;
      }

      .quick-stat {
        padding: 0;
        min-width: 0;
        border-radius: var(--radius-md);
      }

      .quick-stat-value {
        font-size: 15px;
        /* Solid accent (not the gradient) + a touch smaller on phones. */
        background: none;
        -webkit-text-fill-color: var(--color-primary);
        color: var(--color-primary);
      }

      /* Smaller font so 2-word labels (TOTAL PROJECTS) wrap cleanly to two
         lines at the SPACE. No overflow-wrap:anywhere, that breaks mid-word
         (TOTA/L) because it lets the grid column shrink to one character. */
      .quick-stat-label {
        font-size: 7px;
        letter-spacing: 0;
        line-height: 1.25;
      }

      /* Section cards - more compact */
      .section-card {
        max-width: 100%;
        min-width: 0;
        overflow: hidden;
        border-radius: var(--radius-lg);
      }

      .section-header {
        padding: 12px 14px;
      }

      .section-title {
        font-size: 14px;
        gap: 8px;
      }

      .section-icon {
        width: 32px;
        height: 32px;
        border-radius: var(--radius-sm);
      }

      .section-icon svg {
        width: 16px;
        height: 16px;
      }

      .section-total {
        font-size: 24px;
      }

      .section-body {
        padding: 12px 14px;
      }

      .status-list {
        gap: 6px;
      }

      .status-item {
        padding: 10px 12px;
      }

      .status-label {
        font-size: 12px;
        gap: 8px;
      }

      .status-count {
        font-size: 15px;
      }

      .view-link {
        height: 32px;
        padding: 0 14px;
        font-size: 12px;
        margin-top: 12px;
      }

      /* Pipeline - more compact */
      .pipeline-arrow {
        display: none;
      }

      .pipeline-flow {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 6px;
        max-width: 100%;
      }

      .pipeline-stage {
        min-width: 0;
        overflow: hidden;
        padding: 10px 6px;
        border-radius: var(--radius-md);
      }

      .pipeline-value {
        font-size: 18px;
      }

      .pipeline-label {
        font-size: 8px;
      }

      .section-header-full {
        padding: 12px 14px;
      }

      .section-title-full {
        font-size: 14px;
      }

      /* Full width sections */
      .full-width-section {
        max-width: 100%;
        overflow: hidden;
        border-radius: var(--radius-lg);
      }

      /* Analytics mobile fixes */
      :global(.analytics-grid) {
        grid-template-columns: repeat(2, 1fr);
        gap: 12px;
      }

      :global(.analytics-stat) {
        padding: 16px 12px;
      }

      :global(.analytics-stat-value) {
        font-size: 22px;
      }

      :global(.analytics-stat-label) {
        font-size: 10px;
      }

      :global(.analytics-content-grid) {
        grid-template-columns: 1fr;
        gap: 20px;
      }

      :global(.analytics-chart) {
        height: 120px;
        padding: 16px;
      }

      .section-body-full {
        padding: 16px;
      }
    }

    @media (max-width: 480px) {
      .quick-stats {
        gap: 7px;
      }

      .quick-stat {
        padding: 0;
      }

      .quick-stat-value {
        font-size: 15px;
        background: none;
        -webkit-text-fill-color: var(--color-primary);
        color: var(--color-primary);
      }

      .quick-stat-label {
        font-size: 7px;
        letter-spacing: 0;
        line-height: 1.25;
      }

      .pipeline-flow {
        gap: 8px;
      }

      .pipeline-stage {
        padding: 12px 8px;
        min-width: 80px;
      }

      /* Analytics - extra small screens */
      :global(.analytics-grid) {
        gap: 8px;
      }

      :global(.analytics-stat) {
        padding: 12px 8px;
      }

      :global(.analytics-stat-value) {
        font-size: 18px;
      }

      :global(.analytics-content-grid) {
        gap: 16px;
      }

      :global(.analytics-chart) {
        height: 100px;
        padding: 12px;
      }

      :global(.top-page-item) {
        padding: 12px 14px;
        font-size: 12px;
      }

      :global(.top-page-path) {
        font-size: 11px;
        word-break: break-all;
      }

      .section-body-full {
        padding: 12px;
      }
    }
  </style>
</head>
<body>
  <AdminPresence />
  <header class="admin-header">
    <a href="/admin/dashboard" class="admin-logo-link">
      <div class="logo-gradient-wrapper"></div>
      <span class="admin-badge">Admin</span>
    </a>
    <AdminNav active="dashboard" />
    <!-- Mobile: Bell + Hamburger -->
    <div class="mobile-header-right">
      <div class="notification-bell-wrapper">
        <button class="btn-bell" id="bellBtnMobile" title="Customer Replies" aria-label="Customer Replies">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
          <span class="bell-badge bell-badge-mobile" style="display:none;">0</span>
        </button>
        <div class="bell-dropdown" id="bellDropdownMobile" style="display:none;">
          <div class="bell-dropdown-header"><span>Customer Replies</span><button class="bell-mark-all-read" onclick="markAllRead()">Mark all read</button></div>
          <div class="bell-dropdown-list" id="bellListMobile">
            <div class="bell-dropdown-empty">No new replies</div>
          </div>
        </div>
      </div>
      <button class="mobile-nav-toggle" id="mobileNavToggle" aria-label="Toggle navigation">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>

    <div class="header-actions">
      <button class="theme-toggle" id="themeToggle" onclick="toggleTheme()" title="Toggle theme">
        <svg class="icon-sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="5"/>
          <line x1="12" y1="1" x2="12" y2="3"/>
          <line x1="12" y1="21" x2="12" y2="23"/>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
          <line x1="1" y1="12" x2="3" y2="12"/>
          <line x1="21" y1="12" x2="23" y2="12"/>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
        </svg>
        <svg class="icon-moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
      </button>
      <div class="notification-bell-wrapper">
        <button class="btn-bell" id="bellBtn" title="Customer Replies" aria-label="Customer Replies">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
          <span class="bell-badge" id="bellBadge" style="display:none;">0</span>
        </button>
        <div class="bell-dropdown" id="bellDropdown" style="display:none;">
          <div class="bell-dropdown-header"><span>Customer Replies</span><button class="bell-mark-all-read" onclick="markAllRead()">Mark all read</button></div>
          <div class="bell-dropdown-list" id="bellList">
            <div class="bell-dropdown-empty">No new replies</div>
          </div>
        </div>
      </div>
      <button class="btn-logout" onclick="logout()">Logout</button>
    </div>
  </header>

  <AdminMobileDrawer active="dashboard" />

  <main class="admin-main">
    <div class="page-header">
      <div>
        <h1 class="page-title">Dashboard</h1>
        <p class="page-subtitle">Overview of your business pipeline</p>
      </div>
      <button class="sync-btn" id="syncPipelineBtn" onclick="syncPipeline()">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21.5 2v6h-6M2.5 22v-6h6M2 11.5a10 10 0 0 1 18.8-4.3M22 12.5a10 10 0 0 1-18.8 4.2"/>
        </svg>
        Sync Pipeline
      </button>
    </div>

    <!-- Quick Stats -->
    <div class="quick-stats">
      <a href="/admin/leads/" class="quick-stat">
        <div class="quick-stat-value">{totalLeads}</div>
        <div class="quick-stat-label">Total Leads</div>
      </a>
      <a href="/admin/quotes/" class="quick-stat">
        <div class="quick-stat-value">{totalQuotes}</div>
        <div class="quick-stat-label">Total Quotes</div>
      </a>
      <a href="/admin/projects/" class="quick-stat">
        <div class="quick-stat-value">{totalProjects}</div>
        <div class="quick-stat-label">Total Projects</div>
      </a>
      <a href="/admin/crew/" class="quick-stat">
        <div class="quick-stat-value">{totalCrew}</div>
        <div class="quick-stat-label">Crew Members</div>
      </a>
    </div>

    <!-- Client Search -->
    <div class="client-search" id="clientSearch">
      <div class="search-input-wrap">
        <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input type="text" class="search-input" id="clientSearchInput" placeholder="Search by name, email, address, quote # or project #…" autocomplete="off" />
        <button class="search-clear" id="searchClearBtn" style="display:none;" aria-label="Clear search">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
        <span class="search-shortcut">⌘S</span>
      </div>
      <div class="search-filters" id="searchFilters">
        <button class="search-filter active" data-type="all">All</button>
        <button class="search-filter" data-type="leads">Leads</button>
        <button class="search-filter" data-type="quotes">Quotes</button>
        <button class="search-filter" data-type="projects">Projects</button>
      </div>
      <div class="search-results" id="searchResults" style="display:none;"></div>
    </div>

    <!-- Upcoming Projects (links to full /admin/calendar) -->
    <div class="upcoming-projects-card">
      <div class="upcoming-header">
        <div class="upcoming-title">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          Upcoming Projects
        </div>
        <a href="/admin/calendar" class="upcoming-cta">Open Calendar →</a>
      </div>
      {upcomingProjects.length === 0 ? (
        <div class="upcoming-empty">No projects scheduled. Set start dates on a project to see it here.</div>
      ) : (
        <div class="upcoming-list">
          {upcomingProjects.map(p => {
            const b = statusBadge(effectiveStatus(p));
            return (
              <a href={`/admin/projects?open=${p.id}`} class="upcoming-row">
                <span class="upcoming-status" style={`background:${b.bg}; color:${b.color};`}>{b.label}</span>
                <span class="upcoming-customer">{p.customer_name}</span>
                <span class="upcoming-dates">{fmtRange(p.scheduled_start, p.scheduled_end)}</span>
                <span class="upcoming-arrow">›</span>
              </a>
            );
          })}
        </div>
      )}
    </div>

    <!-- Section Cards Grid -->
    <div class="dashboard-grid">
      <!-- Leads -->
      <div class="section-card">
        <div class="section-header">
          <div class="section-title">
            <div class="section-icon leads">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                <circle cx="9" cy="7" r="4"/>
                <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
              </svg>
            </div>
            Leads
          </div>
          <div class="section-total">{totalLeads}</div>
        </div>
        <div class="section-body">
          <div class="status-list">
            <div class="status-item">
              <span class="status-label">
                <span class="status-dot pending"></span>
                Pending Confirmation
              </span>
              <span class={`status-count ${leadCounts.pending_confirmation === 0 ? 'zero' : ''}`}>
                {leadCounts.pending_confirmation}
              </span>
            </div>
            <div class="status-item">
              <span class="status-label">
                <span class="status-dot confirmed"></span>
                Confirmed (Ready for Quote)
              </span>
              <span class={`status-count ${leadCounts.confirmed === 0 ? 'zero' : ''}`}>
                {leadCounts.confirmed}
              </span>
            </div>
          </div>
          <a href="/admin/leads" class="view-link">
            View All Leads
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Quotes -->
      <div class="section-card">
        <div class="section-header">
          <div class="section-title">
            <div class="section-icon quotes">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                <path d="M14 2v6h6"/>
                <path d="M16 13H8"/>
                <path d="M16 17H8"/>
                <path d="M10 9H8"/>
              </svg>
            </div>
            Quotes
          </div>
          <div class="section-total">{totalQuotes}</div>
        </div>
        <div class="section-body">
          <div class="status-list">
            <div class="status-item">
              <span class="status-label">
                <span class="status-dot draft"></span>
                Draft
              </span>
              <span class={`status-count ${quoteCounts.draft === 0 ? 'zero' : ''}`}>
                {quoteCounts.draft}
              </span>
            </div>
            <div class="status-item">
              <span class="status-label">
                <span class="status-dot sent"></span>
                Pending Approval
              </span>
              <span class={`status-count ${quoteCounts.sent === 0 ? 'zero' : ''}`}>
                {quoteCounts.sent}
              </span>
            </div>
            <div class="status-item">
              <span class="status-label">
                <span class="status-dot accepted"></span>
                Ready to Promote
              </span>
              <span class={`status-count ${quoteCounts.accepted === 0 ? 'zero' : ''}`}>
                {quoteCounts.accepted}
              </span>
            </div>
            <div class="status-item">
              <span class="status-label">
                <span class="status-dot declined"></span>
                Needs Review
              </span>
              <span class={`status-count ${quoteCounts.declined === 0 ? 'zero' : ''}`}>
                {quoteCounts.declined}
              </span>
            </div>
            {quoteCounts.cold > 0 && (
              <div class="status-item">
                <span class="status-label">
                  <span class="status-dot" style="background: #64748b;"></span>
                  Cold (No Response)
                </span>
                <span class="status-count" style="color: #64748b;">
                  {quoteCounts.cold}
                </span>
              </div>
            )}
          </div>
        </div>
      </div>

      <!-- Projects -->
      <div class="section-card">
        <div class="section-header">
          <div class="section-title">
            <div class="section-icon projects">
