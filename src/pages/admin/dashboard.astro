            <svg class="pipeline-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="28" height="28">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
            <div class="pipeline-stage green">
              <div class="pipeline-value" id="pipeline-readyForProject">-</div>
              <div class="pipeline-label">Ready for Project</div>
            </div>
            <svg class="pipeline-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="28" height="28">
              <path d="M5 12h14M12 5l7 7-7 7"/>
