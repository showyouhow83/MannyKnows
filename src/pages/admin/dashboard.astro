  </main>

  <!-- MK Footer -->
  <footer class="admin-footer">
    by <a href="https://mannyknows.com" class="footer-link" target="_blank" rel="noopener">MK <span class="rocket-emoji">🚀</span></a>
  </footer>

  <!-- Toast -->
  <div class="toast" id="toast"></div>

  <script>
    // Toast notification
    function showToast(message: string, type: 'success' | 'error' | 'info' = 'success') {
      const toast = document.getElementById('toast');
      if (!toast) return;
      toast.textContent = message;
      toast.className = `toast ${type} visible`;
      setTimeout(() => toast.classList.remove('visible'), 4000);
    }

    // Fetch and update pipeline stats
    async function fetchPipelineStats() {
      const refreshBtn = document.getElementById('refreshPipelineBtn');
      if (refreshBtn) {
        refreshBtn.classList.add('spinning');
      }

      try {
        const res = await fetch('/api/admin/dashboard-stats/', {
          method: 'GET',
          credentials: 'include'
        });
        const data = await res.json() as any;

        if (!data.success) {
          console.error('Pipeline stats error:', data);
          const errorDiv = document.getElementById('pipeline-error');
          if (errorDiv) {
            errorDiv.style.display = 'block';
            errorDiv.textContent = data.error || 'Failed to load stats';
          }
          return;
        }

        // Update pipeline values
        const readyForQuote = document.getElementById('pipeline-readyForQuote');
        const awaitingResponse = document.getElementById('pipeline-awaitingResponse');
        const readyForProject = document.getElementById('pipeline-readyForProject');
        const inProgress = document.getElementById('pipeline-inProgress');

        if (readyForQuote) readyForQuote.textContent = String(data.pipeline.readyForQuote);
        if (awaitingResponse) awaitingResponse.textContent = String(data.pipeline.awaitingResponse);
        if (readyForProject) readyForProject.textContent = String(data.pipeline.readyForProject);
        if (inProgress) inProgress.textContent = String(data.pipeline.inProgress);

        // Hide error if shown
        const errorDiv = document.getElementById('pipeline-error');
        if (errorDiv) errorDiv.style.display = 'none';

        // Debug: log raw query results to console
        console.log('Dashboard stats:', data);
      } catch (err) {
        console.error('Failed to fetch pipeline stats:', err);
        const errorDiv = document.getElementById('pipeline-error');
        if (errorDiv) {
          errorDiv.style.display = 'block';
          errorDiv.textContent = 'Failed to connect to server';
        }
      } finally {
        if (refreshBtn) {
          refreshBtn.classList.remove('spinning');
        }
      }
    }

    // Load pipeline stats on page load
    fetchPipelineStats();

    // Refresh button handler
    const refreshBtn = document.getElementById('refreshPipelineBtn');
    if (refreshBtn) {
      refreshBtn.addEventListener('click', fetchPipelineStats);
    }

    // Sync pipeline
    async function syncPipeline() {
      const btn = document.getElementById('syncPipelineBtn') as HTMLButtonElement;
      if (!btn) return;

      btn.disabled = true;
      btn.classList.add('syncing');
      const originalText = btn.innerHTML;
      btn.innerHTML = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M21.5 2v6h-6M2.5 22v-6h6M2 11.5a10 10 0 0 1 18.8-4.3M22 12.5a10 10 0 0 1-18.8 4.2"/>
      </svg> Syncing...`;

      try {
        // First check what needs fixing
        const checkRes = await fetch('/api/admin/sync-pipeline/', {
          method: 'GET',
          credentials: 'include'
        });
        const checkData = await checkRes.json() as any;

        if (checkData.total_issues === 0) {
          showToast('Pipeline is already in sync!', 'info');
          btn.disabled = false;
          btn.classList.remove('syncing');
          btn.innerHTML = originalText;
          return;
        }

        // Fix the issues
        const fixRes = await fetch('/api/admin/sync-pipeline/', {
          method: 'POST',
          credentials: 'include'
        });
        const fixData = await fixRes.json() as any;

        if (fixData.success) {
          const total = fixData.quotesFixed + fixData.leadsPromotedFixed + fixData.leadsWonFixed;
          showToast(`Fixed ${total} records! Refreshing...`, 'success');
          setTimeout(() => window.location.reload(), 1500);
        } else {
          showToast(fixData.error || 'Failed to sync', 'error');
        }
      } catch (err) {
        showToast('Error syncing pipeline', 'error');
      }

      btn.disabled = false;
      btn.classList.remove('syncing');
      btn.innerHTML = originalText;
    }
    (window as any).syncPipeline = syncPipeline;

    async function logout() {
      await fetch('/api/admin/logout/', { method: 'POST' });
      window.location.href = '/admin';
    }
    (window as any).logout = logout;

    // Theme toggle
    function initTheme() {
      const saved = localStorage.getItem('admin-theme');
      const theme = saved || 'dark';
      document.documentElement.setAttribute('data-theme', theme);
    }

    function toggleTheme() {
      const current = document.documentElement.getAttribute('data-theme') || 'dark';
      const next = current === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      localStorage.setItem('admin-theme', next);
    }
    (window as any).toggleTheme = toggleTheme;

    // Initialize theme on load
    initTheme();

    // =====================================================
    // MOBILE NAVIGATION
    // =====================================================
    const mobileNavToggle = document.getElementById('mobileNavToggle');
    const mobileNavPanel = document.getElementById('mobileNavPanel');
    const mobileNavOverlay = document.getElementById('mobileNavOverlay');
    const mobileNavClose = document.getElementById('mobileNavClose');

    function openMobileNav() {
      mobileNavToggle?.classList.add('active');
      mobileNavPanel?.classList.add('active');
      mobileNavOverlay?.classList.add('active');
      document.body.style.overflow = 'hidden';
    }

    function closeMobileNav() {
      mobileNavToggle?.classList.remove('active');
      mobileNavPanel?.classList.remove('active');
      mobileNavOverlay?.classList.remove('active');
      document.body.style.overflow = '';
    }
    (window as any).closeMobileNav = closeMobileNav;

    mobileNavToggle?.addEventListener('click', () => {
      if (mobileNavPanel?.classList.contains('active')) {
        closeMobileNav();
      } else {
        openMobileNav();
      }
    });

    mobileNavClose?.addEventListener('click', closeMobileNav);
    mobileNavOverlay?.addEventListener('click', closeMobileNav);

    // Close on escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && mobileNavPanel?.classList.contains('active')) {
        closeMobileNav();
      }
    });

    // Load analytics
    async function loadAnalytics() {
      const content = document.getElementById('analytics-content');
      const period = document.getElementById('analytics-period');

      try {
        const response = await fetch('/api/admin/analytics/');
        const data = await response.json() as any;

        if (!data.configured) {
          content!.innerHTML = `
            <div class="analytics-not-configured">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 56px; height: 56px; margin-bottom: 20px; color: var(--color-text-secondary);">
                <circle cx="12" cy="12" r="10"/>
                <line x1="12" y1="8" x2="12" y2="12"/>
                <line x1="12" y1="16" x2="12.01" y2="16"/>
              </svg>
              <h4 style="margin-bottom: 12px; color: var(--color-text-primary); font-size: 18px;">Analytics Not Configured</h4>
              <p style="color: var(--color-text-secondary); margin-bottom: 8px;">Add Cloudflare API credentials to see website traffic data.</p>
              <p style="margin-bottom: 20px; font-size: 13px;">
                <span style="color: ${data.hasToken ? 'var(--color-success)' : 'var(--color-error)'};">${data.hasToken ? '✓' : '✗'} CLOUDFLARE_API_TOKEN ${data.hasToken ? 'found' : 'missing'}</span>
                &nbsp;·&nbsp;
                <span style="color: ${data.hasZoneId ? 'var(--color-success)' : 'var(--color-error)'};">${data.hasZoneId ? '✓' : '✗'} CLOUDFLARE_ZONE_ID ${data.hasZoneId ? 'found' : 'missing'}</span>
              </p>
              <p style="color: var(--color-text-secondary); font-size: 13px; max-width: 460px; margin: 0 auto;">
                Add both under <strong>Workers &amp; Pages → mannyknows → Settings → Variables and Secrets</strong>.
                Token needs <em>Zone → Analytics → Read</em> for mannyknows.com
                (create at dash.cloudflare.com → My Profile → API Tokens).
                Saving redeploys the worker: allow a minute, then hit Refresh above.
              </p>
            </div>
          `;
          return;
        }

        if (data.error) {
          content!.innerHTML = `
            <div style="text-align: center; padding: 48px; color: #ef4444;">
              <p style="font-size: 16px;">Error loading analytics: ${data.message || data.error}</p>
            </div>
          `;
          return;
        }

        // Show period
        if (period && data.period) {
          period.textContent = `${data.period.start} to ${data.period.end}`;
        }

        // Format numbers
        const formatNumber = (n: number) => n.toLocaleString();
        const formatBytes = (b: number) => {
          if (b < 1024) return b + ' B';
          if (b < 1024 * 1024) return (b / 1024).toFixed(1) + ' KB';
          if (b < 1024 * 1024 * 1024) return (b / (1024 * 1024)).toFixed(1) + ' MB';
          return (b / (1024 * 1024 * 1024)).toFixed(1) + ' GB';
        };

        // Build chart
        const maxViews = Math.max(...data.daily.map((d: any) => d.pageViews), 1);
        const chartBars = data.daily.map((d: any) => {
          const height = Math.max((d.pageViews / maxViews) * 100, 8);
          const date = new Date(d.date);
          const label = date.toLocaleDateString('en-US', { weekday: 'short' });
          return `<div class="chart-bar" style="height: ${height}%" title="${d.pageViews.toLocaleString()} views on ${d.date}">
            <span class="chart-bar-label">${label}</span>
          </div>`;
        }).join('');

        // Build top pages
        const topPagesHtml = data.topPages.length > 0
          ? data.topPages.map((p: any) => `
              <div class="top-page-item">
                <span class="top-page-path">${p.path}</span>
                <span class="top-page-views">${formatNumber(p.views)}</span>
              </div>
            `).join('')
          : '<div class="top-page-item"><span style="color: var(--color-text-secondary);">No page data available</span></div>';

        // A Cloudflare API warning must be visible — silent zeros would read
        // as "no traffic" when the real story is "bad token / query failed".
        const warningHtml = data.warning
          ? `<div style="margin-bottom: 16px; padding: 10px 14px; border-radius: 10px; background: rgba(245, 158, 11, 0.12); border: 1px solid rgba(245, 158, 11, 0.35); color: var(--color-warning); font-size: 13px;">Cloudflare API: ${data.warning}</div>`
          : '';

        content!.innerHTML = `
          ${warningHtml}
          <div class="analytics-grid">
            <div class="analytics-stat" title="HTML pages served at the Cloudflare edge over the last 7 days. Counts bots and crawlers too.">
              <div class="analytics-stat-value">${formatNumber(data.totals.pageViews)}</div>
              <div class="analytics-stat-label">Page Views (edge)</div>
            </div>
            <div class="analytics-stat" title="Distinct IP addresses per day at the edge, averaged over 7 days (peak day: ${formatNumber(data.totals.uniqueVisitorsPeak ?? 0)}). Includes bots and crawlers: real human visitors run lower; see GA4.">
              <div class="analytics-stat-value">${formatNumber(data.totals.uniqueVisitorsAvg ?? 0)}</div>
              <div class="analytics-stat-label">Unique IPs / Day (avg)</div>
            </div>
            <div class="analytics-stat" title="Every HTTP request the edge served in the last 7 days: pages, images, scripts, bots, everything.">
              <div class="analytics-stat-value">${formatNumber(data.totals.requests)}</div>
              <div class="analytics-stat-label">Total Requests</div>
            </div>
            <div class="analytics-stat">
              <div class="analytics-stat-value">${formatBytes(data.totals.bandwidth)}</div>
              <div class="analytics-stat-label">Bandwidth</div>
            </div>
          </div>

          <div class="analytics-content-grid">
            <div>
              <div class="analytics-subtitle">Daily Page Views (Last 7 Days)</div>
              <div class="analytics-chart" style="padding-bottom: 36px;">
                ${chartBars}
              </div>
            </div>
            <div>
              <div class="analytics-subtitle">Top Pages</div>
              <div class="top-pages">
                ${topPagesHtml}
              </div>
            </div>
          </div>

          <p style="margin-top: 14px; font-size: 12px; color: var(--color-text-secondary);">
            Edge data from Cloudflare: includes bots, crawlers, and monitors, so these numbers run higher than human traffic.
            For real visitor behavior use <a href="https://analytics.google.com/" target="_blank" rel="noopener" style="color: var(--color-primary);">Google Analytics (GA4)</a>, which is already installed on the site.
          </p>
        `;
      } catch (error) {
        content!.innerHTML = `
          <div style="text-align: center; padding: 48px; color: #ef4444;">
            <p style="font-size: 16px;">Failed to load analytics</p>
          </div>
        `;
      }
    }

    // Load analytics on page load
    loadAnalytics();

    // Desktop bell
    const bellBtn = document.getElementById('bellBtn');
    const bellBadge = document.getElementById('bellBadge');
    const bellDropdown = document.getElementById('bellDropdown');
    const bellList = document.getElementById('bellList');
    // Mobile bell
    const bellBtnMobile = document.getElementById('bellBtnMobile');
    const bellBadgeMobile = document.querySelector('.bell-badge-mobile') as HTMLElement | null;
    const bellDropdownMobile = document.getElementById('bellDropdownMobile');
    const bellListMobile = document.getElementById('bellListMobile');

    let bellOpen = false;
    let activeBellDropdown: HTMLElement | null = null;

    function closeBell() {
      bellOpen = false;
      if (bellDropdown) bellDropdown.style.display = 'none';
      if (bellDropdownMobile) bellDropdownMobile.style.display = 'none';
      activeBellDropdown = null;
    }

    [bellBtn, bellBtnMobile].forEach(btn => {
      btn?.addEventListener('click', (e: Event) => {
        e.stopPropagation();
        const dropdown = btn === bellBtn ? bellDropdown : bellDropdownMobile;
        if (bellOpen && activeBellDropdown === dropdown) {
          closeBell();
        } else {
          closeBell();
          bellOpen = true;
          activeBellDropdown = dropdown;
          if (dropdown) dropdown.style.display = 'block';
        }
      });
    });

    document.addEventListener('click', () => { if (bellOpen) closeBell(); });
    bellDropdown?.addEventListener('click', (e: Event) => e.stopPropagation());
    bellDropdownMobile?.addEventListener('click', (e: Event) => e.stopPropagation());

    function bellEscapeHtml(str: string): string {
      return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    function bellGetTimeAgo(date: Date): string {
      const now = new Date();
      const diff = Math.floor((now.getTime() - date.getTime()) / 1000);
      if (diff < 60) return 'just now';
      if (diff < 3600) return `${Math.floor(diff / 60)}m ago`;
      if (diff < 86400) return `${Math.floor(diff / 3600)}h ago`;
      return `${Math.floor(diff / 86400)}d ago`;
    }

    function renderBellNotifications(data: any, listEl: HTMLElement) {
      let html = '';

      // New leads
      (data.leads || []).forEach((l: any) => {
        const dateObj = l.created_at ? new Date(l.created_at + 'Z') : null;
        const timeAgo = dateObj ? bellGetTimeAgo(dateObj) : '';
        html += `<div class="bell-notification" onclick="window.location.href='/admin/leads?open=${l.id}'" style="border-left: 3px solid #22c55e;">
          <div class="bell-notification-top">
            <span class="bell-notification-name">${bellEscapeHtml(l.customer_name || 'New Lead')}</span>
            <span class="bell-notification-time">${timeAgo}</span>
          </div>
          <div class="bell-notification-body">${bellEscapeHtml(l.service_type || 'New lead received')}</div>
          <div class="bell-notification-quote" style="color: #22c55e;">NEW LEAD</div>
        </div>`;
      });

      // Quote responses (accepted/declined)
      (data.quoteResponses || []).forEach((q: any) => {
        const dateObj = q.responded_at ? new Date(q.responded_at + 'Z') : null;
        const timeAgo = dateObj ? bellGetTimeAgo(dateObj) : '';
        const isAccepted = q.status === 'accepted';
        html += `<div class="bell-notification" onclick="window.location.href='/admin/quotes?open=${q.id}'" style="border-left: 3px solid ${isAccepted ? '#0071e3' : '#f59e0b'};">
          <div class="bell-notification-top">
            <span class="bell-notification-name">${bellEscapeHtml(q.customer_name || 'Customer')}</span>
            <span class="bell-notification-time">${timeAgo}</span>
          </div>
          <div class="bell-notification-body">Quote ${isAccepted ? 'accepted' : 'declined'}</div>
          <div class="bell-notification-quote" style="color: ${isAccepted ? '#0071e3' : '#f59e0b'};">#${bellEscapeHtml(q.quote_number || '')}</div>
        </div>`;
      });

      // Customer replies
      (data.replies || []).forEach((r: any) => {
        const dateObj = r.created_at ? new Date(r.created_at + 'Z') : null;
        const timeAgo = dateObj ? bellGetTimeAgo(dateObj) : '';
        const preview = (r.body || '').substring(0, 80) + ((r.body || '').length > 80 ? '...' : '');
        html += `<div class="bell-notification" onclick="window.location.href='/admin/quotes?open=${r.quote_id}'">
          <div class="bell-notification-top">
            <span class="bell-notification-name">${bellEscapeHtml(r.customer_name || r.sender_name || 'Customer')}</span>
            <span class="bell-notification-time">${timeAgo}</span>
          </div>
          <div class="bell-notification-body">${bellEscapeHtml(preview)}</div>
          <div class="bell-notification-quote">#${bellEscapeHtml(r.quote_number || '')}</div>
        </div>`;
      });

      listEl.innerHTML = html || '<div style="padding: 16px; text-align: center; color: var(--color-text-secondary); font-size: 13px;">No new notifications</div>';
    }

    var bellErrorCount = 0;
    async function loadBellNotifications() {
      if (bellErrorCount >= 3) { window.location.href = '/admin/'; return; }
      try {
        const res = await fetch('/api/admin/unread-replies/', { credentials: 'same-origin' });
        if (res.status === 401 || res.status === 403) { window.location.href = '/admin/'; return; }
        if (!res.ok) { bellErrorCount++; return; }
        const data: any = await res.json();
        if (!data.success) return;
        bellErrorCount = 0;
        const total = data.total || 0;
        [bellBadge, bellBadgeMobile].forEach(badge => {
          if (badge) {
            badge.textContent = String(total);
            badge.style.display = total > 0 ? 'flex' : 'none';
          }
        });
        [bellBtn, bellBtnMobile].forEach(btn => {
          if (total > 0) btn?.classList.add('has-notifications');
          else btn?.classList.remove('has-notifications');
        });
        if (bellList) renderBellNotifications(data, bellList);
        if (bellListMobile) renderBellNotifications(data, bellListMobile);
      } catch (err) { bellErrorCount++; }
    }
    async function markAllRead() {
      try {
        await fetch('/api/admin/unread-replies/', {
          method: 'POST',
          credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ mark_all: true })
        });
        loadBellNotifications();
        closeBell();
      } catch (err) {
        console.error('Failed to mark all as read:', err);
      }
    }
    (window as any).markAllRead = markAllRead;

    loadBellNotifications();
    setInterval(loadBellNotifications, 30000); // Poll every 30s
    document.addEventListener('visibilitychange', () => { if (!document.hidden) { bellErrorCount = 0; loadBellNotifications(); } });

    // ── Client Search ──────────────────────────────────────────────────────
    const searchInput = document.getElementById('clientSearchInput') as HTMLInputElement;
    const searchResults = document.getElementById('searchResults') as HTMLElement;
    const searchClearBtn = document.getElementById('searchClearBtn') as HTMLButtonElement;
    let searchType = 'all';
    let searchTimer: ReturnType<typeof setTimeout> | null = null;

    function escHtml(s: unknown): string {
      return String(s == null ? '' : s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    const STATUS_COLORS: Record<string, { bg: string; color: string }> = {
      confirmed: { bg: 'rgba(34,197,94,0.15)', color: '#4ade80' },
      pending_confirmation: { bg: 'rgba(245,158,11,0.15)', color: '#fbbf24' },
      draft: { bg: 'rgba(148,163,184,0.15)', color: '#a1a1aa' },
      sent: { bg: 'rgba(59,130,246,0.15)', color: '#60a5fa' },
      accepted: { bg: 'rgba(34,197,94,0.15)', color: '#4ade80' },
      declined: { bg: 'rgba(239,68,68,0.15)', color: '#f87171' },
      needs_crew: { bg: 'rgba(245,158,11,0.15)', color: '#fbbf24' },
      in_progress: { bg: 'rgba(59,130,246,0.15)', color: '#60a5fa' },
      completed: { bg: 'rgba(34,197,94,0.15)', color: '#4ade80' },
    };

    function statusChip(status: string): string {
      if (!status) return '';
      const s = STATUS_COLORS[status] || { bg: 'rgba(148,163,184,0.1)', color: '#a1a1aa' };
      const label = (status || '').replace(/_/g, ' ');
      return `<span class="search-result-status" style="background:${s.bg};color:${s.color};">${escHtml(label)}</span>`;
    }

    function renderResults(results: any[]): void {
      if (!results.length) {
        searchResults.innerHTML = '<div class="search-empty">No matches found</div>';
        searchResults.style.display = 'block';
        return;
      }
      searchResults.innerHTML = results.map(r => {
        // Left: the Contact hub (or the record itself for raw, unlinked leads).
        const mainUrl = r.contactUrl || r.recordUrl;
        const mainBadge = r.contactId
          ? '<span class="search-result-badge contact">Contact</span>'
          : '';
        const main = `
          <a class="sr-main" href="${escHtml(mainUrl)}">
            ${mainBadge}
            <span class="search-result-main">
              <div class="search-result-name">${escHtml(r.name)}</div>
              ${r.sub ? `<div class="search-result-sub">${escHtml(r.sub)}</div>` : ''}
            </span>
          </a>`;
        // Right: the single live record at its current stage. Only when the
        // contact has progressed AND it's a distinct target from the left.
        let record = '';
        if (r.stage && r.contactId) {
          record = `
          <a class="sr-record" href="${escHtml(r.recordUrl)}" title="Open ${escHtml(r.stage)}">
            <span class="search-result-badge ${escHtml(r.stage)}">${escHtml(r.stage)}</span>
            ${r.recordNumber ? `<span class="search-result-number">${escHtml(r.recordNumber)}</span>` : ''}
            ${statusChip(r.status)}
          </a>`;
        } else if (r.stage && !r.contactId) {
          // Raw lead — left already links to it; show the stage/status inline.
          record = `
          <span class="sr-record" style="cursor:default;">
            <span class="search-result-badge ${escHtml(r.stage)}">${escHtml(r.stage)}</span>
            ${statusChip(r.status)}
          </span>`;
        }
        return `<div class="search-result-item">${main}${record}</div>`;
      }).join('');
      searchResults.style.display = 'block';
    }

    async function runSearch(): Promise<void> {
      const q = searchInput.value.trim();
      if (q.length < 2) {
        searchResults.style.display = 'none';
        return;
      }
      try {
        const res = await fetch(`/api/admin/search?q=${encodeURIComponent(q)}&type=${searchType}`, { credentials: 'same-origin' });
        const data: any = await res.json();
        renderResults(data.results || []);
      } catch { /* silent */ }
    }

    searchInput?.addEventListener('input', () => {
      const q = searchInput.value.trim();
      searchClearBtn.style.display = q ? 'block' : 'none';
      if (searchTimer) clearTimeout(searchTimer);
      searchTimer = setTimeout(runSearch, 280);
    });

    searchClearBtn?.addEventListener('click', () => {
      searchInput.value = '';
      searchClearBtn.style.display = 'none';
      searchResults.style.display = 'none';
    });

    document.getElementById('searchFilters')?.querySelectorAll('.search-filter').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.search-filter').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        searchType = (btn as HTMLElement).dataset.type || 'all';
        if (searchInput.value.trim().length >= 2) runSearch();
      });
    });

    document.addEventListener('click', (e) => {
      if (!document.getElementById('clientSearch')?.contains(e.target as Node)) {
        searchResults.style.display = 'none';
      }
    });

    // Cmd+S / Ctrl+S on dashboard focuses the search bar
    document.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key === 's') {
        e.preventDefault();
        searchInput?.focus();
        searchInput?.select();
      }
      if (e.key === 'Escape') {
        searchResults.style.display = 'none';
        searchInput?.blur();
      }
    });
  </script>
</body>
</html>
