      <!-- Website Analytics -->
      <div class="full-width-section" id="analytics-section">
        <div class="section-header-full">
          <h3 class="section-title-full">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M18 20V10"/>
              <path d="M12 20V4"/>
              <path d="M6 20v-6"/>
            </svg>
            Website Analytics
          </h3>
          <span id="analytics-period" style="font-size: 14px; color: var(--color-text-secondary);"></span>
        </div>
        <div class="section-body-full" id="analytics-content">
          <div style="text-align: center; padding: 48px; color: var(--color-text-secondary);">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 40px; height: 40px; margin-bottom: 16px; animation: spin 1s linear infinite;">
              <path d="M21 12a9 9 0 11-6.219-8.56"/>
            </svg>
            <div style="font-size: 16px;">Loading analytics...</div>
