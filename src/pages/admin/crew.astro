    // =====================================================
    // Build time options from 00:00 to 23:30 in 30-min steps
    function populateTimeSelect(selectEl, includeEmpty) {
      selectEl.innerHTML = includeEmpty ? '<option value="">Still working / not set</option>' : '<option value="">Select time...</option>';
      for (let h = 0; h < 24; h++) {
        for (let m = 0; m < 60; m += 30) {
          const val = `${String(h).padStart(2,'0')}:${String(m).padStart(2,'0')}`;
          const ampm = h === 0 ? '12' : h > 12 ? String(h - 12) : String(h);
          const period = h < 12 ? 'AM' : 'PM';
          const label = `${ampm}:${String(m).padStart(2,'0')} ${period}`;
          const opt = document.createElement('option');
          opt.value = val;
          opt.textContent = label;
          selectEl.appendChild(opt);
        }
      }
    }

