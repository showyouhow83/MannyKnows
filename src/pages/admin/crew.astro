      }

      const btn = document.getElementById('saveShiftBtn');
      btn.disabled = true; btn.textContent = 'Adding...';

      // Store as local ET time (no UTC conversion)
      const clockInDT = `${date}T${clockIn}:00`;
      const clockOutDT = clockOut ? `${date}T${clockOut}:00` : null;

      try {
        const res = await fetch('/api/admin/crew/timelogs/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'include',
          body: JSON.stringify({ crew_lead_id: parseInt(crewId), clock_in: clockInDT, clock_out: clockOutDT, work_date: date, notes: notes || null })
        });
