    async function saveExpense() {
      const editId = document.getElementById('expEditId').value;
      const isEdit = !!editId;
      const crewId = document.getElementById('expCrewId').value;
      const date = document.getElementById('expDate').value;
      const amount = parseFloat(document.getElementById('expAmount').value);
      const description = document.getElementById('expDescription').value.trim();
      const receiptInput = document.getElementById('expReceipt');
      const receiptFile = receiptInput?.files?.[0];

      if (!crewId || !date || !amount || !description) {
        showToast('Crew member, date, amount, and description are required', 'error');
        return;
      }
      const paidWithNow = document.getElementById('expPaidWithValue').value || 'crew';
      // Receipt required for reimbursable + company-card entries, optional for deductions
      // (admin paid directly — they're recording an internal subtraction, not requesting reimbursement).
      if (!isEdit && !receiptFile && paidWithNow !== 'deduction') {
        showToast('Receipt photo is required', 'error');
        return;
      }

      const btn = document.getElementById('saveExpenseBtn');
      const originalBtnText = btn.textContent;
      btn.disabled = true; btn.textContent = receiptFile ? 'Uploading receipt...' : 'Saving...';

      try {
        // Upload receipt image if a new one was selected
        let receiptUrl;
        if (receiptFile) {
          const timestamp = Date.now();
          const ext = receiptFile.name.split('.').pop()?.toLowerCase() || 'jpg';
          const uploadPath = `receipts/${timestamp}_receipt.${ext}`;
          const uploadRes = await fetch('/api/r2-upload/', {
            method: 'POST',
            credentials: 'include',
            headers: {
              'Content-Type': receiptFile.type || 'image/jpeg',
              'X-Upload-Path': uploadPath,
              'X-Upload-Timestamp': String(timestamp),
            },
            body: receiptFile,
          });
          const uploadData = await uploadRes.json();
          if (uploadData.success && (uploadData.fileUrl || uploadData.url)) {
            receiptUrl = uploadData.fileUrl || uploadData.url;
          } else {
            showToast(uploadData.error || 'Receipt upload failed', 'error');
            btn.disabled = false; btn.textContent = originalBtnText;
            return;
          }
          btn.textContent = 'Saving...';
        }

        const payload = { crew_lead_id: parseInt(crewId), work_date: date, amount, description, paid_with: paidWithNow };
        if (receiptUrl !== undefined) payload.receipt_url = receiptUrl;

        let res;
        if (isEdit) {
          res = await fetch('/api/admin/crew/expenses/', {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'include',
            body: JSON.stringify({ id: parseInt(editId), ...payload })
          });
        } else {
          res = await fetch('/api/admin/crew/expenses/', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'include',
            body: JSON.stringify(payload)
          });
        }

        const data = await res.json();
        if (data.success) {
          closeExpenseModal();
          showToast(isEdit ? 'Expense updated' : 'Expense added');
          loadTimesheets();
        } else {
          showToast(data.error || 'Failed to save expense', 'error');
        }
      } catch { showToast('Error saving expense', 'error'); }
      finally { btn.disabled = false; btn.textContent = originalBtnText; }
    }
    window.saveExpense = saveExpense;

