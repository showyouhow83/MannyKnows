  <script is:inline>
    // Search functionality
    const searchInput = document.getElementById('searchInput');
    const noResults = document.getElementById('noResults');
    const crewCards = document.querySelectorAll('.crew-card');

    searchInput.addEventListener('input', () => {
      const query = searchInput.value.toLowerCase().trim();
      let visibleCount = 0;

      crewCards.forEach(card => {
        const searchData = card.getAttribute('data-search') || '';
        const matches = query === '' || searchData.includes(query);
        card.classList.toggle('hidden', !matches);
        if (matches) visibleCount++;
      });

      noResults.classList.toggle('visible', visibleCount === 0 && query !== '');
    });

    // Toast notification
    function showToast(message, type = 'success') {
      const toast = document.getElementById('toast');
      toast.textContent = message;
      toast.className = `toast ${type} visible`;
      setTimeout(() => toast.classList.remove('visible'), 4000);
    }

    // Confirm modal
    let pendingDeleteId = null;
    let pendingDeleteName = null;

    function showCrewDeleteModal(id, name) {
      pendingDeleteId = id;
      pendingDeleteName = name;
      document.getElementById('confirmTitle').textContent = `Remove ${name}?`;
      document.getElementById('confirmText').textContent = 'This crew lead will be archived and removed from the list. Their time logs are kept, and you can restore them anytime from the Archived section below.';
      document.getElementById('crewDeleteModal').classList.add('active');
    }

    function closeCrewDeleteModal() {
      document.getElementById('crewDeleteModal').classList.remove('active');
      pendingDeleteId = null;
      pendingDeleteName = null;
    }

    document.getElementById('confirmBtn').addEventListener('click', async function() {
      if (!pendingDeleteId) return;

      // Save values before closing modal (closeCrewDeleteModal resets them)
      const idToDelete = pendingDeleteId;
      const nameToDelete = pendingDeleteName;

      closeCrewDeleteModal();

      try {
        const response = await fetch(`/api/crew/?crew_id=${idToDelete}`, {
          method: 'DELETE',
          credentials: 'include'
        });

        const data = await response.json();

        if (data.success) {
          showToast(`${nameToDelete} archived`, 'success');
          setTimeout(() => window.location.reload(), 1000);
        } else {
          showToast(data.error || 'Failed to remove crew lead', 'error');
        }
      } catch (err) {
        showToast('Failed to remove. Please try again.', 'error');
      }
    });

    function toggleArchived() {
      const btn = document.querySelector('.archived-toggle');
      const list = document.getElementById('archivedList');
      if (!btn || !list) return;
      const open = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!open));
      list.hidden = open;
    }

    async function restoreCrew(id, name) {
      try {
        const response = await fetch('/api/crew-leads/', {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'include',
          body: JSON.stringify({ id, active: true })
        });
        const data = await response.json();
        if (data.success) {
          showToast(`${name} restored`, 'success');
          setTimeout(() => window.location.reload(), 1000);
        } else {
          showToast(data.error || 'Failed to restore crew lead', 'error');
        }
      } catch (err) {
        showToast('Failed to restore. Please try again.', 'error');
      }
    }

    function openAddModal() {
      document.getElementById('modalTitle').textContent = 'Add Crew Lead';
      document.getElementById('crewId').value = '';
      document.getElementById('crewName').value = '';
      document.getElementById('crewEmail').value = '';
      document.getElementById('crewPhone').value = '';
      document.getElementById('crewModal').classList.add('active');
    }

    // Tab switching
    function switchTab(tab) {
      document.getElementById('panelMembers').classList.toggle('active', tab === 'members');
      document.getElementById('panelTimesheets').classList.toggle('active', tab === 'timesheets');
      document.getElementById('tabMembers').classList.toggle('active', tab === 'members');
      document.getElementById('tabTimesheets').classList.toggle('active', tab === 'timesheets');
      document.getElementById('addCrewBtn').style.display = tab === 'members' ? '' : 'none';
      if (tab === 'timesheets') initTimesheets();
    }
    window.switchTab = switchTab;

    // Show/hide hourly vs salaried fields based on the pay-model select.
    function syncPayModelFields() {
      const model = document.getElementById('crewPayModel').value;
      const hourly = document.getElementById('hourlyFields');
      const salaried = document.getElementById('salariedFields');
      if (model === 'salaried_daily') {
        hourly.style.display = 'none';
        salaried.style.display = '';
      } else {
        hourly.style.display = '';
        salaried.style.display = 'none';
      }
      updateSalaryDailyTotal();
    }
    window.syncPayModelFields = syncPayModelFields;

    function updateSalaryDailyTotal() {
      const h = parseFloat(document.getElementById('crewSalaryDailyHours').value) || 0;
      const r = parseFloat(document.getElementById('crewSalaryDailyRate').value) || 0;
      document.getElementById('crewSalaryDailyTotal').textContent = `$${(h * r).toFixed(2)}/day`;
    }
    document.getElementById('crewSalaryDailyHours')?.addEventListener('input', updateSalaryDailyTotal);
    document.getElementById('crewSalaryDailyRate')?.addEventListener('input', updateSalaryDailyTotal);

    function openAddModal() {
      document.getElementById('modalTitle').textContent = 'Add Crew Member';
      document.getElementById('crewId').value = '';
      document.getElementById('crewName').value = '';
      document.getElementById('crewEmail').value = '';
      document.getElementById('crewPhone').value = '';
      document.getElementById('crewPayModel').value = 'hourly';
      document.getElementById('crewRate').value = '';
      document.getElementById('crewSalaryDailyHours').value = '8';
      document.getElementById('crewSalaryDailyRate').value = '';
      document.getElementById('crewBonusStart').value = '';
      document.getElementById('crewIsDriver').checked = false;
      syncPayModelFields();
      document.getElementById('crewModal').classList.add('active');
    }

    function openEditModal(id, name, email, phone, rate, bonusStart, isDriver, payModel, salaryDailyHours, salaryDailyRate) {
      document.getElementById('modalTitle').textContent = 'Edit Crew Member';
      document.getElementById('crewId').value = id;
      document.getElementById('crewName').value = name;
      document.getElementById('crewEmail').value = email || '';
      document.getElementById('crewPhone').value = phone;
      document.getElementById('crewPayModel').value = payModel || 'hourly';
      document.getElementById('crewRate').value = rate || '';
      document.getElementById('crewSalaryDailyHours').value = salaryDailyHours || '8';
      document.getElementById('crewSalaryDailyRate').value = salaryDailyRate || '';
      document.getElementById('crewBonusStart').value = bonusStart || '';
      document.getElementById('crewIsDriver').checked = !!isDriver;
      syncPayModelFields();
      document.getElementById('crewModal').classList.add('active');
    }

    function closeModal() {
      document.getElementById('crewModal').classList.remove('active');
    }

    // ===== Materials / gear issuance log =====
    function escapeHtmlMat(s) {
      return String(s == null ? '' : s)
        .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }
    function todayIso() {
      // Local date as YYYY-MM-DD (avoids UTC off-by-one on the date input).
      const d = new Date();
      const off = d.getTimezoneOffset();
      const local = new Date(d.getTime() - off * 60000);
      return local.toISOString().slice(0, 10);
    }
    function openMaterialsModal(crewId, crewName) {
      document.getElementById('materialsCrewId').value = String(crewId);
      document.getElementById('materialsCrewName').textContent = crewName || '';
      document.getElementById('matItem').value = '';
      document.getElementById('matCategory').value = '';
      document.getElementById('matQty').value = '1';
      document.getElementById('matDate').value = todayIso();
      document.getElementById('matNote').value = '';
      document.getElementById('materialsModal').classList.add('active');
      loadMaterials(crewId);
    }
    window.openMaterialsModal = openMaterialsModal;

    function closeMaterialsModal() {
      document.getElementById('materialsModal').classList.remove('active');
    }
    window.closeMaterialsModal = closeMaterialsModal;

    function fmtMatDate(s) {
      if (!s) return '—';
      const d = new Date(String(s) + 'T00:00:00');
      return isNaN(d.getTime()) ? s : d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
    }

    async function loadMaterials(crewId) {
      const list = document.getElementById('materialsList');
      list.innerHTML = '<div style="font-size:13px; color:var(--color-text-secondary); font-style:italic;">Loading…</div>';
      try {
        const res = await fetch(`/api/admin/crew/materials/?crew_lead_id=${crewId}`, { credentials: 'include' });
        const data = await res.json();
        if (!data.success) { list.innerHTML = '<div style="font-size:13px; color:#fca5a5;">Failed to load.</div>'; return; }
        const items = data.materials || [];
        if (items.length === 0) {
          list.innerHTML = '<div style="font-size:13px; color:var(--color-text-secondary); font-style:italic;">Nothing issued yet.</div>';
          return;
        }
        list.innerHTML = items.map(m => `
          <div style="display:flex; align-items:center; gap:10px; padding:8px 10px; background:rgba(255,255,255,0.03); border:1px solid var(--glass-border); border-radius:8px;">
            <div style="flex:1; min-width:0;">
              <div style="font-size:14px; font-weight:600; color:var(--color-text-primary);">
                ${m.quantity && Number(m.quantity) !== 1 ? `<span style="color:var(--color-text-secondary);">${Number(m.quantity)}×</span> ` : ''}${escapeHtmlMat(m.item)}
                ${m.category ? `<span style="margin-left:6px; font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:0.3px; padding:1px 6px; border-radius:999px; background:rgba(99,102,241,0.18); color:#a5b4fc;">${escapeHtmlMat(m.category)}</span>` : ''}
              </div>
              <div style="font-size:12px; color:var(--color-text-secondary); margin-top:2px;">
                ${fmtMatDate(m.date_given)}${m.note ? ' · ' + escapeHtmlMat(m.note) : ''}
              </div>
            </div>
            <button onclick="deleteMaterial(${m.id})" title="Remove" style="background:transparent; border:1px solid rgba(239,68,68,0.4); color:#fca5a5; width:28px; height:28px; border-radius:6px; cursor:pointer; flex-shrink:0;">×</button>
          </div>
        `).join('');
      } catch {
        list.innerHTML = '<div style="font-size:13px; color:#fca5a5;">Failed to load.</div>';
      }
    }
    window.loadMaterials = loadMaterials;

    async function addMaterial() {
      const crewId = Number(document.getElementById('materialsCrewId').value);
      const item = document.getElementById('matItem').value.trim();
      if (!item) { showToast('Enter an item name', 'error'); return; }
      const btn = document.getElementById('matAddBtn');
      btn.disabled = true;
      try {
        const res = await fetch('/api/admin/crew/materials/', {
          method: 'POST', credentials: 'include',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            crew_lead_id: crewId,
            item,
            category: document.getElementById('matCategory').value.trim(),
            quantity: Number(document.getElementById('matQty').value) || 1,
            date_given: document.getElementById('matDate').value || null,
            note: document.getElementById('matNote').value.trim(),
          }),
        });
        const data = await res.json();
        if (!data.success) { showToast(data.error || 'Failed to add', 'error'); btn.disabled = false; return; }
        // Reset the item/qty/note for fast repeat entry; keep category + date.
        document.getElementById('matItem').value = '';
        document.getElementById('matQty').value = '1';
        document.getElementById('matNote').value = '';
        document.getElementById('matItem').focus();
        showToast('Item added');
        loadMaterials(crewId);
      } catch {
        showToast('Failed to add', 'error');
      } finally {
        btn.disabled = false;
      }
    }
    window.addMaterial = addMaterial;

    async function deleteMaterial(id) {
      try {
        const res = await fetch(`/api/admin/crew/materials/?id=${id}`, { method: 'DELETE', credentials: 'include' });
        const data = await res.json();
        if (!data.success) { showToast(data.error || 'Failed to remove', 'error'); return; }
        loadMaterials(Number(document.getElementById('materialsCrewId').value));
      } catch {
        showToast('Failed to remove', 'error');
      }
    }
    window.deleteMaterial = deleteMaterial;

    async function saveCrew() {
      const id = document.getElementById('crewId').value;
      const name = document.getElementById('crewName').value.trim();
      const email = document.getElementById('crewEmail').value.trim();
      const phone = document.getElementById('crewPhone').value.trim();
      const payModel = document.getElementById('crewPayModel').value;
      const rate = parseFloat(document.getElementById('crewRate').value) || 0;
      const salaryDailyHours = parseFloat(document.getElementById('crewSalaryDailyHours').value) || 8;
      const salaryDailyRate = parseFloat(document.getElementById('crewSalaryDailyRate').value) || 0;
      const bonusStart = document.getElementById('crewBonusStart').value.trim();
      const isDriver = document.getElementById('crewIsDriver').checked;

      if (!name || !phone) {
        showToast('Name and phone are required', 'error');
        return;
      }
      if (payModel === 'salaried_daily' && (salaryDailyHours <= 0 || salaryDailyRate <= 0)) {
        showToast('Salaried crew need a daily-hours and daily-rate value', 'error');
        return;
      }

      const btn = document.getElementById('saveBtn');
      btn.disabled = true;
      btn.textContent = 'Saving...';

      try {
        const method = id ? 'PATCH' : 'POST';
        const base = {
          name, email: email || null, phone,
          hourly_rate: rate,
          pay_model: payModel,
          salary_daily_hours: salaryDailyHours,
          salary_daily_rate: salaryDailyRate,
          bonus_start_date: bonusStart || null,
          is_driver: isDriver,
        };
        const payload = id ? { id: parseInt(id), ...base } : base;

        const response = await fetch('/api/crew-leads/', {
          method,
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        const data = await response.json();

        if (data.success) {
          showToast(id ? 'Crew member updated' : 'Crew member added', 'success');
          setTimeout(() => window.location.reload(), 1000);
        } else {
          showToast(data.error || 'Failed to save', 'error');
          btn.disabled = false;
          btn.textContent = 'Save';
        }
      } catch {
        showToast('Failed to save. Please try again.', 'error');
        btn.disabled = false;
        btn.textContent = 'Save';
      }
    }

    // =====================================================
    // TIMESHEETS
    // =====================================================
    let currentWeekStart = null;

    function getSundayOf(date) {
      const d = new Date(date + 'T12:00:00Z'); // noon UTC avoids timezone shift
      const day = d.getUTCDay(); // 0=Sun, 1=Mon, ... 6=Sat
      // Pay week starts Sunday, runs Sun → Sat (7 days)
      d.setUTCDate(d.getUTCDate() - day);
      return d.toISOString().slice(0, 10);
    }

    function addDays(dateStr, days) {
      const d = new Date(dateStr + 'T12:00:00Z');
      d.setUTCDate(d.getUTCDate() + days);
      return d.toISOString().slice(0, 10);
    }

    function fmtDate(dateStr) {
      const d = new Date(dateStr + 'T12:00:00Z');
      return d.toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric', timeZone: 'UTC' });
    }

    function fmtTime(dtStr) {
      if (!dtStr) return '—';
      // Normalize "T8:00" → "T08:00"
      let s = dtStr.replace(/T(\d):/, 'T0$1:');
      // Parse as ET (no Z suffix — treat as local time)
      s = s.replace('Z', '');
      const d = new Date(s);
      if (isNaN(d.getTime())) return dtStr;
      return d.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit', hour12: true, timeZone: 'America/New_York' });
    }

    function fmtHours(mins) {
      const h = Math.floor(mins / 60);
      const m = mins % 60;
      return `${h}h ${m.toString().padStart(2,'0')}m`;
    }

    function initTimesheets() {
      if (currentWeekStart) return; // already initialized
      const today = new Date().toISOString().slice(0, 10);
      currentWeekStart = getSundayOf(today);
      document.getElementById('weekPicker').value = currentWeekStart;
      updateWeekLabel();
      // Auto-load when date picker changes
      document.getElementById('weekPicker').addEventListener('change', () => loadTimesheets());
      loadTimesheets();
    }

    function updateWeekLabel() {
      const end = addDays(currentWeekStart, 6);
      document.getElementById('weekRangeLabel').textContent = `${fmtDate(currentWeekStart)} – ${fmtDate(end)}`;
    }

    function prevWeek() {
      currentWeekStart = addDays(currentWeekStart, -7);
      document.getElementById('weekPicker').value = currentWeekStart;
      updateWeekLabel();
      loadTimesheets();
    }
    window.prevWeek = prevWeek;

    function nextWeek() {
      currentWeekStart = addDays(currentWeekStart, 7);
      document.getElementById('weekPicker').value = currentWeekStart;
      updateWeekLabel();
      loadTimesheets();
    }
    window.nextWeek = nextWeek;

    async function loadTimesheets() {
      const picker = document.getElementById('weekPicker').value;
      if (picker) currentWeekStart = getSundayOf(picker);
      updateWeekLabel();

      const summaryBody = document.getElementById('summaryBody');
      const logsBody = document.getElementById('logsBody');
      const expensesBody = document.getElementById('expensesBody');
      const expensesTotal = document.getElementById('expensesTotal');
      const companyExpensesBody = document.getElementById('companyExpensesBody');
      const companyExpensesTotal = document.getElementById('companyExpensesTotal');
      const deductionsBody = document.getElementById('deductionsBody');
      const deductionsTotal = document.getElementById('deductionsTotal');
      summaryBody.innerHTML = '<tr><td colspan="9" style="text-align:center;padding:16px;color:var(--color-text-secondary);">Loading...</td></tr>';
      logsBody.innerHTML = '<tr><td colspan="7" style="text-align:center;padding:16px;color:var(--color-text-secondary);">Loading...</td></tr>';
      expensesBody.innerHTML = '<tr><td colspan="6" style="text-align:center;padding:16px;color:var(--color-text-secondary);">Loading...</td></tr>';
      companyExpensesBody.innerHTML = '<tr><td colspan="6" style="text-align:center;padding:16px;color:var(--color-text-secondary);">Loading...</td></tr>';
      deductionsBody.innerHTML = '<tr><td colspan="6" style="text-align:center;padding:16px;color:var(--color-text-secondary);">Loading...</td></tr>';

      const weekEnd = addDays(currentWeekStart, 6);

      try {
        // Fetch time logs + expenses in parallel
        const [timeRes, expRes] = await Promise.all([
          fetch(`/api/admin/crew/timelogs/?week_start=${currentWeekStart}`, { credentials: 'include' }),
          fetch(`/api/admin/crew/expenses/?week_start=${currentWeekStart}&week_end=${weekEnd}`, { credentials: 'include' }),
        ]);
        const data = await timeRes.json();
        const expData = await expRes.json();
        if (!data.success) { showToast(data.error || 'Failed to load', 'error'); return; }

        const allExpenses = (expData.success ? expData.expenses : []) || [];
        // Three buckets:
        //   reimbursable (paid_with='crew'): adds to paycheck
        //   company-card: tracked separately, no pay impact
        //   deduction:    subtracted from paycheck (admin paid for something on crew's behalf)
        const expenses = allExpenses.filter(e => e.paid_with !== 'company_card' && e.paid_with !== 'deduction');
        const companyExpenses = allExpenses.filter(e => e.paid_with === 'company_card');
        const deductions = allExpenses.filter(e => e.paid_with === 'deduction');

        const expenseByCrew = {};
        let totalExpenses = 0;
        for (const exp of expenses) {
          expenseByCrew[exp.crew_lead_id] = (expenseByCrew[exp.crew_lead_id] || 0) + exp.amount;
          totalExpenses += exp.amount;
        }
        const deductionByCrew = {};
        let totalDeductions = 0;
        for (const ded of deductions) {
          deductionByCrew[ded.crew_lead_id] = (deductionByCrew[ded.crew_lead_id] || 0) + ded.amount;
          totalDeductions += ded.amount;
        }
        let totalCompanyExpenses = 0;
        for (const exp of companyExpenses) totalCompanyExpenses += exp.amount;

        // Summary table
        if (!data.summary || data.summary.length === 0) {
          summaryBody.innerHTML = '<tr><td colspan="9" style="text-align:center;padding:24px;color:var(--color-text-secondary);">No time tracked this week</td></tr>';
        } else {
          summaryBody.innerHTML = data.summary.map(s => {
            const isSalaried = s.pay_model === 'salaried_daily';
            const rawHours = isSalaried ? '—' : `${(s.raw_minutes / 60).toFixed(1)}h`;
            // Paid hours = payable_minutes (for salaried = 7 × daily_hours × 60)
            const paidMins = s.payable_minutes ?? s.total_minutes;
            const extraMins = s.extra_minutes ?? 0;
            const driverMins = s.driver_bonus_minutes || 0;
            const driverDays = s.driver_bonus_days || 0;
            const paidHours = fmtHours(paidMins);
            const driverNote = driverMins > 0
              ? `<div style="color:#a5b4fc; font-size:11px; margin-top:2px;">incl +${driverMins / 60}h driver (${driverDays}d)</div>`
              : '';
            const extraNote = extraMins > 0
              ? `<div style="color:var(--color-text-secondary); font-size:11px; margin-top:2px;">+${extraMins}m unpaid</div>`
              : '';
            const salariedNote = isSalaried
              ? `<div style="color:#a5b4fc; font-size:11px; margin-top:2px;">salaried · ${s.salary_daily_hours}h × 7 days</div>`
              : '';
            const rateCell = isSalaried
              ? `$${Number(s.salary_daily_rate).toFixed(2)}/hr <span style="color:var(--color-text-secondary); font-size:11px;">(salaried)</span>`
              : `$${Number(s.hourly_rate).toFixed(2)}/hr`;
            const isClockedIn = data.logs.some(l => l.crew_lead_id === s.crew_lead_id && !l.clock_out);
            const crewExpenses = expenseByCrew[s.crew_lead_id] || 0;
            const crewDeductions = deductionByCrew[s.crew_lead_id] || 0;
            const totalPayout = s.total_pay + crewExpenses - crewDeductions;
            const dedCell = crewDeductions > 0
              ? `<span style="color:#fca5a5;">−$${crewDeductions.toFixed(2)}</span>`
              : '<span style="color:var(--color-text-secondary);">—</span>';
            return `<tr>
              <td>${isClockedIn ? '<span class="clocked-in-dot"></span>' : ''}${esc(s.name)}${isSalaried ? ' <span style="font-size:10px; padding:1px 6px; border-radius:999px; background:rgba(99,102,241,0.18); color:#a5b4fc; font-weight:600; text-transform:uppercase; letter-spacing:0.5px;">Salaried</span>' : ''}</td>
              <td style="color:var(--color-text-secondary);">${rawHours}</td>
              <td><strong>${paidHours}</strong>${salariedNote}${driverNote}${extraNote}</td>
              <td>${rateCell}</td>
              <td>$${Number(s.total_pay).toFixed(2)}</td>
              <td>${crewExpenses > 0 ? '$' + crewExpenses.toFixed(2) : '<span style="color:var(--color-text-secondary);">—</span>'}</td>
              <td>${dedCell}</td>
              <td class="pay-amount">$${totalPayout.toFixed(2)}</td>
              <td style="color:var(--color-text-secondary);font-size:12px;">Pay ${fmtDate(addDays(currentWeekStart, 11))}</td>
            </tr>`;
          }).join('');
        }

        // Render expenses table
        if (expenses.length === 0) {
          expensesBody.innerHTML = '<tr><td colspan="6" style="text-align:center;padding:24px;color:var(--color-text-secondary);">No expenses this week</td></tr>';
          expensesTotal.textContent = '';
        } else {
          expensesTotal.textContent = `Total: $${totalExpenses.toFixed(2)}`;
          const isMob = window.innerWidth <= 768;
          expensesBody.innerHTML = expenses.map(e => {
            const nameDisp = isMob ? esc(e.crew_name).split(' ').map(w => w[0]).join('') : esc(e.crew_name);
            const receiptIcon = e.receipt_url
              ? `<button onclick="showReceipt('${esc(e.receipt_url)}')" title="View receipt" style="background:none; border:none; color:var(--color-primary); cursor:pointer; padding:4px;"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg></button>`
              : '<span style="color:var(--color-text-secondary); opacity:0.3;">—</span>';
            return `<tr>
              <td title="${esc(e.crew_name)}">${nameDisp}</td>
              <td>${fmtDate(e.work_date)}</td>
              <td style="font-weight:600;">$${Number(e.amount).toFixed(2)}</td>
              <td>${esc(e.description || '')}</td>
              <td style="text-align:center;">${receiptIcon}</td>
              <td style="white-space:nowrap;">
                <button class="btn-edit-log" onclick='editExpense(${JSON.stringify(e).replace(/'/g, "\\u0027")})'>Edit</button>
                <button class="btn-delete-log" style="margin-left:4px;" onclick="deleteExpense(${e.id})">Del</button>
              </td>
            </tr>`;
          }).join('');
        }

        // Company Expenses (paid with company card — not added to payout)
        if (companyExpenses.length === 0) {
          companyExpensesBody.innerHTML = '<tr><td colspan="6" style="text-align:center;padding:24px;color:var(--color-text-secondary);">No company-card expenses this week</td></tr>';
          companyExpensesTotal.textContent = '';
        } else {
          companyExpensesTotal.textContent = `Total: $${totalCompanyExpenses.toFixed(2)}`;
          const isMobC = window.innerWidth <= 768;
          companyExpensesBody.innerHTML = companyExpenses.map(e => {
            const nameDisp = isMobC ? esc(e.crew_name).split(' ').map(w => w[0]).join('') : esc(e.crew_name);
            const receiptIcon = e.receipt_url
              ? `<button onclick="showReceipt('${esc(e.receipt_url)}')" title="View receipt" style="background:none; border:none; color:var(--color-primary); cursor:pointer; padding:4px;"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg></button>`
              : '<span style="color:var(--color-text-secondary); opacity:0.3;">—</span>';
            return `<tr>
              <td title="${esc(e.crew_name)}">${nameDisp}</td>
              <td>${fmtDate(e.work_date)}</td>
              <td style="font-weight:600;">$${Number(e.amount).toFixed(2)}</td>
              <td>${esc(e.description || '')}</td>
              <td style="text-align:center;">${receiptIcon}</td>
              <td style="white-space:nowrap;">
                <button class="btn-edit-log" onclick='editExpense(${JSON.stringify(e).replace(/'/g, "\\u0027")})'>Edit</button>
                <button class="btn-delete-log" style="margin-left:4px;" onclick="deleteExpense(${e.id})">Del</button>
              </td>
            </tr>`;
          }).join('');
        }

        // Deductions (admin paid for something on crew's behalf — subtracted from paycheck)
        if (deductions.length === 0) {
          deductionsBody.innerHTML = '<tr><td colspan="6" style="text-align:center;padding:24px;color:var(--color-text-secondary);">No deductions this week</td></tr>';
          deductionsTotal.textContent = '';
        } else {
          deductionsTotal.textContent = `Total: −$${totalDeductions.toFixed(2)}`;
          const isMobD = window.innerWidth <= 768;
          deductionsBody.innerHTML = deductions.map(e => {
            const nameDisp = isMobD ? esc(e.crew_name).split(' ').map(w => w[0]).join('') : esc(e.crew_name);
            const receiptIcon = e.receipt_url
              ? `<button onclick="showReceipt('${esc(e.receipt_url)}')" title="View receipt" style="background:none; border:none; color:var(--color-primary); cursor:pointer; padding:4px;"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg></button>`
              : '<span style="color:var(--color-text-secondary); opacity:0.3;">—</span>';
            return `<tr>
              <td title="${esc(e.crew_name)}">${nameDisp}</td>
              <td>${fmtDate(e.work_date)}</td>
              <td style="font-weight:600; color:#fca5a5;">−$${Number(e.amount).toFixed(2)}</td>
              <td>${esc(e.description || '')}</td>
              <td style="text-align:center;">${receiptIcon}</td>
              <td style="white-space:nowrap;">
                <button class="btn-edit-log" onclick='editExpense(${JSON.stringify(e).replace(/'/g, "\\u0027")})'>Edit</button>
                <button class="btn-delete-log" style="margin-left:4px;" onclick="deleteExpense(${e.id})">Del</button>
              </td>
            </tr>`;
          }).join('');
        }

        // Detailed logs
        if (!data.logs || data.logs.length === 0) {
          logsBody.innerHTML = '<tr><td colspan="7" style="text-align:center;padding:24px;color:var(--color-text-secondary);">No shifts logged this week</td></tr>';
          document.getElementById('logsCount').textContent = '';
        } else {
          document.getElementById('logsCount').textContent = `${data.logs.length} shift${data.logs.length !== 1 ? 's' : ''}`;
          const isMobile = window.innerWidth <= 768;
          logsBody.innerHTML = data.logs.map(l => {
            const isOpen = !l.clock_out;
            const rawMins = isOpen ? null : Math.floor((new Date(l.clock_out) - new Date(l.clock_in)) / 60000);
            // Client-side mirror of the auto-lunch rule (240 min → −30). Keep
            // in sync with AUTO_LUNCH_* in src/lib/crewPay.ts (pending Manny's review).
            const mins = rawMins !== null && rawMins >= 240 ? rawMins - 30 : rawMins;
            // Use initials on mobile
            const nameDisplay = isMobile ? esc(l.crew_name).split(' ').map(w => w[0]).join('') : esc(l.crew_name);
            // Auto-closed shifts (crew forgot to clock out → capped at 17h) get a
            // red note so they're easy to spot, plus a "Compare day" button to
            // line up everyone who worked that date and fix the clock-out.
            const autoClosed = (l.notes || '').includes('[auto-closed');
            const noteHtml = esc(l.notes || '').replace(/(\[auto-closed[^\]]*\])/g, '<span style="color:#f87171; font-weight:700;">$1</span>');
            return `<tr data-date="${esc(l.work_date)}"${autoClosed ? ' class="log-autoclosed"' : ''}>
              <td title="${esc(l.crew_name)}">${nameDisplay}</td>
              <td>${fmtDate(l.work_date)}</td>
              <td>${fmtTime(l.clock_in)}</td>
              <td class="${isOpen ? 'log-open' : ''}">${isOpen ? 'Active' : fmtTime(l.clock_out)}</td>
              <td>${mins !== null ? fmtHours(mins) : '—'}</td>
              <td style="font-size:12px; color:var(--color-text-secondary);">${noteHtml}</td>
              <td style="white-space:nowrap;">
                <button class="btn-edit-log" onclick="editLog(${l.id}, '${l.clock_in}', '${l.clock_out || ''}', '${esc(l.notes||'')}')">Edit</button>
                <button class="btn-delete-log" style="margin-left:4px;" onclick="deleteLog(${l.id})">Del</button>
                ${autoClosed ? `<button class="btn-compare-day" style="margin-left:4px; padding:6px 10px; background:rgba(245,158,11,0.15); border:1px solid rgba(245,158,11,0.4); border-radius:var(--radius-md); color:#fcd34d; font-size:12px; font-weight:600; cursor:pointer; white-space:nowrap;" onclick="compareDay('${esc(l.work_date)}')" title="Show everyone who worked this day so you can match the clock-out">Compare day</button>` : ''}
              </td>
            </tr>`;
          }).join('');
        }
      } catch { showToast('Failed to load timesheets', 'error'); }
    }
    window.loadTimesheets = loadTimesheets;

    function esc(str) {
      return String(str || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    // Edit shift modal
    function editLog(id, clockIn, clockOut, notes) {
      document.getElementById('editShiftId').value = id;
      document.getElementById('editShiftNotes').value = notes || '';

      // Parse date and times from the datetime strings
      const inStr = (clockIn || '').replace('Z','');
      const outStr = (clockOut || '').replace('Z','');
      const date = inStr.slice(0, 10);
      const inTime = inStr.includes('T') ? inStr.split('T')[1].slice(0, 5) : '';
      const outTime = outStr.includes('T') ? outStr.split('T')[1].slice(0, 5) : '';

      document.getElementById('editShiftDate').value = date;

      // Populate time dropdowns
      populateTimeSelect(document.getElementById('editShiftClockIn'), false);
      populateTimeSelect(document.getElementById('editShiftClockOut'), true);

      // Set selected values
      document.getElementById('editShiftClockIn').value = inTime;
      document.getElementById('editShiftClockOut').value = outTime;

      document.getElementById('editShiftModal').classList.add('active');
    }
    window.editLog = editLog;

    function closeEditShiftModal() {
      document.getElementById('editShiftModal').classList.remove('active');
    }
    window.closeEditShiftModal = closeEditShiftModal;

    async function saveEditShift() {
      const id = document.getElementById('editShiftId').value;
      const date = document.getElementById('editShiftDate').value;
      const clockIn = document.getElementById('editShiftClockIn').value;
      const clockOut = document.getElementById('editShiftClockOut').value;
      const notes = document.getElementById('editShiftNotes').value.trim();

      if (!date || !clockIn) { showToast('Date and clock-in are required', 'error'); return; }

      const btn = document.getElementById('saveEditShiftBtn');
      btn.disabled = true; btn.textContent = 'Saving...';

      const clockInDT = `${date}T${clockIn}:00`;
      const clockOutDT = clockOut ? `${date}T${clockOut}:00` : null;

      try {
        const res = await fetch('/api/admin/crew/timelogs/', {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'include',
          body: JSON.stringify({ id: parseInt(id), clock_in: clockInDT, clock_out: clockOutDT, work_date: date, notes: notes || null })
        });
        const data = await res.json();
        if (data.success) { closeEditShiftModal(); showToast('Shift updated'); loadTimesheets(); }
        else showToast(data.error || 'Failed to update', 'error');
      } catch { showToast('Error updating shift', 'error'); }
      finally { btn.disabled = false; btn.textContent = 'Save Changes'; }
    }
    window.saveEditShift = saveEditShift;

    function deleteLog(id) {
      window.showConfirmModal({
        title: 'Delete this shift log?',
        text: 'This cannot be undone.',
        confirmText: 'Delete log',
        type: 'danger',
        onConfirm: async () => {
          try {
            const res = await fetch(`/api/admin/crew/timelogs/?id=${id}`, { method: 'DELETE', credentials: 'include' });
            const data = await res.json();
            if (data.success) { showToast('Log deleted'); loadTimesheets(); }
            else showToast(data.error || 'Failed', 'error');
          } catch { showToast('Error', 'error'); }
        },
      });
    }
    window.deleteLog = deleteLog;

    // Compare day: filter the Shift Detail table to a single date so every crew
    // member who worked that day lines up — used to fix an auto-closed shift's
    // clock-out to match when co-workers signed off. Toggles off on second click.
    let _dayFilter = null;
    function compareDay(date) {
      const rows = document.querySelectorAll('#logsBody tr[data-date]');
      if (_dayFilter === date) {
        _dayFilter = null;
        rows.forEach(r => { r.style.display = ''; r.style.background = ''; });
        return;
      }
      _dayFilter = date;
      rows.forEach(r => {
        if (r.getAttribute('data-date') === date) { r.style.display = ''; r.style.background = 'rgba(245,158,11,0.12)'; }
        else { r.style.display = 'none'; r.style.background = ''; }
      });
      const first = document.querySelector('#logsBody tr[data-date="' + date + '"]');
      if (first) first.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }
    window.compareDay = compareDay;

