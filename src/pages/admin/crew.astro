    // =====================================================
    // CSV IMPORT
    // Format: name,date,clock_in,clock_out
    // Example: Abdiaz,2026-04-01,07:30,16:00
    // clock_out can be blank for open shifts
    // =====================================================
    async function importCSV(input) {
      const file = input.files[0];
      if (!file) return;
      input.value = ''; // reset so same file can be re-imported

      const text = await file.text();
      const lines = text.trim().split('\n').filter(l => l.trim());
      if (lines.length === 0) { showToast('CSV is empty', 'error'); return; }

      // Skip header row if it starts with "name" (case-insensitive)
      const dataLines = lines[0].toLowerCase().startsWith('name') ? lines.slice(1) : lines;
      if (dataLines.length === 0) { showToast('No data rows found in CSV', 'error'); return; }

      // Build crew name → id map from page
      const crewMap = {};
      document.querySelectorAll('.crew-card').forEach(card => {
        const id = card.dataset.id;
        const name = (card.querySelector('h3')?.textContent || '').trim().toLowerCase();
        if (id && name) crewMap[name] = parseInt(id);
      });

      let imported = 0, skipped = 0, errors = [];

      for (const line of dataLines) {
        const cols = line.split(',').map(c => c.trim().replace(/^"|"$/g, ''));
        const [name, date, clockIn, clockOut] = cols;
        if (!name || !date || !clockIn || clockIn.trim() === '') { skipped++; continue; }

        const crewId = crewMap[name.toLowerCase()];
        if (!crewId) { errors.push(`"${name}" not found`); skipped++; continue; }

        // Normalize time: "8:00" → "08:00", "7:30" → "07:30"
        function padTime(t) {
          if (!t) return '';
          const parts = t.split(':');
          if (parts.length < 2) return t;
          return `${parts[0].padStart(2,'0')}:${parts[1].padStart(2,'0')}`;
        }
        const normIn = padTime(clockIn);
        const normOut = padTime(clockOut);
        // Convert local ET to UTC (+4h EDT, +5h EST — use 4 for summer)
        // Store as local ET time (no UTC conversion)
        const clockInDT = `${date}T${normIn}:00`;
        const clockOutDT = normOut ? `${date}T${normOut}:00` : null;

        try {
          const res = await fetch('/api/admin/crew/timelogs/', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'include',
            body: JSON.stringify({ crew_lead_id: crewId, clock_in: clockInDT, clock_out: clockOutDT, work_date: date, notes: 'Imported', override: true })
          });
          const data = await res.json();
          if (data.success) imported++;
          else { skipped++; errors.push(data.error); }
        } catch { skipped++; }
      }

      if (errors.length > 0) console.warn('Import issues:', errors);
      showToast(`Imported ${imported} shift${imported !== 1 ? 's' : ''}${skipped > 0 ? `, ${skipped} skipped` : ''}`);
      if (imported > 0) loadTimesheets();
    }
    window.importCSV = importCSV;

    // Export week to CSV (works with Google Sheets + Excel)
    function exportWeekCSV() {
      const summaryBody = document.getElementById('summaryBody');
      const logsBody = document.getElementById('logsBody');
      if (!summaryBody || !logsBody) { showToast('No data to export', 'error'); return; }

      const weekEnd = addDays(currentWeekStart, 6);
      let csv = `MannyKnows - Weekly Timesheet\n`;
      csv += `Week: ${currentWeekStart} to ${weekEnd}\n\n`;

      // Pay Summary
      csv += `PAY SUMMARY\n`;
      csv += `Name,Raw Hours,Paid Hours,Rate,Gross Pay,Expenses,Total Payout\n`;
      summaryBody.querySelectorAll('tr').forEach(row => {
        const cells = row.querySelectorAll('td');
        if (cells.length >= 7) {
          const name = cells[0].textContent.trim();
          const rawH = cells[1].textContent.trim();
          const netH = cells[2].textContent.trim();
          const rate = cells[3].textContent.trim();
          const gross = cells[4].textContent.trim();
          const exp = cells[5].textContent.trim().replace('—', '$0.00');
          const total = cells[6].textContent.trim();
          csv += `"${name}",${rawH},${netH},"${rate}","${gross}","${exp}","${total}"\n`;
        }
      });

      csv += `\nSHIFT DETAIL\n`;
      csv += `Name,Date,Clock In,Clock Out,Duration,Notes\n`;
      logsBody.querySelectorAll('tr').forEach(row => {
        const cells = row.querySelectorAll('td');
        if (cells.length >= 6) {
          const vals = Array.from(cells).slice(0, 6).map(c => c.textContent.trim());
          csv += vals.map(v => `"${v}"`).join(',') + '\n';
        }
      });

      const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `timesheet-${currentWeekStart}.csv`;
      a.click();
      URL.revokeObjectURL(url);
      showToast('CSV exported');
    }
    window.exportWeekCSV = exportWeekCSV;

