---
// Admin Crew Leads Page - Glassmorphic Design
import { AdminAuth } from '../../lib/adminAuth';
import AdminNav from '../../components/AdminNav.astro';
import AdminPresence from '../../components/AdminPresence.astro';
import AdminMobileDrawer from '../../components/AdminMobileDrawer.astro';
import ConfirmModal from '../../components/ConfirmModal.astro';
import { computeBonus } from '../../lib/crewBonus';
import '../../styles/admin.css';

const env = Astro.locals.runtime?.env;
const sessionSecret = env?.SESSION_SECRET || env?.ADMIN_PASSWORD;
const session = await AdminAuth.validateSession(Astro.request, sessionSecret);

if (!session.isAuthenticated) {
  return Astro.redirect('/admin');
}
if (session.role === 'viewer') {
  return Astro.redirect('/admin/portfolios');
}

// Fetch all crew leads from D1
const db = env?.MK_APP_DB;
let crewLeads: any[] = [];
let archivedCrew: any[] = [];
let error = '';

if (db) {
  try {
    const result = await db.prepare(
      'SELECT * FROM crew_leads WHERE active = 1 ORDER BY name ASC'
    ).all();
    crewLeads = result.results || [];
    const archived = await db.prepare(
      'SELECT * FROM crew_leads WHERE active = 0 ORDER BY name ASC'
    ).all();
    archivedCrew = archived.results || [];
  } catch (e) {
    error = 'Failed to load crew leads';
    console.error('Crew leads fetch error:', e);
  }
} else {
  error = 'Database not configured';
}
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Crew Leads | MannyKnows Admin</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <meta name="robots" content="noindex, nofollow">
  <script>
    // Theme init - runs before CSS to prevent flash
    (function() {
      const theme = localStorage.getItem('admin-theme') || 'dark';
      document.documentElement.setAttribute('data-theme', theme);
    })();
  </script>
  <style>
    /* Page-specific styles */
    .admin-main {
      max-width: 1200px;
    }

    /* Search bar */
    .search-bar {
      background: var(--glass-bg);
      border: 1px solid var(--glass-border);
      border-radius: var(--radius-lg);
      padding: 10px 14px;
      margin-bottom: 16px;
      display: flex;
      gap: 10px;
      align-items: center;
      backdrop-filter: blur(10px);
    }

    .search-bar svg {
      color: var(--color-text-secondary);
      flex-shrink: 0;
    }

    .search-input {
      flex: 1;
      border: none;
      font-size: 14px;
      outline: none;
      background: transparent;
      color: var(--color-text-primary);
    }

    .search-input::placeholder {
      color: var(--color-text-secondary);
    }

    .crew-card.hidden {
      display: none;
    }

    .no-results {
      display: none;
      text-align: center;
      padding: 40px 24px;
      color: var(--color-text-secondary);
      background: var(--glass-bg);
      border: 1px solid var(--glass-border);
      border-radius: var(--radius-lg);
      font-size: 14px;
    }

    .no-results.visible {
      display: block;
    }

    .crew-list {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .crew-card {
      background: var(--glass-bg);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid var(--glass-border);
      border-radius: var(--radius-lg);
      padding: 24px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      transition: all 0.3s ease;
    }

    .crew-card:hover {
      background: var(--glass-bg-hover);
    }

    .crew-info h3 {
      font-size: 18px;
      font-weight: 600;
      margin-bottom: 8px;
      color: var(--color-text-primary);
    }

    .crew-contact {
      display: flex;
      gap: 16px;
      font-size: 14px;
      color: var(--color-text-secondary);
    }

    .crew-contact span {
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .crew-contact svg {
      opacity: 0.7;
    }

    .crew-actions {
      display: flex;
      gap: 10px;
    }

    /* Normalized to the shared admin button look (slim glass pill). */
    .btn-edit {
      padding: 9px 16px;
      background: var(--glass-bg);
      border: 1px solid var(--glass-border);
      border-radius: var(--radius-md);
      color: var(--color-text-primary);
      font-size: 13px;
      font-weight: 600;
      cursor: pointer;
      transition: background 0.18s ease, border-color 0.18s ease;
    }

    .btn-edit:hover {
      background: var(--glass-bg-hover);
    }

    /* Remove = red outline (matches the destructive button style). */
    .btn-delete {
      padding: 9px 16px;
      background: var(--glass-bg);
      border: 1px solid rgba(239, 68, 68, 0.4);
      border-radius: var(--radius-md);
      color: #fca5a5;
      font-size: 13px;
      font-weight: 600;
      cursor: pointer;
      transition: background 0.18s ease, border-color 0.18s ease;
    }

    .btn-delete:hover {
      border-color: rgba(239, 68, 68, 0.6);
      background: rgba(239, 68, 68, 0.12);
    }

    /* Empty state */
    .empty-state {
      text-align: center;
      padding: 60px 24px;
      background: var(--glass-bg);
      border: 1px solid var(--glass-border);
      border-radius: var(--radius-xl);
    }

    .empty-state svg {
      color: var(--color-text-secondary);
      opacity: 0.5;
      margin-bottom: 16px;
    }

    .empty-state h3 {
      font-size: 20px;
      color: var(--color-text-primary);
      margin-bottom: 8px;
    }

    .empty-state p {
      color: var(--color-text-secondary);
      margin-bottom: 24px;
    }

    /* Error */
    .error-banner {
      background: rgba(239, 68, 68, 0.1);
      border: 1px solid rgba(239, 68, 68, 0.3);
      color: #f87171;
      padding: 16px 20px;
      border-radius: var(--radius-md);
      margin-bottom: 24px;
    }

    /* Modal overrides — match Leads/Quotes modal width */
    .modal {
      background: linear-gradient(135deg, rgba(30, 41, 59, 0.98), rgba(15, 23, 42, 0.99));
      border: 1px solid var(--glass-border);
      max-width: 700px;
      width: 100%;
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
    }

    .form-group label {
      display: block;
      font-size: 13px;
      font-weight: 600;
      color: var(--color-text-secondary);
      margin-bottom: 8px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .form-group input {
      width: 100%;
      padding: 14px 16px;
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid var(--glass-border);
      border-radius: var(--radius-md);
      color: var(--color-text-primary);
      font-size: 14px;
      transition: all 0.2s ease;
    }

    .form-group input:focus {
      outline: none;
      border-color: var(--color-primary);
      box-shadow: 0 0 0 3px rgba(255, 120, 29, 0.2);
    }

    .form-group input::placeholder {
      color: var(--color-text-secondary);
    }

    .btn-cancel {
      padding: 12px 24px;
      background: var(--glass-bg);
      border: 1px solid var(--glass-border);
      border-radius: var(--radius-md);
      color: var(--color-text-primary);
      font-size: 14px;
      font-weight: 500;
      cursor: pointer;
      transition: all 0.2s;
    }

    .btn-cancel:hover {
      background: var(--glass-bg-hover);
    }

    .btn-save {
      padding: 12px 24px;
      background: linear-gradient(135deg, var(--color-primary), var(--color-primary-dark));
      color: white;
      border: none;
      border-radius: var(--radius-md);
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s;
      box-shadow: 0 4px 15px rgba(255, 120, 29, 0.3);
    }

    .btn-save:hover {
      box-shadow: 0 6px 20px rgba(255, 120, 29, 0.4);
    }

    .btn-save:disabled {
      opacity: 0.5;
      cursor: not-allowed;
      transform: none;
    }

    /* Confirm Modal */
    .confirm-modal {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.7);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 2000;
    }

    .confirm-modal.active {
      display: flex;
    }

    .confirm-content {
      background: var(--color-background-light);
      border-radius: var(--radius-xl);
      border: 1px solid var(--glass-border);
      padding: 32px;
      max-width: 400px;
      width: 90%;
      text-align: center;
      animation: modalSlideIn 0.2s ease-out;
    }

    .confirm-icon {
      width: 72px;
      height: 72px;
      border-radius: 50%;
      background: rgba(239, 68, 68, 0.1);
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 20px;
    }

    .confirm-title {
      font-size: 20px;
      font-weight: 700;
      color: var(--color-text-primary);
      margin-bottom: 10px;
    }

    .confirm-text {
      color: var(--color-text-secondary);
      font-size: 14px;
      margin-bottom: 28px;
      line-height: 1.5;
    }

    .confirm-actions {
      display: flex;
      gap: 12px;
      justify-content: center;
    }

    .confirm-actions .btn {
      padding: 12px 28px;
      border-radius: var(--radius-md);
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
      border: none;
      transition: all 0.2s;
    }

    .confirm-actions .btn-secondary {
      background: var(--glass-bg);
      border: 1px solid var(--glass-border);
      color: var(--color-text-primary);
    }

    .confirm-actions .btn-secondary:hover {
      background: var(--glass-bg-hover);
    }

    .confirm-actions .btn-danger {
      background: linear-gradient(135deg, #ef4444, #dc2626);
      color: white;
      box-shadow: 0 4px 15px rgba(239, 68, 68, 0.3);
    }

    .confirm-actions .btn-danger:hover {
      box-shadow: 0 6px 20px rgba(239, 68, 68, 0.4);
    }

    /* Tabs */
    .crew-tabs {
      display: flex;
      gap: 4px;
      background: var(--glass-bg);
      border: 1px solid var(--glass-border);
      border-radius: var(--radius-lg);
      padding: 4px;
      margin-bottom: 24px;
      width: fit-content;
    }

    .crew-tab {
      padding: 8px 20px;
      border-radius: 14px;
      border: none;
      background: transparent;
      color: var(--color-text-secondary);
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s;
    }

    .crew-tab.active {
      background: linear-gradient(135deg, var(--color-primary), var(--color-primary-dark));
      color: white;
    }

    .tab-panel { display: none; }
    .tab-panel.active { display: block; }

    /* Archived crew section */
    .archived-section { margin-top: 24px; }
    .archived-toggle {
      display: flex;
      align-items: center;
      gap: 6px;
      width: 100%;
      background: none;
      border: none;
      padding: 10px 0;
      color: var(--color-text-secondary);
      font-size: 13px;
      font-weight: 600;
      cursor: pointer;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    .archived-chevron { transition: transform 0.2s; }
    .archived-toggle[aria-expanded="true"] .archived-chevron { transform: rotate(90deg); }
    .archived-list { display: flex; flex-direction: column; gap: 12px; margin-top: 8px; }
    .archived-card { opacity: 0.7; }
    .archived-badge {
      margin-left: 12px;
      font-size: 11px;
      padding: 2px 8px;
      border-radius: 999px;
      background: rgba(148,163,184,0.18);
      color: #94a3b8;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    /* Hourly rate badge on crew card */
    .crew-rate {
      font-size: 13px;
      color: var(--color-text-secondary);
      display: flex;
      align-items: center;
      gap: 4px;
      margin-top: 4px;
    }

    .crew-rate strong { color: var(--color-primary); }

    /* WhatsApp link — same slim pill shape as the other crew buttons,
       keeping the WhatsApp-green tint. */
    .wa-link {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 9px 16px;
      background: rgba(37,211,102,0.15);
      border: 1px solid rgba(37,211,102,0.35);
      color: #25d366;
      border-radius: var(--radius-md);
      font-size: 13px;
      font-weight: 600;
      text-decoration: none;
    }
    .wa-link:hover { background: rgba(37,211,102,0.22); }

    /* Timesheets table */
    .timesheet-controls {
      display: flex;
      gap: 12px;
      align-items: center;
      margin-bottom: 20px;
      flex-wrap: wrap;
    }

    .week-picker {
      padding: 8px 14px;
      background: var(--glass-bg);
      border: 1px solid var(--glass-border);
      border-radius: var(--radius-md);
      color: var(--color-text-primary);
      font-size: 14px;
    }

    .week-label {
      font-size: 14px;
      color: var(--color-text-secondary);
      font-weight: 500;
    }

    /* Summary table */
    .summary-table-wrap {
      background: var(--glass-bg);
      border: 1px solid var(--glass-border);
      border-radius: var(--radius-lg);
      overflow: hidden;
      margin-bottom: 24px;
    }

    .summary-table-title {
      padding: 16px 20px;
      font-size: 13px;
      font-weight: 700;
      color: var(--color-text-secondary);
      text-transform: uppercase;
      letter-spacing: 0.5px;
      border-bottom: 1px solid var(--glass-border);
    }

    .summary-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 14px;
    }

    .summary-table th {
      padding: 14px 20px;
      text-align: left;
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: var(--color-text-secondary);
      border-bottom: 1px solid var(--glass-border);
      white-space: nowrap;
    }

    .summary-table td {
      padding: 16px 20px;
      border-bottom: 1px solid var(--glass-border);
      color: var(--color-text-primary);
      font-size: 14px;
      vertical-align: middle;
    }

    .summary-table tr:last-child td { border-bottom: none; }

    .summary-table tr:hover td { background: var(--glass-bg-hover); }

    .pay-amount {
      font-weight: 700;
      color: var(--color-success);
    }

    /* Logs table */
    .logs-table-wrap {
      background: var(--glass-bg);
      border: 1px solid var(--glass-border);
      border-radius: var(--radius-lg);
      overflow: hidden;
    }

    .logs-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 13px;
    }

    .logs-table th {
      padding: 12px 16px;
      text-align: left;
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: var(--color-text-secondary);
      border-bottom: 1px solid var(--glass-border);
      white-space: nowrap;
    }

    .logs-table td {
      padding: 13px 16px;
      border-bottom: 1px solid var(--glass-border);
      color: var(--color-text-primary);
      font-size: 14px;
      vertical-align: middle;
    }

    .logs-table tr:last-child td { border-bottom: none; }

    .logs-table tr:hover td { background: var(--glass-bg-hover); }

    .log-open { color: var(--color-success); font-style: italic; }

    .btn-edit-log {
      padding: 6px 12px;
      background: var(--glass-bg);
      border: 1px solid var(--glass-border);
      border-radius: var(--radius-md);
      color: var(--color-text-primary);
      font-size: 12px;
      font-weight: 500;
      cursor: pointer;
      transition: all 0.2s;
      white-space: nowrap;
    }
    /* Compare-day button + row highlight are styled inline in the JS render
       (logsBody is built via innerHTML, which Astro's scoped styles don't reach). */

    .btn-edit-log:hover {
      background: var(--glass-bg-hover);
      border-color: var(--color-primary);
      color: var(--color-primary);
    }

    .btn-delete-log {
      padding: 6px 12px;
      background: transparent;
      border: 1px solid var(--glass-border);
      border-radius: var(--radius-md);
      color: var(--color-text-secondary);
      font-size: 12px;
      font-weight: 500;
      cursor: pointer;
      transition: all 0.2s;
      white-space: nowrap;
    }

    .btn-delete-log:hover {
      border-color: var(--color-error);
      color: var(--color-error);
      background: rgba(239, 68, 68, 0.1);
    }

    /* Clocked-in now indicator */
    .clocked-in-dot {
      display: inline-block;
      width: 8px; height: 8px;
      border-radius: 50%;
      background: var(--color-success);
      box-shadow: 0 0 6px var(--color-success);
      margin-right: 6px;
    }

    /* Responsive */
    @media (max-width: 768px) {
      .crew-card {
        flex-direction: column;
        align-items: flex-start;
        gap: 16px;
      }

      .crew-actions { width: 100%; }
      .crew-actions button, .crew-actions a { flex: 1; }
      .crew-contact { flex-direction: column; gap: 4px; }

      /* Timesheet controls — stack vertically */
      .timesheet-controls {
        flex-direction: column !important;
        align-items: stretch !important;
        gap: 8px !important;
      }

      .timesheet-controls .week-label { text-align: center; }

      .timesheet-controls > div[style*="margin-left"] {
        margin-left: 0 !important;
        flex-wrap: wrap;
        justify-content: center;
      }

      /* Prev/Next buttons side by side, centered */
      .tc-nav-row { display: flex; gap: 8px; justify-content: center; }

      /* Summary table: horizontal scroll */
      .summary-table-wrap { overflow-x: auto; -webkit-overflow-scrolling: touch; }
      .summary-table { min-width: 700px; }
      .summary-table th, .summary-table td { padding: 10px 12px !important; font-size: 12px !important; white-space: nowrap; }

      /* Shift detail table: use initials on mobile, horizontal scroll */
      .logs-table-wrap { overflow-x: auto; -webkit-overflow-scrolling: touch; }
      .logs-table { min-width: 600px; }
      .logs-table th, .logs-table td { padding: 10px 8px !important; font-size: 12px !important; white-space: nowrap; }
    }

    /* Mobile Navigation */
    .mobile-nav-toggle {
      display: none;
      flex-direction: column;
      justify-content: center;
      gap: 5px;
      width: 40px;
      height: 40px;
      background: var(--glass-bg);
      border: 1px solid var(--glass-border);
      border-radius: var(--radius-md);
      cursor: pointer;
      padding: 10px;
      transition: all 0.2s ease;
    }

    .mobile-nav-toggle span {
      display: block;
      width: 100%;
      height: 2px;
      background: var(--color-text-primary);
      border-radius: 2px;
      transition: all 0.3s ease;
    }

    .mobile-nav-toggle:hover {
      background: var(--glass-bg-hover);
    }

    .mobile-nav-toggle.active span:nth-child(1) {
      transform: rotate(45deg) translate(5px, 5px);
    }

    .mobile-nav-toggle.active span:nth-child(2) {
      opacity: 0;
    }

    .mobile-nav-toggle.active span:nth-child(3) {
      transform: rotate(-45deg) translate(5px, -5px);
    }

    .mobile-nav-overlay {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: rgba(0, 0, 0, 0.5);
      z-index: 998;
      opacity: 0;
      transition: opacity 0.3s ease;
    }

    .mobile-nav-overlay.active {
      display: block;
      opacity: 1;
    }

    .mobile-nav-panel {
      position: fixed;
      top: 0;
      right: -300px;
      width: 280px;
      height: 100vh;
      background: var(--color-background);
      border-left: 1px solid var(--glass-border);
      z-index: 999;
      transition: right 0.3s ease;
      overflow-y: auto;
    }

    .mobile-nav-panel.active {
      right: 0;
    }

    .mobile-nav-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 16px 20px;
      border-bottom: 1px solid var(--glass-border);
    }

    .mobile-nav-title {
      font-size: 18px;
      font-weight: 600;
      color: var(--color-text-primary);
    }

    .mobile-nav-close {
      width: 36px;
      height: 36px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: var(--glass-bg);
      border: 1px solid var(--glass-border);
      border-radius: var(--radius-md);
      cursor: pointer;
      color: var(--color-text-primary);
      transition: all 0.2s ease;
    }

    .mobile-nav-close:hover {
      background: var(--glass-bg-hover);
    }

    .mobile-nav-links {
      padding: 16px;
    }

    .mobile-nav-link {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 14px 16px;
      color: var(--color-text-secondary);
      text-decoration: none;
      font-weight: 500;
      font-size: 15px;
      border-radius: var(--radius-md);
      transition: all 0.2s ease;
      margin-bottom: 4px;
    }

    .mobile-nav-link:hover {
      background: var(--glass-bg-hover);
      color: var(--color-text-primary);
    }

    .mobile-nav-link.active {
      background: linear-gradient(135deg, var(--color-primary), var(--color-primary-dark));
      color: white;
    }

    .mobile-nav-link svg {
      flex-shrink: 0;
    }

    .mobile-nav-divider {
      height: 1px;
      background: var(--glass-border);
      margin: 12px 0;
    }

    .mobile-nav-section-title {
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: var(--color-text-secondary);
      padding: 8px 16px 12px;
      opacity: 0.7;
    }

    @media (max-width: 1024px) {
      .mobile-nav-toggle {
        display: flex;
      }

      .admin-nav {
        display: none;
      }
    }
  </style>

  <style is:global>
    /* JS-rendered dynamic content styles */
    .btn-edit-log {
      padding: 6px 12px;
      background: var(--glass-bg);
      border: 1px solid var(--glass-border);
      border-radius: 8px;
      color: var(--color-text-primary);
      font-size: 12px;
      font-weight: 500;
      cursor: pointer;
      transition: all 0.2s;
      white-space: nowrap;
    }
    .btn-edit-log:hover { background: var(--glass-bg-hover); border-color: var(--color-primary); color: var(--color-primary); }

    .btn-delete-log {
      padding: 6px 12px;
      background: transparent;
      border: 1px solid var(--glass-border);
      border-radius: 8px;
      color: var(--color-text-secondary);
      font-size: 12px;
      font-weight: 500;
      cursor: pointer;
      transition: all 0.2s;
      white-space: nowrap;
    }
    .btn-delete-log:hover { border-color: #ef4444; color: #ef4444; background: rgba(239,68,68,0.1); }

    .pay-amount { font-weight: 700; color: #22c55e; }
    .clocked-in-dot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: #22c55e; box-shadow: 0 0 6px #22c55e; margin-right: 6px; }
    .log-open { color: #22c55e; font-style: italic; }

    /* Table row hover for dynamically rendered rows */
    .summary-table tbody tr:hover td { background: var(--glass-bg-hover); }
    .logs-table tbody tr:hover td { background: var(--glass-bg-hover); }

    /* Consistent column padding for alignment */
    .summary-table th,
    .logs-table th { padding: 14px 1rem !important; }
    .summary-table td { padding: 18px 1rem !important; }
    .logs-table td { padding: 14px 1rem !important; }
  </style>
</head>
<body>
  <AdminPresence />
  <header class="admin-header">
    <a href="/admin/dashboard" class="admin-logo-link">
      <div class="logo-gradient-wrapper"></div>
      <span class="admin-badge">Admin</span>
    </a>
    <AdminNav active="crew" />
    <!-- Mobile: Bell + Hamburger -->
    <div class="mobile-header-right">
      <div class="notification-bell-wrapper">
        <button class="btn-bell" id="bellBtnMobile" title="Customer Replies" aria-label="Customer Replies">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
          <span class="bell-badge bell-badge-mobile" style="display:none;">0</span>
        </button>
        <div class="bell-dropdown" id="bellDropdownMobile" style="display:none;">
          <div class="bell-dropdown-header"><span>Customer Replies</span><button class="bell-mark-all-read" onclick="markAllRead()">Mark all read</button></div>
          <div class="bell-dropdown-list" id="bellListMobile">
            <div class="bell-dropdown-empty">No new replies</div>
          </div>
        </div>
      </div>
      <button class="mobile-nav-toggle" id="mobileNavToggle" aria-label="Toggle navigation">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>

    <div class="header-actions">
      <button class="theme-toggle" id="themeToggle" onclick="toggleTheme()" title="Toggle theme">
        <svg class="icon-sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="5"/>
          <line x1="12" y1="1" x2="12" y2="3"/>
          <line x1="12" y1="21" x2="12" y2="23"/>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
          <line x1="1" y1="12" x2="3" y2="12"/>
          <line x1="21" y1="12" x2="23" y2="12"/>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
        </svg>
        <svg class="icon-moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
      </button>
      <div class="notification-bell-wrapper">
        <button class="btn-bell" id="bellBtn" title="Customer Replies" aria-label="Customer Replies">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
          <span class="bell-badge" id="bellBadge" style="display:none;">0</span>
        </button>
        <div class="bell-dropdown" id="bellDropdown" style="display:none;">
          <div class="bell-dropdown-header"><span>Customer Replies</span><button class="bell-mark-all-read" onclick="markAllRead()">Mark all read</button></div>
          <div class="bell-dropdown-list" id="bellList">
            <div class="bell-dropdown-empty">No new replies</div>
          </div>
        </div>
      </div>
      <button class="btn-logout" onclick="logout()">Logout</button>
    </div>
  </header>

  <AdminMobileDrawer active="crew" />

  <main class="admin-main">
    <div class="page-header">
      <div>
        <h1 class="page-title">Crew</h1>
        <p class="page-subtitle">Manage crew members and track their hours</p>
      </div>
      <button class="btn btn-primary" onclick="openAddModal()" id="addCrewBtn">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="12" y1="5" x2="12" y2="19"></line>
          <line x1="5" y1="12" x2="19" y2="12"></line>
        </svg>
        Add Crew Member
      </button>
    </div>

    {error && <div class="error-banner">{error}</div>}

    <!-- Tabs -->
    <div class="crew-tabs">
      <button class="crew-tab active" id="tabMembers" onclick="switchTab('members')">Crew Members</button>
      <button class="crew-tab" id="tabTimesheets" onclick="switchTab('timesheets')">Timesheets</button>
    </div>

    <!-- TAB 1: Crew Members -->
    <div class="tab-panel active" id="panelMembers">
      <div class="search-bar">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/>
        </svg>
        <input type="text" class="search-input" id="searchInput" placeholder="Search crew...">
      </div>

      <div class="no-results" id="noResults">No crew members match your search</div>

      <div class="crew-list" id="crewList">
        {crewLeads.length === 0 ? (
          <div class="empty-state">
            <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
              <circle cx="9" cy="7" r="4"/>
              <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
            </svg>
            <h3>No Crew Members Yet</h3>
            <p>Add your first crew member to get started</p>
          </div>
        ) : (
          crewLeads.map((lead) => {
            const phone = String(lead.phone || '').replace(/\D/g, '');
            const waPhone = phone.startsWith('1') ? phone : `1${phone}`;
            const waUrl = `https://wa.me/${waPhone}`;
            const isSalaried = lead.pay_model === 'salaried_daily';
            const dailyTotal = (Number(lead.salary_daily_hours) || 0) * (Number(lead.salary_daily_rate) || 0);
            const rate = isSalaried
              ? `Salaried · $${dailyTotal.toFixed(2)}/day`
              : (lead.hourly_rate ? `$${Number(lead.hourly_rate).toFixed(2)}/hr` : 'Rate not set');
            const bonus = computeBonus(lead.bonus_start_date);
            return (
              <div class="crew-card" data-id={lead.id} data-search={`${lead.name} ${lead.email || ''} ${lead.phone}`.toLowerCase()}>
                <div class="crew-info">
                  <h3>{lead.name}</h3>
                  <div class="crew-contact">
                    {lead.email && (
                      <span>
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                          <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                          <polyline points="22,6 12,13 2,6"/>
                        </svg>
                        {lead.email}
                      </span>
                    )}
                    <span>
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                      </svg>
                      {lead.phone}
                    </span>
                  </div>
                  <div class="crew-rate">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
                    <strong>{rate}</strong>
                    {bonus.startDate && (
                      <span style="margin-left:12px; font-size:12px; color:var(--color-text-secondary);" title={`Bonus accrued from ${bonus.startDate}; claimable on ${bonus.claimDate}`}>
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align:-1px; margin-right:4px;"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                        Bonus <strong style="color:#fbbf24;">${bonus.amount}</strong> <span style="opacity:0.7;">({bonus.days}d)</span>
                      </span>
                    )}
                    {lead.is_driver ? (
                      <span style="margin-left:12px; font-size:11px; padding:2px 8px; border-radius:999px; background:rgba(99,102,241,0.18); color:#a5b4fc; font-weight:600; text-transform:uppercase; letter-spacing:0.5px;" title="Driver — earns +1h per work day">
                        Driver
                      </span>
                    ) : null}
                  </div>
                </div>
                <div class="crew-actions">
                  <a href={waUrl} target="_blank" class="wa-link" title="Message on WhatsApp">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                    WhatsApp
                  </a>
                  <button class="btn-edit" onclick={`openMaterialsModal(${lead.id}, '${lead.name.replace(/'/g,"\\'")}')`} title="Track materials & gear given">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right:6px;"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
                    Materials
                  </button>
                  <button class="btn-edit" onclick={`openEditModal(${lead.id}, '${lead.name.replace(/'/g,"\\'")}', '${(lead.email||'').replace(/'/g,"\\'")}', '${lead.phone}', ${lead.hourly_rate || 0}, '${lead.bonus_start_date || ''}', ${lead.is_driver ? 1 : 0}, '${lead.pay_model || 'hourly'}', ${lead.salary_daily_hours || 8}, ${lead.salary_daily_rate || 0})`}>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right:6px;"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                    Edit
                  </button>
                  <button class="btn-delete" onclick={`deleteCrew(${lead.id}, '${lead.name.replace(/'/g,"\\'")}')`}>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right:6px;"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                    Remove
                  </button>
                </div>
              </div>
            );
          })
        )}
      </div>

      {archivedCrew.length > 0 && (
        <div class="archived-section">
          <button class="archived-toggle" type="button" onclick="toggleArchived()" aria-expanded="false">
            <svg class="archived-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
            Archived crew ({archivedCrew.length})
          </button>
          <div class="archived-list" id="archivedList" hidden>
            {archivedCrew.map((lead) => {
              const isSalaried = lead.pay_model === 'salaried_daily';
              const dailyTotal = (Number(lead.salary_daily_hours) || 0) * (Number(lead.salary_daily_rate) || 0);
              const rate = isSalaried
                ? `Salaried · $${dailyTotal.toFixed(2)}/day`
                : (lead.hourly_rate ? `$${Number(lead.hourly_rate).toFixed(2)}/hr` : 'Rate not set');
              return (
                <div class="crew-card archived-card" data-id={lead.id}>
                  <div class="crew-info">
                    <h3>{lead.name}</h3>
                    <div class="crew-contact">
                      {lead.email && <span>{lead.email}</span>}
                      <span>{lead.phone}</span>
                    </div>
                    <div class="crew-rate">
                      <strong>{rate}</strong>
                      <span class="archived-badge">Archived</span>
                    </div>
                  </div>
                  <div class="crew-actions">
                    <button class="btn-edit" onclick={`restoreCrew(${lead.id}, '${lead.name.replace(/'/g,"\\'")}')`}>
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right:6px;"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
                      Restore
                    </button>
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      )}
    </div>

    <!-- TAB 2: Timesheets -->
    <div class="tab-panel" id="panelTimesheets">
      <div class="timesheet-controls">
        <div style="display:flex; align-items:center; gap:8px; flex-wrap:wrap;">
          <label class="week-label">Week of:</label>
          <input type="date" class="week-picker" id="weekPicker">
          <div class="tc-nav-row">
            <button class="btn btn-secondary" style="padding:6px 14px; font-size:12px;" onclick="prevWeek()">← Prev</button>
            <button class="btn btn-secondary" style="padding:6px 14px; font-size:12px;" onclick="nextWeek()">Next →</button>
          </div>
          <span class="week-label" id="weekRangeLabel"></span>
        </div>
        <div style="margin-left:auto; display:flex; gap:6px; flex-wrap:wrap;">
          <button class="btn btn-secondary" style="padding:6px 12px; font-size:12px;" onclick="openAddShiftModal()">+ Shift</button>
          <button class="btn btn-secondary" style="padding:6px 12px; font-size:12px;" onclick="openAddExpenseModal()">+ Expense</button>
          <label class="btn btn-secondary" style="padding:6px 12px; font-size:12px; cursor:pointer;">
            Import
            <input type="file" id="csvImport" accept=".csv" style="display:none;" onchange="importCSV(this)">
          </label>
          <button class="btn btn-secondary" style="padding:6px 12px; font-size:12px;" onclick="exportWeekCSV()">Export</button>
        </div>
      </div>

      <!-- Pay Summary -->
      <div class="summary-table-wrap">
        <div class="summary-table-title">Weekly Pay Summary</div>
        <table class="summary-table">
          <thead>
            <tr>
              <th>Crew Member</th>
              <th>Raw Hours</th>
              <th>Paid Hours</th>
              <th>Rate</th>
              <th>Gross Pay</th>
              <th>Expenses</th>
              <th>Deductions</th>
              <th>Total Payout</th>
              <th>Pay Date</th>
            </tr>
          </thead>
          <tbody id="summaryBody">
            <tr><td colspan="9" style="text-align:center; padding:24px; color:var(--color-text-secondary);">Select a week to load data</td></tr>
          </tbody>
        </table>
      </div>

      <!-- Detailed Logs -->
      <div class="logs-table-wrap">
        <div class="summary-table-title" style="display:flex; justify-content:space-between; align-items:center;">
          <span>Shift Detail</span>
          <span id="logsCount" style="font-weight:400; text-transform:none; letter-spacing:0;"></span>
        </div>
        <table class="logs-table">
          <thead>
            <tr>
              <th>Name</th>
              <th>Date</th>
              <th>Clock In</th>
              <th>Clock Out</th>
              <th>Duration</th>
              <th>Notes</th>
              <th></th>
            </tr>
          </thead>
          <tbody id="logsBody">
            <tr><td colspan="7" style="text-align:center; padding:24px; color:var(--color-text-secondary);">No shifts to show</td></tr>
          </tbody>
        </table>
      </div>

      <!-- Reimbursable Expenses (paid out-of-pocket — added to crew payout) -->
      <div class="logs-table-wrap" style="margin-top:24px;">
        <div class="summary-table-title" style="display:flex; justify-content:space-between; align-items:center;">
          <span>Reimbursable Expenses</span>
          <span id="expensesTotal" style="font-weight:400; text-transform:none; letter-spacing:0;"></span>
        </div>
        <table class="logs-table">
          <thead>
            <tr>
              <th>Name</th>
              <th>Date</th>
              <th>Amount</th>
              <th>Description</th>
              <th>Receipt</th>
              <th></th>
            </tr>
          </thead>
          <tbody id="expensesBody">
            <tr><td colspan="6" style="text-align:center; padding:24px; color:var(--color-text-secondary);">No expenses this week</td></tr>
          </tbody>
        </table>
      </div>

      <!-- Company Expenses (paid with company card — tracked but NOT reimbursed) -->
      <div class="logs-table-wrap" style="margin-top:24px;">
        <div class="summary-table-title" style="display:flex; justify-content:space-between; align-items:center;">
          <span>Company Expenses <span style="font-weight:400; text-transform:none; letter-spacing:0; color:var(--color-text-secondary); font-size:12px;">(paid with company card)</span></span>
          <span id="companyExpensesTotal" style="font-weight:400; text-transform:none; letter-spacing:0;"></span>
        </div>
        <table class="logs-table">
          <thead>
            <tr>
              <th>Name</th>
              <th>Date</th>
              <th>Amount</th>
              <th>Description</th>
              <th>Receipt</th>
              <th></th>
            </tr>
          </thead>
          <tbody id="companyExpensesBody">
            <tr><td colspan="6" style="text-align:center; padding:24px; color:var(--color-text-secondary);">No company-card expenses this week</td></tr>
          </tbody>
        </table>
      </div>

      <!-- Deductions (admin paid for something on crew's behalf — subtracted from paycheck) -->
      <div class="logs-table-wrap" style="margin-top:24px;">
        <div class="summary-table-title" style="display:flex; justify-content:space-between; align-items:center;">
          <span>Deductions <span style="font-weight:400; text-transform:none; letter-spacing:0; color:var(--color-text-secondary); font-size:12px;">(subtracted from paycheck)</span></span>
          <span id="deductionsTotal" style="font-weight:400; text-transform:none; letter-spacing:0;"></span>
        </div>
        <table class="logs-table">
          <thead>
            <tr>
              <th>Name</th>
              <th>Date</th>
              <th>Amount</th>
              <th>Note</th>
              <th>Receipt</th>
              <th></th>
            </tr>
          </thead>
          <tbody id="deductionsBody">
            <tr><td colspan="6" style="text-align:center; padding:24px; color:var(--color-text-secondary);">No deductions this week</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </main>

  <!-- MK Footer -->
  <footer class="admin-footer">
    by <a href="https://mannyknows.com" class="footer-link" target="_blank" rel="noopener">MK <span class="rocket-emoji">🚀</span></a>
  </footer>

  <!-- Toast -->
  <div class="toast" id="toast"></div>

  <ConfirmModal />

  <!-- Confirm Modal -->
  <div class="confirm-modal" id="crewDeleteModal">
    <div class="confirm-content">
      <div class="confirm-icon">
        <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2">
          <path d="M12 9v4m0 4h.01M3 12a9 9 0 1118 0 9 9 0 01-18 0z"/>
        </svg>
      </div>
      <h3 class="confirm-title" id="confirmTitle">Remove Crew Lead?</h3>
      <p class="confirm-text" id="confirmText">This action cannot be undone.</p>
      <div class="confirm-actions">
        <button class="btn btn-secondary" onclick="closeCrewDeleteModal()">Cancel</button>
        <button class="btn btn-danger" id="confirmBtn">Remove</button>
      </div>
    </div>
  </div>

  <!-- Add/Edit Modal -->
  <div class="modal-overlay" id="crewModal">
    <div class="modal">
      <div class="modal-header">
        <h2 class="modal-title" id="modalTitle">Add Crew Lead</h2>
      </div>
      <div class="modal-body">
        <input type="hidden" id="crewId" value="">
        <div class="form-group">
          <label for="crewName">Name *</label>
          <input type="text" id="crewName" placeholder="Enter full name" required>
        </div>
        <div class="form-group">
          <label for="crewPhone">Phone (WhatsApp) *</label>
          <input type="tel" id="crewPhone" placeholder="(413) 555-0000" required>
        </div>
        <div class="form-group">
          <label for="crewEmail">Email (optional)</label>
          <input type="email" id="crewEmail" placeholder="email@example.com">
        </div>
        <div class="form-group">
          <label for="crewPayModel">Pay Model *</label>
          <select id="crewPayModel" class="form-select" onchange="syncPayModelFields()">
            <option value="hourly">Hourly — clocks in/out, paid by the hour</option>
            <option value="salaried_daily">Salaried — fixed daily pay, no clock-in</option>
          </select>
        </div>
        <div class="form-group" id="hourlyFields">
          <label for="crewRate">Hourly Rate ($)</label>
          <input type="number" id="crewRate" placeholder="0.00" min="0" step="0.50">
        </div>
        <div class="form-group" id="salariedFields" style="display:none;">
          <label for="crewSalaryDailyRate">Daily Pay Calculation</label>
          <div style="display:grid; grid-template-columns: 1fr auto 1fr auto 1fr; gap:8px; align-items:center;">
            <input type="number" id="crewSalaryDailyHours" placeholder="8" min="0" step="0.25" value="8">
            <span style="color:var(--color-text-secondary);">hr ×</span>
            <input type="number" id="crewSalaryDailyRate" placeholder="0.00" min="0" step="0.50">
            <span style="color:var(--color-text-secondary);">/hr =</span>
            <span id="crewSalaryDailyTotal" style="font-weight:600; color:var(--color-text-primary);">$0.00/day</span>
          </div>
          <div style="margin-top:6px; font-size:11px; color:var(--color-text-secondary);">
            Paid every day in the pay week (Sun–Sat) automatically. Weekly gross = 7 × daily total. No clock-in required.
          </div>
        </div>
        <div class="form-group">
          <label for="crewBonusStart">Bonus Start Date</label>
          <input type="date" id="crewBonusStart">
          <div style="margin-top:6px; font-size:11px; color:var(--color-text-secondary);">
            Year-end bonus accrues +$1/day from this date (capped at $365 / 365 days). Leave blank to disable.
          </div>
        </div>
        <div class="form-group">
          <label style="display:flex; align-items:center; gap:10px; cursor:pointer; font-weight:500;">
            <input type="checkbox" id="crewIsDriver" style="width:18px; height:18px; accent-color:var(--color-primary); cursor:pointer;">
            <span>Driver</span>
          </label>
          <div style="margin-top:6px; font-size:11px; color:var(--color-text-secondary);">
            Adds +1 hour to their timesheet on any day they work more than 30 minutes (paid at their hourly rate). Multiple shifts in a day still earn one bonus.
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn-cancel" onclick="closeModal()">Cancel</button>
        <button class="btn-save" id="saveBtn" onclick="saveCrew()">Save Crew Lead</button>
      </div>
