            <button type="button" data-value="company_card" class="expPaidWithOpt" style="padding:12px; background:rgba(255,255,255,0.05); color:var(--color-text-primary); border:1px solid var(--glass-border); border-radius:var(--radius-md); font-size:13px; font-weight:600; cursor:pointer;">Company card</button>
            <button type="button" data-value="deduction" class="expPaidWithOpt" style="padding:12px; background:rgba(255,255,255,0.05); color:var(--color-text-primary); border:1px solid var(--glass-border); border-radius:var(--radius-md); font-size:13px; font-weight:600; cursor:pointer;">Deduct from pay</button>
