    async function submitCrewExpense() {
      const date = document.getElementById('crewExpDate').value;
      const amount = parseFloat(document.getElementById('crewExpAmount').value);
      const description = document.getElementById('crewExpDesc').value.trim();
      const receiptInput = document.getElementById('crewExpReceipt');
      const receiptFile = receiptInput?.files?.[0];

      if (!date || !amount || !description) { showError('Date, amount, and description are required.'); return; }
      if (!receiptFile) { showError('Receipt photo is required.'); return; }

      const btn = document.getElementById('crewExpSubmitBtn');
      btn.disabled = true; btn.textContent = 'Uploading...';

      try {
        const ts = Date.now();
        const ext = receiptFile.name.split('.').pop()?.toLowerCase() || 'jpg';
        const uploadRes = await fetch('/api/r2-upload/', {
          method: 'POST', credentials: 'include',
          headers: { 'Content-Type': receiptFile.type || 'image/jpeg', 'X-Upload-Path': `receipts/${ts}_receipt.${ext}`, 'X-Upload-Timestamp': String(ts) },
          body: receiptFile,
        });
        const uploadData = await uploadRes.json();
        if (!uploadData.success || !(uploadData.fileUrl || uploadData.url)) {
          showError(uploadData.error || 'Receipt upload failed. Try again.');
          btn.disabled = false; btn.textContent = 'Submit Expense';
          return;
        }
        const receiptUrl = uploadData.fileUrl || uploadData.url;
        btn.textContent = 'Saving...';

        const res = await fetch('/api/crew/expenses/', {
          method: 'POST', headers: { 'Content-Type': 'application/json' }, credentials: 'include',
          body: JSON.stringify({ work_date: date, amount, description, receipt_url: receiptUrl, paid_with: crewExpPaidWith })
        });
        const data = await res.json();
        if (data.success) {
          document.getElementById('expenseForm').style.display = 'none';
          // Bring the "+ Add Expense" button back since the form is collapsed.
          const addBtn = document.getElementById('addExpenseBtn');
          if (addBtn) addBtn.style.display = '';
          // Clear form for next submission
          document.getElementById('crewExpAmount').value = '';
          document.getElementById('crewExpDesc').value = '';
          document.getElementById('crewExpReceipt').value = '';
          document.getElementById('crewExpReceiptLabel').textContent = 'Tap to upload receipt';
          loadCrewExpenses();
          loadWeekSummary();
        } else { showError(data.error || 'Failed to submit expense.'); }
      } catch { showError('Error submitting expense.'); }
      finally { btn.disabled = false; btn.textContent = 'Submit Expense'; }
    }

    function setExpensesSummary(count, reimbursableTotal) {
      const el = document.getElementById('expensesSummary');
      if (!el) return;
      if (!count) { el.textContent = ''; return; }
      const money = reimbursableTotal > 0 ? ` · $${reimbursableTotal.toFixed(2)}` : '';
      el.textContent = `(${count}${money})`;
    }

    async function loadCrewExpenses() {
      // Render into both targets: the modal list (#crewExpensesList) and the
      // body card mirror (#crewExpensesBodyList). Some pages render only one
      // of the two depending on view, so guard each individually.
      // NB: this <script is:inline> block is raw JS — Astro does NOT compile
      // it through TypeScript. Type assertions (`as Foo`) and parameter type
      // annotations (`(x: string)`) would parse as syntax errors at runtime
      // and crash the whole login script. Keep this block JS-clean.
      const targets = [
        document.getElementById('crewExpensesList'),
        document.getElementById('crewExpensesBodyList'),
      ].filter(Boolean);
      if (!targets.length || !crewId) return;
      const writeAll = (html) => { for (const el of targets) el.innerHTML = html; };
      try {
        const res = await fetch('/api/crew/expenses/', { credentials: 'include' });
        const data = await res.json();
        if (!data.success || !data.expenses || data.expenses.length === 0) {
          writeAll('<div style="text-align:center; padding:12px; color:var(--color-text-secondary); font-size:12px;">No expenses this week</div>');
          weekExtras = { reimbursable: 0, deductions: 0 };
          renderWeekStats();
          setExpensesSummary(0, 0);
          return;
        }
        const expenses = data.expenses.filter(e => e.paid_with !== 'deduction');
        const deductions = data.expenses.filter(e => e.paid_with === 'deduction');
        // Reimbursable = out-of-pocket only ('crew' value or default).
        // Company-card rows are tracked but never affect the paycheck.
        const reimbursableSum = expenses
          .filter(e => e.paid_with !== 'company_card')
          .reduce((sum, e) => sum + Number(e.amount || 0), 0);
        const deductionsSum = deductions
          .reduce((sum, e) => sum + Number(e.amount || 0), 0);
        weekExtras = { reimbursable: reimbursableSum, deductions: deductionsSum };
        renderWeekStats();
        setExpensesSummary(data.expenses.length, reimbursableSum);
        let reimbTotal = 0;
        let dedTotal = 0;
        const renderRow = (e, isDeduction) => {
          const isCompanyCard = e.paid_with === 'company_card';
          const receipt = e.receipt_url ? `<a href="${e.receipt_url}" target="_blank" style="color:var(--color-primary); font-size:11px;">Receipt</a>` : '';
          const day = new Date(e.work_date + 'T12:00:00Z').toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric', timeZone: 'UTC' });
          const tag = isDeduction
            ? `<span style="font-size:10px; padding:2px 6px; border-radius:6px; background:rgba(220,38,38,0.15); color:#fca5a5; font-weight:600;">Deduction</span>`
            : isCompanyCard
              ? `<span style="font-size:10px; padding:2px 6px; border-radius:6px; background:rgba(59,130,246,0.15); color:#60a5fa; font-weight:600;">Company card</span>`
              : '';
          const amountColor = isDeduction ? '#fca5a5' : 'var(--color-text-primary)';
          const amountText = isDeduction ? `−$${Number(e.amount).toFixed(2)}` : `$${Number(e.amount).toFixed(2)}`;
          return `<div style="display:flex; justify-content:space-between; align-items:center; padding:8px 0; border-bottom:1px solid rgba(255,255,255,0.04);">
            <div><span style="color:${amountColor}; font-weight:500;">${amountText}</span> <span style="color:var(--color-text-secondary); font-size:12px;">${e.description || ''}</span> ${tag}</div>
            <div style="display:flex; gap:8px; align-items:center;"><span style="font-size:11px; color:var(--color-text-secondary);">${day}</span>${receipt}</div>
          </div>`;
        };

        let html = '';
        if (expenses.length > 0) {
          html += expenses.map(e => {
            if (e.paid_with !== 'company_card') reimbTotal += e.amount;
            return renderRow(e, false);
          }).join('');
          html += `<div style="text-align:right; padding:8px 0; font-weight:600; color:var(--color-text-primary);">Reimbursable total: $${reimbTotal.toFixed(2)}</div>`;
        }
        if (deductions.length > 0) {
          html += `<div style="margin-top:12px; padding-top:8px; border-top:1px solid rgba(255,255,255,0.06); font-size:11px; text-transform:uppercase; letter-spacing:0.5px; color:var(--color-text-secondary);">Deductions <span style="text-transform:none; letter-spacing:0; opacity:0.7;">(items the company bought for you — subtracted from this paycheck)</span></div>`;
          html += deductions.map(e => {
            dedTotal += e.amount;
            return renderRow(e, true);
          }).join('');
          html += `<div style="text-align:right; padding:8px 0; font-weight:600; color:#fca5a5;">Deductions total: −$${dedTotal.toFixed(2)}</div>`;
        }
        writeAll(html);
      } catch { writeAll('<div style="color:var(--color-text-secondary); font-size:12px;">Failed to load</div>'); }
    }

