    // ===== Media Pool (capture photos/videos from the job site) =====
    async function handleMediaPoolFiles(files) {
      if (!files || !files.length) return;
      const noteEl = document.getElementById('mediaPoolNote');
      const note = (noteEl?.value || '').trim();
      const noteErr = document.getElementById('mediaPoolNoteError');
      // Note is required — it's how admin groups the batch when triaging.
      if (!note) {
        if (noteErr) noteErr.style.display = 'block';
        if (noteEl) {
          noteEl.style.borderColor = 'rgba(239,68,68,0.6)';
          noteEl.focus();
        }
        // Clear the file pickers so the next try-with-note doesn't re-upload.
        const cIn = document.getElementById('mediaPoolCamera');
        const lIn = document.getElementById('mediaPoolLibrary');
        if (cIn) cIn.value = '';
        if (lIn) lIn.value = '';
        return;
      }
      if (noteErr) noteErr.style.display = 'none';
      if (noteEl) noteEl.style.borderColor = '';
      const progressEl = document.getElementById('mediaPoolProgress');
      const cameraInput = document.getElementById('mediaPoolCamera');
      const libraryInput = document.getElementById('mediaPoolLibrary');
      progressEl.style.display = 'block';

      const total = files.length;
      let done = 0, failed = 0;
      // Per-file audit trail — posted at the end so we have a RECORD of why any
      // file dropped (too_large / rate_limited / upload_failed / save_failed /
      // network) instead of just a silent "X failed".
      const uploadLogs = [];

      for (let i = 0; i < files.length; i++) {
        const file = files[i];
        const isVideo = (file.type || '').startsWith('video/');
        // Match the server caps (25MB images / 100MB videos) so we don't reject
        // files the server would have accepted.
        const maxSize = isVideo ? 100 * 1024 * 1024 : 25 * 1024 * 1024;
        const baseLog = { filename: file.name, file_size: file.size, media_type: isVideo ? 'video' : 'image', note };
        progressEl.textContent = `Uploading ${i + 1} of ${total}: ${file.name}`;
        try {
          if (file.size > maxSize) {
            failed++;
            uploadLogs.push({ ...baseLog, result: 'failed', reason: 'too_large' });
            continue;
          }
          const ts = Date.now();
          const safeName = file.name.replace(/[^a-zA-Z0-9_.-]/g, '_');
          const ext = (safeName.split('.').pop() || (isVideo ? 'mp4' : 'jpg')).toLowerCase();
          const baseName = safeName.replace(new RegExp(`\\.${ext}$`, 'i'), '') || 'upload';
          const path = `pool/${ts}_${baseName}.${ext}`;

          const uploadRes = await fetch('/api/r2-upload/', {
            method: 'POST',
            headers: {
              'Content-Type': file.type || (isVideo ? 'video/mp4' : 'image/jpeg'),
              'X-Upload-Path': path,
              'X-Upload-Timestamp': String(ts),
            },
            body: file,
          });
          const uploadData = await uploadRes.json();
          const mediaUrl = uploadData.fileUrl || uploadData.url;
          if (!uploadData.success || !mediaUrl) {
            failed++;
            const reason = uploadRes.status === 429 ? 'rate_limited' : 'upload_failed';
            uploadLogs.push({ ...baseLog, result: 'failed', reason });
            continue;
          }

          const saveRes = await fetch('/api/crew/media-pool/', {
            method: 'POST',
            credentials: 'include',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              media_url: mediaUrl,
              media_type: isVideo ? 'video' : 'image',
              file_size: file.size,
              original_filename: file.name,
              note,
            }),
          });
          const saveData = await saveRes.json();
          if (!saveData.success) {
            failed++;
            uploadLogs.push({ ...baseLog, result: 'failed', reason: 'save_failed' });
            continue;
          }
          done++;
          uploadLogs.push({ ...baseLog, result: 'ok', reason: null });
        } catch {
          failed++;
          uploadLogs.push({ ...baseLog, result: 'failed', reason: 'network' });
        }
      }

      // Persist the audit trail (best-effort — never block the UI on it).
      try {
        await fetch('/api/crew/upload-log/', {
          method: 'POST',
          credentials: 'include',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ logs: uploadLogs }),
        });
      } catch {}

      if (cameraInput) cameraInput.value = '';
      if (libraryInput) libraryInput.value = '';
      if (noteEl) noteEl.value = '';
      progressEl.textContent = failed > 0
        ? `${done} uploaded, ${failed} failed`
        : `Uploaded ${done} of ${total} ✓`;
      setTimeout(() => { progressEl.style.display = 'none'; }, 3000);
      loadMediaPoolRecent();
    }
    window.handleMediaPoolFiles = handleMediaPoolFiles;

    async function loadMediaPoolRecent() {
      const recent = document.getElementById('mediaPoolRecent');
      if (!recent) return;
      try {
        const res = await fetch('/api/crew/media-pool/', { credentials: 'include' });
        const data = await res.json();
        if (!data.success || !data.items || !data.items.length) {
          recent.innerHTML = '<div style="font-size:12px; color:var(--color-text-secondary); opacity:0.6;">No uploads yet — your captures will show here.</div>';
          return;
        }
        recent.innerHTML = data.items.slice(0, 10).map(it => {
          const isVideo = it.media_type === 'video';
          const thumb = isVideo
            ? '<div style="width:64px; height:64px; background:rgba(255,255,255,0.05); display:flex; align-items:center; justify-content:center; border-radius:8px; border:1px solid var(--glass-border);"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color:var(--color-text-secondary);"><polygon points="5 3 19 12 5 21 5 3"/></svg></div>'
            : `<img src="${it.media_url}" style="width:64px; height:64px; object-fit:cover; border-radius:8px; border:1px solid var(--glass-border);" alt="">`;
          const title = (it.note || '').replace(/"/g, '&quot;');
          return `<div style="flex:0 0 auto;" title="${title}">${thumb}</div>`;
        }).join('');
      } catch {
        recent.innerHTML = '<div style="font-size:12px; color:var(--color-text-secondary); opacity:0.6;">Couldn\'t load recent uploads.</div>';
      }
    }

    document.getElementById('loginPhone').addEventListener('keydown', e => { if (e.key === 'Enter') doLogin(); });

    (async function() {
      const res = await fetch('/api/crew/login/',{credentials:'include'});
      const data = await res.json();
      if (data.authenticated) await loadStatus();
    })();

    // ===== Expenses modal =====
    function openExpensesModal() {
      const modal = document.getElementById('expensesModal');
      modal.classList.add('active');
      document.body.style.overflow = 'hidden';
      // Refresh list every time we open so totals stay accurate.
      loadCrewExpenses();
      // Open in "list view": form collapsed, "+ Add Expense" button visible.
      document.getElementById('expenseForm').style.display = 'none';
      const btn = document.getElementById('addExpenseBtn');
      if (btn) btn.style.display = '';
    }
    function closeExpensesModal() {
      document.getElementById('expensesModal').classList.remove('active');
      document.body.style.overflow = '';
    }
    window.openExpensesModal = openExpensesModal;
    window.closeExpensesModal = closeExpensesModal;

    function openMediaModal() {
      const modal = document.getElementById('mediaModal');
      modal.classList.add('active');
      document.body.style.overflow = 'hidden';
      loadMediaPoolRecent(); // refresh recent uploads each open
    }
    function closeMediaModal() {
      document.getElementById('mediaModal').classList.remove('active');
      document.body.style.overflow = '';
    }
    window.openMediaModal = openMediaModal;
    window.closeMediaModal = closeMediaModal;
  </script>

  <!-- Expenses modal — replaces the old right-column card. The form + list
       live in here so the main page stays focused on clock controls + media. -->
  <div class="tc-modal" id="expensesModal" onclick="if(event.target===this) closeExpensesModal()">
    <div class="tc-modal-box">
      <div class="tc-modal-header">
        <h3>Expenses This Week</h3>
        <button class="tc-modal-close" onclick="closeExpensesModal()">&times;</button>
      </div>
      <div class="tc-modal-body">
        <button class="tc-btn" id="addExpenseBtn" style="background:var(--glass-bg); border:1px solid var(--glass-border); color:var(--color-text-primary); font-size:13px; padding:10px; margin-bottom:14px;" onclick="toggleExpenseForm()">+ Add Expense</button>

        <!-- Inline expense form (hidden until + Add tapped) -->
        <div id="expenseForm" style="display:none; margin-bottom:16px; padding:14px; background:rgba(255,255,255,0.03); border:1px solid var(--glass-border); border-radius:var(--radius-md);">
          <div style="margin-bottom:10px;">
            <label style="font-size:10px; font-weight:700; color:var(--color-text-secondary); text-transform:uppercase; letter-spacing:0.5px; display:block; margin-bottom:4px;">Date *</label>
            <input type="date" id="crewExpDate" class="form-input">
          </div>
          <div style="margin-bottom:10px;">
            <label style="font-size:10px; font-weight:700; color:var(--color-text-secondary); text-transform:uppercase; letter-spacing:0.5px; display:block; margin-bottom:4px;">Amount ($) *</label>
            <input type="number" id="crewExpAmount" class="form-input" placeholder="0.00" min="0" step="0.01" inputmode="decimal">
          </div>
          <div style="margin-bottom:10px;">
            <label style="font-size:10px; font-weight:700; color:var(--color-text-secondary); text-transform:uppercase; letter-spacing:0.5px; display:block; margin-bottom:4px;">Paid with *</label>
            <div id="crewExpPaidWith" style="display:grid; grid-template-columns:1fr 1fr; gap:6px;">
              <button type="button" data-value="crew" class="crewExpPaidWithOpt" style="padding:8px 10px; background:linear-gradient(135deg, var(--color-primary), #6366f1); color:#fff; border:1px solid var(--color-primary); border-radius:8px; font-size:12px; font-weight:600; cursor:pointer;">My money</button>
              <button type="button" data-value="company_card" class="crewExpPaidWithOpt" style="padding:8px 10px; background:rgba(255,255,255,0.05); color:var(--color-text-primary); border:1px solid var(--glass-border); border-radius:8px; font-size:12px; font-weight:600; cursor:pointer;">Company card</button>
            </div>
            <div style="font-size:11px; color:var(--color-text-secondary); margin-top:4px;">Reimbursable amounts add to your weekly payout. Company-card receipts are tracked but not paid back.</div>
          </div>
          <div style="margin-bottom:10px;">
            <label style="font-size:10px; font-weight:700; color:var(--color-text-secondary); text-transform:uppercase; letter-spacing:0.5px; display:block; margin-bottom:4px;">Description *</label>
            <input type="text" id="crewExpDesc" class="form-input" placeholder="Gas, materials, supplies...">
          </div>
          <div style="margin-bottom:12px;">
            <label style="font-size:10px; font-weight:700; color:var(--color-text-secondary); text-transform:uppercase; letter-spacing:0.5px; display:block; margin-bottom:4px;">Receipt *</label>
            <div style="border:1.5px dashed var(--glass-border); border-radius:8px; padding:12px; text-align:center; cursor:pointer;" onclick="document.getElementById('crewExpReceipt').click()">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="color:var(--color-text-secondary); display:block; margin:0 auto 4px;"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
              <div style="font-size:12px; color:var(--color-text-secondary);" id="crewExpReceiptLabel">Tap to upload receipt</div>
              <input type="file" id="crewExpReceipt" accept="image/*,application/pdf,.pdf" style="display:none;" onchange="if(this.files[0]) document.getElementById('crewExpReceiptLabel').textContent = this.files[0].name;">
            </div>
          </div>
          <button class="tc-btn" id="crewExpSubmitBtn" onclick="submitCrewExpense()" style="background:linear-gradient(135deg, var(--color-primary), #6366f1); color:white; font-size:13px; padding:10px;">Submit Expense</button>
        </div>

        <div id="crewExpensesList" style="font-size:13px; color:var(--color-text-secondary);">Loading...</div>
      </div>
    </div>
  </div>

  <!-- Capture Media modal — moved out of the right-column card; opened by the
       Capture Media button below Expenses. -->
  <div class="tc-modal" id="mediaModal" onclick="if(event.target===this) closeMediaModal()">
    <div class="tc-modal-box">
      <div class="tc-modal-header">
        <h3>Capture Media</h3>
        <button class="tc-modal-close" onclick="closeMediaModal()">&times;</button>
      </div>
      <div class="tc-modal-body">
        <div style="font-size:12px; color:var(--color-text-secondary); margin-bottom:12px; line-height:1.5;">
          Take photos and videos <strong>before</strong> you start, <strong>while you work</strong>, and <strong>before you leave</strong> each day. Before-photos protect us (and you) if a customer claims something was broken when we arrived. During and after photos build the project's portfolio. Don't worry about which project — admin sorts everything later. Tip: type a note like “Smith house — before” so the whole batch stays grouped.
        </div>

        <!-- Note first so crew can label the batch before tapping a capture button. -->
        <div style="margin-bottom:12px;">
          <label style="font-size:10px; font-weight:700; color:var(--color-text-secondary); text-transform:uppercase; letter-spacing:0.5px; display:block; margin-bottom:4px;">Note <span style="color:#fca5a5;">*</span> <span style="font-weight:500; text-transform:none; letter-spacing:0; opacity:0.8;">(required — tags the whole batch so admin can group it)</span></label>
          <input type="text" id="mediaPoolNote" class="form-input" required placeholder="e.g. Smith house — before" aria-required="true">
          <div id="mediaPoolNoteError" style="display:none; font-size:11px; color:#fca5a5; margin-top:4px;">Add a note before uploading — it's what lets admin group your batch.</div>
        </div>

        <!-- Separate camera + library inputs. Single picker is unreliable on Android. -->
        <input type="file" id="mediaPoolCamera" accept="image/*,video/*" capture="environment" style="display:none;" onchange="handleMediaPoolFiles(this.files)">
        <input type="file" id="mediaPoolLibrary" accept="image/*,video/mp4,video/quicktime,video/webm" multiple style="display:none;" onchange="handleMediaPoolFiles(this.files)">

        <div style="display:grid; grid-template-columns:1fr 1fr; gap:8px; margin-bottom:12px;">
          <button class="tc-btn" style="padding:10px 12px; font-size:13px; background:linear-gradient(135deg, var(--color-primary), #6366f1); color:#fff; border:1px solid var(--color-primary); display:flex; align-items:center; justify-content:center; gap:6px;" onclick="document.getElementById('mediaPoolCamera').click()">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
            Take Photo / Video
          </button>
          <button class="tc-btn" style="padding:10px 12px; font-size:13px; background:var(--glass-bg); border:1px solid var(--glass-border); color:var(--color-text-primary); display:flex; align-items:center; justify-content:center; gap:6px;" onclick="document.getElementById('mediaPoolLibrary').click()">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
            From Library
          </button>
        </div>

        <div id="mediaPoolProgress" style="display:none; margin-bottom:12px; padding:10px; background:rgba(255,255,255,0.03); border:1px solid var(--glass-border); border-radius:var(--radius-md); font-size:12px; color:var(--color-text-secondary);"></div>

        <div style="font-size:11px; font-weight:700; color:var(--color-text-secondary); text-transform:uppercase; letter-spacing:0.6px; margin-bottom:6px;">Recent Uploads</div>
        <div id="mediaPoolRecent" style="display:flex; gap:8px; overflow-x:auto; padding-bottom:6px; min-height:60px;">
          <div style="font-size:12px; color:var(--color-text-secondary); opacity:0.6;">Loading…</div>
        </div>
      </div>
    </div>
  </div>
</body>
</html>
