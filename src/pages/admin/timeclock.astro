---
// Crew Time Tracking — /admin/timeclock
import '../../styles/admin.css';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <!-- maximum-scale=1 prevents iOS Safari from auto-zooming when a field with
       font-size < 16px gets focus (it never zooms back out cleanly). We keep
       user-scalable=yes so pinch-zoom still works for accessibility. -->
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes">
  <title>Crew Time Tracking | MannyKnows</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <meta name="robots" content="noindex, nofollow">
  <script>
    (function() { document.documentElement.setAttribute('data-theme', 'dark'); })();
  </script>
  <style>
    /* Lock the page to viewport width on every device — iOS Safari otherwise
       lets a single off-by-one element (date input, modal backdrop, toast)
       push the body wider than the viewport and force a horizontal scroll.
       overscroll-behavior-x stops the rubber-band horizontal pan that some
       Android keyboards trigger when fields are focused. */
    html, body {
      overflow-x: hidden;
      max-width: 100vw;
      overscroll-behavior-x: none;
      touch-action: pan-y;
    }
    body { min-height: 100vh; display: flex; flex-direction: column; }
    .tc-card * { max-width: 100%; box-sizing: border-box; }
    /* iOS Safari auto-zooms on focus of any input < 16px font-size and never
       zooms back. Bump every editable control on this page to 16px so the
       trigger never fires. */
    .tc-card input,
    .tc-card textarea,
    .tc-card select,
    .tc-form-group input,
    .tc-form-group textarea,
    .tc-form-group select {
      font-size: 16px;
    }
    /* iOS Safari renders the native calendar widget so the input visibly
       overflows its container — neutralise the native chrome so the field
       behaves like the rest of the .form-input controls. */
    .tc-card input[type="date"].form-input {
      -webkit-appearance: none;
      appearance: none;
      min-height: 44px;
    }

    /* Header uses admin-header from admin.css */

    /* Layout */
    .tc-main { flex: 1; padding: 24px 16px 48px; max-width: 1200px; margin: 0 auto; width: 100%; }

    @media (min-width: 768px) {
      .tc-main { padding: 32px 24px 48px; }
      .tc-layout { display: grid; grid-template-columns: 360px 1fr; gap: 20px; }
    }

    .tc-card {
      background: var(--glass-bg); border: 1px solid var(--glass-border);
      border-radius: var(--radius-xl); padding: 24px; backdrop-filter: blur(20px); margin-bottom: 16px;
    }
    .tc-card-title { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; color: var(--color-text-secondary); margin-bottom: 16px; }

    /* Login */
    .tc-form-group { margin-bottom: 14px; }
    .tc-form-group label { display: block; font-size: 11px; font-weight: 600; color: var(--color-text-secondary); text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 6px; }
    .tc-form-group input { width: 100%; padding: 12px 14px; background: rgba(255,255,255,0.05); border: 1px solid var(--glass-border); border-radius: var(--radius-md); color: var(--color-text-primary); font-size: 15px; outline: none; }
    .tc-form-group input:focus { border-color: var(--color-primary); }
    .tc-form-group input::placeholder { color: var(--color-text-secondary); }

    /* Buttons */
    .tc-btn { width: 100%; padding: 12px; border: none; border-radius: var(--radius-md); font-size: 14px; font-weight: 700; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px; }
    .tc-btn:disabled { opacity: 0.5; cursor: not-allowed; }
    .tc-btn-login { background: linear-gradient(135deg, var(--color-primary), #6366f1); color: white; }
    .tc-btn-in { background: linear-gradient(135deg, #22c55e, #16a34a); color: white; }
    .tc-btn-out { background: linear-gradient(135deg, #ef4444, #dc2626); color: white; }
    .tc-btn-break { background: linear-gradient(135deg, #f59e0b, #d97706); color: white; }
    .tc-btn-lunch { background: linear-gradient(135deg, #8b5cf6, #7c3aed); color: white; }
    .tc-btn-end-break { background: linear-gradient(135deg, #22c55e, #16a34a); color: white; }
    .tc-btn-sm { padding: 10px; font-size: 13px; }

    /* Status */
    .tc-status { padding: 10px 14px; border-radius: var(--radius-md); display: flex; align-items: center; gap: 10px; font-size: 14px; font-weight: 600; margin-bottom: 12px; }
    .tc-status-working { background: rgba(34,197,94,0.15); border: 1px solid rgba(34,197,94,0.3); color: #4ade80; }
    .tc-status-idle { background: var(--glass-bg); border: 1px solid var(--glass-border); color: var(--color-text-secondary); }
    .tc-status-break { background: rgba(245,158,11,0.15); border: 1px solid rgba(245,158,11,0.3); color: #fbbf24; }
    .tc-status-lunch { background: rgba(139,92,246,0.15); border: 1px solid rgba(139,92,246,0.3); color: #a78bfa; }
    .tc-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
    .tc-status-working .tc-dot { background: #22c55e; box-shadow: 0 0 6px #22c55e; }
    .tc-status-idle .tc-dot { background: #94a3b8; }
    .tc-status-break .tc-dot { background: #f59e0b; box-shadow: 0 0 6px #f59e0b; }
    .tc-status-lunch .tc-dot { background: #8b5cf6; box-shadow: 0 0 6px #8b5cf6; }

    /* Timer */
    .tc-timer { font-size: 36px; font-weight: 700; text-align: center; letter-spacing: -1px; font-variant-numeric: tabular-nums; color: var(--color-text-primary); margin: 4px 0; }
    .tc-timer-label { text-align: center; font-size: 11px; color: var(--color-text-secondary); text-transform: uppercase; letter-spacing: 1px; margin-bottom: 16px; }
    .tc-welcome-name { font-size: 18px; font-weight: 700; color: var(--color-text-primary); margin-bottom: 2px; }
    .tc-welcome-date { font-size: 12px; color: var(--color-text-secondary); margin-bottom: 14px; }

    /* Break countdown */
    .tc-break-countdown { font-size: 28px; font-weight: 700; text-align: center; font-variant-numeric: tabular-nums; margin: 4px 0; }
    .tc-break-label { text-align: center; font-size: 11px; color: var(--color-text-secondary); text-transform: uppercase; letter-spacing: 1px; margin-bottom: 16px; }

    /* Button rows */
    .tc-btn-row { display: flex; gap: 8px; margin-bottom: 8px; }
    .tc-btn-row .tc-btn { flex: 1; }

    /* Tables */
    .tc-table { width: 100%; border-collapse: collapse; font-size: 13px; }
    .tc-table th { text-align: left; font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: var(--color-text-secondary); padding: 8px 12px; border-bottom: 1px solid var(--glass-border); }
    .tc-table td { padding: 14px 12px; border-bottom: 1px solid var(--glass-border); color: var(--color-text-primary); font-size: 13px; }
    .tc-table tr:last-child td { border-bottom: none; }
    .tc-shift-active { color: #22c55e; font-weight: 600; }
    .tc-pay-amount { font-weight: 700; color: #22c55e; }

    /* Summary card on right */
    .tc-summary-inline { display: flex; gap: 24px; flex-wrap: wrap; }
    .tc-summary-item { display: flex; flex-direction: column; gap: 2px; }
    .tc-summary-item .label { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: var(--color-text-secondary); }
    .tc-summary-item .value { font-size: 15px; font-weight: 700; color: var(--color-text-primary); }
    .tc-summary-item .value.pay { color: #22c55e; }

    .tc-error { background: rgba(239,68,68,0.15); border: 1px solid rgba(239,68,68,0.3); color: #f87171; padding: 10px 14px; border-radius: var(--radius-md); font-size: 13px; margin-bottom: 16px; display: none; }
    .tc-error.visible { display: block; }
    .hidden { display: none !important; }

    /* Crew messages strip (year-end bonus today; admin broadcasts later). */
    .tc-msg-strip { margin-bottom: 16px; display: flex; flex-direction: column; gap: 8px; }
    .tc-bonus-banner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 10px 14px;
      background: linear-gradient(135deg, rgba(251,191,36,0.10), rgba(245,158,11,0.05));
      border: 1px solid rgba(251,191,36,0.25);
      border-radius: var(--radius-md);
      color: var(--color-text-primary);
      cursor: pointer;
      transition: padding 0.18s ease;
    }
    .tc-bonus-banner-content { display: flex; align-items: center; gap: 10px; flex: 1; min-width: 0; }
    .tc-bonus-banner-content svg { color: #fbbf24; flex-shrink: 0; }
    .tc-bonus-banner-text { font-size: 13px; line-height: 1.4; }
    .tc-bonus-banner-summary { font-size: 13px; line-height: 1.4; display: none; }
    /* Minimized state: hide the verbose text, show the short summary, and
       tighten padding so the banner shrinks to a pill but stays visible. */
    .tc-bonus-banner.minimized { padding: 6px 12px; }
    .tc-bonus-banner.minimized .tc-bonus-banner-text { display: none; }
    .tc-bonus-banner.minimized .tc-bonus-banner-summary { display: block; }
    .tc-bonus-banner-close {
      background: transparent; border: none; color: var(--color-text-secondary);
      line-height: 1; cursor: pointer; padding: 4px 6px;
      flex-shrink: 0;
      display: flex; align-items: center;
    }
    .tc-bonus-banner-close:hover { color: var(--color-text-primary); }

    /* Expenses modal — replaces the old tc-card panel in the right column. */
    .tc-modal {
      position: fixed; inset: 0;
      background: rgba(0,0,0,0.6);
      display: none;
      align-items: center; justify-content: center;
      z-index: 1000;
      padding: 16px;
    }
    .tc-modal.active { display: flex; }
    .tc-modal-box {
      background: var(--color-background-light, var(--color-background));
      border: 1px solid var(--glass-border);
      border-radius: var(--radius-lg);
      width: 100%;
      max-width: 480px;
      max-height: 90vh;
      display: flex; flex-direction: column;
      overflow: hidden;
    }
    .tc-modal-header {
      padding: 14px 18px;
      border-bottom: 1px solid var(--glass-border);
      display: flex; justify-content: space-between; align-items: center;
    }
    .tc-modal-header h3 { margin: 0; font-size: 15px; font-weight: 700; }
    .tc-modal-close {
      background: transparent; border: none; color: var(--color-text-secondary);
      font-size: 22px; line-height: 1; cursor: pointer; padding: 0 4px;
    }
    .tc-modal-body { padding: 16px 18px; overflow-y: auto; }
  </style>

  <style is:global>
    /* JS-rendered content — must be global to avoid scoped attribute mismatch */
    .tc-summary-inline { display: flex; gap: 24px; flex-wrap: wrap; }
    .tc-summary-item { display: flex; flex-direction: column; gap: 2px; }
    .tc-summary-item .label { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: var(--color-text-secondary); }
    .tc-summary-item .value { font-size: 14px; font-weight: 600; color: var(--color-text-primary); }
    .tc-summary-item .value.pay { color: #22c55e; }
    .tc-table td { padding: 14px 1rem !important; border-bottom: 1px solid var(--glass-border) !important; }
    .tc-table th { padding: 12px 1rem !important; }
    .tc-table tr:last-child td { border-bottom: none !important; }
    .tc-shift-active { color: #22c55e; font-weight: 600; }
    .tc-pay-amount { font-weight: 700; color: #22c55e; }
  </style>
</head>
<body>
  <header class="admin-header">
    <a href="/admin/timeclock" class="admin-logo-link">
      <div class="logo-gradient-wrapper"></div>
      <span class="admin-badge">Crew</span>
    </a>
    <div style="display:flex; gap:12px; align-items:center;">
      <button class="btn-logout hidden" id="logoutBtn" onclick="logout()">Sign Out</button>
    </div>
  </header>

  <div class="tc-main">
    <div class="tc-error" id="errorMsg"></div>

    <!-- LOGIN -->
    <div class="tc-card" id="loginPanel" style="max-width:400px; margin:40px auto;">
      <div class="tc-card-title">Crew Time Tracking</div>
      <div class="tc-form-group">
        <label>Your Name</label>
        <input type="text" id="loginName" placeholder="First and Last Name" autocomplete="name">
      </div>
      <div class="tc-form-group">
        <label>Phone Number</label>
        <input type="tel" id="loginPhone" placeholder="(413) 555-0000" autocomplete="tel">
      </div>
      <button class="tc-btn tc-btn-login" id="loginBtn" onclick="doLogin()">Sign In</button>
    </div>

    <!-- TRACKING -->
    <div class="hidden" id="trackingPanel">
      <!-- Messages strip: bonus banner (and future admin broadcasts). Always
           present once a crew member is logged in; clicking the banner toggles
           between expanded and minimized. Minimized leaves a small pill at
           the top so crew can re-expand whenever they want. -->
      <div class="tc-msg-strip hidden" id="msgStrip">
        <div class="tc-bonus-banner" id="bonusBanner" onclick="toggleBonusBanner()" role="button" tabindex="0">
          <div class="tc-bonus-banner-content">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15 9 22 9 16 14 18 21 12 17 6 21 8 14 2 9 9 9 12 2"/></svg>
            <div class="tc-bonus-banner-text" id="bonusBannerText"></div>
            <div class="tc-bonus-banner-summary" id="bonusBannerSummary"></div>
          </div>
          <button class="tc-bonus-banner-close" onclick="event.stopPropagation(); toggleBonusBanner();" aria-label="Toggle">
            <svg id="bonusBannerChevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="18 15 12 9 6 15"/></svg>
          </button>
        </div>
      </div>

      <div class="tc-layout">
        <!-- Left: Clock controls -->
        <div>
          <div class="tc-card">
            <div class="tc-welcome-name" id="welcomeName"></div>
            <div class="tc-welcome-date" id="welcomeDate"></div>

            <div class="tc-status tc-status-idle" id="statusBanner">
              <div class="tc-dot"></div>
              <span id="statusText">Not clocked in</span>
            </div>

            <div class="tc-timer" id="timerDisplay">0:00:00</div>
            <div class="tc-timer-label">Today's Hours</div>

            <!-- IDLE -->
            <div id="idlePanel">
              <button class="tc-btn tc-btn-in" onclick="doClockIn()">Clock In</button>
            </div>

            <!-- WORKING -->
            <div class="hidden" id="workingPanel">
              <button class="tc-btn tc-btn-out" onclick="doClockOut()">Clock Out</button>
            </div>

            <!-- Expenses moved to a modal so it doesn't compete visually with
                 Capture Media. Summary on the button keeps it useful at a glance. -->
            <button class="tc-btn tc-btn-sm" id="openExpensesBtn" onclick="openExpensesModal()"
              style="background:linear-gradient(135deg, var(--color-primary), #6366f1); border:1px solid var(--color-primary); color:#fff; margin-top:12px; font-weight:600;">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
              Expenses <span id="expensesSummary" style="opacity:0.85; font-weight:500;"></span>
            </button>

            <!-- Capture Media lives in a modal too, triggered right below Expenses. -->
            <button class="tc-btn tc-btn-sm" id="openMediaBtn" onclick="openMediaModal()"
              style="background:var(--glass-bg); border:1px solid var(--glass-border); color:var(--color-text-primary); margin-top:8px; font-weight:600;">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
              Capture Media
            </button>
          </div>

          <!-- Today's shifts -->
          <div class="tc-card hidden" id="shiftsCard">
            <div class="tc-card-title">Today's Shifts</div>
            <table class="tc-table">
              <thead><tr><th>In</th><th>Out</th><th>Hours</th></tr></thead>
              <tbody id="shiftsBody"></tbody>
            </table>
          </div>
        </div>

        <!-- Right: This week's summary (desktop) -->
        <div>
          <div class="tc-card">
            <div class="tc-card-title">This Week</div>
            <div id="weekSummary" style="padding:8px 0;">
              <div style="text-align:center; color:var(--color-text-secondary); font-size:13px;">Loading...</div>
            </div>
          </div>

          <div class="tc-card">
            <div class="tc-card-title">Week's Shifts</div>
            <table class="tc-table">
              <thead><tr><th>Day</th><th>In</th><th>Out</th><th>Hours</th></tr></thead>
              <tbody id="weekShiftsBody">
                <tr><td colspan="4" style="text-align:center; color:var(--color-text-secondary);">Loading...</td></tr>
              </tbody>
            </table>
          </div>

          <!-- Expenses this week — read-only mirror of the modal's list so
               crew can see what they've logged at a glance without opening
               the modal. Add/Edit still happens inside the modal. -->
          <div class="tc-card">
            <div class="tc-card-title">Expenses This Week</div>
            <div id="crewExpensesBodyList" style="font-size:13px; color:var(--color-text-secondary);">Loading...</div>
          </div>

        </div>
      </div>
    </div>
  </div>

  <script is:inline>
    let crewId = null, crewName = '', currentState = 'idle';
    let timerInterval = null;
    // Server-computed work minutes at the moment of the last API response,
    // and the local Date.now() at which we received that response. The live
    // timer ticks from this anchor — never re-parsing server datetimes — so
    // crew on different devices/timezones see the correct elapsed time.
    let workMinutesAtAnchor = 0;
    let apiAnchorMs = 0;
    let breakEndTime = null, breakCountdownInterval = null;

    function formatDuration(sec) {
      const h = Math.floor(sec / 3600), m = Math.floor((sec % 3600) / 60), s = sec % 60;
      return `${h}:${String(m).padStart(2,'0')}:${String(s).padStart(2,'0')}`;
    }

    function fmtTime(dtStr) {
      if (!dtStr) return '—';
      const s = dtStr.replace('Z','').replace(/T(\d):/,'T0$1:');
      const d = new Date(s);
      return isNaN(d.getTime()) ? dtStr : d.toLocaleTimeString('en-US',{hour:'numeric',minute:'2-digit',hour12:true,timeZone:'America/New_York'});
    }

    function fmtMins(m) { const h = Math.floor(m/60); return h > 0 ? `${h}h ${m%60}m` : `${m%60}m`; }

    function showError(msg) {
      const el = document.getElementById('errorMsg');
      el.textContent = msg; el.classList.add('visible');
      setTimeout(() => el.classList.remove('visible'), 5000);
    }

    function startTimer() {
      stopTimer();
      timerInterval = setInterval(() => {
        let sec = workMinutesAtAnchor * 60;
        if (currentState === 'working' && apiAnchorMs) {
          sec += Math.floor((Date.now() - apiAnchorMs) / 1000);
        }
        document.getElementById('timerDisplay').textContent = formatDuration(Math.max(0, sec));
      }, 1000);
    }

    function stopTimer() { if (timerInterval) { clearInterval(timerInterval); timerInterval = null; } }

    function updateBreakCountdown() {
      if (!breakEndTime) return;
      const remaining = Math.max(0, Math.floor((breakEndTime.getTime() - Date.now()) / 1000));
      document.getElementById('breakCountdown').textContent = `${Math.floor(remaining/60)}:${String(remaining%60).padStart(2,'0')}`;
      if (remaining <= 0) { clearInterval(breakCountdownInterval); breakCountdownInterval = null; loadStatus(); }
    }

    function updateUI(data) {
      const state = data.state || 'idle';
      currentState = state;
      // Anchor the live timer on Date.now() at the moment we received the
      // server's work_minutes_now figure. Subsequent ticks add the wall-clock
      // delta only — no server datetime parsing on the client.
      workMinutesAtAnchor = data.work_minutes_now ?? data.total_minutes_today ?? 0;
      apiAnchorMs = Date.now();

      const banner = document.getElementById('statusBanner');
      const statusText = document.getElementById('statusText');
      const idle = document.getElementById('idlePanel');
      const working = document.getElementById('workingPanel');

      idle.classList.add('hidden');
      working.classList.add('hidden');

      if (state === 'working' || state === 'on_break' || state === 'on_lunch') {
        banner.className = 'tc-status tc-status-working';
        statusText.textContent = `Clocked in since ${fmtTime(data.clock_in_time)}`;
        working.classList.remove('hidden');
      } else {
        banner.className = 'tc-status tc-status-idle';
        statusText.textContent = 'Not clocked in';
        idle.classList.remove('hidden');
      }

      // Today's shifts
      const logs = data.logs || [];
      const tbody = document.getElementById('shiftsBody');
      const shiftsCard = document.getElementById('shiftsCard');
      if (logs.length > 0) {
        shiftsCard.classList.remove('hidden');
        tbody.innerHTML = logs.map(l => {
          const isOpen = !l.clock_out;
          const dur = isOpen ? null : Math.floor((new Date(l.clock_out) - new Date(l.clock_in)) / 60000);
          return `<tr><td>${fmtTime(l.clock_in)}</td><td class="${isOpen?'tc-shift-active':''}">${isOpen?'Working...':fmtTime(l.clock_out)}</td><td>${dur !== null ? fmtMins(dur) : '—'}</td></tr>`;
        }).join('');
      } else { shiftsCard.classList.add('hidden'); }

      startTimer();
    }

    // Pay summary is built from two API calls (timeclock + expenses). Both stash
    // their data here, then renderWeekStats() draws the final unified card.
    let payModel = 'hourly'; // 'hourly' | 'salaried_daily'
    let weekStats = {
      totalMinutes: 0, payableMinutes: 0, rate: 0,
      driverBonusMinutes: 0, driverBonusDays: 0, driverBonusDates: [],
      // Salaried-only fields:
      salaryDailyHours: 0, salaryDailyRate: 0, salaryDaysPerWeek: 7,
    };
    let weekExtras = { reimbursable: 0, deductions: 0 };

    // Show/hide clock-in / today / shifts cards based on pay model.
    // Salaried crew never clock in, so those controls just confuse them.
    function applyPayModelLayout(model) {
      payModel = model;
      const isSalaried = model === 'salaried_daily';
      // Cards that are irrelevant for salaried crew
      const hideForSalaried = [
        'statusBanner', 'timerDisplay', 'idlePanel', 'workingPanel',
        'shiftsCard',
      ];
      // The "Today's Hours" label sits as a sibling of timerDisplay — toggle by
      // searching for it (it's a class, not an id, so just hide the timer block).
      hideForSalaried.forEach(id => {
        const el = document.getElementById(id);
        if (el) el.style.display = isSalaried ? 'none' : '';
      });
      // The "Today's Hours" label is a class — hide via the timer's parent.
      document.querySelectorAll('.tc-timer-label').forEach(el => {
        el.style.display = isSalaried ? 'none' : '';
      });
      // Week's Shifts table doesn't apply either.
      const weekShifts = document.getElementById('weekShiftsBody');
      const weekShiftsCard = weekShifts?.closest('.tc-card');
      if (weekShiftsCard) weekShiftsCard.style.display = isSalaried ? 'none' : '';
    }

    function fmtMoney(n) {
      const sign = n < 0 ? '−' : '';
      return `${sign}$${Math.abs(n).toFixed(2)}`;
    }

    function renderWeekStats() {
      const summaryEl = document.getElementById('weekSummary');
      if (!summaryEl) return;
      const reimb = weekExtras.reimbursable;
      const ded = weekExtras.deductions;
      const showTakeHome = (reimb > 0 || ded > 0);
      const reimbRow = reimb > 0
        ? `<div class="tc-summary-item"><span class="label">Reimbursable</span><span class="value" style="color:#4ade80;">+$${reimb.toFixed(2)}</span></div>`
        : '';
      const dedRow = ded > 0
        ? `<div class="tc-summary-item"><span class="label">Deductions</span><span class="value" style="color:#fca5a5;">−$${ded.toFixed(2)}</span></div>`
        : '';

      if (payModel === 'salaried_daily') {
        // Fixed pay: 7 days × daily_hours × daily_rate. No driver bonus, no
        // 30-min rounding. Crew portal shows the breakdown so they understand
        // exactly how their salary is computed.
        const dailyHours = Number(weekStats.salaryDailyHours) || 0;
        const dailyRate = Number(weekStats.salaryDailyRate) || 0;
        const days = Number(weekStats.salaryDaysPerWeek) || 7;
        const dailyTotal = dailyHours * dailyRate;
        const grossPay = days * dailyTotal;
        const takeHome = grossPay + reimb - ded;
        summaryEl.innerHTML = `
          <div class="tc-summary-inline">
            <div class="tc-summary-item"><span class="label">Pay Model</span><span class="value">Salaried</span></div>
            <div class="tc-summary-item"><span class="label">Daily</span><span class="value">${dailyHours}h × $${dailyRate.toFixed(2)}</span></div>
            <div class="tc-summary-item"><span class="label">Daily Total</span><span class="value">$${dailyTotal.toFixed(2)}</span></div>
            <div class="tc-summary-item"><span class="label">Days (Sun–Sat)</span><span class="value">${days}</span></div>
            <div class="tc-summary-item"><span class="label">Gross Pay</span><span class="value${showTakeHome ? '' : ' pay'}">$${grossPay.toFixed(2)}</span></div>
            ${reimbRow}
            ${dedRow}
            ${showTakeHome ? `<div class="tc-summary-item"><span class="label">Take-home</span><span class="value pay">$${takeHome.toFixed(2)}</span></div>` : ''}
          </div>
        `;
        return;
      }

      // Hourly: original layout with optional driver-bonus row
      const totalHrs = (weekStats.totalMinutes / 60).toFixed(1);
      const paidHrs = (weekStats.payableMinutes / 60).toFixed(1);
      const rate = Number(weekStats.rate) || 0;
      const grossPay = (weekStats.payableMinutes / 60) * rate;
      const takeHome = grossPay + reimb - ded;
      const driverHrs = (weekStats.driverBonusMinutes / 60);
      const driverRow = driverHrs > 0
        ? `<div class="tc-summary-item"><span class="label">Driver Bonus</span><span class="value" style="color:#a5b4fc;">+${driverHrs}h <span style="opacity:0.7; font-size:12px;">(${weekStats.driverBonusDays}d)</span></span></div>`
        : '';
      summaryEl.innerHTML = `
        <div class="tc-summary-inline">
          <div class="tc-summary-item"><span class="label">Total Hours</span><span class="value">${totalHrs}h</span></div>
          ${driverRow}
          <div class="tc-summary-item"><span class="label">Paid Hours</span><span class="value">${paidHrs}h</span></div>
          <div class="tc-summary-item"><span class="label">Rate</span><span class="value">$${rate.toFixed(2)}/hr</span></div>
          <div class="tc-summary-item"><span class="label">Gross Pay</span><span class="value${showTakeHome ? '' : ' pay'}">$${grossPay.toFixed(2)}</span></div>
          ${reimbRow}
          ${dedRow}
          ${showTakeHome ? `<div class="tc-summary-item"><span class="label">Take-home</span><span class="value pay">$${takeHome.toFixed(2)}</span></div>` : ''}
        </div>
      `;
    }

    // Year-end bonus — rendered into a slim banner at the top of the messages
    // strip. Always present once a bonus exists; crew can minimize to a pill
    // but can't dismiss outright (preference is persisted in localStorage).
    function renderBonusCard(bonus) {
      const strip = document.getElementById('msgStrip');
      const banner = document.getElementById('bonusBanner');
      const text = document.getElementById('bonusBannerText');
      const summary = document.getElementById('bonusBannerSummary');
      if (!banner || !text || !summary) return;
      if (!bonus || !bonus.startDate) {
        banner.classList.add('hidden');
        if (strip) strip.classList.add('hidden');
        return;
      }
      strip.classList.remove('hidden');
      banner.classList.remove('hidden');
      const claimDate = new Date(bonus.claimDate + 'T12:00:00Z')
        .toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
      text.innerHTML = `<strong style="color:#fbbf24;">$${bonus.amount}</strong> bonus accrued · <strong>${bonus.days}/365 days</strong> · full $365 on <strong>${claimDate}</strong>`;
      // Minimized form: short pill with just the dollar amount.
      summary.innerHTML = `<strong style="color:#fbbf24;">$${bonus.amount}</strong> · ${bonus.days}/365`;
      // Apply persisted minimize state (default expanded).
      if (localStorage.getItem('bonusBannerMinimized') === '1') {
        banner.classList.add('minimized');
        setBonusChevron(true);
      } else {
        banner.classList.remove('minimized');
        setBonusChevron(false);
      }
    }

    function setBonusChevron(isMinimized) {
      const svg = document.getElementById('bonusBannerChevron');
      if (!svg) return;
      svg.innerHTML = isMinimized
        ? '<polyline points="6 9 12 15 18 9"/>'
        : '<polyline points="18 15 12 9 6 15"/>';
    }

    function toggleBonusBanner() {
      const banner = document.getElementById('bonusBanner');
      if (!banner) return;
      const wasMin = banner.classList.toggle('minimized');
      localStorage.setItem('bonusBannerMinimized', wasMin ? '1' : '0');
      setBonusChevron(wasMin);
    }
    window.toggleBonusBanner = toggleBonusBanner;

    async function loadWeekSummary() {
      if (!crewId) return;
      try {
        // Pay week starts Sunday, runs Sun → Sat (7 days)
        const now = new Date();
        const day = now.getDay(); // 0=Sun, 1=Mon ... 6=Sat
        const sun = new Date(now); sun.setDate(now.getDate() - day);
        const weekStart = sun.toISOString().slice(0,10);

        const res = await fetch(`/api/crew/timeclock/?week=true&week_start=${weekStart}`, { credentials: 'include' });
        const data = await res.json();

        // Keep payModel in sync — week summary is the authoritative source.
        if (data.pay_model) applyPayModelLayout(data.pay_model);
        weekStats = {
          totalMinutes: data.total_minutes_week || 0,
          // Fallback mirrors PAY_BLOCK_MINUTES rounding in src/lib/crewPay.ts
          // (pending Manny's review); the API value wins when present.
          payableMinutes: data.payable_minutes_week ?? Math.floor((data.total_minutes_week || 0) / 30) * 30,
          rate: data.hourly_rate || 0,
          driverBonusMinutes: data.driver_bonus_minutes || 0,
          driverBonusDays: data.driver_bonus_days || 0,
          driverBonusDates: data.driver_bonus_dates || [],
          salaryDailyHours: data.salary_daily_hours || 0,
          salaryDailyRate: data.salary_daily_rate || 0,
          salaryDaysPerWeek: data.salary_days_per_week || 7,
        };
        renderWeekStats();
        renderBonusCard(data.bonus);

        // Week's shifts
        const weekLogs = data.week_logs || [];
        const bonusDates = new Set(data.driver_bonus_dates || []);
        const weekBody = document.getElementById('weekShiftsBody');
        if (weekLogs.length === 0) {
          weekBody.innerHTML = '<tr><td colspan="4" style="text-align:center;color:var(--color-text-secondary);">No shifts this week</td></tr>';
        } else {
          // Render shifts in order; after the LAST shift of any day that earned
          // a driver bonus, append a subtle "+1h driver" row so the crew sees
          // exactly which days the bonus came from.
          const rows = [];
          for (let i = 0; i < weekLogs.length; i++) {
            const l = weekLogs[i];
            const isOpen = !l.clock_out;
            const dur = isOpen ? null : Math.floor((new Date(l.clock_out) - new Date(l.clock_in)) / 60000);
            const dayName = new Date(l.work_date + 'T12:00:00').toLocaleDateString('en-US',{weekday:'short',month:'short',day:'numeric',timeZone:'UTC'});
            rows.push(`<tr><td>${dayName}</td><td>${fmtTime(l.clock_in)}</td><td class="${isOpen?'tc-shift-active':''}">${isOpen?'Active':fmtTime(l.clock_out)}</td><td>${dur!==null?fmtMins(dur):'—'}</td></tr>`);
            const next = weekLogs[i + 1];
            const isLastOfDay = !next || next.work_date !== l.work_date;
            if (isLastOfDay && bonusDates.has(l.work_date)) {
              rows.push(`<tr style="background:rgba(99,102,241,0.06);"><td></td><td colspan="2" style="color:#a5b4fc; font-size:12px; font-style:italic;">+ Driver bonus</td><td style="color:#a5b4fc;">+1h 0m</td></tr>`);
            }
          }
          weekBody.innerHTML = rows.join('');
        }
      } catch { /* silent */ }
      loadCrewExpenses();
      loadMediaPoolRecent();
    }

    let crewExpPaidWith = 'crew';
    function setCrewExpPaidWith(val) {
      crewExpPaidWith = val === 'company_card' ? 'company_card' : 'crew';
      document.querySelectorAll('.crewExpPaidWithOpt').forEach(btn => {
