          <h3 class="section-h">Payment Schedule</h3>
          <p style="font-size:13px; color:#475569; margin-bottom:8px;">
            {row.down_payment_percent}% down split into {row.down_payment_count} payment{row.down_payment_count === 1 ? '' : 's'},
            {isMonthlyPlan
              ? ` with the balance divided into ${row.monthly_payment_count} monthly payment${row.monthly_payment_count === 1 ? '' : 's'} after job completion.`
