---
// /project/contract/[token] — customer-facing contract review + signing.
// Token-gated (no admin session). Phase 6C: replaces the legacy
// upload-a-PDF flow with the template-driven contract. Looks up the
// project_contracts row by its contract_token (not the project's
// client_token), renders scope + payment schedule + terms inline, and
// embeds a signature pad that POSTs to /api/projects/contract/sign.
import { env as cfEnv } from 'cloudflare:workers';
import {
  COMPANY_HEADER,
  parseScopes,
  renderScopesHtml,
} from '../../../lib/quoteTemplateConstants';
import { getBrand, SL_BRAND, type Brand } from '../../../lib/brand';
import { streamThumb } from '../../../lib/stream';

export const prerender = false;

const env = cfEnv;
const db = env?.MK_APP_DB;
const token = (Astro.params.token || '').trim();
let brand: Brand = SL_BRAND;

let error: string | null = null;
let row: any = null;

if (!db) {
  error = 'Server is not configured.';
} else if (!token) {
  error = 'Missing contract token.';
} else {
  row = await db.prepare(`
    SELECT
      p.id AS project_id, p.project_number, p.customer_name, p.customer_email,
      p.customer_phone, p.customer_address, p.customer_city, p.customer_state, p.customer_zip,
      p.services, p.quote_id, p.partner_id,
      c.id AS contract_id, c.scopes AS contract_scopes,
      c.total, c.discount, c.start_date,
      c.down_payment_percent, c.down_payment_count, c.monthly_payment_count,
      c.cancellation_window_days, c.cancellation_fee_amount,
      c.late_fee_amount, c.late_fee_grace_days, c.warranty_months,
      c.payment_schedule, c.terms, c.status, c.contract_token,
      c.signed_at
    FROM project_contracts c
    INNER JOIN projects p ON p.id = c.project_id
    WHERE c.contract_token = ?
  `).bind(token).first() as any;

  if (row) brand = await getBrand(db, row.partner_id);
  if (!row) error = 'Contract not found — please check the link in your email.';
  else if (row.status === 'void') error = `This contract has been voided. Please contact ${brand.name}.`;
  else if (row.status === 'draft') error = `This contract has not been sent yet. Please wait for the email from ${brand.name}.`;
}

// Phase 6D — fetch the customer's prior signature from the originating
// quote (if any) so we can offer a "Reuse my signature" shortcut. Inlined
// into a JS variable on the page so the client can paint it onto the
// canvas without an extra round-trip.
let priorSignature: { signature_data_url: string; signer_name: string; signed_at: string; quote_number: string } | null = null;
if (row?.quote_id && !error) {
  const prior = await db.prepare(`
    SELECT s.signature_data_url, s.signer_name, s.signed_at, q.quote_number
    FROM quote_signatures s
    INNER JOIN quotes q ON q.id = s.quote_id
    WHERE s.quote_id = ?
    LIMIT 1
  `).bind(row.quote_id).first() as any;
  if (prior?.signature_data_url) {
    priorSignature = {
      signature_data_url: prior.signature_data_url as string,
      signer_name: prior.signer_name as string,
      signed_at: prior.signed_at as string,
      quote_number: prior.quote_number as string,
    };
  }
}

const firstName = row?.customer_name?.split(' ')?.[0] || 'there';

function fmtDate(s: string | null | undefined): string {
  if (!s) return '—';
  try {
    // Tolerate SQLite CURRENT_TIMESTAMP ('YYYY-MM-DD HH:MM:SS') as well as
    // plain 'YYYY-MM-DD' values. Splitting on space/T isolates the date.
    const trimmed = String(s).split(/[\sT]/)[0];
    const d = new Date(trimmed + 'T00:00:00');
    if (isNaN(d.getTime())) return String(s);
    return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
  } catch { return String(s); }
}
function fmtMoney(n: number | string | null | undefined): string {
  const v = Number(n);
  if (!Number.isFinite(v)) return '$0.00';
  return v.toLocaleString('en-US', { style: 'currency', currency: 'USD' });
}

const scopes = row ? parseScopes(row.contract_scopes) : [];
const scopesHtml = renderScopesHtml(scopes);
let paymentSchedule: Array<{ id: string; kind: 'down' | 'monthly'; label: string; amount: number; due_date: string }> = [];
try { paymentSchedule = JSON.parse(row?.payment_schedule || '[]'); } catch {}
let terms: any = {};
try { terms = JSON.parse(row?.terms || '{}'); } catch {}

// Starred project photos — these appear in the contract (mirrors how starred
// quote images appear in the quote PDF). The star is inherited from the quote
// on promotion and the admin can star/unstar more in the project view; this
// reads live so newly-starred photos show up next time the contract loads.
let contractPhotos: Array<{ url: string; isVideo: boolean }> = [];
if (row?.project_id && !error) {
  try {
    const ph = await db.prepare(`
      SELECT image_url, stream_uid, poster_url FROM project_updates
      WHERE project_id = ? AND COALESCE(is_starred, 0) = 1 AND image_url IS NOT NULL
      ORDER BY created_at ASC
    `).bind(row.project_id).all();
    contractPhotos = (ph.results || []).map((r: any) => {
      const isVideo = !!r.stream_uid || /\.(mp4|mov|webm|m4v)(?:\?|$)/i.test(r.image_url || '');
      let url = r.image_url;
      if (isVideo) {
        // streamThumb returns '' when STREAM_CUSTOMER_SUBDOMAIN isn't
        // configured — fall back to the stored poster or raw video URL.
        url = (r.stream_uid ? streamThumb(r.stream_uid, '1s', env) : '') || r.poster_url || r.image_url;
      } else {
        try { const u = new URL(r.image_url); url = `${u.origin}/cdn-cgi/image/width=800,quality=80,format=auto${u.pathname}`; } catch {}
      }
      return { url, isVideo };
    });
  } catch (e) { console.error('[contract] starred photos query failed', e); }
}

const total = Number(row?.total) || 0;
const discount = Number(row?.discount) || 0;
const downSum = paymentSchedule.filter(r => r.kind === 'down').reduce((s, r) => s + (Number(r.amount) || 0), 0);
const monthlySum = paymentSchedule.filter(r => r.kind === 'monthly').reduce((s, r) => s + (Number(r.amount) || 0), 0);
// Sum every row (down + monthly + balance + any custom rows like Materials)
// so the schedule footer total is correct regardless of the payment plan.
const scheduleTotal = paymentSchedule.reduce((s, r) => s + (Number(r.amount) || 0), 0);
const isMonthlyPlan = paymentSchedule.some(r => r.kind === 'monthly');

const fullAddress = row ? [row.customer_address, row.customer_city, [row.customer_state, row.customer_zip].filter(Boolean).join(' ')].filter(Boolean).join(', ') : '';
const alreadySigned = row?.status === 'signed' || row?.status === 'countersigned';

// After the customer submits the signature pad, the client redirects to
// ?signed=1 so we can show a fresh "Thanks!" framing instead of the
// (confusing) "Already Signed" wording when they come back to this URL
// in the future.
const justSigned = Astro.url.searchParams.get('signed') === '1';

// Pull both signatures off the contract. Contractor is snapshotted at
// apply-template time so it's already present (even in pre-sign drafts).
// Customer signature only exists once the customer signed.
type SigRow = {
  signature_data_url: string;
  signer_name: string;
  signed_at: string;
  ip_address?: string | null;
  user_agent?: string | null;
  consent_text?: string | null;
};
let contractorSignature: SigRow | null = null;
let customerSignature: SigRow | null = null;
if (row?.contract_id) {
  const sigs = await db.prepare(
    "SELECT signature_data_url, signer_name, signed_at, ip_address, user_agent, consent_text, signer_role FROM contract_signatures WHERE project_contract_id = ? ORDER BY signed_at DESC"
  ).bind(row.contract_id).all() as any;
  for (const s of (sigs.results || [])) {
    const sigRow: SigRow = {
      signature_data_url: s.signature_data_url,
      signer_name: s.signer_name,
      signed_at: s.signed_at,
      ip_address: s.ip_address ?? null,
      user_agent: s.user_agent ?? null,
      consent_text: s.consent_text ?? null,
    };
    if (s.signer_role === 'contractor' && !contractorSignature) contractorSignature = sigRow;
    if (s.signer_role === 'customer' && !customerSignature) customerSignature = sigRow;
  }
}

// Per-payment receipts — surface the same signed/"PAID" payment rows the admin
// contract preview shows, so the customer's contract reflects in-person
// downpayment signatures. Keyed by payment-schedule row id.
type ReceiptRow = {
  row_id: string; amount: number; payment_method: string | null; check_number: string | null;
  customer_name: string | null; customer_signature_data_url: string | null;
  contractor_name: string | null; contractor_signature_data_url: string | null; collected_at: string | null;
};
const receiptByRow: Record<string, ReceiptRow> = {};
if (row?.contract_id) {
  try {
    const recs = await db.prepare(
      `SELECT row_id, amount, payment_method, check_number, customer_name,
              customer_signature_data_url, contractor_name, contractor_signature_data_url, collected_at
       FROM payment_receipts WHERE project_contract_id = ?`
    ).bind(row.contract_id).all() as any;
    for (const r of (recs.results || [])) receiptByRow[r.row_id] = r as ReceiptRow;
  } catch (e) {
    console.error('[contract page] payment_receipts query failed (table missing?):', e);
  }
}
const hasReceipts = Object.keys(receiptByRow).length > 0;

function parseUserAgent(ua: string | null | undefined): string {
  if (!ua) return 'Unknown device';
  let browser = 'Browser';
  if (/Edg\//.test(ua)) browser = 'Edge';
  else if (/Chrome\//.test(ua) && !/Edg\//.test(ua) && !/OPR\//.test(ua)) browser = 'Chrome';
  else if (/Firefox\//.test(ua)) browser = 'Firefox';
  else if (/Safari\//.test(ua) && !/Chrome\//.test(ua)) browser = 'Safari';
  let os = 'Unknown OS';
  if (/iPhone|iPad|iPod/.test(ua)) os = 'iOS';
  else if (/Mac OS X/.test(ua)) os = 'macOS';
  else if (/Android/.test(ua)) os = 'Android';
  else if (/Windows/.test(ua)) os = 'Windows';
  else if (/Linux/.test(ua)) os = 'Linux';
  return `${browser} on ${os}`;
}
function fmtFullDateTime(s: string | null | undefined): string {
  if (!s) return '—';
  try {
    const trimmed = String(s).replace(' ', 'T') + 'Z';
    const d = new Date(trimmed);
    if (isNaN(d.getTime())) return String(s);
    return d.toLocaleString('en-US', {
      month: 'long', day: 'numeric', year: 'numeric',
      hour: 'numeric', minute: '2-digit', timeZoneName: 'short',
    });
  } catch { return String(s); }
}
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex, nofollow">
  <title>{row ? `Contract ${row.project_number}` : 'Contract'} — {brand.name}</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background: #f8fafc; min-height: 100vh; color: #1e293b; }

    .header { background: rgb(15, 18, 25); padding: 36px 30px 32px; text-align: center; }
    .header-logo { display: inline-block; max-width: 260px; height: auto; }
    .gold-bar { height: 4px; background: linear-gradient(90deg, #ff781d 0%, #ffa25c 50%, #ff781d 100%); }

    .container { max-width: 880px; margin: 0 auto; padding: 32px 20px 0; }
    .card { background: white; border-radius: 16px; padding: 0; overflow: hidden; margin-bottom: 24px; box-shadow: 0 10px 40px rgba(0,0,0,0.06); }
    .card-header { padding: 22px 28px; background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%); border-bottom: 1px solid #cbd5e1; }
    .badge { display: inline-block; padding: 6px 14px; border-radius: 999px; font-size: 12px; font-weight: 700; letter-spacing: 0.5px; }

    /* Customer-side Download PDF link in the card header. Opens the
       token-gated /project/contract-preview/<token>/ page where the
       customer hits Cmd/Ctrl+P → Save as PDF. */
    .pdf-link {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 6px 14px;
      background: #ffffff;
      border: 1px solid #cbd5e1;
      border-radius: 999px;
      color: #1e293b;
      text-decoration: none;
      font-size: 12px;
      font-weight: 600;
      transition: background 0.15s, border-color 0.15s;
    }
    .pdf-link:hover { background: #f1f5f9; border-color: #94a3b8; }
    .badge-blue { background: #dbeafe; color: #1e40af; }
    .badge-green { background: #dcfce7; color: #166534; }
    .card-body { padding: 28px; }
    .card-body h2 { font-size: 24px; font-weight: 700; color: #1e293b; margin-bottom: 8px; }
    .message { color: #475569; font-size: 14px; line-height: 1.6; margin-bottom: 20px; }

    .summary { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 10px; padding: 16px 20px; margin: 18px 0; font-size: 13px; }
    .summary-row { display: grid; grid-template-columns: 130px 1fr; gap: 10px; padding: 6px 0; }
    .summary-row .label { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: #475569; padding-top: 2px; }
    .summary-row .value { color: #111827; }
    .summary .total-row { border-top: 2px solid #cbd5e1; margin-top: 10px; padding-top: 12px; font-weight: 700; font-size: 16px; }

    h3.section-h { font-size: 16px; font-weight: 700; color: #0f172a; margin: 24px 0 10px; border-bottom: 1px solid #cbd5e1; padding-bottom: 4px; }
    .contract-photos { display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 8px; }
    .contract-photo { position: relative; aspect-ratio: 4/3; border-radius: 8px; overflow: hidden; background: #1e293b; border: 1px solid #cbd5e1; }
    .contract-photo img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .contract-photo-badge { position: absolute; bottom: 4px; left: 4px; background: rgba(0,0,0,0.7); color: #fff; font-size: 10px; font-weight: 600; padding: 1px 5px; border-radius: 4px; text-transform: uppercase; }

    .pay-table { width: 100%; border-collapse: collapse; font-size: 13px; margin: 8px 0 16px; }
    .pay-table th, .pay-table td { padding: 8px 10px; border-bottom: 1px solid #e5e7eb; text-align: left; }
    .pay-table th { background: #f8fafc; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: #475569; }
    .pay-table td.amount { text-align: right; font-weight: 700; }

    .term-block { margin: 10px 0; padding: 10px 14px; background: #f8fafc; border-left: 4px solid #cbd5e1; font-size: 12px; line-height: 1.6; }

    .sig-block { margin: 24px 0; padding: 18px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; }
    .sig-label { font-size: 12px; font-weight: 700; color: #1e293b; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 8px; }
    .sig-pad-wrap { position: relative; background: #fff; border: 2px dashed #94a3b8; border-radius: 8px; overflow: hidden; touch-action: none; }
    .sig-pad-wrap.is-empty::after { content: 'Draw your signature with finger or mouse'; position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; color: #94a3b8; font-size: 13px; pointer-events: none; font-style: italic; }
    .sig-pad { display: block; width: 100%; height: 160px; touch-action: none; cursor: crosshair; }
    .sig-actions { display: flex; justify-content: space-between; align-items: center; font-size: 12px; color: #64748b; margin-top: 6px; }
    .sig-clear { background: transparent; border: 1px solid #cbd5e1; color: #475569; padding: 4px 12px; border-radius: 6px; font-size: 12px; font-weight: 600; cursor: pointer; }
    .sig-name-input { width: 100%; padding: 12px 14px; margin-top: 12px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 14px; font-family: inherit; }
    .sig-name-input:focus { outline: 2px solid #ff781d; outline-offset: -1px; }
    .sig-consent { display: flex; align-items: flex-start; gap: 10px; margin-top: 12px; font-size: 12px; color: #475569; line-height: 1.5; }
    .sig-consent input { flex-shrink: 0; margin-top: 2px; }
    .sig-consent label { cursor: pointer; user-select: none; }

    .ref-block { margin: 18px 0; padding: 14px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 10px; }
    .ref-row { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; margin-top: 8px; font-size: 13px; }
    .ref-row label { display: inline-flex; align-items: center; gap: 6px; cursor: pointer; }

    .form-error { color: #b91c1c; background: #fef2f2; border: 1px solid #fecaca; padding: 10px 14px; border-radius: 8px; margin: 12px 0; font-size: 13px; display: none; }
    .form-error.visible { display: block; }

    .btn-row { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; margin-top: 18px; }
    .btn { display: inline-flex; align-items: center; justify-content: center; padding: 14px 26px; border-radius: 10px; font-size: 14px; font-weight: 700; text-decoration: none; cursor: pointer; border: none; font-family: inherit; min-width: 200px; transition: opacity 0.15s, transform 0.15s; }
    .btn-primary { background: linear-gradient(135deg, #ff781d 0%, #e05f00 100%); color: white; }
    .btn-primary:hover { transform: none; opacity: 0.95; }
    .btn-primary:disabled { opacity: 0.5; cursor: not-allowed; transform: none; }
    .btn-secondary { background: #f1f5f9; color: #1e293b; border: 1px solid #cbd5e1; }
    .btn-secondary:hover { background: #e2e8f0; }
    .loading { display: none; align-items: center; gap: 8px; }
    .spinner { width: 14px; height: 14px; border: 2px solid rgba(255,255,255,0.4); border-top-color: #fff; border-radius: 50%; animation: spin 0.7s linear infinite; }
    @keyframes spin { to { transform: rotate(360deg); } }
    #confirm-form.submitted .btn-text { display: none; }
    #confirm-form.submitted .loading { display: inline-flex; }

    .footer { background: rgb(15, 18, 25); padding: 32px 30px; text-align: center; margin-top: auto; }
    .footer-logo { display: inline-block; max-width: 180px; height: auto; margin-bottom: 14px; }
    .footer p { color: rgba(255,255,255,0.9); font-size: 13px; margin: 0 0 12px 0; }
    .footer-links { margin: 12px 0; }
    .footer-links a { color: #ff781d; font-size: 14px; text-decoration: none; font-weight: 600; }
    .footer-links span { color: rgba(255,255,255,0.5); margin: 0 8px; }
    .footer-certs { color: rgba(255,255,255,0.65) !important; font-size: 11px !important; margin: 12px 0 0 0 !important; letter-spacing: 0.3px; }
    .partner-logo { background: #fff; padding: 8px 14px; border-radius: 10px; max-height: 72px; width: auto; max-width: 260px; height: auto; }
    .header-logo-name { display:inline-block; color:#fff; font-size:28px; font-weight:800; letter-spacing:0.3px; }
    .footer-logo.partner-logo { max-height: 52px; }

    .success-icon { font-size: 64px; color: #10b981; text-align: center; margin-bottom: 8px; }
    .error-icon { font-size: 48px; color: #ef4444; text-align: center; margin-bottom: 8px; }
  </style>
</head>
<body>
  <header class="header">
    <a href="https://mannyknows.com" style="display: inline-block; text-decoration: none;">
      {!brand.isPartner
        ? <img src="/logo.svg" alt="MannyKnows" width="180" height="70" class="header-logo" style="border-radius:0;" />
        : brand.logoUrl
          ? <img src={brand.logoUrl} alt={brand.name} class="header-logo partner-logo" />
          : <span class="header-logo-name">{brand.name}</span>}
    </a>
  </header>
  <div class="gold-bar"></div>

  <main class="container">
    {error ? (
      <div class="card">
        <div class="card-body">
          <div class="error-icon">!</div>
          <h2 style="text-align:center;">Can't load this contract</h2>
          <p class="message" style="text-align:center;">{error}</p>
          <div class="btn-row">
            <a href="https://mannyknows.com" class="btn btn-secondary">Return to Website</a>
          </div>
        </div>
      </div>
    ) : alreadySigned ? (
      <div class="card">
        <div class="card-header" style="text-align: center;">
          <span class="badge badge-green">SIGNED</span>
          <div style="margin-top: 10px;">
            <a href={`/project/contract-preview/${token}/`} target="_blank" rel="noopener" class="pdf-link">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
              Download PDF
            </a>
          </div>
        </div>
        <div class="card-body">
          <div class="success-icon">&#10003;</div>
          <h2 style="text-align:center;">
            {justSigned ? 'Thanks for signing!' : 'Contract Signed'}
          </h2>
          <p class="message" style="text-align:center;">
            {justSigned
              ? `You're all set, ${firstName} — your signed contract is locked in. ${brand.name} will reach out as the start date approaches. The full contract is below for your records.`
              : `Hi ${firstName}, your contract was signed on ${fmtDate(row.signed_at)}. Below is the full contract for your records.`}
          </p>

          <div class="summary">
            <div class="summary-row"><span class="label">Contract #</span><span class="value">{row.project_number}</span></div>
            <div class="summary-row"><span class="label">Work site</span><span class="value">{fullAddress}</span></div>
            <div class="summary-row"><span class="label">Start date</span><span class="value">{fmtDate(row.start_date)}</span></div>
            <div class="summary-row total-row"><span class="label">Total</span><span class="value">{fmtMoney(total)}</span></div>
            {discount > 0 && (<div style="text-align:right; font-size:12px; color:#64748b; margin-top:4px;">Includes discount of {fmtMoney(discount)}</div>)}
          </div>

          <h3 class="section-h">Scope of Work</h3>
          <div set:html={scopesHtml}></div>

          {contractPhotos.length > 0 && (
            <>
              <h3 class="section-h">Project Photos</h3>
              <div class="contract-photos">
                {contractPhotos.map((p) => (
                  <div class="contract-photo">
                    <img src={p.url} alt="Project photo" loading="lazy" />
                    {p.isVideo && <span class="contract-photo-badge">Video</span>}
                  </div>
                ))}
              </div>
            </>
          )}

          {paymentSchedule.length > 0 && (
            <>
              <h3 class="section-h">Payment Schedule</h3>
              <table class="pay-table">
                <thead>
                  <tr>
                    <th style="width: 100px;">Kind</th>
                    <th>Label</th>
                    <th style="width: 130px;">Due date</th>
                    <th style="width: 120px; text-align:right;">Amount</th>
                    {hasReceipts && <th style="width: 180px;">Signatures</th>}
                  </tr>
                </thead>
                <tbody>
                  {paymentSchedule.map((r) => {
                    const rec = receiptByRow[r.id];
                    return (
                    <tr>
                      <td style="text-transform: capitalize; font-size:12px; color:#475569;">{r.kind}</td>
                      <td>{r.label}</td>
                      <td>{fmtDate(r.due_date)}</td>
                      <td class="amount">{fmtMoney(r.amount)}</td>
                      {hasReceipts && (rec ? (
                        <td style="font-size:9px; color:#475569;">
                          <div style="display:flex; gap:10px; align-items:flex-end;">
                            <div style="flex:1; min-width:0;">
                              {rec.customer_signature_data_url && (<img src={rec.customer_signature_data_url} alt="Client signature" style="display:block; max-height:26px; max-width:100%;" />)}
                              <div style="border-top:1px solid #94a3b8; padding-top:2px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">Client{rec.customer_name ? ` — ${rec.customer_name}` : ''}</div>
                            </div>
                            <div style="flex:1; min-width:0;">
                              {rec.contractor_signature_data_url && (<img src={rec.contractor_signature_data_url} alt="Contractor signature" style="display:block; max-height:26px; max-width:100%;" />)}
                              <div style="border-top:1px solid #94a3b8; padding-top:2px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">Contractor</div>
                            </div>
                          </div>
                          <div style="margin-top:2px; color:#16a34a; font-weight:700;">PAID {rec.collected_at ? fmtDate(rec.collected_at) : ''}{rec.payment_method ? ` · ${rec.payment_method}` : ''}{rec.check_number ? ` #${rec.check_number}` : ''}</div>
                        </td>
                      ) : (
                        <td style="font-size:10px; color:#94a3b8;">Client _______ / Contractor _______</td>
                      ))}
                    </tr>
                    );
                  })}
                  <tr style="background: #fef9c3; font-weight: 700; border-top: 2px solid #0f172a;">
                    <td colspan="3">TOTAL</td>
                    <td class="amount">{fmtMoney(scheduleTotal)}</td>
                    {hasReceipts && <td></td>}
                  </tr>
                </tbody>
              </table>
            </>
          )}

          <h3 class="section-h">Terms</h3>
          <div class="term-block">
            <strong>Cancellation:</strong> {row.cancellation_window_days} day{row.cancellation_window_days === 1 ? '' : 's'} for a full refund of the deposit. After that, a {fmtMoney(row.cancellation_fee_amount)} cancellation fee applies. Once work starts, the deposit is non-refundable.
          </div>
          <div class="term-block">
            <strong>Late payments:</strong> Any payment more than {row.late_fee_grace_days} business day{row.late_fee_grace_days === 1 ? '' : 's'} late incurs a {fmtMoney(row.late_fee_amount)} fee.
          </div>
          <div class="term-block">
            <strong>Workmanship warranty:</strong> {row.warranty_months} months from project completion.
          </div>
          {terms.marketing_release?.enabled && terms.marketing_release.text && (
            <div class="term-block">
              <strong>Marketing release:</strong> {terms.marketing_release.text}
            </div>
          )}
          {Array.isArray(terms.custom_terms) && terms.custom_terms.length > 0 && terms.custom_terms.map((ct: any) => (
            ct?.text ? (
              <div class="term-block">
                {ct.title && <><strong>{ct.title}:</strong>{' '}</>}{ct.text}
              </div>
            ) : null
          ))}

          <h3 class="section-h">Signatures</h3>
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin: 8px 0 14px;">
            <div style="background: #fff; border: 1px solid #e2e8f0; border-radius: 8px; padding: 12px; text-align: center; min-height: 110px; display: flex; flex-direction: column; justify-content: space-between;">
              {customerSignature ? (
                <>
                  <img src={customerSignature.signature_data_url} alt={`Signature by ${customerSignature.signer_name}`} style="max-height: 70px; max-width: 100%; margin: 0 auto;" />
                  <div style="margin-top: 6px; font-size: 12px; color: #1e293b;">
                    <strong>{customerSignature.signer_name}</strong>
                  </div>
                  <div style="font-size: 11px; color: #64748b;">Customer · {fmtDate(customerSignature.signed_at)}</div>
                </>
              ) : (
                <div style="color: #94a3b8; font-size: 12px; align-self: center; padding: 24px 0;">Customer signature</div>
              )}
            </div>
            <div style="background: #fff; border: 1px solid #e2e8f0; border-radius: 8px; padding: 12px; text-align: center; min-height: 110px; display: flex; flex-direction: column; justify-content: space-between;">
              {contractorSignature ? (
                <>
                  <img src={contractorSignature.signature_data_url} alt={`Signature by ${contractorSignature.signer_name}`} style="max-height: 70px; max-width: 100%; margin: 0 auto;" />
                  <div style="margin-top: 6px; font-size: 12px; color: #1e293b;">
                    <strong>{contractorSignature.signer_name}</strong>
                  </div>
                  <div style="font-size: 11px; color: #64748b;">Contractor · {fmtDate(contractorSignature.signed_at)}</div>
                </>
              ) : (
                <div style="color: #94a3b8; font-size: 12px; align-self: center; padding: 24px 0;">Contractor signature</div>
              )}
            </div>
          </div>

          {customerSignature && (
            <div style="margin-top: 14px; padding: 14px 16px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 10px; font-size: 12px; line-height: 1.6; color: #475569;">
              <div style="font-weight: 700; color: #0f172a; font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 8px;">Signature Audit Trail</div>
              <div style="display: grid; grid-template-columns: 110px 1fr; gap: 4px 12px;">
                <div>Signed by</div><div><strong style="color:#0f172a;">{customerSignature.signer_name}</strong></div>
                <div>Date &amp; time</div><div>{fmtFullDateTime(customerSignature.signed_at)}</div>
                {customerSignature.ip_address && (<><div>IP address</div><div>{customerSignature.ip_address}</div></>)}
                {customerSignature.user_agent && (<><div>Device</div><div>{parseUserAgent(customerSignature.user_agent)}</div></>)}
                <div>Contract</div><div>#{row.project_number}</div>
                {customerSignature.consent_text && (<><div>Consent</div><div style="font-style: italic; color: #64748b;">{customerSignature.consent_text}</div></>)}
              </div>
              <div style="margin-top: 10px; padding-top: 8px; border-top: 1px dashed #cbd5e1; font-size: 10px; color: #94a3b8;">
                Recorded under the ESIGN Act (15 U.S.C. § 7001 et seq.) and Massachusetts UETA.
              </div>
            </div>
          )}

          <div class="btn-row">
            <a href="https://mannyknows.com" class="btn btn-secondary">Return to Website</a>
          </div>
        </div>
      </div>
    ) : (
      <div class="card">
        <div class="card-header" style="text-align: center;">
          <span class="badge badge-blue">CONTRACT #{row.project_number}</span>
          <div style="margin-top: 10px;">
            <a href={`/project/contract-preview/${token}/`} target="_blank" rel="noopener" class="pdf-link">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
              Download PDF
            </a>
          </div>
        </div>
        <div class="card-body">
          <h2>Review &amp; Sign Your Contract</h2>
          <p class="message">
            Hi {firstName}! Please review the full contract below — scope of work, payment schedule, and terms — then sign at the bottom to authorize {brand.name} to begin your project.
          </p>

          <div class="summary">
            <div class="summary-row"><span class="label">Customer</span><span class="value">{row.customer_name}</span></div>
            <div class="summary-row"><span class="label">Work site</span><span class="value">{fullAddress}</span></div>
            <div class="summary-row"><span class="label">Start date</span><span class="value">{fmtDate(row.start_date)}</span></div>
            <div class="summary-row total-row"><span class="label">Total</span><span class="value">{fmtMoney(total)}</span></div>
