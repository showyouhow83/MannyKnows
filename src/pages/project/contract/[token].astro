          </p>
          <table class="pay-table">
            <thead>
              <tr>
                <th style="width: 100px;">Kind</th>
                <th>Label</th>
                <th style="width: 130px;">Due date</th>
                <th style="width: 120px; text-align:right;">Amount</th>
                {hasReceipts && <th style="width: 180px;">Signatures</th>}
              </tr>
            </thead>
            <tbody>
              {paymentSchedule.map((r) => {
                const rec = receiptByRow[r.id];
                return (
                <tr>
                  <td style="text-transform: capitalize; font-size:12px; color:#475569;">{r.kind}</td>
                  <td>{r.label}</td>
                  <td>{fmtDate(r.due_date)}</td>
                  <td class="amount">{fmtMoney(r.amount)}</td>
                  {hasReceipts && (rec ? (
                    <td style="font-size:9px; color:#475569;">
                      <div style="display:flex; gap:10px; align-items:flex-end;">
                        <div style="flex:1; min-width:0;">
                          {rec.customer_signature_data_url && (<img src={rec.customer_signature_data_url} alt="Client signature" style="display:block; max-height:26px; max-width:100%;" />)}
                          <div style="border-top:1px solid #94a3b8; padding-top:2px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">Client{rec.customer_name ? ` — ${rec.customer_name}` : ''}</div>
                        </div>
                        <div style="flex:1; min-width:0;">
                          {rec.contractor_signature_data_url && (<img src={rec.contractor_signature_data_url} alt="Contractor signature" style="display:block; max-height:26px; max-width:100%;" />)}
                          <div style="border-top:1px solid #94a3b8; padding-top:2px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">Contractor</div>
                        </div>
                      </div>
                      <div style="margin-top:2px; color:#16a34a; font-weight:700;">PAID {rec.collected_at ? fmtDate(rec.collected_at) : ''}{rec.payment_method ? ` · ${rec.payment_method}` : ''}{rec.check_number ? ` #${rec.check_number}` : ''}</div>
                    </td>
                  ) : (
                    <td style="font-size:10px; color:#94a3b8;">Client _______ / Contractor _______</td>
                  ))}
                </tr>
                );
              })}
              {paymentSchedule.length > 0 && (
                <tr style="background: #fef9c3; font-weight: 700; border-top: 2px solid #0f172a;">
                  <td colspan="3">TOTAL</td>
                  <td class="amount">{fmtMoney(scheduleTotal)}</td>
                  {hasReceipts && <td></td>}
                </tr>
              )}
            </tbody>
          </table>

          <h3 class="section-h">Terms</h3>
          <div class="term-block">
            <strong>Cancellation:</strong> You have {row.cancellation_window_days} day{row.cancellation_window_days === 1 ? '' : 's'} to cancel for a full refund of the deposit. After that window, a {fmtMoney(row.cancellation_fee_amount)} cancellation fee applies. Once work starts, the deposit is non-refundable.
          </div>
          <div class="term-block">
            <strong>Late payments:</strong> Any invoice or progress payment not received within {row.late_fee_grace_days} business day{row.late_fee_grace_days === 1 ? '' : 's'} of the due date will be considered late, and a late fee of {fmtMoney(row.late_fee_amount)} will be applied.
          </div>
          <div class="term-block">
            <strong>Workmanship warranty:</strong> {row.warranty_months} months from the project completion date. Covers application failures by our workers; excludes weather, homeowner-caused damage, structural issues, and flaking of old paint.
          </div>
          {terms.marketing_release?.enabled && terms.marketing_release.text && (
            <div class="term-block">
              <strong>Marketing release:</strong> {terms.marketing_release.text}
            </div>
          )}
          {Array.isArray(terms.custom_terms) && terms.custom_terms.length > 0 && terms.custom_terms.map((ct: any) => (
            ct?.text ? (
              <div class="term-block">
                {ct.title && <><strong>{ct.title}:</strong>{' '}</>}{ct.text}
              </div>
            ) : null
          ))}

          {terms.reference_request?.enabled && (
            <div class="ref-block">
              <strong style="font-size:13px;">{terms.reference_request.text || 'Can we use you as a reference?'}</strong>
              <div class="ref-row">
                <label><input type="radio" name="useAsReference" value="yes"> Yes</label>
                <label><input type="radio" name="useAsReference" value="no"> No</label>
                <span style="font-size:11px; color:#94a3b8;">(optional)</span>
              </div>
            </div>
          )}

          <h3 class="section-h">Sign &amp; Authorize</h3>
          {/* Stash the prior signature data URL on a hidden element so the
              inline script can read it without needing JSON.parse + string
              escaping inside the script tag itself. */}
          {priorSignature && (
            <input type="hidden" id="priorSigData" value={priorSignature.signature_data_url} />
          )}
          {priorSignature && (
            <input type="hidden" id="priorSigName" value={priorSignature.signer_name} />
          )}
          <form id="confirm-form" novalidate>
            <input type="hidden" name="token" value={token}>

            <div class="sig-block">
              <div class="sig-label">Customer signature</div>
              {priorSignature && (
                <div style="margin-bottom: 10px; padding: 10px 12px; background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 8px; display: flex; align-items: center; gap: 10px; flex-wrap: wrap; font-size: 13px;">
                  <span style="color: #1e40af; flex: 1;">
                    Reuse the signature you drew on quote <strong>{priorSignature.quote_number}</strong> ({fmtDate(priorSignature.signed_at)})?
                  </span>
                  <button type="button" id="reuseSigBtn" style="padding: 6px 14px; background: #ff781d; color: white; border: none; border-radius: 6px; font-size: 12px; font-weight: 700; cursor: pointer;">Reuse signature</button>
                </div>
              )}
              <div class="sig-pad-wrap is-empty" id="sigPadWrap">
                <canvas class="sig-pad" id="sigPad" width="600" height="160"></canvas>
              </div>
              <div class="sig-actions">
                <span>Use your finger or mouse to sign.</span>
                <button type="button" class="sig-clear" id="sigClearBtn">Clear</button>
              </div>

              <input type="text" id="sigNameInput" class="sig-name-input" placeholder="Type your full legal name" autocomplete="name" required>

              <div class="sig-consent">
                <input type="checkbox" id="sigConsentBox">
                <label for="sigConsentBox" id="sigConsentLabel">
                  I agree that my electronic signature above and my typed name are the legal equivalent of my manual handwritten signature. I authorize {brand.name} to begin the project at the agreed price, subject to the payment schedule and terms shown above.
                </label>
              </div>
            </div>

            <div class="form-error" id="formError"></div>

            <div class="btn-row">
              <button type="submit" class="btn btn-primary" id="acceptBtn" disabled>
                <span class="btn-text">Sign &amp; authorize</span>
                <span class="loading"><span class="spinner"></span>Processing…</span>
              </button>
            </div>
          </form>

          {contractorSignature && (
            <>
              <h3 class="section-h" style="margin-top: 28px;">Already signed by {brand.name}</h3>
              <div style="background: #fff; border: 1px solid #e2e8f0; border-radius: 10px; padding: 16px; text-align: center;">
                <img src={contractorSignature.signature_data_url} alt={`Signature by ${contractorSignature.signer_name}`} style="max-height: 80px; max-width: 100%; margin: 0 auto;" />
                <div style="margin-top: 8px; font-size: 13px; color: #1e293b;">
                  <strong>{contractorSignature.signer_name}</strong>
                </div>
                <div style="font-size: 11px; color: #64748b;">Contractor · Counter-signed {fmtDate(contractorSignature.signed_at)}</div>
              </div>
            </>
          )}
        </div>
      </div>
    )}
  </main>

  <footer class="footer">
    <a href="https://mannyknows.com" style="display: inline-block; text-decoration: none;">
      {!brand.isPartner
        ? <img src="/logo.svg" alt="MannyKnows" width="140" height="54" class="footer-logo" style="border-radius:0;" />
        : brand.logoUrl
          ? <img src={brand.logoUrl} alt={brand.name} class="footer-logo partner-logo" />
          : <span class="header-logo-name" style="font-size:20px;">{brand.name}</span>}
    </a>
    {!brand.isPartner && <p>Remodeling, Painting &amp; Home Repairs — Springfield, MA</p>}
    <div class="footer-links">
      {brand.websiteLabel && <a href={brand.websiteUrl}>{brand.websiteLabel}</a>}
      {brand.websiteLabel && brand.phoneDisplay && <span>|</span>}
      {brand.phoneDisplay && <a href={`tel:${brand.phoneTel}`}>{brand.phoneDisplay}</a>}
    </div>
    {brand.isPartner
      ? (brand.addressLines.length > 0 && <p class="footer-certs">{brand.addressLines.join(', ')}</p>)
      : (COMPANY_HEADER.licenseNumber && <p class="footer-certs">MA HIC License #{COMPANY_HEADER.licenseNumber}</p>)}
  </footer>

  <script is:inline>
    (function() {
      var form = document.getElementById('confirm-form');
      if (!form) return;

      var canvas = document.getElementById('sigPad');
      var padWrap = document.getElementById('sigPadWrap');
      var clearBtn = document.getElementById('sigClearBtn');
      var nameInput = document.getElementById('sigNameInput');
      var consentBox = document.getElementById('sigConsentBox');
      var consentLabel = document.getElementById('sigConsentLabel');
      var submitBtn = document.getElementById('acceptBtn');
      var errorEl = document.getElementById('formError');
      if (!canvas || !nameInput || !consentBox || !submitBtn) return;

      var drawing = false;
      var hasStrokes = false;
      // Make the canvas internal resolution = bounding box * DPR so the
      // strokes stay crisp on retina screens.
      var lastCanvasW = 0, lastCanvasH = 0;
      function resizeCanvas() {
        var ratio = window.devicePixelRatio || 1;
        var rect = canvas.getBoundingClientRect();
        var w = Math.round(rect.width), h = Math.round(rect.height);
        if (!w || !h) return;
        // Skip spurious mobile resize events (URL-bar show/hide on scroll,
        // keyboard open/close) that don't change the pad's size — re-initing
        // the backing store wipes the signature even though hasStrokes is true,
        // exporting a blank canvas to the signed PDF.
        if (w === lastCanvasW && h === lastCanvasH) return;
        var prev = hasStrokes ? canvas.toDataURL('image/png') : null;
        lastCanvasW = w; lastCanvasH = h;
        canvas.width = w * ratio;
        canvas.height = h * ratio;
        var ctx = canvas.getContext('2d');
        ctx.scale(ratio, ratio);
        ctx.lineWidth = 2.2;
        ctx.lineCap = 'round';
        ctx.lineJoin = 'round';
        ctx.strokeStyle = '#0f172a';
        if (prev) {
          var img = new Image();
          img.onload = function() { ctx.drawImage(img, 0, 0, w, h); };
          img.src = prev;
        }
      }
      resizeCanvas();
      window.addEventListener('resize', resizeCanvas);
      window.addEventListener('orientationchange', function () { setTimeout(resizeCanvas, 250); });
      function pointFromEvent(e) {
        var rect = canvas.getBoundingClientRect();
        var clientX = (e.touches ? e.touches[0].clientX : e.clientX);
        var clientY = (e.touches ? e.touches[0].clientY : e.clientY);
        return { x: clientX - rect.left, y: clientY - rect.top };
      }
      function startStroke(e) {
        e.preventDefault();
        drawing = true;
        var p = pointFromEvent(e);
        var ctx = canvas.getContext('2d');
        ctx.beginPath();
        ctx.moveTo(p.x, p.y);
      }
      function continueStroke(e) {
        if (!drawing) return;
        e.preventDefault();
        var p = pointFromEvent(e);
        var ctx = canvas.getContext('2d');
        ctx.lineTo(p.x, p.y);
        ctx.stroke();
        if (!hasStrokes) {
          hasStrokes = true;
          padWrap.classList.remove('is-empty');
          updateSubmitState();
        }
      }
      function endStroke() { drawing = false; }
      canvas.addEventListener('mousedown', startStroke);
      canvas.addEventListener('mousemove', continueStroke);
      window.addEventListener('mouseup', endStroke);
      canvas.addEventListener('touchstart', startStroke, { passive: false });
      canvas.addEventListener('touchmove', continueStroke, { passive: false });
      canvas.addEventListener('touchend', endStroke);

      clearBtn?.addEventListener('click', function() {
        var ctx = canvas.getContext('2d');
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        hasStrokes = false;
        padWrap.classList.add('is-empty');
        updateSubmitState();
      });

      // Reuse-prior-signature shortcut. Paint the customer's prior quote
      // signature onto the canvas + fill the typed-name field. They still
      // have to tick the consent box themselves (intent has to be fresh on
      // each new document for ESIGN compliance).
      var reuseBtn = document.getElementById('reuseSigBtn');
      var priorSigData = document.getElementById('priorSigData');
      var priorSigName = document.getElementById('priorSigName');
      if (reuseBtn && priorSigData && priorSigData.value) {
        reuseBtn.addEventListener('click', function() {
          var img = new Image();
          img.onload = function() {
            var ctx = canvas.getContext('2d');
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            // Fit the prior signature into the canvas while preserving its
            // aspect ratio. Centered horizontally + vertically. The canvas
            // is already ctx.scale(devicePixelRatio) from resizeCanvas, so
            // we work in unscaled CSS pixels.
            var rect = canvas.getBoundingClientRect();
            var cw = rect.width;
            var ch = rect.height;
            var iw = img.naturalWidth || img.width;
            var ih = img.naturalHeight || img.height;
            var scale = Math.min(cw / iw, ch / ih);
            var dw = iw * scale;
            var dh = ih * scale;
            var dx = (cw - dw) / 2;
            var dy = (ch - dh) / 2;
            // Need to use the css coords since we already ctx.scale(ratio)
            // when resizing the canvas — work in unscaled CSS pixels.
            ctx.drawImage(img, dx, dy, dw, dh);
            hasStrokes = true;
            padWrap.classList.remove('is-empty');
            if (priorSigName && priorSigName.value && !nameInput.value) {
              nameInput.value = priorSigName.value;
            }
            updateSubmitState();
          };
          img.src = priorSigData.value;
        });
      }

      function updateSubmitState() {
        var ok = hasStrokes && nameInput.value.trim().length >= 2 && consentBox.checked;
        submitBtn.disabled = !ok;
      }
      nameInput.addEventListener('input', updateSubmitState);
      consentBox.addEventListener('change', updateSubmitState);

      function showError(msg) {
        errorEl.textContent = msg;
        errorEl.classList.add('visible');
      }
      function clearError() {
        errorEl.classList.remove('visible');
        errorEl.textContent = '';
      }

      form.addEventListener('submit', async function(e) {
        e.preventDefault();
        clearError();
        if (!hasStrokes) { showError('Please draw your signature in the box above.'); return; }
        var typedName = (nameInput.value || '').trim();
        if (typedName.length < 2) { showError('Please type your full legal name.'); return; }
        if (!consentBox.checked) { showError('Please tick the consent box to authorize.'); return; }

        form.classList.add('submitted');
        var fd = new FormData(form);
        var token = fd.get('token');
        var sigDataUrl = canvas.toDataURL('image/png');
        var consentText = (consentLabel.textContent || '').trim();
        var refInput = document.querySelector('input[name="useAsReference"]:checked');
        var useAsReference = refInput ? (refInput.value === 'yes') : null;

        try {
          var response = await fetch('/api/projects/contract/sign/', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              token: token,
              signature_data_url: sigDataUrl,
              signer_name: typedName,
              consent_text: consentText,
              use_as_reference: useAsReference,
            }),
          });
          var data = await response.json();
          if (data && data.success) {
            // Kick off the signed-contract PDF auto-gen BEFORE redirect so
            // the iframe survives long enough to finish. We give it up to
            // 25s (typical render is ~8s; this is generous), then redirect
            // regardless — the admin can backfill if anything went wrong.
            // The iframe loads /admin/projects/[id]/contract/preview with
            // ?token=...&autosave=1 and uses the contract_token for auth.
            var autosaveDone = false;
            function finishRedirect() {
              if (autosaveDone) return;
              autosaveDone = true;
              var here = window.location.pathname;
              window.location.href = here + (here.endsWith('/') ? '' : '/') + '?signed=1';
            }
            if (data.project_id) {
              try {
                var iframe = document.createElement('iframe');
                iframe.setAttribute('aria-hidden', 'true');
                iframe.style.cssText = 'position:fixed; left:-9999px; top:0; width:900px; height:1400px; border:0; opacity:0; pointer-events:none;';
                iframe.src = '/admin/projects/' + data.project_id + '/contract/preview/?token=' + encodeURIComponent(token) + '&autosave=1';
                function onMsg(e) {
                  var msg = e.data;
                  if (!msg || typeof msg !== 'object') return;
                  if (msg.projectId !== Number(data.project_id)) return;
                  if (msg.type === 'sl-contract-signed-pdf-saved' || msg.type === 'sl-contract-signed-pdf-failed') {
                    window.removeEventListener('message', onMsg);
                    finishRedirect();
                  }
                }
                window.addEventListener('message', onMsg);
                document.body.appendChild(iframe);
                // Hard timeout fallback so a stalled iframe doesn't trap
                // the customer on a never-resolving "Saving…" screen.
                setTimeout(finishRedirect, 25000);
              } catch (_) {
                finishRedirect();
              }
            } else {
              finishRedirect();
            }
          } else {
            showError((data && data.error) || 'Something went wrong. Please try again.');
            form.classList.remove('submitted');
          }
        } catch {
          showError('Failed to connect. Please check your internet and try again.');
          form.classList.remove('submitted');
        }
      });
    })();
  </script>
</body>
</html>
