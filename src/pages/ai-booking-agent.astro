---
// AI Booking Agent lander — targets the "AI booking agent / AI answering
// service for small business" query cluster, where we have real shipped proof
// (JK Daycare: site agent + Twilio IVR in two weeks; SL Painting: 24/7
// qualifying agent) that national SaaS tools can't match locally.
// Every claim traces to the published case studies or the data files.
//
// The agent has a name: Remi AI, and this is its OWN product page (Manny,
// Aug 2026 restructure): Remi sells standalone, separate from the AI Agents
// Team and the website plans. The ladder, prices, and admin matrix live in
// src/data/remi.ts — every number here interpolates from there.
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import NavBar from '../components/navigation/NavBar.astro';
import Section from '../components/layout/Section.astro';
import Container from '../components/layout/Container.astro';
import DockMenu from '../components/navigation/DockMenu.astro';
import Faq from '../components/ui/Faq.astro';
import AgentAvatar from '../components/team/AgentAvatar.astro';
import PricingCards, { type PricingCard } from '../components/pricing/PricingCards.astro';
import { remiTiers, remiCustom, remiMatrix, remiSetupFee, remiLiteMonthly, remiMidMonthly, remiProMonthly } from '../data/remi';
import { plans } from '../data/plans';

const PHONE_DISPLAY = '(413) 361-8451';
const PHONE_TEL = '+14133618451';

// The cheapest plan that ships Remi AI — for the "already included" note.
const getFound = plans.find((p) => p.slug === 'get-found')!;

// The ladder on the shared pricing grid — same anatomy as /plans, /ecommerce,
// /apps and /local-seo, so pricing reads identically everywhere.
const remiCards: PricingCard[] = remiTiers.map((t) => ({
  name: t.name,
  audience: t.audience,
  price: t.price,
  setupFee: remiSetupFee,
  scope: t.scope,
  tagline: t.tagline,
  features: t.features,
  featured: t.featured,
  primary: { label: `Start with ${t.name}`, href: '#contact', context: `Remi AI plans: ${t.name}` },
}));

const FAQS = [
  {
    q: 'What does an AI booking agent cost?',
    a: `Remi AI has three plans plus a custom build. Every plan carries the one-time $${remiSetupFee} setup, waived when you prepay a year (which also gets you 2 months free):`,
    table: {
      head: ['How you get Remi AI', 'Price'],
      rows: [
        ['Remi AI Lite — answers & captures leads', `$${remiLiteMonthly}/mo + $${remiSetupFee} setup`],
        ['Remi AI — Lite plus the full customization admin', `$${remiMidMonthly}/mo + $${remiSetupFee} setup`],
        ['Remi AI Pro — books into your calendar', `$${remiProMonthly}/mo + $${remiSetupFee} setup`],
        ['Remi AI Custom — phone IVR & deep integrations', 'From $2,500, quoted'],
        ['Already inside every website plan', `From $${getFound.price}/mo (the plan price)`],
      ],
    },
  },
  { q: 'Which Remi AI books appointments?', a: 'Remi AI Pro. It books the appointment into your admin calendar and syncs it to the business or personal calendar you already use, so the job shows up where you actually look. On the website plans, booking arrives with Get Booked. Lite and the middle plan answer, qualify, and capture the lead for you to close.' },
  { q: 'Does it work with the website I already have?', a: "Yes. Every Remi AI plan is one embed snippet on the site you already have, whatever it's built on — nothing gets rebuilt. And if you don't have a website, a fast one-page site on your own domain is included at no extra cost." },
  { q: 'Do I manage Remi AI myself?', a: "Yes, through your own admin. We configure Remi AI for your business at setup and train you on the admin; from there it's yours — the Brand Brain it answers from, your leads inbox, and every control your plan unlocks. You never file a ticket to change a price or an opening hour." },
  { q: 'Does the AI booking agent speak Spanish?', a: 'Yes, English and Spanish are standard on everything we build, not an add-on. Remi AI answers in whichever language the customer starts with.' },
  { q: 'Can it answer phone calls, or just website chat?', a: "On your site it answers, and on Remi AI Pro it books. For your phone line, Remi AI Custom answers every call and routes it to the right person — that's a quoted build." },
  { q: 'How fast can it be live?', a: 'Minutes. Remi AI is configured and added to your website that fast. A full build (website, AI agent, and a phone system routing every call) has gone from kickoff to live in two weeks.' },
];

// Kept under 160 chars — search results truncate past that (SEO pass, Aug 2026).
const META_DESCRIPTION = `Remi AI answers your customers 24/7 in English or Spanish, captures every lead, and books jobs into your calendar. Plans from $${remiLiteMonthly}/mo, on any website.`;

const pageJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Remi AI: AI Booking Agent for Small Businesses',
  serviceType: 'AI booking agent and AI answering service development',
  provider: {
    '@type': 'ProfessionalService',
    '@id': 'https://mannyknows.com/#business',
    name: 'MannyKnows',
    url: 'https://mannyknows.com',
    telephone: '+1-413-361-8451',
    address: { '@type': 'PostalAddress', addressLocality: 'Springfield', addressRegion: 'MA', addressCountry: 'US' },
  },
  areaServed: 'Western Massachusetts',
  description: META_DESCRIPTION,
  // Recurring price in `price`; the one-time setup rides in the description so
  // the offer never implies all-in pricing (same pattern as /ecommerce).
  offers: [
    ...remiTiers.map((t) => ({
      '@type': 'Offer',
      name: t.name,
      price: String(t.price),
      priceCurrency: 'USD',
      description: `${t.scope}. $${t.price}/mo plus a one-time $${remiSetupFee} setup, waived on a prepaid year.`,
    })),
    { '@type': 'Offer', name: remiCustom.name, description: 'Phone IVR and deep integrations, scoped and quoted from $2,500; its running monthly is quoted with the build.' },
  ],
};
---

<BaseLayout title="Remi AI, the AI Booking Agent for Western Mass | MannyKnows" description={META_DESCRIPTION}>
  <script type="application/ld+json" set:html={JSON.stringify(pageJsonLd)} />
  {/* one-canvas: one tone for the whole page instead of a different colour
      per section (Manny, Aug 2026). Hue is grouped by pillar — see the
      ONE-TONE CANVAS block in global.css. The per-section .room /
      .chain-* / .glow-* classes below are left in place on purpose:
      delete the two classes on the next line and the page reverts. */}
  <main class="relative bg-light-primary dark:bg-dark-primary text-text-light-primary dark:text-text-dark-primary min-h-screen transition-colors duration-300 one-canvas one-canvas-live">

    <header class="relative bg-gradient-to-t from-gray-50/50 via-gray-100/30 to-gray-50/20 dark:from-gray-900/60 dark:via-slate-800/40 dark:to-gray-900/30 transition-colors duration-300 room-hero">
      <NavBar />
      <nav aria-label="breadcrumb" class="max-w-[1440px] mx-auto px-4 lg:px-6 pt-6 pb-4">
        <ol class="flex flex-wrap items-center gap-2 text-sm text-text-light-secondary dark:text-text-dark-secondary">
          <li><a href="/" class="hover:text-primary-blue transition-colors">Home</a></li>
          <li class="flex items-center"><span class="mx-2 text-text-light-tertiary dark:text-text-dark-tertiary">/</span><span class="text-text-light-primary dark:text-text-dark-primary font-medium">AI Booking Agent</span></li>
        </ol>
      </nav>

      <div class="pb-16 px-4 sm:px-6 lg:px-8">
        <div class="max-w-[1440px] mx-auto text-center">
          <!-- Remi AI himself, not a generic spot illustration (Manny, Aug 2026) -->
          <div class="flex justify-center mb-6">
            <div class="w-32 h-32 md:w-40 md:h-40 rounded-3xl bg-gradient-to-br from-primary-blue/[0.07] via-transparent to-primary-pink/[0.07]">
              <AgentAvatar agent="desi" class="w-full h-full" />
            </div>
          </div>
          <span class="inline-block bg-gradient-to-r from-primary-blue/10 via-purple-500/10 to-primary-pink/10 text-primary-blue px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider mb-5">
            AI Business Chatbot
          </span>
          <h1 class="sf-bold apple-headline text-4xl md:text-5xl lg:text-6xl mb-6 leading-tight">
            <span class="apple-gradient-text" data-colorful-title>AI agents that answer,<br /> qualify &amp; book leads, 24/7</span>
          </h1>
          <p class="max-w-3xl mx-auto text-base sm:text-xl text-text-light-secondary dark:text-text-dark-secondary leading-relaxed mb-8">
            Most jobs are lost to the call nobody could answer. Remi AI is our AI booking agent for Western Mass small businesses. Trained on your business, it answers customer questions in English or Spanish, asks the qualifying questions you would, and books the appointment while you're away.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
            <a href="#contact" data-contact-context="AI booking agent" class="inline-flex items-center justify-center gap-2 px-7 h-12 rounded-full bg-gradient-to-r from-primary-blue via-purple-500 to-primary-pink text-white font-semibold hover:shadow-lg hover:shadow-primary-blue/25 transition-shadow">
              Get your booking agent
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
            </a>
            <!-- Launches the live site agent (our opscloud.us app, agent_manny_mk).
                 The widget opens on a hash matching its own configured name, which is
                 "Astro" on our account, so #astro is the trigger (#chat also works).
                 It re-checks on hashchange, so this stays a same-page anchor and opens
                 the agent right here instead of bouncing the visitor to the homepage.
                 Name it Astro here, not Remi AI, because Astro is who greets the visitor. -->
            <a href="/ai-booking-agent/#astro?menu=demo" class="inline-flex items-center justify-center gap-2 px-6 h-12 rounded-full border border-light-tertiary dark:border-dark-accent text-text-light-primary dark:text-text-dark-primary font-medium hover:border-primary-blue/40 transition-colors">
              Test Astro, our own “Remi” AI agent
            </a>
          </div>
          <p class="mt-5 text-sm text-text-light-tertiary dark:text-text-dark-tertiary">
            English &amp; Spanish standard · Plans from ${remiLiteMonthly}/mo · Built in Springfield, MA
          </p>
        </div>
      </div>
    </header>

    <!-- The Remi AI plans — the shared pricing grid (same anatomy as /plans),
         then the custom build as its own band, then the admin matrix. -->
    <Section id="versions" variant="alternate" className="room chain-violet-blue">
      <Container>
        <div class="text-center max-w-2xl mx-auto mb-12">
          <h2 class="sf-bold text-2xl md:text-3xl font-bold mb-4"><span class="apple-gradient-text" data-colorful-title>One Remi AI, three sizes</span></h2>
          <p class="text-text-light-secondary dark:text-text-dark-secondary leading-relaxed">
            Pick by what you want Remi AI doing. Move up anytime — the training carries, and the tiers differ by which admin controls they unlock, not by which agent you get.
          </p>
        </div>

        <PricingCards id="remi-plans" cards={remiCards} billing="monthly" featuredLabel="Most popular" />

        <p class="mt-6 text-center text-xs text-text-light-tertiary dark:text-text-dark-tertiary max-w-2xl mx-auto">
          No website? A one-page site on your own domain is included with any plan — <a href="/ai-website/" class="text-primary-blue dark:text-blue-300 font-medium hover:underline">see the One-Page Website</a>. Already on a <a href="/plans/" class="text-primary-blue dark:text-blue-300 font-medium hover:underline">website plan</a>? Remi AI is in there from Get Found up.
        </p>

        <!-- The fourth door: a build, not a subscription, so it sits outside
             the grid — same pattern as the Custom tier band on /apps. -->
        <div class="max-w-6xl mx-auto mt-10 rounded-3xl border border-primary-blue/30 ring-1 ring-primary-blue/10 bg-white dark:bg-dark-secondary p-6 sm:p-8">
          <div class="flex flex-col lg:flex-row lg:items-center gap-6">
            <div class="flex-1">
              <span class="text-[11px] font-bold uppercase tracking-wider text-primary-blue dark:text-blue-300">Built around you</span>
              <h3 class="text-xl font-bold text-text-light-primary dark:text-text-dark-primary mt-1 mb-3">{remiCustom.name}</h3>
              <ul class="grid sm:grid-cols-2 gap-x-6 gap-y-2">
                {remiCustom.points.map((pt) => (
                  <li class="flex items-start gap-2 text-sm text-text-light-secondary dark:text-text-dark-secondary leading-snug">
                    <svg class="w-4 h-4 mt-0.5 flex-shrink-0 text-primary-blue dark:text-blue-300" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                    <span>{pt}</span>
                  </li>
                ))}
              </ul>
            </div>
            <div class="flex-shrink-0 text-center lg:text-right">
              <div class="text-2xl font-black text-text-light-primary dark:text-text-dark-primary leading-none">{remiCustom.priceLabel}</div>
              <p class="mt-1.5 text-xs text-text-light-tertiary dark:text-text-dark-tertiary max-w-[220px] mx-auto lg:mx-0 lg:ml-auto">{remiCustom.priceNote}</p>
              <a href="#contact" data-contact-context="Remi AI Custom build" class="mt-4 inline-flex items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-primary-blue to-primary-pink text-white px-6 py-3 text-sm font-semibold transition-all duration-300">
                Scope a build
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
              </a>
            </div>
          </div>
        </div>
      </Container>
    </Section>

    <!-- The admin matrix: what each plan unlocks. This is the real difference
         between tiers — we configure Remi AI at setup and train you, then the
         admin is yours. Rows come from src/data/remi.ts. -->
    <Section id="admin" variant="default" className="room chain-blue-violet">
      <Container>
        <div class="text-center max-w-2xl mx-auto mb-10">
          <h2 class="sf-bold text-2xl md:text-3xl font-bold mb-4"><span class="apple-gradient-text" data-colorful-title>Your admin, plan by plan</span></h2>
          <p class="text-text-light-secondary dark:text-text-dark-secondary leading-relaxed">
            Every plan comes with your own admin. We set Remi AI up and train you on it; what you can reach in there depends on the plan.
          </p>
        </div>
        <div class="max-w-4xl mx-auto overflow-x-auto">
          <table class="w-full text-sm border-collapse min-w-[560px]">
            <thead>
              <tr>
                <th class="text-left pb-3 pr-4 text-[11px] font-bold uppercase tracking-wider text-text-light-tertiary dark:text-text-dark-tertiary border-b border-light-tertiary dark:border-dark-accent">In the admin</th>
                {remiTiers.map((t) => (
                  <th class="pb-3 px-3 text-center text-[11px] font-bold uppercase tracking-wider text-text-light-primary dark:text-text-dark-primary border-b border-light-tertiary dark:border-dark-accent whitespace-nowrap">{t.name}</th>
                ))}
              </tr>
            </thead>
            <tbody>
              {remiMatrix.map((row) => (
                <tr>
                  <td class="py-3 pr-4 text-text-light-secondary dark:text-text-dark-secondary leading-snug border-b border-light-tertiary/60 dark:border-dark-accent/60">{row.label}</td>
                  {row.tiers.map((has) => (
                    <td class="py-3 px-3 text-center border-b border-light-tertiary/60 dark:border-dark-accent/60">
                      {has ? (
                        <svg class="w-4 h-4 inline-block text-primary-blue dark:text-blue-300" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                      ) : (
                        <span class="text-text-light-tertiary dark:text-text-dark-tertiary" aria-label="not included">—</span>
                      )}
                    </td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </Container>
    </Section>

    <!-- Proof (moved from under the hero, Manny, Aug 2026):
         shipped, named, linked: the thing national SaaS tools can't say. -->
    <Section id="proof" variant="default" className="room glow-blue">
      <!-- Case-study astronaut peeking from the left edge. -->
      <div class="cs-mascot" aria-hidden="true">
        <img src="/mascot/astro-casestudy.webp" alt="Astronaut mascot peeking at the case studies" aria-hidden="true" width="360" height="631" loading="lazy" decoding="async" />
      </div>
      <Container>
        <div class="text-center max-w-2xl mx-auto mb-12">
          <h2 class="sf-bold text-2xl md:text-3xl font-bold mb-4"><span class="apple-gradient-text" data-colorful-title>Answering Springfield customers today</span></h2>
          <p class="text-text-light-secondary dark:text-text-dark-secondary leading-relaxed">A daycare and a painting contractor, both case studies below.</p>
        </div>
        <div class="grid md:grid-cols-2 gap-6 max-w-5xl mx-auto">
          <div class="rounded-2xl border border-light-tertiary dark:border-dark-accent bg-white dark:bg-dark-secondary p-7 flex flex-col">
            <span class="text-[11px] font-bold uppercase tracking-wider text-primary-blue dark:text-blue-300 mb-3">Licensed childcare · Springfield</span>
            <h3 class="text-lg font-bold text-text-light-primary dark:text-text-dark-primary mb-2">JK Daycare got a website, AI agent &amp; phone system in two weeks</h3>
            <p class="text-sm text-text-light-secondary dark:text-text-dark-secondary leading-relaxed flex-1">Parents couldn't reach anyone midday and there was no website to answer them. Two weeks later they had a site with an AI agent answering parents' questions from the site's own content, plus a Twilio IVR phone system that gives callers what they need and routes them to the right person. Every call answered.</p>
            <a href="/work/jk-daycare/" class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-primary-blue dark:text-blue-300 hover:underline">
              Read the JK Daycare case study
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
            </a>
          </div>
          <div class="rounded-2xl border border-light-tertiary dark:border-dark-accent bg-white dark:bg-dark-secondary p-7 flex flex-col">
            <span class="text-[11px] font-bold uppercase tracking-wider text-primary-blue dark:text-blue-300 mb-3">Painting contractor · Springfield</span>
            <h3 class="text-lg font-bold text-text-light-primary dark:text-text-dark-primary mb-2">SL Painting gets leads qualified around the clock</h3>
            <p class="text-sm text-text-light-secondary dark:text-text-dark-secondary leading-relaxed flex-1">A contractor can't answer chat from a ladder. SL Painting's AI Sales &amp; Booking Agent answers questions and qualifies leads 24/7, so what reaches the crew is a real job with details, not a missed call. The same site now ranks #1 on Google, organically, for exterior painting in Springfield.</p>
            <a href="/work/sl-painting/" class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-primary-blue dark:text-blue-300 hover:underline">
              Read the SL Painting case study
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
            </a>
          </div>
        </div>
      </Container>
    </Section>

    <!-- FAQ closes the page (Manny, Aug 2026). The Faq component emits
         FAQPage schema; the contact CTA rides at its foot. -->
    <Section id="faq" variant="alternate" className="room glow-violet">
      <Container>
        <div class="max-w-3xl mx-auto">
          <Faq faqs={FAQS} heading="Booking-agent questions, answered" />
          <div class="text-center mt-12">
            <a href="#contact" data-contact-context="AI booking agent" class="inline-flex items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-primary-blue to-primary-pink text-white px-7 py-3.5 text-sm font-semibold transition-all duration-300">
              Talk about your booking agent
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
            </a>
            <p class="mt-4 text-sm text-text-light-tertiary dark:text-text-dark-tertiary">Or call <a href={`tel:${PHONE_TEL}`} class="text-primary-blue hover:underline">{PHONE_DISPLAY}</a>, English or Spanish.</p>
          </div>
        </div>
      </Container>
    </Section>

    <DockMenu />
  </main>
</BaseLayout>

<style>
  /* Case-study astronaut: left-edge peek on the proof section. */
  #proof { position: relative; overflow: hidden; }
  .cs-mascot {
    --mascot-height: 360px;
    --mascot-peek: 58%;
    --mascot-rotate: 31deg;

    position: absolute;
    top: 50%;
    left: 0;
    transform: translateY(-50%) translateX(calc(-100% + var(--mascot-peek)));
    pointer-events: none;
    z-index: 20;
  }
  .cs-mascot img {
    height: var(--mascot-height);
    width: auto;
    transform: rotate(var(--mascot-rotate));
  }
  @media (max-width: 1279px) {
    .cs-mascot { --mascot-height: 280px; }
  }
  @media (max-width: 639px) {
    .cs-mascot { display: none; }
  }

  .astro-float { animation: astro-float 6s ease-in-out infinite; will-change: transform; }
  @keyframes astro-float {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50%      { transform: translateY(-10px) rotate(-1.5deg); }
  }
  @media (prefers-reduced-motion: reduce) { .astro-float { animation: none; } }
</style>
