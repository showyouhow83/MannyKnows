---
// Terms of Service — styled to match the site.
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import NavBar from '../components/navigation/NavBar.astro';
import Section from '../components/layout/Section.astro';
import Container from '../components/layout/Container.astro';
import DockMenu from '../components/navigation/DockMenu.astro';
import Breadcrumb from '../components/ui/Breadcrumb.astro';
import { plans } from '../data/plans';

const effectiveDate = 'August 14, 2026';

// Setup fees and build values are read from plans.ts rather than typed here, so
// the legal page and the pricing grid cannot disagree after a reprice — this
// section is the one place the two numbers are published side by side.
const WEBSITE_SLUGS = ['get-found', 'get-booked', 'get-growing', 'get-ahead'];
const websiteBuilds = WEBSITE_SLUGS
  .map((slug) => plans.find((p) => p.slug === slug))
  .filter((p): p is NonNullable<typeof p> => Boolean(p?.setupFee));
const storeBuilds = (plans.find((p) => p.slug === 'sell-online')?.tiers ?? [])
  .filter((t) => Boolean(t.setupFee));
const fmt = (n: number) => n.toLocaleString('en-US');
---

<BaseLayout title="Terms of Service | MannyKnows"
  description="The terms that govern MannyKnows services, plans, and payments: what we deliver, what you agree to, and how billing works.">
  <main class="relative bg-light-primary dark:bg-dark-primary text-text-light-primary dark:text-text-dark-primary min-h-screen transition-colors duration-300">

    <header class="relative bg-light-primary dark:bg-dark-primary transition-colors duration-300">
      <NavBar />
      <Breadcrumb items={[{ label: 'Terms of Service' }]} />
      <div class="pb-10 px-4">
        <Container>
          <div class="max-w-3xl mx-auto text-center">
            <span class="inline-block bg-black/5 dark:bg-white/10 text-text-light-secondary dark:text-text-dark-secondary px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider mb-4">Legal</span>
            <h1 class="sf-bold apple-headline text-4xl md:text-5xl lg:text-6xl mb-5 leading-tight">
              <span class="text-text-light-primary dark:text-text-dark-primary">Terms of Service</span>
            </h1>
            <p class="text-lg text-text-light-secondary dark:text-text-dark-secondary leading-relaxed">The terms that govern your use of MannyKnows.</p>
            <p class="mt-3 text-sm text-text-light-tertiary dark:text-text-dark-tertiary">Effective date: {effectiveDate}</p>
          </div>
        </Container>
      </div>
    </header>

    <Section id="terms" variant="default">
      <Container>
        <article class="legal-prose max-w-3xl mx-auto">
          <p>Welcome to MannyKnows. These Terms of Service ("Terms") govern your access to and use of <a href="/">mannyknows.com</a> (the "Site") and any related content, tools, and services we provide (together, the "Services"). MannyKnows is a sole proprietorship based in Springfield, Massachusetts, serving businesses across Western Massachusetts and beyond. By using the Site, you agree to these Terms. If you do not agree, please do not use the Site.</p>

          <h2>1. Who may use the Services</h2>
          <p>You must be able to form a binding contract to use the Services. If you use the Services on behalf of an organization, you represent that you are authorized to accept these Terms on its behalf.</p>

          <h2>2. The Services</h2>
          <p>We build custom apps and websites and provide AI automation for small businesses. Our offerings include monthly website plans (Get Found, Get Booked, Get Growing, and Get Ahead) along with Sell Online, Business Ads, AI Agents Team, and Multimedia Agency plans, and one-time projects such as website builds, SEO, automation, AI adoption, and audits. The Site describes these offerings and lets you contact us and subscribe to our newsletter.</p>
          <p>Any specific project or paid engagement is governed by a separate written agreement between you and MannyKnows; if that agreement conflicts with these Terms, the separate agreement controls for that engagement.</p>

          <h3 id="free-360-photo" class="scroll-mt-24">Free 360° photo and paid photo packs</h3>
          <p>The free 360° photo offer provides one professional 360° photograph of your business, captured by us and published to your Google Business Profile through MannyKnows' own Google account. The free photo remains hosted and controlled by MannyKnows, includes MannyKnows branding within the image (typically at the zenith, the top of the sphere, and possibly at other points), and the image file itself is not delivered to you. If you'd like it removed from your listing at any time, ask and we'll take it down.</p>
          <p>Paid photography, including the 360° Photo Pack and any commissioned shoots, is different: once paid in full, the resulting files are delivered to you, contain no MannyKnows branding, and are yours to keep and use as you wish.</p>

          <h2>3. Plans, billing, and cancellation</h2>
          <p>Monthly plans come with two billing options. Published prices are "starting at" figures; the final price and scope for your engagement are set out in the written agreement or proposal for that engagement, which controls if it differs from these Terms.</p>
          <ul>
            <li><strong>Month to month:</strong> a one-time setup fee pays for the initial build (see <a href="#build-fee">Setup and the initial build</a>), and the plan then runs month to month at the standard monthly rate. There is no minimum term. You can cancel at any time and nothing further is owed; cancellation takes effect at the end of the then-current billing month, and the service keeps running until then. Fees already paid or owed for work performed are not refunded, except under the refund window described below.</li>
            <li><strong>Yearly (prepaid, discounted):</strong> you pay for 12 months of service up front at the discounted annual total, 10× the monthly rate, the equivalent of 2 months free, <strong>and the setup fee is waived in full</strong>. Both the discount and the waiver are conditioned on prepayment of the full 12-month term.</li>
            <li><strong>Ads plans:</strong> on advertising plans, you fund your advertising spend directly with the ad platforms; our fee covers strategy, creative, and management, not the ad spend itself, which we never mark up.</li>
          </ul>

          <h3 id="build-fee" class="scroll-mt-24">Setup and the initial build</h3>
          <p>Website and store plans include designing and building the site or store itself, work that is normally billed as a separate project. On month-to-month billing that build is paid for by a <strong>one-time setup fee</strong>, charged once at the start of the engagement. You then pay the monthly rate for the service, and the same rate each month after.</p>
          <p><strong>Prepay the year and the setup fee is waived in full.</strong> Nothing is charged for the build at all on a prepaid annual term.</p>
          <p>Each tier's setup fee is a fixed discount against the standard value of that build, which is set from typical build hours at our flat $75/hr rate:</p>
          <ul>
            <li><strong>Website plans:</strong> {websiteBuilds.map((p, i) => (<>{i > 0 ? ' · ' : ''}{p.name} ${fmt(p.setupFee!)} setup (${fmt(p.buildValue!)} build)</>))}.</li>
            <li><strong>Online-store tiers:</strong> {storeBuilds.map((t, i) => (<>{i > 0 ? ' · ' : ''}{t.name} ${fmt(t.setupFee!)} setup (${fmt(t.buildValue!)} build)</>))}.</li>
            <li>These standard figures apply unless your engagement was custom-scoped in writing, in which case the written quote controls.</li>
          </ul>
          <p><strong>Because the build is paid for when it is built, there is no minimum term and no early-cancellation charge on a monthly plan.</strong> Whenever you cancel, whether that is in month two or month twenty, nothing further is owed for the build or for anything else. We do not bill build costs back on exit.</p>

          <h3 id="refund-window" class="scroll-mt-24">Your first 5 business days</h3>
          <p>For 5 business days after project kickoff, you may cancel for any reason and receive a <strong>full refund of everything you have paid, the setup fee included</strong>, on both monthly and prepaid annual billing. Ask in writing within that window and we refund it. After those 5 business days, setup fees and prepaid annual fees are non-refundable, except where the law requires otherwise or we materially fail to deliver and do not cure.</p>
          <p>Kickoff is the date we start work on your build, which we confirm to you in writing. Business days exclude weekends and U.S. federal holidays.</p>

          <p>If an engagement does require a further one-time charge (a migration, a catalog import, custom development, or other work outside the scope of your plan), it is quoted in writing and agreed before that work begins. We do not add one-time charges to an invoice you have not seen first.</p>
          <p>The finished website is yours. Your domain, your content, and the site itself go with you if you leave, with nothing to settle first.</p>
          <p><strong>Remi AI and the other AI agents are service software</strong>, licensed for the duration of your plan. They run on our infrastructure and are not part of the files, code, or data that transfer when you leave. The content they produced for your site and the leads they captured remain yours; the agents themselves do not transfer.</p>
          <p>On the One-Page Website, clients are given access to the site's GitHub repository once the project is complete. Remi AI is not part of that repository and stops with the monthly plan. Most one-page projects are completed within 7 days after the contract has been signed; build timelines are good-faith estimates, not guarantees.</p>

          <h3 id="unlimited" class="scroll-mt-24">What "unlimited" means on a plan</h3>
          <p>Where a plan is described as including something "unlimited," that means we do not meter it or charge per unit, not that it has no practical limit at all. Specifically:</p>
          <ul>
            <li><strong>Storage and bandwidth:</strong> not metered and never billed as an overage, for normal business use of your website or store. This does not cover using your site as general file storage, a media-streaming service, or a distribution point for other people's content.</li>
            <li><strong>Stock photography, video, and logos:</strong> drawn from our own stock-media subscription and licensed for use in the work we produce for you, subject to that provider's license terms. Assets are not resold to you or delivered as standalone files for use elsewhere.</li>
            <li><strong>Content updates:</strong> there is no cap on how many changes you can request and no per-change fee. Requests are handled in the normal course on business days, in the order received. This covers updates to your existing pages, copy, images, and products, not a redesign, pages beyond the page count of your tier, new features or integrations, or work that belongs to a higher tier or to a separate project. If a request falls outside this, we will say so before starting and quote it separately.</li>
          </ul>
          <p>We ask only that use be reasonable. If usage becomes wildly disproportionate to what the plan costs, we will talk with you before changing anything.</p>

          <h3>Early cancellation of a prepaid annual term</h3>
          <p>The annual discount and the setup-fee waiver both exist because the year is paid up front. Outside the <a href="#refund-window">first 5 business days</a>, prepaid annual fees are non-refundable once the term begins, except where the law requires otherwise or we materially fail to deliver and do not cure. If we agree to a refund in a particular case, the months already used are re-priced at the standard month-to-month rate and the waived setup fee is restored, and both are deducted, together with payment-processing costs, from any amount returned.</p>

          <h3 id="switching-plans" class="scroll-mt-24">Switching plans</h3>
          <p>Moving between plans, including between a website plan and an online-store plan, in either direction, is a plan change, not a cancellation. On month-to-month billing, the change takes effect at the start of your next billing month and there is nothing to refund. Your new monthly rate is simply the new tier's rate.</p>
          <p>On a prepaid annual term, within the <a href="#refund-window">first 5 business days</a> after project kickoff you may instead request a cash refund of the unused balance. After that window, the unused balance is not refunded in cash. It converts, dollar for dollar, into service credit you can apply to the new plan or to any other MannyKnows service. Service credit is not redeemable for cash.</p>

          <h4 id="setup-on-switch" class="scroll-mt-24">What the setup fee does when you switch</h4>
          <p>Setup fees attach to the build, not to the plan, so you are never charged twice for work you have already paid for. One rule covers every move:</p>
          <p><strong>Amount due on a switch = the new tier's setup fee &minus; the setup fee you have already paid, and never less than $0.</strong></p>
          <ul>
            <li><strong>Moving up.</strong> You pay the difference and nothing more. Get Found ($595) to Get Booked ($895) is <strong>$300</strong>. Get Found ($595) to Sell Smarter ($1,345) is <strong>$750</strong>.</li>
            <li><strong>Moving down.</strong> The result is negative, so nothing is due and nothing is refunded. Get Growing ($1,195) to Get Found ($595) costs <strong>$0</strong>, and if you later move back up to Get Growing it is $0 again, because $1,195 is already paid.</li>
            <li><strong>Sideways at the same setup fee.</strong> Nothing is due. Get Growing and Get Ahead share a $1,195 build, so moving between them is <strong>$0</strong>.</li>
            <li><strong>On a prepaid annual term</strong>, your setup fee was waived rather than paid, so the amount already paid is $0. Move up and stay on a prepaid year and the new tier's setup fee is waived too, so nothing is due. Move to month-to-month billing on a larger build and the new tier's setup fee applies in full, because none has been paid.</li>
            <li>A switch never restarts the <a href="#refund-window">5-business-day refund window</a>, which runs once, from your original kickoff.</li>
          </ul>
          <p>Every tier's setup fee is listed under <a href="#build-fee">Setup and the initial build</a>. Where a build was custom-scoped in writing, the written quote sets the figure used in this calculation.</p>

          <h3>Late and failed payments</h3>
          <p>Invoices are due by the date stated on them. If an amount is not paid when due, we may:</p>
          <ul>
            <li>charge a late fee and interest on the overdue balance at 1.5% per month (18% per year) or the maximum rate permitted by applicable law, whichever is lower, accruing from the due date until paid;</li>
            <li>pass through fees we incur from failed payments or chargebacks;</li>
            <li>suspend or pause some or all of the Services (including hosting, websites, stores, AI agents, and advertising campaigns we operate for you) after notice, until the account is brought current. Suspension does not pause your payment obligations, and we are not liable for the consequences of a suspension caused by non-payment;</li>
            <li>recover our reasonable costs of collecting overdue amounts, including collection-agency charges and attorneys' fees, to the extent permitted by law.</li>
          </ul>
          <p>Amounts stated are exclusive of taxes; you are responsible for any sales or similar taxes that apply to your engagement. If you have a good-faith dispute about an invoice, tell us before the due date and we will work it out: undisputed portions remain due on time.</p>

          <h2>4. AI chat assistant</h2>
          <p>When our AI chat assistant is offered on the Site, its responses are automated and AI-generated. They may be inaccurate, incomplete, or out of date, and are provided for general information only, not professional, legal, financial, or other advice. Do not submit sensitive personal information through the chat, and verify anything important before relying on it. The assistant may be unavailable or withdrawn at any time.</p>

          <h2>5. Acceptable use</h2>
          <p>When using the Services, you agree not to:</p>
          <ul>
            <li>Break the law or infringe the rights of others.</li>
            <li>Submit false, misleading, or others' personal information without permission.</li>
            <li>Attempt to disrupt, overload, probe, or gain unauthorized access to the Site or its systems.</li>
            <li>Introduce malware, scrape or harvest data without permission, or circumvent security or rate-limiting measures.</li>
            <li>Use the Services to send spam or for any abusive or harmful purpose.</li>
          </ul>

          <h2>6. Intellectual property</h2>
          <p>The Site and its content (including text, graphics, logos, and design) are owned by MannyKnows or its licensors and are protected by intellectual-property laws. We grant you a limited, non-exclusive, non-transferable license to access and use the Site for its intended purpose. You may not copy, modify, distribute, or create derivative works without our permission, except as allowed by law.</p>

          <h2>7. Your submissions</h2>
          <p>When you send us content through a form, the chat assistant, or otherwise, you keep your rights in it but grant MannyKnows a worldwide, royalty-free license to use that content to operate and improve the Services and to respond to you. Do not submit anything you do not have the right to share, and do not share confidential information you do not want us to use for these purposes.</p>

          <h2>8. Third-party links and services</h2>
          <p>The Site may link to or rely on third-party websites and services we do not control, including infrastructure providers such as Cloudflare (hosting and storage), Resend (email delivery), and Twilio (SMS and phone, where an engagement uses them). We are not responsible for third parties' content, policies, or practices, and your use of their websites and services is at your own risk. See our <a href="/privacy/">Privacy Policy</a> for how these providers handle information.</p>

          <h2>9. Disclaimers</h2>
          <p>The Services are provided "as is" and "as available," without warranties of any kind, whether express or implied, including implied warranties of merchantability, fitness for a particular purpose, and non-infringement. We do not warrant that the Services will be uninterrupted, secure, error-free, or that any information provided is accurate or complete.</p>

          <h2>10. Limitation of liability</h2>
          <p>To the fullest extent permitted by law, MannyKnows will not be liable for any indirect, incidental, special, consequential, or punitive damages, or any loss of profits, data, or goodwill, arising from your use of the Services.</p>

          <h2>11. Indemnification</h2>
          <p>You agree to indemnify and hold harmless MannyKnows from any claims, damages, liabilities, and expenses arising out of your use of the Services or your violation of these Terms or applicable law.</p>

          <h2>12. Changes to the Services and Terms</h2>
          <p>We may modify or discontinue the Services at any time. We may also update these Terms; the updated version will be posted here with a revised "Effective date." Your continued use of the Site after changes take effect means you accept the updated Terms.</p>

          <h2>13. Governing law</h2>
          <p>These Terms are governed by the laws of the Commonwealth of Massachusetts, without regard to its conflict-of-laws rules, and any disputes will be resolved in the state or federal courts located in Massachusetts.</p>

          <h2>14. Contact us</h2>
          <p>Questions about these Terms? Reach us at <a href="mailto:mm@mannyknows.com">mm@mannyknows.com</a>, call <a href="tel:+14133618451">(413)&nbsp;361-8451</a>, or use the <a href="/#about">contact form</a> on our Site. MannyKnows is based in Springfield, Massachusetts.</p>
        </article>

        <div class="max-w-3xl mx-auto mt-12 pt-8 border-t border-light-tertiary dark:border-dark-accent flex items-center justify-between gap-4">
          <a href="/" class="inline-flex items-center gap-2 text-primary-blue font-medium group">
            <svg class="w-4 h-4 rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            Back home
          </a>
          <a href="/privacy/" class="inline-flex items-center gap-2 text-primary-blue font-medium group">
            Privacy Policy
            <svg class="w-4 h-4 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          </a>
        </div>
      </Container>
    </Section>

    <DockMenu />
  </main>
</BaseLayout>

<style>
  .legal-prose { color: inherit; font-size: 1.05rem; line-height: 1.8; }
  .legal-prose :global(h2) { font-size: 1.5rem; font-weight: 700; margin: 2.25rem 0 0.75rem; line-height: 1.3; }
  .legal-prose :global(h3) { font-size: 1.15rem; font-weight: 700; margin: 1.5rem 0 0.5rem; }
  .legal-prose :global(h4) { font-size: 1.02rem; font-weight: 700; margin: 1.25rem 0 0.5rem; }
  .legal-prose :global(p) { margin: 0 0 1.25rem; }
  .legal-prose :global(ul), .legal-prose :global(ol) { margin: 0 0 1.25rem; padding-left: 1.5rem; }
  .legal-prose :global(li) { margin: 0.4rem 0; }
  .legal-prose :global(ul) { list-style: disc; }
  .legal-prose :global(ol) { list-style: decimal; }
  .legal-prose :global(a) { color: #0071e3; text-decoration: underline; text-underline-offset: 2px; }
  .legal-prose :global(a:hover) { color: #ff4faa; }
  .legal-prose :global(strong) { font-weight: 700; }
</style>
