---
// Individual blog post
export const prerender = true;

import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import NavBar from '../../components/navigation/NavBar.astro';
import Section from '../../components/layout/Section.astro';
import Container from '../../components/layout/Container.astro';
import DockMenu from '../../components/navigation/DockMenu.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import Button from '../../components/ui/Button.astro';
import { getPostImage } from '../../utils/postImage';
import { getPostIllustration } from '../../utils/postIllustration';
import Illustration from '../../components/illustrations/Illustration.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts
    .filter((p) => !p.data.draft)
    .map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const heroImage = getPostImage(post);
// Self-hosted banners ship AVIF/WebP siblings next to the JPG (same base name),
// so offer them to the browser. Only for local /blog/*.jpg — generated PNG
// thumbnails and remote URLs have no siblings to point at.
const siblings = (img?: string) => {
  const base = img && /^\/blog\/[^/]+\.jpg$/.test(img) ? img.replace(/\.jpg$/, '') : null;
  return { avif: base ? `${base}.avif` : null, webp: base ? `${base}.webp` : null };
};
const { avif: heroAvif, webp: heroWebp } = siblings(heroImage);
const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

// "Keep reading" — the three most closely related posts, ranked by how many tags
// they share with this one and then by recency. Without this, only the four posts
// the footer surfaces get linked from anywhere but /blog, which leaves the older
// ones on a single internal link each.
const allPosts = (await getCollection('blog')).filter((p) => !p.data.draft && p.id !== post.id);
const tags = new Set(post.data.tags);
const related = allPosts
  .map((p) => ({ post: p, shared: p.data.tags.filter((t) => tags.has(t)).length }))
  .sort((a, b) =>
    b.shared - a.shared ||
    b.post.data.pubDate.getTime() - a.post.data.pubDate.getTime()
  )
  .slice(0, 3)
  .map((r) => r.post);

// Tag scoring clusters around the popular tags, so a post with uncommon tags can
// end up in nobody's "Keep reading". Chronological neighbours cover that gap:
// every post is linked by the one before and after it, whatever its tags.
const byDate = [...allPosts, post].sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const here = byDate.findIndex((p) => p.id === post.id);
const newer = here > 0 ? byDate[here - 1] : undefined;
const older = here < byDate.length - 1 ? byDate[here + 1] : undefined;

// BlogPosting structured data, generated from frontmatter for EVERY post —
// added in the template (Aug 2026 schema pass) so no post ships without it
// and dates come from pubDate, never scraped off the byline.
const siteUrl = 'https://mannyknows.com';
const postUrl = `${siteUrl}/blog/${post.id}/`;
const postJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.seoDescription ?? post.data.description,
  datePublished: post.data.pubDate.toISOString().slice(0, 10),
  // Emitted only when the post has actually been revised. Sending a
  // dateModified equal to datePublished on every post tells Google nothing and
  // makes the signal worthless on the posts that were genuinely updated.
  ...(post.data.updatedDate
    ? { dateModified: post.data.updatedDate.toISOString().slice(0, 10) }
    : {}),
  author: { '@type': 'Person', name: post.data.author, url: `${siteUrl}/about/` },
  publisher: {
    '@type': 'Organization',
    '@id': `${siteUrl}/#business`,
    name: 'MannyKnows',
    url: siteUrl,
    logo: { '@type': 'ImageObject', url: `${siteUrl}/favicon.svg` },
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': postUrl },
  url: postUrl,
  ...(post.data.tags.length ? { keywords: post.data.tags.join(', ') } : {}),
  ...(heroImage ? { image: heroImage.startsWith('http') ? heroImage : `${siteUrl}${heroImage}` } : {}),
};
---

<BaseLayout
  title={post.data.seoTitle ?? `${post.data.title} | MannyKnows`}
  description={post.data.seoDescription ?? post.data.description}
  image={heroImage}
>
  <script type="application/ld+json" set:html={JSON.stringify(postJsonLd)} />
  <main class="relative bg-light-primary dark:bg-dark-primary text-text-light-primary dark:text-text-dark-primary min-h-screen transition-colors duration-300 one-canvas one-canvas-live">

    <header class="relative bg-gradient-to-t from-gray-50/50 via-gray-100/30 to-gray-50/20 dark:from-gray-900/60 dark:via-slate-800/40 dark:to-gray-900/30 transition-colors duration-300 room-hero">
      <NavBar />
      <Breadcrumb items={[{ label: 'Blog', href: '/blog/' }, { label: post.data.title }]} />
      <div class="pb-10">
        <Container>
          <div class="grid lg:grid-cols-2 gap-10 lg:gap-14 items-center">
            <div class="order-1">
              {heroImage ? (
                <div class="rounded-2xl overflow-hidden border border-light-tertiary dark:border-dark-accent aspect-[16/9]">
                  <picture>
                    {heroAvif && <source type="image/avif" srcset={heroAvif} />}
                    {heroWebp && <source type="image/webp" srcset={heroWebp} />}
                    <img src={heroImage} alt={post.data.title} width="1280" height="720" loading="eager" decoding="async" class="w-full h-full object-cover" />
                  </picture>
                </div>
              ) : (
                <div class="rounded-2xl border border-light-tertiary dark:border-dark-accent bg-gradient-to-br from-primary-blue/[0.05] via-transparent to-primary-pink/[0.05] px-6 py-8 flex items-center justify-center">
                  <Illustration kind={getPostIllustration(post)} class="w-full max-w-xs" />
                </div>
              )}
            </div>
            <div class="order-2">
              <div class="flex flex-wrap gap-2 mb-4">
                {post.data.tags.map((tag) => (
                  <span class="inline-flex items-center rounded-full bg-primary-blue/10 px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wide text-primary-blue dark:text-blue-300">{tag}</span>
                ))}
              </div>
              <h1 class="sf-bold apple-headline text-4xl md:text-5xl lg:text-6xl mb-6 leading-tight">
                <span class="apple-gradient-text" data-colorful-title>{post.data.title}</span>
              </h1>
              <p class="max-w-2xl text-base sm:text-xl text-text-light-secondary dark:text-text-dark-secondary leading-relaxed mb-8">{post.data.description}</p>
              <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-text-light-tertiary dark:text-text-dark-tertiary">
                <span class="font-medium text-text-light-secondary dark:text-text-dark-secondary">{post.data.author}</span>
                <span aria-hidden="true">·</span>
                <time datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time>
                {post.data.updatedDate && (
                  <span class="inline-flex items-center gap-1.5">
                    <span aria-hidden="true">·</span>
                    <span>Updated <time datetime={post.data.updatedDate.toISOString()}>{fmt(post.data.updatedDate)}</time></span>
                  </span>
                )}
              </div>
            </div>
          </div>
        </Container>
      </div>
    </header>

    <Section id="post" variant="default" className="room">
      <Container>
        <article class="mk-prose max-w-3xl mx-auto">
          <Content />
        </article>
        {related.length > 0 && (
          <div class="mt-12 pt-8 border-t border-light-tertiary dark:border-dark-accent">
            <h2 class="sf-bold text-xl sm:text-2xl font-bold text-text-light-primary dark:text-text-dark-primary mb-5">Keep reading</h2>
            <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 list-none p-0 m-0">
              {related.map((r) => {
                const img = getPostImage(r);
                const sib = siblings(img);
                return (
                  <li>
                    <a
                      href={`/blog/${r.id}/`}
                      class="group flex h-full flex-col overflow-hidden rounded-2xl border border-light-tertiary dark:border-dark-accent bg-white dark:bg-dark-secondary no-underline transition-all duration-300 hover:border-primary-blue/40 hover:shadow-xl hover:shadow-primary-blue/10"
                    >
                      {img && (
                        <div class="aspect-[16/9] overflow-hidden border-b border-light-tertiary dark:border-dark-accent">
                          <picture>
                            {sib.avif && <source type="image/avif" srcset={sib.avif} />}
                            {sib.webp && <source type="image/webp" srcset={sib.webp} />}
                            <img src={img} alt={`${r.data.title}: article banner`} width="640" height="360" loading="lazy" decoding="async" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.03]" />
                          </picture>
                        </div>
                      )}
                      <div class="flex flex-1 flex-col p-4">
                        <span class="text-sm font-semibold leading-snug text-text-light-primary dark:text-text-dark-primary group-hover:text-primary-blue dark:group-hover:text-blue-300 transition-colors">{r.data.title}</span>
                        <span class="mt-2 text-xs text-text-light-secondary dark:text-text-dark-secondary line-clamp-3">{r.data.description}</span>
                      </div>
                    </a>
                  </li>
                );
              })}
            </ul>
          </div>
        )}

        {(newer || older) && (
          <nav aria-label="More posts" class="mt-8 grid gap-4 sm:grid-cols-2">
            {older && (
              <a href={`/blog/${older.id}/`} class="group flex flex-col rounded-2xl border border-light-tertiary dark:border-dark-accent bg-white dark:bg-dark-secondary p-4 no-underline transition-colors hover:border-primary-blue/40">
                <span class="text-xs font-bold uppercase tracking-wider text-text-light-tertiary dark:text-text-dark-tertiary">Previous post</span>
                <span class="mt-1 text-sm font-semibold text-text-light-primary dark:text-text-dark-primary group-hover:text-primary-blue dark:group-hover:text-blue-300 transition-colors">{older.data.title}</span>
              </a>
            )}
            {newer && (
              <a href={`/blog/${newer.id}/`} class="group flex flex-col rounded-2xl border border-light-tertiary dark:border-dark-accent bg-white dark:bg-dark-secondary p-4 no-underline transition-colors hover:border-primary-blue/40 sm:text-right sm:items-end">
                <span class="text-xs font-bold uppercase tracking-wider text-text-light-tertiary dark:text-text-dark-tertiary">Next post</span>
                <span class="mt-1 text-sm font-semibold text-text-light-primary dark:text-text-dark-primary group-hover:text-primary-blue dark:group-hover:text-blue-300 transition-colors">{newer.data.title}</span>
              </a>
            )}
          </nav>
        )}

        <div class="mt-10 pt-6 border-t border-light-tertiary dark:border-dark-accent">
          <Button href="/blog/" variant="ghost" class="gap-2">
            <svg class="w-4 h-4 rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            All posts
          </Button>
        </div>
      </Container>
    </Section>

    <DockMenu />
  </main>
</BaseLayout>
