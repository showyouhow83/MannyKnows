---
// Local SEO — THE page for getting found on Google, merged with the former
// /free-360-photo/ page (Aug 2026 per Manny): one funnel instead of two
// overlapping pages. /free-360-photo/ now 301s to #free-360-photo here, so
// every old button, share, and print link still lands.
//
// The offer structure (blessed by Manny, Aug 9 2026; menu deepened Aug 12):
//   • Free 360° photo — the lead magnet, unchanged.
//   • Three monthly SEO programs: "On the Map" $245/mo, "Own the Map" $495/mo,
//     "Own the Market" $995/mo (the full-department tier: roadmap, technical
//     program, pillar content, honest authority work, LLM visibility).
//   • Four one-time services in the on-demand strip: audit $375 (credited
//     toward month one within 30 days), migration from $750, virtual tour
//     from $495, GBP rescue from $245. Photo pack / profile setup remain
//     quotable through the quote modal only — the footnote was cut Aug 12
//     (Manny: too many prices on one screen).
//   • The AI-powered website plans as the other path — a NO-PRICE invite
//     banner to /plans/ (Manny, Aug 12: one product with prices per page;
//     the plan cards' "$95/$245/$545" and the "$145 field layer" note were
//     removed). The $145/mo plan-client add-on lives in the FAQ only.
//   • Never sold, stated on the page: bought links, guest-post volume,
//     ranking guarantees.
//
// HONESTY RULE: every figure traces to a printed source (GbpStats /
// GbpComparison carry theirs). No invented timelines or ranking guarantees.
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import NavBar from '../components/navigation/NavBar.astro';
import Section from '../components/layout/Section.astro';
import Container from '../components/layout/Container.astro';
import DockMenu from '../components/navigation/DockMenu.astro';
import StepCards from '../components/ui/StepCards.astro';
import GbpStats from '../components/sections/GbpStats.astro';
import GbpComparison from '../components/sections/GbpComparison.astro';
import { BOOKING_URL } from '../data/booking';
import PricingCards from '../components/pricing/PricingCards.astro';
import type { PricingCard } from '../components/pricing/PricingCards.astro';

const siteUrl = 'https://mannyknows.com';
const PHONE_TEL = '+14133618451';
const EMAIL = 'mm@mannyknows.com';
const SERVICE_AREA = 'Springfield, MA & the Pioneer Valley';
const FREE_TRAVEL = 'within ~10 miles of Springfield'; // free-shoot radius; beyond it a small gas/travel fee may apply

// The two monthly SEO packages. `service` values exist in serviceTypes.ts so
// the quote modal can name what the visitor clicked.
// The package cards render through the shared PricingCards component, the same
// one /plans and /ecommerce use, so all four pricing surfaces read alike.
// billing="none": these are month-to-month only — no yearly rate has ever been
// published on this page, and inventing one here would be an offer change.
const PACKAGES = [
  {
    name: 'On the Map',
    audience: 'For getting on the map',
    scope: 'Your Google profile, run monthly',
    scopeLines: ['Monthly 360° + standard photos', 'Reviews collected and answered'],
    price: 245,
    note: 'month-to-month · cancel anytime',
    service: 'seo-on-the-map',
    description: 'Everything a local profile needs to rank and stay ranked, done for you every month. It starts with a real shoot at your business.',
    features: [
      'Fresh photos published every month — a mix of 360° and standard shots, so your profile never goes stale',
      'Reviews collected and answered every month: a review link & QR for your counter, asks on a schedule, every review replied to',
      'Monthly Google posts, plus on-page SEO fixes on your existing website',
      'Citations built and cleaned — your name, address & phone consistent across the directories Google checks',
      'A monthly report on what moved and what changes next',
      'Month one sets you up: your Google Business Profile claimed, verified, and configured right — category, services, hours, info',
      'Plus the launch shoot: five 360° photos published as a mini "see inside" tour on your listing',
    ],
  },
  {
    name: 'Own the Map',
    audience: 'For owning your neighborhood',
    scope: 'Profile, content and AI search',
    scopeLines: ['Monthly content in your voice', 'Full virtual tour, month one'],
    price: 495,
    note: 'month-to-month · cancel anytime',
    service: 'seo-own-the-map',
    featured: true,
    builtOn: 'Everything in On the Map, plus',
    description: 'The full presence — a virtual tour customers can walk through, content that compounds, and a site structured for AI answers.',
    features: [
      'Monthly content written in your voice, for the searches your customers actually make',
      "AI search optimization, kept current so ChatGPT and Google's AI can read, quote, and recommend you",
      'Keyword & competitor research, refreshed quarterly — what customers search, what rivals rank for, and what we do about it',
      'Map-pack rank tracking across the neighborhoods you serve, reported monthly',
      'Campaign landing pages on demand, whenever a promotion calls for one',
      'Month one builds your full virtual tour from 360° images and video, embedded on your site and your profile',
    ],
  },
  {
    name: 'Own the Market',
    audience: 'For competing beyond the block',
    scope: 'A full SEO department',
    scopeLines: ['Quarterly roadmap + strategy call', 'LLM visibility tracked monthly'],
    price: 995,
    note: 'month-to-month · cancel anytime',
    service: 'seo-own-the-market',
    builtOn: 'Everything in Own the Map, plus',
    description: 'A full SEO department for businesses competing beyond the neighborhood, or with a catalog to rank.',
    features: [
      'An SEO roadmap — a sequenced quarterly plan tied to traffic and revenue targets, reviewed together on a monthly strategy call',
      'The full technical program — Core Web Vitals, schema at scale, crawl & index control, and migrations covered when you redesign',
      'Pillar & cluster content that owns a topic per quarter — a hub page plus supporting articles, interlinked and reviewed before anything ships',
      'Authority building without shortcuts — local links, unlinked mentions reclaimed, toxic links audited and disavowed',
      'LLM visibility tracking — how often ChatGPT, Perplexity, and Google AI actually recommend you, measured monthly',
      'eCommerce SEO where there is a catalog — collection pages, product schema, and content that ranks',
      'A live dashboard of rankings, traffic, calls, and conversions, plus your 360° tour kept current as the business changes',
    ],
  },
];

const packageCards: PricingCard[] = PACKAGES.map((p) => ({
  name: p.name,
  audience: p.audience,
  price: p.price,
  priceUnit: '/mo',
  priceNote: 'Month-to-month, cancel anytime',
  scope: p.scope,
  scopeLines: p.scopeLines,
  tagline: p.description,
  builtOn: p.builtOn,
  features: p.features,
  featured: p.featured,
  primary: { label: `Start with ${p.name}`, href: '#quote', quoteContext: p.service },
}));

// One-time services — quoted flat from the same public $75/hr the apps pillar
// uses. The audit price is exact; the rest are floors ("from"), quoted up front.
const ONDEMAND = [
  { name: 'Deep SEO & AI-Readiness Audit', min: 375, exact: true, service: 'seo-audit', body: 'Technical, content, local, and AI search in one prioritized fix list. Start any package within 30 days and the full price is credited toward month one.' },
  { name: 'Site Migration SEO', min: 750, service: 'seo-migration', body: 'Keep your rankings through a redesign, replatform, or domain change, with every old URL mapped to its new home.' },
  { name: 'Virtual Tour Shoot', min: 495, service: 'virtual-tour', body: 'A full 360° walkthrough of your business, shot on site and published to your website and your Google listing.' },
  { name: 'Google Profile Rescue', min: 245, service: 'gbp-rescue', body: 'Suspended, duplicate, or hijacked listings recovered, verified, and set back up right.' },
];

// What "local SEO" covers here — each item maps to a deliverable in the
// packages or plans above.
const INCLUDED = [
  { title: 'Google Business Profile, run right', body: 'Claimed, verified, and maintained, with the right primary category, complete info, photos, hours, and posts that keep the profile visibly alive.', icon: 'M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z M15 11a3 3 0 11-6 0 3 3 0 016 0z' },
  { title: 'On-page & technical SEO', body: 'Fast pages, clean structure, and all the HTML behind it. That\'s the foundation Google reads before it ranks anyone.', icon: 'M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4' },
  { title: 'AI search optimization', body: "Customers now ask ChatGPT and Google's AI. Your site gets structured so answer engines can read, quote, and recommend you.", icon: 'M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0013.5 19.5h-3a3.374 3.374 0 00-2.494-1.01l-.548-.547z' },
  { title: '360° photos & tours, refreshed monthly', body: 'A real shoot at your business, then new 360° and standard photos every month, published to your profile so it always looks active.', icon: 'M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z M15 13a3 3 0 11-6 0 3 3 0 016 0z' },
  { title: 'Reviews, asked and answered', body: 'A review link and QR for your counter, asks on a schedule, and every review answered. It\'s the signal customers check before they call.', icon: 'M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.196-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.783-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z' },
  { title: 'Content that stays fresh', body: 'Pages and posts written in your voice and kept current — continuously on the bigger package and the self-optimizing plans.', icon: 'M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z' },
];

// The free shoot, ported from the old /free-360-photo/ page.
const SHOOT_STEPS = [
  { n: '01', title: 'Call or book a time', body: 'Tap to call or send the short form below. We pick a time that fits your schedule, and it only takes a minute.', icon: 'M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z' },
  { n: '02', title: 'We come to you', body: 'We show up at your business and capture a crisp, professional 360° photo. Most shoots take under 30 minutes.', icon: 'M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z M15 11a3 3 0 11-6 0 3 3 0 016 0z' },
  { n: '03', title: 'It goes live on Google', body: 'We publish your 360° photo to your Google Business Profile so customers can step inside before they visit, free.', icon: 'M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9' },
];

const FAQS = [
  { q: 'Is the 360° photo really free?', a: "Yes. We come to your business, shoot one professional 360° photo, and publish it to your Google Business Profile at no cost, with no obligation. It's how we introduce our work." },
  { q: 'What does "fresh photos every month" mean?', a: 'On the SEO packages we keep shooting. New photos go up every month, some 360° and some standard, published to your profile. An active profile with recent photos reads as an open, working business, to Google and to customers.' },
  { q: 'How does the review collection work?', a: "You get a review link and a QR code for the counter, asks go out on a schedule, and every review gets answered. 42% of consumers say they're unlikely to use a business that never replies to reviews." },
  { q: 'Is SEO included in the website plans?', a: 'Yes. Every AI-powered website we build ships with SEO included, from day one. The packages here bring the same human + AI pipeline to sites we didn\'t build, and plan clients can still add the field layer — the monthly shoot, the review work, the profile management — at a reduced price, since their plan already covers the digital half.' },
  { q: 'I already have a website. Can you do SEO on it?', a: "That's exactly what these packages are for. They work on any site. The free AI Website Analysis is a good first step either way; it shows what's holding your site back before you spend anything." },
  { q: 'Can I add a package to my website plan?', a: "Yes, and it costs less. Every website plan already covers the on-page work and reporting, so plan clients add On the Map for $145/mo instead of $245 and pay only for the field layer — the monthly shoot, the review work, and hands-on profile management. Own the Map's digital half already lives inside Get Growing, so plan clients who want the tour book it as a one-time shoot." },
  { q: 'Do you build backlinks?', a: "Earned ones, on Own the Market. We earn local links from chambers, sponsorships, and directories, reclaim mentions of your business that never linked, and audit toxic links dragging you down. We never buy links, trade guest posts at volume, or promise a ranking — that's the stuff penalties are made of." },
  { q: 'What does the audit cost, and do I need one first?', a: "The deep audit is $375, and if you start any package within 30 days the full price is credited toward your first month. You don't need it first — the free AI Website Analysis is the quick version, and month one of every package runs its own baseline. The audit is for owners who want the complete picture before spending anything else." },
  { q: 'What is the map pack and why does it matter?', a: "The map pack is the three results Google shows above everything else for local searches, and it's where the calls come from. Your Google Business Profile, not your website, is what ranks you there, which is why profile work, photos, and reviews carry the packages." },
  { q: 'How long until results?', a: "The straight answer is that it depends on your market. Lightly contested local terms can move fast; competitive ones take months of consistent work. Everything here is month-to-month, so you're never locked in while it compounds." },
  { q: 'Do you serve my area?', a: `We're based in Springfield, MA, and shoot on-site across the Pioneer Valley: Chicopee, Holyoke, Westfield, Northampton, and the towns around them. Free shoots cover locations ${FREE_TRAVEL}; a little farther out we may add a small gas/travel fee, always quoted up front. The SEO work itself can be done from anywhere.` },
];

const META_DESCRIPTION = 'Local SEO services for Springfield, Chicopee, Holyoke & Northampton MA. Google Business Profile, 360° photos, reviews & AI search optimization. From $245/mo.';

// Structured data for SEO + AI answer engines (Service + FAQ)
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      '@id': `${siteUrl}/local-seo#service`,
      name: 'SEO Services',
      serviceType: 'Local SEO, technical SEO, content & AI search optimization, Google Business Profile, 360° photography',
      description: META_DESCRIPTION,
      areaServed: [
        { '@type': 'City', name: 'Springfield, Massachusetts' },
        { '@type': 'City', name: 'Chicopee, Massachusetts' },
        { '@type': 'City', name: 'Holyoke, Massachusetts' },
        { '@type': 'City', name: 'Northampton, Massachusetts' },
        { '@type': 'City', name: 'Westfield, Massachusetts' },
        { '@type': 'AdministrativeArea', name: 'Western Massachusetts' },
        { '@type': 'AdministrativeArea', name: 'Pioneer Valley' },
      ],
      provider: {
        '@type': 'LocalBusiness',
        name: 'MannyKnows',
        email: EMAIL,
        telephone: PHONE_TEL,
        url: siteUrl,
        address: {
          '@type': 'PostalAddress',
          addressLocality: 'Springfield',
          addressRegion: 'MA',
          addressCountry: 'US',
        },
        image: `${siteUrl}/favicon.svg`,
        priceRange: '$$',
        areaServed: SERVICE_AREA,
      },
      offers: [
        {
          '@type': 'Offer',
          name: 'Free 360° Photo',
          description: 'One professional 360° photo of your business, published to your Google Business Profile at no cost.',
          price: '0',
          priceCurrency: 'USD',
          availability: 'https://schema.org/InStock',
          url: `${siteUrl}/local-seo/#free-360-photo`,
        },
        ...PACKAGES.map((p) => ({
          '@type': 'Offer',
          name: `${p.name} (SEO package)`,
          description: p.description,
          priceCurrency: 'USD',
          priceSpecification: { '@type': 'UnitPriceSpecification', price: String(p.price), priceCurrency: 'USD', unitText: 'MONTH' },
          url: `${siteUrl}/local-seo/#packages`,
        })),
        ...ONDEMAND.map((s) => ({
          '@type': 'Offer',
          name: `${s.name} (one-time)`,
          description: s.body,
          priceCurrency: 'USD',
          priceSpecification: s.exact
            ? { '@type': 'UnitPriceSpecification', price: String(s.min), priceCurrency: 'USD' }
            : { '@type': 'PriceSpecification', minPrice: String(s.min), priceCurrency: 'USD' },
          url: `${siteUrl}/local-seo/#packages`,
        })),
      ],
    },
    {
      '@type': 'FAQPage',
      '@id': `${siteUrl}/local-seo#faq`,
      mainEntity: FAQS.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};
---

<BaseLayout title="Springfield SEO Company: Local SEO, 360° & AI | MannyKnows" description={META_DESCRIPTION}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  {/* one-canvas: one tone for the whole page instead of a different colour
      per section (Manny, Aug 2026). Hue is grouped by pillar — see the
      ONE-TONE CANVAS block in global.css. The per-section .room /
      .chain-* / .glow-* classes below are left in place on purpose:
      delete the two classes on the next line and the page reverts. */}
  <main class="relative bg-light-primary dark:bg-dark-primary text-text-light-primary dark:text-text-dark-primary min-h-screen transition-colors duration-300 one-canvas one-canvas-live">

    <!-- ───────────────────────── Hero ───────────────────────── -->
    <header class="relative bg-gradient-to-t from-gray-50/50 via-gray-100/30 to-gray-50/20 dark:from-gray-900/60 dark:via-slate-800/40 dark:to-gray-900/30 transition-colors duration-300 room-hero">
      <NavBar />
      <nav aria-label="breadcrumb" class="max-w-[1440px] mx-auto px-4 lg:px-6 pt-6 pb-4">
        <ol class="flex flex-wrap items-center gap-2 text-sm text-text-light-secondary dark:text-text-dark-secondary">
          <li><a href="/" class="hover:text-primary-blue transition-colors">Home</a></li>
          <li class="flex items-center"><span class="mx-2 text-text-light-tertiary dark:text-text-dark-tertiary">/</span><span class="text-text-light-primary dark:text-text-dark-primary font-medium">Local SEO</span></li>
        </ol>
      </nav>

      <div class="pb-14">
        <Container>
          <div class="max-w-[1440px] mx-auto text-center">
            <div class="flex justify-center mb-6">
              <img
                src="/mascot/astro-360.webp"
                alt="Astronaut mascot holding a 360-degree camera"
                aria-hidden="true"
                width="300"
                height="442"
                decoding="async"
                class="astro-float w-auto h-[220px] pointer-events-none"
              />
            </div>
            <span class="inline-block bg-gradient-to-r from-primary-blue/10 via-purple-500/10 to-primary-pink/10 text-primary-blue px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider mb-5">
              Springfield, MA &amp; Western Massachusetts
            </span>
            <h1 class="sf-bold apple-headline text-4xl md:text-5xl lg:text-6xl mb-6 leading-tight">
              <span class="apple-gradient-text" data-colorful-title>Local SEO that gets you found<br />on Google, and quoted by AI</span>
            </h1>
            <p class="max-w-3xl mx-auto text-base sm:text-xl text-text-light-secondary dark:text-text-dark-secondary leading-relaxed mb-8">
              Every AI-powered website we build ships with SEO included. These packages bring the same human + AI pipeline to any site, along with what no other Springfield SEO company does — 360° photos, virtual tours, and reviews, refreshed every month. From ${PACKAGES[0].price}/mo, or start with a free 360° photo.
            </p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
              <a href="#quote" data-quote-context="seo-on-the-map" class="inline-flex items-center justify-center gap-2 px-7 h-12 rounded-full bg-gradient-to-r from-primary-blue via-purple-500 to-primary-pink text-white font-semibold hover:shadow-lg hover:shadow-primary-blue/25 transition-shadow">
                Start ranking today
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
              </a>
              <a href="#free-360-photo" class="inline-flex items-center justify-center gap-2 px-6 h-12 rounded-full border border-light-tertiary dark:border-dark-accent text-text-light-primary dark:text-text-dark-primary font-medium hover:border-primary-blue/40 transition-colors">
                Claim the free 360° photo
              </a>
            </div>
            <p class="mt-5 text-sm text-text-light-tertiary dark:text-text-dark-tertiary">
              Month-to-month · cancel anytime · every figure on this page is sourced
            </p>
          </div>
        </Container>
      </div>
    </header>

    <!-- ───────────────────────── Free 360° photo (the lead magnet) ─────────────────────────
         Anchor target for the old /free-360-photo/ URL (301s land here). -->
    <Section id="free-360-photo" variant="alternate" className="room chain-violet-blue">
      <Container>
        <div class="text-center max-w-2xl mx-auto mb-14">
          <span class="inline-block bg-gradient-to-r from-primary-blue/10 via-purple-500/10 to-primary-pink/10 text-primary-blue px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider mb-4">We come to you · {SERVICE_AREA}</span>
          <h2 class="sf-bold text-2xl md:text-3xl font-bold mb-4"><span class="apple-gradient-text" data-colorful-title>Start with a free 360° photo</span></h2>
          <p class="text-text-light-secondary dark:text-text-dark-secondary leading-relaxed">We come to your business, shoot one immersive 360° photo, then publish it to your Google listing so customers can step inside before they visit. No cost, no obligation. It's how we introduce our work.</p>
        </div>
        <StepCards steps={SHOOT_STEPS} cols={3} class="max-w-6xl mx-auto" />
        <div class="flex flex-col sm:flex-row gap-4 justify-center items-center mt-10">
          <a href="#quote" data-quote-context="360-photo" class="inline-flex items-center justify-center gap-2 px-7 h-12 rounded-full bg-gradient-to-r from-primary-blue via-purple-500 to-primary-pink text-white font-semibold hover:shadow-lg hover:shadow-primary-blue/25 transition-shadow">
            Claim 360° photo
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
          </a>
          {BOOKING_URL && (
            <a href={BOOKING_URL} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 px-6 h-12 rounded-full border border-light-tertiary dark:border-dark-accent text-text-light-primary dark:text-text-dark-primary font-medium hover:border-primary-blue/40 transition-colors">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
              Book a time
            </a>
          )}
        </div>
        <p class="text-center mt-4 text-sm text-text-light-tertiary dark:text-text-dark-tertiary">No cost · No obligation · Live on Google in days</p>
      </Container>
    </Section>

    <!-- ───────────────────────── What's included ───────────────────────── -->
    <Section id="included" variant="default" className="room chain-blue-violet">
      <Container>
        <div class="text-center max-w-2xl mx-auto mb-14">
          <h2 class="sf-bold text-2xl md:text-3xl font-bold mb-4"><span class="apple-gradient-text" data-colorful-title>What local SEO covers here</span></h2>
          <p class="text-text-light-secondary dark:text-text-dark-secondary leading-relaxed">Not a report and a retainer — the work itself, done for you across your profile, your site, your photos, and your reviews.</p>
        </div>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 max-w-6xl mx-auto">
          {INCLUDED.map((item) => (
            <div class="rounded-2xl border border-light-tertiary dark:border-dark-accent bg-white dark:bg-dark-secondary p-6">
              <span class="inline-flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-br from-primary-blue/10 to-primary-pink/10 text-primary-blue dark:text-blue-300 mb-4">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d={item.icon} /></svg>
              </span>
              <h3 class="text-base font-bold text-text-light-primary dark:text-text-dark-primary mb-2">{item.title}</h3>
              <p class="text-sm text-text-light-secondary dark:text-text-dark-secondary leading-relaxed">{item.body}</p>
            </div>
          ))}
        </div>
        <p class="text-center text-sm text-text-light-secondary dark:text-text-dark-secondary mt-8">
          Want the reviews playbook itself? <a href="/blog/get-more-google-reviews/" class="text-primary-blue dark:text-blue-300 font-medium hover:underline">How to get more Google reviews (and what to do when one goes bad) →</a>
        </p>
      </Container>
    </Section>

    <!-- ───────────────────────── The SEO packages ───────────────────────── -->
    <Section id="packages" variant="alternate" className="room chain-violet-violet">
      <Container>
        <div class="text-center max-w-2xl mx-auto mb-14">
          <span class="inline-block bg-gradient-to-r from-primary-blue/10 via-purple-500/10 to-primary-pink/10 text-primary-blue px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider mb-4">SEO packages</span>
          <h2 class="sf-bold text-2xl md:text-3xl font-bold mb-4"><span class="apple-gradient-text" data-colorful-title>Get on the map. Own it. Then own the market.</span></h2>
          <p class="text-text-light-secondary dark:text-text-dark-secondary leading-relaxed">For any website, including ones we didn't build, this is a human + AI pipeline with real photography behind it. Prices are starting points, tailored to your business.</p>
        </div>
        <PricingCards id="seoPackages" cards={packageCards} billing="none" featuredLabel="Best value" />
        <p class="text-center text-sm text-text-light-secondary dark:text-text-dark-secondary mt-8 max-w-2xl mx-auto">
          No bought links, no guest-post schemes, no ranking guarantees. The method is the work above, done every month.
        </p>

        <!-- ── One-time, on demand ── -->
        <div class="max-w-6xl mx-auto mt-16">
          <div class="text-center max-w-2xl mx-auto mb-8">
            <h3 class="sf-bold text-xl md:text-2xl font-bold mb-2"><span class="apple-gradient-text" data-colorful-title>One-time, on demand</span></h3>
            <p class="text-sm text-text-light-secondary dark:text-text-dark-secondary">No subscription needed. Flat quotes at $75/hr, priced up front.</p>
          </div>
          <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
            {ONDEMAND.map((s) => (
              <div class="flex flex-col rounded-2xl border border-light-tertiary dark:border-dark-accent bg-white dark:bg-dark-secondary p-6">
                <h4 class="text-base font-bold text-text-light-primary dark:text-text-dark-primary mb-1">{s.name}</h4>
                <p class="text-sm font-semibold text-primary-blue dark:text-blue-300 mb-3">{s.exact ? `$${s.min}` : `from $${s.min}`}<span class="font-normal text-text-light-tertiary dark:text-text-dark-tertiary"> · one-time</span></p>
                <p class="text-sm text-text-light-secondary dark:text-text-dark-secondary leading-relaxed flex-1">{s.body}</p>
                <a href="#quote" data-quote-context={s.service} class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-primary-blue dark:text-blue-300">
                  Get a quote
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
                </a>
              </div>
            ))}
          </div>
        </div>
      </Container>
    </Section>

    <!-- ───────────────────────── The other path: sites with SEO included ───────────────────────── -->
    <Section id="plans" variant="default" className="room chain-violet-blue">
      <Container>
        <div class="text-center max-w-3xl mx-auto">
          <h2 class="sf-bold text-2xl md:text-3xl font-bold mb-4"><span class="apple-gradient-text" data-colorful-title>Every AI-powered website includes SEO</span></h2>
          <p class="text-text-light-secondary dark:text-text-dark-secondary leading-relaxed mb-8">Rather have the site do the work? Every website we build ships with SEO included from day one, so the build, the content, and the ranking work are never out of sync. The bigger plans go further — the site writes its own content and tunes its own SEO continuously.</p>
          <p class="text-sm font-semibold uppercase tracking-wide text-primary-blue dark:text-blue-300 mb-6">Get Found · Get Booked · Get Growing</p>
          <a href="/plans/" class="inline-flex items-center justify-center gap-2 px-7 h-12 rounded-full bg-gradient-to-r from-primary-blue via-purple-500 to-primary-pink text-white font-semibold hover:shadow-lg hover:shadow-primary-blue/25 transition-shadow">
            Explore the AI-powered websites
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
          </a>
        </div>
      </Container>
    </Section>

    <!-- ───────────────────────── GBP: stats + comparison ───────────────────────── -->
    <Section id="gbp" variant="alternate" className="room chain-blue-violet">
      <Container>
        <div class="text-center max-w-2xl mx-auto">
          <h2 class="sf-bold text-2xl md:text-3xl font-bold mb-3"><span class="apple-gradient-text" data-colorful-title>It starts with your Google Business Profile</span></h2>
          <p class="text-sm sm:text-base text-text-light-secondary dark:text-text-dark-secondary leading-relaxed">The free listing behind Google Maps and the map pack is what ranks you locally. Most owners set it up once and never touch it again, so getting it right is the cheapest win in local SEO.</p>
        </div>
        <div class="mt-10">
          <GbpStats />
        </div>
        <div class="mt-16">
          <GbpComparison />
        </div>
      </Container>
    </Section>

    <!-- ───────────────────────── FAQ ───────────────────────── -->
    <Section id="faq" variant="gradient" className="room glow-violet">
      <Container>
        <div class="max-w-3xl mx-auto">
          <div class="text-center mb-12">
            <h2 class="sf-bold text-2xl md:text-3xl font-bold mb-4"><span class="apple-gradient-text" data-colorful-title>Questions, answered</span></h2>
          </div>
          <div class="space-y-3">
            {FAQS.map((f) => (
              <details class="group bg-white dark:bg-dark-secondary border border-light-tertiary dark:border-dark-accent rounded-xl px-5 py-4">
                <summary class="flex items-center justify-between cursor-pointer list-none font-semibold text-text-light-primary dark:text-text-dark-primary">
                  {f.q}
                  <svg class="w-5 h-5 text-text-light-tertiary dark:text-text-dark-tertiary transition-transform group-open:rotate-180 flex-shrink-0 ml-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                </summary>
                <p class="mt-3 text-sm text-text-light-secondary dark:text-text-dark-secondary leading-relaxed">{f.a}</p>
              </details>
            ))}
          </div>
        </div>
      </Container>
    </Section>

    <DockMenu />
  </main>
</BaseLayout>
