---
// Business Apps — the fourth pillar page (hero promise: "AI Agents, Websites,
// SEO & Apps"). Built Aug 2026 per Manny by merging the two parked product
// drafts (automation-integration + practical-ai-adoption) into ONE page.
//
// Positioning (Manny's words): NOT regular app development — apps for
// businesses: Apps Script, APIs, MCP servers, scripts. "Disconnected and
// connected apps" is the organizing idea. Three tiers, all with prices that
// already existed in site copy: Scripts & Tools from $300, Connected Apps
// from $600, Business Apps from $2,500 (or co-owned, nothing upfront).
// Flat $75/hr, quoted up front — same one-time model as the profession pages.
//
// HONESTY RULE: proof is the real portfolio (VL Home Services, SL Painting);
// no invented metrics.
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import NavBar from '../components/navigation/NavBar.astro';
import Section from '../components/layout/Section.astro';
import Container from '../components/layout/Container.astro';
import DockMenu from '../components/navigation/DockMenu.astro';
import StepCards from '../components/ui/StepCards.astro';
import Faq from '../components/ui/Faq.astro';
import Breadcrumb from '../components/ui/Breadcrumb.astro';
import Button from '../components/ui/Button.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import PricingCards from '../components/pricing/PricingCards.astro';
import type { PricingCard } from '../components/pricing/PricingCards.astro';

const siteUrl = 'https://mannyknows.com';
const PHONE_TEL = '+14133618451';
const EMAIL = 'mm@mannyknows.com';

// The three tiers. `service` values exist in serviceTypes.ts so the quote
// modal can name what the visitor clicked.
// Rendered through the shared PricingCards component so /apps matches /plans,
// /ecommerce, and /local-seo. billing="none": these are one-time builds, so a
// Monthly/Yearly toggle would be meaningless here.
const TIERS = [
  {
    name: 'Scripts & Tools',
    audience: 'For killing weekly busywork',
    scope: 'Standalone tools',
    scopeLines: ['Google Apps Script automations', 'Scheduled reports and reminders'],
    kind: 'Disconnected',
    price: 300,
    service: 'app-scripts',
    description: 'Standalone helpers that do one job well. The spreadsheet that becomes a tool, the script that runs on schedule, the utility that kills an hour of weekly busywork.',
    features: [
      'Google Apps Script, so your Sheets, Docs, and Gmail do the work themselves',
      'Scheduled scripts that run reports, reminders, and cleanups without you',
      'One-job tools built around how you already work',
    ],
  },
  {
    name: 'Connected Apps',
    audience: "For tools that don't talk",
    scope: 'Your stack, wired together',
    scopeLines: ['APIs, webhooks, Twilio, Zapier', 'MCP servers so AI can use them'],
    kind: 'Connected',
    price: 600,
    service: 'app-integration',
    featured: true,
    description: 'Your tools wired together so data stops being re-typed. Website, inbox, CRM, calendar, phone, and accounting move information on their own.',
    features: [
      'API & webhook integration — if a tool has an API, we can wire it in',
      'Twilio phone & SMS with call routing, business-hours logic, and A2P registration handled',
      'Make.com & Zapier flows, documented so they keep running without babysitting',
      'MCP servers that plug your business tools into AI, so your assistants can actually use them',
    ],
  },
  {
    name: 'Business Apps',
    audience: 'For running the whole operation',
    scope: 'A system built for you',
    scopeLines: ['Dashboards, booking, quoting', 'Yours outright, or co-owned'],
    kind: 'Custom',
    price: 2500,
    service: 'custom-app',
    description: 'Admin dashboards, booking and quoting engines, client portals — the systems your business runs on, designed, built, and published for you.',
    features: [
      'Dashboards and admin panels that put your whole operation on one screen',
      'Booking, quoting, and lead-to-job systems like the one VL Home Services runs on',
      'AI assistants grounded in your own content, with a human approving what matters',
      'Own it outright, or co-own it with nothing upfront',
    ],
  },
];

const STEPS = [
  { n: '01', title: 'Map & quote', body: 'A short call on the busywork and the tools you already use. We scope it and send a fixed quote, so the total is known before we start.', icon: 'M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7' },
  { n: '02', title: 'Build & connect', body: 'Apps Script, APIs, webhooks, Twilio, MCP servers, or a full custom build. Whatever the job calls for, wired into the tools you already run on.', icon: 'M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4' },
  { n: '03', title: 'Document & hand off', body: 'Every flow documented, every account yours. Most projects run 2–4 weeks from kickoff to live, and it keeps working without you babysitting it.', icon: 'M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4' },
];

const FAQS = [
  { q: 'Is this app development like an app-store app?', a: "No. We build apps for how a business runs, not consumer apps for a store. Scripts, integrations, dashboards, and internal systems — the software that removes busywork and keeps your operation in one place." },
  { q: 'How much does an app cost?', a: 'Scripts and tools start at $300, connected apps and integrations at $600, and full business apps at $2,500. Everything is billed at a flat $75/hr and quoted up front after a short call, so you know the total before we start.' },
  { q: 'What is an MCP server, and why would my business want one?', a: "MCP (Model Context Protocol) is the open standard that lets AI assistants plug into business tools securely. Wire your calendar, CRM, or inventory into an MCP server once, and the AI you use can actually work with them — check availability, look up a customer, update a record — instead of just talking about it." },
  { q: 'Will it work with the tools I already use?', a: "Almost always. We connect what you've got (website, inbox, CRM, calendar, phone, accounting) rather than making you switch. If something can't connect cleanly, we'll tell you up front." },
  { q: 'Will the AI parts make things up?', a: 'AI assistants we build are grounded in your own content and data, with clear review checkpoints. AI does the heavy lifting, and a human keeps control of what actually goes out the door.' },
  { q: 'Do I own what you build?', a: 'Yes, completely. The code, the flows, the accounts, and the documentation are yours; we build with you, never to lock you in. Bigger builds can also be co-owned. We fund the build, you bring the business, and you pay nothing upfront.' },
  { q: 'How long does a project take?', a: 'Most projects run 2–4 weeks from kickoff to live, depending on how many tools and flows are involved. You get a firm timeline with the quote.' },
  { q: 'Who maintains it after launch?', a: "Everything is documented for handoff, so you can run it yourself. If you'd rather have it monitored and maintained, it rolls into a monthly plan from $95/mo — optional, never required." },
];

const META_DESCRIPTION = 'Apps for how your business runs. Apps Script tools, API & Twilio integrations, MCP servers, and custom dashboards. From $300, quoted up front.';

// Structured data for SEO + AI answer engines (Service + FAQ)
const tierCards: PricingCard[] = TIERS.map((t) => ({
  name: t.name,
  audience: t.audience,
  price: t.price,
  priceUnit: 'one-time',
  priceNote: 'Starting at, quoted flat at $75/hr',
  scope: t.scope,
  scopeLines: t.scopeLines,
  tagline: t.description,
  features: t.features,
  featured: t.featured,
  badge: t.kind,
  primary: { label: 'Get a quote', href: '#quote', quoteContext: t.service },
}));

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      '@id': `${siteUrl}/apps#service`,
      name: 'Business Apps & Integrations',
      serviceType: 'Business app development, workflow automation, API integration & MCP servers',
      description: META_DESCRIPTION,
      areaServed: [
        { '@type': 'City', name: 'Springfield, Massachusetts' },
        { '@type': 'AdministrativeArea', name: 'Western Massachusetts' },
      ],
      provider: {
        '@type': 'LocalBusiness',
        name: 'MannyKnows',
        email: EMAIL,
        telephone: PHONE_TEL,
        url: siteUrl,
        address: {
          '@type': 'PostalAddress',
          addressLocality: 'Springfield',
          addressRegion: 'MA',
          addressCountry: 'US',
        },
        image: `${siteUrl}/favicon.svg`,
        priceRange: '$$',
        areaServed: 'Springfield, MA & Western Massachusetts',
      },
      offers: TIERS.map((t) => ({
        '@type': 'Offer',
        name: `${t.name} (${t.kind})`,
        description: t.description,
        price: String(t.price),
        priceCurrency: 'USD',
        availability: 'https://schema.org/InStock',
        url: `${siteUrl}/apps/#tiers`,
      })),
    },
    // FAQPage schema comes from the shared <Faq /> component below.
  ],
};
---

<BaseLayout title="Business Apps, Integrations & MCP Servers | MannyKnows" description={META_DESCRIPTION}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  {/* one-canvas: one tone for the whole page instead of a different colour
      per section (Manny, Aug 2026). Hue is grouped by pillar — see the
      ONE-TONE CANVAS block in global.css. The per-section .room /
      .chain-* / .glow-* classes below are left in place on purpose:
      delete the two classes on the next line and the page reverts. */}
  <main class="relative bg-light-primary dark:bg-dark-primary text-text-light-primary dark:text-text-dark-primary min-h-screen transition-colors duration-300 one-canvas one-canvas-live">

    <!-- ───────────────────────── Hero ───────────────────────── -->
    <header class="relative bg-gradient-to-t from-gray-50/50 via-gray-100/30 to-gray-50/20 dark:from-gray-900/60 dark:via-slate-800/40 dark:to-gray-900/30 transition-colors duration-300 room-hero">
      <NavBar />
      <Breadcrumb items={[{ label: 'Business Apps' }]} />

      <div class="pb-14">
        <Container>
          <div class="max-w-[1440px] mx-auto text-center">
            <!-- Desktop: badge + title share the row with the dashboards
                 astronaut (Manny, Aug 2026); description below. -->
            <div class="flex flex-col md:flex-row items-center justify-center gap-4 md:gap-12 text-center md:text-left">
              <div>
                <span class="inline-block bg-gradient-to-r from-primary-blue/10 via-purple-500/10 to-primary-pink/10 text-primary-blue px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider mb-5">
                  Custom Business Apps &amp; Automation · Springfield, MA
                </span>
                <h1 class="sf-bold apple-headline text-4xl md:text-5xl lg:text-6xl mb-0 leading-tight">
                  <span class="apple-gradient-text" data-colorful-title>Apps for how your<br />business runs</span>
                </h1>
              </div>
              <img
                src="/mascot/astro-dashboards.webp"
                alt="Astronaut mascot presenting floating data dashboards"
                aria-hidden="true"
                width="556"
                height="620"
                decoding="async"
                class="astro-float w-auto h-[220px] pointer-events-none"
              />
            </div>
            <p class="max-w-3xl mx-auto text-base sm:text-xl text-text-light-secondary dark:text-text-dark-secondary leading-relaxed mt-6 mb-8">
              Custom business apps and workflow automation for Springfield and Western Mass small businesses. Scripts that automate the busywork, integrations that connect the tools you already use (APIs, phone &amp; SMS, MCP servers your AI can work through), and complete systems for booking, quoting, and dashboards.
            </p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
              <Button href="#quote" data-quote-context="custom-app" arrow="right">Scope my app</Button>
              <Button href="/how-it-works/" variant="secondary">See the process</Button>
            </div>
          </div>
        </Container>
      </div>
    </header>

    <!-- ───────────────────────── Disconnected / Connected ───────────────────────── -->
    <Section id="concept" variant="alternate" className="room glow-violet">
      <Container>
        <SectionHeader
          title="Apps that stand alone. Apps that connect everything."
          subtitle="Some jobs need a tool. Some need your tools talking to each other. The fastest way to get hours back is to stop doing the work a machine can do. Data moves between your website, inbox, CRM, calendar, and accounting on its own — no more copying the same thing into five places."
        />
        <div class="grid gap-5 md:grid-cols-2 max-w-5xl mx-auto">
          <!-- Waist-up mascots sit flush on each card's bottom edge: the
               negative bottom margin cancels the card padding. -->
          <div class="rounded-3xl border border-light-tertiary dark:border-dark-accent bg-white dark:bg-dark-secondary p-6 sm:p-8 overflow-hidden flex flex-col">
            <h3 class="text-lg font-bold text-text-light-primary dark:text-text-dark-primary mb-3">Disconnected: scripts &amp; tools</h3>
            <div class="flex gap-4 flex-1">
              <p class="flex-1 text-sm text-text-light-secondary dark:text-text-dark-secondary leading-relaxed">Standalone helpers with one job. A Google Apps Script that turns a spreadsheet into a quoting tool, a scheduled report that lands in your inbox every Monday, a utility that renames, sorts, or files what you used to do by hand.</p>
              <img src="/mascot/astro-disconnected.webp" alt="Astronaut mascot with standalone tool icons" aria-hidden="true" width="420" height="412" loading="lazy" decoding="async" class="self-end flex-shrink-0 w-32 sm:w-36 h-auto -mb-6 sm:-mb-8 pointer-events-none" />
            </div>
          </div>
          <div class="rounded-3xl border border-primary-blue/40 ring-1 ring-primary-blue/20 bg-white dark:bg-dark-secondary p-6 sm:p-8 overflow-hidden flex flex-col">
            <h3 class="text-lg font-bold text-text-light-primary dark:text-text-dark-primary mb-3">Connected: integrations &amp; MCP</h3>
            <div class="flex gap-4 flex-1">
              <p class="flex-1 text-sm text-text-light-secondary dark:text-text-dark-secondary leading-relaxed">If a tool has an API, we can wire it in — webhooks, Twilio call routing and SMS with business-hours logic and A2P registration handled, and Make.com and Zapier flows. MCP servers let the AI you use plug into your calendar, CRM, and inventory and actually work with them.</p>
              <img src="/mascot/astro-connected.webp" alt="Astronaut mascot with connected app icons" aria-hidden="true" width="420" height="412" loading="lazy" decoding="async" class="self-end flex-shrink-0 w-32 sm:w-36 h-auto -mb-6 sm:-mb-8 pointer-events-none" />
            </div>
          </div>
        </div>
      </Container>
    </Section>

    <!-- ───────────────────────── Tiers ───────────────────────── -->
    <Section id="tiers" variant="default" className="room chain-blue-violet">
      <!-- App astronaut peeking in from the right edge (the render carries
           its own lean, so CSS rotation sits at 0). Dials live in the
           .tiers-mascot CSS below. -->
      <div class="tiers-mascot" aria-hidden="true">
        <img src="/mascot/astro-app-peek.webp" alt="Astronaut mascot peeking at the pricing tiers" aria-hidden="true" width="389" height="880" loading="lazy" decoding="async" />
      </div>
      <Container>
        <SectionHeader
          title="Pick the size of the job"
          subtitle="From a single Google Apps Script to a full custom dashboard or client portal, every business app is scoped and quoted up front. You know the total before we start, and you only pay for the automation your business actually needs."
        />
        <PricingCards id="appTiers" cards={tierCards} billing="none" />
        <p class="text-center text-xs text-text-light-tertiary dark:text-text-dark-tertiary mt-8 max-w-2xl mx-auto">
          Got an idea bigger than a build? Some apps we co-own. We fund the build, you bring the business, and you pay nothing upfront. And when apps become part of everything (site, media, promotion) the <a href="/plans/multimedia-agency/" class="underline decoration-dotted hover:text-primary-blue">Multimedia Agency retainer</a> puts a developer on demand.
        </p>
      </Container>
    </Section>

    <!-- ───────────────────────── How it works + case studies ───────────────────────── -->
    <Section id="how-it-works" variant="default" className="room chain-violet-violet">
      <!-- Case-study astronaut peeking from the left, level with the
           case-study cards at the section's bottom. -->
      <div class="cs-mascot" aria-hidden="true">
        <img src="/mascot/astro-casestudy.webp" alt="Astronaut mascot peeking at the case studies" aria-hidden="true" width="360" height="631" loading="lazy" decoding="async" />
      </div>
      <Container>
        <SectionHeader
          title="How it works"
          subtitle='Three steps, a fixed quote, and a documented handoff. The full build process, from friction to finished app, lives on <a href="/how-it-works/" class="underline decoration-dotted hover:text-primary-blue">how it works</a>.'
          html
        />
        <StepCards steps={STEPS} cols={3} class="max-w-6xl mx-auto" />

        <!-- Case studies (was its own "We've wired this up before" section;
             folded in below the steps, Manny, Aug 2026). -->
        <div id="case-studies" class="text-center max-w-2xl mx-auto mt-20 mb-12 scroll-mt-24">
          <h3 class="sf-bold text-2xl md:text-3xl font-bold"><span class="apple-gradient-text" data-colorful-title>Case Studies</span></h3>
        </div>
        <div class="grid gap-6 md:grid-cols-2 max-w-5xl mx-auto">
          <a href="/work/vl-home-services/" class="rounded-3xl border border-light-tertiary dark:border-dark-accent bg-white dark:bg-dark-secondary p-6 sm:p-8 hover:border-primary-blue/30 hover:shadow-lg transition-all duration-300">
            <h4 class="text-lg font-bold text-text-light-primary dark:text-text-dark-primary mb-2">VL Home Services</h4>
            <p class="text-sm text-text-light-secondary dark:text-text-dark-secondary leading-relaxed mb-4">An operation that ran on referrals and paper, turned into one connected system — a website, an admin dashboard, and a 24/7 AI Sales &amp; Booking Agent. Every inquiry captured and tracked, customers answered around the clock in any language.</p>
            <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-primary-blue dark:text-blue-300">Read the case study <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg></span>
          </a>
          <a href="/work/sl-painting/" class="rounded-3xl border border-light-tertiary dark:border-dark-accent bg-white dark:bg-dark-secondary p-6 sm:p-8 hover:border-primary-blue/30 hover:shadow-lg transition-all duration-300">
            <h4 class="text-lg font-bold text-text-light-primary dark:text-text-dark-primary mb-2">SL Painting</h4>
            <p class="text-sm text-text-light-secondary dark:text-text-dark-secondary leading-relaxed mb-4">A 24/7 AI Sales &amp; Booking Agent that answers homeowners and qualifies leads around the clock. Grounded in their business and their voice, not a generic bot. Real AI, doing a real job.</p>
            <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-primary-blue dark:text-blue-300">Read the case study <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg></span>
          </a>
        </div>
      </Container>
    </Section>

    <!-- ───────────────────────── FAQ ───────────────────────── -->
    <Section id="faq" variant="gradient" className="room glow-violet">
      <Container>
        <Faq faqs={FAQS} heading="Questions, answered" />
      </Container>
    </Section>

    <DockMenu />
  </main>
</BaseLayout>

<style>
  /* Right-edge peek for the tiers section (same family as the homepage
     .gbp-mascot). The render is pre-tilted, so rotate stays 0. */
  #tiers { position: relative; overflow: hidden; }
  .tiers-mascot {
    --mascot-height: 440px;
    --mascot-peek: 100%;
    --mascot-rotate: 0deg;

    position: absolute;
    top: 50%;
    right: 0;
    transform: translateY(-50%) translateX(calc(100% - var(--mascot-peek)));
    pointer-events: none;
    /* Behind the cards, not over them. The edge-peek pattern assumes side
       gutters (see CLAUDE.md); the tier grid now fills the container, so at
       z-index 20 the astronaut sat across the third card's CTA. Painting it
       under the grid keeps the peek and clears the button. */
    z-index: 0;
  }
  .tiers-mascot img {
    height: var(--mascot-height);
    width: auto;
    transform: rotate(var(--mascot-rotate));
  }
  @media (max-width: 1279px) {
    .tiers-mascot { --mascot-height: 320px; }
  }
  @media (max-width: 639px) {
    .tiers-mascot { display: none; }
  }

  /* Case-study astronaut: left-edge peek, anchored to the section bottom
     where the case-study cards live. */
  #how-it-works { position: relative; overflow: hidden; }
  .cs-mascot {
    --mascot-height: 360px;
    --mascot-peek: 58%;
    --mascot-rotate: 31deg;

    position: absolute;
    bottom: 32px;
    left: 0;
    transform: translateX(calc(-100% + var(--mascot-peek)));
    pointer-events: none;
    z-index: 20;
  }
  .cs-mascot img {
    height: var(--mascot-height);
    width: auto;
    transform: rotate(var(--mascot-rotate));
  }
  @media (max-width: 1279px) {
    .cs-mascot { --mascot-height: 280px; }
  }
  @media (max-width: 639px) {
    .cs-mascot { display: none; }
  }

  .astro-float { animation: astro-float 6s ease-in-out infinite; will-change: transform; }
  @keyframes astro-float {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50%      { transform: translateY(-10px) rotate(-1.5deg); }
  }
  @media (prefers-reduced-motion: reduce) { .astro-float { animation: none; } }
</style>
