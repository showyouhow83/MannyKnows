---
// AI Website (one-page) — the product's own sales page.
//
// Before this existed the product lived only as a fourth card on the
// /free-360-photo lead-magnet page: no price in the section, no CTA, no proof,
// and copy that talked the reader out of it and into the $95/mo plan. This is
// the page it gets sold on; /free-360-photo and /services now link here.
//
// Every price, feature, and answer comes from src/data/aiWebsite.ts so the
// three surfaces can't drift.
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import NavBar from '../components/navigation/NavBar.astro';
import Section from '../components/layout/Section.astro';
import Container from '../components/layout/Container.astro';
import DockMenu from '../components/navigation/DockMenu.astro';
import StepCards from '../components/ui/StepCards.astro';
import Faq from '../components/ui/Faq.astro';
import AiWebsiteAgentDemo from '../components/sections/AiWebsiteAgentDemo.astro';
import QuoteBlock from '../components/ui/QuoteBlock.astro';
import { getTestimonial } from '../data/testimonials';
import {
  aiWebsiteSetupFee,
  aiWebsiteMonthly,
  aiWebsiteYearly,
  aiWebsiteAgent,
  aiWebsiteSections,
  aiWebsiteLighthouse,
  aiWebsiteMonthlyIncludes,
  aiWebsiteSetupIncludes,
  aiWebsiteSteps,
  aiWebsiteFaq,
} from '../data/aiWebsite';

const PHONE_DISPLAY = '(413) 361-8451';
const PHONE_TEL = '+14133618451';

const heroSections = aiWebsiteSections.filter((s) => s.hero);
const restSections = aiWebsiteSections.filter((s) => !s.hero);

// Title/meta kept under 60/160 chars — search results truncate past that.
const META_DESCRIPTION = `A one-page website with Remi, an AI agent that answers customers and captures every lead — $${aiWebsiteSetupFee} to build, $${aiWebsiteMonthly}/mo to run. Springfield, MA.`;

const siteUrl = 'https://mannyknows.com';
const pageJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${siteUrl}/ai-website/#service`,
  name: 'AI Website — one-page site with an AI agent',
  serviceType: 'Web design and AI agent development',
  description: META_DESCRIPTION,
  areaServed: 'Western Massachusetts',
  provider: {
    '@type': 'ProfessionalService',
    '@id': `${siteUrl}/#business`,
    name: 'MannyKnows',
    url: siteUrl,
    telephone: '+1-413-361-8451',
    address: { '@type': 'PostalAddress', addressLocality: 'Springfield', addressRegion: 'MA', addressCountry: 'US' },
  },
  offers: [
    {
      '@type': 'Offer',
      name: 'Build & launch (one-time)',
      price: String(aiWebsiteSetupFee),
      priceCurrency: 'USD',
      description: 'Design, copy, 360° tour embed, Remi trained on your business, and launch on your own domain.',
      url: `${siteUrl}/ai-website/`,
    },
    {
      '@type': 'Offer',
      name: 'Hosted & answering (monthly)',
      price: String(aiWebsiteMonthly),
      priceCurrency: 'USD',
      description: 'Hosting, SSL, security, Remi running and retrained, and every lead delivered.',
      url: `${siteUrl}/ai-website/`,
    },
  ],
};
---

<BaseLayout title="AI Website — One-Page Site with an AI Agent | MannyKnows" description={META_DESCRIPTION}>
  <script type="application/ld+json" set:html={JSON.stringify(pageJsonLd)} />

  <main class="relative bg-light-primary dark:bg-dark-primary text-text-light-primary dark:text-text-dark-primary min-h-screen transition-colors duration-300">

    <!-- ───────────────────────── Hero ───────────────────────── -->
    <header class="relative bg-gradient-to-t from-gray-50/50 via-gray-100/30 to-gray-50/20 dark:from-gray-900/60 dark:via-slate-800/40 dark:to-gray-900/30 transition-colors duration-300">
      <NavBar />
      <nav aria-label="breadcrumb" class="max-w-[1440px] mx-auto px-4 lg:px-6 pt-6 pb-4">
        <ol class="flex flex-wrap items-center gap-2 text-sm text-text-light-secondary dark:text-text-dark-secondary">
          <li><a href="/" class="hover:text-primary-blue transition-colors">Home</a></li>
          <li class="flex items-center"><span class="mx-2 text-text-light-tertiary dark:text-text-dark-tertiary">/</span><a href="/services/" class="hover:text-primary-blue transition-colors">Services</a></li>
          <li class="flex items-center"><span class="mx-2 text-text-light-tertiary dark:text-text-dark-tertiary">/</span><span class="text-text-light-primary dark:text-text-dark-primary font-medium">AI Website</span></li>
        </ol>
      </nav>

      <div class="pb-16 px-4 sm:px-6 lg:px-8">
        <div class="max-w-[1440px] mx-auto">
          <div class="flex flex-col lg:flex-row items-center gap-12 lg:gap-16">
            <!-- Pitch -->
            <div class="flex-1 text-center lg:text-left">
              <span class="inline-block bg-gradient-to-r from-primary-blue/10 via-purple-500/10 to-primary-pink/10 text-primary-blue px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider mb-5">
                One page · One agent · Western Massachusetts
              </span>
              <h1 class="sf-bold apple-headline text-4xl md:text-5xl lg:text-6xl mb-6 leading-tight">
                <span class="apple-gradient-text" data-colorful-title>A one-page website that answers customers while you work</span>
              </h1>
              <p class="max-w-2xl mx-auto lg:mx-0 text-base sm:text-xl text-text-light-secondary dark:text-text-dark-secondary leading-relaxed mb-6">
                Most local businesses don't need twelve pages — or a Wix subscription that leaves all the work
                to them. This is one fast page, built for you by a developer, on your own domain — with Remi,
                an AI agent trained on your business, awake at midnight to answer the customer who found you
                and send you their lead.
              </p>

              <!-- Price, stated up front. The old card buried it. -->
              <div class="inline-flex flex-wrap items-baseline justify-center lg:justify-start gap-x-3 gap-y-1 rounded-2xl border border-primary-blue/30 bg-white/70 dark:bg-dark-secondary/70 px-5 py-3 mb-8">
                <span class="text-2xl font-black text-text-light-primary dark:text-text-dark-primary">${aiWebsiteSetupFee}</span>
                <span class="text-sm text-text-light-secondary dark:text-text-dark-secondary">to build</span>
                <span class="text-text-light-tertiary dark:text-text-dark-tertiary">·</span>
                <span class="text-2xl font-black text-text-light-primary dark:text-text-dark-primary">${aiWebsiteMonthly}<span class="text-base font-bold">/mo</span></span>
                <span class="text-sm text-text-light-secondary dark:text-text-dark-secondary">to run it</span>
              </div>

              <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
                <a href="#contact" data-contact-context="AI Website (one-page)" class="inline-flex items-center justify-center gap-2 px-7 h-12 rounded-full bg-gradient-to-r from-primary-blue via-purple-500 to-primary-pink text-white font-semibold hover:shadow-lg hover:shadow-primary-blue/25 transition-shadow">
                  Start my one-page site
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
                </a>
                <a href="#whats-on-it" class="inline-flex items-center justify-center gap-2 px-6 h-12 rounded-full border border-light-tertiary dark:border-dark-accent text-text-light-primary dark:text-text-dark-primary font-medium hover:border-primary-blue/40 transition-colors">
                  See what's on the page
                </a>
              </div>
              <p class="mt-5 text-sm text-text-light-tertiary dark:text-text-dark-tertiary">
                You own the site · English &amp; Spanish standard · Live in about two weeks
              </p>
            </div>

            <!-- Proof, immediately: the agent doing its job -->
            <div class="flex-1 w-full">
              <AiWebsiteAgentDemo />
            </div>
          </div>
        </div>
      </div>
    </header>

    <!-- ───────────────────────── The agent ───────────────────────── -->
    <Section id="the-agent" variant="default">
      <Container>
        <div class="text-center max-w-2xl mx-auto mb-12">
          <span class="inline-block bg-gradient-to-r from-primary-blue/10 via-purple-500/10 to-primary-pink/10 text-primary-blue px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider mb-4">The part that isn't a website</span>
          <h2 class="sf-bold text-2xl md:text-3xl font-bold mb-4"><span class="apple-gradient-text" data-colorful-title>Anyone can build you a page. This one has Remi on it.</span></h2>
          <p class="text-text-light-secondary dark:text-text-dark-secondary leading-relaxed">
            A normal small-business site is a brochure: it waits. Remi works the conversation — answers what
            visitors ask, gathers who they are and what they need, and sends you the lead ready to close.
            It's the lightest version of the same agent that books and sells on our
            <a href="/plans/" class="text-primary-blue dark:text-blue-300 hover:underline">website plans</a>.
          </p>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6 max-w-6xl mx-auto">
          {aiWebsiteAgent.map((c) => (
            <div class="rounded-2xl border border-light-tertiary dark:border-dark-accent bg-white dark:bg-dark-secondary p-6">
              <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-br from-primary-blue to-primary-pink text-white shadow-lg shadow-primary-blue/20 mb-4">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d={c.icon} /></svg>
              </div>
              <h3 class="text-base font-bold text-text-light-primary dark:text-text-dark-primary mb-2">{c.title}</h3>
              <p class="text-sm text-text-light-secondary dark:text-text-dark-secondary leading-relaxed">{c.body}</p>
            </div>
          ))}
        </div>

        <!-- Proof it isn't theoretical -->
        <div class="max-w-4xl mx-auto mt-12 grid md:grid-cols-2 gap-6">
          <a href="/work/sl-painting/" class="group rounded-2xl border border-light-tertiary dark:border-dark-accent bg-white dark:bg-dark-secondary p-6 transition-all hover:border-primary-blue/40 hover:shadow-xl hover:shadow-primary-blue/10">
            <span class="text-[11px] font-bold uppercase tracking-wider text-primary-blue dark:text-blue-300">Painting contractor · Springfield</span>
            <p class="mt-2 text-sm text-text-light-secondary dark:text-text-dark-secondary leading-relaxed">
              SL Painting's agent qualifies leads around the clock — a contractor can't answer chat from a ladder.
              The same site now ranks #1 on Google, organically, for exterior painting in Springfield.
            </p>
            <span class="mt-3 inline-flex items-center gap-1.5 text-sm font-semibold text-primary-blue dark:text-blue-300">Read the case study<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg></span>
          </a>
          <a href="/work/jk-daycare/" class="group rounded-2xl border border-light-tertiary dark:border-dark-accent bg-white dark:bg-dark-secondary p-6 transition-all hover:border-primary-blue/40 hover:shadow-xl hover:shadow-primary-blue/10">
            <span class="text-[11px] font-bold uppercase tracking-wider text-primary-blue dark:text-blue-300">Licensed childcare · Springfield</span>
            <p class="mt-2 text-sm text-text-light-secondary dark:text-text-dark-secondary leading-relaxed">
              JK Daycare went from no website and unanswered midday calls to a live site, a working AI agent,
              and a phone system that routes every call — in two weeks.
            </p>
            <span class="mt-3 inline-flex items-center gap-1.5 text-sm font-semibold text-primary-blue dark:text-blue-300">Read the case study<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg></span>
          </a>
        </div>
      </Container>
    </Section>

    <!-- ───────────────────────── What's on the page ───────────────────────── -->
    <!-- ("One page, seven jobs" + Lighthouse moved to the end of the page
         per Manny, Aug 2026 — the sales sections lead, the anatomy follows.) -->

    <!-- ───────────────────────── Pricing ───────────────────────── -->
    <Section id="pricing" variant="gradient">
      <Container>
        <div class="text-center max-w-2xl mx-auto mb-12">
          <span class="inline-block bg-gradient-to-r from-primary-blue/10 via-purple-500/10 to-primary-pink/10 text-primary-blue px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider mb-4">Pricing</span>
          <h2 class="sf-bold text-2xl md:text-3xl font-bold mb-4"><span class="apple-gradient-text" data-colorful-title>${aiWebsiteSetupFee} to build it. ${aiWebsiteMonthly}/mo to keep it working.</span></h2>
          <p class="text-text-light-secondary dark:text-text-dark-secondary leading-relaxed">
            Two numbers, and here's exactly what each one buys.
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-6 max-w-4xl mx-auto">
          <div class="rounded-2xl border border-light-tertiary dark:border-dark-accent bg-white dark:bg-dark-secondary p-7 flex flex-col">
            <span class="text-[11px] font-bold uppercase tracking-wider text-text-light-tertiary dark:text-text-dark-tertiary">One-time</span>
            <div class="flex items-baseline gap-2 mt-1 mb-4">
              <span class="text-4xl font-black text-text-light-primary dark:text-text-dark-primary">${aiWebsiteSetupFee}</span>
              <span class="text-sm text-text-light-secondary dark:text-text-dark-secondary">build &amp; launch</span>
            </div>
            <ul class="space-y-2.5 flex-1">
              {aiWebsiteSetupIncludes.map((f) => (
                <li class="flex items-start gap-2 text-sm text-text-light-primary dark:text-text-dark-primary">
                  <svg class="w-4 h-4 text-green-500 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                  <span>{f}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="rounded-2xl border border-primary-blue/40 ring-1 ring-primary-blue/15 bg-white dark:bg-dark-secondary p-7 flex flex-col">
            <span class="text-[11px] font-bold uppercase tracking-wider text-primary-blue dark:text-blue-300">Every month after</span>
            <div class="flex items-baseline gap-2 mt-1 mb-1">
              <span class="text-4xl font-black text-text-light-primary dark:text-text-dark-primary">${aiWebsiteMonthly}</span>
              <span class="text-sm text-text-light-secondary dark:text-text-dark-secondary">/mo — ${aiWebsiteYearly} a year</span>
            </div>
            <p class="text-xs text-text-light-tertiary dark:text-text-dark-tertiary mb-4">Cancel anytime. The site and domain stay yours.</p>
            <ul class="space-y-2.5 flex-1">
              {aiWebsiteMonthlyIncludes.map((f) => (
                <li class="flex items-start gap-2 text-sm text-text-light-primary dark:text-text-dark-primary">
                  <svg class="w-4 h-4 text-green-500 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                  <span>{f}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <div class="text-center mt-8">
          <a href="#contact" data-contact-context="AI Website (one-page)" class="inline-flex items-center justify-center gap-2 px-7 h-12 rounded-full bg-gradient-to-r from-primary-blue via-purple-500 to-primary-pink text-white font-semibold hover:shadow-lg hover:shadow-primary-blue/25 transition-shadow">
            Start my one-page site
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
          </a>
        </div>

        <!-- The honest comparison, rather than a section that argues against itself -->
        <div class="max-w-3xl mx-auto mt-12 rounded-2xl border border-light-tertiary dark:border-dark-accent bg-white/70 dark:bg-dark-secondary/70 p-6 text-center">
          <h3 class="text-base font-bold text-text-light-primary dark:text-text-dark-primary mb-2">When one page isn't the right answer</h3>
          <p class="text-sm text-text-light-secondary dark:text-text-dark-secondary leading-relaxed">
            If you want a multilingual site of several pages that we design, run, update four times a month, and
            keep ranking — with your Google Business Profile handled and your own admin — that's a monthly plan,
            starting at $95/mo with no setup fee. Different product, different job.
            <a href="/plans/get-found/" class="text-primary-blue dark:text-blue-300 hover:underline font-semibold">Compare Get Found</a>.
          </p>
        </div>
      </Container>
    </Section>

    <!-- ───────────────────────── How it works ───────────────────────── -->
    <Section id="how-it-works" variant="default">
      <Container>
        <div class="text-center max-w-2xl mx-auto mb-12">
          <h2 class="sf-bold text-2xl md:text-3xl font-bold mb-4"><span class="apple-gradient-text" data-colorful-title>From one conversation to a page that works</span></h2>
        </div>
        <StepCards steps={aiWebsiteSteps} cols={4} class="max-w-6xl mx-auto" />
        <div class="max-w-2xl mx-auto mt-14">
          <QuoteBlock quote={getTestimonial('SL Painting')} align="center" />
        </div>
      </Container>
    </Section>

    <!-- ───────────────────────── FAQ + CTA ───────────────────────── -->
    <Section id="faq" variant="gradient">
      <Container>
        <div class="max-w-3xl mx-auto">
          <Faq faqs={aiWebsiteFaq} heading="One-page website questions, answered" />
          <div class="text-center mt-12">
            <a href="#contact" data-contact-context="AI Website (one-page)" class="inline-flex items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-primary-blue to-primary-pink text-white px-7 py-3.5 text-sm font-semibold transition-all duration-300">
              Talk about your one-page site
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
            </a>
            <p class="mt-4 text-sm text-text-light-tertiary dark:text-text-dark-tertiary">
              Or call <a href={`tel:${PHONE_TEL}`} class="text-primary-blue hover:underline">{PHONE_DISPLAY}</a> — English or Spanish.
            </p>
          </div>
        </div>
      </Container>
    </Section>

    <!-- ───────────────── What's on the page (appended per Manny, Aug 2026) ───────────────── -->
    <Section id="whats-on-it" variant="default">
      <Container>
        <div class="text-center max-w-2xl mx-auto mb-12">
          <h2 class="sf-bold text-2xl md:text-3xl font-bold mb-4"><span class="apple-gradient-text" data-colorful-title>One page, seven jobs</span></h2>
          <p class="text-text-light-secondary dark:text-text-dark-secondary leading-relaxed">
            Everything a customer needs in one scroll — and structured so Google and the AI assistants people now
            ask can read it, rank it, and recommend you.
          </p>
        </div>

        <!-- The two that do the heaviest lifting get the weight -->
        <div class="grid md:grid-cols-2 gap-6 max-w-6xl mx-auto mb-6">
          {heroSections.map((s) => (
            <div class="rounded-2xl border border-primary-blue/30 ring-1 ring-primary-blue/10 bg-white dark:bg-dark-secondary p-7">
              <h3 class="text-lg font-bold text-text-light-primary dark:text-text-dark-primary mb-2">{s.name}</h3>
              <p class="text-sm text-text-light-secondary dark:text-text-dark-secondary leading-relaxed">{s.body}</p>
            </div>
          ))}
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-5 gap-5 max-w-6xl mx-auto">
          {restSections.map((s) => (
            <div class="rounded-xl border border-light-tertiary dark:border-dark-accent bg-white dark:bg-dark-secondary p-5">
              <h3 class="text-sm font-bold text-primary-blue dark:text-blue-300 mb-1.5">{s.name}</h3>
              <p class="text-sm text-text-light-secondary dark:text-text-dark-secondary leading-relaxed">{s.body}</p>
            </div>
          ))}
        </div>
      </Container>
    </Section>

    <!-- ───────────────────────── Lighthouse ───────────────────────── -->
    <Section id="lighthouse" variant="gradient">
      <Container>
        <div class="text-center max-w-2xl mx-auto mb-12">
          <h2 class="sf-bold text-2xl md:text-3xl font-bold mb-4"><span class="apple-gradient-text" data-colorful-title>Engineered for the four scores Google grades</span></h2>
          <p class="text-text-light-secondary dark:text-text-dark-secondary leading-relaxed">
            Lighthouse is Google's own audit of a page. We build to near-perfect across all four — and you don't
            have to take our word for it: run it on this site, or on the one you have now.
          </p>
        </div>
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 max-w-6xl mx-auto">
          {aiWebsiteLighthouse.map((l) => (
            <div class="bg-white dark:bg-dark-secondary border border-light-tertiary dark:border-dark-accent rounded-xl p-5 text-center">
              <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-green-500/10 text-green-600 dark:text-green-400 font-black mb-3">100</div>
              <h3 class="text-sm font-bold text-text-light-primary dark:text-text-dark-primary mb-1">{l.name}</h3>
              <p class="text-xs text-text-light-secondary dark:text-text-dark-secondary leading-relaxed">{l.body}</p>
            </div>
          ))}
        </div>
        <div class="text-center mt-8">
          <a href="/free-ai-website-analysis/" class="inline-flex items-center gap-1.5 text-sm font-semibold text-primary-blue dark:text-blue-300 hover:underline">
            Get a free analysis of your current site
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
          </a>
        </div>
      </Container>
    </Section>

    <DockMenu />
  </main>
</BaseLayout>
