        </div>
      </Container>
    </Section>

    <DockMenu />
  </main>
</BaseLayout>

<style>
  /* Case-study astronaut: left-edge peek on the agent section (same family
     as /apps and /ai-booking-agent). */
  #the-agent { position: relative; overflow: hidden; }
  #whats-on-it { position: relative; overflow: hidden; }

  /* Rotating verb in the H1 — one word slides out the top, the next slides
     in from below. Reduced-motion users get the static first word. */
  .rotate-word {
    display: inline-block;
    transition: transform 0.35s ease, opacity 0.35s ease;
    will-change: transform, opacity;
  }
  .rotate-word.is-out { transform: translateY(-0.55em); opacity: 0; }
  .rotate-word.is-prep { transition: none; transform: translateY(0.55em); opacity: 0; }
  .cs-mascot {
    --mascot-height: 360px;
    --mascot-peek: 58%;
    --mascot-rotate: 31deg;

    position: absolute;
    top: 50%;
    left: 0;
    transform: translateY(-50%) translateX(calc(-100% + var(--mascot-peek)));
    pointer-events: none;
    z-index: 20;
  }
  .cs-mascot img {
    height: var(--mascot-height);
    width: auto;
    transform: rotate(var(--mascot-rotate));
  }
  @media (max-width: 1279px) {
    .cs-mascot { --mascot-height: 280px; }
  }
  @media (max-width: 639px) {
    .cs-mascot { display: none; }
  }
</style>

<script>
  // H1 verb rotation: work → sleep → drive → quote the next job → …
  // One at a time, sliding up and out, next sliding in from below.
  (function () {
    const el = document.getElementById('rotateWord');
    if (!el) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const WORDS = ['work', 'sleep', 'drive', 'quote the next job', 'run the crew', 'finally take a day off'];
    let i = 0;
    setInterval(() => {
      el.classList.add('is-out');
      setTimeout(() => {
        i = (i + 1) % WORDS.length;
        el.textContent = WORDS[i];
        el.classList.remove('is-out');
        el.classList.add('is-prep');
        void el.offsetWidth; // commit the below-the-line start before sliding in
        el.classList.remove('is-prep');
      }, 360);
    }, 2600);
  })();
</script>
