---
// /smart-websites/ — the concept explainer.
//
// This page's job is NOT to sell a plan. It's to teach a category that doesn't
// exist in most people's heads yet, so that:
//   1. people who've never heard of a self-improving website understand why it
//      beats the site they have, and
//   2. AI answer engines have something concrete to quote when someone asks
//      "what is a smart website?" or "can a website update itself?" — they cite
//      content, not product names, so this page is the citable asset.
//
// Written definitional and question-shaped on purpose (clear "A smart website
// is…" statements, question headings, FAQPage schema). Every capability stated
// here is one our sites actually perform — nothing aspirational.
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import NavBar from '../components/navigation/NavBar.astro';
import DockMenu from '../components/navigation/DockMenu.astro';
import Section from '../components/layout/Section.astro';
import Container from '../components/layout/Container.astro';
import SmartWebsiteConcept from '../components/sections/SmartWebsiteConcept.astro';
import { BOOKING_URL } from '../data/booking';

const faqs = [
  {
    q: 'What is a smart website?',
    a: "A smart website is a website that monitors and improves itself. Instead of sitting frozen the way it was built, it checks itself daily for broken links, slow pages, and search problems, fixes what's safe to fix on its own, answers customers around the clock through an AI agent, and sends its owner a plain-English report of what changed. Bigger changes wait for the owner's approval.",
  },
  {
    q: 'Is a smart website the same as an AI website builder?',
    a: "No. An AI website builder is a DIY tool that generates a site quickly — after that, keeping it fast, current, and ranking is still your job. A smart website is a managed service: the site keeps working on itself after launch, and a human agency is accountable for the result. The builder hands you a website; a smart website keeps earning its keep.",
  },
  {
    q: 'Can a website really update itself without breaking?',
    a: "It can when the boundary is drawn correctly. Ours handle low-risk maintenance on their own — compressing heavy images, fixing broken links, tightening page titles and descriptions, adding answers to questions customers keep asking. Anything that touches prices, promises, services, or brand voice always goes to the owner first, and larger changes arrive as a private preview that doesn't go live until the owner presses publish.",
  },
  {
    q: 'Do I lose control of my own website?',
    a: "No. You get an admin where you can see and change anything yourself, every automated change is reported to you in plain English, and anything meaningful requires your approval before it goes live. Autonomous means the busywork happens without you — not that decisions happen without you.",
  },
  {
    q: 'Why does a normal website get worse over time?',
    a: "Nothing on the web holds still. Search engines change how they rank, browsers and plugins change what they support, images and pages accumulate weight, links rot as other sites move or disappear, and the questions your customers ask drift away from what the site answers. A site built once and never touched falls a little further behind every month — the decline is invisible until leads dry up.",
  },
  {
    q: 'How much does a smart website cost?',
    a: 'MannyKnows smart website plans start at $99/mo, month to month, and include hosting, SSL, unlimited content updates, English and Spanish, your own admin, and Remi — the AI agent that answers your customers 24/7. Higher plans add booking and lead pipelines, then full self-optimization where the site writes its own content and tunes its own SEO.',
  },
  {
    q: 'Will AI assistants like ChatGPT find my business?',
    a: "That's increasingly where customers ask first, and it's part of what these sites are built for. Being quotable by an AI takes clear structure, real answers to real questions, and consistent business information across the web — the same work that earns search rankings, aimed at a newer audience. It's built into how we structure every site we ship.",
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<BaseLayout
  title="What Is a Smart Website? A Site That Improves Itself | MannyKnows"
  description="A smart website checks itself daily, fixes what's safe on its own, answers customers 24/7, and reports what changed — instead of decaying like a normal site. How they work, what they cost, and who they're for."
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <main class="relative bg-light-primary dark:bg-dark-primary text-text-light-primary dark:text-text-dark-primary min-h-screen transition-colors duration-300">

    <header class="relative bg-gradient-to-t from-gray-50/50 via-gray-100/30 to-gray-50/20 dark:from-gray-900/60 dark:via-slate-800/40 dark:to-gray-900/30 transition-colors duration-300">
      <NavBar />
      <nav aria-label="breadcrumb" class="max-w-[1440px] mx-auto px-4 lg:px-6 pt-6 pb-4">
        <ol class="flex flex-wrap items-center gap-2 text-sm text-text-light-secondary dark:text-text-dark-secondary">
          <li><a href="/" class="hover:text-primary-blue transition-colors">Home</a></li>
          <li class="flex items-center"><span class="mx-2 text-text-light-tertiary dark:text-text-dark-tertiary">/</span><span class="text-text-light-primary dark:text-text-dark-primary font-medium">Smart websites</span></li>
        </ol>
      </nav>
      <div class="pb-12 px-4">
        <div class="max-w-3xl mx-auto text-center">
          <span class="inline-block bg-gradient-to-r from-primary-blue/10 via-purple-500/10 to-primary-pink/10 text-primary-blue px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider mb-4">Springfield · Western Massachusetts</span>
          <h1 class="sf-bold apple-headline text-4xl md:text-5xl lg:text-6xl mb-6">
            <span class="apple-gradient-text" data-colorful-title>What is a smart website?</span>
          </h1>
          <p class="text-base sm:text-xl text-text-light-secondary dark:text-text-dark-secondary leading-relaxed">
            <strong class="text-text-light-primary dark:text-text-dark-primary">A smart website is a website that monitors and improves itself.</strong> It checks itself every day, fixes what's safe to fix on its own, answers your customers around the clock, and tells you in plain English what it changed — instead of sitting frozen the way it was built.
          </p>
        </div>
      </div>
    </header>

    <!-- The concept, taught -->
    <Section id="concept" variant="default">
      <Container>
        <SmartWebsiteConcept />
      </Container>
    </Section>

    <!-- The distinction that matters most: this is NOT a website builder -->
    <Section id="not-a-builder" variant="alternate">
      <Container>
        <div class="max-w-3xl mx-auto">
          <h2 class="sf-bold text-2xl md:text-3xl font-bold text-center mb-6">
            <span class="apple-gradient-text" data-colorful-title>"Isn't this just an AI website builder?"</span>
          </h2>
          <p class="text-base sm:text-lg text-text-light-secondary dark:text-text-dark-secondary leading-relaxed mb-6">
            No — and it's worth being precise, because the two get sold with the same words. An <strong class="text-text-light-primary dark:text-text-dark-primary">AI website builder</strong> is a tool you operate. It generates a decent-looking site in minutes, and then everything after that is yours: the speed, the search rankings, the updates, the customer questions at 9 p.m., the thing that broke in March that you'll notice in August.
          </p>
          <p class="text-base sm:text-lg text-text-light-secondary dark:text-text-dark-secondary leading-relaxed mb-6">
            A <strong class="text-text-light-primary dark:text-text-dark-primary">smart website</strong> is a service that's accountable for the outcome. The site keeps working on itself after launch, and there's a person — here, that's Manny — whose job is making sure it's actually bringing in work. The builder sells you a starting line. This is the part after it.
          </p>
          <p class="text-base sm:text-lg text-text-light-secondary dark:text-text-dark-secondary leading-relaxed">
            That's also why it's monthly rather than one big check. A website isn't a thing you buy once; it's something that either keeps up or falls behind.
          </p>
        </div>
      </Container>
    </Section>

    <!-- Honest scoping -->
    <Section id="who-its-for" variant="default">
      <Container>
        <div class="max-w-4xl mx-auto">
          <h2 class="sf-bold text-2xl md:text-3xl font-bold text-center mb-10">
            <span class="apple-gradient-text" data-colorful-title>Who this is actually for</span>
          </h2>
          <div class="grid gap-6 md:grid-cols-2">
            <div class="rounded-2xl border border-primary-blue/40 ring-1 ring-primary-blue/15 bg-white dark:bg-dark-secondary p-6">
              <h3 class="text-lg font-bold text-text-light-primary dark:text-text-dark-primary mb-4">A good fit if…</h3>
              <ul class="space-y-3 text-sm text-text-light-secondary dark:text-text-dark-secondary">
                <li class="flex gap-3"><span class="text-primary-blue dark:text-blue-300 flex-shrink-0">✓</span><span>You run the business and don't have time to babysit a website</span></li>
                <li class="flex gap-3"><span class="text-primary-blue dark:text-blue-300 flex-shrink-0">✓</span><span>Customers call or message after hours and you can't always answer</span></li>
                <li class="flex gap-3"><span class="text-primary-blue dark:text-blue-300 flex-shrink-0">✓</span><span>Your site is a few years old and you're not sure it still works</span></li>
                <li class="flex gap-3"><span class="text-primary-blue dark:text-blue-300 flex-shrink-0">✓</span><span>People near you search for what you do and find someone else</span></li>
                <li class="flex gap-3"><span class="text-primary-blue dark:text-blue-300 flex-shrink-0">✓</span><span>Your customers speak English, Spanish, or both</span></li>
              </ul>
            </div>
            <div class="rounded-2xl border border-light-tertiary dark:border-dark-accent bg-white dark:bg-dark-secondary p-6">
              <h3 class="text-lg font-bold text-text-light-primary dark:text-text-dark-primary mb-4">Probably not, if…</h3>
              <ul class="space-y-3 text-sm text-text-light-secondary dark:text-text-dark-secondary">
                <li class="flex gap-3"><span class="text-text-light-tertiary dark:text-text-dark-tertiary flex-shrink-0">—</span><span>You want to build and manage it all yourself — a builder tool is cheaper and fine for that</span></li>
                <li class="flex gap-3"><span class="text-text-light-tertiary dark:text-text-dark-tertiary flex-shrink-0">—</span><span>You need a one-page placeholder and nothing more</span></li>
                <li class="flex gap-3"><span class="text-text-light-tertiary dark:text-text-dark-tertiary flex-shrink-0">—</span><span>You'd rather pay once and let it sit — that's a project build, not a plan, and we do those too</span></li>
              </ul>
              <p class="text-sm text-text-light-secondary dark:text-text-dark-secondary mt-5">
                We'd rather tell you upfront than sell you the wrong thing.
              </p>
            </div>
          </div>
        </div>
      </Container>
    </Section>

    <!-- Proof -->
    <Section id="proof" variant="alternate">
      <Container>
        <div class="max-w-3xl mx-auto text-center">
          <span class="inline-block text-[11px] font-bold uppercase tracking-wider text-primary-blue dark:text-blue-300 mb-4">It's not theoretical</span>
          <h2 class="sf-bold text-2xl md:text-3xl font-bold mb-5 text-text-light-primary dark:text-text-dark-primary">
            This is already running for a Springfield painting contractor
          </h2>
          <p class="text-base sm:text-lg text-text-light-secondary dark:text-text-dark-secondary leading-relaxed mb-6">
            SL Painting had a great reputation and no way for new customers to find them — every lead handled by phone and memory. Today their site ranks <strong class="text-text-light-primary dark:text-text-dark-primary">#1 on Google, organically, for "Exterior Painting" in Springfield</strong>, an AI agent answers homeowners around the clock, and every lead lands in an admin instead of a notebook.
          </p>
          <a href="/work/sl-painting/" class="inline-flex items-center gap-1.5 text-sm font-semibold text-primary-blue dark:text-blue-300 hover:underline">
            Read the full story
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
          </a>
        </div>
      </Container>
    </Section>

    <!-- FAQ -->
    <Section id="faq" variant="default">
      <Container>
        <div class="max-w-3xl mx-auto">
          <h2 class="sf-bold text-2xl md:text-3xl font-bold text-center mb-10">
            <span class="apple-gradient-text" data-colorful-title>Questions people ask</span>
          </h2>
          <div class="space-y-4">
            {faqs.map((f) => (
              <div class="rounded-2xl border border-light-tertiary dark:border-dark-accent bg-white dark:bg-dark-secondary p-6">
                <h3 class="font-semibold text-text-light-primary dark:text-text-dark-primary mb-2">{f.q}</h3>
                <p class="text-sm text-text-light-secondary dark:text-text-dark-secondary leading-relaxed">{f.a}</p>
              </div>
            ))}
          </div>
        </div>
      </Container>
    </Section>

    <!-- CTA -->
    <Section id="cta" variant="alternate">
      <Container>
        <div class="max-w-2xl mx-auto text-center">
          <h2 class="sf-bold text-2xl md:text-3xl font-bold mb-4">
            <span class="apple-gradient-text" data-colorful-title>See what yours would do</span>
          </h2>
          <p class="text-text-light-secondary dark:text-text-dark-secondary mb-8">
            Tell us about your business on a short call — we'll show you what a site like this would handle for you, and what it would cost. Plans start at $99/mo, month to month.
          </p>
          <div class="flex flex-wrap items-center justify-center gap-4">
            <a href={BOOKING_URL} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-primary-blue to-primary-pink text-white px-7 py-3.5 text-sm font-semibold transition-all duration-300">
              Book a free call
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
            </a>
            <a href="/plans/" class="inline-flex items-center justify-center gap-2 rounded-xl border border-primary-blue/40 text-primary-blue dark:text-blue-300 px-7 py-3.5 text-sm font-semibold hover:bg-primary-blue/5 transition-all duration-300">
              Compare the plans
            </a>
          </div>
        </div>
      </Container>
    </Section>

    <DockMenu />
  </main>
</BaseLayout>
