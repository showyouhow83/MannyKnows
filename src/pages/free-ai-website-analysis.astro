---
// Landing page behind the "Free AI Website Analysis" nav CTA. Sells the offer
// honestly and routes to the contact modal — no fake tooling. We review each
// site with the same tooling we build with.
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import NavBar from '../components/navigation/NavBar.astro';
import DockMenu from '../components/navigation/DockMenu.astro';
import Section from '../components/layout/Section.astro';
import Container from '../components/layout/Container.astro';
import QuoteBlock from '../components/ui/QuoteBlock.astro';
import Faq from '../components/ui/Faq.astro';
import { getTestimonial } from '../data/testimonials';

const checks = [
  { title: 'Speed & Core Web Vitals', body: "How fast your site loads on a real phone. It's the single biggest thing that costs you visitors and Google ranking.", icon: 'M13 10V3L4 14h7v7l9-11h-7z' },
  { title: 'AI-readiness', body: "Whether AI answer engines can find, read, and recommend you. We look at crawler policy, llms.txt, and machine-readable contact info, plus where an AI agent could answer and book for you 24/7.", icon: 'M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z' },
  { title: 'Google & technical SEO', body: "Whether Google can find, read, and rank your pages, from titles, structure, sitemaps, and schema to the technical basics most sites get wrong.", icon: 'M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z' },
  { title: 'Mobile experience', body: "How the site actually feels on the phones most of your customers use — layout, tap targets, and readability.", icon: 'M12 18h.01M8 21h8a1 1 0 001-1V4a1 1 0 00-1-1H8a1 1 0 00-1 1v16a1 1 0 001 1z' },
  { title: 'Conversion & trust', body: "Whether a visitor can quickly see what you do, trust you, and take the next step to call, book, or buy.", icon: 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z' },
  { title: 'Accessibility', body: "Whether everyone can use your site. It's the right thing to do, and a real ranking and legal factor.", icon: 'M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z' },
];

// One section instead of the old three-step "How it works" + separate
// walk-away list — same information, half the scroll, none of the filler.
const walkaway = [
  'A prioritized list of the fixes that matter most, highest impact first.',
  'A clear read on how you compare to the competitors showing up ahead of you.',
  'A straight answer on whether a refresh, a rebuild, or maintenance makes sense.',
  'And every fix on the list is something we can run for you (website, SEO, AI agent, store) so the list never becomes homework.',
];

const faqs = [
  { q: 'Is it really free?', a: 'Yes, the instant scan and our full review both. It is how we show the kind of work we do before you spend a dollar.' },
  { q: 'What do you need from me?', a: 'Your website address and your email — the full report is delivered there, every finding with its fix. One website per email address; re-scanning your own site is always free. If you have a goal in mind (more calls, more bookings, more online sales), say so and the review focuses there.' },
  { q: 'How is this different from a free automated score?', a: 'The instant scan is automated, which is why it is instant. Our full review is not. We check your competitors, your actual rankings, and whether the site sells, then put the findings in a prioritized, actionable list. Most tools stop at a number; we start there.' },
  { q: 'How long does it take?', a: 'The scan takes seconds. Our full review usually comes back within a couple of business days. Tell us if you need it sooner.' },
];

const quote = getTestimonial('SL Painting');
---

<BaseLayout
  title="Free AI Website Analysis for Speed & SEO | MannyKnows"
  description="Get a free review of your website (speed, Google visibility, mobile, and conversions) with a prioritized list of fixes."
>
  <main class="relative bg-light-primary dark:bg-dark-primary text-text-light-primary dark:text-text-dark-primary min-h-screen transition-colors duration-300">

    <header class="relative bg-gradient-to-t from-gray-50/50 via-gray-100/30 to-gray-50/20 dark:from-gray-900/60 dark:via-slate-800/40 dark:to-gray-900/30 transition-colors duration-300 room-hero">
      <NavBar />
      <nav aria-label="breadcrumb" class="max-w-[1440px] mx-auto px-4 lg:px-6 pt-6 pb-4">
        <ol class="flex flex-wrap items-center gap-2 text-sm text-text-light-secondary dark:text-text-dark-secondary">
          <li><a href="/" class="hover:text-primary-blue transition-colors">Home</a></li>
          <li class="flex items-center"><span class="mx-2 text-text-light-tertiary dark:text-text-dark-tertiary">/</span><span class="text-text-light-primary dark:text-text-dark-primary font-medium">Free AI Website Analysis</span></li>
        </ol>
      </nav>
      <div class="pb-12 px-4">
        <div class="max-w-[1440px] mx-auto text-center">
          <span class="inline-block bg-gradient-to-r from-primary-blue/10 via-purple-500/10 to-primary-pink/10 text-primary-blue px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider mb-4">Instant scan · full review · no obligation</span>
          <h1 class="sf-bold apple-headline text-4xl md:text-5xl lg:text-6xl mb-6">
            <span class="apple-gradient-text" data-colorful-title>Free AI Website Analysis</span>
          </h1>
          <p class="max-w-3xl mx-auto text-base sm:text-xl text-text-light-secondary dark:text-text-dark-secondary leading-relaxed">
            Type your address and your email for an instant checkup. Is your site findable, fast, answering customers, and turning visits into calls? Every gap comes back named, with the fix next to it, delivered to your inbox. Then we go deeper, free.
          </p>

          <!-- Instant scanner -->
          <form id="scanForm" class="mt-8 max-w-2xl mx-auto flex flex-col sm:flex-row gap-3" novalidate>
            <label for="scanUrl" class="sr-only">Your website address</label>
            <input
              id="scanUrl"
              name="url"
              type="text"
              inputmode="url"
              autocomplete="url"
              placeholder="yourbusiness.com"
              class="flex-1 min-w-0 h-12 px-4 rounded-xl border border-light-tertiary dark:border-dark-accent bg-white dark:bg-dark-secondary text-text-light-primary dark:text-text-dark-primary text-base focus:outline-none focus:border-primary-blue/60 focus:ring-2 focus:ring-primary-blue/20 transition"
            />
            <label for="scanEmail" class="sr-only">Your email</label>
            <input
              id="scanEmail"
              name="email"
              type="email"
              inputmode="email"
              autocomplete="email"
              placeholder="you@yourbusiness.com"
              class="flex-1 min-w-0 h-12 px-4 rounded-xl border border-light-tertiary dark:border-dark-accent bg-white dark:bg-dark-secondary text-text-light-primary dark:text-text-dark-primary text-base focus:outline-none focus:border-primary-blue/60 focus:ring-2 focus:ring-primary-blue/20 transition"
            />
            <button id="scanBtn" type="submit" class="inline-flex items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-primary-blue to-primary-pink text-white px-6 h-12 text-sm font-semibold transition-all duration-300 disabled:opacity-60 disabled:cursor-not-allowed">
              Scan my site, free
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
            </button>
          </form>
          <p id="scanError" role="alert" class="hidden mt-4 max-w-xl mx-auto text-sm text-red-500"></p>
          <p class="mt-4 text-sm text-text-light-tertiary dark:text-text-dark-tertiary">
            Instant and free. The full report goes to your email — one website per email, re-scans anytime. Prefer to skip the scan? <a href="#contact" data-contact-context="Free AI Website Analysis" class="text-primary-blue dark:text-blue-300 hover:underline">Request the free review</a>.
          </p>
        </div>
      </div>
    </header>

    <!-- Scan results (rendered by the script below) -->
    <Section id="scan-results-section" variant="default" className="hidden room chain-violet-blue">
      <Container>
        <div id="scanResults" class="max-w-6xl mx-auto"></div>
        <div class="max-w-4xl mx-auto text-center mt-10">
          <p class="text-sm text-text-light-secondary dark:text-text-dark-secondary mb-4 max-w-2xl mx-auto">
            That's the automated first pass — one page, read by a machine. Our free <strong class="text-text-light-primary dark:text-text-dark-primary">full review</strong> goes where scanners can't: your competitors, your actual rankings, and whether the site sells.
          </p>
          <a href="#contact" data-contact-context="Free AI Website Analysis (ran the instant scan)" class="inline-flex items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-primary-blue to-primary-pink text-white px-6 py-3 text-sm font-semibold transition-all duration-300">
            Get the free full review
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
          </a>
        </div>
      </Container>
    </Section>

    <Section id="analysis-checks" variant="default" className="room chain-blue-violet">
      <Container>
        <div class="max-w-6xl mx-auto">
          <h2 class="sf-bold text-2xl md:text-3xl font-bold text-center mb-10">
            <span class="apple-gradient-text" data-colorful-title>What we check</span>
          </h2>
          <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {checks.map((c) => (
              <div class="rounded-2xl border border-light-tertiary dark:border-dark-accent bg-white dark:bg-dark-secondary p-6 transition-all duration-300 hover:border-primary-blue/30 hover:shadow-lg">
                <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-gradient-to-br from-primary-blue to-primary-pink text-white shadow-lg shadow-primary-blue/20 mb-4">
                  <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d={c.icon} /></svg>
                </div>
                <h3 class="text-base font-bold text-text-light-primary dark:text-text-dark-primary mb-2">{c.title}</h3>
                <p class="text-sm text-text-light-secondary dark:text-text-dark-secondary leading-relaxed">{c.body}</p>
              </div>
            ))}
          </div>
        </div>
      </Container>
    </Section>

    <Section id="analysis-walkaway" variant="alternate" className="room glow-violet">
      <Container>
        <div class="max-w-3xl mx-auto">
          <h2 class="sf-bold text-2xl md:text-3xl font-bold text-center mb-4">
            <span class="apple-gradient-text" data-colorful-title>What you walk away with</span>
          </h2>
          <p class="text-center text-base text-text-light-secondary dark:text-text-dark-secondary max-w-2xl mx-auto mb-8">
            The scan is instant. Our free full review is where it gets serious. We check what a scanner can't (your competitors, your rankings, whether the site actually sells) and send back a short plan.
          </p>
          <ul class="grid sm:grid-cols-2 gap-4">
            {walkaway.map((w) => (
              <li class="flex items-start gap-3 rounded-xl border border-light-tertiary dark:border-dark-accent bg-white dark:bg-dark-secondary p-5">
                <svg class="w-5 h-5 text-green-500 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
                <span class="text-sm text-text-light-secondary dark:text-text-dark-secondary leading-relaxed">{w}</span>
              </li>
            ))}
          </ul>
        </div>
      </Container>
    </Section>

    {quote && (
      <Section id="analysis-proof" variant="default" className="room glow-violet">
        <Container>
          <div class="max-w-2xl mx-auto text-center">
            <p class="text-sm font-semibold uppercase tracking-wide text-primary-blue dark:text-blue-300 mb-6">The kind of result this leads to</p>
            <QuoteBlock quote={quote} align="center" />
          </div>
        </Container>
      </Section>
    )}

    <Section id="analysis-faq" variant="alternate" className="room glow-blue">
      <Container>
        <Faq faqs={faqs} />
        <div class="text-center mt-12">
          <a href="#contact" data-contact-context="Free AI Website Analysis" class="inline-flex items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-primary-blue to-primary-pink text-white px-6 py-3 text-sm font-semibold transition-all duration-300">
            Get my free analysis
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
          </a>
        </div>
      </Container>
    </Section>

    <DockMenu />
  </main>
</BaseLayout>

<script>
  // Instant scanner: POST the URL to /api/analyze-site and render the result.
  // All markup classes are literal strings so Tailwind's scanner keeps them.
  (function () {
    const form = document.getElementById('scanForm');
    if (!form) return;
    const input = document.getElementById('scanUrl') as HTMLInputElement | null;
    const btn = document.getElementById('scanBtn') as HTMLButtonElement | null;
    const errEl = document.getElementById('scanError');
    const section = document.getElementById('scan-results-section');
    const out = document.getElementById('scanResults');

    const esc = (s: string) =>
      String(s).replace(/[&<>"']/g, (ch) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[ch] as string);

    function showError(msg: string) {
      if (!errEl) return;
      errEl.textContent = msg;
      errEl.classList.remove('hidden');
    }

    const ICONS: Record<string, string> = {
      pass: '<span class="inline-flex w-5 h-5 rounded-full bg-green-500/15 text-green-500 items-center justify-center text-xs font-bold flex-shrink-0" aria-label="pass">✓</span>',
      warn: '<span class="inline-flex w-5 h-5 rounded-full bg-amber-500/15 text-amber-500 items-center justify-center text-xs font-bold flex-shrink-0" aria-label="warning">!</span>',
      fail: '<span class="inline-flex w-5 h-5 rounded-full bg-red-500/15 text-red-500 items-center justify-center text-xs font-bold flex-shrink-0" aria-label="fail">✕</span>',
    };

    function barColor(score: number) {
      return score >= 80 ? 'bg-green-500' : score >= 50 ? 'bg-amber-500' : 'bg-red-500';
    }

    // Normal path: the full report went to their inbox — the page shows the
    // score, the pillar bars, and where the details went. No expandable
    // checks, no fixes: those live in the email (that's the whole gate).
    function renderTeaser(data: any) {
      if (!out || !section) return;
      const pillars = [...data.pillars].sort((a: any, b: any) => a.score - b.score);
      out.innerHTML = `
        <div class="text-center mb-8">
          <p class="text-sm font-semibold uppercase tracking-wide text-primary-blue dark:text-blue-300 mb-3">Instant scan · ${esc(data.host)}</p>
          <div class="inline-flex items-baseline gap-3">
            <span class="text-6xl font-black apple-gradient-text" data-colorful-title>${data.overall}</span>
            <span class="text-2xl font-bold text-text-light-tertiary dark:text-text-dark-tertiary">/100</span>
          </div>
          <p class="mt-2 text-lg font-semibold text-text-light-primary dark:text-text-dark-primary">${esc(data.grade)}</p>
          <p class="mt-1 text-sm text-text-light-tertiary dark:text-text-dark-tertiary">${data.findings === 0 ? 'Nothing flagged on this pass.' : data.findings + ' finding' + (data.findings > 1 ? 's' : '') + ' worth your attention.'}</p>
        </div>
        <div class="max-w-xl mx-auto rounded-2xl border border-primary-blue/30 bg-primary-blue/5 dark:bg-primary-blue/10 p-6 text-center mb-10">
          <p class="text-base font-bold text-text-light-primary dark:text-text-dark-primary">Full report sent to ${esc(data.sentTo)}</p>
          <p class="mt-1 text-sm text-text-light-secondary dark:text-text-dark-secondary leading-relaxed">Every finding, with the fix next to it. Give it a minute — and check spam or Promotions if it doesn't show.</p>
        </div>
        <div class="space-y-4 max-w-3xl mx-auto">
          ${pillars.map((p: any) => `
            <div class="bg-white dark:bg-dark-secondary border border-light-tertiary dark:border-dark-accent rounded-2xl px-6 py-5">
              <div class="flex items-center justify-between mb-2">
                <span class="font-bold text-text-light-primary dark:text-text-dark-primary">${esc(p.name)}</span>
                <span class="text-sm font-bold ${p.score >= 80 ? 'text-green-500' : p.score >= 50 ? 'text-amber-500' : 'text-red-500'}">${p.score}</span>
              </div>
              <div class="h-2 rounded-full bg-light-tertiary dark:bg-dark-accent overflow-hidden">
                <div class="h-full rounded-full ${barColor(p.score)} transition-all duration-700" style="width:${p.score}%"></div>
              </div>
            </div>`).join('')}
        </div>
        <p class="text-center text-xs text-text-light-tertiary dark:text-text-dark-tertiary mt-6">Automated first pass of one page${data.cached ? ' (cached within the last 30 minutes)' : ''}. The detail behind each bar is in your email.</p>
      `;
      section.classList.remove('hidden');
      section.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    // Fallback path: the report email couldn't be sent, so the full report
    // renders on the page — a real visitor shouldn't be stranded by an
    // email-provider hiccup on our side.
    function render(data: any) {
      if (!out || !section) return;
      // Worst first (Manny, Aug 2026): lowest-scoring pillar leads, and inside
      // each pillar the failures lead — the visitor's biggest problem is the
      // first thing they read, not buried under green rows.
      const CHECK_ORDER: Record<string, number> = { fail: 0, warn: 1, pass: 2 };
      const pillars = [...data.pillars]
        .sort((a: any, b: any) => a.score - b.score)
        .map((p: any) => ({
          ...p,
          checks: [...p.checks].sort((a: any, b: any) => (CHECK_ORDER[a.status] ?? 3) - (CHECK_ORDER[b.status] ?? 3)),
        }));
      const fails = pillars.flatMap((p: any) => p.checks).filter((c: any) => c.status !== 'pass').length;
      out.innerHTML = `
        <div class="text-center mb-10">
          <p class="text-sm font-semibold uppercase tracking-wide text-primary-blue dark:text-blue-300 mb-3">Instant scan · ${esc(data.host)}</p>
          <div class="inline-flex items-baseline gap-3">
            <span class="text-6xl font-black apple-gradient-text" data-colorful-title>${data.overall}</span>
            <span class="text-2xl font-bold text-text-light-tertiary dark:text-text-dark-tertiary">/100</span>
          </div>
          <p class="mt-2 text-lg font-semibold text-text-light-primary dark:text-text-dark-primary">${esc(data.grade)}</p>
          <p class="mt-1 text-sm text-text-light-tertiary dark:text-text-dark-tertiary">${fails === 0 ? 'Nothing flagged on this pass.' : fails + ' finding' + (fails > 1 ? 's' : '') + ' worth your attention below.'}</p>
        </div>
        <div class="space-y-5">
          ${data.pillars.map((p: any) => `
            <details class="group bg-white dark:bg-dark-secondary border border-light-tertiary dark:border-dark-accent rounded-2xl px-6 py-5" ${p.score < 100 ? 'open' : ''}>
              <summary class="flex items-center gap-4 cursor-pointer list-none">
                <div class="flex-1 min-w-0">
                  <div class="flex items-center justify-between mb-2">
                    <span class="font-bold text-text-light-primary dark:text-text-dark-primary">${esc(p.name)}</span>
                    <span class="text-sm font-bold ${p.score >= 80 ? 'text-green-500' : p.score >= 50 ? 'text-amber-500' : 'text-red-500'}">${p.score}</span>
                  </div>
                  <div class="h-2 rounded-full bg-light-tertiary dark:bg-dark-accent overflow-hidden">
                    <div class="h-full rounded-full ${barColor(p.score)} transition-all duration-700" style="width:${p.score}%"></div>
                  </div>
                </div>
                <svg class="w-5 h-5 text-text-light-tertiary dark:text-text-dark-tertiary transition-transform group-open:rotate-180 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
              </summary>
              <ul class="mt-4 space-y-3">
                ${p.checks.map((c: any) => `
                  <li class="flex items-start gap-3">
                    ${ICONS[c.status]}
                    <div class="min-w-0">
                      <p class="text-sm font-semibold text-text-light-primary dark:text-text-dark-primary">${esc(c.label)}</p>
                      <p class="text-sm text-text-light-secondary dark:text-text-dark-secondary leading-relaxed">${esc(c.detail)}</p>
                      ${c.fix ? `<a href="${esc(c.fix.href)}" class="text-sm text-primary-blue dark:text-blue-300 font-medium hover:underline">${esc(c.fix.text)} →</a>` : ''}
                    </div>
                  </li>`).join('')}
              </ul>
            </details>`).join('')}
        </div>
        ${Array.isArray(data.opportunities) && data.opportunities.length ? `
        <div class="mt-12">
          <h3 class="sf-bold text-xl md:text-2xl font-bold text-center mb-2"><span class="apple-gradient-text" data-colorful-title>Where AI could work for ${esc(data.host)}</span></h3>
          <p class="text-center text-sm text-text-light-secondary dark:text-text-dark-secondary max-w-2xl mx-auto mb-6">Each card comes from something the scan found on your page, matched to the AI agent, automation, or SEO service that fixes it.</p>
          <div class="grid gap-4 sm:grid-cols-2">
            ${data.opportunities.map((o: any) => `
              <a href="${esc(o.href)}" class="group block rounded-2xl border border-light-tertiary dark:border-dark-accent bg-white dark:bg-dark-secondary p-5 hover:border-primary-blue/30 hover:shadow-lg transition-all duration-300">
                <p class="text-sm font-bold text-text-light-primary dark:text-text-dark-primary mb-1.5">${esc(o.title)}</p>
                <p class="text-sm text-text-light-secondary dark:text-text-dark-secondary leading-relaxed">${esc(o.body)}</p>
                <span class="inline-block mt-3 text-sm text-primary-blue dark:text-blue-300 font-medium group-hover:underline">See how →</span>
              </a>`).join('')}
          </div>
        </div>` : ''}
        <p class="text-center text-xs text-text-light-tertiary dark:text-text-dark-tertiary mt-6">Automated first pass of one page, fetched ${esc(new Date(data.fetchedAt).toLocaleTimeString())}${data.cached ? ' (cached within the last 30 minutes)' : ''}. It can miss things we'd catch ourselves. That's what the free review below is for.</p>
      `;
      section.classList.remove('hidden');
      section.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!input || !btn) return;
      errEl && errEl.classList.add('hidden');
      const url = input.value.trim();
      if (!url) { showError('Type your website address first, like yourbusiness.com.'); return; }
      const emailInput = document.getElementById('scanEmail') as HTMLInputElement | null;
      const email = emailInput?.value.trim() ?? '';
      if (!email || !/^[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,}$/i.test(email)) {
        showError("Add your email too. It's where we follow up on what the scan finds.");
        emailInput?.focus();
        return;
      }
      btn.disabled = true;
      const original = btn.innerHTML;
      btn.innerHTML = 'Scanning…';
      try {
        const res = await fetch('/api/analyze-site', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ url, email }),
        });
        const data = await res.json();
        if (data.ok) (data.emailed ? renderTeaser(data) : render(data));
        else showError(data.error || 'Something went wrong. Try again, or request our free full review below.');
      } catch {
        showError('Network hiccup. Try again in a moment.');
      } finally {
        btn.disabled = false;
        btn.innerHTML = original;
      }
    });
  })();
</script>
