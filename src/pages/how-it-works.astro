---
// How it works — the "From process to app" section, now on its own page.
// The homepage links here via a banner.
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import NavBar from '../components/navigation/NavBar.astro';
import DockMenu from '../components/navigation/DockMenu.astro';
import ProcessSectionAlt from '../components/sections/ProcessSectionAlt.astro';
import { BOOKING_URL } from '../data/booking';
---

<BaseLayout
  title="How We Work — From First Call to Launch | MannyKnows"
  description="How to start with MannyKnows: book a free call, phone, or message us. We map what's slowing you down, scope a plan or build, and you approve before anything starts."
>
  <main class="relative bg-light-primary dark:bg-dark-primary text-text-light-primary dark:text-text-dark-primary min-h-screen transition-colors duration-300">

    <header class="relative bg-gradient-to-t from-gray-50/50 via-gray-100/30 to-gray-50/20 dark:from-gray-900/60 dark:via-slate-800/40 dark:to-gray-900/30 transition-colors duration-300">
      <NavBar />
      <nav aria-label="breadcrumb" class="max-w-[1440px] mx-auto px-4 lg:px-6 pt-6 pb-2">
        <ol class="flex flex-wrap items-center gap-2 text-sm text-text-light-secondary dark:text-text-dark-secondary">
          <li><a href="/" class="hover:text-primary-blue transition-colors">Home</a></li>
          <li class="flex items-center"><span class="mx-2 text-text-light-tertiary dark:text-text-dark-tertiary">/</span><span class="text-text-light-primary dark:text-text-dark-primary font-medium">How it works</span></li>
        </ol>
      </nav>
    </header>

    <h1 class="sr-only">How it works — from process to app</h1>
    <ProcessSectionAlt />

    <!-- A real example + a next step (so the page doesn't dead-end) -->
    <section class="relative py-16 bg-light-primary dark:bg-dark-primary transition-colors duration-300">
      <div class="max-w-4xl mx-auto px-6 lg:px-8">
        <div class="rounded-2xl border border-light-tertiary dark:border-dark-accent bg-white dark:bg-dark-secondary p-8 md:p-10">
          <span class="inline-block text-[11px] font-bold uppercase tracking-wider text-primary-blue dark:text-blue-300 mb-4">A real example</span>
          <h2 class="sf-bold text-2xl md:text-3xl font-bold text-text-light-primary dark:text-text-dark-primary mb-4">
            SL Painting: from invisible to booking jobs while they work
          </h2>
          <p class="text-text-light-secondary dark:text-text-dark-secondary leading-relaxed mb-4">
            The bottleneck: a painting contractor with a great reputation and no way for new customers to find them, and every lead handled by phone and memory. We mapped how the work actually came in, then built the fix — a fast website, an admin CRM to catch every lead, a 24/7 AI Sales &amp; Booking Agent, and AI Painter Lab so homeowners preview their house in 98 colors before they commit.
          </p>
          <p class="text-text-light-secondary dark:text-text-dark-secondary leading-relaxed mb-6">
            The result: SL Painting now ranks <strong class="text-text-light-primary dark:text-text-dark-primary">#1 on Google — organically — for “Exterior Painting” in Springfield</strong>, and leads arrive already qualified. That's the whole arc: find the bottleneck, build the fix, run and refine it.
          </p>
          <a href="/work/sl-painting/" class="inline-flex items-center gap-1.5 text-sm font-semibold text-primary-blue dark:text-blue-300 hover:underline">
            Read the full SL Painting story
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
          </a>
        </div>

      </div>
    </section>

    <!-- Getting started — concrete contact rails + what happens next -->
    <section id="get-started" class="relative py-16 bg-gradient-to-t from-gray-50/50 via-gray-100/30 to-gray-50/20 dark:from-gray-900/60 dark:via-slate-800/40 dark:to-gray-900/30 border-t border-gray-300/30 dark:border-white/10 transition-colors duration-300">
      <div class="max-w-4xl mx-auto px-6 lg:px-8">
        <div class="text-center mb-10">
          <span class="inline-block text-[11px] font-bold uppercase tracking-wider text-primary-blue dark:text-blue-300 mb-3">Getting started</span>
          <h2 class="sf-bold text-2xl md:text-3xl font-bold"><span class="apple-gradient-text" data-colorful-title>Reaching us is the easy part</span></h2>
          <p class="text-text-light-secondary dark:text-text-dark-secondary max-w-2xl mx-auto mt-3">
            Tell us what eats your time — the quoting, the scheduling, the follow-ups, getting found on Google. Pick whichever way is easiest below. A real person (Manny) gets back to you, usually the same day.
          </p>
        </div>

        <!-- Ways to reach us -->
        <div class="grid gap-4 sm:grid-cols-3 mb-14">
          <a href={BOOKING_URL} target="_blank" rel="noopener noreferrer" class="group rounded-2xl border border-primary-blue/40 ring-1 ring-primary-blue/15 bg-white dark:bg-dark-secondary p-5 hover:border-primary-blue/60 hover:shadow-lg transition-all duration-300">
            <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-br from-primary-blue to-primary-pink text-white shadow-lg shadow-primary-blue/20 mb-3">
              <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
            </div>
            <h3 class="text-base font-bold text-text-light-primary dark:text-text-dark-primary mb-1">Book a free call</h3>
            <p class="text-sm text-text-light-secondary dark:text-text-dark-secondary">Pick a time that works. 20 minutes, no pressure, no obligation.</p>
          </a>
          <a href="tel:+14133618451" class="group rounded-2xl border border-light-tertiary dark:border-dark-accent bg-white dark:bg-dark-secondary p-5 hover:border-primary-blue/40 hover:shadow-lg transition-all duration-300">
            <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-br from-primary-blue to-primary-pink text-white shadow-lg shadow-primary-blue/20 mb-3">
              <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
            </div>
            <h3 class="text-base font-bold text-text-light-primary dark:text-text-dark-primary mb-1">Call or text</h3>
            <p class="text-sm text-text-light-secondary dark:text-text-dark-secondary">(413) 361-8451 — straight to Manny, English or Spanish.</p>
          </a>
          <a href="#contact" data-contact-context="How it works" class="group rounded-2xl border border-light-tertiary dark:border-dark-accent bg-white dark:bg-dark-secondary p-5 hover:border-primary-blue/40 hover:shadow-lg transition-all duration-300">
            <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-br from-primary-blue to-primary-pink text-white shadow-lg shadow-primary-blue/20 mb-3">
              <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
            </div>
            <h3 class="text-base font-bold text-text-light-primary dark:text-text-dark-primary mb-1">Send a message</h3>
            <p class="text-sm text-text-light-secondary dark:text-text-dark-secondary">Tell us what you need; we reply with clear next steps.</p>
          </a>
        </div>
        <p class="text-center text-sm text-text-light-tertiary dark:text-text-dark-tertiary -mt-10 mb-14">
          In a hurry? <strong class="text-text-light-secondary dark:text-text-dark-secondary">Ask Remi</strong>, our AI agent, in the corner of your screen — it answers on the spot, any hour, in English or Spanish.
        </p>

        <!-- What happens after you reach out -->
        <div class="max-w-2xl mx-auto">
          <h3 class="sf-bold text-xl md:text-2xl font-bold text-center text-text-light-primary dark:text-text-dark-primary mb-8">What happens after you reach out</h3>
          <ol class="space-y-6">
            <li class="flex gap-4">
              <span class="flex-shrink-0 flex h-8 w-8 items-center justify-center rounded-full bg-gradient-to-br from-primary-blue to-primary-pink text-white text-sm font-bold">1</span>
              <div><strong class="text-text-light-primary dark:text-text-dark-primary">We talk it through — free.</strong> <span class="text-text-light-secondary dark:text-text-dark-secondary">You describe what's slowing you down or where customers can't find you. We ask the right questions and listen.</span></div>
            </li>
            <li class="flex gap-4">
              <span class="flex-shrink-0 flex h-8 w-8 items-center justify-center rounded-full bg-gradient-to-br from-primary-blue to-primary-pink text-white text-sm font-bold">2</span>
              <div><strong class="text-text-light-primary dark:text-text-dark-primary">We scope the fix.</strong> <span class="text-text-light-secondary dark:text-text-dark-secondary">We recommend a plan or a one-time build and put clear pricing on it — what's included, what it costs, what it does. No surprises, no jargon.</span></div>
            </li>
            <li class="flex gap-4">
              <span class="flex-shrink-0 flex h-8 w-8 items-center justify-center rounded-full bg-gradient-to-br from-primary-blue to-primary-pink text-white text-sm font-bold">3</span>
              <div><strong class="text-text-light-primary dark:text-text-dark-primary">You approve before anything starts.</strong> <span class="text-text-light-secondary dark:text-text-dark-secondary">You see the plan (and a written quote if it's custom) and say go. Nothing is billed until you do.</span></div>
            </li>
            <li class="flex gap-4">
              <span class="flex-shrink-0 flex h-8 w-8 items-center justify-center rounded-full bg-gradient-to-br from-primary-blue to-primary-pink text-white text-sm font-bold">4</span>
              <div><strong class="text-text-light-primary dark:text-text-dark-primary">We build; you review before launch.</strong> <span class="text-text-light-secondary dark:text-text-dark-secondary">You see the work on a private preview link. It goes live only when you're happy — then we run it, keep it sharp, and send a plain-English report every month.</span></div>
            </li>
          </ol>

          <div class="flex flex-wrap items-center justify-center gap-4 mt-12">
            <a href={BOOKING_URL} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-primary-blue to-primary-pink text-white px-7 py-3.5 text-sm font-semibold transition-all duration-300">
              Book a free call
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
            </a>
            <a href="/plans/" class="inline-flex items-center justify-center gap-2 rounded-xl border border-primary-blue/40 text-primary-blue dark:text-blue-300 px-7 py-3.5 text-sm font-semibold hover:bg-primary-blue/5 transition-all duration-300">
              See the plans first
            </a>
          </div>
        </div>
      </div>
    </section>

    <DockMenu />
  </main>
</BaseLayout>
