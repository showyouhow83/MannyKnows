---
// How it works — the getting-started section IS the hero (contact rails +
// what happens next), followed by the first-timer FAQ. (The JK Daycare
// client quote was removed per Manny, Aug 2026.)
// The old "From process to app" rotating hero and the SL Painting example
// card were removed per Manny (Aug 2026) — the process story now lives in
// the four-step list, and SL Painting's full story stays at /work/sl-painting.
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import NavBar from '../components/navigation/NavBar.astro';
import DockMenu from '../components/navigation/DockMenu.astro';
import Faq from '../components/ui/Faq.astro';
import Breadcrumb from '../components/ui/Breadcrumb.astro';
import Button from '../components/ui/Button.astro';
import Section from '../components/layout/Section.astro';
import Container from '../components/layout/Container.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import StepCards from '../components/ui/StepCards.astro';
import { BOOKING_URL } from '../data/booking';
import { plans } from '../data/plans';

// Cost FAQ reads Get Found from plans.ts so a reprice can't strand it (or the FAQPage JSON-LD it feeds).
const getFound = plans.find((p) => p.slug === 'get-found')!;

// Answers assembled from copy already established elsewhere on the site —
// same facts, gathered where a first-time visitor actually asks them.
const faqs = [
  { q: 'Do I need to know what I need before I call?', a: "No. That's our job. Bring the bottleneck — the quoting that eats your evenings, the phone nobody can answer, the site nobody can find. We map how the work actually comes in on the first call and recommend the fix, whether that's a plan, a one-time build, or the smallest first step that gets you moving." },
  { q: 'What does it cost?', a: `Monthly website plans start at $${getFound.setupFee!.toLocaleString('en-US')} once to build the site and $${getFound.price}/mo to run it, with hosting, Remi AI answering 24/7, SEO, and maintenance included. No term, and prepaying the year waives the setup fee. One-time builds get a flat written quote up front. Either way, nothing is billed until you've seen the plan and said go.` },
  { q: 'What if I already have a website?', a: "You don't have to start over. We audit what you have, fix what's costing you customers (speed, technical SEO, mobile problems, forms nobody completes) and then keep it maintained so the fixes stick." },
  { q: 'Who actually does the work?', a: "Manny (twenty years of engineering for enterprise and startups, including enterprise eCommerce and consulting at Accenture) plus the AI agents he manages. You get a direct line to the person building, in English or Spanish. No account manager in the middle." },
  { q: 'What happens after launch?', a: "The work keeps going. The site stays fast, secure, and ranking; every lead lands in your admin; changes arrive as a private preview for your approval first; and you always know what changed and what it did." },
];
---

<BaseLayout
  title="How We Work: From First Call to Launch | MannyKnows"
  description="How to start with MannyKnows. Book a free call or message us. We map what's slowing you down, scope a plan or build, and you approve before anything starts."
>
  {/* one-canvas: one tone for the whole page instead of a different colour
      per section (Manny, Aug 2026). Hue is grouped by pillar — see the
      ONE-TONE CANVAS block in global.css. The per-section .room /
      .chain-* / .glow-* classes below are left in place on purpose:
      delete the two classes on the next line and the page reverts. */}
  <main class="relative bg-light-primary dark:bg-dark-primary text-text-light-primary dark:text-text-dark-primary min-h-screen transition-colors duration-300 one-canvas one-canvas-live">

    <header class="relative bg-gradient-to-t from-gray-50/50 via-gray-100/30 to-gray-50/20 dark:from-gray-900/60 dark:via-slate-800/40 dark:to-gray-900/30 transition-colors duration-300 room-hero">
      <NavBar />
      <Breadcrumb items={[{ label: 'How it works' }]} />

      <!-- Hero (the /contact shape). `id` kept so old /how-it-works/#get-started
           links still land right; the contact rails sit in the section below. -->
      <div id="get-started" class="pb-12 px-4">
        <div class="max-w-[1440px] mx-auto text-center">
          <div class="flex justify-center mb-6">
            <img
              src="/mascot/astro-megaphone.webp"
              alt="Astronaut mascot making an announcement with a megaphone"
              aria-hidden="true"
              width="660"
              height="880"
              decoding="async"
              class="astro-float w-auto h-[220px] pointer-events-none"
            />
          </div>
          <span class="inline-block bg-gradient-to-r from-primary-blue/10 via-purple-500/10 to-primary-pink/10 text-primary-blue px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider mb-4">Getting started</span>
          <h1 class="sf-bold apple-headline text-4xl md:text-5xl lg:text-6xl mb-6">
            <span class="apple-gradient-text" data-colorful-title>Reaching us is the easy part</span>
          </h1>
          <p class="max-w-3xl mx-auto text-base sm:text-xl text-text-light-secondary dark:text-text-dark-secondary leading-relaxed">
            Tell us what eats your time — the quoting, the scheduling, the follow-ups, getting found on Google. Pick whichever way is easiest below. A real person (Manny) gets back to you, usually the same day.
          </p>
        </div>
      </div>
    </header>

    <!-- Ways to reach us + what happens next -->
    <Section id="reach-us" variant="default" className="room chain-violet-blue">
      <Container>
        <div class="grid gap-6 sm:grid-cols-3 max-w-6xl mx-auto">
          <a href={BOOKING_URL} target="_blank" rel="noopener noreferrer" class="group rounded-2xl border border-primary-blue/40 ring-1 ring-primary-blue/20 bg-white dark:bg-dark-secondary p-6 transition-all duration-300 hover:border-primary-blue/60 hover:shadow-xl hover:shadow-primary-blue/10">
            <div class="flex items-center gap-3">
              <div class="flex h-11 w-11 flex-shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-primary-blue to-primary-pink text-white shadow-lg shadow-primary-blue/20">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
              </div>
              <h3 class="text-lg font-bold text-text-light-primary dark:text-text-dark-primary leading-snug">Book a free call</h3>
            </div>
            <p class="mt-3 text-sm text-text-light-secondary dark:text-text-dark-secondary leading-relaxed">Pick a time that works, 20 minutes, free, no obligation.</p>
          </a>
          <a href="tel:+14133618451" class="group rounded-2xl border border-light-tertiary dark:border-dark-accent bg-white dark:bg-dark-secondary p-6 transition-all duration-300 hover:border-primary-blue/40 hover:shadow-xl hover:shadow-primary-blue/10">
            <div class="flex items-center gap-3">
              <div class="flex h-11 w-11 flex-shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-primary-blue to-primary-pink text-white shadow-lg shadow-primary-blue/20">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
              </div>
              <h3 class="text-lg font-bold text-text-light-primary dark:text-text-dark-primary leading-snug">Call or text</h3>
            </div>
            <p class="mt-3 text-sm text-text-light-secondary dark:text-text-dark-secondary leading-relaxed">(413) 361-8451, straight to Manny, English or Spanish.</p>
          </a>
          <a href="#contact" data-contact-context="How it works" class="group rounded-2xl border border-light-tertiary dark:border-dark-accent bg-white dark:bg-dark-secondary p-6 transition-all duration-300 hover:border-primary-blue/40 hover:shadow-xl hover:shadow-primary-blue/10">
            <div class="flex items-center gap-3">
              <div class="flex h-11 w-11 flex-shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-primary-blue to-primary-pink text-white shadow-lg shadow-primary-blue/20">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
              </div>
              <h3 class="text-lg font-bold text-text-light-primary dark:text-text-dark-primary leading-snug">Send a message</h3>
            </div>
            <p class="mt-3 text-sm text-text-light-secondary dark:text-text-dark-secondary leading-relaxed">Tell us what you need; we reply with clear next steps.</p>
          </a>
        </div>
        <p class="text-center text-sm text-text-light-tertiary dark:text-text-dark-tertiary mt-6 max-w-3xl mx-auto">
          In a hurry? <strong class="text-text-light-secondary dark:text-text-dark-secondary">Ask Remi AI</strong>, our AI agent, in the corner of your screen. It answers on the spot, any hour, in English or Spanish.
        </p>

        <!-- What happens after you reach out — the shared numbered-step cards -->
        <div class="mt-12">
          <SectionHeader title="What happens after you reach out" />
          <StepCards
            cols={4}
            steps={[
              { title: 'We talk it through, free.', body: "You describe what's slowing you down or where customers can't find you. We ask the right questions and listen." },
              { title: 'We scope the fix.', body: "We recommend a plan or a one-time build and put clear pricing on it (what's included, what it costs, what it does) in writing, before anything starts." },
              { title: 'You approve before anything starts.', body: "You see the plan (and a written quote if it's custom) and say go. Nothing is billed until you do." },
              { title: 'We build; you review before launch.', body: "You see the work on a private preview link. It goes live only when you're happy, then we run it, keep it sharp, and keep you posted on what changed." },
            ]}
          />
          <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mt-12">
            <Button href={BOOKING_URL} target="_blank" rel="noopener noreferrer" arrow="right">Book a free call</Button>
            <Button href="/plans/" variant="secondary">See the plans first</Button>
          </div>
        </div>
      </Container>
    </Section>

    <!-- First-timer questions -->
    <Section id="faq" variant="default" className="room glow-violet">
      <Container>
        <Faq faqs={faqs} />
      </Container>
    </Section>

    <DockMenu />
  </main>
</BaseLayout>

<style>
  /* Gentle float for the hero mascot — same dials as the other page heroes. */
  .astro-float { animation: astro-float 6s ease-in-out infinite; will-change: transform; }
  @keyframes astro-float {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50%      { transform: translateY(-10px) rotate(-1.5deg); }
  }
  @media (prefers-reduced-motion: reduce) { .astro-float { animation: none; } }
</style>
