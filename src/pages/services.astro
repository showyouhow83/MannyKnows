---
// Services — the "start here" map for Western Mass businesses. Names what we
// build (concrete, owner-facing, SEO), then the two ways to work with us
// (monthly / one-time) and the custom-apps distinction. Routes to Plans, the
// AI Team, the Online Store, Business Ads, and the Idea Launchpad.
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import NavBar from '../components/navigation/NavBar.astro';
import Section from '../components/layout/Section.astro';
import WaysToWork from '../components/sections/WaysToWork.astro';
import Container from '../components/layout/Container.astro';
import DockMenu from '../components/navigation/DockMenu.astro';
import Button from '../components/ui/Button.astro';
import QuoteBlock from '../components/ui/QuoteBlock.astro';
import { getTestimonial } from '../data/testimonials';
import { aiWebsiteSetupFee, aiWebsiteMonthly } from '../data/aiWebsite';

// What we build — named the way a business owner (and Google) looks for it.
const services = [
  {
    href: '/plans/',
    title: 'Smart Website',
    desc: 'Website development the way it should be: a living site on your Brand Brain. It answers customers, and on higher tiers writes its own content and tunes its own SEO and speed. From $95/mo.',
    icon: 'M21 12a9 9 0 11-18 0 9 9 0 0118 0zM3.6 9h16.8M3.6 15h16.8M12 3a15.3 15.3 0 010 18M12 3a15.3 15.3 0 000 18',
  },
  {
    href: '/ai-website/',
    title: 'AI Website (one-page)',
    desc: `The fastest way to a real site: one fast page with “Remi”, an AI agent that answers your customers and captures every lead, tuned to near-perfect Google scores. $${aiWebsiteSetupFee} to build, $${aiWebsiteMonthly}/mo to run.`,
    icon: 'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z',
  },
  {
    href: '/ecommerce/',
    title: 'Online Store',
    desc: 'A Shopify store set up and run for you: four tiers from $150/mo, Shopify subscription included, up to a full AI shopping assistant and managed ads.',
    icon: 'M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17M17 17a2 2 0 100 4 2 2 0 000-4zM9 19a2 2 0 11-4 0 2 2 0 014 0z',
  },
  {
    href: '/local-seo/',
    title: 'SEO for Google & AI search',
    desc: 'Local SEO and web optimization that get you found when locals search, and quoted by AI answers (ChatGPT, Google AI). Built into every website; Nova on the AI Team goes deeper.',
    icon: 'M21 21l-5.2-5.2m2.2-5.3a7.5 7.5 0 11-15 0 7.5 7.5 0 0115 0z',
  },
  {
    href: '/ai-team/',
    title: 'The AI Team',
    desc: 'You hire Manny AI, one manager that staffs AI specialists on your business: front desk, daily intel, copy, SEO, engagement, reporting, and more behind the scenes. $195 setup, AI staff from $95/mo.',
    icon: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z',
  },
  {
    href: '/plans/business-ads/',
    title: 'Business Ads',
    desc: 'Social, Google, and Meta ads plus SEO campaigns that get you seen: traffic built to convert, watched and corrected monthly. $350/mo per social network, or 4 major networks for $950/mo.',
    icon: 'M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z',
  },
  {
    href: '/plans/multimedia-agency/',
    title: 'Every role, one builder',
    desc: 'Manny on retainer: development, design, SEO, photo & video, with AI multiplying the output. From $2,350/wk or $8,600/mo.',
    icon: 'M7 4v16M17 4v16M3 8h4m10 0h4M3 12h18M3 16h4m10 0h4M4 20h16a1 1 0 001-1V5a1 1 0 00-1-1H4a1 1 0 00-1 1v14a1 1 0 001 1z',
  },
  {
    href: '/local-seo/#free-360-photo',
    title: 'Photo, video & 360° tours',
    desc: 'Business and product photography, short-form video, and Google Street View 360° tours: start with a free 360° photo of your business.',
    icon: 'M23 19a2 2 0 01-2 2H3a2 2 0 01-2-2V8a2 2 0 012-2h4l2-3h6l2 3h4a2 2 0 012 2zM16 13a4 4 0 11-8 0 4 4 0 018 0z',
  },
  {
    href: '/apps/',
    title: 'Custom apps & automation',
    desc: 'Apps for how your business runs: scripts from $300, integrations & MCP servers from $600, dashboards & custom systems from $2,500. Own it outright, or co-own it with nothing upfront.',
    icon: 'M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4',
  },
];

// Structured data: umbrella Service + OfferCatalog derived from the `services`
// array above — the catalog can never drift from the visible cards.
const pageJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'MannyKnows Services',
  serviceType: 'Web design, AI agent development, SEO services, and app development',
  provider: {
  '@type': 'ProfessionalService',
  '@id': 'https://mannyknows.com/#business',
  name: 'MannyKnows',
  url: 'https://mannyknows.com',
  telephone: '+1-413-361-8451',
  address: { '@type': 'PostalAddress', addressLocality: 'Springfield', addressRegion: 'MA', addressCountry: 'US' },
},
  areaServed: 'Western Massachusetts',
  description: 'AI agents, web design, SEO services & custom apps for small businesses in Western Massachusetts.',
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'What we build',
    itemListElement: services.map((s) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: s.title },
      url: 'https://mannyknows.com' + (s.href.startsWith('#') ? '/services/' + s.href : s.href),
    })),
  },
};
---

<BaseLayout
  title="Services & Pricing: Web Design, AI Agents, SEO | MannyKnows"
  description="AI agents, websites, SEO, online stores, and custom apps for Western Mass businesses. Work with us monthly or one-time. From $95/mo."
>
  <script type="application/ld+json" set:html={JSON.stringify(pageJsonLd)} />
  <main class="relative bg-light-primary dark:bg-dark-primary text-text-light-primary dark:text-text-dark-primary min-h-screen transition-colors duration-300">

    <header class="relative bg-gradient-to-t from-gray-50/50 via-gray-100/30 to-gray-50/20 dark:from-gray-900/60 dark:via-slate-800/40 dark:to-gray-900/30 transition-colors duration-300">
      <NavBar />
      <nav aria-label="breadcrumb" class="max-w-[1440px] mx-auto px-4 lg:px-6 pt-6 pb-4">
        <ol class="flex flex-wrap items-center gap-2 text-sm text-text-light-secondary dark:text-text-dark-secondary">
          <li><a href="/" class="hover:text-primary-blue transition-colors">Home</a></li>
          <li class="flex items-center"><span class="mx-2 text-text-light-tertiary dark:text-text-dark-tertiary">/</span><span class="text-text-light-primary dark:text-text-dark-primary font-medium">Services</span></li>
        </ol>
      </nav>
      <div class="pb-12 px-4">
        <div class="max-w-[1440px] mx-auto text-center">
          {/* Mascot above the eyebrow, same as the /ecommerce, /plans and
              /free-360-photo heroes. Eager (top of the page) with width and
              height declared, so it reserves its box and never shifts the H1. */}
          <div class="flex justify-center mb-6">
            <img
              src="/mascot/astro-satellite.webp"
              alt=""
              aria-hidden="true"
              width="420"
              height="318"
              decoding="async"
              class="astro-float w-full max-w-[210px] h-auto pointer-events-none"
            />
          </div>
          {/* Eyebrow adds what the H1 doesn't (city + the page's promise)
              instead of repeating the H1's own service list. */}
          <span class="inline-block bg-gradient-to-r from-primary-blue/10 via-purple-500/10 to-primary-pink/10 text-primary-blue px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider mb-4">Services &amp; Pricing</span>
          <h1 class="sf-bold apple-headline text-4xl md:text-5xl lg:text-6xl mb-6">
            <span class="apple-gradient-text" data-colorful-title>AI agents, web design, SEO &amp; apps that grow your Western Mass business</span>
          </h1>
          <p class="max-w-3xl mx-auto text-base sm:text-xl text-text-light-secondary dark:text-text-dark-secondary leading-relaxed">
            We make small businesses win online with web design, AI agents, and SEO. You get found on Google and on the AI answer engines your customers now ask, those customers answered around the clock, and visits turned into booked jobs and sales. Work with us <strong class="text-text-light-primary dark:text-text-dark-primary">monthly</strong> (we run it) or as a <strong class="text-text-light-primary dark:text-text-dark-primary">one-time project</strong> (you own it).
          </p>
        </div>
      </div>
    </header>

    <!-- What we build -->
    <Section id="what-we-build" variant="default">
      <Container>
        <div class="text-center max-w-2xl mx-auto mb-12">
          <h2 class="sf-bold text-2xl md:text-3xl font-bold">
            <span class="apple-gradient-text" data-colorful-title>What we build</span>
          </h2>
        </div>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 max-w-6xl mx-auto">
          {services.map((s) => (
            <a href={s.href} class="group flex flex-col rounded-2xl border border-light-tertiary dark:border-dark-accent bg-white dark:bg-dark-secondary p-6 transition-all duration-300 hover:border-primary-blue/40 hover:shadow-xl hover:shadow-primary-blue/10">
              <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-gradient-to-br from-primary-blue to-primary-pink text-white shadow-lg shadow-primary-blue/20 mb-4">
                <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d={s.icon} /></svg>
              </div>
              <h3 class="text-lg font-bold text-text-light-primary dark:text-text-dark-primary">{s.title}</h3>
              <p class="mt-2 text-sm text-text-light-secondary dark:text-text-dark-secondary leading-relaxed flex-1">{s.desc}</p>
              <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-primary-blue dark:text-blue-300">
                Learn more
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
              </span>
            </a>
          ))}
        </div>
      </Container>
    </Section>

    <WaysToWork />

    <!-- Proof + CTA -->
    <Section id="services-cta" variant="default">
      <Container>
        <div class="max-w-2xl mx-auto">
          <QuoteBlock quote={getTestimonial('SL Painting')} align="center" />
        </div>
        <div class="text-center mt-12">
          <Button href="#contact" text="Not sure which fits? Let's talk" variant="cta" arrow={true} />
        </div>
      </Container>
    </Section>

    <DockMenu />
  </main>
</BaseLayout>

<style>
  /* Matches the /plans and /ecommerce heroes: a slow drift, off for
     reduced-motion users. */
  .astro-float { animation: astro-float 6s ease-in-out infinite; will-change: transform; }
  @keyframes astro-float {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50%      { transform: translateY(-10px) rotate(-1.5deg); }
  }
  @media (prefers-reduced-motion: reduce) { .astro-float { animation: none; } }
</style>
