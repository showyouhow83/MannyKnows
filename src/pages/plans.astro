---
// Dedicated Plans & Pricing page — better for SEO and for linking in proposals
// and DMs than the homepage anchor. Reuses <PricingPlans /> so the tiers stay a
// single source of truth.
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import NavBar from '../components/navigation/NavBar.astro';
import Section from '../components/layout/Section.astro';
import Container from '../components/layout/Container.astro';
import Faq from '../components/ui/Faq.astro';
import DockMenu from '../components/navigation/DockMenu.astro';
import PricingPlans from '../components/sections/PricingPlans.astro';
import Illustration from '../components/illustrations/Illustration.astro';
import { servicePlans, websitePlans } from '../data/plans';
import AgentAvatar from '../components/team/AgentAvatar.astro';
import SmartWebsiteConcept from '../components/sections/SmartWebsiteConcept.astro';
import { team, aiTeamStartingPrice } from '../data/aiTeam';

const aiTeamRoster = [...team].filter((a) => !a.hidden).sort((a, b) => a.order - b.order);

const faqs = [
  {
    q: 'Can a plan be customized?',
    a: "Yes: every plan is a starting point. We tailor the scope and the price to your business, so you're never paying for services you don't need.",
  },
  {
    q: "What if I don't have a website yet?",
    a: "That's what the plans are for: designing and building your site is included, not a separate project. There's no setup fee: you pay the monthly price the first month and the same price every month after. Prefer to pay once for a one-time build instead? We do that too, just ask.",
  },
  {
    // Mirrors the twin-ladder FAQ on the Online Store plan (plans.ts,
    // sell-online) — keep the two in sync.
    q: 'What if I want to sell products?',
    a: "Every website plan has a store twin on our Online Store page (Get Found ↔ Sell Online, Get Booked ↔ Sell More, Get Growing ↔ Sell Smarter, Get Ahead ↔ Sell Everywhere): a real Shopify store, with the Shopify subscription included in the price. Switching is a plan change, not a project: we clone your design across, your monthly moves to the store tier's price, and “Remi's” training and your content carry. No migration fee, and it works the same in reverse if you stop selling. If you prepaid a year, switches after the first 7 days from kickoff aren't refunded in cash: the unused balance becomes credit, dollar for dollar, toward anything we do.",
  },
  {
    q: 'Why is $95/mo enough?',
    a: "Get Found is small: a 1–3 page site, hosted and kept fast, set up to rank locally, with your own admin, a contact form, and “Remi” answering questions 24/7. What it doesn't have is the bigger machinery: “Remi” booking jobs into your calendar, the multi-page build, the full self-optimizing engine. Those start at Get Booked. The $95 exists because a new business shouldn't need $3,000 to have a real website, and the ladder is built so you grow into the next tier when you're ready.",
  },
  {
    q: 'Is there a contract?',
    a: "Two options. Month-to-month: full price, cancel anytime. Yearly: pay the year upfront and get 2 months free, 10 months' worth for 12 months of service. Details are in our terms.",
  },
  {
    q: 'How do we start?',
    a: "Tell us what you're working with: a quick message or a call. We scope a plan together before anything's locked in.",
  },
  {
    q: 'Is this the same as an AI website builder?',
    a: "No. An AI website builder is a DIY tool. It generates a site fast, and after that keeping it quick, current, and ranking is your job. These plans are a managed service: the site keeps working on itself after launch, and we're accountable for the result. The builder hands you a starting line; this is the part after it.",
  },
  {
    q: 'Can a website really improve itself without breaking?',
    a: "It can when the boundary is drawn correctly. Your site handles low-risk upkeep on its own: compressing heavy images, fixing broken links, tightening page titles and descriptions, adding answers to questions customers keep asking. Anything touching your prices, promises, services, or voice comes to you first, and bigger changes arrive as a private preview that doesn't go live until you publish it.",
  },
  {
    q: 'Do I lose control of my own website?',
    a: "No. You get your own admin to see and change anything yourself, every automated change is reported clearly, and anything meaningful needs your approval. The busywork happens without you: decisions don't.",
  },
  {
    q: 'Will AI assistants like ChatGPT find my business?',
    a: "That's increasingly where customers ask first, and it's part of what these sites are built for. Getting quoted by an AI takes clear structure, real answers to real questions, and consistent business details across the web: the same work that earns search rankings, aimed at a newer audience. It's built into how we structure every site we ship.",
  },
];


// Structured data: the plan catalog as Service offers, mapped from plans.ts
// at build time (only plans shown in the grid; prices cannot drift).
const pageJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Website & Growth Plans',
  serviceType: 'Website design, hosting, SEO, and marketing management',
  provider: {
  '@type': 'ProfessionalService',
  '@id': 'https://mannyknows.com/#business',
  name: 'MannyKnows',
  url: 'https://mannyknows.com',
  telephone: '+1-413-361-8451',
  address: { '@type': 'PostalAddress', addressLocality: 'Springfield', addressRegion: 'MA', addressCountry: 'US' },
},
  areaServed: 'Western Massachusetts',
  description: 'Monthly website plans (designed, hosted, maintained, and answering customers 24/7) plus store, ads, and full-agency tiers.',
  offers: websitePlans.map((pl) => ({
    '@type': 'Offer',
    name: pl.name,
    price: String(pl.price),
    priceCurrency: 'USD',
    description: pl.tagline,
  })),
};
---

<BaseLayout
  title="Web Design Plans, Western Mass: from $95/mo | MannyKnows"
  description="Web design plans for Western Mass: Get Found, Get Booked, Get Growing, Get Ahead: design, hosting, SEO & maintenance in one price. From $95/mo, no setup fee."
>
  <script type="application/ld+json" set:html={JSON.stringify(pageJsonLd)} />
  <main class="relative bg-light-primary dark:bg-dark-primary text-text-light-primary dark:text-text-dark-primary min-h-screen transition-colors duration-300">

    <header class="relative bg-gradient-to-t from-gray-50/50 via-gray-100/30 to-gray-50/20 dark:from-gray-900/60 dark:via-slate-800/40 dark:to-gray-900/30 transition-colors duration-300">
      <NavBar />
      <nav aria-label="breadcrumb" class="max-w-[1440px] mx-auto px-4 lg:px-6 pt-6 pb-4">
        <ol class="flex flex-wrap items-center gap-2 text-sm text-text-light-secondary dark:text-text-dark-secondary">
          <li><a href="/" class="hover:text-primary-blue transition-colors">Home</a></li>
          <li class="flex items-center"><span class="mx-2 text-text-light-tertiary dark:text-text-dark-tertiary">/</span><span class="text-text-light-primary dark:text-text-dark-primary font-medium">Plans</span></li>
        </ol>
      </nav>
      <!-- Split hero (Aug 2026 per Manny): the old hero paragraph + the
           Brand Brain paragraph merged into one block — condensed pitch on
           the left, the Brand Brain as a scannable panel on the right, so
           the copy stops reading like a trilogy while every SEO keyword
           (AI-powered website, Western Massachusetts, the professions,
           multilingual, leads, Brand Brain, API/MCP) survives. -->
      <div class="pb-14">
        <Container>
          <div class="max-w-[1440px] mx-auto grid lg:grid-cols-2 gap-10 lg:gap-14 items-center">
            <div class="text-center lg:text-left">
              <div class="flex justify-center mb-6">
                <!-- Flipped wrapper (not the img: astro-float's keyframes own
                     the img's transform) so the mascot faces the Brand Brain
                     panel instead of giving it its back. -->
                <div class="-scale-x-100">
                  <img
                    src="/mascot/astro-laptop-fly.webp"
                    alt=""
                    aria-hidden="true"
                    width="560"
                    height="539"
                    decoding="async"
                    class="astro-float w-full max-w-[150px] h-auto pointer-events-none"
                  />
                </div>
              </div>
              <span class="inline-block bg-gradient-to-r from-primary-blue/10 via-purple-500/10 to-primary-pink/10 text-primary-blue px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider mb-4">Website Design &amp; Development</span>
              <h1 class="sf-bold apple-headline text-4xl md:text-5xl lg:text-6xl mb-6">
                <span class="apple-gradient-text" data-colorful-title>A website that works while you do</span>
              </h1>
              <p class="max-w-2xl mx-auto lg:mx-0 text-base sm:text-xl text-text-light-secondary dark:text-text-dark-secondary leading-relaxed mb-8">
                Every plan is an AI-powered website, not a brochure that sits there: multilingual, capturing leads, managing clients, and found on Google from day one. These aren't static websites: each one runs on your Brand Brain, working in your voice.
              </p>
              <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
                <a href="#pricingPlans" class="inline-flex items-center justify-center gap-2 px-7 h-12 rounded-full bg-gradient-to-r from-primary-blue via-purple-500 to-primary-pink text-white font-semibold hover:shadow-lg hover:shadow-primary-blue/25 transition-shadow">
                  See the plans
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" /></svg>
                </a>
                <a href="#quote" class="inline-flex items-center justify-center gap-2 px-6 h-12 rounded-full border border-light-tertiary dark:border-dark-accent text-text-light-primary dark:text-text-dark-primary font-medium hover:border-primary-blue/40 transition-colors">
                  Build your plan
                </a>
              </div>
              <p class="mt-5 text-sm text-text-light-tertiary dark:text-text-dark-tertiary">
                Built for contractors and home services, medical &amp; dental practices, daycares, professional offices, and retailers.
              </p>
            </div>

            <!-- The Brand Brain, shown instead of explained -->
            <div class="rounded-3xl border border-primary-blue/40 ring-1 ring-primary-blue/20 bg-white dark:bg-dark-secondary p-6 sm:p-8 shadow-lg shadow-primary-blue/5">
              <span class="block text-[11px] font-bold uppercase tracking-wide text-primary-blue dark:text-blue-300 mb-1">Powered by your Brand Brain</span>
              <p class="text-sm text-text-light-secondary dark:text-text-dark-secondary mb-5">Your business's private database for its AI agents: one brain, every job.</p>
              <ul class="space-y-3.5">
                <li class="flex items-start gap-3 text-sm text-text-light-secondary dark:text-text-dark-secondary leading-snug">
                  <span class="flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-lg bg-gradient-to-br from-primary-blue/10 to-primary-pink/10 text-primary-blue dark:text-blue-300"><svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129" /></svg></span>
                  <span>Answers customers in whichever language they arrive in</span>
                </li>
                <li class="flex items-start gap-3 text-sm text-text-light-secondary dark:text-text-dark-secondary leading-snug">
                  <span class="flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-lg bg-gradient-to-br from-primary-blue/10 to-primary-pink/10 text-primary-blue dark:text-blue-300"><svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4" /></svg></span>
                  <span>Captures and organizes every lead</span>
                </li>
                <li class="flex items-start gap-3 text-sm text-text-light-secondary dark:text-text-dark-secondary leading-snug">
                  <span class="flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-lg bg-gradient-to-br from-primary-blue/10 to-primary-pink/10 text-primary-blue dark:text-blue-300"><svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" /></svg></span>
                  <span>Writes its own content, in your voice</span>
                </li>
                <li class="flex items-start gap-3 text-sm text-text-light-secondary dark:text-text-dark-secondary leading-snug">
                  <span class="flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-lg bg-gradient-to-br from-primary-blue/10 to-primary-pink/10 text-primary-blue dark:text-blue-300"><svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg></span>
                  <span>Tunes its own speed and SEO</span>
                </li>
                <li class="flex items-start gap-3 text-sm text-text-light-secondary dark:text-text-dark-secondary leading-snug">
                  <span class="flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-lg bg-gradient-to-br from-primary-blue/10 to-primary-pink/10 text-primary-blue dark:text-blue-300"><svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" /></svg></span>
                  <span>Wires into the tools you already use, through APIs and MCP servers, so what it does keeps growing with the business</span>
                </li>
              </ul>
              <p class="mt-5 pt-5 border-t border-light-tertiary dark:border-dark-accent text-sm font-semibold text-text-light-primary dark:text-text-dark-primary">
                Like hiring a staff member who never sleeps, never forgets, and can pick up a new job whenever you need one.
              </p>
            </div>
          </div>
        </Container>
      </div>
    </header>

    <Section id="plans-list" variant="default">
      <Container>
        <!-- The Brand Brain story now lives in the hero panel above. -->
        <PricingPlans />

        {/* AI Team banner — moved into the review's old prime spot right under
            the pricing grid (per Manny): pick a plan, or hire the agents directly. */}
        <div class="mt-14">
        <a href="/ai-team/" class="group block max-w-6xl mx-auto mb-12 rounded-3xl border border-primary-blue/40 ring-1 ring-primary-blue/20 bg-gradient-to-br from-primary-blue/[0.06] via-transparent to-primary-pink/[0.06] p-6 sm:p-8 hover:shadow-[0_16px_50px_rgba(16,209,255,0.18)] transition-all duration-300">
          <div class="flex flex-col lg:flex-row items-center gap-6 lg:gap-8">
            <div class="flex flex-wrap justify-center gap-y-1.5 -space-x-1.5 flex-shrink-0 max-w-[280px] lg:max-w-[264px]">
              {aiTeamRoster.map((a) => (
                <div class="w-9 h-9 sm:w-11 sm:h-11 rounded-full ring-2 ring-primary-blue/40 bg-gradient-to-br from-primary-blue/10 to-primary-pink/10 overflow-hidden" title={`${a.name}: ${a.role}`}>
                  <AgentAvatar agent={a.id} class="w-full h-full" />
                </div>
              ))}
            </div>
            <div class="flex-1 text-center lg:text-left">
              <span class="inline-block bg-gradient-to-r from-primary-blue to-primary-pink text-white text-[11px] font-bold uppercase tracking-wide px-2.5 py-1 rounded-full mb-2">Flagship</span>
              <h2 class="text-xl sm:text-2xl font-bold text-text-light-primary dark:text-text-dark-primary">The AI Team, built for you, run on demand</h2>
              <p class="mt-1.5 text-sm text-text-light-secondary dark:text-text-dark-secondary leading-relaxed max-w-2xl">
                You hire Manny AI, one manager that staffs AI specialists on your business: front desk, daily intel, copy, SEO, engagement, and reporting, with design, video, voice, publishing, and ads sub-agents behind the scenes. A person watches the output. One-time $195 setup.
              </p>
            </div>
            <div class="flex-shrink-0 text-center">
              <div class="text-xs uppercase tracking-wide text-text-light-tertiary dark:text-text-dark-tertiary">AI staff from</div>
              <div class="text-2xl font-black text-text-light-primary dark:text-text-dark-primary leading-none">${aiTeamStartingPrice.toLocaleString('en-US')}<span class="text-sm font-semibold text-text-light-secondary dark:text-text-dark-secondary">/mo</span></div>
              <span class="mt-3 inline-flex items-center justify-center gap-1.5 rounded-xl bg-gradient-to-r from-primary-blue to-primary-pink text-white px-5 py-2.5 text-sm font-semibold transition-all">
                Meet the team
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
              </span>
            </div>
          </div>
        </a>
        </div>
      </Container>
    </Section>

    <!-- Beyond the website: Business Ads & Multimedia — services, not website tiers. -->
    <Section id="why-smart" variant="alternate">
      <Container>
        <SmartWebsiteConcept />
      </Container>
    </Section>

    <Section id="plans-services" variant="default">
      <Container>
        <div class="text-center max-w-2xl mx-auto mb-10">
          <h2 class="sf-bold text-2xl md:text-3xl font-bold">
            <span class="apple-gradient-text" data-colorful-title>Beyond your website</span>
          </h2>
          <p class="mt-3 text-base text-text-light-secondary dark:text-text-dark-secondary leading-relaxed">
            Once your site is working, these bigger engagements grow it: driving the right traffic, or running your whole media &amp; tech operation when you want it all handled. Priced weekly or monthly, and scoped to you.
          </p>
        </div>
        <div class="grid gap-6 md:grid-cols-2 max-w-6xl mx-auto items-stretch">
          {servicePlans.map((p) => (
            <div class="rounded-3xl border border-light-tertiary dark:border-dark-accent bg-white dark:bg-dark-secondary p-6 sm:p-8 flex flex-col">
              <div class="flex items-center gap-3 mb-2">
                <svg class="w-6 h-6 flex-shrink-0 text-primary-blue dark:text-blue-300" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d={p.icon} /></svg>
                <h3 class="text-xl font-bold text-text-light-primary dark:text-text-dark-primary">{p.name}</h3>
              </div>
              <p class="text-sm text-text-light-secondary dark:text-text-dark-secondary leading-relaxed mb-4">{p.tagline}</p>
              <ul class="space-y-2 mb-6 flex-1">
                {p.highlights.slice(0, 4).map((f) => (
                  <li class="flex items-start gap-2 text-sm text-text-light-secondary dark:text-text-dark-secondary leading-snug">
                    <svg class="w-4 h-4 mt-0.5 flex-shrink-0 text-primary-blue dark:text-blue-300" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                    <span>{f}</span>
                  </li>
                ))}
              </ul>
              <div class="flex items-end justify-between gap-3 pt-4 border-t border-light-tertiary dark:border-dark-accent">
                <div class="leading-none">
                  <span class="block text-[11px] font-semibold uppercase tracking-wide text-text-light-tertiary dark:text-text-dark-tertiary">Starting at</span>
                  <span class="text-2xl font-black text-text-light-primary dark:text-text-dark-primary">${p.price.toLocaleString('en-US')}</span><span class="text-sm text-text-light-secondary dark:text-text-dark-secondary">{p.priceUnit ?? '/mo'}</span>
                </div>
                <a href={`/plans/${p.slug}/`} class="flex-shrink-0 inline-flex items-center justify-center gap-1.5 rounded-xl border border-primary-blue/40 text-primary-blue dark:text-blue-300 px-5 py-2.5 text-sm font-semibold hover:bg-primary-blue/5 transition-all duration-300">
                  What's included
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
                </a>
              </div>
            </div>
          ))}
        </div>

      </Container>
    </Section>

    <Section id="plans-faq" variant="default">
      <Container>
        <div class="max-w-3xl mx-auto">
          <Faq faqs={faqs} />

          <div class="text-center mt-12">
            <a href="#contact" class="inline-flex items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-primary-blue to-primary-pink text-white px-6 py-3 text-sm font-semibold transition-all duration-300">
              Build your plan
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
            </a>
          </div>
        </div>
      </Container>
    </Section>

    <DockMenu />
  </main>
</BaseLayout>

<style>
  /* Subtle drift for the flying astronaut. Respects reduced-motion. */
  .astro-float { animation: astro-float 6s ease-in-out infinite; will-change: transform; }
  @keyframes astro-float {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50%      { transform: translateY(-10px) rotate(-1.5deg); }
  }
  @media (prefers-reduced-motion: reduce) {
    .astro-float { animation: none; }
  }
</style>
