<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Appointment Confirmation - MannyKnows</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
      background: #f1f5f9;
      min-height: 100vh;
      color: #1e293b;
    }
    /* Header — matches client portal */
    .header {
      background: #171717;
      padding: 40px 20px;
      text-align: center;
      color: white;
    }
    .header-content { max-width: 600px; margin: 0 auto; }
    .logo { margin-bottom: 8px; }
    .logo-svg { width: 52px; height: auto; }
    /* Container + card — matches client portal (overlaps header) */
    .container {
      max-width: 900px;
      margin: -40px auto 40px;
      padding: 0 20px;
    }
    .card {
      background: #ffffff;
      border-radius: 16px;
      box-shadow: 0 4px 24px rgba(0, 0, 0, 0.1);
      overflow: hidden;
    }
    /* Content */
    .content {
      padding: 40px 30px;
    }
    /* Success Icon */
    .success-icon {
      width: 80px;
      height: 80px;
      background: linear-gradient(135deg, #10b981 0%, #047857 100%);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 24px;
    }
    .success-icon svg {
      width: 40px;
      height: 40px;
      color: white;
    }
    .info-icon {
      background: linear-gradient(135deg, #ff781d 0%, #e05e00 100%);
    }
    .error-icon {
      background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
    }
    /* Confirmation Badge */
    .confirmation-badge {
      display: inline-block;
      background: linear-gradient(135deg, #ff781d 0%, #e05e00 100%);
      color: white;
      padding: 8px 20px;
      border-radius: 20px;
      font-size: 13px;
      font-weight: 600;
      letter-spacing: 1px;
      margin-bottom: 24px;
    }
    /* Title */
    .title {
      font-size: 28px;
      font-weight: 700;
      color: #1e293b;
      text-align: center;
      margin-bottom: 16px;
    }
    .subtitle {
      font-size: 16px;
      color: #475569;
      line-height: 1.7;
      text-align: center;
      margin-bottom: 30px;
    }
    /* Details Card */
    .details-card {
      background: #f8fafc;
      border-radius: 12px;
      padding: 24px;
      margin: 30px 0;
      border: 1px solid #e2e8f0;
    }
    .details-title {
      font-size: 18px;
      font-weight: 700;
      color: #ff781d;
      margin-bottom: 20px;
    }
    .details-table {
      width: 100%;
      border-collapse: collapse;
    }
    .details-table td {
      padding: 12px 0;
      border-bottom: 1px solid #e2e8f0;
      font-size: 14px;
    }
    .details-table tr:last-child td {
      border-bottom: none;
    }
    .details-label {
      color: #64748b;
      width: 120px;
      vertical-align: top;
    }
    .details-value {
      color: #1e293b;
      font-weight: 600;
    }
    /* Next Steps */
    .next-steps {
      margin: 30px 0;
    }
    .next-steps-title {
      font-size: 16px;
      font-weight: 700;
      color: #1e293b;
      margin-bottom: 16px;
    }
    .step {
      display: flex;
      align-items: flex-start;
      gap: 12px;
      margin-bottom: 12px;
    }
    .step-number {
      width: 28px;
      height: 28px;
      min-width: 28px;
      background: linear-gradient(135deg, #ff781d 0%, #e05e00 100%);
      border-radius: 50%;
      color: white;
      font-size: 14px;
      font-weight: 700;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .step-text {
      color: #475569;
      font-size: 14px;
      line-height: 1.6;
      padding-top: 4px;
    }
    /* CTA Button */
    .cta-button {
      display: inline-block;
      background: linear-gradient(135deg, #10b981 0%, #047857 100%);
      color: #ffffff;
      padding: 18px 48px;
      text-decoration: none;
      border-radius: 8px;
      font-weight: 700;
      font-size: 18px;
      letter-spacing: 0.5px;
      margin: 20px 0;
    }
    .cta-button:hover {
      opacity: 0.95;
    }
    .cta-button.blue {
      background: linear-gradient(135deg, #ff781d 0%, #e05e00 100%);
    }
    /* Contact Section */
    .contact-section {
      text-align: center;
      padding: 24px 0;
      border-top: 1px solid #e2e8f0;
      margin-top: 30px;
    }
    .contact-label {
      color: #64748b;
      font-size: 14px;
      margin-bottom: 8px;
    }
    .contact-phone {
      color: #ff781d;
      font-size: 20px;
      font-weight: 700;
      text-decoration: none;
    }
    .contact-phone:hover {
      color: #c75800;
    }
    /* Footer — matches client portal */
    .portal-footer {
      background: #f8fafc;
      border-top: 1px solid #e2e8f0;
      padding: 28px 20px 36px;
      text-align: center;
    }
    .portal-footer-creds { font-size: 12px; color: #64748b; margin-bottom: 10px; }
    .portal-footer-copy { font-size: 13px; color: #475569; line-height: 1.6; margin-bottom: 8px; }
    .portal-footer-legal a { color: #64748b; text-decoration: none; font-size: 13px; margin: 0 8px; }
    .portal-footer-legal a:hover { color: #ff781d; }
    /* Spinner */
    .spinner {
      width: 48px;
      height: 48px;
      border: 4px solid #ff781d;
      border-top-color: transparent;
      border-radius: 50%;
      animation: spin 1s linear infinite;
      margin: 0 auto 16px;
    }
    @keyframes spin { to { transform: rotate(360deg); } }
    .text-center { text-align: center; }
    /* Image Upload Styles */
    .image-upload-section {
      margin: 30px 0;
      padding: 24px;
      background: #f0f9ff;
      border-radius: 12px;
      border: 1px solid #bae6fd;
    }
    .image-upload-title {
      font-size: 16px;
      font-weight: 700;
      color: #0369a1;
      margin: 0 0 8px 0;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .image-upload-desc {
      color: #475569;
      font-size: 14px;
      margin: 0 0 16px 0;
    }
    .upload-dropzone {
      border: 2px dashed #ff781d;
      border-radius: 12px;
      padding: 32px 20px;
      text-align: center;
      background: white;
      cursor: pointer;
      transition: all 0.2s ease;
    }
    .upload-dropzone:hover,
    .upload-dropzone.dragover {
      border-color: #10b981;
      background: #f0fdf4;
    }
    .upload-dropzone.uploading {
      pointer-events: none;
      opacity: 0.7;
    }
    .upload-icon {
      width: 48px;
      height: 48px;
      margin: 0 auto 12px;
      color: #ff781d;
    }
    .upload-text {
      color: #1e293b;
      font-weight: 600;
      margin-bottom: 4px;
    }
    .upload-hint {
      color: #64748b;
      font-size: 13px;
    }
    .upload-input {
      display: none;
    }
    .image-previews {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin-top: 16px;
    }
</style>
<style is:global>
    /* Dynamic elements created by JavaScript need global styles */
    .image-preview {
      position: relative;
      width: 100px !important;
      height: 100px !important;
      border-radius: 8px;
      overflow: hidden;
      border: 2px solid #e2e8f0;
      flex-shrink: 0;
    }
    .image-preview img {
      width: 100% !important;
      height: 100% !important;
      object-fit: cover;
    }
    .image-preview.uploading::after {
      content: '';
      position: absolute;
      inset: 0;
      background: rgba(255,255,255,0.8);
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .image-preview .upload-spinner {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 24px;
      height: 24px;
      border: 3px solid #ff781d;
      border-top-color: transparent;
      border-radius: 50%;
      animation: spin 1s linear infinite;
    }
</style>
<style>
    .upload-status {
      margin-top: 12px;
      padding: 12px;
      border-radius: 8px;
      font-size: 14px;
    }
    .upload-status.success {
      background: #f0fdf4;
      color: #166534;
      border: 1px solid #bbf7d0;
    }
    .upload-status.error {
      background: #fef2f2;
      color: #dc2626;
      border: 1px solid #fecaca;
    }
    .upload-complete-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: #10b981;
      color: white;
      padding: 4px 12px;
      border-radius: 16px;
      font-size: 13px;
      font-weight: 600;
    }
  </style>
</head>
<body>
  <!-- Header — matches client portal -->
  <header class="header">
    <div class="header-content">
      <div class="logo" style="display: flex; align-items: center; justify-content: center; gap: 12px;">
        <svg class="logo-svg" viewBox="0 0 620 240" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="MannyKnows">
          <path d="M0 0H85V226L211 0H290L160 240H0Z" fill="#ff781d"/>
          <path d="M290 0L370 0L456.67 160L619 160L619 240L420 240Z" fill="#ffffff"/>
        </svg>
        <span style="font-size: 22px; font-weight: 700; letter-spacing: -0.3px; color: #ffffff; white-space: nowrap;">MannyKnows</span>
      </div>
    </div>
  </header>

  <div class="container">
    <div class="card">
    <!-- Content -->
    <div class="content">
      {status === 'confirmed' && lead && (
        <>
          <div class="text-center">
            <div class="success-icon">
              <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
              </svg>
            </div>
            <div class="confirmation-badge">CONFIRMATION #{lead.confirmation_code}</div>
            <h1 class="title">Appointment Confirmed!</h1>
            <p class="subtitle">Thank you for confirming! We're looking forward to helping you with your project.</p>
          </div>

          <div class="details-card">
            <h2 class="details-title">Appointment Details</h2>
            <table class="details-table">
              <tr>
                <td class="details-label">Service</td>
                <td class="details-value">{serviceNames[lead.service_type] || lead.service_type}</td>
              </tr>
              <tr>
                <td class="details-label">Date</td>
                <td class="details-value">{lead.preferred_date}</td>
              </tr>
              <tr>
                <td class="details-label">Time</td>
                <td class="details-value">{formatTime(lead.preferred_time)}</td>
              </tr>
              <tr>
                <td class="details-label">Location</td>
                <td class="details-value">
                  {lead.address}
                  {lead.city && `, ${lead.city}`}
                  {lead.state && `, ${lead.state}`}
