          </div>

          <div class="next-steps">
            <h3 class="next-steps-title">What happens next?</h3>
            <div class="step">
              <div class="step-number">1</div>
              <div class="step-text">We've received your confirmation — our team will reach out if anything about the time needs adjusting</div>
            </div>
            <div class="step">
              <div class="step-number">2</div>
              <div class="step-text">You'll receive a reminder 24 hours before your appointment</div>
            </div>
            <div class="step">
              <div class="step-number">3</div>
              <div class="step-text">The estimate is completely free, with no obligation</div>
            </div>
          </div>

          <!-- Image Upload Section -->
          <div class="image-upload-section" id="imageUploadSection">
            <h3 class="image-upload-title">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                <circle cx="8.5" cy="8.5" r="1.5"/>
                <polyline points="21 15 16 10 5 21"/>
              </svg>
              Add Project Photos (Optional)
            </h3>
            <p class="image-upload-desc">Help us prepare for your estimate by uploading photos of the project area. Up to 3 photos.</p>

            <div class="upload-dropzone" id="uploadDropzone">
              <svg class="upload-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                <polyline points="17 8 12 3 7 8"/>
                <line x1="12" y1="3" x2="12" y2="15"/>
              </svg>
              <p class="upload-text">Tap to select photos or drag & drop</p>
              <p class="upload-hint">JPEG, PNG, or HEIC • Max 10MB each</p>
              <input type="file" class="upload-input" id="uploadInput" accept="image/jpeg,image/png,image/webp,image/heic" multiple />
            </div>

            <div class="image-previews" id="imagePreviews"></div>
            <div id="uploadStatus"></div>
          </div>

          <div class="contact-section">
            <p class="contact-label">Need to reschedule?</p>
            <a href="tel:+14133618451" class="contact-phone">(413) 361-8451</a>
          </div>
        </>
      )}

      {(status === 'invalid' || status === 'not_found' || status === 'error' || status === 'cancelled') && (
        <>
          <div class="text-center">
            <div class="success-icon error-icon">
              <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
              </svg>
            </div>
            <h1 class="title">Something Went Wrong</h1>
            <p class="subtitle">{errorMessage}</p>
            <p class="subtitle">If you need to schedule or confirm an appointment, please contact us directly.</p>
          </div>

          <div class="text-center">
            <a href="tel:+14133618451" class="cta-button" style="display: inline-flex; align-items: center; gap: 8px;">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
              </svg>
              Call Us
            </a>
          </div>

          <div class="text-center" style="margin-top: 20px;">
            <a href="/" style="color: #ff781d; font-weight: 500; text-decoration: none;">Return to Homepage</a>
          </div>
        </>
      )}

      {status === 'loading' && (
        <div class="text-center" style="padding: 40px 0;">
          <div class="spinner"></div>
          <p class="subtitle">Confirming your appointment...</p>
        </div>
      )}
    </div>

    </div><!-- /.card -->
  </div><!-- /.container -->

  <!-- Footer — matches client portal.
       NOTE: no credentials line here on purpose — license/cert/warranty claims
       are skipped until Manny provides real data (see CONTENT_TODOS.md). -->
  <footer class="portal-footer">
    <div class="portal-footer-copy">
      &copy; {currentYear} MannyKnows &middot; Springfield, MA &middot; <a href="tel:+14133618451" style="color: inherit;">(413) 361-8451</a>
    </div>
  </footer>

  <script define:vars={{ token, status }}>
    // Image upload handling
    (function() {
      const confirmationToken = token;
      const pageStatus = status;

      // Only run on confirmed pages
      if (pageStatus !== 'confirmed') return;

      const MAX_IMAGES = 3;
      let uploadedCount = 0;

      // Initialize upload handlers for both primary and alt sections
      const sections = [
        { dropzone: 'uploadDropzone', input: 'uploadInput', previews: 'imagePreviews', statusEl: 'uploadStatus' }
      ];

      sections.forEach(ids => {
        const dropzone = document.getElementById(ids.dropzone);
        const input = document.getElementById(ids.input);
        const previews = document.getElementById(ids.previews);
        const statusEl = document.getElementById(ids.statusEl);

        if (!dropzone || !input) return;

        // Click to open file picker
        dropzone.addEventListener('click', () => input.click());

        // Drag events
        dropzone.addEventListener('dragover', (e) => {
          e.preventDefault();
          dropzone.classList.add('dragover');
        });

        dropzone.addEventListener('dragleave', () => {
          dropzone.classList.remove('dragover');
        });

        dropzone.addEventListener('drop', (e) => {
          e.preventDefault();
          dropzone.classList.remove('dragover');
          if (e.dataTransfer?.files) {
            handleFiles(e.dataTransfer.files, previews, statusEl, dropzone);
          }
        });

        // File input change
        input.addEventListener('change', (e) => {
          if (e.target.files) {
            handleFiles(e.target.files, previews, statusEl, dropzone);
          }
        });
      });

      async function handleFiles(files, previewsEl, statusEl, dropzone) {
        const remaining = MAX_IMAGES - uploadedCount;
        if (remaining <= 0) {
          showStatus(statusEl, 'error', 'Maximum 3 images already uploaded');
          return;
        }

        const filesToUpload = Array.from(files).slice(0, remaining);

        for (const file of filesToUpload) {
          // Validate file type
          if (!file.type.startsWith('image/')) {
            showStatus(statusEl, 'error', `${file.name} is not an image`);
            continue;
          }

          // Validate file size (10MB)
          if (file.size > 10 * 1024 * 1024) {
            showStatus(statusEl, 'error', `${file.name} is too large (max 10MB)`);
            continue;
          }

          // Create preview
          const preview = createPreview(file, previewsEl);

          // Upload
          try {
            dropzone.classList.add('uploading');
            const result = await uploadImage(file);

            if (result.success) {
              preview.classList.remove('uploading');
              preview.querySelector('.upload-spinner')?.remove();
              uploadedCount = result.imageCount;
              showStatus(statusEl, 'success', `Photo uploaded! (${result.imageCount}/${MAX_IMAGES})`);

              // Hide dropzone if max reached
              if (result.remainingSlots === 0) {
                dropzone.style.display = 'none';
                showStatus(statusEl, 'success', 'All 3 photos uploaded!');
              }

              // Sync across both sections
              syncUploadState(result.imageCount);
            } else {
              preview.remove();
              showStatus(statusEl, 'error', result.error || 'Upload failed');
            }
          } catch (err) {
            preview.remove();
            showStatus(statusEl, 'error', 'Upload failed. Please try again.');
          } finally {
            dropzone.classList.remove('uploading');
          }
        }
      }

      function createPreview(file, previewsEl) {
        const preview = document.createElement('div');
        preview.className = 'image-preview uploading';

        const img = document.createElement('img');
        img.src = URL.createObjectURL(file);
        preview.appendChild(img);

        const spinner = document.createElement('div');
        spinner.className = 'upload-spinner';
        preview.appendChild(spinner);

        previewsEl.appendChild(preview);
        return preview;
      }

      async function uploadImage(file) {
        const response = await fetch('/api/leads/upload-image/', {
          method: 'POST',
          headers: {
            'Content-Type': file.type,
            'X-Confirmation-Token': confirmationToken
          },
          body: file
        });

        return response.json();
      }

      function showStatus(statusEl, type, message) {
        if (!statusEl) return;
        statusEl.className = 'upload-status ' + type;
        statusEl.textContent = message;
        statusEl.style.display = 'block';

        // Auto-hide success after 5s
        if (type === 'success') {
          setTimeout(() => {
            statusEl.style.display = 'none';
          }, 5000);
        }
      }

      function syncUploadState(count) {
        uploadedCount = count;

        // If max reached, hide both dropzones
        if (count >= MAX_IMAGES) {
          sections.forEach(ids => {
            const dz = document.getElementById(ids.dropzone);
            if (dz) dz.style.display = 'none';
          });
        }
      }
    })();
  </script>
</body>
</html>
