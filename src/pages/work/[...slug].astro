---
// Individual case study — a client or capability project with the full story.
// Data: src/content/portfolio/*.md (schema in src/content.config.ts).
export const prerender = true;

import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import NavBar from '../../components/navigation/NavBar.astro';
import Section from '../../components/layout/Section.astro';
import Container from '../../components/layout/Container.astro';
import DockMenu from '../../components/navigation/DockMenu.astro';
import Button from '../../components/ui/Button.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import QuoteBlock from '../../components/ui/QuoteBlock.astro';
import { getTestimonial } from '../../data/testimonials';

export async function getStaticPaths() {
  const projects = await getCollection('portfolio');
  return projects
    .filter((p) => !p.data.draft)
    .map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const d = project.data;

// Cross-link the other case studies. Without this, a study nothing else happens
// to mention (Springfield en Victoria, say) sits on a single internal link from
// /work — and a visitor who reads one has no path to the next.
// Rotate through the list rather than always showing the newest three, or the
// oldest study would never appear in anyone's module and would keep sitting on a
// single inlink. Walking the ring gives every study the same number of inlinks.
const published = (await getCollection('portfolio'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => (b.data.year ?? 0) - (a.data.year ?? 0) || a.id.localeCompare(b.id));
const at = published.findIndex((p) => p.id === project.id);
const moreWork = [1, 2, 3]
  .map((k) => published[(at + k) % published.length])
  .filter((p) => p && p.id !== project.id);

// This client's own testimonial, if they've given one (undefined otherwise).
const clientQuote = getTestimonial(d.client ?? d.title);

// Responsive screenshots share the homepage pipeline: variants live at
// public/works/<base>-<width>.<ext>. A value containing "/" or "." is treated
// as a literal src/URL instead (e.g. "/works/foo.png" or an external image).
const IMG_WIDTHS = [400, 640, 960, 1280];
const isLiteral = (v: string) => v.includes('/') || v.includes('.');
const srcset = (base: string, ext: 'avif' | 'webp') =>
  IMG_WIDTHS.map((w) => `/works/${base}-${w}.${ext} ${w}w`).join(', ');
const fallbackSrc = (base: string) => `/works/${base}-960.webp`;

const host = (url: string) => url.replace(/^https?:\/\//, '').replace(/\/+$/, '');

// Compact "at a glance" rows — only render the ones that have data.
const facts = [
  d.role && { label: 'What we did', value: d.role },
  d.industry && { label: 'Industry', value: d.industry },
  d.timeline && { label: 'Timeline', value: d.timeline },
  d.year && { label: 'Year', value: String(d.year) },
].filter(Boolean) as { label: string; value: string }[];
---

<BaseLayout
  title={`${d.title}: Case Study | MannyKnows`}
  description={d.seoDescription ?? d.summary}
  image={d.heroImage && isLiteral(d.heroImage) ? d.heroImage : undefined}
>
  {/* one-canvas: one tone for the whole page instead of a different colour
      per section (Manny, Aug 2026). Hue is grouped by pillar — see the
      ONE-TONE CANVAS block in global.css. The per-section .room /
      .chain-* / .glow-* classes below are left in place on purpose:
      delete the two classes on the next line and the page reverts. */}
  <main class="relative bg-light-primary dark:bg-dark-primary text-text-light-primary dark:text-text-dark-primary min-h-screen transition-colors duration-300 one-canvas one-canvas-live">

    <header class="relative bg-gradient-to-t from-gray-50/50 via-gray-100/30 to-gray-50/20 dark:from-gray-900/60 dark:via-slate-800/40 dark:to-gray-900/30 transition-colors duration-300 room-hero">
      <NavBar />
      <Breadcrumb items={[{ label: 'Portfolio', href: '/#work' }, { label: d.title }]} />
      <div class="pb-12 px-4">
        <div class="max-w-[1440px] mx-auto text-center">
          <span class="inline-block bg-gradient-to-r from-primary-blue/10 via-purple-500/10 to-primary-pink/10 text-primary-blue px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider mb-4">Case Study</span>
          <h1 class="sf-bold apple-headline text-4xl md:text-5xl lg:text-6xl mb-6 leading-tight">
            <span class="apple-gradient-text" data-colorful-title>{d.title}</span>
          </h1>
          <p class="max-w-3xl mx-auto text-base sm:text-xl text-text-light-secondary dark:text-text-dark-secondary leading-relaxed">{d.tagline}</p>
          <p class="max-w-3xl mx-auto mt-4 text-base text-text-light-secondary dark:text-text-dark-secondary leading-relaxed mb-8">{d.summary}</p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
            <Button href="#contact" arrow="right">Start a project like this</Button>
            {d.liveUrl && (
              <Button href={d.liveUrl} target="_blank" rel="noopener noreferrer" variant="secondary" arrow="external">Visit live site</Button>
            )}
          </div>
        </div>
      </div>
    </header>

    <Section id="case-study" variant="default" className="room glow-violet">
      <Container>
        <div class="max-w-6xl mx-auto">
          {d.heroImage && (
            <div class="rounded-2xl overflow-hidden border border-light-tertiary dark:border-dark-accent mb-12 aspect-[16/9] shadow-sm">
              {isLiteral(d.heroImage) ? (
                <img src={d.heroImage} alt={`${d.title} website, designed and built by MannyKnows`} width="1280" height="720" loading="eager" decoding="async" class="w-full h-full object-cover" />
              ) : (
                <picture>
                  <source type="image/avif" srcset={srcset(d.heroImage, 'avif')} sizes="(min-width: 1024px) 960px, 92vw" />
                  <source type="image/webp" srcset={srcset(d.heroImage, 'webp')} sizes="(min-width: 1024px) 960px, 92vw" />
                  <img src={fallbackSrc(d.heroImage)} alt={`${d.title} website, designed and built by MannyKnows`} width="1280" height="720" loading="eager" decoding="async" class="w-full h-full object-cover" />
                </picture>
              )}
            </div>
          )}

          <div class="grid lg:grid-cols-[1fr_18rem] gap-10 lg:gap-14 items-start">
            <!-- Narrative + goals + results -->
            <div class="order-2 lg:order-1 min-w-0">
              {d.results.length > 0 && (
                <div class={`grid grid-cols-2 gap-4 mb-12 ${d.results.length >= 3 ? 'sm:grid-cols-3' : 'sm:grid-cols-2'}`}>
                  {d.results.map((r) => (
                    <div class="rounded-2xl border border-light-tertiary dark:border-dark-accent bg-white dark:bg-dark-secondary p-6 text-center">
                      <div class="text-3xl md:text-4xl font-black apple-gradient-text leading-none mb-2">{r.value}</div>
                      <div class="text-xs text-text-light-secondary dark:text-text-dark-secondary uppercase tracking-wider">{r.label}</div>
                    </div>
                  ))}
                </div>
              )}

              {d.goals.length > 0 && (
                <div class="mb-12">
                  <h2 class="text-lg font-bold text-text-light-primary dark:text-text-dark-primary mb-4">Goals</h2>
                  <ul class="space-y-3">
                    {d.goals.map((g) => (
                      <li class="flex items-start gap-3 text-text-light-primary dark:text-text-dark-primary">
                        <svg class="w-5 h-5 text-primary-blue flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4"/></svg>
                        <span class="leading-relaxed">{g}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              )}

              <article class="mk-prose">
                <Content />
              </article>

              {clientQuote && <div class="mt-8"><QuoteBlock quote={clientQuote} /></div>}
            </div>

            <!-- "At a glance" sticky sidebar -->
            <aside class="order-1 lg:order-2 lg:sticky lg:top-24">
              <div class="rounded-2xl border border-light-tertiary dark:border-dark-accent bg-white dark:bg-dark-secondary p-6">
                <div class="grid grid-cols-2 gap-x-6 lg:block">
                  <div>
                    <h2 class="text-xs font-bold uppercase tracking-wider text-text-light-tertiary dark:text-text-dark-tertiary mb-4">At a glance</h2>
                    <dl class="space-y-4">
                      {facts.map((f) => (
                        <div>
                          <dt class="text-xs text-text-light-tertiary dark:text-text-dark-tertiary mb-0.5">{f.label}</dt>
                          <dd class="text-sm font-medium text-text-light-primary dark:text-text-dark-primary">{f.value}</dd>
                        </div>
                      ))}
                    </dl>
                  </div>

                  {d.services.length > 0 && (
                    <div class="mt-5 pt-5 border-t border-light-tertiary dark:border-dark-accent max-lg:mt-0 max-lg:pt-0 max-lg:border-0">
                      <h3 class="text-xs font-bold uppercase tracking-wider text-text-light-tertiary dark:text-text-dark-tertiary mb-2">Delivered:</h3>
                      <ul class="space-y-2">
                        {d.services.map((s) => (
                          <li class="flex items-start gap-2 text-sm text-text-light-primary dark:text-text-dark-primary">
                            <svg class="w-4 h-4 text-green-500 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                            <span>{s}</span>
                          </li>
                        ))}
                      </ul>
                    </div>
                  )}
                </div>

                {d.techStack.length > 0 && (
                  <div class="mt-5 pt-5 border-t border-light-tertiary dark:border-dark-accent">
                    <div class="text-xs text-text-light-tertiary dark:text-text-dark-tertiary mb-2">Tech stack</div>
                    <div class="flex flex-wrap gap-1.5">
                      {d.techStack.map((t) => (
                        <span class="inline-flex items-center rounded-full bg-primary-blue/10 px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wide text-primary-blue dark:text-blue-300">{t}</span>
                      ))}
                    </div>
                  </div>
                )}

                {d.liveUrl && (
                  <a href={d.liveUrl} target="_blank" rel="noopener noreferrer" class="mt-5 pt-5 border-t border-light-tertiary dark:border-dark-accent flex items-center gap-2 text-sm text-primary-blue dark:text-blue-300 font-medium hover:underline">
                    {host(d.liveUrl)}
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H8M17 7v9"/></svg>
                  </a>
                )}
              </div>
            </aside>
          </div>

          {d.gallery.length > 0 && (
            <div class="mt-12 grid gap-6 sm:grid-cols-2">
              {d.gallery.map((g) => (
                <div class="rounded-2xl overflow-hidden border border-light-tertiary dark:border-dark-accent aspect-[16/9]">
                  {isLiteral(g) ? (
                    <img src={g} alt={`${d.title} website screenshot, from the MannyKnows web design portfolio`} loading="lazy" decoding="async" class="w-full h-full object-cover" />
                  ) : (
                    <picture>
                      <source type="image/avif" srcset={srcset(g, 'avif')} sizes="(min-width: 640px) 45vw, 92vw" />
                      <source type="image/webp" srcset={srcset(g, 'webp')} sizes="(min-width: 640px) 45vw, 92vw" />
                      <img src={fallbackSrc(g)} alt={`${d.title} website screenshot, from the MannyKnows web design portfolio`} width="1280" height="720" loading="lazy" decoding="async" class="w-full h-full object-cover" />
                    </picture>
                  )}
                </div>
              ))}
            </div>
          )}

          {moreWork.length > 0 && (
            <div class="mt-12 pt-8 border-t border-light-tertiary dark:border-dark-accent">
              <h2 class="sf-bold text-xl sm:text-2xl font-bold text-text-light-primary dark:text-text-dark-primary mb-5">More work</h2>
              <ul class="grid gap-4 sm:grid-cols-3 list-none p-0 m-0">
                {moreWork.map((w) => (
                  <li>
                    <a
                      href={`/work/${w.id}/`}
                      class="group flex h-full flex-col rounded-2xl border border-light-tertiary dark:border-dark-accent bg-white dark:bg-dark-secondary p-4 no-underline transition-all duration-300 hover:border-primary-blue/40 hover:shadow-xl hover:shadow-primary-blue/10"
                    >
                      <span class="text-sm font-semibold text-text-light-primary dark:text-text-dark-primary group-hover:text-primary-blue dark:group-hover:text-blue-300 transition-colors">{w.data.title}</span>
                      <span class="mt-1.5 text-xs text-text-light-secondary dark:text-text-dark-secondary line-clamp-2">{w.data.tagline}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}

          {/* Credit block — every case study links the person behind the work.
              This is also deliberate internal linking: /about had zero editorial
              inlinks in the July 2026 architecture review. */}
          <aside class="mt-12 rounded-3xl border border-light-tertiary dark:border-dark-accent bg-gradient-to-br from-primary-blue/[0.06] via-transparent to-primary-pink/[0.06] p-6 sm:p-8">
            <p class="text-xs font-bold uppercase tracking-wider text-primary-blue dark:text-blue-300 mb-2">Who did this work</p>
            <p class="text-sm text-text-light-secondary dark:text-text-dark-secondary leading-relaxed">
              This project, like everything in this portfolio, was designed, built, and maintained by Manny, with twenty years of engineering for enterprises and startups applied to a local business. No handoffs, no account manager between you and the person doing the work.
              <a href="/about/" class="text-primary-blue dark:text-blue-300 font-medium hover:underline whitespace-nowrap">Meet who you'd be working with →</a>
            </p>
          </aside>

          <div class="mt-12 pt-8 border-t border-light-tertiary dark:border-dark-accent flex items-center justify-between flex-wrap gap-4">
            <Button href="/#work" variant="ghost" class="gap-2">
              <svg class="w-4 h-4 rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
              Back to portfolio
            </Button>
            <Button href="#contact" arrow="right">Get started</Button>
          </div>
        </div>
      </Container>
    </Section>

    <DockMenu />
  </main>
</BaseLayout>
