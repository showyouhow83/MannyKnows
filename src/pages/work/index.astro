---
// Work index — the portfolio of case studies (src/content/portfolio/*.md).
// Draft entries are hidden; featured pins to the top, then `order` ascending.
export const prerender = true;

import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import NavBar from '../../components/navigation/NavBar.astro';
import Section from '../../components/layout/Section.astro';
import Container from '../../components/layout/Container.astro';
import DockMenu from '../../components/navigation/DockMenu.astro';

const projects = (await getCollection('portfolio'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => (Number(b.data.featured) - Number(a.data.featured)) || (a.data.order - b.data.order));

// Same responsive image pipeline as the detail page / homepage cards.
const WIDTHS = [400, 640, 960, 1280];
const isLiteral = (v: string) => v.includes('/') || v.includes('.');
const srcset = (base: string, ext: 'avif' | 'webp') =>
  WIDTHS.map((w) => `/works/${base}-${w}.${ext} ${w}w`).join(', ');
const CARD_SIZES = '(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 92vw';
const initial = (name: string) => name.trim().charAt(0).toUpperCase();
---

<BaseLayout title="Work — Case Studies | MannyKnows" description="Real projects MannyKnows has designed, built, and shipped for small businesses — the goals, the tech, and the outcome.">
  <main class="relative bg-light-primary dark:bg-dark-primary text-text-light-primary dark:text-text-dark-primary min-h-screen transition-colors duration-300">

    <header class="relative bg-gradient-to-t from-gray-50/50 via-gray-100/30 to-gray-50/20 dark:from-gray-900/60 dark:via-slate-800/40 dark:to-gray-900/30 transition-colors duration-300">
      <NavBar />
      <nav aria-label="breadcrumb" class="max-w-[1440px] mx-auto px-4 lg:px-6 pt-6 pb-4">
        <ol class="flex flex-wrap items-center gap-2 text-sm text-text-light-secondary dark:text-text-dark-secondary">
          <li><a href="/" class="hover:text-primary-blue transition-colors">Home</a></li>
          <li class="flex items-center"><span class="mx-2 text-text-light-tertiary dark:text-text-dark-tertiary">/</span><span class="text-text-light-primary dark:text-text-dark-primary font-medium">Portfolio</span></li>
        </ol>
      </nav>
      <div class="pb-12 px-4">
        <Container>
          <div class="text-center max-w-[1440px] mx-auto">
            <span class="inline-block bg-gradient-to-r from-primary-blue/10 via-purple-500/10 to-primary-pink/10 text-primary-blue px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider mb-4">Case studies</span>
            <h1 class="sf-bold apple-headline text-4xl md:text-5xl lg:text-6xl mb-6">
              <span class="apple-gradient-text" data-colorful-title>Work we've shipped</span>
            </h1>
            <p class="max-w-3xl mx-auto text-base sm:text-xl text-text-light-secondary dark:text-text-dark-secondary leading-relaxed">
              Real projects for real businesses — the goal behind each one, how it was built, and what it changed. Click any project for the full story.
            </p>
          </div>
        </Container>
      </div>
    </header>

    <Section id="work-list" variant="default">
      <Container>
        {projects.length === 0 ? (
          <p class="text-center text-text-light-secondary dark:text-text-dark-secondary">Case studies are on the way — check back soon.</p>
        ) : (
          <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 px-2">
            {projects.map((p) => {
              const d = p.data;
              return (
                <a href={`/work/${p.id}/`} class="group flex flex-col bg-white dark:bg-dark-secondary border border-light-tertiary dark:border-dark-accent rounded-xl overflow-hidden transition-all duration-300 hover:shadow-lg hover:border-primary-blue/30">
                  <div class="aspect-[16/9] overflow-hidden border-b border-light-tertiary dark:border-dark-accent">
                    {d.heroImage ? (
                      isLiteral(d.heroImage) ? (
                        <img src={d.heroImage} alt={d.title} width="1280" height="720" loading="lazy" decoding="async" class="w-full h-full object-cover transition-transform duration-500" />
                      ) : (
                        <picture>
                          <source type="image/avif" srcset={srcset(d.heroImage, 'avif')} sizes={CARD_SIZES} />
                          <source type="image/webp" srcset={srcset(d.heroImage, 'webp')} sizes={CARD_SIZES} />
                          <img src={`/works/${d.heroImage}-960.webp`} alt={d.title} width="1280" height="720" loading="lazy" decoding="async" class="w-full h-full object-cover transition-transform duration-500" />
                        </picture>
                      )
                    ) : (
                      <div class="w-full h-full bg-gradient-to-br from-primary-blue/15 via-purple-500/10 to-primary-pink/15 flex items-center justify-center">
                        <span class="text-3xl font-bold apple-gradient-text">{initial(d.title)}</span>
                      </div>
                    )}
                  </div>
                  <div class="p-5 flex flex-col flex-1">
                    <div class="flex items-center justify-between gap-2">
                      <h2 class="font-semibold text-text-light-primary dark:text-text-dark-primary">{d.title}</h2>
                      <svg class="w-4 h-4 flex-shrink-0 text-text-light-tertiary dark:text-text-dark-tertiary group-hover:text-primary-blue transition-colors" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
                    </div>
                    {d.industry && (
                      <span class="text-[11px] font-medium uppercase tracking-wide text-primary-blue dark:text-blue-300 mt-1">{d.industry}</span>
                    )}
                    <p class="text-sm text-text-light-secondary dark:text-text-dark-secondary mt-3 leading-relaxed flex-1">{d.tagline}</p>
                    {d.services.length > 0 && (
                      <div class="flex flex-wrap gap-1.5 mt-4">
                        {d.services.slice(0, 3).map((t) => (
                          <span class="text-[11px] font-medium text-primary-blue dark:text-blue-300 bg-primary-blue/10 rounded-full px-2 py-0.5">{t}</span>
                        ))}
                      </div>
                    )}
                  </div>
                </a>
              );
            })}
          </div>
        )}
      </Container>
    </Section>

    {/* Everything below exists because the July 2026 architecture review flagged
        this page as thin (241 words) — a page people land on ready to act, with
        nothing to read. Every claim below is pulled from a published case study
        and links to it; don't add a claim here without a case study behind it. */}
    <Section id="work-bones" variant="alternate">
      <Container>
        <div class="max-w-[1440px] mx-auto text-center mb-10">
          <h2 class="sf-bold text-2xl md:text-3xl font-bold">
            <span class="apple-gradient-text" data-colorful-title>The same bones under every build</span>
          </h2>
          <p class="mt-3 max-w-3xl mx-auto text-base text-text-light-secondary dark:text-text-dark-secondary leading-relaxed">
            Five different businesses — a painter, a daycare, a home-services company, an online store, a church. The projects look nothing alike, but they're built on the same principles.
          </p>
        </div>
        <div class="grid gap-6 sm:grid-cols-2 max-w-4xl mx-auto">
          <div class="rounded-2xl border border-light-tertiary dark:border-dark-accent bg-white dark:bg-dark-secondary p-6">
            <h3 class="font-bold text-text-light-primary dark:text-text-dark-primary mb-2">Fast enough to rank</h3>
            <p class="text-sm text-text-light-secondary dark:text-text-dark-secondary leading-relaxed">Speed is a ranking factor and a first impression. <a href="/work/sl-painting/" class="text-primary-blue dark:text-blue-300 hover:underline">SL Painting</a> holds a 100 Lighthouse score — and ranks #1 organically for "Exterior Painting" in Springfield on the back of it.</p>
          </div>
          <div class="rounded-2xl border border-light-tertiary dark:border-dark-accent bg-white dark:bg-dark-secondary p-6">
            <h3 class="font-bold text-text-light-primary dark:text-text-dark-primary mb-2">Answered around the clock</h3>
            <p class="text-sm text-text-light-secondary dark:text-text-dark-secondary leading-relaxed">An agent that answers when the owner can't. <a href="/work/jk-daycare/" class="text-primary-blue dark:text-blue-300 hover:underline">JK Daycare</a> went from kickoff to launch in two weeks — website, AI agent, and a phone IVR, all answering parents' questions from the site's own content.</p>
          </div>
          <div class="rounded-2xl border border-light-tertiary dark:border-dark-accent bg-white dark:bg-dark-secondary p-6">
            <h3 class="font-bold text-text-light-primary dark:text-text-dark-primary mb-2">The whole operation, not just the site</h3>
            <p class="text-sm text-text-light-secondary dark:text-text-dark-secondary leading-relaxed"><a href="/work/vl-home-services/" class="text-primary-blue dark:text-blue-300 hover:underline">VL Home Services</a> ran on referrals and manual everything. Now it's a complete digital operation — projects, crew, and an agent that answers customers in any language, and the team's own questions too.</p>
          </div>
          <div class="rounded-2xl border border-light-tertiary dark:border-dark-accent bg-white dark:bg-dark-secondary p-6">
            <h3 class="font-bold text-text-light-primary dark:text-text-dark-primary mb-2">Built for where the business is going</h3>
            <p class="text-sm text-text-light-secondary dark:text-text-dark-secondary leading-relaxed"><a href="/work/cherry-vibes/" class="text-primary-blue dark:text-blue-300 hover:underline">Cherry Vibes</a> moved from the Costa Rican market to the U.S. on a custom Shopify Hydrogen storefront. <a href="/work/springfield-en-victoria/" class="text-primary-blue dark:text-blue-300 hover:underline">Springfield en Victoria</a> reaches its congregation in several languages, with live streaming for the people who can't be in the room.</p>
          </div>
        </div>
      </Container>
    </Section>

    <Section id="work-honesty" variant="default">
      <Container>
        <div class="max-w-3xl mx-auto">
          <div class="rounded-2xl border border-light-tertiary dark:border-dark-accent border-l-[3px] border-l-primary-pink bg-white dark:bg-dark-secondary p-6 sm:p-8">
            <h2 class="text-lg font-bold text-text-light-primary dark:text-text-dark-primary mb-3">How these case studies are written</h2>
            <p class="text-sm text-text-light-secondary dark:text-text-dark-secondary leading-relaxed mb-3">
              Every number here is real. Where a project has a measurable result — a ranking, a launch date, a Lighthouse score — you'll see it. Where it doesn't, we describe what was built instead of inventing a percentage. No case study is published until the client's story is confirmed in their own words, and nothing in this portfolio is borrowed from work that isn't ours to show.
            </p>
            <p class="text-sm text-text-light-secondary dark:text-text-dark-secondary leading-relaxed">
              All of it was designed, built, and maintained by Manny — twenty years of engineering for enterprises and startups, applied to local businesses. One person, a direct line, no account manager. <a href="/about/" class="font-semibold text-primary-blue dark:text-blue-300 hover:underline">Meet who you'd be working with →</a>
            </p>
          </div>
          <div class="text-center mt-12">
            <p class="text-base text-text-light-secondary dark:text-text-dark-secondary mb-5">Want to know what a project like yours would look like?</p>
            <div class="flex flex-wrap items-center justify-center gap-4">
              <a href="/contact/" data-contact-context="Portfolio — start a project" class="inline-flex items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-primary-blue to-primary-pink text-white px-6 py-3 text-sm font-semibold transition-all duration-300">Tell us what you do</a>
              <a href="/free-ai-website-analysis/" class="inline-flex items-center justify-center gap-2 rounded-xl border border-primary-blue/40 text-primary-blue dark:text-blue-300 px-6 py-3 text-sm font-semibold hover:bg-primary-blue/5 transition-all duration-300">Get a free look at your current site</a>
            </div>
          </div>
        </div>
      </Container>
    </Section>

    <DockMenu />
  </main>
</BaseLayout>
