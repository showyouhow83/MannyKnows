---
// Per-plan detail pages (/plans/<slug>) — driven by src/data/plans.ts so the
// cards and detail pages never drift apart. Prerendered, one page per plan.
export const prerender = true;

import BaseLayout from '../../layouts/BaseLayout.astro';
import NavBar from '../../components/navigation/NavBar.astro';
import DockMenu from '../../components/navigation/DockMenu.astro';
import Section from '../../components/layout/Section.astro';
import Container from '../../components/layout/Container.astro';
import Faq from '../../components/ui/Faq.astro';
import { plans, yearlyTotal, yearlyMonthly, type Plan } from '../../data/plans';
import { BOOKING_URL } from '../../data/booking';
import { getTestimonial } from '../../data/testimonials';
import QuoteBlock from '../../components/ui/QuoteBlock.astro';
import Illustration from '../../components/illustrations/Illustration.astro';
import StepCards from '../../components/ui/StepCards.astro';
import SmartWebsiteConcept from '../../components/sections/SmartWebsiteConcept.astro';

// Sell Online lives on its own page (/ecommerce) — selling products is a
// different decision from getting found, so it isn't one of the website tiers.
// Its old /plans/sell-online URL 301s there from astro.config.mjs.
export function getStaticPaths() {
  return plans
    .filter((p) => p.slug !== 'sell-online')
    .map((p) => ({ params: { slug: p.slug }, props: { plan: p } }));
}

const { plan } = Astro.props as { plan: Plan };

// The self-improving concept applies to the website plans — not to the ads or
// agency retainers, which aren't websites.
const isWebsitePlan = ['get-found', 'get-booked', 'get-growing', 'get-ahead'].includes(plan.slug);
const others = plans.filter((p) => p.slug !== plan.slug);
const planHref = (slug: string) => (slug === 'sell-online' ? '/ecommerce/' : `/plans/${slug}/`);

const planIll: Record<string, 'website' | 'store' | 'ads' | 'multimedia'> = {
  'get-growing': 'website',
  'sell-online': 'store',
  'business-ads': 'ads',
  'multimedia-agency': 'multimedia',
};

// Proof map — the testimonial (if one exists) and the case studies that prove
// this plan. Honest: only clients who actually gave a quote get one shown.
// Cases without a quote show "See it working:" only — they demonstrate the
// capability, they do not claim that client is on this tier. Get Found stays
// bare on purpose: no published client is on the 1–3 page starter, and
// borrowing a bigger build to sell it would overstate what the plan is.
const proofMap: Record<string, { quote?: string; cases: { slug: string; name: string }[] }> = {
  'get-booked': { cases: [{ slug: 'jk-daycare', name: 'JK Daycare' }] },
  'get-growing': { quote: 'SL Painting', cases: [{ slug: 'sl-painting', name: 'SL Painting' }, { slug: 'vl-home-services', name: 'VL Home Services' }] },
  'get-ahead': { cases: [{ slug: 'sl-painting', name: 'SL Painting' }] },
  'sell-online': { quote: 'Cherry Vibes', cases: [{ slug: 'cherry-vibes', name: 'Cherry Vibes' }] },
  'business-ads': { quote: 'SL Painting', cases: [{ slug: 'sl-painting', name: 'SL Painting' }] },
  'multimedia-agency': { quote: 'VL Home Services', cases: [{ slug: 'vl-home-services', name: 'VL Home Services' }, { slug: 'sl-painting', name: 'SL Painting' }] },
};
const proof = proofMap[plan.slug];
const proofQuote = proof?.quote ? getTestimonial(proof.quote) : undefined;

---

<BaseLayout
  title={plan.metaTitle ?? `${plan.name} Plan: from $${plan.price.toLocaleString('en-US')}/mo | MannyKnows`}
  description={plan.tiers
    ? `${plan.tagline} ${plan.tiers.map((t) => `${t.name} $${t.price.toLocaleString('en-US')}${t.unit}`).join(' · ')}. Cancel anytime.`
    : `${plan.tagline} $${plan.price.toLocaleString('en-US')}/mo, or $${yearlyTotal(plan).toLocaleString('en-US')}/yr, 2 months free. Cancel anytime.`}
>
  <main class="relative bg-light-primary dark:bg-dark-primary text-text-light-primary dark:text-text-dark-primary min-h-screen transition-colors duration-300">

    <header class="relative bg-gradient-to-t from-gray-50/50 via-gray-100/30 to-gray-50/20 dark:from-gray-900/60 dark:via-slate-800/40 dark:to-gray-900/30 transition-colors duration-300">
      <NavBar />
      <nav aria-label="breadcrumb" class="max-w-[1440px] mx-auto px-4 lg:px-6 pt-6 pb-4">
        <ol class="flex flex-wrap items-center gap-2 text-sm text-text-light-secondary dark:text-text-dark-secondary">
          <li><a href="/" class="hover:text-primary-blue transition-colors">Home</a></li>
          <li class="flex items-center"><span class="mx-2 text-text-light-tertiary dark:text-text-dark-tertiary">/</span><a href="/plans/" class="hover:text-primary-blue transition-colors">Plans</a></li>
          <li class="flex items-center"><span class="mx-2 text-text-light-tertiary dark:text-text-dark-tertiary">/</span><span class="text-text-light-primary dark:text-text-dark-primary font-medium">{plan.name}</span></li>
        </ol>
      </nav>
      <div class="pb-12">
        <Container>
          <div class="max-w-[1440px] mx-auto text-center">
            {plan.heroMascot ? (
              /* Photo mascot wins over the generic line illustration. Eager (top of
                 the page) with width/height declared, so it reserves its box and
                 never shifts the H1 — same treatment as /services and /ecommerce. */
              <div class="flex justify-center mb-6">
                <img
                  src={plan.heroMascot.src}
                  alt=""
                  aria-hidden="true"
                  width={plan.heroMascot.width}
                  height={plan.heroMascot.height}
                  decoding="async"
                  class="astro-float w-full max-w-[190px] h-auto pointer-events-none"
                />
              </div>
            ) : planIll[plan.slug] ? (
              <div class="flex justify-center mb-6">
                <Illustration kind={planIll[plan.slug]} class="w-full max-w-[210px]" />
              </div>
            ) : null}
            <span class="inline-block bg-gradient-to-r from-primary-blue/10 via-purple-500/10 to-primary-pink/10 text-primary-blue px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider mb-4">
              <svg class="inline-block w-4 h-4 align-[-0.2em] mr-1" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d={plan.icon} /></svg>{plan.name}
            </span>
            <h1 class="sf-bold apple-headline text-4xl md:text-5xl lg:text-6xl mb-6">
              <span class="apple-gradient-text" data-colorful-title>{plan.headline}</span>
            </h1>
            <p class="max-w-3xl mx-auto text-base sm:text-xl text-text-light-secondary dark:text-text-dark-secondary leading-relaxed">{plan.blurb}</p>
            {plan.blurb.includes('*') && (
              <p class="mt-3 max-w-3xl mx-auto text-xs text-text-light-tertiary dark:text-text-dark-tertiary">*Logo via our Envato Elements license, used as-is or reworked with AI.</p>
            )}

            <!-- Price block — sub-plan tiers when the plan has them, month-to-month/yearly otherwise -->
            {plan.tiers ? (
              <div class="mt-8 inline-flex flex-col sm:flex-row items-stretch gap-3 text-center">
                {plan.tiers.map((t) => (
                  <div class={`rounded-2xl bg-white dark:bg-dark-secondary px-6 py-4 ${t.featured ? 'border border-primary-blue/40 ring-1 ring-primary-blue/20' : 'border border-light-tertiary dark:border-dark-accent'}`}>
                    <span class={`block text-[11px] font-semibold uppercase tracking-wide ${t.featured ? 'text-primary-blue dark:text-blue-300' : 'text-text-light-tertiary dark:text-text-dark-tertiary'}`}>{t.name}</span>
                    <span class="text-3xl font-black">${t.price.toLocaleString('en-US')}</span><span class="text-sm text-text-light-secondary dark:text-text-dark-secondary">{t.unit}</span>
                    <span class="block text-xs text-text-light-tertiary dark:text-text-dark-tertiary mt-1">{t.note}</span>
                  </div>
                ))}
              </div>
            ) : (
              <div class="mt-8 inline-flex flex-col sm:flex-row items-stretch gap-3 text-center">
                <div class="rounded-2xl border border-light-tertiary dark:border-dark-accent bg-white dark:bg-dark-secondary px-6 py-4">
                  <span class="block text-[11px] font-semibold uppercase tracking-wide text-text-light-tertiary dark:text-text-dark-tertiary">Month-to-month</span>
                  <span class="text-3xl font-black">${plan.price.toLocaleString('en-US')}</span><span class="text-sm text-text-light-secondary dark:text-text-dark-secondary">/mo</span>
                  <span class="block text-xs text-text-light-tertiary dark:text-text-dark-tertiary mt-1">starting at · cancel anytime</span>
                </div>
                <div class="rounded-2xl border border-primary-blue/40 ring-1 ring-primary-blue/20 bg-white dark:bg-dark-secondary px-6 py-4">
                  <span class="block text-[11px] font-semibold uppercase tracking-wide text-primary-blue dark:text-blue-300">Yearly · 2 months free</span>
                  <span class="text-3xl font-black">${yearlyMonthly(plan).toLocaleString('en-US')}</span><span class="text-sm text-text-light-secondary dark:text-text-dark-secondary">/mo</span>
                  <span class="block text-xs text-text-light-tertiary dark:text-text-dark-tertiary mt-1">billed as one payment of ${yearlyTotal(plan).toLocaleString('en-US')}/yr</span>
                </div>
              </div>
            )}

            <p class="mt-6 text-sm text-text-light-secondary dark:text-text-dark-secondary">
              <strong class="text-text-light-primary dark:text-text-dark-primary">Built for:</strong> {plan.whoFor}
            </p>

            <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
              <a href="#contact" data-contact-context={`${plan.name} plan`} class="inline-flex items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-primary-blue to-primary-pink text-white px-8 py-3.5 text-sm font-semibold transition-all duration-300">
                {plan.ctaLabel ?? `Get started with ${plan.name}`}
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
              </a>
              <a href="/#work" class="inline-flex items-center justify-center gap-2 rounded-xl border border-primary-blue/40 text-primary-blue dark:text-blue-300 px-6 py-3.5 text-sm font-semibold hover:bg-primary-blue/5 transition-all duration-300">
                {plan.portfolioLabel ?? 'See it in our portfolio'}
              </a>
              {!plan.hideBooking && (
                <a href={BOOKING_URL} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 rounded-xl border border-primary-blue/40 text-primary-blue dark:text-blue-300 px-6 py-3.5 text-sm font-semibold hover:bg-primary-blue/5 transition-all duration-300">
                  Book a call
                </a>
              )}
            </div>
            <p class="mt-3 text-xs text-text-light-tertiary dark:text-text-dark-tertiary">{plan.terms ?? 'Month-to-month · cancel anytime · your domain and content stay yours'}</p>
          </div>
        </Container>
      </div>
    </header>

    <!-- Sub-plan tiers (e.g. Business Ads: per-network vs full coverage) -->
    {plan.tiers && (
      <Section id="plan-tiers" variant="default">
        <Container>
          <h2 class="sf-bold text-2xl md:text-3xl font-bold text-center mb-4">
            <span class="apple-gradient-text" data-colorful-title>{plan.tiersHeading ?? 'Pick your plan'}</span>
          </h2>
          {plan.tiersIntro && (
            <p class="text-center text-base text-text-light-secondary dark:text-text-dark-secondary max-w-2xl mx-auto mb-12">
              {plan.tiersIntro}
            </p>
          )}
          <div class="grid gap-6 md:grid-cols-2 max-w-6xl mx-auto items-stretch">
            {plan.tiers.map((t) => (
              <div class={`rounded-3xl bg-white dark:bg-dark-secondary p-6 sm:p-8 flex flex-col ${t.featured ? 'border border-primary-blue/40 ring-1 ring-primary-blue/20' : 'border border-light-tertiary dark:border-dark-accent'}`}>
                {t.featured && (
                  <span class="self-start inline-block bg-gradient-to-r from-primary-blue to-primary-pink text-white text-[11px] font-bold uppercase tracking-wide px-2.5 py-1 rounded-full mb-3">Best value</span>
                )}
                <h3 class="text-xl font-bold text-text-light-primary dark:text-text-dark-primary">{t.name}</h3>
                <div class="mt-2 mb-3">
                  <span class="text-3xl font-black text-text-light-primary dark:text-text-dark-primary">${t.price.toLocaleString('en-US')}</span><span class="text-sm text-text-light-secondary dark:text-text-dark-secondary">{t.unit}</span>
                  <span class="block text-xs text-text-light-tertiary dark:text-text-dark-tertiary mt-1">{t.note}</span>
                </div>
                <p class="text-sm text-text-light-secondary dark:text-text-dark-secondary leading-relaxed mb-4">{t.description}</p>
                {t.builtOn && (
                  <p class="text-xs font-semibold uppercase tracking-wide text-primary-blue dark:text-blue-300 mb-2">{t.builtOn}:</p>
                )}
                <ul class="space-y-2.5 flex-1">
                  {t.features.map((f) => (
                    <li class="flex items-start gap-2 text-sm text-text-light-secondary dark:text-text-dark-secondary leading-snug">
                      <svg class="w-4 h-4 mt-0.5 flex-shrink-0 text-primary-blue dark:text-blue-300" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                      </svg>
                      <span>{f}</span>
                    </li>
                  ))}
                </ul>
                <a
                  href="#contact"
                  data-contact-context={`${plan.name}: ${t.name}`}
                  class={`mt-6 inline-flex items-center justify-center gap-2 rounded-xl px-6 py-3 text-sm font-semibold transition-all duration-300 ${t.featured ? 'bg-gradient-to-r from-primary-blue to-primary-pink text-white' : 'border border-primary-blue/40 text-primary-blue dark:text-blue-300 hover:bg-primary-blue/5'}`}
                >
                  Start with {t.name}
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
                </a>
              </div>
            ))}
          </div>
        </Container>
      </Section>
    )}

    <!-- What's included -->
    <Section id="plan-included" variant="default">
      <Container>
        <h2 class="sf-bold text-2xl md:text-3xl font-bold text-center mb-12">
          <span class="apple-gradient-text" data-colorful-title>Everything included</span>
        </h2>
        <div class="grid gap-6 md:grid-cols-2 max-w-6xl mx-auto">
          {plan.deliverables.map((d) => (
            <div class="rounded-2xl border border-light-tertiary dark:border-dark-accent bg-white dark:bg-dark-secondary p-6">
              <h3 class="text-lg font-bold text-text-light-primary dark:text-text-dark-primary mb-3">{d.title}</h3>
              <ul class="space-y-2.5">
                {d.items.map((item) => (
                  <li class="flex items-start gap-2 text-sm text-text-light-secondary dark:text-text-dark-secondary leading-snug">
                    <svg class="w-4 h-4 mt-0.5 flex-shrink-0 text-primary-blue dark:text-blue-300" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
        <p class="mt-8 text-center text-sm text-text-light-secondary dark:text-text-dark-secondary max-w-2xl mx-auto">
          Plus what every plan includes: your own admin, multilingual as standard, SSL and caching on a global edge network, a domain if you need one, and unlimited storage, bandwidth, content updates, and stock photos, video &amp; logos.
          <a href="/plans/#included" class="text-primary-blue dark:text-blue-300 font-medium hover:underline whitespace-nowrap">See the full list →</a>
        </p>
      </Container>
    </Section>

    <!-- Why a self-improving site beats a normal one (website plans only) -->
    {isWebsitePlan && (
      <Section id="plan-concept" variant="alternate">
        <Container>
          <SmartWebsiteConcept compact={true} />
          <p class="text-center mt-10">
            <a href="/plans/#why-smart" class="inline-flex items-center gap-1.5 text-sm font-semibold text-primary-blue dark:text-blue-300 hover:underline">
              Compare all the plans
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
            </a>
          </p>
        </Container>
      </Section>
    )}

    <!-- Proof — testimonial (if any) + the case studies that show this plan working -->
    {proof && (
      <Section id="plan-proof" variant="default">
        <Container>
          <div class="max-w-3xl mx-auto">
            {proofQuote && <QuoteBlock quote={proofQuote} />}
            <div class={`flex flex-wrap items-center justify-center gap-3 ${proofQuote ? 'mt-6' : ''}`}>
              <span class="text-sm text-text-light-secondary dark:text-text-dark-secondary">See it working:</span>
              {proof.cases.map((c) => (
                <a href={`/work/${c.slug}/`} class="inline-flex items-center gap-1.5 rounded-full border border-primary-blue/40 text-primary-blue dark:text-blue-300 px-4 py-1.5 text-sm font-medium hover:bg-primary-blue/5 transition-all">
                  {c.name}
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
                </a>
              ))}
            </div>
          </div>
        </Container>
      </Section>
    )}

    <!-- How it works -->
    <Section id="plan-steps" variant="alternate">
      <Container>
        <h2 class="sf-bold text-2xl md:text-3xl font-bold text-center mb-12">
          <span class="apple-gradient-text" data-colorful-title>How it works</span>
        </h2>
        <StepCards steps={plan.steps} class="max-w-6xl mx-auto" />
      </Container>
    </Section>

    <!-- FAQ -->
    <Section id="plan-faq" variant="default">
      <Container>
        <div class="max-w-3xl mx-auto">
          <Faq faqs={plan.faq} />
          <div class="text-center mt-12">
            <a href="#contact" data-contact-context={`${plan.name} plan`} class="inline-flex items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-primary-blue to-primary-pink text-white px-6 py-3 text-sm font-semibold transition-all duration-300">
              Talk to us about {plan.name}
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
            </a>
          </div>
        </div>
      </Container>
    </Section>

    <!-- Other plans -->
    <Section id="plan-others" variant="alternate">
      <Container>
        <h2 class="text-lg font-bold text-center mb-8 text-text-light-primary dark:text-text-dark-primary">Not the right fit? The other plans:</h2>
        <div class="grid gap-4 sm:grid-cols-3 max-w-6xl mx-auto">
          {others.map((p) => (
            <a href={planHref(p.slug)} class="rounded-2xl border border-light-tertiary dark:border-dark-accent bg-white dark:bg-dark-secondary p-5 hover:border-primary-blue/40 hover:shadow-lg transition-all duration-300">
              <svg class="w-6 h-6 text-primary-blue dark:text-blue-300" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d={p.icon} /></svg>
              <h3 class="font-bold text-text-light-primary dark:text-text-dark-primary mt-2">{p.name}</h3>
              <p class="text-xs text-text-light-tertiary dark:text-text-dark-tertiary mt-1">from ${p.price.toLocaleString('en-US')}{p.priceUnit ?? '/mo'}</p>
              <p class="text-sm text-text-light-secondary dark:text-text-dark-secondary mt-2 leading-snug">{p.tagline}</p>
            </a>
          ))}
        </div>
      </Container>
    </Section>

    <DockMenu />
  </main>
</BaseLayout>

<style>
  /* Matches the /services, /ecommerce and /free-360-photo heroes: a slow drift,
     off for reduced-motion users. */
  .astro-float { animation: astro-float 6s ease-in-out infinite; will-change: transform; }
  @keyframes astro-float {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50%      { transform: translateY(-10px) rotate(-1.5deg); }
  }
  @media (prefers-reduced-motion: reduce) { .astro-float { animation: none; } }
</style>
