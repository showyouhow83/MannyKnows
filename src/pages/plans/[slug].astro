---
// Per-plan detail pages (/plans/<slug>) — driven by src/data/plans.ts so the
// cards and detail pages never drift apart. Prerendered, one page per plan.
export const prerender = true;

import BaseLayout from '../../layouts/BaseLayout.astro';
import NavBar from '../../components/navigation/NavBar.astro';
import DockMenu from '../../components/navigation/DockMenu.astro';
import Section from '../../components/layout/Section.astro';
import Container from '../../components/layout/Container.astro';
import Faq from '../../components/ui/Faq.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import Button from '../../components/ui/Button.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import { plans, yearlyTotal, yearlyMonthly, type Plan } from '../../data/plans';
import { BOOKING_URL } from '../../data/booking';
import { getTestimonial } from '../../data/testimonials';
import QuoteBlock from '../../components/ui/QuoteBlock.astro';
import Illustration from '../../components/illustrations/Illustration.astro';
import StepCards from '../../components/ui/StepCards.astro';
import SmartWebsiteConcept from '../../components/sections/SmartWebsiteConcept.astro';
import PricingCards from '../../components/pricing/PricingCards.astro';
import { serviceTierCards } from '../../lib/pricingCards';

// Sell Online lives on its own page (/ecommerce) — selling products is a
// different decision from getting found, so it isn't one of the website tiers.
// Its old /plans/sell-online URL 301s there from astro.config.mjs.
export function getStaticPaths() {
  return plans
    .filter((p) => p.slug !== 'sell-online')
    .map((p) => ({ params: { slug: p.slug }, props: { plan: p } }));
}

const { plan } = Astro.props as { plan: Plan };

// The self-improving concept applies to the website plans — not to the ads or
// agency retainers, which aren't websites.
const isWebsitePlan = ['get-found', 'get-booked', 'get-growing', 'get-ahead'].includes(plan.slug);
const others = plans.filter((p) => p.slug !== plan.slug);
const planHref = (slug: string) => (slug === 'sell-online' ? '/ecommerce/' : `/plans/${slug}/`);

const planIll: Record<string, 'website' | 'store' | 'ads' | 'multimedia'> = {
  'get-growing': 'website',
  'sell-online': 'store',
  'business-ads': 'ads',
  'multimedia-agency': 'multimedia',
};

// Proof map — the testimonial (if one exists) and the case studies that prove
// this plan. Honest: only clients who actually gave a quote get one shown.
// Cases without a quote show "See it working:" only — they demonstrate the
// capability, they do not claim that client is on this tier. Get Found stays
// bare on purpose: no published client is on the 1–3 page starter, and
// borrowing a bigger build to sell it would overstate what the plan is.
const proofMap: Record<string, { quote?: string; cases: { slug: string; name: string }[] }> = {
  'get-booked': { cases: [{ slug: 'jk-daycare', name: 'JK Daycare' }] },
  'get-growing': { quote: 'SL Painting', cases: [{ slug: 'sl-painting', name: 'SL Painting' }, { slug: 'vl-home-services', name: 'VL Home Improvement Services' }] },
  'get-ahead': { cases: [{ slug: 'sl-painting', name: 'SL Painting' }] },
  'sell-online': { quote: 'Cherry Vibes', cases: [{ slug: 'cherry-vibes', name: 'Cherry Vibes' }] },
  'business-ads': { quote: 'SL Painting', cases: [{ slug: 'sl-painting', name: 'SL Painting' }] },
  'multimedia-agency': { quote: 'VL Home Improvement Services', cases: [{ slug: 'vl-home-services', name: 'VL Home Improvement Services' }, { slug: 'sl-painting', name: 'SL Painting' }] },
};
const proof = proofMap[plan.slug];
const proofQuote = proof?.quote ? getTestimonial(proof.quote) : undefined;

// Sub-plan tiers on the SHARED pricing grid (Manny, Aug 2026): the same
// PricingCards anatomy as /plans, /ecommerce, /apps and /local-seo, so every
// pricing card on the site reads identically. These services front no build
// and publish no yearly rate, so billing='none' — one price, its own unit.
const tierCards = serviceTierCards(plan.slug);

// Mentions of Manny (the human) link to /about/ (Manny, Aug 2026). Word-bound
// so "MannyKnows" and "Manny AI" never match — those aren't the person.
const linkManny = (s: string) =>
  s.replace(
    /\bManny\b(?!\s*AI\b)/g,
    '<a href="/about/" class="text-primary-blue dark:text-blue-300 font-medium hover:underline">Manny</a>'
  );
const mentionsManny = (s: string) => /\bManny\b(?!\s*AI\b)/.test(s);
// FAQ answers that name Manny get the link; the Faq component renders those
// with set:html and strips the tags back out of the FAQPage schema.
const planFaqs = plan.faq.map((f) =>
  mentionsManny(f.a) ? { ...f, a: linkManny(f.a), html: true } : f
);

// Meta description: tagline + the price pair, and the yearly-waiver note only
// while the whole line stays inside the 160-char SERP budget.
const usd = (n: number) => n.toLocaleString('en-US');
const metaDescription = (() => {
  if (plan.tiers) {
    return `${plan.tagline} ${plan.tiers.map((t) => `${t.name} $${usd(t.price)}${t.unit}`).join(' · ')}. No term.`;
  }
  const base = `${plan.tagline} $${usd(plan.setupFee ?? 0)} setup + $${usd(plan.price)}/mo.`;
  const waiver = ' Prepay the year, setup waived.';
  return base.length + waiver.length <= 160 ? base + waiver : base;
})();
---

<BaseLayout
  title={plan.metaTitle ?? `${plan.name} Plan: from $${plan.price.toLocaleString('en-US')}/mo | MannyKnows`}
  description={metaDescription}
>
  {/* one-canvas: one tone for the whole page instead of a different colour
      per section (Manny, Aug 2026). Hue is grouped by pillar — see the
      ONE-TONE CANVAS block in global.css. The per-section .room /
      .chain-* / .glow-* classes below are left in place on purpose:
      delete the two classes on the next line and the page reverts. */}
  <main class="relative bg-light-primary dark:bg-dark-primary text-text-light-primary dark:text-text-dark-primary min-h-screen transition-colors duration-300 one-canvas one-canvas-live">

    <header class="relative bg-gradient-to-t from-gray-50/50 via-gray-100/30 to-gray-50/20 dark:from-gray-900/60 dark:via-slate-800/40 dark:to-gray-900/30 transition-colors duration-300 room-hero">
      <NavBar />
      <Breadcrumb items={[{ label: 'Plans', href: '/plans/' }, { label: plan.name }]} />
      <div class="pb-12">
        <Container>
          <div class="max-w-[1440px] mx-auto text-center">
            {plan.heroMascot ? (
              /* Photo mascot wins over the generic line illustration. Eager (top of
                 the page) with width/height declared, so it reserves its box and
                 never shifts the H1 — same treatment as /services and /ecommerce. */
              <div class="flex justify-center mb-6">
                <img
                  src={plan.heroMascot.src}
                  alt={`Astronaut mascot for the ${plan.name} plan`}
                  aria-hidden="true"
                  width={plan.heroMascot.width}
                  height={plan.heroMascot.height}
                  decoding="async"
                  class="astro-float w-auto h-[220px] pointer-events-none"
                />
              </div>
            ) : planIll[plan.slug] ? (
              <div class="flex justify-center mb-6">
                <Illustration kind={planIll[plan.slug]} class="w-full max-w-[210px]" />
              </div>
            ) : null}
            <span class="inline-block bg-gradient-to-r from-primary-blue/10 via-purple-500/10 to-primary-pink/10 text-primary-blue px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider mb-4">
              <svg class="inline-block w-4 h-4 align-[-0.2em] mr-1" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d={plan.icon} /></svg>{plan.name}
            </span>
            <h1 class="sf-bold apple-headline text-4xl md:text-5xl lg:text-6xl mb-6">
              <span class="apple-gradient-text" data-colorful-title>{plan.headline}</span>
            </h1>
            <p class="max-w-3xl mx-auto text-base sm:text-xl text-text-light-secondary dark:text-text-dark-secondary leading-relaxed" set:html={linkManny(plan.blurb)}></p>
            {plan.blurb.includes('*') && (
              <p class="mt-3 max-w-3xl mx-auto text-xs text-text-light-tertiary dark:text-text-dark-tertiary">*Logo via our Envato Elements license, used as-is or reworked with AI.</p>
            )}

            <!-- Price block — sub-plan tiers when the plan has them, otherwise
                 the monthly (+ setup fee) and yearly (setup waived) pair -->
            {plan.tiers ? (
              <div class="mt-8 inline-flex flex-col sm:flex-row items-stretch gap-3 text-center">
                {plan.tiers.map((t) => (
                  <div class={`rounded-2xl bg-white dark:bg-dark-secondary px-6 py-4 ${t.featured ? 'border border-primary-blue/40 ring-1 ring-primary-blue/20' : 'border border-light-tertiary dark:border-dark-accent'}`}>
                    <span class={`block text-[11px] font-bold uppercase tracking-wider ${t.featured ? 'text-primary-blue dark:text-blue-300' : 'text-text-light-tertiary dark:text-text-dark-tertiary'}`}>{t.name}</span>
                    <span class="text-3xl font-black">${t.price.toLocaleString('en-US')}</span><span class="text-sm text-text-light-secondary dark:text-text-dark-secondary">{t.unit}</span>
                    <span class="block text-xs text-text-light-tertiary dark:text-text-dark-tertiary mt-1">{t.note}</span>
                  </div>
                ))}
              </div>
            ) : (
              <div class="mt-8 inline-flex flex-col sm:flex-row items-stretch gap-3 text-center">
                <div class="rounded-2xl border border-light-tertiary dark:border-dark-accent bg-white dark:bg-dark-secondary px-6 py-4">
                  <span class="block text-[11px] font-bold uppercase tracking-wider text-text-light-tertiary dark:text-text-dark-tertiary">Month to month</span>
                  <span class="text-3xl font-black">${plan.price.toLocaleString('en-US')}</span><span class="text-sm text-text-light-secondary dark:text-text-dark-secondary">/mo</span>
                  <span class="block text-xs text-text-light-tertiary dark:text-text-dark-tertiary mt-1">starting at · cancel anytime</span>
                  {plan.setupFee && <span class="block text-xs font-semibold text-text-light-secondary dark:text-text-dark-secondary mt-1">plus ${plan.setupFee.toLocaleString('en-US')} one-time setup</span>}
                </div>
                <div class="rounded-2xl border border-primary-blue/40 ring-1 ring-primary-blue/20 bg-white dark:bg-dark-secondary px-6 py-4">
                  <span class="block text-[11px] font-bold uppercase tracking-wider text-primary-blue dark:text-blue-300">Yearly · build free</span>
                  <span class="text-3xl font-black">${yearlyMonthly(plan).toLocaleString('en-US')}</span><span class="text-sm text-text-light-secondary dark:text-text-dark-secondary">/mo</span>
                  <span class="block text-xs text-text-light-tertiary dark:text-text-dark-tertiary mt-1">billed as one payment of ${yearlyTotal(plan).toLocaleString('en-US')}/yr</span>
                  {plan.setupFee && <span class="block text-xs font-semibold text-green-700 dark:text-green-400 mt-1">2 months free, setup fee waived</span>}
                </div>
              </div>
            )}

            <p class="mt-6 text-sm text-text-light-secondary dark:text-text-dark-secondary">
              <strong class="text-text-light-primary dark:text-text-dark-primary">Built for:</strong> {plan.whoFor}
            </p>

            <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
              <Button href="#contact" data-contact-context={`${plan.name} plan`} arrow="right">{plan.ctaLabel ?? `Get started with ${plan.name}`}</Button>
              <Button href="/#work" variant="secondary">{plan.portfolioLabel ?? 'See it in our portfolio'}</Button>
              {!plan.hideBooking && (
                <Button href={BOOKING_URL} target="_blank" rel="noopener noreferrer" variant="secondary">Book a call</Button>
              )}
            </div>
            <p class="mt-3 text-xs text-text-light-tertiary dark:text-text-dark-tertiary">{plan.terms ?? 'No term · cancel anytime · your domain and content stay yours'}</p>
          </div>
        </Container>
      </div>
    </header>

    <!-- Sub-plan tiers (e.g. Business Ads: per-network vs full coverage) on
         the shared pricing grid, so pricing cards read the same sitewide. -->
    {tierCards && (
      <Section id="plan-tiers" variant="default" className="room chain-violet-blue">
        <Container>
          <SectionHeader title={plan.tiersHeading ?? 'Pick your plan'} subtitle={plan.tiersIntro} />
          <PricingCards id={`${plan.slug}-tiers`} cards={tierCards} billing="none" featuredLabel="Best value" />
        </Container>
      </Section>
    )}

    <!-- What's included -->
    <Section id="plan-included" variant="default" className="room glow-blue">
      <Container>
        <SectionHeader title="Everything included" />
        <div class="grid gap-6 md:grid-cols-2 max-w-6xl mx-auto">
          {plan.deliverables.map((d) => (
            <div class="rounded-2xl border border-light-tertiary dark:border-dark-accent bg-white dark:bg-dark-secondary p-6">
              <h3 class="text-lg font-bold text-text-light-primary dark:text-text-dark-primary mb-3">{d.title}</h3>
              <ul class="space-y-2.5">
                {d.items.map((item) => (
                  <li class="flex items-start gap-2 text-sm text-text-light-secondary dark:text-text-dark-secondary leading-snug">
                    <svg class="w-4 h-4 mt-0.5 flex-shrink-0 text-primary-blue dark:text-blue-300" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                    <span set:html={linkManny(item)}></span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
        {isWebsitePlan && (
          <p class="mt-8 text-center text-sm text-text-light-secondary dark:text-text-dark-secondary max-w-2xl mx-auto">
            Plus what every website plan includes: your own admin, multilingual as standard, SSL and caching on a global edge network, a domain if you need one, and unlimited storage, bandwidth, and stock photos, video &amp; logos.
            <a href="/plans/#included" class="text-primary-blue dark:text-blue-300 font-medium hover:underline whitespace-nowrap">See the full list →</a>
          </p>
        )}
      </Container>
    </Section>

    <!-- Why a self-improving site beats a normal one (website plans only) -->
    {isWebsitePlan && (
      <Section id="plan-concept" variant="alternate" className="room glow-violet">
        <Container>
          <SmartWebsiteConcept compact={true} />
          <p class="text-center mt-10">
            <Button href="/plans/#pricingPlans" variant="ghost" arrow="right">Compare all the plans</Button>
          </p>
        </Container>
      </Section>
    )}

    <!-- Proof — testimonial (if any) + the case studies that show this plan working -->
    {proof && (
      <Section id="plan-proof" variant="default" className="room glow-violet">
        <Container>
          <div class="max-w-3xl mx-auto">
            {proofQuote && <QuoteBlock quote={proofQuote} />}
            <div class={`flex flex-wrap items-center justify-center gap-3 ${proofQuote ? 'mt-6' : ''}`}>
              <span class="text-sm text-text-light-secondary dark:text-text-dark-secondary">See it working:</span>
              {proof.cases.map((c) => (
                <Button href={`/work/${c.slug}/`} variant="secondary" size="sm" arrow="right">{c.name}</Button>
              ))}
            </div>
          </div>
        </Container>
      </Section>
    )}

    <!-- How it works -->
    <Section id="plan-steps" variant="alternate" className="room glow-blue">
      <Container>
        <SectionHeader title="How it works" />
        <StepCards steps={plan.steps} class="max-w-6xl mx-auto" />
      </Container>
    </Section>

    <!-- FAQ -->
    <Section id="plan-faq" variant="default" className="room glow-violet">
      <Container>
        <div class="max-w-6xl mx-auto">
          <Faq faqs={planFaqs} />
          <div class="text-center mt-12">
            <Button href="#contact" data-contact-context={`${plan.name} plan`} arrow="right">Talk to us about {plan.name}</Button>
          </div>
        </div>
      </Container>
    </Section>

    <!-- Other plans -->
    <Section id="plan-others" variant="alternate" className="room glow-violet">
      <Container>
        <SectionHeader title="Not the right fit? The other plans" />
        <div class="grid gap-4 sm:grid-cols-3 max-w-6xl mx-auto">
          {others.map((p) => (
            <a href={planHref(p.slug)} class="rounded-2xl border border-light-tertiary dark:border-dark-accent bg-white dark:bg-dark-secondary p-6 transition-all duration-300 hover:border-primary-blue/40 hover:shadow-xl hover:shadow-primary-blue/10">
              <div class="flex items-center gap-3">
                <span class="flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-lg bg-gradient-to-br from-primary-blue/10 to-primary-pink/10 text-primary-blue dark:text-blue-300"><svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d={p.icon} /></svg></span>
                <h3 class="text-lg font-bold text-text-light-primary dark:text-text-dark-primary leading-snug">{p.name}</h3>
              </div>
              <p class="text-xs text-text-light-tertiary dark:text-text-dark-tertiary mt-1">from ${p.price.toLocaleString('en-US')}{p.priceUnit ?? '/mo'}</p>
              <p class="text-sm text-text-light-secondary dark:text-text-dark-secondary mt-2 leading-snug">{p.tagline}</p>
            </a>
          ))}
        </div>
      </Container>
    </Section>

    <DockMenu />
  </main>
</BaseLayout>

<style>
  /* Matches the /services, /ecommerce and /free-360-photo heroes: a slow drift,
     off for reduced-motion users. */
  .astro-float { animation: astro-float 6s ease-in-out infinite; will-change: transform; }
  @keyframes astro-float {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50%      { transform: translateY(-10px) rotate(-1.5deg); }
  }
  @media (prefers-reduced-motion: reduce) { .astro-float { animation: none; } }
</style>
