---
// /pricing — every service on one page, each with the SAME PricingCards grid
// its product page renders (Manny, Aug 2026: "I prefer to see the pricing
// cards we have on each service page"). Grids come from src/lib/pricingCards.ts,
// the shared builders the product pages import, so the menu can't drift from
// the pages. Simple centred hero (the /contact shape), billing rules as FAQs.
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import NavBar from '../components/navigation/NavBar.astro';
import Section from '../components/layout/Section.astro';
import Container from '../components/layout/Container.astro';
import DockMenu from '../components/navigation/DockMenu.astro';
import Breadcrumb from '../components/ui/Breadcrumb.astro';
import Button from '../components/ui/Button.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import Faq from '../components/ui/Faq.astro';
import PricingCards from '../components/pricing/PricingCards.astro';
import { plans, websitePlans } from '../data/plans';
import { remiCustom, remiSetupFee } from '../data/remi';
import { aiTeamSetupFee } from '../data/aiTeam';
import AiTeamBanner from '../components/sections/AiTeamBanner.astro';
import { ONDEMAND, PLAN_CLIENT_ON_THE_MAP } from '../data/localSeo';
import { APPS_HOURLY } from '../data/apps';
import {
  websitePlanCards,
  storeCards,
  remiCards,
  localSeoCards,
  appTierCards,
  serviceTierCards,
} from '../lib/pricingCards';

const siteUrl = 'https://mannyknows.com';
const usd = (n: number) => `$${n.toLocaleString('en-US')}`;
const getFound = websitePlans[0];
const ads = plans.find((p) => p.slug === 'business-ads')!;
const agency = plans.find((p) => p.slug === 'multimedia-agency')!;

// One section per product, in the order we sell them. `billing` and
// `featuredLabel` mirror the product page exactly.
const sections = [
  {
    id: 'websites',
    title: 'Websites, built and run for you',
    subtitle: 'AI-powered sites with Remi AI answering customers, hosting, SEO, and upkeep included. Practices first, every appointment business after.',
    cards: websitePlanCards(),
    billing: 'monthly' as const,
    featuredLabel: 'Most popular',
    href: '/plans/',
    linkLabel: 'Compare the plans in full',
  },
  {
    id: 'stores',
    title: 'Online stores',
    subtitle: 'A Shopify store designed, stocked, and run for you. The Shopify subscription itself is billed by Shopify, in your name.',
    cards: storeCards(),
    billing: 'monthly' as const,
    featuredLabel: 'Most popular',
    href: '/ecommerce/',
    linkLabel: 'Compare the store plans in full',
  },
  {
    id: 'remi',
    title: 'Remi AI, the AI booking agent',
    subtitle: 'One agent, sold on its own. Each tier unlocks more of the admin; booking arrives at Pro. No website yet? Lite includes a one-page site we build, on the same subscription.',
    cards: remiCards(),
    billing: 'monthly' as const,
    featuredLabel: 'Most popular',
    href: '/ai-booking-agent/',
    linkLabel: 'See what each tier unlocks',
  },
  {
    // The AI Agents Team publishes ONE price — Remi AI, the agent that is a
    // product on its own. Everything else is scoped and quoted on the free
    // diagnostic (Manny: "no per-agent price tags"), so this section renders a
    // panel, not a grid, and /pricing says the same thing /ai-team says.
    id: 'ai-team',
    title: 'The AI Agents Team',
    subtitle: 'Manny AI is the manager. You define the work; it adds as many AI agents as each workflow needs and runs them for you. Priced by the workflow, never by the head count.',
    cards: [] as ReturnType<typeof remiCards>,
    billing: 'none' as const,
    featuredLabel: '',
    href: '/ai-team/',
    linkLabel: 'Meet Manny AI and the team',
  },
  {
    id: 'seo',
    title: 'Local SEO packages',
    subtitle: 'For the website you already have. Your Google profile, monthly 360° photos, reviews, content, and AI-search work.',
    cards: localSeoCards(),
    billing: 'none' as const,
    featuredLabel: 'Best value',
    href: '/local-seo/',
    linkLabel: 'See the SEO packages in full',
  },
  {
    id: 'apps',
    title: 'Business apps',
    subtitle: 'Scripts, integrations, MCP servers, and full business apps for how you run, quoted up front.',
    cards: appTierCards(),
    billing: 'none' as const,
    featuredLabel: 'Most popular',
    href: '/apps/',
    linkLabel: 'See the app tiers in full',
  },
  {
    id: 'ads',
    title: ads.name,
    subtitle: 'Social, Google & social ads, and SEO campaigns, one network at a time. You fund the ad spend; it is never marked up.',
    cards: serviceTierCards('business-ads')!,
    billing: 'none' as const,
    featuredLabel: 'Best value',
    href: '/plans/business-ads/',
    linkLabel: 'See Business Ads in full',
  },
  {
    id: 'agency',
    title: agency.name,
    subtitle: 'Hire Manny by the week. Development, design, SEO, photo, and video, with AI multiplying the output.',
    cards: serviceTierCards('multimedia-agency')!,
    billing: 'none' as const,
    featuredLabel: 'Best value',
    href: '/plans/multimedia-agency/',
    linkLabel: 'See the agency retainer in full',
  },
];

// How the AI Agents Team is priced — by the workflow (Manny, Aug 16 2026):
// a workflow is one business process, defined with you, staffed by however
// many agents it needs. No per-agent price tags anywhere.
const AI_TEAM_HOW = [
  { title: 'A workflow is the unit', body: 'One business process, defined with you on the free diagnostic: what comes in, what the agents do, who approves, what goes out. Publish a week of content, answer and qualify leads, turn every job into a case study, keep the profile alive.', icon: 'M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4' },
  { title: 'Manny AI staffs it', body: 'The manager adds as many specialists as the workflow needs and runs them, so the same process runs every time, faster and with fewer errors than a hand-off between people and tools. Add a workflow any time; the team grows with it.', icon: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z' },
  { title: 'Priced per workflow', body: `The monthly is quoted per workflow after the diagnostic, so you pay for what runs for you, not for a roster. One-time ${usd(aiTeamSetupFee)} setup to build and train the first workflow, waived on a prepaid year. Normal AI usage is included.`, icon: 'M9 14l6-6m-5.5.5h.01m4.99 5h.01M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16l3.5-2 3.5 2 3.5-2 3.5 2z' },
];

const FREE = [
  { name: 'Free AI Website Analysis', body: 'Send your site, get a scored report on speed, SEO, mobile, conversion, and AI-readiness, emailed to you.', href: '/free-ai-website-analysis/', icon: 'M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z' },
  { name: 'Free 360° photo', body: 'We come to your business, shoot one professional 360° photo, and publish it to your Google Business Profile.', href: '/local-seo/#free-360-photo', icon: 'M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z M15 13a3 3 0 11-6 0 3 3 0 016 0z' },
];

// The billing rules, as questions (Manny: the panel "needs to be made into FAQs").
const FAQS = [
  { q: 'Is there a contract?', a: 'No. Everything monthly is month-to-month with no minimum term and no exit charge. Yearly is optional, prepaid, and waives the setup fee. One-time builds are quoted up front and paid as scoped.' },
  { q: 'What is the setup fee, and when is it waived?', a: `Website and store plans charge a one-time setup fee for the build on month-to-month billing (Get Found starts at ${usd(getFound.setupFee!)}). Prepay a year at 10× the monthly, so two months are free, and the setup fee is waived in full. Remi AI, the One-Page Website, and the AI Agents Team carry a ${usd(remiSetupFee)} setup on the same rule. SEO packages, Business Ads, and the agency retainer have no setup fee of ours.` },
  { q: 'What does "no minimum term" mean?', a: 'Month-to-month means exactly that. Cancel anytime, with nothing further owed for the build or anything else. Your domain, your content, and the leads captured for you stay yours; Remi AI and the other agents are service software that run on our side and stop with the plan.' },
  { q: 'Can I change my mind after we start?', a: 'Website and store plans carry a 5-business-day refund window from kickoff, on both billing modes, refunding everything paid including the setup fee. After that window, setup fees and prepaid years are non-refundable.' },
  { q: 'Can I switch plans later?', a: 'Yes, any time, in either direction, including between a website plan and a store plan. Moving up costs the difference between the new setup fee and the one you already paid, floored at $0, so moving down or sideways is free. A waived yearly setup counts as $0 paid. The formula is published in the terms.' },
  { q: 'What is not included in these prices?', a: 'Ad spend on Business Ads and Get Ahead (it goes straight to the platform and is never marked up), the Shopify subscription on store plans (billed by Shopify in your name), and third-party costs like a domain you register yourself. Everything else on a card is in the price.' },
  { q: 'Which one should I start with?', a: 'If you have a website that is not bringing customers, run the free AI Website Analysis and start where it points. If you have no site, the One-Page Website or Get Found. If the phone is the bottleneck, Remi AI on the site you already have. If you are not sure, send a message and we will tell you which single thing to do first.' },
];

// OfferCatalog structured data, computed from the same cards (never typed by hand).
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'OfferCatalog',
  '@id': `${siteUrl}/pricing/#catalog`,
  name: 'MannyKnows services and pricing',
  url: `${siteUrl}/pricing/`,
  provider: { '@id': `${siteUrl}/#business` },
  itemListElement: sections.map((s) => ({
    '@type': 'OfferCatalog',
    name: s.title,
    url: `${siteUrl}${s.href}`,
    itemListElement: s.cards.map((c) => ({
      '@type': 'Offer',
      name: c.name,
      description: c.tagline,
      url: `${siteUrl}${s.href}`,
      priceCurrency: 'USD',
      price: c.price,
      ...(s.billing === 'monthly' || (c.priceUnit ?? '').includes('/mo')
        ? { priceSpecification: { '@type': 'UnitPriceSpecification', price: c.price, priceCurrency: 'USD', unitText: 'month' } }
        : (c.priceUnit ?? '').includes('/wk')
          ? { priceSpecification: { '@type': 'UnitPriceSpecification', price: c.price, priceCurrency: 'USD', unitText: 'week' } }
          : {}),
    })),
  })),
};

const META_TITLE = 'Pricing: Websites, AI Agents, SEO & Apps | MannyKnows';
const META_DESCRIPTION = `Every MannyKnows service on one page with what it costs: website plans from ${usd(getFound.price)}/mo, stores, Remi AI, the AI Agents Team, SEO packages, apps, ads, and the agency retainer.`;
---

<BaseLayout title={META_TITLE} description={META_DESCRIPTION}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <main class="relative bg-light-primary dark:bg-dark-primary text-text-light-primary dark:text-text-dark-primary min-h-screen transition-colors duration-300 one-canvas one-canvas-live">

    <header class="relative bg-gradient-to-t from-gray-50/50 via-gray-100/30 to-gray-50/20 dark:from-gray-900/60 dark:via-slate-800/40 dark:to-gray-900/30 transition-colors duration-300 room-hero">
      <NavBar />
      <Breadcrumb items={[{ label: 'Pricing' }]} />
      <div class="pb-12 px-4">
        <div class="max-w-[1440px] mx-auto text-center">
          <span class="inline-block bg-gradient-to-r from-primary-blue/10 via-purple-500/10 to-primary-pink/10 text-primary-blue px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider mb-4">Pricing</span>
          <h1 class="sf-bold apple-headline text-4xl md:text-5xl lg:text-6xl mb-6">
            <span class="apple-gradient-text" data-colorful-title>Everything we do, and what it costs</span>
          </h1>
          <p class="max-w-3xl mx-auto text-base sm:text-xl text-text-light-secondary dark:text-text-dark-secondary leading-relaxed">
            The whole menu on one page. Websites we build and run, online stores, Remi AI, the AI Agents Team, SEO packages, business apps, ads, and the agency retainer, each with the same cards you will find on its own page. The numbers are the numbers.
          </p>
        </div>
      </div>
    </header>

    {sections.map((s, i) => (
      <Section id={s.id} variant={i % 2 === 0 ? 'default' : 'alternate'} className={`room ${i % 2 === 0 ? 'chain-violet-blue' : 'chain-blue-violet'} scroll-mt-24`}>
        <Container>
          <SectionHeader title={s.title} subtitle={s.subtitle} />
          {s.cards.length > 0 && (
            <PricingCards id={`pricing-${s.id}`} cards={s.cards} billing={s.billing} featuredLabel={s.featuredLabel} />
          )}

          {s.id === 'ai-team' && (
            <>
              <AiTeamBanner />
              <div class="max-w-6xl mx-auto mt-8 grid gap-6 md:grid-cols-3">
                {AI_TEAM_HOW.map((h) => (
                  <div class="rounded-2xl border border-light-tertiary dark:border-dark-accent bg-white dark:bg-dark-secondary p-6">
                    <div class="flex items-center gap-3">
                      <div class="flex h-11 w-11 flex-shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-primary-blue to-primary-pink text-white shadow-lg shadow-primary-blue/20">
                        <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d={h.icon} /></svg>
                      </div>
                      <h3 class="text-lg font-bold text-text-light-primary dark:text-text-dark-primary leading-snug">{h.title}</h3>
                    </div>
                    <p class="mt-3 text-sm text-text-light-secondary dark:text-text-dark-secondary leading-relaxed">{h.body}</p>
                  </div>
                ))}
              </div>
            </>
          )}

          {s.id === 'remi' && (
            <div class="max-w-6xl mx-auto mt-8 rounded-3xl border border-primary-blue/40 ring-1 ring-primary-blue/20 bg-white dark:bg-dark-secondary p-6 sm:p-8 shadow-lg shadow-primary-blue/5 flex flex-col md:flex-row md:items-center gap-4 md:gap-8">
              <div class="flex-1">
                <div class="flex items-center gap-3">
                  <div class="flex h-11 w-11 flex-shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-primary-blue to-primary-pink text-white shadow-lg shadow-primary-blue/20">
                    <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
                  </div>
                  <h3 class="text-lg font-bold text-text-light-primary dark:text-text-dark-primary leading-snug">{remiCustom.name}</h3>
                </div>
                <p class="mt-3 text-sm text-text-light-secondary dark:text-text-dark-secondary leading-relaxed">{remiCustom.points.join('. ')}.</p>
              </div>
              <div class="flex-shrink-0 md:text-right">
                <div class="text-2xl font-black text-text-light-primary dark:text-text-dark-primary leading-none">{remiCustom.priceLabel}</div>
                <div class="text-xs text-text-light-tertiary dark:text-text-dark-tertiary mt-1 max-w-[16rem]">{remiCustom.priceNote}</div>
              </div>
            </div>
          )}

          {s.id === 'remi' && (
            <p class="mt-6 text-center text-sm text-text-light-secondary dark:text-text-dark-secondary">No website yet? Remi AI Lite includes a fast one-page site we design and host, so the agent has somewhere to live. Same {usd(remiSetupFee)} setup, same monthly. <a href="/ai-website/" class="text-primary-blue dark:text-blue-300 font-medium hover:underline">See the One-Page Website</a>.</p>
          )}

          {s.id === 'seo' && (
            <div class="max-w-6xl mx-auto mt-8">
              <p class="text-xs font-bold uppercase tracking-wider text-text-light-tertiary dark:text-text-dark-tertiary mb-4 text-center">One-time SEO services</p>
              <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
                {ONDEMAND.map((o) => (
                  <a href="#quote" data-quote-context={o.service} class="group rounded-2xl border border-light-tertiary dark:border-dark-accent bg-white dark:bg-dark-secondary p-6 transition-all duration-300 hover:border-primary-blue/40 hover:shadow-xl hover:shadow-primary-blue/10">
                    <h3 class="text-lg font-bold text-text-light-primary dark:text-text-dark-primary leading-snug group-hover:text-primary-blue dark:group-hover:text-blue-300 transition-colors">{o.name}</h3>
                    <div class="mt-2 text-2xl font-black text-text-light-primary dark:text-text-dark-primary">{o.exact ? '' : 'from '}{usd(o.min)}<span class="text-sm font-medium text-text-light-secondary dark:text-text-dark-secondary"> one-time</span></div>
                    <p class="mt-2 text-sm text-text-light-secondary dark:text-text-dark-secondary leading-relaxed">{o.body}</p>
                  </a>
                ))}
              </div>
              <p class="mt-6 text-center text-sm text-text-light-secondary dark:text-text-dark-secondary">Website-plan clients add On the Map for {usd(PLAN_CLIENT_ON_THE_MAP)}/mo, since their plan already covers the digital half.</p>
            </div>
          )}

          {s.id === 'apps' && (
            <p class="mt-6 text-center text-sm text-text-light-secondary dark:text-text-dark-secondary">Every build is quoted up front at a flat ${APPS_HOURLY}/hr, so the total is known before we start.</p>
          )}


          <div class="text-center mt-10">
            <Button href={s.href} variant="secondary" arrow="right">{s.linkLabel}</Button>
          </div>
        </Container>
      </Section>
    ))}

    <!-- Free to start -->
    <Section id="free" variant={sections.length % 2 === 0 ? 'default' : 'alternate'} className="room glow-blue">
      <Container>
        <SectionHeader title="Free to start" subtitle="Two things we do at no cost, and how we introduce our work." />
        <div class="max-w-6xl mx-auto grid gap-6 md:grid-cols-2">
          {FREE.map((f) => (
            <a href={f.href} class="group rounded-2xl border border-light-tertiary dark:border-dark-accent bg-white dark:bg-dark-secondary p-6 transition-all duration-300 hover:border-primary-blue/40 hover:shadow-xl hover:shadow-primary-blue/10">
              <div class="flex items-center gap-3">
                <div class="flex h-11 w-11 flex-shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-primary-blue to-primary-pink text-white shadow-lg shadow-primary-blue/20">
                  <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d={f.icon} /></svg>
                </div>
                <h3 class="text-lg font-bold text-text-light-primary dark:text-text-dark-primary leading-snug group-hover:text-primary-blue dark:group-hover:text-blue-300 transition-colors">{f.name}</h3>
                <span class="ml-auto inline-block bg-gradient-to-r from-primary-blue/10 via-purple-500/10 to-primary-pink/10 text-primary-blue dark:text-blue-300 px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider">Free</span>
              </div>
              <p class="mt-3 text-sm text-text-light-secondary dark:text-text-dark-secondary leading-relaxed">{f.body}</p>
            </a>
          ))}
        </div>
      </Container>
    </Section>

    <Section id="pricing-faq" variant="default" className="room glow-violet">
      <Container>
        <Faq faqs={FAQS} />
        <div class="text-center mt-12">
          <Button href="#contact" data-contact-context="Pricing page" arrow="right">Ask which one fits</Button>
        </div>
      </Container>
    </Section>

    <DockMenu />
  </main>
</BaseLayout>
