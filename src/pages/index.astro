				<img src="/mascot/astro-360-peek.webp" alt="" width="598" height="880" loading="lazy" decoding="async" />
			</div>
			<GoogleProfile />
		</PageSection>

		<!-- Business Apps — the fourth hero pillar ("AI Agents, Websites, SEO
		     & Apps"), a compact promo for /apps/. Tiers and prices mirror the
		     page's TIERS data (apps.astro). -->
		<PageSection
			id="apps"
			badge="Business Apps"
			title="Apps for how your <br />business runs"
			subtitle="Custom business apps and workflow automation for Western Mass small businesses: scripts that automate the busywork, integrations that connect the tools you already use, and complete systems for booking, quoting, and dashboards. Quoted up front; you own all of it."
			variant="alternate"
		>
			<div class="max-w-6xl mx-auto">
				<!-- Bento grid (Manny's pick, Aug 2026: the layout he liked
				     from the Websites options, filled with Apps content).
				     Stacks to one column on phones, story tile first.
				     No prices on the homepage — tiers live on /apps/. -->
				<div class="grid gap-5 md:grid-cols-4">
					<div class="md:col-span-2 md:row-span-2 rounded-3xl border border-primary-blue/40 ring-1 ring-primary-blue/20 bg-white dark:bg-dark-secondary p-8 flex flex-col justify-center">
						<h3 class="text-xl sm:text-2xl font-bold text-text-light-primary dark:text-text-dark-primary mb-4">Disconnected and connected apps</h3>
						<p class="text-sm sm:text-base text-text-light-secondary dark:text-text-dark-secondary leading-relaxed mb-4">Some jobs need a standalone tool. Some need your website, inbox, CRM, calendar, and phone talking to each other so data stops being re-typed. We build both.</p>
						<p class="text-sm font-semibold text-text-light-primary dark:text-text-dark-primary">The fastest way to get hours back is to stop doing the work a machine can do.</p>
					</div>
					<div class="rounded-3xl border border-light-tertiary dark:border-dark-accent bg-white dark:bg-dark-secondary p-6">
						<div class="text-2xl font-black apple-gradient-text mb-1" data-colorful-title>Scripts</div>
						<p class="text-sm text-text-light-secondary dark:text-text-dark-secondary">Apps Script tools: spreadsheets that become quoting tools, reports that send themselves.</p>
					</div>
					<div class="rounded-3xl border border-light-tertiary dark:border-dark-accent bg-white dark:bg-dark-secondary p-6">
						<div class="text-2xl font-black apple-gradient-text mb-1" data-colorful-title>Wired</div>
						<p class="text-sm text-text-light-secondary dark:text-text-dark-secondary">APIs, webhooks, Twilio phone &amp; SMS, Make &amp; Zapier: your tools connected, end to end.</p>
					</div>
					<div class="rounded-3xl border border-light-tertiary dark:border-dark-accent bg-white dark:bg-dark-secondary p-6">
						<div class="text-2xl font-black apple-gradient-text mb-1" data-colorful-title>MCP</div>
						<p class="text-sm text-text-light-secondary dark:text-text-dark-secondary">Your AI plugged into your calendar, CRM, and inventory: it works with them, not just talks.</p>
					</div>
					<div class="rounded-3xl border border-light-tertiary dark:border-dark-accent bg-white dark:bg-dark-secondary p-6">
						<div class="text-2xl font-black apple-gradient-text mb-1" data-colorful-title>Yours</div>
						<p class="text-sm text-text-light-secondary dark:text-text-dark-secondary">Quoted up front: the code, the flows, and the accounts are yours. Co-own option for big ideas.</p>
					</div>
				</div>
				<div class="text-center mt-10">
					<a href="/apps/" class="inline-flex items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-primary-blue to-primary-pink text-white px-8 py-3.5 text-sm font-semibold transition-all duration-300">
						Explore Business Apps
						<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
					</a>
					<p class="mt-4 text-xs text-text-light-tertiary dark:text-text-dark-tertiary">Most projects live in 2–4 weeks · you own everything we build</p>
				</div>
			</div>
		</PageSection>

		<!-- Who you're working with — condensed founder intro, routes to /about -->
		<PageSection
			id="about"
			badge="Your solutions partner"
			title="Who you're working with"
			variant="hero"
		>
			<!-- Same blue nebula as /about's header. warm = buffered during idle
			     time after load, so it plays instantly on scroll without ever
			     competing with the page's own assets. -->
			<HeroVideoBackground slot="background" name="hero-blue" tone="color" warm />
			<HomeAbout />
		</PageSection>

		<!-- Testimonials — driven by src/data/testimonials.ts (real quotes only);
		     renders nothing if that list is ever emptied.
		     (Replaces the retired ReviewsSection carousel.) -->
		<PageSection
			id="work"
			badge="Portfolio"
			title="Our web design portfolio"
			subtitle="The latest sites, stores, and apps we've designed and built: a site that ranks #1 on Google organically, AI agents that answer customers around the clock, and custom apps that take the manual work off your plate. Click any project for the full story."
			variant="alternate"
		>
			<!-- Case-study astronaut peeking from the left edge of the
			     portfolio, same treatment as the other case-study sections. -->
			<div class="cs-mascot" aria-hidden="true">
				<img src="/mascot/astro-casestudy.webp" alt="" width="360" height="631" loading="lazy" decoding="async" />
			</div>
			<SelectedWork />

			{/* Idea launcher — hidden from the site per Manny (Aug 2026), together
			   with the IdeaLaunchpad modal in BaseLayout. Kept in code in case it
			   comes back.
      <!-- Idea launcher, relocated from the nav bulb. Deliberately small and
           FYI-sized: a footnote to the portfolio, not a promo banner. -->
      <div class="mt-10 flex justify-center px-4">
        <button
          type="button"
          data-idea-open
          class="group inline-flex items-start gap-3 max-w-lg rounded-xl border border-light-tertiary dark:border-dark-accent bg-white/70 dark:bg-dark-secondary/70 px-4 py-3 text-left transition-all duration-300 hover:border-amber-400/50 hover:shadow-md"
        >
          <svg class="w-4 h-4 mt-0.5 flex-shrink-0 text-amber-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" /></svg>
          <span class="text-xs sm:text-[13px] leading-relaxed text-text-light-secondary dark:text-text-dark-secondary">
            <strong class="text-text-light-primary dark:text-text-dark-primary">Got an idea of your own?</strong> Every project here started as one, an app, a tool, a store. <span class="text-primary-blue dark:text-blue-300 font-medium whitespace-nowrap group-hover:underline">See how we build it →</span>
          </span>
        </button>
      </div> */}
		</PageSection>

		<Testimonials />

		<!-- Latest Work (real client sites) — portfolio proof, closing the page
		     right after the testimonials (per Manny: quotes first, then the work). -->

		<!-- "New Playbooks" (blog highlights) — hidden from the homepage per request
		     (kept, not deleted, in case we want it back). The posts still live in the
		     footer's "AI News" column and at /blog. -->
		{/* <BlogHighlights /> */}

		<!-- Customer Reviews Section — hidden until a real client testimonial (e.g. SL Painting) is ready.
		     Fabricated testimonials were removed; see ReviewsSection.astro. -->
		<!-- <ReviewsSection /> -->


		<!-- Floating Dock Menu -->
		<DockMenu />
	</main>
</BaseLayout>
<style>
	/* ── Astronaut peeking from the right of the GBP section ──────────────
	   Manny's dials:
	     --mascot-height  how big he is
	     --mascot-peek    how much of him is VISIBLE (px or %): the rest
	                      stays cropped off the right edge of the section
	     --mascot-rotate  counterclockwise tilt (more negative = leans in more)
	     --mascot-top     vertical position inside the section
	   ------------------------------------------------------------------- */
	.gbp-mascot {
		--mascot-height: 440px;
		--mascot-peek: 58%;
		--mascot-rotate: -31deg;
		--mascot-top: 31.5%;

		position: absolute;
		top: var(--mascot-top);
		right: 0;
		transform: translateY(-50%) translateX(calc(100% - var(--mascot-peek)));
		pointer-events: none;
		/* Over the cards, like the telescope astronaut: blocking a corner is
		   house style now; pointer-events none keeps everything clickable. */
		z-index: 20;
	}
	.gbp-mascot img {
		height: var(--mascot-height);
		width: auto;
		display: block;
		transform: rotate(var(--mascot-rotate));
	}
	/* Tablet: same peek, scaled down so the stat cards keep breathing room.
	   (Overlap itself is fine: house style since the telescope astronaut.) */
	@media (max-width: 1279px) {
		.gbp-mascot { --mascot-height: 320px; --mascot-top: 42%; }
	}
	/* Phones only: no empty margin at all, stays hidden. */
	@media (max-width: 639px) {
		.gbp-mascot { display: none; }
	}

	/* Case-study astronaut: left-edge peek on the portfolio section (same
	   family as the case-study peeks on /apps, /ai-booking-agent, /ai-website). */
	#work { position: relative; overflow: hidden; }
	.cs-mascot {
		--mascot-height: 360px;
		--mascot-peek: 58%;
		--mascot-rotate: 31deg;

		position: absolute;
		top: 50%;
		left: 0;
		transform: translateY(-50%) translateX(calc(-100% + var(--mascot-peek)));
		pointer-events: none;
		z-index: 20;
	}
	.cs-mascot img {
		height: var(--mascot-height);
		width: auto;
		transform: rotate(var(--mascot-rotate));
	}
	@media (max-width: 1279px) {
		.cs-mascot { --mascot-height: 280px; }
	}
	@media (max-width: 639px) {
		.cs-mascot { display: none; }
	}
</style>




