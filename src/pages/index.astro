---
// The homepage was the ONLY public page without this — with output:'server'
// that meant SSR on every hit AND a duplicate ~116K CSS bundle (its chunk
// graph couldn't share Container.*.css with the 44 prerendered pages).
export const prerender = true;

// Import the Layout component
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import NavBar from '../components/navigation/NavBar.astro';
import HeroSection from '../components/sections/HeroSection.astro';
import HeroSwiper from '../components/sections/HeroSwiper.astro';
// BlogHighlights ("New playbooks") is hidden from the homepage for now — re-enable
// the import and the <BlogHighlights /> tag below to bring it back.
// import BlogHighlights from '../components/sections/BlogHighlights.astro';
// Reviews section is temporarily hidden from the homepage until we have a real
// client testimonial to display. The fabricated testimonials were removed from
// Testimonials render from src/data/testimonials.ts — hidden while the real
// list is empty; add real quotes there to make the section appear.
import Testimonials from '../components/sections/Testimonials.astro';
import DockMenu from '../components/navigation/DockMenu.astro';
import PageSection from '../components/layout/PageSection.astro';
import SelectedWork from '../components/sections/SelectedWork.astro';
import HomeAiTeam from '../components/sections/HomeAiTeam.astro';
import GoogleProfile from '../components/sections/GoogleProfile.astro';
import SmartWebsiteConcept from '../components/sections/SmartWebsiteConcept.astro';
import HomeAbout from '../components/sections/HomeAbout.astro';
import HeroVideoBackground from '../components/ui/HeroVideoBackground.astro';
// Offer-catalog prices come from the canonical plan data so structured data can
// never drift from the published price on a reprice.
import { plans } from '../data/plans';

const planPrice = (slug: string) => String(plans.find((p) => p.slug === slug)?.price ?? '');

// ========================================
// LOCAL SEO — structured data (LocalBusiness / Person / WebSite)
// Real NAP, service area, and social profiles for Manny / MannyKnows.
// ========================================
const siteUrl = 'https://mannyknows.com';
const PHONE_TEL = '+14133618451';
const EMAIL = 'mm@mannyknows.com';

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ProfessionalService',
      '@id': `${siteUrl}/#business`,
      name: 'MannyKnows',
      description:
        'Custom apps, websites, and AI automation for established small businesses across Springfield and Western Massachusetts. Manny turns the manual processes that slow a business down into software that runs them, from ecommerce stores and lead-to-job systems to data pipelines and API integrations.',
      url: siteUrl,
      email: EMAIL,
      telephone: PHONE_TEL,
      image: `${siteUrl}/favicon.svg`,
      priceRange: '$$',
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Springfield',
        addressRegion: 'MA',
        addressCountry: 'US',
      },
      areaServed: [
        { '@type': 'City', name: 'Springfield, Massachusetts' },
        { '@type': 'City', name: 'Chicopee, Massachusetts' },
        { '@type': 'City', name: 'Holyoke, Massachusetts' },
        { '@type': 'City', name: 'Westfield, Massachusetts' },
        { '@type': 'City', name: 'West Springfield, Massachusetts' },
        { '@type': 'City', name: 'Agawam, Massachusetts' },
        { '@type': 'City', name: 'Northampton, Massachusetts' },
        { '@type': 'City', name: 'Amherst, Massachusetts' },
        { '@type': 'City', name: 'Longmeadow, Massachusetts' },
        { '@type': 'City', name: 'East Longmeadow, Massachusetts' },
        { '@type': 'City', name: 'Wilbraham, Massachusetts' },
        { '@type': 'City', name: 'Monson, Massachusetts' },
        { '@type': 'City', name: 'Greenfield, Massachusetts' },
        { '@type': 'City', name: 'Deerfield, Massachusetts' },
        { '@type': 'City', name: 'Ludlow, Massachusetts' },
        { '@type': 'City', name: 'Hampden, Massachusetts' },
        { '@type': 'City', name: 'Enfield, Connecticut' },
        { '@type': 'City', name: 'Suffield, Connecticut' },
        { '@type': 'City', name: 'Windsor Locks, Connecticut' },
        { '@type': 'City', name: 'Granby, Connecticut' },
        { '@type': 'City', name: 'Somers, Connecticut' },
        { '@type': 'AdministrativeArea', name: 'Pioneer Valley' },
        { '@type': 'AdministrativeArea', name: 'Hampden County, Massachusetts' },
        { '@type': 'AdministrativeArea', name: 'Western Massachusetts' },
      ],
      sameAs: [
        'https://www.linkedin.com/in/mr83/',
        'https://www.youtube.com/@ShowYouHowAI',
        'https://www.tiktok.com/@mrmanny83',
      ],
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'Services',
        itemListElement: [
          {
            '@type': 'Offer',
            priceCurrency: 'USD',
            priceSpecification: { '@type': 'UnitPriceSpecification', price: planPrice('get-growing'), priceCurrency: 'USD', unitText: 'MONTH' },
            itemOffered: { '@type': 'Service', name: 'Get Growing (AI-powered bilingual website)', description: 'A multilingual website with a built-in AI agent that answers, books, and sells, and that tunes its own content, SEO, and speed.' },
          },
          {
            '@type': 'Offer',
            priceCurrency: 'USD',
            priceSpecification: { '@type': 'UnitPriceSpecification', price: planPrice('get-ahead'), priceCurrency: 'USD', unitText: 'MONTH' },
            itemOffered: { '@type': 'Service', name: 'Get Ahead (managed growth plan)', description: 'The full growth engine: AI-powered website, SEO, and managed Google + social advertising with a monthly working session. Month-to-month; the client owns everything.' },
          },
          {
            '@type': 'Offer',
            priceCurrency: 'USD',
            priceSpecification: { '@type': 'UnitPriceSpecification', price: '95', priceCurrency: 'USD', unitText: 'MONTH' },
            itemOffered: { '@type': 'Service', name: 'AI Team (AI agents)', description: 'AI agents hired per role, sales & booking, research, copy, graphics, voice, SEO, publishing, ads, engagement, and reporting.' },
          },
          {
            '@type': 'Offer',
            itemOffered: { '@type': 'Service', name: 'Local SEO', description: 'Local map-pack visibility, Google Business Profile, and technical SEO for Western Massachusetts businesses.' },
          },
        ],
      },
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      url: siteUrl,
      name: 'MannyKnows',
      publisher: { '@id': `${siteUrl}/#business` },
      inLanguage: 'en-US',
    },
  ],
};
// ========================================
// NAVBAR CONFIGURATION
// ========================================
const NAVBAR_CONFIG = {
	// Search gradient animations in navbar
	searchGradientEnabled: true,
	searchScrollDelay: 0,
	
	// Debug mode for development
	debugMode: false,
};
---

<BaseLayout
	title="AI Agents, Web Design & SEO in Springfield, MA | MannyKnows"
	description="Web design, AI agents, local SEO & custom apps from $95/mo, built in Springfield, MA for all of Western Mass. Cancel anytime. Call or text (413) 361-8451."
	footerServices={true}
>
	<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
	<main class="relative bg-light-primary dark:bg-dark-primary text-text-light-primary dark:text-text-dark-primary min-h-screen transition-colors duration-300">
		<!-- Marquee Announcement Section -->

		<!-- Header Container with Subtle Background -->
		<header class="relative bg-gradient-to-t from-gray-50/50 via-gray-100/30 to-gray-50/20 dark:from-gray-900/60 dark:via-slate-800/40 dark:to-gray-900/30 transition-colors duration-300">
            <!-- Navigation -->
            <NavBar
				animationConfig={{
					searchGradientEnabled: NAVBAR_CONFIG.searchGradientEnabled,
					debugMode: NAVBAR_CONFIG.debugMode,
					searchScrollDelay: NAVBAR_CONFIG.searchScrollDelay
				}}
			/>

            <!-- Hero stack: slider leads on mobile; follows the headline on desktop -->
            <div class="flex flex-col">
            <!-- Hero Section -->
            <HeroSection
                badge="Springfield · Western Massachusetts"
                title=""
                highlightedText='AI Agents, Websites, SEO <br class="sm:hidden" /> & Apps'
                titleAfter=""
                subtitle="We offer AI-powered websites for businesses of any size in Western Mass. Multilingual, built to capture leads, manage clients, and get you found on Google."
            />

            <!-- Hero CTAs + credibility stat band -->
            <div class="max-w-[1440px] mx-auto px-4 mt-8 pb-10 md:pb-16">
              <div class="flex flex-row items-stretch justify-center gap-3 sm:gap-4 max-w-md sm:max-w-none mx-auto">
                <Button href="/local-seo/#free-360-photo" text="FREE 360° PHOTO" subtext="CLAIM NOW" variant="theme-aware" sparkles={true} sparkleTheme="purple" className="flex-1 sm:flex-none sm:px-8" />
                <Button href="/plans/" text="SEE THE PLANS" subtext="FROM $95/MO" variant="primary" sparkles={false} className="flex-1 sm:flex-none sm:px-8" />
              </div>
              <ul class="mt-8 grid grid-cols-3 gap-x-2 gap-y-6 sm:gap-x-4 md:gap-x-5 max-w-3xl mx-auto text-text-light-secondary dark:text-text-dark-secondary">
                <li class="flex flex-col items-center text-center gap-1"><span class="text-base sm:text-lg font-black apple-gradient-text">Reach #One</span> <span class="text-xs leading-snug">we’ve ranked clients #1 organic on Google</span></li>
                <li class="flex flex-col items-center text-center gap-1"><span class="text-base sm:text-lg font-black apple-gradient-text">AI-powered</span> <span class="text-xs leading-snug">Websites built to engage and support your audience</span></li>
                <li class="flex flex-col items-center text-center gap-1"><span class="text-base sm:text-lg font-black apple-gradient-text">Direct <span class="whitespace-nowrap">1-on-1</span></span> <span class="text-xs leading-snug">access to a human senior account owner, not a call center</span></li>
              </ul>
            </div>

            <!-- Hero Swiper Slider — leads on both mobile & desktop; mascot rides its lower-left corner -->
            <div class="relative order-first">
              <HeroSwiper />
            </div>
            </div>
        </header>

		<!-- AI Team — the flagship; teaser that routes to the /ai-team lander -->
		<PageSection
			id="ai-team"
			badge="AI Team"
			title="Fix your biggest business bottlenecks<br />with AI agents"
			subtitle="Unanswered reviews, missed calls, and dormant social accounts are just a few of the many ways Western Mass businesses might be leaking revenue daily. Stop the drain with Manny AI."
			variant="alternate"
		>
			<HomeAiTeam />
		</PageSection>

		<!-- AI-Powered Websites — promo for /plans that sells the CONCEPT, not
		     the price list (pricing cards live only on /plans, per Manny).
		     The contrast columns come from SmartWebsiteConcept (shared with
		     /plans) so the copy can never drift. -->
		<PageSection
			id="plans"
			badge="AI-Powered Websites"
			title="Websites that help you run <br />your business efficiently"
			subtitle="A normal website is frozen the day it launches: it only improves if you pay someone to touch it. Ours check themselves every single day: multilingual, capturing leads, and getting you found on Google."
			variant="alternate"
		>
			<div class="max-w-5xl mx-auto">
				<!-- The versus panel + closing line live in SmartWebsiteConcept,
				     shared with /plans and the plan pages: one implementation. -->
				<SmartWebsiteConcept showHeader={false} />
				<div class="text-center mt-8">
					<a href="/plans/" class="inline-flex items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-primary-blue to-primary-pink text-white px-8 py-3.5 text-sm font-semibold transition-all duration-300">
						Compare the plans
						<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
					</a>
					<p class="mt-4 text-xs text-text-light-tertiary dark:text-text-dark-tertiary">Every plan is tailored to your business</p>
				</div>
			</div>
		</PageSection>

		<!-- Google Business Profile — the "why a 360° photo wins" proof tiles
		     (swapped in from /free-360-photo/, Aug 2026; the BrightLocal stats
		     went the other way). Every figure is sourced on the page (see the
		     component's header comment). -->
