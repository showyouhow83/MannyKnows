---
// The homepage was the ONLY public page without this — with output:'server'
// that meant SSR on every hit AND a duplicate ~116K CSS bundle (its chunk
// graph couldn't share Container.*.css with the 44 prerendered pages).
export const prerender = true;

// Import the Layout component
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import NavBar from '../components/navigation/NavBar.astro';
import HeroSection from '../components/sections/HeroSection.astro';
import HeroSwiper from '../components/sections/HeroSwiper.astro';
// BlogHighlights ("New playbooks") and the old ReviewsSection carousel were
// removed in the Aug 2026 style pass (dead, off-canon; git history has them).
// Testimonials render from src/data/testimonials.ts — hidden while the real
// list is empty; add real quotes there to make the section appear.
import Testimonials from '../components/sections/Testimonials.astro';
import DockMenu from '../components/navigation/DockMenu.astro';
import PageSection from '../components/layout/PageSection.astro';
import SelectedWork from '../components/sections/SelectedWork.astro';
import HomeAiTeam from '../components/sections/HomeAiTeam.astro';
import GoogleProfile from '../components/sections/GoogleProfile.astro';
import SmartWebsiteConcept from '../components/sections/SmartWebsiteConcept.astro';
import HomeAbout from '../components/sections/HomeAbout.astro';
import HeroVideoBackground from '../components/ui/HeroVideoBackground.astro';
// Offer-catalog prices come from the canonical plan data so structured data can
// never drift from the published price on a reprice.
import { plans } from '../data/plans';
import { team } from '../data/aiTeam';

const planPrice = (slug: string) => String(plans.find((p) => p.slug === slug)?.price ?? '');
// Cheapest hireable agent — the "AI staff from $X/mo" figure, computed so a
// reprice in aiTeam.ts can't strand the structured data.
const aiStaffFrom = String(Math.min(...team.filter((a) => a.price > 0).map((a) => a.price)));

// ========================================
// LOCAL SEO — structured data (LocalBusiness / Person / WebSite)
// Real NAP, service area, and social profiles for Manny / MannyKnows.
// ========================================
const siteUrl = 'https://mannyknows.com';
const PHONE_TEL = '+14133618451';
const EMAIL = 'mm@mannyknows.com';

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ProfessionalService',
      '@id': `${siteUrl}/#business`,
      name: 'MannyKnows',
      description:
        'Web design and marketing for dental and medical practices in Springfield and Western Massachusetts, backed by hundreds of dental and medical practice websites designed, built, and launched, plus AI-powered websites, AI agents, local SEO, online stores, and custom apps for contractors, daycares, professional offices, and shops across the region.',
      knowsAbout: [
        'Dental practice website design',
        'Medical practice website design',
        'Healthcare marketing',
        'Local SEO',
        'AI agents for small business',
        'AI booking agents',
        'Shopify ecommerce',
        'Google Business Profile',
        'Custom business apps and automation',
      ],
      url: siteUrl,
      email: EMAIL,
      telephone: PHONE_TEL,
      image: `${siteUrl}/favicon.svg`,
      priceRange: '$$',
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Springfield',
        addressRegion: 'MA',
        addressCountry: 'US',
      },
      areaServed: [
        { '@type': 'City', name: 'Springfield, Massachusetts' },
        { '@type': 'City', name: 'Chicopee, Massachusetts' },
        { '@type': 'City', name: 'Holyoke, Massachusetts' },
        { '@type': 'City', name: 'Westfield, Massachusetts' },
        { '@type': 'City', name: 'West Springfield, Massachusetts' },
        { '@type': 'City', name: 'Agawam, Massachusetts' },
        { '@type': 'City', name: 'Northampton, Massachusetts' },
        { '@type': 'City', name: 'Amherst, Massachusetts' },
        { '@type': 'City', name: 'Longmeadow, Massachusetts' },
        { '@type': 'City', name: 'East Longmeadow, Massachusetts' },
        { '@type': 'City', name: 'Wilbraham, Massachusetts' },
        { '@type': 'City', name: 'Monson, Massachusetts' },
        { '@type': 'City', name: 'Greenfield, Massachusetts' },
        { '@type': 'City', name: 'Deerfield, Massachusetts' },
        { '@type': 'City', name: 'Ludlow, Massachusetts' },
        { '@type': 'City', name: 'Hampden, Massachusetts' },
        { '@type': 'City', name: 'Enfield, Connecticut' },
        { '@type': 'City', name: 'Suffield, Connecticut' },
        { '@type': 'City', name: 'Windsor Locks, Connecticut' },
        { '@type': 'City', name: 'Granby, Connecticut' },
        { '@type': 'City', name: 'Somers, Connecticut' },
        { '@type': 'AdministrativeArea', name: 'Pioneer Valley' },
        { '@type': 'AdministrativeArea', name: 'Hampden County, Massachusetts' },
        { '@type': 'AdministrativeArea', name: 'Western Massachusetts' },
      ],
      sameAs: [
        'https://www.linkedin.com/in/mr83/',
        'https://www.youtube.com/@ShowYouHowAI',
        'https://www.tiktok.com/@mrmanny83',
      ],
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'Services',
        itemListElement: [
          {
            '@type': 'Offer',
            url: `${siteUrl}/plans/`,
            itemOffered: { '@type': 'Service', name: 'Websites & marketing for dental & medical practices', description: 'Practice websites with an AI agent that answers patients 24/7 and books into the schedule, local SEO for the town, and monthly upkeep, backed by hundreds of dental and medical practice websites designed, built, and launched.' },
          },
          {
            '@type': 'Offer',
            priceCurrency: 'USD',
            priceSpecification: { '@type': 'UnitPriceSpecification', price: planPrice('get-growing'), priceCurrency: 'USD', unitText: 'MONTH' },
            itemOffered: { '@type': 'Service', name: 'Get Growing (AI-powered bilingual website)', description: 'A multilingual website with a built-in AI agent that answers, books, and sells, and that tunes its own content, SEO, and speed.' },
          },
          {
            '@type': 'Offer',
            priceCurrency: 'USD',
            priceSpecification: { '@type': 'UnitPriceSpecification', price: planPrice('get-ahead'), priceCurrency: 'USD', unitText: 'MONTH' },
            itemOffered: { '@type': 'Service', name: 'Get Ahead (managed growth plan)', description: 'The full growth engine combines an AI-powered website, SEO, and managed Google + social advertising with a monthly working session. A one-time setup fee covers the build, waived on a prepaid year. No minimum term, and the client owns everything.' },
          },
          {
            '@type': 'Offer',
            priceCurrency: 'USD',
            priceSpecification: { '@type': 'UnitPriceSpecification', price: aiStaffFrom, priceCurrency: 'USD', unitText: 'MONTH' },
            itemOffered: { '@type': 'Service', name: 'AI Agents Team', description: 'AI agents ready to work on your business, per role: sales & booking, research, copy, graphics, voice, SEO, publishing, ads, engagement, and reporting.' },
          },
          {
            '@type': 'Offer',
            itemOffered: { '@type': 'Service', name: 'Local SEO', description: 'Local map-pack visibility, Google Business Profile, and technical SEO for Western Massachusetts businesses.' },
          },
        ],
      },
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      url: siteUrl,
      name: 'MannyKnows',
      publisher: { '@id': `${siteUrl}/#business` },
      inLanguage: 'en-US',
    },
  ],
};
// ========================================
// NAVBAR CONFIGURATION
// ========================================
const NAVBAR_CONFIG = {
	// Search gradient animations in navbar
	searchGradientEnabled: true,
	searchScrollDelay: 0,
	
	// Debug mode for development
	debugMode: false,
};
---

<BaseLayout
	title="AI Agents, Web Design & SEO in Springfield, MA | MannyKnows"
	description="Web design & marketing for dental & medical practices in Springfield & Western Mass, plus AI agents, SEO, stores & apps for every local business."
	footerServices={true}
>
	<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
	<main class="relative bg-light-primary dark:bg-dark-primary text-text-light-primary dark:text-text-dark-primary min-h-screen transition-colors duration-300">
		<!-- Marquee Announcement Section -->

		<!-- Header Container with Subtle Background -->
		<header id="home-hero" class="room-hero relative bg-gradient-to-t from-gray-50/50 via-gray-100/30 to-gray-50/20 dark:from-gray-900/60 dark:via-slate-800/40 dark:to-gray-900/30 transition-colors duration-300">
            <!-- Navigation -->
            <NavBar
				animationConfig={{
					searchGradientEnabled: NAVBAR_CONFIG.searchGradientEnabled,
					debugMode: NAVBAR_CONFIG.debugMode,
					searchScrollDelay: NAVBAR_CONFIG.searchScrollDelay
				}}
			/>

            <!-- Hero stack: slider leads on mobile; follows the headline on desktop -->
            <div class="flex flex-col">
            <!-- Hero Section -->
            <HeroSection
                badge="Springfield · Western Massachusetts"
                title=""
                highlightedText='AI Agents, Websites, SEO <br class="sm:hidden" /> & Apps'
                titleAfter=""
                subtitle="AI-powered practice websites, local SEO, and AI agents that answer patients and keep the schedule full, backed by hundreds of dental and medical practice websites designed, built, and launched. Contractors, daycares, professional offices, and shops across Western Mass run on the same engine."
            />

            <!-- Hero CTAs + credibility stat band -->
            <div class="max-w-[1440px] mx-auto px-4 mt-8 pb-10 md:pb-16">
              {/* The homepage's one exception to the flex-col sm:flex-row button
                  row: these are the two-line pills (Button `subtext`), built to
                  sit side by side on a phone, so the row stays flex-row. */}
              <div class="flex flex-row items-stretch justify-center gap-4 max-w-md sm:max-w-none mx-auto">
                <Button href="/local-seo/#free-360-photo" text="FREE 360° PHOTO" subtext="CLAIM NOW" variant="secondary" class="flex-1 sm:flex-none sm:px-8" />
                <Button href="/free-ai-website-analysis/" text="FREE AI WEBSITE" subtext="ANALYSIS" class="flex-1 sm:flex-none sm:px-8" />
              </div>
              <ul class="mt-8 grid grid-cols-3 gap-4 sm:gap-6 max-w-3xl mx-auto text-text-light-secondary dark:text-text-dark-secondary">
                <li class="flex flex-col items-center text-center gap-1"><span class="text-lg font-black apple-gradient-text">Organically #1</span> <span class="text-xs leading-snug">we help businesses climb to the top</span></li>
                <li class="flex flex-col items-center text-center gap-1"><span class="text-lg font-black apple-gradient-text">AI-powered</span> <span class="text-xs leading-snug">Websites built to engage and support</span></li>
                <li class="flex flex-col items-center text-center gap-1"><span class="text-lg font-black apple-gradient-text">Direct <span class="whitespace-nowrap">1-on-1</span></span> <span class="text-xs leading-snug">access to a human senior account owner</span></li>
              </ul>
            </div>

            <!-- Hero Swiper Slider — leads on both mobile & desktop; mascot rides its lower-left corner -->
            <div class="relative order-first">
              <HeroSwiper />
            </div>
            </div>
        </header>

		<!-- AI Agents Team — the flagship; teaser that routes to the /ai-team lander -->
		<!-- COLOR TEST (Manny-guided): hero wash family + no top seam + a glow
		     in the H1 gradient's own hues. Scoped to this section only. -->
		<PageSection
			id="ai-team"
			className="room room-violet"
			badge="AI Agents Team"
			title="Fix business bottlenecks<br />with AI agents"
			subtitle="Stop losing revenue to operational bottlenecks. We deploy autonomous AI agents that can take a customer's request, price the job, and draft the quote in your CRM while you're still on the ladder. Let AI handle the busywork so you can focus on the business."
			variant="hero"
		>
			<HomeAiTeam />
		</PageSection>

		<!-- AI-Powered Websites — promo for /plans that sells the CONCEPT, not
		     the price list (pricing cards live only on /plans, per Manny).
		     The contrast columns come from SmartWebsiteConcept (shared with
		     /plans) so the copy can never drift. -->
		<PageSection
			id="plans"
			className="room room-blue"
			badge="AI-Powered Websites"
			title="Websites that run <br />your business efficiently"
			subtitle="Instead of costing you manual maintenance fees for every fix, your website improves itself—climbing Google rankings and becoming a more valuable, lead-generating asset every single day. How far the autonomy goes depends on the plan — light on Get Found, full on Get Growing and up."
			variant="hero"
		>
			<!-- Laptop astronaut peeking in from the left edge (mirrored so the
			     laptop leads into the section). Dials in .plans-mascot below. -->
			<div slot="background" class="plans-mascot" aria-hidden="true">
				<img src="/mascot/astro-laptop.webp" alt="Astronaut mascot flying while typing on a laptop" aria-hidden="true" width="917" height="880" loading="lazy" decoding="async" />
			</div>
			<!-- The versus panel + closing line live in SmartWebsiteConcept,
			     shared with /plans and the plan pages: one implementation
			     (it caps its own panel at max-w-6xl, the sitewide banner width). -->
			<SmartWebsiteConcept showHeader={false} />
			<div class="text-center mt-10">
				<Button href="/plans/" arrow="right">Compare the plans</Button>
				<p class="mt-4 text-xs text-text-light-tertiary dark:text-text-dark-tertiary">Every plan is tailored to your business</p>
			</div>
		</PageSection>

		<!-- Google Business Profile — the "why a 360° photo wins" proof tiles
		     (swapped in from /free-360-photo/, Aug 2026; the BrightLocal stats
		     went the other way). Every figure is sourced on the page (see the
		     component's header comment). -->
		<PageSection
			id="google-profile"
			className="room room-violet"
			badge="Search Engine Optimization"
			title="Why a 360° photo <br />wins customers"
			subtitle="People choose businesses they can see. A 360° photo turns your Google listing into a storefront that works around the clock."
			variant="alternate"
		>
			<!-- 360-camera astronaut peeking in from the right edge. All the dials
			     live in the .gbp-mascot CSS block below: tweak and hot-reload. -->
			<div slot="background" class="gbp-mascot" aria-hidden="true">
				<img src="/mascot/astro-360-peek.webp" alt="Astronaut mascot with a 360-degree camera peeking into the section" aria-hidden="true" width="598" height="880" loading="lazy" decoding="async" />
			</div>
			<GoogleProfile />
		</PageSection>

		<!-- Business Apps — the fourth hero pillar ("AI Agents, Websites, SEO
		     & Apps"), a compact promo for /apps/. Tiers and prices mirror the
		     page's TIERS data (apps.astro). -->
		<PageSection
			id="apps"
			variant="hero"
			className="room room-blue"
			badge="Business Apps"
			title="Apps for how your <br />business runs"
			subtitle="Custom business apps and workflow automation for Western Mass small businesses. Scripts that automate the busywork, integrations that connect the tools you already use, and complete systems for booking, quoting, and dashboards. Quoted up front; you own all of it."
		>
			<!-- On desktop the dashboards astronaut shares the title's row (Manny,
			     Aug 2026) — the header's `aside` slot, so the header itself is
			     the shared SectionHeader and not a copy. -->
			<img slot="aside" src="/mascot/astro-dashboards.webp" alt="Astronaut mascot presenting floating data dashboards" aria-hidden="true" width="556" height="620" loading="lazy" decoding="async" class="astro-float w-auto h-[220px] pointer-events-none" />
			<div class="max-w-6xl mx-auto">
				<!-- Bento grid (Manny's pick, Aug 2026: the layout he liked
				     from the Websites options, filled with Apps content).
				     Stacks to one column on phones, story tile first.
				     No prices on the homepage — tiers live on /apps/. -->
				<div class="grid gap-6 md:grid-cols-4">
					<div class="md:col-span-2 md:row-span-2 rounded-3xl border border-primary-blue/40 ring-1 ring-primary-blue/20 bg-white dark:bg-dark-secondary p-6 sm:p-8 flex flex-col justify-center">
						<h3 class="text-xl sm:text-2xl font-bold mb-4"><span class="apple-gradient-text" data-colorful-title>Disconnected and connected apps</span></h3>
						<p class="text-sm sm:text-base text-text-light-secondary dark:text-text-dark-secondary leading-relaxed mb-4">Some jobs need a standalone tool. Some need your website, inbox, CRM, calendar, and phone talking to each other so data stops being re-typed. We build both.</p>
						<p class="text-sm font-semibold text-text-light-primary dark:text-text-dark-primary">The fastest way to get hours back is to stop doing the work a machine can do.</p>
					</div>
					<div class="rounded-2xl border border-light-tertiary dark:border-dark-accent bg-white dark:bg-dark-secondary p-6">
						<h3 class="text-lg font-bold leading-snug"><span class="apple-gradient-text" data-colorful-title>Scripts</span></h3>
						<p class="mt-3 text-sm text-text-light-secondary dark:text-text-dark-secondary leading-relaxed">Apps Script tools, from spreadsheets that become quoting tools to reports that send themselves.</p>
					</div>
					<div class="rounded-2xl border border-light-tertiary dark:border-dark-accent bg-white dark:bg-dark-secondary p-6">
						<h3 class="text-lg font-bold leading-snug"><span class="apple-gradient-text" data-colorful-title>Wired</span></h3>
						<p class="mt-3 text-sm text-text-light-secondary dark:text-text-dark-secondary leading-relaxed">APIs, webhooks, Twilio phone &amp; SMS, Make &amp; Zapier — your tools connected, end to end.</p>
					</div>
					<div class="rounded-2xl border border-light-tertiary dark:border-dark-accent bg-white dark:bg-dark-secondary p-6">
						<h3 class="text-lg font-bold leading-snug"><span class="apple-gradient-text" data-colorful-title>MCP</span></h3>
						<p class="mt-3 text-sm text-text-light-secondary dark:text-text-dark-secondary leading-relaxed">Your AI plugged into your calendar, CRM, and inventory. It works with them, not just talks.</p>
					</div>
					<div class="rounded-2xl border border-light-tertiary dark:border-dark-accent bg-white dark:bg-dark-secondary p-6">
						<h3 class="text-lg font-bold leading-snug"><span class="apple-gradient-text" data-colorful-title>Yours</span></h3>
						<p class="mt-3 text-sm text-text-light-secondary dark:text-text-dark-secondary leading-relaxed">Quoted up front. The code, the flows, and the accounts are yours. Co-own option for big ideas.</p>
					</div>
				</div>
				<div class="text-center mt-10">
					<Button href="/apps/" arrow="right">Explore Business Apps</Button>
					<p class="mt-4 text-xs text-text-light-tertiary dark:text-text-dark-tertiary">Most projects live in 2–4 weeks · you own everything we build</p>
				</div>
			</div>
		</PageSection>

		<!-- Who you're working with — condensed founder intro, routes to /about -->
		<PageSection
			id="about"
			className="room room-violet"
			badge="Your solutions partner"
			title="Who you're working with"
			variant="hero"
		>
			<!-- Same blue nebula as /about's header. warm = buffered during idle
			     time after load, so it plays instantly on scroll without ever
			     competing with the page's own assets. -->
			<HeroVideoBackground slot="background" name="hero-blue" tone="color" warm />
			<HomeAbout />
		</PageSection>

		<!-- Testimonials — driven by src/data/testimonials.ts (real quotes only);
		     renders nothing if that list is ever emptied.
		     (Replaces the retired ReviewsSection carousel.) -->
		<PageSection
			id="work"
			className="room room-blue"
			badge="Portfolio"
			title="Our web design portfolio"
			subtitle="The latest sites, stores, and apps we've designed and built — they rank organically on Google, answer customers around the clock, and take the manual work off your plate. Click any project for the full story."
			variant="alternate"
		>
			<SelectedWork />

			{/* Idea launcher — hidden from the site per Manny (Aug 2026), together
			   with the IdeaLaunchpad modal in BaseLayout. Kept in code in case it
			   comes back.
      <!-- Idea launcher, relocated from the nav bulb. Deliberately small and
           FYI-sized: a footnote to the portfolio, not a promo banner. -->
      <div class="mt-10 flex justify-center px-4">
        <button
          type="button"
          data-idea-open
          class="group inline-flex items-start gap-3 max-w-lg rounded-xl border border-light-tertiary dark:border-dark-accent bg-white/70 dark:bg-dark-secondary/70 px-4 py-3 text-left transition-all duration-300 hover:border-amber-400/50 hover:shadow-md"
        >
          <svg class="w-4 h-4 mt-0.5 flex-shrink-0 text-amber-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" /></svg>
          <span class="text-xs sm:text-[13px] leading-relaxed text-text-light-secondary dark:text-text-dark-secondary">
            <strong class="text-text-light-primary dark:text-text-dark-primary">Got an idea of your own?</strong> Every project here started as one, an app, a tool, a store. <span class="text-primary-blue dark:text-blue-300 font-medium whitespace-nowrap group-hover:underline">See how we build it →</span>
          </span>
        </button>
      </div> */}
		</PageSection>

		<Testimonials size="hero" />

		<!-- "New Playbooks" (blog highlights) left the homepage per request; the
		     posts still live in the footer's "AI News" column and at /blog. -->

		<!-- Floating Dock Menu -->
		<DockMenu />
	</main>
</BaseLayout>
<style>
	/* ── Astronaut peeking from the right of the GBP section ──────────────
	   Manny's dials:
	     --mascot-height  how big he is
	     --mascot-peek    how much of him is VISIBLE (px or %): the rest
	                      stays cropped off the right edge of the section
	     --mascot-rotate  counterclockwise tilt (more negative = leans in more)
	     --mascot-top     vertical position inside the section
	   ------------------------------------------------------------------- */
	/* Laptop astronaut: left-edge peek on the AI-Powered Websites section.
	   The art faces left, so the img is mirrored (scaleX) to lead with the
	   laptop; rotate is applied after the flip. */
	.plans-mascot {
		--mascot-height: 400px;
		/* The versus panel is max-w-6xl (the sitewide banner width), which
		   leaves a 144px gutter at 1440 — the peek is sized to live in it, not
		   over the copy (Aug 2026; it was 70% when the panel was narrower). */
		--mascot-peek: 34%;
		/* Gentler than the 31° house tilt: this art is wide (flying pose),
		   so a full lean swings the laptop end too far. */
		--mascot-rotate: 15deg;
		--mascot-top: 50%;

		position: absolute;
		top: var(--mascot-top);
		left: 0;
		transform: translateY(-50%) translateX(calc(-100% + var(--mascot-peek)));
		pointer-events: none;
		z-index: 20;
	}
	.plans-mascot img {
		height: var(--mascot-height);
		width: auto;
		display: block;
		transform: rotate(var(--mascot-rotate)) scaleX(-1);
	}
	@media (max-width: 1439px) {
		.plans-mascot { --mascot-peek: 22%; }
	}
	@media (max-width: 1279px) {
		.plans-mascot { --mascot-height: 300px; }
	}
	@media (max-width: 639px) {
		.plans-mascot { display: none; }
	}

	/* ── AI Agents Team color test (Manny-guided session) ─────────────────────────
	   Seamless: same wash family as the hero above, and the seam border is
	   removed so the two grounds meet without a line. The glow uses the H1
	   gradient's own hues — blue (#0071e3) upper-left, pink (#ff4faa) right,
	   purple (#8b5cf6) low-center — each fading radially to nothing.
	   Dials: the three rgba alphas below (dark) and the light-mode set. */
	/* AI Agents Team color test lives in the is:global block below — #ai-team is
	   rendered by PageSection, so scoped selectors here can never match it. */

	.gbp-mascot {
		--mascot-height: 440px;
		--mascot-peek: 58%;
		--mascot-rotate: -31deg;
		--mascot-top: 31.5%;

		position: absolute;
		top: var(--mascot-top);
		right: 0;
		transform: translateY(-50%) translateX(calc(100% - var(--mascot-peek)));
		pointer-events: none;
		/* Over the cards, like the telescope astronaut: blocking a corner is
		   house style now; pointer-events none keeps everything clickable. */
		z-index: 20;
	}
	.gbp-mascot img {
		height: var(--mascot-height);
		width: auto;
		display: block;
		transform: rotate(var(--mascot-rotate));
	}
	/* Tablet: same peek, scaled down so the stat cards keep breathing room.
	   (Overlap itself is fine: house style since the telescope astronaut.) */
	@media (max-width: 1279px) {
		.gbp-mascot { --mascot-height: 320px; --mascot-top: 42%; }
	}
	/* Phones only: no empty margin at all, stays hidden. */
