			id="google-profile"
			badge="Search Engine Optimization"
			title="Why a 360° photo <br />wins customers"
			subtitle="People choose businesses they can see. A 360° photo turns your Google listing into a storefront that works around the clock."
			variant="hero"
		>
			<!-- 360-camera astronaut peeking in from the right edge. All the dials
			     live in the .gbp-mascot CSS block below: tweak and hot-reload. -->
