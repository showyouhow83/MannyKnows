---
// Online stores — their own page, deliberately not one of the four website
// tiers on /plans. Getting found and getting booked is one decision; selling
// products online is a different build with different economics, and mixing
// them made the plans table read like a store was just "the expensive tier".
// Driven by the same src/data/plans.ts entry, so pricing never drifts.
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import NavBar from '../components/navigation/NavBar.astro';
import DockMenu from '../components/navigation/DockMenu.astro';
import Section from '../components/layout/Section.astro';
import Container from '../components/layout/Container.astro';
import Faq from '../components/ui/Faq.astro';
import { ecommercePlans, yearlyTotal, yearlyMonthly } from '../data/plans';
// Official monochrome brand marks from the CC0 simple-icons set, resolved at
// build time. Adobe Commerce/Magento and Ecwid aren't in the set (Adobe's
// marks were removed on trademark grounds) — those two render as text chips.
import { siShopify, siWoocommerce, siBigcommerce, siSquare, siSquarespace, siWix } from 'simple-icons';

const platformLogos: { title: string; path?: string }[] = [
  { title: 'Shopify', path: siShopify.path },
  { title: 'WooCommerce', path: siWoocommerce.path },
  { title: 'Adobe Commerce (Magento)' },
  { title: 'BigCommerce', path: siBigcommerce.path },
  { title: 'Ecwid' },
  { title: 'Square Online', path: siSquare.path },
  { title: 'Squarespace', path: siSquarespace.path },
  { title: 'Wix', path: siWix.path },
];
import { BOOKING_URL } from '../data/booking';
import { getTestimonial } from '../data/testimonials';
import QuoteBlock from '../components/ui/QuoteBlock.astro';
import Illustration from '../components/illustrations/Illustration.astro';
import StepCards from '../components/ui/StepCards.astro';

const plan = ecommercePlans[0];
const proofQuote = getTestimonial('Cherry Vibes');

// The honest comparison: a store isn't a website tier, so we say plainly what
// it costs relative to the plan it's built on rather than hiding the math.


// Structured data: the store service with its real tiers (mapped from
// plans.ts at build time — cannot drift from the pricing grid).
const pageJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Ecommerce Web Design & Development',
  serviceType: 'Ecommerce website design, development, and store management',
  provider: {
  '@type': 'ProfessionalService',
  '@id': 'https://mannyknows.com/#business',
  name: 'MannyKnows',
  url: 'https://mannyknows.com',
  telephone: '+1-413-361-8451',
  address: { '@type': 'PostalAddress', addressLocality: 'Springfield', addressRegion: 'MA', addressCountry: 'US' },
},
  areaServed: 'Western Massachusetts',
  description: 'Online stores built, stocked, and run — Shopify and beyond, with the platform subscription included in every tier.',
  offers: (plan.tiers ?? []).map((t) => ({
    '@type': 'Offer',
    name: t.name,
    price: String(t.price),
    priceCurrency: 'USD',
    description: t.description,
  })),
};
---

<BaseLayout
  title="Ecommerce Web Design for Western Mass | MannyKnows"
  description={`Ecommerce website development for Western Mass — Shopify stores built, stocked & run: product pages that sell, Remi answering shoppers 24/7. From $${plan.price.toLocaleString('en-US')}/mo.`}
>
  <script type="application/ld+json" set:html={JSON.stringify(pageJsonLd)} />
  <main class="relative bg-light-primary dark:bg-dark-primary text-text-light-primary dark:text-text-dark-primary min-h-screen transition-colors duration-300">

    <header class="relative bg-gradient-to-t from-gray-50/50 via-gray-100/30 to-gray-50/20 dark:from-gray-900/60 dark:via-slate-800/40 dark:to-gray-900/30 transition-colors duration-300">
      <NavBar />
      <nav aria-label="breadcrumb" class="max-w-[1440px] mx-auto px-4 lg:px-6 pt-6 pb-4">
        <ol class="flex flex-wrap items-center gap-2 text-sm text-text-light-secondary dark:text-text-dark-secondary">
          <li><a href="/" class="hover:text-primary-blue transition-colors">Home</a></li>
          <li class="flex items-center"><span class="mx-2 text-text-light-tertiary dark:text-text-dark-tertiary">/</span><span class="text-text-light-primary dark:text-text-dark-primary font-medium">Online stores</span></li>
        </ol>
      </nav>
      <div class="pb-12">
        <Container>
          <div class="max-w-[1440px] mx-auto text-center">
            <div class="flex justify-center mb-6">
              <Illustration kind="store" class="w-full max-w-[210px]" />
            </div>
            <span class="inline-block bg-gradient-to-r from-primary-blue/10 via-purple-500/10 to-primary-pink/10 text-primary-blue px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider mb-4">
              <svg class="inline-block w-4 h-4 align-[-0.2em] mr-1" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d={plan.icon} /></svg>Shopify stores · built, stocked &amp; run for you
            </span>
            <h1 class="sf-bold apple-headline text-4xl md:text-5xl lg:text-6xl mb-6">
              <span class="apple-gradient-text" data-colorful-title>Online stores that sell while your business is closed</span>
            </h1>
            <p class="max-w-3xl mx-auto text-base sm:text-xl text-text-light-secondary dark:text-text-dark-secondary leading-relaxed">
              Anyone can sign up for a store. A store that <em>sells</em> is a job: the right products, written and photographed right, emails that bring people back, a checkout nobody abandons. We do that job every month — so by the holiday rush you're tuned and stocked, not launching.
            </p>

            <div class="mt-8 inline-flex flex-col sm:flex-row items-stretch gap-3 text-center">
              <div class="rounded-2xl border border-light-tertiary dark:border-dark-accent bg-white dark:bg-dark-secondary px-6 py-4">
                <span class="block text-[11px] font-semibold uppercase tracking-wide text-text-light-tertiary dark:text-text-dark-tertiary">Month-to-month</span>
                <span class="text-3xl font-black">${plan.price.toLocaleString('en-US')}</span><span class="text-sm text-text-light-secondary dark:text-text-dark-secondary">/mo</span>
                <span class="block text-xs text-text-light-tertiary dark:text-text-dark-tertiary mt-1">starting at · cancel anytime</span>
              </div>
              <div class="rounded-2xl border border-primary-blue/40 ring-1 ring-primary-blue/20 bg-white dark:bg-dark-secondary px-6 py-4">
                <span class="block text-[11px] font-semibold uppercase tracking-wide text-primary-blue dark:text-blue-300">Yearly · 2 months free</span>
                <span class="text-3xl font-black">${yearlyMonthly(plan).toLocaleString('en-US')}</span><span class="text-sm text-text-light-secondary dark:text-text-dark-secondary">/mo</span>
                <span class="block text-xs text-text-light-tertiary dark:text-text-dark-tertiary mt-1">billed as one payment of ${yearlyTotal(plan).toLocaleString('en-US')}/yr</span>
              </div>
            </div>

            <p class="mt-3 text-sm font-medium text-text-light-primary dark:text-text-dark-primary">
              Every tier includes your Shopify subscription — one bill, not two.
            </p>

            <p class="mt-6 text-sm text-text-light-secondary dark:text-text-dark-secondary">
              <strong class="text-text-light-primary dark:text-text-dark-primary">Built for:</strong> {plan.whoFor}
            </p>

            <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
              <a href="#contact" data-contact-context="Sell Online — store plan" class="inline-flex items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-primary-blue to-primary-pink text-white px-8 py-3.5 text-sm font-semibold transition-all duration-300">
                Start your store
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
              </a>
              <a href="/work/cherry-vibes/" class="inline-flex items-center justify-center gap-2 rounded-xl border border-primary-blue/40 text-primary-blue dark:text-blue-300 px-6 py-3.5 text-sm font-semibold hover:bg-primary-blue/5 transition-all duration-300">
                See a store we built
              </a>
            </div>
            <p class="mt-3 text-xs text-text-light-tertiary dark:text-text-dark-tertiary">Month-to-month · cancel anytime · your store and catalog stay yours</p>
            <!-- Platforms we service — a CSS-only logo marquee (track duplicated
                 for the seamless loop; pauses on hover; static under
                 prefers-reduced-motion). "Adobe Commerce" is Magento's current
                 name (renamed 2021). -->
            <div class="mt-8 max-w-3xl mx-auto">
              <p class="text-xs font-semibold uppercase tracking-wider text-text-light-tertiary dark:text-text-dark-tertiary mb-3">We work across the platforms</p>
              <div class="platform-marquee" role="img" aria-label="Shopify, WooCommerce, Adobe Commerce (Magento), BigCommerce, Ecwid, Square Online, Squarespace, Wix">
                <div class="platform-track text-gray-500 dark:text-slate-400" aria-hidden="true">
                  {[0, 1].map(() => (
                    platformLogos.map((l) => (
                      <span class="platform-item" title={l.title}>
                        {l.path ? (
                          <svg viewBox="0 0 24 24" class="h-6 w-6 flex-shrink-0" fill="currentColor" aria-hidden="true"><path d={l.path} /></svg>
                        ) : null}
                        <span class="whitespace-nowrap text-sm font-semibold">{l.title}</span>
                      </span>
                    ))
                  ))}
                </div>
              </div>
            </div>
          </div>
        </Container>
      </div>
    </header>

    {/* The pricing ladder — four tiers, modeled on what ecommerce agencies sell
        as monthly retainers, at local-business prices. Data lives on the plan
        record (plans.ts `tiers`); every price includes the Shopify subscription. */}
    <Section id="store-tiers" variant="default">
      <Container>
        <div class="text-center max-w-[1440px] mx-auto mb-10">
          <h2 class="sf-bold text-2xl md:text-3xl font-bold">
            <span class="apple-gradient-text" data-colorful-title>Four sizes of store</span>
          </h2>
          <p class="mt-3 max-w-3xl mx-auto text-base text-text-light-secondary dark:text-text-dark-secondary leading-relaxed">
            Each tier includes everything in the one before it — and your Shopify subscription. Start where your store is; move up when it's earning more.
          </p>
        </div>
        <!-- Monthly ⇄ Yearly toggle — visually identical to /plans, yearly
             pre-selected so the cheaper rate is what visitors meet first. -->
        <div id="storePricing">
        <div class="flex flex-col items-center gap-2 mb-10">
          <div class="inline-flex items-center rounded-full border border-light-tertiary dark:border-dark-accent bg-white dark:bg-dark-secondary p-1" role="group" aria-label="Billing period">
            <button type="button" data-billing-btn="monthly" aria-pressed="false" class="billing-btn rounded-full px-5 py-2 text-sm font-semibold transition-all duration-200 text-text-light-secondary dark:text-text-dark-secondary">
              Monthly
            </button>
            <button type="button" data-billing-btn="yearly" aria-pressed="true" class="billing-btn rounded-full px-5 py-2 text-sm font-semibold transition-all duration-200 bg-gradient-to-r from-primary-blue to-primary-pink text-white shadow">
              Yearly <span class="font-bold billing-btn-note text-white">· 2 months free</span>
            </button>
          </div>
          <p class="text-xs text-text-light-tertiary dark:text-text-dark-tertiary" data-billing-caption>
            One upfront payment for the year — 2 months free
          </p>
        </div>
        <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-4 items-stretch">
          {plan.tiers!.map((t) => (
            <div class={`relative flex flex-col rounded-2xl border bg-white dark:bg-dark-secondary p-6 transition-all duration-300 ${t.featured ? 'border-primary-blue/50 shadow-lg shadow-primary-blue/10 ring-1 ring-primary-blue/30 xl:-mt-2 xl:mb-2' : 'border-light-tertiary dark:border-dark-accent hover:border-primary-blue/30 hover:shadow-lg'}`}>
              {t.featured && (
                <span class="absolute -top-3 left-1/2 -translate-x-1/2 whitespace-nowrap bg-gradient-to-r from-primary-blue to-primary-pink text-white text-[11px] font-bold uppercase tracking-wide px-3 py-1 rounded-full shadow">
                  Most popular
                </span>
              )}

              <div class="flex items-center justify-center gap-2">
                <h3 class="text-base sm:text-lg font-bold text-text-light-primary dark:text-text-dark-primary leading-tight">{t.name}</h3>
              </div>

              <div class="mt-4 text-center">
                <span class="block text-[11px] font-semibold uppercase tracking-wide text-text-light-tertiary dark:text-text-dark-tertiary">Starting at</span>
                <div data-billing-view="monthly" hidden class="whitespace-nowrap leading-none mt-0.5">
                  <span class="text-3xl font-black text-text-light-primary dark:text-text-dark-primary">${t.price.toLocaleString('en-US')}</span><span class="text-sm text-text-light-secondary dark:text-text-dark-secondary">/mo</span>
                </div>
                <div data-billing-view="yearly" class="whitespace-nowrap leading-none mt-0.5">
                  <span class="text-3xl font-black text-text-light-primary dark:text-text-dark-primary">${Math.round((t.price * 10) / 12).toLocaleString('en-US')}</span><span class="text-sm text-text-light-secondary dark:text-text-dark-secondary">/mo</span>
                </div>
                <div data-billing-view="monthly" hidden class="text-xs text-text-light-tertiary dark:text-text-dark-tertiary mt-1.5">
                  or ${(t.price * 10).toLocaleString('en-US')}/yr paid upfront — <span class="text-primary-blue dark:text-blue-300 font-semibold">2 months free</span>
                </div>
                <div data-billing-view="yearly" class="text-xs text-text-light-tertiary dark:text-text-dark-tertiary mt-1.5">
                  billed as one payment of ${(t.price * 10).toLocaleString('en-US')}/yr · <span class="text-primary-blue dark:text-blue-300 font-semibold">2 months free</span>
                </div>
                <p class="text-[11px] font-semibold uppercase tracking-wide text-primary-blue dark:text-blue-300 mt-1.5">{t.note}</p>
              </div>

              <p class="mt-3 text-sm text-text-light-secondary dark:text-text-dark-secondary leading-relaxed">{t.description}</p>

              <div class="mt-4 pt-4 border-t border-light-tertiary dark:border-dark-accent flex-1">
                {t.builtOn && (
                  <p class="mb-2.5 text-xs font-bold text-primary-blue dark:text-blue-300">{t.builtOn}</p>
                )}
                <ul class="space-y-2.5">
                  {t.features.map((f) => (
                    <li class="flex items-start gap-2 text-sm text-text-light-secondary dark:text-text-dark-secondary leading-snug">
                      <svg class="w-4 h-4 mt-0.5 flex-shrink-0 text-primary-blue dark:text-blue-300" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                      </svg>
                      <span>{f}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <a href="#contact" data-contact-context={`Online Store — ${t.name}`} class={`mt-4 inline-flex items-center justify-center gap-1 rounded-xl px-4 py-2.5 text-sm font-semibold transition-all duration-300 ${t.featured ? 'bg-gradient-to-r from-primary-blue to-primary-pink text-white' : 'border border-primary-blue/40 text-primary-blue dark:text-blue-300 hover:bg-primary-blue/5'}`}>
                Get started
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
              </a>
            </div>
          ))}
        </div>
        </div>

        <div class="mt-14">
          <p class="text-center text-xs font-bold uppercase tracking-wider text-text-light-tertiary dark:text-text-dark-tertiary mb-4">Compare at a glance</p>
          <div class="overflow-x-auto rounded-2xl border border-light-tertiary dark:border-dark-accent">
            <table class="w-full min-w-[720px] text-sm bg-white dark:bg-dark-secondary">
              <thead>
                <tr class="border-b border-light-tertiary dark:border-dark-accent text-left">
                  <th class="p-4 font-semibold text-text-light-primary dark:text-text-dark-primary">What you get</th>
                  {plan.tiers!.map((t) => <th class="p-4 font-semibold text-center text-text-light-primary dark:text-text-dark-primary">{t.name.replace('Sell ', '')}</th>)}
                </tr>
              </thead>
              <tbody class="text-text-light-secondary dark:text-text-dark-secondary">
                {[
                  ['Shopify subscription included', 'Basic', 'Basic', 'Grow', 'Grow'],
                  ['Store built & configured — theme, payments, shipping, taxes', '✓', '✓', '✓', '✓'],
                  ['Remi answers shoppers 24/7, any language', '✓', '✓', '✓', '✓'],
                  ['Product adds & changes per month', '10', '30', '100', '100'],
                  ['SEO product descriptions — AI-written & reviewed', 'Unlimited', 'Unlimited', 'Unlimited', 'Unlimited'],
                  ['Store SEO', 'Basics', 'AI-Automated', 'Full program', 'Full program'],
                  ['Email — flows (cart, welcome, post-purchase)', '—', '✓', '✓', '✓'],
                  ['Cart-abandonment optimization', '—', '—', '✓', '✓'],
                  ['Reviews collected & shown', '—', '✓', '✓', '✓'],
                  ['AI shopping assistant — recommends & upsells', '—', '—', '✓', '✓'],
                  ['Multilingual storefront', '—', '—', '✓', '✓'],
                  ['Ads run & managed (two networks) + product feeds', '—', '—', '—', '✓'],
                  ['Monthly working session with Manny', '—', '—', '—', '✓'],
                ].map((row) => (
                  <tr class="border-b border-light-tertiary/60 dark:border-dark-accent/60 last:border-0">
                    <td class="p-4">{row[0]}</td>
                    {row.slice(1).map((c) => (
                      <td class={`p-4 text-center ${c === '✓' ? 'text-green-500 font-bold' : c === '—' ? 'text-text-light-tertiary dark:text-text-dark-tertiary' : 'font-semibold text-primary-blue dark:text-blue-300'}`}>{c}</td>
                    ))}
                  </tr>
                ))}
                <tr class="bg-light-secondary/40 dark:bg-dark-primary/40">
                  <td class="p-4 font-bold text-text-light-primary dark:text-text-dark-primary">Per month</td>
                  {plan.tiers!.map((t) => <td class="p-4 text-center font-black text-text-light-primary dark:text-text-dark-primary">${t.price.toLocaleString('en-US')}</td>)}
                </tr>
              </tbody>
            </table>
          </div>
          <p class="mt-4 text-center text-xs text-text-light-tertiary dark:text-text-dark-tertiary max-w-2xl mx-auto">
            No markups, no hidden fees: your platform's own payment-processing rates apply, whatever runs your store — Shopify, WooCommerce, or any of the systems we work with. Bigger store needing an enterprise tier? We run those too.
          </p>
        </div>
      </Container>
    </Section>

    <!-- Why this isn't one of the website plans -->
    <Section id="store-vs-site" variant="alternate">
      <Container>
        <div class="max-w-3xl mx-auto text-center">
          <h2 class="sf-bold text-2xl md:text-3xl font-bold mb-4">
            <span class="apple-gradient-text" data-colorful-title>A store is a different animal than a website</span>
          </h2>
          <p class="text-base text-text-light-secondary dark:text-text-dark-secondary leading-relaxed">
            A <a href="/plans/" class="text-primary-blue dark:text-blue-300 font-medium hover:underline">website</a> gets you found and reached. A store has a harder job: a stranger has to decide, trust you, and pay — without talking to anybody. That's inventory, product photography, shipping, taxes, and cart-recovery email. A bigger machine, with its own price.
          </p>
        </div>
      </Container>
    </Section>

    <!-- What's included -->
    <Section id="store-included" variant="default">
      <Container>
        <h2 class="sf-bold text-2xl md:text-3xl font-bold text-center mb-12">
          <span class="apple-gradient-text" data-colorful-title>Everything included</span>
        </h2>
        <div class="grid gap-6 md:grid-cols-2 max-w-6xl mx-auto">
          {plan.deliverables.map((d) => (
            <div class="rounded-2xl border border-light-tertiary dark:border-dark-accent bg-white dark:bg-dark-secondary p-6">
              <h3 class="text-lg font-bold text-text-light-primary dark:text-text-dark-primary mb-3">{d.title}</h3>
              <ul class="space-y-2.5">
                {d.items.map((item) => (
                  <li class="flex items-start gap-2 text-sm text-text-light-secondary dark:text-text-dark-secondary leading-snug">
                    <svg class="w-4 h-4 mt-0.5 flex-shrink-0 text-primary-blue dark:text-blue-300" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
        <p class="mt-8 text-center text-sm text-text-light-secondary dark:text-text-dark-secondary max-w-2xl mx-auto">
          Plus what every plan includes: your own admin, multilingual as standard, SSL and caching on a global edge network, a domain if you need one, and unlimited storage, bandwidth, content updates, and stock photos, video &amp; logos.
          <a href="/plans/#included" class="text-primary-blue dark:text-blue-300 font-medium hover:underline whitespace-nowrap">See the full list →</a>
        </p>
      </Container>
    </Section>

    <!-- Proof -->
    <Section id="store-proof" variant="alternate">
      <Container>
        <div class="max-w-3xl mx-auto">
          <h2 class="sf-bold text-2xl md:text-3xl font-bold text-center mb-10">
            <span class="apple-gradient-text" data-colorful-title>From a store we built &amp; run</span>
          </h2>
          {proofQuote && <QuoteBlock quote={proofQuote} />}
          <div class="flex flex-wrap items-center justify-center gap-3 mt-6">
            <span class="text-sm text-text-light-secondary dark:text-text-dark-secondary">See it working:</span>
            <a href="/work/cherry-vibes/" class="inline-flex items-center gap-1.5 rounded-full border border-primary-blue/40 text-primary-blue dark:text-blue-300 px-4 py-1.5 text-sm font-medium hover:bg-primary-blue/5 transition-all">
              Cherry Vibes
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
            </a>
          </div>
        </div>
      </Container>
    </Section>

    <!-- How it works -->
    <Section id="store-steps" variant="default">
      <Container>
        <h2 class="sf-bold text-2xl md:text-3xl font-bold text-center mb-12">
          <span class="apple-gradient-text" data-colorful-title>How it works</span>
        </h2>
        <StepCards steps={plan.steps} class="max-w-6xl mx-auto" />
      </Container>
    </Section>

    <!-- FAQ -->
    <Section id="store-faq" variant="alternate">
      <Container>
        <div class="max-w-3xl mx-auto">
          <Faq faqs={plan.faq} />
          <div class="text-center mt-12">
            <a href="#contact" data-contact-context="Sell Online — store plan" class="inline-flex items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-primary-blue to-primary-pink text-white px-6 py-3 text-sm font-semibold transition-all duration-300">
              Talk to us about your store
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
            </a>
          </div>
        </div>
      </Container>
    </Section>

    <!-- Back to the website plans -->
    <Section id="store-plans" variant="default">
      <Container>
        <div class="max-w-2xl mx-auto text-center rounded-3xl border border-light-tertiary dark:border-dark-accent bg-white dark:bg-dark-secondary p-8">
