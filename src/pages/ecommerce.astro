</BaseLayout>

<style>
  .platform-marquee {
    overflow: hidden;
    position: relative;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
  }
  .platform-track {
    display: flex;
    align-items: center;
    gap: 2.5rem;
    width: max-content;
    animation: platformScroll 30s linear infinite;
  }
  .platform-item { display: inline-flex; align-items: center; gap: 0.5rem; opacity: 0.85; }
  .platform-marquee:hover .platform-track { animation-play-state: paused; }
  @keyframes platformScroll {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .platform-track { animation: none; flex-wrap: wrap; justify-content: center; width: auto; }
    .platform-track > :nth-child(n+9) { display: none; } /* hide the duplicate set */
    .platform-marquee { -webkit-mask-image: none; mask-image: none; }
  }
</style>

<script>
  // Monthly ⇄ Yearly toggle for the store tiers — same behavior as /plans.
  (function () {
    const root = document.getElementById('storePricing');
    if (!root) return;
    const buttons = root.querySelectorAll<HTMLButtonElement>('[data-billing-btn]');
    const caption = root.querySelector('[data-billing-caption]');
    const views = root.querySelectorAll<HTMLElement>('[data-billing-view]');
    const activeCls = ['bg-gradient-to-r', 'from-primary-blue', 'to-primary-pink', 'text-white', 'shadow'];
    const inactiveCls = ['text-text-light-secondary', 'dark:text-text-dark-secondary'];

    function setBilling(mode: 'monthly' | 'yearly') {
      views.forEach((el) => { el.hidden = el.dataset.billingView !== mode; });
      if (caption) {
        caption.textContent = mode === 'monthly'
          ? 'Month-to-month · cancel anytime'
          : 'One upfront payment for the year — 2 months free';
      }
      buttons.forEach((b) => {
        const active = b.dataset.billingBtn === mode;
        b.setAttribute('aria-pressed', String(active));
        activeCls.forEach((c) => b.classList.toggle(c, active));
        inactiveCls.forEach((c) => b.classList.toggle(c, !active));
        const note = b.querySelector('.billing-btn-note');
        if (note) {
          note.classList.toggle('text-white', active);
          note.classList.toggle('text-primary-blue', !active);
          note.classList.toggle('dark:text-blue-300', !active);
        }
      });
    }

    buttons.forEach((b) =>
      b.addEventListener('click', () => setBilling(b.dataset.billingBtn as 'monthly' | 'yearly'))
    );
  })();
</script>

